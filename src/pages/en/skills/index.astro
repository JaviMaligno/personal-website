---
import Layout from '../../../layouts/Layout.astro';
import Skills from '../../../components/Skills.astro';
import { getLocalizedPath } from '../../../i18n';

const lang = 'en';
---

<Layout
  title="All Skills - Javier Aguilar"
  description="Reusable agent skills — content & media, dev workflow, QA & testing, and governance — packaged as Claude skills."
>
  <div class="skills-page">
    <div class="container">
      <a href={`${getLocalizedPath('/', lang)}#skills`} class="back-link">← Back home</a>
    </div>
    <Skills full={true} />
  </div>
</Layout>

<style>
  .skills-page {
    padding-top: var(--space-3xl);
  }
  .back-link {
    display: inline-block;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--primary);
  }
</style>
