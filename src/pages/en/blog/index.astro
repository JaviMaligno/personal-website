---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, type Language } from '../../../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

// Get all English blog posts, sorted by date
const allPosts = await getCollection('blog', ({ data }) => data.lang === 'en');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Cada articulo lleva ya su heroImage en el frontmatter y el fichero
// existe en /public/blog, pero el listado solo mostraba texto: la portada
// se estaba usando unicamente para la tarjeta de redes sociales.
const readingMinutes = (body: string) =>
  Math.max(1, Math.round(body.trim().split(/\s+/).length / 200));

// Language switch for blog index
const langSwitchPath = '/es/blog/';
---

<Layout title={`${t('blog').title} | Javier Aguilar`} description={t('blog').subtitle} langSwitchOverride={langSwitchPath}>
  <section class="blog-hero">
    <div class="container">
      <h1>{t('blog').title}</h1>
      <p class="subtitle">{t('blog').subtitle}</p>
    </div>
  </section>

  <section class="blog-list">
    <div class="container">
      {posts.length === 0 ? (
        <p class="no-articles">{t('blog').noArticles}</p>
      ) : (
        <div class="articles-grid">
          {posts.map((post) => (
            <article class="article-card">
              <a href={`/en/blog/${post.slug.replace('en/', '')}/`}>
                {post.data.heroImage && (
                  <img
                    class="article-cover"
                    src={post.data.heroImage}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="450"
                  />
                )}
                <div class="article-content">
                  <div class="article-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </time>
                    <span class="meta-sep" aria-hidden="true">&middot;</span>
                    <span>{readingMinutes(post.body)} min read</span>
                  </div>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <div class="article-tags">
                      {post.data.tags.slice(0, 3).map(tag => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  )}
                  <span class="read-more">{t('blog').readMore} &rarr;</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    padding: calc(72px + var(--space-3xl)) 0 var(--space-2xl);
    text-align: center;
  }

  .blog-hero h1 {
    font-size: 3rem;
    margin-bottom: var(--space-md);
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .blog-list {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  .no-articles {
    text-align: center;
    color: var(--text-muted);
    font-size: 1.125rem;
  }

  /* Rejilla de tres en vez de columna unica: con portada, una sola
     columna a 800px hacia una pagina de treinta pantallas. */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-xl);
  }

  .article-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .article-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .article-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .article-cover {
    display: block;
    width: 100%;
    /* height:auto es obligatorio: el atributo height del <img> fija la
       altura como pista de presentacion y anula el aspect-ratio. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }

  .article-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-lg);
  }

  .article-content h2 {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .article-content p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-sm);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .meta-sep {
    opacity: 0.5;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
    padding-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .tag {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text-muted);
  }

  .read-more {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent-text);
  }

  @media (max-width: 768px) {
    .blog-hero h1 {
      font-size: 2rem;
    }

    .subtitle {
      font-size: 1rem;
    }

    .article-card a {
      padding: var(--space-lg);
    }

    .article-content h2 {
      font-size: 1.25rem;
    }
  }
</style>
