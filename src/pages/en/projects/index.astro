---
import Layout from '../../../layouts/Layout.astro';
import { projects } from '../../../data/projects';
import { useTranslations, getLocalizedPath } from '../../../i18n';

const lang = 'en';
const t = useTranslations(lang);

const categoryLabels: Record<string, string> = {
  automation: 'AI Automation',
  assistants: 'AI Assistants',
  mcp: 'MCP',
  domainSystems: 'Domain Systems'
};
---

<Layout
  title="All Projects - Javier Aguilar"
  description="Explore all AI projects: automation pipelines, assistants, MCP connectors, and domain systems."
>
  <section class="all-projects">
    <div class="container">
      <a href={`${getLocalizedPath('/', lang)}#projects`} class="back-link">← Back to projects</a>

      <div class="section-header">
        <h1>All Projects</h1>
        <p>Complete portfolio of AI automation systems</p>
      </div>

      <div class="category-filters">
        <button class="filter-btn active" data-filter="all">All</button>
        {Object.entries(categoryLabels).map(([key, label]) => (
          <button class="filter-btn" data-filter={key}>{label}</button>
        ))}
      </div>

      <div class="grid grid-2">
        {projects.map((project) => (
          <div class="card project-card" data-project-category={project.category}>
            <div class="project-header">
              <span class="category-badge" data-category={project.category}>
                {categoryLabels[project.category]}
              </span>
            </div>
            <h3>{t('projects')[project.key].title}</h3>
            <p>{t('projects')[project.key].description}</p>

            <div class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <div class="project-actions">
              <a
                href={`${getLocalizedPath('/', lang)}projects/${project.slug}`}
                class="btn btn-primary btn-sm"
              >
                {t('projectDetails').viewDetails}
              </a>
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                  GitHub
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const category = params.get('category');
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card');

  function filter(cat) {
    cards.forEach(card => {
      card.style.display = (!cat || cat === 'all' || card.dataset.projectCategory === cat) ? '' : 'none';
    });
    buttons.forEach(btn => {
      btn.classList.toggle('active', btn.dataset.filter === (cat || 'all'));
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      filter(f);
      const url = new URL(window.location);
      if (f === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', f);
      history.replaceState(null, '', url);
    });
  });

  if (category) filter(category);
</script>

<style>
  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
    margin-bottom: var(--space-xl);
  }

  .filter-btn {
    padding: 0.4rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    background: var(--glass-border);
    color: var(--text-primary);
  }

  .filter-btn.active {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #fff;
  }

  .all-projects {
    padding: var(--space-3xl) 0;
  }

  .back-link {
    display: inline-block;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: var(--space-xl);
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--primary);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-header h1 {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
  }

  .section-header p {
    color: var(--text-muted);
  }

  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-header {
    margin-bottom: var(--space-sm);
  }

  .category-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
  }

  .category-badge[data-category="automation"] {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.3);
    color: #818cf8;
  }

  .category-badge[data-category="assistants"] {
    background: rgba(56, 189, 248, 0.15);
    border-color: rgba(56, 189, 248, 0.3);
    color: #38bdf8;
  }

  .category-badge[data-category="mcp"] {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.3);
    color: #4ade80;
  }

  .category-badge[data-category="domainSystems"] {
    background: rgba(251, 146, 60, 0.15);
    border-color: rgba(251, 146, 60, 0.3);
    color: #fb923c;
  }

  .project-card h3 {
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }

  .project-card p {
    flex-grow: 1;
    font-size: 0.9375rem;
  }

  .project-actions {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
  }
</style>
