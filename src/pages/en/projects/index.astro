---
import Layout from '../../../layouts/Layout.astro';
import { projects } from '../../../data/projects';
import { useTranslations, getLocalizedPath } from '../../../i18n';

const lang = 'en';
const t = useTranslations(lang);

const categoryLabels: Record<string, string> = {
  agentPipelines: 'AI Pipelines',
  mcp: 'MCP',
  compliance: 'Compliance'
};
---

<Layout
  title="All Projects - Javier Aguilar"
  description="Explore all AI automation projects: agent pipelines, MCP servers, and compliance systems."
>
  <section class="all-projects">
    <div class="container">
      <a href={`${getLocalizedPath('/', lang)}#projects`} class="back-link">← Back to projects</a>

      <div class="section-header">
        <h1>All Projects</h1>
        <p>Complete portfolio of AI automation systems</p>
      </div>

      <div class="grid grid-2">
        {projects.map((project) => (
          <div class="card project-card">
            <div class="project-header">
              <span class="category-badge" data-category={project.category}>
                {categoryLabels[project.category]}
              </span>
            </div>
            <h3>{t('projects')[project.key].title}</h3>
            <p>{t('projects')[project.key].description}</p>

            <div class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <div class="project-actions">
              <a
                href={`${getLocalizedPath('/', lang)}projects/${project.slug}`}
                class="btn btn-primary btn-sm"
              >
                {t('projectDetails').viewDetails}
              </a>
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                  GitHub
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .all-projects {
    padding: var(--space-3xl) 0;
  }

  .back-link {
    display: inline-block;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: var(--space-xl);
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--primary);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-header h1 {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
  }

  .section-header p {
    color: var(--text-muted);
  }

  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-header {
    margin-bottom: var(--space-sm);
  }

  .category-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
  }

  .category-badge[data-category="agentPipelines"] {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.3);
    color: #818cf8;
  }

  .category-badge[data-category="mcp"] {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.3);
    color: #4ade80;
  }

  .category-badge[data-category="compliance"] {
    background: rgba(251, 146, 60, 0.15);
    border-color: rgba(251, 146, 60, 0.3);
    color: #fb923c;
  }

  .project-card h3 {
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }

  .project-card p {
    flex-grow: 1;
    font-size: 0.9375rem;
  }

  .project-actions {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
  }
</style>
