---
import Layout from '../../../layouts/Layout.astro';
import Skills from '../../../components/Skills.astro';
import { getLocalizedPath } from '../../../i18n';

const lang = 'es';
---

<Layout
  title="Todas las Skills - Javier Aguilar"
  description="Skills de agente reutilizables — contenido y media, flujo de desarrollo, QA y testing, y gobernanza — empaquetadas como skills de Claude."
>
  <div class="skills-page">
    <div class="container">
      <a href={`${getLocalizedPath('/', lang)}#skills`} class="back-link">← Volver al inicio</a>
    </div>
    <Skills full={true} />
  </div>
</Layout>

<style>
  .skills-page {
    padding-top: var(--space-3xl);
  }
  .back-link {
    display: inline-block;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--primary);
  }
</style>
