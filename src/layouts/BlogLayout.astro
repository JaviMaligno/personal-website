---
import "../styles/global.css";
import {
  getLangFromUrl,
  useTranslations,
  languages,
  getLocalizedPath,
  type Language,
} from "../i18n";
import { social } from "../config";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  translationSlug?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  translationSlug,
} = Astro.props;

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const otherLang = lang === "en" ? "es" : "en";

// Canonical and alternate URLs
const siteUrl = "https://www.javieraguilar.ai";
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const currentSlug = Astro.url.pathname.split("/").filter(Boolean).pop();

// For blog pages, construct alternate language URL
const langSwitchPath = translationSlug
  ? `/${otherLang}/blog/${translationSlug}/`
  : `/${otherLang}/blog/`;

const alternateUrl = translationSlug
  ? `${siteUrl}/${otherLang}/blog/${translationSlug}/`
  : null;

// Article image - use heroImage if provided, otherwise default to og-image
const articleImage = heroImage
  ? heroImage.startsWith("http")
    ? heroImage
    : `${siteUrl}${heroImage}`
  : `${siteUrl}/og-image.png`;

// Schema.org Article structured data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  image: articleImage,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: "Javier Aguilar",
    url: siteUrl,
    jobTitle: "AI Agent Architect",
    sameAs: [social.github, social.linkedin],
  },
  publisher: {
    "@type": "Organization",
    name: "AGILabs",
    url: siteUrl,
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/og-image.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  keywords: tags.join(", "),
  inLanguage: lang === "en" ? "en-US" : "es-ES",
};

const formattedDate = pubDate.toLocaleDateString(
  lang === "es" ? "es-ES" : "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);

const formattedUpdatedDate = updatedDate?.toLocaleDateString(
  lang === "es" ? "es-ES" : "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Javier Aguilar" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={articleImage} />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Canonical and hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateUrl && (
        <link
          rel="alternate"
          hreflang={otherLang === "en" ? "en" : "es"}
          href={alternateUrl}
        />
      )
    }
    {/* x-default should always point to English version */}
    {
      (lang === "en" || alternateUrl) && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={lang === "en" ? canonicalUrl : alternateUrl}
        />
      )
    }

    <!-- Schema.org structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />

    <!-- Fonts - use system font stack with Inter as enhancement -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      /></noscript
    >

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Javier Aguilar</title>

    <!-- Calendly widget loaded on-demand -->
    <script is:inline>
      window.loadCalendlyPopup = function (url) {
        if (window.Calendly) {
          Calendly.initPopupWidget({ url: url });
        } else {
          // Load CSS
          var css = document.createElement("link");
          css.rel = "stylesheet";
          css.href = "https://assets.calendly.com/assets/external/widget.css";
          document.head.appendChild(css);
          // Load JS
          var script = document.createElement("script");
          script.src = "https://assets.calendly.com/assets/external/widget.js";
          script.onload = function () {
            Calendly.initPopupWidget({ url: url });
          };
          document.head.appendChild(script);
        }
      };
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" integrity="sha384-zh0CIslj+VczCZtlzBcjt5ppRcsAmDnRem7ESsYwWwg3m/OaJ2l4x7YBZl9Kxxib" crossorigin="anonymous">
  </head>
  <body>
    <!-- Header -->
    <header class="header">
      <div class="container header-container">
        <a href={getLocalizedPath("/", lang)} class="logo">
          <span class="logo-name">Javier Aguilar</span>
          <span class="logo-badge">AGILabs</span>
        </a>

        <nav class="nav">
          <a href={`${getLocalizedPath("/", lang)}#services`}
            >{t("nav").services}</a
          >
          <a href={`${getLocalizedPath("/", lang)}#projects`}
            >{t("nav").projects}</a
          >
          <a href={getLocalizedPath("/blog/", lang)}>{t("nav").blog}</a>
          <a href={`${getLocalizedPath("/", lang)}#contact`}
            >{t("nav").contact}</a
          >
          <a
            href="#"
            onclick="window.loadCalendlyPopup && window.loadCalendlyPopup('https://calendly.com/javiecija96/discovery-call?hide_landing_page_details=1&hide_gdpr_banner=1&primary_color=6366f1');return false;"
            class="btn btn-primary btn-sm">{t("cta").bookCall}</a
          >
          <a
            href={langSwitchPath}
            class="lang-switch"
            title={languages[otherLang]}
          >
            {otherLang.toUpperCase()}
          </a>
        </nav>

        <button class="mobile-menu-btn" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <main class="blog-main">
      <div class="container">
        <article class="blog-article">
          <header class="article-header">
            <a href={getLocalizedPath("/blog/", lang)} class="back-link">
              &larr; {t("blog").backToBlog}
            </a>
            <h1>{title}</h1>
            <div class="article-meta">
              <time datetime={pubDate.toISOString()}>{formattedDate}</time>
              {
                updatedDate && (
                  <span class="updated">
                    ({t("blog").updated}: {formattedUpdatedDate})
                  </span>
                )
              }
            </div>
            {
              heroImage && (
                <img
                  width={1020}
                  height={510}
                  src={heroImage}
                  alt={title}
                  class="hero-image"
                />
              )
            }
            {
              tags.length > 0 && (
                <div class="article-tags">
                  {tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )
            }
          </header>

          <div class="article-content">
            <slot />
          </div>

          <footer class="article-footer">
            <div class="author-box">
              <div class="author-info">
                <span class="author-name">Javier Aguilar</span>
                <span class="author-role">AI Agent Architect</span>
              </div>
            </div>
            <a
              href={`${getLocalizedPath("/", lang)}#contact`}
              class="btn btn-primary"
            >
              {t("blog").getInTouch}
            </a>
          </footer>
        </article>
      </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <p class="footer-manifesto">{t("footer").manifesto}</p>
        <div class="footer-links">
          <a href={social.github} target="_blank" rel="noopener">GitHub</a>
          <a href={social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
        <p class="footer-copyright">
          {t("footer").copyright.replace("{year}", currentYear.toString())}
        </p>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const menuBtn = document.querySelector(".mobile-menu-btn");
      const nav = document.querySelector(".nav");

      menuBtn?.addEventListener("click", () => {
        nav?.classList.toggle("open");
        menuBtn.classList.toggle("open");
      });

      // Close menu on link click
      document.querySelectorAll(".nav a").forEach((link) => {
        link.addEventListener("click", () => {
          nav?.classList.remove("open");
          menuBtn?.classList.remove("open");
        });
      });
    </script>
  </body>
</html>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(10, 10, 15, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--glass-border);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
  }

  .logo-name {
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .logo-badge {
    font-size: 0.625rem;
    font-weight: 500;
    padding: 0.25rem 0.5rem;
    background: var(--accent-gradient);
    border-radius: var(--radius-sm);
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .nav a:hover {
    color: var(--text-primary);
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .lang-switch {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    color: var(--text-muted) !important;
  }

  .lang-switch:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary) !important;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .blog-main {
    padding-top: calc(72px + var(--space-2xl));
    padding-bottom: var(--space-2xl);
    min-height: 100vh;
  }

  .blog-article {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: var(--space-lg);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-primary);
  }

  .article-header {
    margin-bottom: var(--space-2xl);
  }

  .article-header h1 {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: var(--space-md);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: var(--space-md);
  }

  .updated {
    font-style: italic;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
  }

  .hero-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-xl);
    border: 1px solid var(--glass-border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .article-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .article-content :global(h2) {
    font-size: 1.75rem;
    color: var(--text-primary);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
  }

  .article-content :global(h3) {
    font-size: 1.375rem;
    color: var(--text-primary);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .article-content :global(p) {
    margin-bottom: var(--space-md);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .article-content :global(li) {
    margin-bottom: var(--space-xs);
  }

  .article-content :global(code) {
    font-family: "Fira Code", monospace;
    font-size: 0.9em;
    padding: 0.2em 0.4em;
    background: var(--bg-card);
    border-radius: var(--radius-sm);
  }

  .article-content :global(pre) {
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    overflow-x: auto;
    margin-bottom: var(--space-md);
  }

  .article-content :global(pre code) {
    padding: 0;
    background: none;
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--accent-primary);
    padding-left: var(--space-md);
    margin: var(--space-lg) 0;
    font-style: italic;
    color: var(--text-muted);
  }

  .article-content :global(a) {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  .article-content :global(a:hover) {
    color: var(--accent-secondary);
  }

  /* KaTeX: hide MathML source, show only rendered HTML */
  .article-content :global(.katex-mathml) {
    position: absolute;
    clip: rect(1px, 1px, 1px, 1px);
    padding: 0;
    border: 0;
    height: 1px;
    width: 1px;
    overflow: hidden;
  }

  .article-content :global(.katex-display) {
    margin: var(--space-md) 0;
    text-align: center;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--space-xl) 0;
    border: 1px solid var(--glass-border);
  }

  .article-content :global(.table-wrap) {
    overflow-x: auto;
    margin: var(--space-xl) 0;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: 0.7rem 1.1rem;
    text-align: left;
    border: 1px solid var(--glass-border);
    vertical-align: top;
    white-space: nowrap;
  }

  .article-content :global(th) {
    background: var(--glass-bg, rgba(255, 255, 255, 0.04));
    font-weight: 600;
  }

  .article-content :global(tbody tr:nth-child(even)) {
    background: rgba(255, 255, 255, 0.02);
  }

  .article-footer {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .author-box {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .author-role {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .footer {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--glass-border);
    text-align: center;
  }

  .footer-manifesto {
    font-size: 1.125rem;
    font-style: italic;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .footer-links a {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .footer-copyright {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .nav {
      position: fixed;
      top: 72px;
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-xl);
      background: var(--bg-primary);
      opacity: 0;
      visibility: hidden;
      transition: all var(--transition-base);
    }

    .nav.open {
      opacity: 1;
      visibility: visible;
    }

    .nav a {
      font-size: 1.25rem;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .mobile-menu-btn.open span:nth-child(1) {
      transform: rotate(45deg) translate(4px, 4px);
    }

    .mobile-menu-btn.open span:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu-btn.open span:nth-child(3) {
      transform: rotate(-45deg) translate(4px, -4px);
    }

    .article-header h1 {
      font-size: 1.75rem;
    }

    .article-footer {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
