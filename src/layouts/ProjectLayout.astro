---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, languages, getLocalizedPath, type Language } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Project - Javier Aguilar', description = 'Project case study' } = Astro.props;

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const otherLang = lang === 'en' ? 'es' : 'en';

// For project pages, we need to construct the alternate language URL
const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(en|es)/, '');
const langSwitchPath = `/${otherLang}${pathWithoutLang}`;

// Canonical and alternate URLs
const siteUrl = 'https://www.javieraguilar.ai';
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const alternateUrl = `${siteUrl}${langSwitchPath}`;

// Schema.org for case study / project
const projectSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "author": {
    "@type": "Person",
    "name": "Javier Aguilar",
    "jobTitle": "AI Agent Architect",
    "url": siteUrl
  },
  "inLanguage": lang === 'en' ? 'en-US' : 'es-ES'
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Javier Aguilar" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Canonical and hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang === 'en' ? 'en' : 'es'} href={canonicalUrl} />
    <link rel="alternate" hreflang={otherLang === 'en' ? 'en' : 'es'} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en${pathWithoutLang}`} />

    <!-- Schema.org structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />

    <!-- Fonts - use system font stack with Inter as enhancement -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" /></noscript>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Calendly widget loaded on-demand -->
    <script is:inline>
      window.loadCalendlyPopup = function(url) {
        if (window.Calendly) {
          Calendly.initPopupWidget({ url: url });
        } else {
          // Load CSS
          var css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = 'https://assets.calendly.com/assets/external/widget.css';
          document.head.appendChild(css);
          // Load JS
          var script = document.createElement('script');
          script.src = 'https://assets.calendly.com/assets/external/widget.js';
          script.onload = function() { Calendly.initPopupWidget({ url: url }); };
          document.head.appendChild(script);
        }
      };
    </script>
  </head>
  <body>
    <!-- Header -->
    <header class="header">
      <div class="container header-container">
        <a href={getLocalizedPath('/', lang)} class="logo">
          <span class="logo-name">Javier Aguilar</span>
          <span class="logo-badge">AGILabs</span>
        </a>

        <nav class="nav">
          <a href={`${getLocalizedPath('/', lang)}#services`}>{t('nav').services}</a>
          <a href={`${getLocalizedPath('/', lang)}#projects`}>{t('nav').projects}</a>
          <a href={getLocalizedPath('/blog/', lang)}>{t('nav').blog}</a>
          <a href={`${getLocalizedPath('/', lang)}#process`}>{t('nav').process}</a>
          <a href={`${getLocalizedPath('/', lang)}#contact`}>{t('nav').contact}</a>
          <a href="#" onclick="window.loadCalendlyPopup && window.loadCalendlyPopup('https://calendly.com/javiecija96/discovery-call?hide_landing_page_details=1&hide_gdpr_banner=1&primary_color=6366f1');return false;" class="btn btn-primary btn-sm">{t('cta').bookCall}</a>
          <a href={langSwitchPath} class="lang-switch" title={languages[otherLang]}>
            {otherLang.toUpperCase()}
          </a>
        </nav>

        <button class="mobile-menu-btn" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <main class="project-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <p class="footer-manifesto">{t('footer').manifesto}</p>
        <div class="footer-links">
          <a href="https://github.com/JaviMaligno" target="_blank" rel="noopener">GitHub</a>
          <a href="https://linkedin.com/in/javier-aguilar-mart%C3%ADn-85575711a/" target="_blank" rel="noopener">LinkedIn</a>
        </div>
        <p class="footer-copyright">{t('footer').copyright.replace('{year}', currentYear.toString())}</p>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const menuBtn = document.querySelector('.mobile-menu-btn');
      const nav = document.querySelector('.nav');

      menuBtn?.addEventListener('click', () => {
        nav?.classList.toggle('open');
        menuBtn.classList.toggle('open');
      });

      // Close menu on link click
      document.querySelectorAll('.nav a').forEach(link => {
        link.addEventListener('click', () => {
          nav?.classList.remove('open');
          menuBtn?.classList.remove('open');
        });
      });
    </script>
  </body>
</html>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(10, 10, 15, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--glass-border);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
  }

  .logo-name {
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .logo-badge {
    font-size: 0.625rem;
    font-weight: 500;
    padding: 0.25rem 0.5rem;
    background: var(--accent-gradient);
    border-radius: var(--radius-sm);
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .nav a:hover {
    color: var(--text-primary);
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .lang-switch {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    color: var(--text-muted) !important;
  }

  .lang-switch:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary) !important;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .project-main {
    padding-top: calc(72px + var(--space-2xl));
    padding-bottom: var(--space-2xl);
    min-height: 100vh;
  }

  .footer {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--glass-border);
    text-align: center;
  }

  .footer-manifesto {
    font-size: 1.125rem;
    font-style: italic;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .footer-links a {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .footer-copyright {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .nav {
      position: fixed;
      top: 72px;
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-xl);
      background: var(--bg-primary);
      opacity: 0;
      visibility: hidden;
      transition: all var(--transition-base);
    }

    .nav.open {
      opacity: 1;
      visibility: visible;
    }

    .nav a {
      font-size: 1.25rem;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .mobile-menu-btn.open span:nth-child(1) {
      transform: rotate(45deg) translate(4px, 4px);
    }

    .mobile-menu-btn.open span:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu-btn.open span:nth-child(3) {
      transform: rotate(-45deg) translate(4px, -4px);
    }
  }
</style>
