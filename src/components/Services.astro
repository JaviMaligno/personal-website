---
import { getLangFromUrl, useTranslations, type Language } from '../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const services = [
  {
    icon: '🔄',
    key: 'agentPipelines' as const
  },
  {
    icon: '🔌',
    key: 'mcpDevelopment' as const
  },
  {
    icon: '🛡️',
    key: 'complianceAutomation' as const
  }
];
---

<section id="services" class="services">
  <div class="container">
    <div class="section-header">
      <h2>{t('services').title}</h2>
      <p>{t('services').subtitle}</p>
    </div>
    
    <div class="grid grid-3">
      {services.map((service) => (
        <div class="card service-card">
          <div class="icon">{service.icon}</div>
          <h3>{t('services')[service.key].title}</h3>
          <p>{t('services')[service.key].description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--bg-secondary);
  }
  
  .service-card h3 {
    margin-bottom: var(--space-sm);
  }
  
  .service-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
  }
</style>
