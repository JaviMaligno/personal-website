---
import { getLangFromUrl, useTranslations, getLocalizedPath, type Language } from '../i18n';
import { getFeaturedProjects } from '../data/projects';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const featuredProjects = getFeaturedProjects();

// Category labels for display
const categoryLabels: Record<string, string> = {
  automation: lang === 'es' ? 'Automatización IA' : 'AI Automation',
  assistants: lang === 'es' ? 'Asistentes IA' : 'AI Assistants',
  mcp: 'MCP',
  domainSystems: lang === 'es' ? 'Sistemas de Dominio' : 'Domain Systems',
  products: lang === 'es' ? 'Productos' : 'Products'
};
---

<section id="projects" class="projects">
  <div class="container">
    <div class="section-header">
      <h2>{t('projects').title}</h2>
      <p>{t('projects').subtitle}</p>
    </div>
    
    <div class="grid grid-3">
      {featuredProjects.map((project) => (
        <div class="card project-card">
          <div class="project-header">
            <span class="category-badge" data-category={project.category}>
              {categoryLabels[project.category]}
            </span>
          </div>
          <h3>{t('projects')[project.key].title}</h3>
          <p>{t('projects')[project.key].description}</p>

          <div class="tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>

          <div class="project-actions">
            <a
              href={`${getLocalizedPath('/', lang)}projects/${project.slug}`}
              class="project-link project-link-primary"
            >
              {t('projectDetails').viewDetails} <span aria-hidden="true">&rarr;</span>
            </a>
            {project.liveUrl && (
              <a href={project.liveUrl} target="_blank" rel="noopener" class="project-link">
                {t('projectDetails').viewLive}
              </a>
            )}
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener" class="project-link">
                GitHub
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="view-all">
      <a href={`${getLocalizedPath('/', lang)}projects`} class="view-all-link">
        {lang === 'es' ? 'Ver todos los proyectos' : 'View all projects'} →
      </a>
    </div>
  </div>
</section>


<style>
  .project-card {
    display: flex;
    flex-direction: column;
  }
  
  .project-header {
    margin-bottom: var(--space-sm);
  }
  
  /* Una sola etiqueta para las cinco categorias: el color distinguia
     familias que el lector no conoce todavia, y el arcoiris competia con
     el acento de la marca. El texto ya dice de que familia es. */
  .category-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0;
    color: var(--text-muted);
  }
  




  
  .project-card h3 {
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }
  
  .project-card p {
    flex-grow: 1;
    font-size: 0.9375rem;
  }
  
  /* Seis botones rellenos en una rejilla de seis tarjetas no jerarquizan
     nada: el relleno del acento se reserva para la accion de la pagina,
     y dentro de la tarjeta basta un enlace. */
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: auto;
    padding-top: var(--space-lg);
  }

  .project-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .project-link:hover {
    color: var(--text-primary);
  }

  .project-link-primary {
    color: var(--accent-text);
  }

  .project-link-primary:hover {
    color: var(--text-primary);
  }

  .view-all {
    text-align: center;
    margin-top: var(--space-xl);
  }

  .view-all-link {
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .view-all-link:hover {
    color: var(--primary);
  }
</style>
