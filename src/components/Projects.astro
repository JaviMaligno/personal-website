---
import { getLangFromUrl, useTranslations, type Language } from '../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

// Category labels for display
const categoryLabels = {
  agentPipelines: lang === 'es' ? 'Pipelines IA' : 'AI Pipelines',
  mcp: 'MCP',
  compliance: lang === 'es' ? 'Cumplimiento' : 'Compliance'
};

// Projects with category mapping to service types
const projects = [
  {
    key: 'devopsAgent' as const,
    category: 'agentPipelines' as keyof typeof categoryLabels,
    tags: ['TypeScript', 'Multi-Agent', 'GitHub API'],
    github: 'https://github.com/javieraguilarmartin/oss-agent'
  },
  {
    key: 'complianceClassifier' as const,
    category: 'compliance' as keyof typeof categoryLabels,
    tags: ['Python', 'LangChain', 'Risk Assessment'],
    github: null
  },
  {
    key: 'dataSourceAutomator' as const,
    category: 'agentPipelines' as keyof typeof categoryLabels,
    tags: ['Python', 'Multi-Agent', 'HITL'],
    github: null
  },
  {
    key: 'mcpGallery' as const,
    category: 'mcp' as keyof typeof categoryLabels,
    tags: ['TypeScript', 'Python', 'MCP'],
    github: 'https://github.com/javieraguilarmartin'
  },
  {
    key: 'applicationAutomator' as const,
    category: 'agentPipelines' as keyof typeof categoryLabels,
    tags: ['Python', 'Automation', 'Email'],
    github: null
  },
  {
    key: 'medicalDocParser' as const,
    category: 'compliance' as keyof typeof categoryLabels,
    tags: ['Python', 'NLP', 'ICD-10'],
    github: null
  }
];
---

<section id="projects" class="projects">
  <div class="container">
    <div class="section-header">
      <h2>{t('projects').title}</h2>
      <p>{t('projects').subtitle}</p>
    </div>
    
    <div class="grid grid-2">
      {projects.map((project) => (
        <div class="card project-card">
          <div class="project-header">
            <span class="category-badge" data-category={project.category}>
              {categoryLabels[project.category]}
            </span>
          </div>
          <h3>{t('projects')[project.key].title}</h3>
          <p>{t('projects')[project.key].description}</p>
          
          <div class="tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          
          <div class="project-actions">
            <button 
              type="button"
              class="btn btn-primary btn-sm project-demo-btn"
              data-project={project.key}
              data-project-title={t('projects')[project.key].title}
              data-category={project.category}
            >
              {t('cta').requestDemo}
            </button>
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                GitHub
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Handle project demo button clicks
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.project-demo-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const target = e.currentTarget as HTMLElement;
        const projectKey = target.dataset.project || '';
        const projectTitle = target.dataset.projectTitle || '';
        const category = target.dataset.category || '';
        
        // Pre-fill the contact form
        const interestSelect = document.getElementById('interest') as HTMLSelectElement;
        if (interestSelect) {
          interestSelect.value = category;
        }
        
        const projectInput = document.getElementById('project') as HTMLInputElement;
        if (projectInput) {
          projectInput.value = projectKey;
        }
        
        const contextBanner = document.getElementById('project-context');
        const contextName = document.getElementById('project-context-name');
        if (contextBanner && contextName) {
          contextName.textContent = projectTitle;
          contextBanner.style.display = 'flex';
        }
        
        // Scroll to contact
        const contactSection = document.getElementById('contact');
        if (contactSection) {
          contactSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  });
</script>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
  }
  
  .project-header {
    margin-bottom: var(--space-sm);
  }
  
  .category-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
  }
  
  .category-badge[data-category="agentPipelines"] {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.3);
    color: #818cf8;
  }
  
  .category-badge[data-category="mcp"] {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.3);
    color: #4ade80;
  }
  
  .category-badge[data-category="compliance"] {
    background: rgba(251, 146, 60, 0.15);
    border-color: rgba(251, 146, 60, 0.3);
    color: #fb923c;
  }
  
  .project-card h3 {
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }
  
  .project-card p {
    flex-grow: 1;
    font-size: 0.9375rem;
  }
  
  .project-actions {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
  
  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
  }
</style>
