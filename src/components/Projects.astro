---
import { getLangFromUrl, useTranslations, getLocalizedPath, type Language } from '../i18n';
import { getFeaturedProjects } from '../data/projects';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const featuredProjects = getFeaturedProjects();

// Category labels for display
const categoryLabels: Record<string, string> = {
  automation: lang === 'es' ? 'Automatización IA' : 'AI Automation',
  assistants: lang === 'es' ? 'Asistentes IA' : 'AI Assistants',
  mcp: 'MCP',
  domainSystems: lang === 'es' ? 'Sistemas de Dominio' : 'Domain Systems'
};
---

<section id="projects" class="projects">
  <div class="container">
    <div class="section-header">
      <h2>{t('projects').title}</h2>
      <p>{t('projects').subtitle}</p>
    </div>
    
    <div class="grid grid-3">
      {featuredProjects.map((project) => (
        <div class="card project-card">
          <div class="project-header">
            <span class="category-badge" data-category={project.category}>
              {categoryLabels[project.category]}
            </span>
          </div>
          <h3>{t('projects')[project.key].title}</h3>
          <p>{t('projects')[project.key].description}</p>

          <div class="tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>

          <div class="project-actions">
            <a
              href={`${getLocalizedPath('/', lang)}projects/${project.slug}`}
              class="btn btn-primary btn-sm"
            >
              {t('projectDetails').viewDetails}
            </a>
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                GitHub
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="view-all">
      <a href={`${getLocalizedPath('/', lang)}projects`} class="view-all-link">
        {lang === 'es' ? 'Ver todos los proyectos' : 'View all projects'} →
      </a>
    </div>
  </div>
</section>


<style>
  .project-card {
    display: flex;
    flex-direction: column;
  }
  
  .project-header {
    margin-bottom: var(--space-sm);
  }
  
  .category-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
  }
  
  .category-badge[data-category="automation"] {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.3);
    color: #818cf8;
  }

  .category-badge[data-category="assistants"] {
    background: rgba(56, 189, 248, 0.15);
    border-color: rgba(56, 189, 248, 0.3);
    color: #38bdf8;
  }

  .category-badge[data-category="mcp"] {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.3);
    color: #4ade80;
  }

  .category-badge[data-category="domainSystems"] {
    background: rgba(251, 146, 60, 0.15);
    border-color: rgba(251, 146, 60, 0.3);
    color: #fb923c;
  }
  
  .project-card h3 {
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }
  
  .project-card p {
    flex-grow: 1;
    font-size: 0.9375rem;
  }
  
  .project-actions {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
  
  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
  }

  .view-all {
    text-align: center;
    margin-top: var(--space-xl);
  }

  .view-all-link {
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .view-all-link:hover {
    color: var(--primary);
  }
</style>
