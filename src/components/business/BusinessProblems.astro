---
import { getLangFromUrl, useTranslations, type Language } from '../../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const problems = t('business').problems.items;

const icons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`
];
---

<section id="problems" class="business-problems">
  <div class="container">
    <h2 class="section-title">{t('business').problems.title}</h2>

    <div class="problems-grid">
      {problems.map((problem: { title: string; description: string }, index: number) => (
        <div class="problem-card">
          <div class="problem-icon" set:html={icons[index]} />
          <h3 class="problem-title">{problem.title}</h3>
          <p class="problem-description">{problem.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .business-problems {
    padding: var(--space-3xl) 0;
    background: var(--bg-secondary);
  }

  .section-title {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin-bottom: var(--space-2xl);
    color: var(--text-primary);
  }

  .problems-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
    max-width: 1000px;
    margin: 0 auto;
  }

  .problem-card {
    text-align: center;
    padding: var(--space-xl);
  }

  .problem-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(239, 68, 68, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-md);
    color: #ef4444;
  }

  .problem-title {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .problem-description {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .problems-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .problem-card {
      padding: var(--space-lg);
    }
  }
</style>
