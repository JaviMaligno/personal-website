---
import { getLangFromUrl, useTranslations, type Language } from '../../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
---

<section id="contact" class="business-cta">
  <div class="container">
    <div class="cta-content">
      <h2 class="cta-title">{t('business').cta.title}</h2>
      <p class="cta-subtitle">{t('business').cta.subtitle}</p>

      <a href="#" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/javiecija96/discovery-call?hide_landing_page_details=1&hide_gdpr_banner=1&primary_color=6366f1'});return false;" class="btn btn-primary btn-large">
        {t('business').cta.button}
      </a>
    </div>
  </div>
</section>

<style>
  .business-cta {
    padding: var(--space-3xl) 0;
    background: var(--bg-secondary);
  }

  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: var(--space-md);
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cta-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-bottom: var(--space-xl);
    line-height: 1.6;
  }

  .btn-large {
    padding: 1rem 2.5rem;
    font-size: 1.125rem;
  }

  @media (max-width: 768px) {
    .btn-large {
      width: 100%;
    }
  }
</style>
