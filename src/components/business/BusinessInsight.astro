---
import { getLangFromUrl, useTranslations, type Language } from '../../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
---

<section class="business-insight">
  <div class="container">
    <div class="insight-content">
      <div class="insight-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/>
        </svg>
      </div>
      <blockquote class="insight-quote">
        {t('business').insight.quote}
      </blockquote>
      <p class="insight-explanation">
        {t('business').insight.explanation}
      </p>
    </div>
  </div>
</section>

<style>
  .business-insight {
    padding: var(--space-2xl) 0;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
    border-top: 1px solid rgba(99, 102, 241, 0.1);
    border-bottom: 1px solid rgba(99, 102, 241, 0.1);
  }

  .insight-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .insight-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--accent-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-lg);
    color: white;
  }

  .insight-quote {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-md);
    line-height: 1.3;
    font-style: normal;
  }

  .insight-explanation {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .business-insight {
      padding: var(--space-xl) 0;
    }
  }
</style>
