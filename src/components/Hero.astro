---
import { getLangFromUrl, useTranslations, type Language } from '../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title">{t('hero').title}</h1>
      <p class="hero-subtitle">{t('hero').subtitle}</p>
      <p class="hero-subheadline">{t('hero').subheadline}</p>
      <p class="hero-role">{t('hero').role}</p>
      <p class="hero-founder">{t('hero').founder}</p>
      
      <div class="hero-cta">
        <a href="#" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/javiecija96/discovery-call?hide_landing_page_details=1&hide_gdpr_banner=1&primary_color=6366f1'});return false;" class="btn btn-primary">{t('cta').bookCall}</a>
        <a href="#projects" class="btn btn-secondary">{t('cta').viewProjects}</a>
      </div>
    </div>
    
    <div class="hero-visual">
      <div class="hero-glow"></div>
      <div class="agent-flow">
        <div class="flow-node input">
          <span class="node-icon">?</span>
          <span class="node-label">Request</span>
        </div>
        <div class="flow-connector"><div class="connector-pulse"></div></div>
        <div class="flow-cluster">
          <div class="flow-node agent supervisor">
            <span class="node-icon">S</span>
            <span class="node-label">Supervisor</span>
          </div>
          <div class="cluster-workers">
            <div class="flow-node agent worker">R</div>
            <div class="flow-node agent worker">A</div>
            <div class="flow-node agent worker">C</div>
          </div>
        </div>
        <div class="flow-connector"><div class="connector-pulse delay-1"></div></div>
        <div class="flow-node review">
          <span class="node-icon">H</span>
          <span class="node-label">Review</span>
        </div>
        <div class="flow-connector"><div class="connector-pulse delay-2"></div></div>
        <div class="flow-node output">
          <span class="node-icon">✓</span>
          <span class="node-label">Result</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: auto;
    display: flex;
    align-items: center;
    padding-top: 120px;
    padding-bottom: var(--space-xl);
    position: relative;
    overflow: hidden;
  }
  
  .hero-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
  }
  
  .hero-content {
    max-width: 600px;
    position: relative;
    z-index: 2;
  }
  
  .hero-title {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;
    margin-bottom: var(--space-md);
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .hero-subtitle {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
    line-height: 1.4;
  }

  .hero-subheadline {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .hero-role {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-xs);
  }
  
  .hero-founder {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-xl);
  }
  
  .hero-cta {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  
  .hero-visual {
    position: absolute;
    right: -10%;
    top: 50%;
    transform: translateY(-50%);
    width: 600px;
    height: 600px;
    pointer-events: none;
  }
  
  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, var(--accent-glow) 0%, transparent 70%);
    filter: blur(60px);
    animation: pulse 4s ease-in-out infinite;
  }
  
  /* Agent Flow Visualization */
  .agent-flow {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-xl);
  }

  .flow-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    background: #0f172a;
    border: 1px solid var(--glass-border);
    animation: float 8s ease-in-out infinite;
    position: relative;
  }

  .flow-node .node-icon {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .flow-node .node-label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  /* Node types */
  .flow-node.input {
    border-color: #334155;
    animation-delay: 0s;
  }

  .flow-node.input .node-icon {
    color: var(--text-secondary);
  }

  .flow-node.agent {
    border-color: #3b82f6;
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.2);
  }

  .flow-node.agent .node-icon {
    color: #60a5fa;
  }

  .flow-node.supervisor {
    animation-delay: 0.5s;
  }

  .flow-node.review {
    background: #3b0764;
    border-color: #a855f7;
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.2);
    animation-delay: 1s;
  }

  .flow-node.review .node-icon {
    color: #c084fc;
  }

  .flow-node.output {
    border-color: #22c55e;
    box-shadow: 0 0 20px rgba(34, 197, 94, 0.2);
    animation-delay: 1.5s;
  }

  .flow-node.output .node-icon {
    color: #4ade80;
  }

  /* Worker nodes cluster */
  .flow-cluster {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .cluster-workers {
    display: flex;
    gap: var(--space-xs);
  }

  .flow-node.worker {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    animation-delay: 0.75s;
  }

  /* Connection lines */
  .flow-connector {
    width: 2px;
    height: 20px;
    background: var(--glass-border);
    position: relative;
    overflow: hidden;
  }

  .connector-pulse {
    position: absolute;
    width: 100%;
    height: 8px;
    background: linear-gradient(to bottom, transparent, var(--accent-primary), transparent);
    animation: pulse-flow 2s ease-in-out infinite;
  }

  .connector-pulse.delay-1 {
    animation-delay: 0.5s;
  }

  .connector-pulse.delay-2 {
    animation-delay: 1s;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.1); }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes pulse-flow {
    0% { top: -8px; opacity: 0; }
    50% { opacity: 1; }
    100% { top: 20px; opacity: 0; }
  }
  
  @media (max-width: 768px) {
    .hero {
      text-align: center;
    }
    
    .hero-cta {
      justify-content: center;
    }
    
    .hero-visual {
      display: none;
    }
  }
</style>
