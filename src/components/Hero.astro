---
import { getLangFromUrl, useTranslations, type Language } from '../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title">{t('hero').title}</h1>
      <p class="hero-subtitle">{t('hero').subtitle}</p>
      <p class="hero-subheadline">{t('hero').subheadline}</p>
      <p class="hero-role">{t('hero').role}</p>
      <p class="hero-founder">{t('hero').founder}</p>
      
      <div class="hero-cta">
        <a href="#" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/javiecija96/discovery-call?hide_landing_page_details=1&hide_gdpr_banner=1&primary_color=6366f1'});return false;" class="btn btn-primary">{t('cta').bookCall}</a>
        <a href="#projects" class="btn btn-secondary">{t('cta').viewProjects}</a>
      </div>
    </div>
    
    <div class="hero-visual">
      <div class="hero-glow"></div>
      <div class="pipeline-flow">
        <div class="pipeline-node supervisor">Supervisor</div>
        <div class="pipeline-connector"><div class="connector-pulse"></div></div>
        <div class="pipeline-workers">
          <div class="pipeline-node worker">Researcher</div>
          <div class="pipeline-node worker">Analyst</div>
        </div>
        <div class="pipeline-connector"><div class="connector-pulse delay-1"></div></div>
        <div class="pipeline-node review">Human Review</div>
        <div class="pipeline-connector"><div class="connector-pulse delay-2"></div></div>
        <div class="pipeline-node coder">Coder</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: auto;
    display: flex;
    align-items: center;
    padding-top: 120px;
    padding-bottom: var(--space-xl);
    position: relative;
    overflow: hidden;
  }
  
  .hero-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
  }
  
  .hero-content {
    max-width: 600px;
    position: relative;
    z-index: 2;
  }
  
  .hero-title {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;
    margin-bottom: var(--space-md);
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .hero-subtitle {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
    line-height: 1.4;
  }

  .hero-subheadline {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .hero-role {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-xs);
  }
  
  .hero-founder {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-xl);
  }
  
  .hero-cta {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  
  .hero-visual {
    position: absolute;
    right: -10%;
    top: 50%;
    transform: translateY(-50%);
    width: 600px;
    height: 600px;
    pointer-events: none;
  }
  
  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, var(--accent-glow) 0%, transparent 70%);
    filter: blur(60px);
    animation: pulse 4s ease-in-out infinite;
  }
  
  /* Pipeline Flow Visualization */
  .pipeline-flow {
    position: absolute;
    top: 28%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: var(--space-lg);
    background: rgba(0, 0, 0, 0.3);
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border);
  }

  .pipeline-node {
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    background: #0f172a;
    border: 1px solid #334155;
    color: var(--text-secondary);
  }

  .pipeline-node.supervisor {
    border-color: #3b82f6;
    color: #60a5fa;
  }

  .pipeline-node.review {
    background: #3b0764;
    border-color: #a855f7;
    color: #c084fc;
  }

  .pipeline-node.coder {
    border-color: #3b82f6;
    color: #60a5fa;
  }

  .pipeline-workers {
    display: flex;
    gap: var(--space-sm);
  }

  .pipeline-workers .pipeline-node {
    font-size: 0.75rem;
    padding: 0.5rem 0.875rem;
  }

  /* Connection lines */
  .pipeline-connector {
    width: 2px;
    height: 24px;
    background: var(--glass-border);
    position: relative;
    overflow: hidden;
  }

  .connector-pulse {
    position: absolute;
    width: 100%;
    height: 10px;
    background: linear-gradient(to bottom, transparent, var(--accent-primary), transparent);
    animation: pulse-flow 2s ease-in-out infinite;
  }

  .connector-pulse.delay-1 {
    animation-delay: 0.6s;
  }

  .connector-pulse.delay-2 {
    animation-delay: 1.2s;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.1); }
  }

  @keyframes pulse-flow {
    0% { top: -10px; opacity: 0; }
    50% { opacity: 1; }
    100% { top: 24px; opacity: 0; }
  }
  
  @media (max-width: 768px) {
    .hero {
      text-align: center;
    }
    
    .hero-cta {
      justify-content: center;
    }
    
    .hero-visual {
      display: none;
    }
  }
</style>
