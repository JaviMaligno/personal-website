---
import { getLangFromUrl, useTranslations, getLocalizedPath, type Language } from '../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
---

<section id="architecture" class="architecture-teaser">
  <div class="container">
    <div class="teaser-card">
      <div class="teaser-content">
        <span class="teaser-badge">Featured Architecture</span>
        <h2>{t('architecture').title}</h2>
        <p>{t('architecture').subtitle}</p>

        <a href={`${getLocalizedPath('/', lang)}projects/data-source-automator`} class="btn btn-primary">
          {t('cta').viewArchitecture}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .architecture-teaser {
    background: linear-gradient(to bottom, var(--bg-primary), var(--bg-secondary));
    position: relative;
    overflow: hidden;
  }

  .architecture-teaser::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--glass-border);
  }

  .teaser-card {
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    position: relative;
    overflow: hidden;
  }

  .teaser-card::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(59, 130, 246, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .teaser-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .teaser-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.375rem 0.75rem;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: var(--radius-full);
    color: #818cf8;
    margin-bottom: var(--space-md);
  }

  .teaser-content h2 {
    font-size: 1.75rem;
    margin-bottom: var(--space-sm);
  }

  .teaser-content p {
    color: var(--text-secondary);
    max-width: 500px;
    margin: 0 auto var(--space-lg);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  @media (max-width: 768px) {
    .teaser-card {
      padding: var(--space-xl);
    }

    .teaser-content h2 {
      font-size: 1.5rem;
    }
  }
</style>
