---
import { getLangFromUrl, useTranslations, type Language } from '../../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const situations = t('mentoring').situations;

interface Case {
  name: string;
  body: string;
}
---

<section class="mentoring-situations">
  <div class="container">
    <h2>{situations.title}</h2>

    <div class="cases">
      {situations.cases.map((item: Case) => (
        <article class="case">
          <h3>{item.name}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>

    <p class="closing">{situations.closing}</p>
  </div>
</section>

<style>
  .mentoring-situations {
    padding: var(--space-2xl) 0;
    background: rgba(255, 255, 255, 0.015);
  }

  h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  /* Flex rather than grid: with an odd number of cases the last one wraps to a
     row of its own, and grid would pin it to the left. Centring the leftover is
     the whole reason for the choice. */
  .cases {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
    max-width: 940px;
    margin: 0 auto;
  }

  .case {
    flex: 1 1 300px;
    max-width: 440px;
    padding: var(--space-lg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
  }

  .case h3 {
    font-size: 1.125rem;
    color: var(--accent-primary);
    margin-bottom: var(--space-sm);
  }

  .case p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .closing {
    max-width: 720px;
    margin: var(--space-xl) auto 0;
    text-align: center;
    color: var(--text-primary);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
</style>
