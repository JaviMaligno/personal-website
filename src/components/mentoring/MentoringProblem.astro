---
import { getLangFromUrl, useTranslations, type Language } from '../../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const problem = t('mentoring').problem;
---

<section class="mentoring-problem">
  <div class="container">
    <div class="problem-content">
      <h2>{problem.title}</h2>
      {problem.body.map((paragraph: string) => <p>{paragraph}</p>)}
      <p class="closing">{problem.closing}</p>
    </div>
  </div>
</section>

<style>
  .mentoring-problem {
    padding: var(--space-2xl) 0;
  }

  .problem-content {
    max-width: 720px;
    margin: 0 auto;
  }

  h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: var(--space-lg);
  }

  p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-md);
    font-size: 1.0625rem;
  }

  .closing {
    margin-top: var(--space-lg);
    padding-left: var(--space-md);
    border-left: 2px solid var(--accent-primary);
    color: var(--text-primary);
    font-weight: 500;
  }
</style>
