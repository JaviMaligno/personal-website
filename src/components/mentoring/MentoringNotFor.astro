---
import { getLangFromUrl, useTranslations, type Language } from '../../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const notFor = t('mentoring').notFor;
---

<section class="mentoring-not-for">
  <div class="container">
    <div class="not-for-content">
      <h2>{notFor.title}</h2>
      <ul>
        {notFor.items.map((item: string) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .mentoring-not-for {
    padding: var(--space-2xl) 0;
    background: rgba(255, 255, 255, 0.015);
  }

  .not-for-content {
    max-width: 720px;
    margin: 0 auto;
  }

  h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: var(--space-lg);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  li {
    color: var(--text-secondary);
    line-height: 1.6;
    padding-left: var(--space-lg);
    position: relative;
  }

  li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }
</style>
