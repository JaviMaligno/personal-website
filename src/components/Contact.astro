---
import { getLangFromUrl, useTranslations, type Language } from '../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

// Calendly URL with styling parameters
const calendlyUrl = 'https://calendly.com/javiecija96/discovery-call?hide_landing_page_details=1&hide_gdpr_banner=1&primary_color=6366f1';
---

<section id="contact" class="contact">
  <div class="container">
    <div class="contact-wrapper">
      <div class="contact-info">
        <h2>{t('contact').title}</h2>
        <p class="subtitle">{t('contact').subtitle}</p>

        <div class="labs-badge">
          <span class="labs-title">{t('labs').title}</span>
          <span class="labs-subtitle">{t('labs').subtitle}</span>
        </div>

        <div class="email-alternative">
          <span>{t('contact').emailAlternative}</span>
          <a href={`mailto:${t('contact').email}`}>{t('contact').email}</a>
        </div>
      </div>

      <div class="calendly-container">
        <!-- Calendly inline widget -->
        <div
          class="calendly-inline-widget"
          data-url={calendlyUrl}
        ></div>

        <!-- Fallback button for when embed doesn't load -->
        <noscript>
          <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
            {t('contact').bookCall}
          </a>
        </noscript>
      </div>
    </div>
  </div>
</section>

<!-- Calendly widget script -->
<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>

<style>
  .contact {
    padding: var(--space-3xl) 0;
  }

  .contact-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .contact-info h2 {
    margin-bottom: var(--space-md);
  }

  .contact-info .subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  .labs-badge {
    display: inline-flex;
    flex-direction: column;
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-xl);
  }

  .labs-title {
    font-size: 1.25rem;
    font-weight: 600;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .labs-subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .email-alternative {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .email-alternative span {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .email-alternative a {
    font-size: 1rem;
    color: var(--accent-primary);
    font-weight: 500;
  }

  .email-alternative a:hover {
    text-decoration: underline;
  }

  .calendly-container {
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 630px;
  }

  .calendly-inline-widget {
    min-width: 100%;
    height: 630px;
  }

  .btn-lg {
    display: block;
    text-align: center;
    padding: var(--space-md) var(--space-xl);
    margin: var(--space-xl);
  }

  @media (max-width: 768px) {
    .contact-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .calendly-container {
      min-height: 700px;
    }

    .calendly-inline-widget {
      height: 700px;
    }
  }
</style>
