---
import { getLangFromUrl, useTranslations, type Language } from '../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

// Calendly URL with styling parameters
const calendlyUrl = 'https://calendly.com/javiecija96/discovery-call?hide_landing_page_details=1&hide_gdpr_banner=1&primary_color=6366f1';
---

<section id="contact" class="contact">
  <div class="container">
    <div class="contact-wrapper">
      <div class="contact-info">
        <h2>{t('contact').title}</h2>
        <p class="subtitle">{t('contact').subtitle}</p>

        <div class="labs-badge">
          <span class="labs-title">{t('labs').title}</span>
          <span class="labs-subtitle">{t('labs').subtitle}</span>
        </div>

        <div class="connect-alternatives">
          <span>{t('contact').connectFirst}</span>
          <div class="connect-links">
            <a href={t('contact').linkedin} target="_blank" rel="noopener" class="connect-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
            <a href={`mailto:${t('contact').email}`} class="email-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              {t('contact').email}
            </a>
          </div>
        </div>
      </div>

      <div class="calendly-container">
        <!-- Calendly inline widget -->
        <div
          class="calendly-inline-widget"
          data-url={calendlyUrl}
        ></div>

        <!-- Fallback button for when embed doesn't load -->
        <noscript>
          <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
            {t('contact').bookCall}
          </a>
        </noscript>
      </div>
    </div>
  </div>
</section>

<!-- Calendly widget script -->
<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>

<style>
  .contact {
    padding: var(--space-3xl) 0;
  }

  .contact-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .contact-info h2 {
    margin-bottom: var(--space-md);
  }

  .contact-info .subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  .labs-badge {
    display: inline-flex;
    flex-direction: column;
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-xl);
  }

  .labs-title {
    font-size: 1.25rem;
    font-weight: 600;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .labs-subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .connect-alternatives {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .connect-alternatives > span {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .connect-links {
    display: flex;
    gap: var(--space-md);
  }

  .connect-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 1rem;
    color: var(--accent-primary);
    font-weight: 500;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: var(--bg-card);
    transition: all 0.2s ease;
  }

  .connect-link:hover {
    background: var(--accent-primary);
    color: white;
    border-color: var(--accent-primary);
  }

  .connect-link svg {
    flex-shrink: 0;
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 1rem;
    color: var(--accent-primary);
    font-weight: 500;
  }

  .email-link:hover {
    text-decoration: underline;
  }

  .email-link svg {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .calendly-container {
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 630px;
  }

  .calendly-inline-widget {
    min-width: 100%;
    height: 630px;
  }

  .btn-lg {
    display: block;
    text-align: center;
    padding: var(--space-md) var(--space-xl);
    margin: var(--space-xl);
  }

  @media (max-width: 768px) {
    .contact-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .connect-links {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .calendly-container {
      min-height: 700px;
    }

    .calendly-inline-widget {
      height: 700px;
    }
  }
</style>
