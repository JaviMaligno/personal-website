---
import { getLangFromUrl, useTranslations, type Language } from '../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const pricing = t('pricing');

const modeKeys = ['diagnose', 'build', 'partner'] as const;
const referenceKeys = ['skills', 'pipeline', 'classifier', 'platform'] as const;

const calendlyPopup = "Calendly.initPopupWidget({url: 'https://calendly.com/javiecija96/discovery-call?hide_landing_page_details=1&hide_gdpr_banner=1&primary_color=6366f1'});return false;";
---

<section id="pricing" class="pricing">
  <div class="container">
    <div class="section-header">
      <h2>{pricing.title}</h2>
      <p>{pricing.subtitle}</p>
    </div>

    <!-- The offer leads with the shape of the collaboration; the number is a
         consequence of the scope, so it sits at the foot of each card. -->
    <div class="modes">
      {modeKeys.map((key) => {
        const mode = pricing.modes[key];
        return (
          <article class={`mode ${key === 'build' ? 'mode-featured' : ''}`}>
            <span class="mode-label">{mode.label}</span>
            <h3>{mode.title}</h3>
            <p class="mode-tagline">{mode.tagline}</p>

            <ul class="mode-includes">
              {mode.includes.map((item) => (
                <li>
                  <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <p class="mode-outcome">{mode.outcome}</p>
            <p class="mode-price">{mode.price}</p>
          </article>
        );
      })}
    </div>

    <div class="reference">
      <div class="reference-header">
        <h3>{pricing.referenceTitle}</h3>
        <p>{pricing.referenceSubtitle}</p>
      </div>
      <ul class="reference-list">
        {referenceKeys.map((key) => (
          <li class="reference-row">
            <div class="reference-text">
              <span class="reference-title">{pricing.projects[key].title}</span>
              <span class="reference-description">{pricing.projects[key].description}</span>
            </div>
            <span class="reference-price">{pricing.projects[key].price}</span>
          </li>
        ))}
      </ul>
    </div>

    <a href={`/${lang}/mentoring`} class="mentoring-link">
      <span class="mentoring-link-title">{pricing.mentoringTeaser.title}</span>
      <span class="mentoring-link-text">{pricing.mentoringTeaser.text}</span>
    </a>

    <div class="pricing-footer">
      <p class="note">{pricing.note}</p>
      <a href="#" onclick={calendlyPopup} class="btn btn-primary">{pricing.cta}</a>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--bg-primary);
  }

  .modes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    align-items: stretch;
  }

  .mode {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .mode:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .mode-featured {
    border-color: var(--accent-primary);
    background: linear-gradient(var(--accent-surface), var(--accent-surface)), var(--bg-card);
  }

  .mode-label {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 0.125rem 0.5rem;
    margin-bottom: var(--space-md);
  }

  .mode-featured .mode-label {
    color: var(--accent-text);
    border-color: var(--accent-primary);
  }

  .mode h3 {
    font-size: 1.375rem;
    margin-bottom: var(--space-xs);
  }

  .mode-tagline {
    font-size: 0.9375rem;
    line-height: 1.55;
    margin-bottom: var(--space-lg);
  }

  .mode-includes {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .mode-includes li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-primary);
  }

  .mode-includes svg {
    color: var(--accent-text);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  /* Pushed to the bottom so every card's price line sits on the same baseline. */
  .mode-outcome {
    margin-top: auto;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-muted);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .mode-price {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-primary);
    margin-top: var(--space-sm);
  }

  .reference {
    max-width: 780px;
    margin: var(--space-3xl) auto 0;
  }

  .reference-header {
    margin-bottom: var(--space-lg);
  }

  .reference-header h3 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: var(--space-xs);
  }

  .reference-header p {
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .reference-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .reference-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--border);
  }

  .reference-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .reference-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .reference-description {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .reference-price {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent-text);
    white-space: nowrap;
  }

  /* Teaser for the mentoring page: the visitor who lands on the home page
     arrives with a different intent than the one who follows a link from an
     article, so the offer needs a door here too. */
  .mentoring-link {
    display: block;
    max-width: 780px;
    margin: var(--space-2xl) auto 0;
    padding: var(--space-lg) var(--space-xl);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius-md);
    background: var(--accent-surface);
    text-decoration: none;
    text-align: center;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .mentoring-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .mentoring-link-title {
    display: block;
    color: var(--accent-text);
    font-weight: 600;
    font-size: 1.125rem;
    margin-bottom: var(--space-xs);
  }

  .mentoring-link-text {
    display: block;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .pricing-footer {
    text-align: center;
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .pricing-footer .note {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: var(--space-md);
  }

  @media (max-width: 768px) {
    .reference {
      margin-top: var(--space-2xl);
    }

    .reference-row {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .mentoring-link {
      padding: var(--space-lg);
    }
  }
</style>
