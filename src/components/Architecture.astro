---
import { getLangFromUrl, useTranslations, type Language } from '../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
---

<section id="architecture" class="architecture">
  <div class="container">
    <div class="section-header">
      <h2>{t('architecture').title}</h2>
      <p>{t('architecture').subtitle}</p>
    </div>
    
    <div class="diagram-container">
      <div class="mermaid">
        {`%%{init: {'theme': 'dark', 'themeVariables': { 'fontFamily': 'Inter', 'secondaryColor': '#1e293b', 'primaryColor': '#3b82f6', 'primaryBorderColor': '#60a5fa' }}}%%
        graph TB
            subgraph Research ["${t('architecture').phases.research}"]
                A["${t('architecture').nodes.supervisor}"] --> B["${t('architecture').nodes.researcher}"]
                A --> C["${t('architecture').nodes.analyst}"]
                B --> D["${t('architecture').nodes.selector}"]
                C --> D
            end
            
            subgraph Spec ["${t('architecture').phases.spec}"]
                D --> E["${t('architecture').nodes.generator}"]
                E --> F["${t('architecture').nodes.writer}"]
                F --> G["${t('architecture').nodes.review}"]
            end
            
            subgraph Impl ["${t('architecture').phases.impl}"]
                G --> H["${t('architecture').nodes.techSpec}"]
                H --> I["${t('architecture').nodes.coder}"]
                I --> J["${t('architecture').nodes.tester}"]
                J --> K["${t('architecture').nodes.review}"]
            end

            classDef default fill:#0f172a,stroke:#334155,color:#fff,stroke-width:1px;
            classDef review fill:#3b0764,stroke:#a855f7,stroke-width:2px;
            classDef agent fill:#0f172a,stroke:#3b82f6,color:#fff;
            
            class G,K review;
            class A,B,C,H,I,J agent;`}
      </div>
      
      <div class="diagram-legend">
        <div class="legend-item">
          <span class="legend-dot agent"></span>
          <span>AI Agent</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot process"></span>
          <span>Process Step</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot review"></span>
          <span>Human Review</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import mermaid from 'mermaid';
  
  document.addEventListener('DOMContentLoaded', () => {
    mermaid.initialize({ 
      startOnLoad: true,
      theme: 'dark',
      securityLevel: 'loose',
      fontFamily: 'Inter, sans-serif',
      flowchart: {
        useMaxWidth: true,
        htmlLabels: true,
        curve: 'basis'
      }
    });
  });
</script>

<style>
  .architecture {
    background: linear-gradient(to bottom, var(--bg-primary), var(--bg-secondary));
    position: relative;
    overflow: hidden;
  }
  
  .architecture::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--glass-border);
  }
  
  .diagram-container {
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  
  .diagram-container::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(59, 130, 246, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }
  
  .mermaid {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-lg);
    z-index: 1;
  }
  
  /* Customizing Mermaid generated SVG via CSS where possible */
  :global(.mermaid svg) {
    max-width: 100%;
    height: auto;
  }
  
  .diagram-legend {
    display: flex;
    gap: var(--space-xl);
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--glass-border);
    z-index: 1;
  }
  
  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  
  .legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid transparent;
  }
  
  .legend-dot.agent {
    background: #0f172a;
    border-color: #3b82f6;
  }
  
  .legend-dot.process {
    background: #0f172a;
    border-color: #334155;
  }
  
  .legend-dot.review {
    background: #3b0764;
    border-color: #a855f7;
  }
  
  @media (max-width: 768px) {
    .diagram-container {
      padding: var(--space-md);
      overflow-x: auto;
    }
    
    .mermaid {
      min-width: 600px; /* Ensure diagram is legible on mobile with scroll */
    }
  }
</style>
