---
import { getLangFromUrl, useTranslations, type Language } from '../../i18n';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const a = t('assessment');

interface Question {
  category: string;
  prompt: string;
  options: string[];
}

const questions = a.questions as Question[];
const mentoringUrl = `/${lang}/mentoring`;

// Everything the client script needs, so it never has to reach back into i18n.
const clientData = {
  questions,
  levelNames: a.ui.levelNames,
  verdicts: a.result.verdicts,
  labels: {
    of: a.ui.of,
    unknownLabel: a.result.unknownLabel,
    emptyBoxes: a.result.emptyBoxes
  }
};
---

<section class="assessment">
  <div class="container">
    <!-- Step 1: intro -->
    <div class="panel" id="intro">
      <h1>{a.intro.title}</h1>
      <p class="lead">{a.intro.subtitle}</p>
      <button class="btn btn-primary btn-large" id="start">{a.intro.start}</button>
      <p class="fineprint">{a.intro.note}</p>
    </div>

    <!-- Step 2: questions, rendered by the script -->
    <div class="panel hidden" id="quiz">
      <div class="progress">
        <div class="progress-bar"><span id="progress-fill"></span></div>
        <div class="progress-text" id="progress-text"></div>
      </div>

      <h2 class="q-category" id="q-category"></h2>
      <p class="q-prompt" id="q-prompt"></p>

      <div class="options" id="options"></div>

      <button class="btn btn-ghost" id="back">{a.ui.back}</button>
    </div>

    <!-- Step 3: result -->
    <div class="panel hidden" id="result">
      <h2>{a.result.title}</h2>
      <p class="verdict" id="verdict"></p>

      <div class="map" id="map"></div>

      <div class="share">
        <h3>{a.result.shareTitle}</h3>
        <p>{a.result.shareBody}</p>
        <form action="https://formspree.io/f/xkgrbqad" method="POST" id="share-form">
          <input type="email" name="email" placeholder={a.result.emailPlaceholder} required />
          <input type="hidden" name="_subject" value="Assessment result" />
          <input type="hidden" name="result" id="result-field" />
          <button type="submit" class="btn btn-primary">{a.result.send}</button>
        </form>
      </div>

      <div class="result-actions">
        <a href={mentoringUrl} class="btn btn-secondary">{a.result.mentoringLink}</a>
        <button class="btn btn-ghost" id="restart">{a.ui.restart}</button>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ clientData }}>
  (() => {
    const { questions, levelNames, verdicts, labels } = clientData;
    const answers = new Array(questions.length).fill(null);
    let current = 0;

    const $ = (id) => document.getElementById(id);
    const intro = $('intro');
    const quiz = $('quiz');
    const result = $('result');

    function show(panel) {
      [intro, quiz, result].forEach((p) => p.classList.add('hidden'));
      panel.classList.remove('hidden');
    }

    function renderQuestion() {
      const q = questions[current];
      $('q-category').textContent = q.category;
      $('q-prompt').textContent = q.prompt;
      $('progress-text').textContent = `${current + 1} ${labels.of} ${questions.length}`;
      $('progress-fill').style.width = `${(current / questions.length) * 100}%`;
      $('back').style.visibility = current === 0 ? 'hidden' : 'visible';

      const box = $('options');
      box.innerHTML = '';
      q.options.forEach((text, level) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'option' + (answers[current] === level ? ' selected' : '');
        btn.textContent = text;
        btn.addEventListener('click', () => {
          answers[current] = level;
          if (current < questions.length - 1) {
            current += 1;
            renderQuestion();
          } else {
            renderResult();
          }
        });
        box.appendChild(btn);
      });
    }

    function renderResult() {
      show(result);

      const unknown = answers.filter((level) => level === 0);
      const count = unknown.length;
      const verdict =
        count === 0 ? verdicts.none : count <= 2 ? verdicts.few : count <= 4 ? verdicts.some : verdicts.many;

      $('verdict').textContent =
        count > 0 ? `${count} ${labels.unknownLabel}. ${verdict}` : verdict;

      // The map: every category with the level chosen, unknowns first so the
      // gaps are what you read, not what you have to hunt for.
      const rows = questions
        .map((q, i) => ({ category: q.category, level: answers[i] ?? 0 }))
        .sort((a, b) => a.level - b.level);

      const map = $('map');
      map.innerHTML = '';
      rows.forEach((row) => {
        const el = document.createElement('div');
        el.className = 'map-row' + (row.level === 0 ? ' empty' : '');

        const name = document.createElement('span');
        name.className = 'map-category';
        name.textContent = row.category;

        const meter = document.createElement('span');
        meter.className = 'map-meter';
        for (let s = 1; s <= 3; s += 1) {
          const seg = document.createElement('span');
          seg.className = 'seg' + (row.level >= s ? ' filled' : '');
          meter.appendChild(seg);
        }

        const label = document.createElement('span');
        label.className = 'map-level';
        label.textContent = levelNames[row.level];

        el.append(name, meter, label);
        map.appendChild(el);
      });

      // What actually reaches the inbox: a lead with the diagnosis attached.
      $('result-field').value = rows
        .map((r) => `${r.category}: ${levelNames[r.level]}`)
        .join('\n');
    }

    $('start').addEventListener('click', () => {
      show(quiz);
      renderQuestion();
    });

    $('back').addEventListener('click', () => {
      if (current > 0) {
        current -= 1;
        renderQuestion();
      }
    });

    $('restart').addEventListener('click', () => {
      answers.fill(null);
      current = 0;
      show(intro);
    });
  })();
</script>

<style>
  .assessment {
    padding-top: 120px;
    padding-bottom: var(--space-2xl);
    min-height: 80vh;
    position: relative;
    overflow: hidden;
  }

  /* Same ambient glow the other landing heroes use, so the page reads as part
     of the site rather than a bare form bolted on. */
  .assessment::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 900px;
    height: 900px;
    background: radial-gradient(circle at center, var(--accent-glow) 0%, transparent 70%);
    filter: blur(80px);
    opacity: 0.35;
    pointer-events: none;
    z-index: 0;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  .panel {
    max-width: 820px;
    margin: 0 auto;
  }

  #intro {
    text-align: center;
    padding-top: var(--space-2xl);
  }

  .hidden {
    display: none;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: var(--space-lg);
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }

  #result h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--space-md);
  }

  .lead {
    color: var(--text-secondary);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.6;
    margin: 0 auto var(--space-xl);
    max-width: 640px;
  }

  .fineprint {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-top: var(--space-lg);
  }

  .btn-large {
    padding: 1rem 2.5rem;
    font-size: 1.125rem;
  }

  /* Questions */
  .progress {
    margin-bottom: var(--space-xl);
  }

  .progress-bar {
    height: 3px;
    background: var(--glass-border);
    border-radius: 2px;
    overflow: hidden;
  }

  .progress-bar span {
    display: block;
    height: 100%;
    background: var(--accent-primary);
    transition: width var(--transition-fast);
  }

  .progress-text {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-top: var(--space-xs);
  }

  .q-category {
    color: var(--accent-primary);
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-sm);
  }

  .q-prompt {
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    line-height: 1.35;
    margin-bottom: var(--space-xl);
    color: var(--text-primary);
    font-weight: 600;
  }

  .options {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  #options :global(.option) {
    text-align: left;
    padding: var(--space-md);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    line-height: 1.5;
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  #options :global(.option:hover),
  #options :global(.option.selected) {
    border-color: var(--accent-primary);
    color: var(--text-primary);
  }

  .btn-ghost {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font: inherit;
    padding: var(--space-xs) 0;
  }

  .btn-ghost:hover {
    color: var(--text-primary);
  }

  /* Result */
  .verdict {
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .map {
    display: grid;
    gap: 1px;
    margin-bottom: var(--space-2xl);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .map :global(.map-row) {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-md);
    align-items: center;
    padding: 0.7rem var(--space-md);
    background: rgba(255, 255, 255, 0.015);
  }

  .map :global(.map-row.empty) {
    background: rgba(255, 255, 255, 0.05);
  }

  .map :global(.map-category) {
    color: var(--text-primary);
  }

  .map :global(.map-meter) {
    display: inline-flex;
    gap: 3px;
  }

  .map :global(.seg) {
    width: 22px;
    height: 10px;
    border: 1px solid var(--glass-border);
    border-radius: 2px;
  }

  .map :global(.seg.filled) {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
  }

  .map :global(.map-level) {
    color: var(--text-muted);
    font-size: 0.875rem;
    min-width: 7.5rem;
    text-align: right;
  }

  .share {
    padding: var(--space-lg);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
  }

  .share h3 {
    margin-bottom: var(--space-xs);
  }

  .share p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .share form {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .share input[type='email'] {
    flex: 1;
    min-width: 220px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    font: inherit;
  }

  .result-actions {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .map :global(.map-row) {
      grid-template-columns: 1fr auto;
      row-gap: var(--space-xs);
    }

    .map :global(.map-level) {
      grid-column: 1 / -1;
      text-align: left;
      min-width: 0;
    }
  }
</style>
