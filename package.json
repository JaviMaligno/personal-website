{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run postbuild",
    "postbuild": "node scripts/copy-sitemap.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test 'scripts/**/*.test.mjs'",
    "test:linkedin": "node scripts/linkedin/test-all.js",
    "test:detect": "node scripts/linkedin/test-detect-posts.js",
    "test:summary": "node scripts/linkedin/test-summary.js",
    "test:gemini": "node scripts/linkedin/test-gemini.js",
    "test:devto": "node scripts/devto/publish-existing-post.js",
    "update:devto": "node scripts/devto/update-devto-post.js",
    "publish:devto": "node scripts/devto/publish-draft.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^9.0.5",
    "@google/generative-ai": "^0.21.0",
    "astro": "^5.16.6",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.12.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
