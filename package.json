{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run postbuild",
    "postbuild": "node scripts/copy-sitemap.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "audit:memory": "node scripts/memory-audit/audit.mjs",
    "test:pages": "npm run build && node --test \"scripts/publications/rendered-page.check.mjs\"",
    "test:linkedin": "node scripts/linkedin/test-all.js",
    "test:detect": "node scripts/linkedin/test-detect-posts.js",
    "test:summary": "node scripts/linkedin/test-summary.js",
    "test:gemini": "node scripts/linkedin/test-gemini.js",
    "test:devto": "node scripts/devto/publish-existing-post.js",
    "update:devto": "node scripts/devto/update-devto-post.js",
    "publish:devto": "node scripts/devto/publish-draft.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@google/generative-ai": "^0.21.0",
    "astro": "^7.4.2",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.16.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "@astrojs/markdown-remark": "^7.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
