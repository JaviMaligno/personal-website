  "issue_test": "import humanize\n\n\ndef test_gnu_3000_bytes():\n    assert humanize.naturalsize(3000, gnu=True) == \"2.9K\"\n",
  "hidden_tests": "import pytest\n\nimport humanize\n\n\n@pytest.mark.parametrize(\"value, expected\", [\n    (1000, \"1000B\"),\n    (4096, \"4.0K\"),\n    (1024**2 * 5, \"5.0M\"),\n    (10**9, \"953.7M\"),\n    (1024**3 * 7, \"7.0G\"),\n])\ndef test_gnu_uses_powers_of_1024(value, expected):\n    assert humanize.naturalsize(value, gnu=True) == expected\n",
