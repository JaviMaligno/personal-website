+// The amount a schedule is expected to post, given its amount and the
+// operator of its amount condition. Schedules are planned for the worst case:
+// a ranged ("is between") amount is expected at the end of the range furthest
+// from zero, and an approximate ("is approximately") amount at the end of its
+// matching tolerance (7.5%, rounded to the cent) furthest from zero. An exact
+// ("is") amount is expected as is, and a missing amount at 0.
+export function getExpectedAmount(
+  amount: number | { num1: number; num2: number },
+  amountOp: string | null | undefined,
+): number {
+  if (amountOp === 'isapprox' && typeof amount === 'number') {
+    const tolerance = getApproxNumberThreshold(amount);
+    return amount < 0 ? amount - tolerance : amount + tolerance;
+  }
+  return getScheduledAmount(amount);
+}
