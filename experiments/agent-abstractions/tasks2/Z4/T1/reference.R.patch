+// The settings of a recurring date config that decide on which day an
+// occurrence finally falls.
+export type OccurrenceRule = {
+  frequency?: string;
+  skipWeekend?: boolean;
+  weekendSolveMode?: 'before' | 'after';
+};
+
+// With weekend handling on, daily schedules drop their weekend occurrences
+// instead of moving them (moving would stack several occurrences on the same
+// Friday or Monday).
+export function dropsWeekendOccurrences(rule: OccurrenceRule): boolean {
+  return !!rule.skipWeekend && rule.frequency === 'daily';
+}
+
+// The day an occurrence finally falls on, or null when the occurrence is
+// dropped altogether.
+export function resolveOccurrenceDate(
+  date: Date,
+  rule: OccurrenceRule,
+): Date | null {
+  if (!rule.skipWeekend) {
+    return date;
+  }
+  if (dropsWeekendOccurrences(rule)) {
+    return d.isWeekend(date) ? null : date;
+  }
+  return getDateWithSkippedWeekend(date, rule.weekendSolveMode);
+}
+
+// How many dropped occurrences in a row we look through before deciding that
+// a schedule has no kept occurrence at all (e.g. every 7 days from a
+// Saturday).
+function maxConsecutiveDroppedOccurrences(_rule: OccurrenceRule): number {
+  return 7;
+}
+
+// Iterates `occurrences` lazily and returns the first one that the rule keeps
+// (not moved). Returns undefined when the iterator runs out, and null when it
+// gives up after too many dropped occurrences in a row.
+export function firstKeptOccurrence(
+  occurrences: Iterable<{ date: Date }>,
+  rule: OccurrenceRule,
+): Date | null | undefined {
+  const drops = dropsWeekendOccurrences(rule);
+  const limit = maxConsecutiveDroppedOccurrences(rule);
+  let dropped = 0;
+  for (const occurrence of occurrences) {
+    if (!drops || resolveOccurrenceDate(occurrence.date, rule) !== null) {
+      return occurrence.date;
+    }
+    if (++dropped >= limit) {
+      return null;
+    }
+  }
+  return undefined;
+}
+
+// The final days of the first `count` kept occurrences of `occurrences`, in
+// iteration order.
+export function takeResolvedOccurrences(
+  occurrences: Iterable<{ date: Date }>,
+  rule: OccurrenceRule,
+  count: number,
+): Date[] {
+  const result: Date[] = [];
+  const limit = maxConsecutiveDroppedOccurrences(rule);
+  let dropped = 0;
+  if (count <= 0) {
+    return result;
+  }
+  for (const occurrence of occurrences) {
+    const date = resolveOccurrenceDate(occurrence.date, rule);
+    if (date === null) {
+      if (++dropped >= limit) {
+        break;
+      }
+      continue;
+    }
+    dropped = 0;
+    result.push(date);
+    if (result.length >= count) {
+      break;
+    }
+  }
+  return result;
+}
