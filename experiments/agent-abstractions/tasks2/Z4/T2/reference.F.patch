+// The days (YYYY-MM-DD, ascending, unique) on which a recurring schedule
+// falls between `start` and `end` (both included), after the weekend rule.
+// Membership is decided by the final day: an occurrence moved into the period
+// is listed, one moved out of it is not.
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  if (!isValidYearMonthDay(start) || !isValidYearMonthDay(end)) {
+    throw new Error('Invalid date range');
+  }
+  if (start > end) {
+    return [];
+  }
+
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const weekendRule = weekendRuleFromConfig(config);
+
+    // Occurrences just outside the period can be moved into it.
+    const margin = maxWeekendShiftDays(weekendRule);
+    const occurrences = schedule.occurrences({
+      start: d.startOfDay(parseDate(subDays(start, margin))),
+      end: d.endOfDay(parseDate(addDays(end, margin))),
+    });
+
+    const days = new Set<string>();
+    for (const occurrence of occurrences) {
+      const date = applyWeekendRule(occurrence.date, weekendRule);
+      if (date === null) {
+        continue;
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
