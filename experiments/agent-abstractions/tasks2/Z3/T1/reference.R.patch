+// Refuses to link the bank account `accountId` of provider `syncSource` when
+// another local account already holds it. An account holds the link when it is
+// not deleted (closed accounts still hold it) and has that provider and
+// provider account id. `upgradingId` (the account receiving the link) never
+// counts, so re-linking an account to its own bank account keeps working.
+// Runs before anything is written, so a refused link changes nothing.
+async function checkBankAccountNotLinkedElsewhere({
+  syncSource,
+  accountId,
+  upgradingId,
+}: {
+  syncSource: AccountSyncSource;
+  accountId: string;
+  upgradingId?: AccountEntity['id'];
+}) {
+  const holder = await db.first<Pick<db.DbAccount, 'id'>>(
+    `SELECT id FROM accounts
+       WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+         AND id != ?`,
+    [syncSource, accountId, upgradingId ?? ''],
+  );
+
+  if (holder) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
