+// Whether a category has at least one budget template saved (a non-empty
+// `goal_def`, as the template editor stores them). Templates that only exist
+// as text in the category's notes are not considered.
+function hasSavedTemplates(goalDef: string | null | undefined): boolean {
+  if (!goalDef) {
+    return false;
+  }
+  try {
+    const templates = JSON.parse(goalDef);
+    return Array.isArray(templates) ? templates.length > 0 : templates != null;
+  } catch {
+    // Something was saved even if it cannot be read back: leave it alone.
+    return true;
+  }
+}
