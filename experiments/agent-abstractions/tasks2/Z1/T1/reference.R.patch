@@ -215,6 +215,51 @@ function setCarryover(
 
 // Actions
 
+// Month-wide budget actions fill in the budget of every category for a month
+// in one go. They leave some categories untouched (their budget keeps its
+// value): hidden categories, categories in hidden groups, and categories with
+// at least one saved budget template (a non-empty `goal_def`, as the template
+// editor stores them).
+type BulkActionCategory = {
+  id: db.DbCategory['id'];
+  hidden: db.DbCategory['hidden'];
+  group_hidden: db.DbCategoryGroup['hidden'] | null;
+  goal_def: db.DbCategory['goal_def'];
+};
+
+function hasSavedTemplates(goalDef: string | null | undefined): boolean {
+  if (!goalDef) {
+    return false;
+  }
+  try {
+    const templates = JSON.parse(goalDef);
+    return Array.isArray(templates) ? templates.length > 0 : templates != null;
+  } catch {
+    // Something was saved even if it cannot be read back: leave it alone.
+    return true;
+  }
+}
+
+function isUntouchedByBulkActions(cat: BulkActionCategory): boolean {
+  return (
+    cat.hidden === 1 ||
+    cat.group_hidden === 1 ||
+    hasSavedTemplates(cat.goal_def)
+  );
+}
+
+async function getCategoriesUntouchedByBulkActions(): Promise<Set<string>> {
+  const categories = await db.all<BulkActionCategory>(
+    `
+    SELECT c.id, c.hidden, g.hidden AS group_hidden, c.goal_def
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+  `,
+  );
+  return new Set(categories.filter(isUntouchedByBulkActions).map(c => c.id));
+}
