+// Net activity of every category in `month` (on-budget accounts only, as the
+// budget's `sum-amount` cells count it), keyed by category id. Spending is
+// negative, income positive. Categories without activity are absent.
+async function getActivityByCategory(
+  month: string,
+): Promise<Map<string, number>> {
+  const rows = await db.all<{ category: string; amount: number | null }>(
+    `
+    SELECT t.category AS category, SUM(t.amount) AS amount
+    FROM v_transactions_internal_alive t
+    LEFT JOIN accounts a ON a.id = t.account
+    WHERE t.category IS NOT NULL
+      AND CAST(t.date / 100 AS INTEGER) = ?
+      AND a.offbudget = 0
+    GROUP BY t.category
+  `,
+    [dbMonth(month)],
+  );
+  return new Map(rows.map(row => [row.category, row.amount || 0]));
+}
+
+// Budgets every category with what it spent in the previous calendar month
+// (income categories, when filled, with what they received).
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getBulkBudgetCategories({
+    skipMissingGroup: true,
+  });
+  const activity = await getActivityByCategory(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudget(cat, activity.get(cat.id) ?? 0),
+      });
+    }
+  });
+}
