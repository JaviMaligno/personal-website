--- /dev/null
+++ b/packages/loot-core/eslint-rules/allow-list.mjs
@@ -0,0 +1,53 @@
+// Shared helpers for the agent lint rules.
+//
+// Base sites that already break a rule are allow-listed individually (file +
+// source line, SQL prefix or method name), never by turning a rule off for a
+// file or a directory. Allow-lists are passed as rule options in
+// eslint.agent.config.mjs.
+import path from 'node:path';
+
+/** Path of the linted file relative to packages/loot-core, with `/` separators. */
+export function relFile(context) {
+  const f = context.filename;
+  const rel = path.isAbsolute(f) ? path.relative(context.cwd, f) : f;
+  return rel.split(path.sep).join('/');
+}
+
+export function inDir(context, dirs) {
+  const rel = relFile(context);
+  return dirs.some(d => rel.startsWith(d));
+}
+
+/** Trimmed source text of the line where `node` starts. */
+export function lineText(context, node) {
+  return context.sourceCode.lines[node.loc.start.line - 1].trim();
+}
+
+/**
+ * Allow-list check for one linted file. Entries are `{ file, count?, ...key }`;
+ * an entry covers at most `count` (default 1) reports in that file, so adding
+ * one more identical line to an allow-listed file is still reported.
+ */
+export function allowList(options, rel) {
+  const entries = (options?.[0]?.allow ?? []).filter(e => e.file === rel);
+  const used = new Map();
+  return pred => {
+    const e = entries.find(x => pred(x) && (used.get(x) ?? 0) < (x.count ?? 1));
+    if (!e) return false;
+    used.set(e, (used.get(e) ?? 0) + 1);
+    return true;
+  };
+}
+
+export const allowSchema = [
+  {
+    type: 'object',
+    properties: {
+      allow: {
+        type: 'array',
+        items: { type: 'object', required: ['file'], properties: { count: { type: 'integer', minimum: 1 } }, additionalProperties: true },
+      },
+    },
+    additionalProperties: true,
+  },
+];
