diff --git a/packages/loot-core/eslint-rules/mutator-required.mjs b/packages/loot-core/eslint-rules/mutator-required.mjs
new file mode 100644
index 0000000..15904e3
--- /dev/null
+++ b/packages/loot-core/eslint-rules/mutator-required.mjs
@@ -0,0 +1,73 @@
+// Handler registrations `app.method('<name>', handler)` for mutating methods
+// (names not starting with get/query/list) must be wrapped so that the
+// mutation is tracked:
+//   form 'mutator'  (A+L):  app.method('<name>', mutator(...))
+//   form 'mutation' (A+ +L): app.method(...mutation('<name>', handler))
+// Base registrations that do not follow the form are allow-listed by
+// file + method name.
+import { allowList, relFile } from './allow-list.mjs';
+
+const READ = /^(get|query|list)/;
+
+function calleeName(callee) {
+  if (callee.type === 'Identifier') return callee.name;
+  if (callee.type === 'MemberExpression' && !callee.computed) return callee.property.name;
+  return null;
+}
+
+function literalName(n) {
+  if (n?.type === 'Literal' && typeof n.value === 'string') return n.value;
+  if (n?.type === 'TemplateLiteral' && n.expressions.length === 0) return n.quasis[0].value.cooked;
+  return null;
+}
+
+export default {
+  meta: {
+    type: 'problem',
+    schema: [
+      {
+        type: 'object',
+        properties: {
+          form: { enum: ['mutator', 'mutation'] },
+          allow: { type: 'array', items: { type: 'object', required: ['file', 'name'] } },
+        },
+        additionalProperties: false,
+      },
+    ],
+    messages: {
+      mutator: "Mutating handler '{{name}}' must be registered as app.method('{{name}}', mutator(...)).",
+      mutation: "Mutating handler '{{name}}' must be registered as app.method(...mutation('{{name}}', handler)).",
+    },
+  },
+  create(context) {
+    const form = context.options[0]?.form ?? 'mutator';
+    const rel = relFile(context);
+    const isAllowed = allowList(context.options, rel);
+    const report = (node, name) => {
+      if (isAllowed(e => e.name === name)) return;
+      context.report({ node, messageId: form, data: { name } });
+    };
+    return {
+      CallExpression(node) {
+        const { callee } = node;
+        if (callee.type !== 'MemberExpression' || calleeName(callee) !== 'method' ||
+            callee.object.type !== 'Identifier' || callee.object.name !== 'app') return;
+        const [first, second] = node.arguments;
+        if (first?.type === 'SpreadElement') {
+          const inner = first.argument;
+          if (inner.type !== 'CallExpression') return;
+          const name = literalName(inner.arguments[0]);
+          if (name == null || READ.test(name)) return;
+          if (form === 'mutation' && calleeName(inner.callee) === 'mutation') return;
+          if (form === 'mutator') return; // spread registrations carry no handler to inspect
+          report(node, name);
+          return;
+        }
+        const name = literalName(first);
+        if (name == null || READ.test(name)) return;
+        if (form === 'mutator' && second?.type === 'CallExpression' && calleeName(second.callee) === 'mutator') return;
+        report(node, name);
+      },
+    };
+  },
+};
diff --git a/packages/loot-core/eslint-rules/no-float-money.mjs b/packages/loot-core/eslint-rules/no-float-money.mjs
new file mode 100644
index 0000000..f2dbb59
--- /dev/null
+++ b/packages/loot-core/eslint-rules/no-float-money.mjs
@@ -0,0 +1,43 @@
+// Money is stored as integer minor units. Converting by hand with * or / 100
+// (or 10 ** n, Math.pow(10, n)) on an amount-like value is reported; use
+// amountToInteger/integerToAmount (or cents.* in the domain layer).
+import { allowList, allowSchema, lineText, relFile } from './allow-list.mjs';
+
+const MONEY = /amount|balance|budgeted|spent|carryover/i;
+const isScale = n =>
+  (n.type === 'Literal' && n.value === 100) ||
+  (n.type === 'BinaryExpression' && n.operator === '**' &&
+    n.left.type === 'Literal' && n.left.value === 10) ||
+  (n.type === 'CallExpression' && n.callee.type === 'MemberExpression' &&
+    n.callee.object.type === 'Identifier' && n.callee.object.name === 'Math' &&
+    !n.callee.computed && n.callee.property.name === 'pow' &&
+    n.arguments[0]?.type === 'Literal' && n.arguments[0].value === 10);
+const isMoney = n =>
+  (n.type === 'Identifier' && MONEY.test(n.name)) ||
+  (n.type === 'MemberExpression' && !n.computed && MONEY.test(n.property.name)) ||
+  (n.type === 'ChainExpression' && isMoney(n.expression)) ||
+  (n.type === 'TSNonNullExpression' && isMoney(n.expression));
+
+export default {
+  meta: {
+    type: 'problem',
+    schema: allowSchema,
+    messages: {
+      float: 'Money must be converted with amountToInteger/integerToAmount (or cents.*), not raw * or / by 100.',
+    },
+  },
+  create(context) {
+    const rel = relFile(context);
+    const isAllowed = allowList(context.options, rel);
+    if (rel === 'src/shared/util.ts') return {};
+    return {
+      BinaryExpression(node) {
+        if (node.operator !== '*' && node.operator !== '/') return;
+        if (!((isScale(node.left) && isMoney(node.right)) || (isScale(node.right) && isMoney(node.left)))) return;
+        const text = lineText(context, node);
+        if (isAllowed(e => e.line === text)) return;
+        context.report({ node, messageId: 'float' });
+      },
+    };
+  },
+};
diff --git a/packages/loot-core/eslint-rules/no-raw-synced-write.mjs b/packages/loot-core/eslint-rules/no-raw-synced-write.mjs
new file mode 100644
index 0000000..08249a6
--- /dev/null
+++ b/packages/loot-core/eslint-rules/no-raw-synced-write.mjs
@@ -0,0 +1,61 @@
+// Raw SQL writes on synced tables bypass the CRDT layer (no sync messages).
+// Flags runQuery/execQuery/run calls whose first argument is a string or
+// template literal starting with INSERT/UPDATE/DELETE/REPLACE on a synced
+// table, outside src/server/db/ and src/server/sync/.
+import { allowList, allowSchema, inDir, relFile } from './allow-list.mjs';
+
+// Tables written through the CRDT write API (db.update/insert/... and the
+// data-specific write functions) on base 9732a446.
+export const SYNCED_TABLES = new Set([
+  'transactions', 'accounts', 'account_groups', 'banks', 'categories', 'category_groups',
+  'category_mapping', 'payees', 'payee_mapping', 'payee_locations', 'schedules',
+  'schedules_next_date', 'rules', 'notes', 'tags', 'zero_budgets', 'reflect_budgets',
+  'zero_budget_months', 'cleanup_groups', 'custom_reports', 'dashboard', 'dashboard_pages',
+  'preferences', 'transaction_filters',
+]);
+const CALLEES = new Set(['runQuery', 'execQuery', 'run']);
+const WRITE =
+  /^\s*(?:INSERT(?:\s+OR\s+\w+)?\s+INTO|UPDATE|DELETE\s+FROM|REPLACE\s+INTO)\s+["`]?(\w+)/i;
+
+function calleeName(callee) {
+  if (callee.type === 'Identifier') return callee.name;
+  if (callee.type === 'MemberExpression' && !callee.computed) return callee.property.name;
+  return null;
+}
+
+/** Static leading text of a string or template literal, or null. */
+function leadingText(arg) {
+  if (!arg) return null;
+  if (arg.type === 'Literal' && typeof arg.value === 'string') return arg.value;
+  if (arg.type === 'TemplateLiteral') return arg.quasis[0].value.cooked ?? '';
+  return null;
+}
+
+export const normalizeSql = s => s.replace(/\s+/g, ' ').trim();
+
+export default {
+  meta: {
+    type: 'problem',
+    schema: allowSchema,
+    messages: {
+      raw: "Raw SQL write on synced table '{{table}}' bypasses CRDT sync messages; use the db write helpers.",
+    },
+  },
+  create(context) {
+    if (inDir(context, ['src/server/db/', 'src/server/sync/'])) return {};
+    const rel = relFile(context);
+    const isAllowed = allowList(context.options, rel);
+    return {
+      CallExpression(node) {
+        if (!CALLEES.has(calleeName(node.callee))) return;
+        const text = leadingText(node.arguments[0]);
+        if (text == null) return;
+        const m = text.match(WRITE);
+        if (!m || !SYNCED_TABLES.has(m[1].toLowerCase())) return;
+        const sql = normalizeSql(text);
+        if (isAllowed(e => sql.startsWith(e.sql))) return;
+        context.report({ node, messageId: 'raw', data: { table: m[1].toLowerCase() } });
+      },
+    };
+  },
+};
diff --git a/packages/loot-core/eslint-rules/no-send-messages.mjs b/packages/loot-core/eslint-rules/no-send-messages.mjs
new file mode 100644
index 0000000..8c45373
--- /dev/null
+++ b/packages/loot-core/eslint-rules/no-send-messages.mjs
@@ -0,0 +1,30 @@
+// Only the db write helpers (src/server/db/) and the sync engine
+// (src/server/sync/) may reference sendMessages.
+import { allowList, allowSchema, inDir, lineText, relFile } from './allow-list.mjs';
+
+export default {
+  meta: {
+    type: 'problem',
+    schema: allowSchema,
+    messages: {
+      send: 'Only db/ and sync/ may call sendMessages; use the db write helpers.',
+    },
+  },
+  create(context) {
+    if (inDir(context, ['src/server/db/', 'src/server/sync/'])) return {};
+    const rel = relFile(context);
+    const isAllowed = allowList(context.options, rel);
+    return {
+      Identifier(node) {
+        if (node.name !== 'sendMessages') return;
+        // `import { sendMessages }` yields two Identifier nodes (imported, local).
+        const p = node.parent;
+        if (p?.type === 'ImportSpecifier' && node === p.local && p.imported !== p.local &&
+            p.imported.range?.[0] === node.range[0]) return;
+        const text = lineText(context, node);
+        if (isAllowed(e => e.line === text)) return;
+        context.report({ node, messageId: 'send' });
+      },
+    };
+  },
+};
diff --git a/packages/loot-core/eslint.agent.config.mjs b/packages/loot-core/eslint.agent.config.mjs
new file mode 100644
index 0000000..b7c68b3
--- /dev/null
+++ b/packages/loot-core/eslint.agent.config.mjs
@@ -0,0 +1,36 @@
+// Agent lint rules for A+L, run by `yarn lint` after `tsgo -b`.
+// Base sites that already break a rule are allow-listed one by one in
+// eslint-rules/base-allow-list.mjs; no rule is turned off for a file or a directory.
+import tsParser from '@typescript-eslint/parser';
+
+import * as allow from './eslint-rules/base-allow-list.mjs';
+import mutatorRequired from './eslint-rules/mutator-required.mjs';
+import noFloatMoney from './eslint-rules/no-float-money.mjs';
+import noRawSyncedWrite from './eslint-rules/no-raw-synced-write.mjs';
+import noSendMessages from './eslint-rules/no-send-messages.mjs';
