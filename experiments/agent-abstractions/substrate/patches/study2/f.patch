+// Bulk actions
+
+type BulkBudgetCategory = Pick<db.DbCategory, 'id' | 'is_income' | 'hidden'> & {
+  group_hidden: db.DbCategoryGroup['hidden'] | null;
+};
+
+// The categories a bulk budget action (copy last month, set to zero, set to an
+// N-month average) writes. Income categories take part only in tracking
+// budgets. Hidden categories and categories in hidden groups are
+// skipped unless `includeHidden` (set to zero writes every category).
+// `skipMissingGroup` also skips a category whose group row does not exist: the
+// average actions have always done so, copy last month has not.
+async function getBulkBudgetCategories({
+  includeHidden,
+  skipMissingGroup,
+}: {
+  includeHidden: boolean;
+  skipMissingGroup: boolean;
+}): Promise<BulkBudgetCategory[]> {
+  const categories = await db.all<BulkBudgetCategory>(
+    `
+  SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0
+  `,
+  );
+  const tracking = isTrackingBudget();
+
+  return categories.filter(cat => {
+    if (cat.is_income === 1 && !tracking) {
+      return false;
+    }
+    if (includeHidden) {
+      return true;
+    }
+    if (cat.hidden === 1 || cat.group_hidden === 1) {
+      return false;
+    }
+    return !(skipMissingGroup && cat.group_hidden == null);
+  });
+}
+
+// An average of past activity becomes a budgeted amount: spending is negative,
+// so the sign is inverted for expense categories; income keeps its sign.
+function averageToBudget(
+  category: Pick<db.DbCategory, 'is_income'>,
+  average: number,
+): number {
+  return category.is_income === 0 ? average * -1 : average;
+}
+
