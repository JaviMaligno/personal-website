+// Domain commands for `rules`.
+//
+// `insertRule/updateRule/deleteRule` in `transactions/transaction-rules.ts`
+// keep their exports (many callers and tests use them) and delegate here.
+// `ruleModel` stays in `transaction-rules.ts`; it is only used inside the
+// command bodies, so the import cycle with that module is harmless.
+import * as db from '#server/db';
+import { ruleModel } from '#server/transactions/transaction-rules';
+import type { RuleEntity } from '#types/models';
+
+import { w } from './internal';
+import type { Id, Patch } from './internal';
+
+// [transaction-rules.insertRule: validate + fromJS + insertWithUUID]
+export async function createRule(
+  r: Omit<RuleEntity, 'id'> & { id?: Id },
+): Promise<RuleEntity['id']> {
+  r = ruleModel.validate(r);
+  return w.insertWithUUID('rules', ruleModel.fromJS(r));
+}
+
+// [transaction-rules.updateRule: validate + fromJS + update]
+export async function updateRule(r: Patch<RuleEntity>): Promise<void> {
+  r = ruleModel.validate(r, { update: true });
+  return w.update('rules', ruleModel.fromJS(r));
+}
+
+// [transaction-rules.deleteRule: refuses if a schedule links it]
+export async function deleteRule(id: Id): Promise<boolean> {
+  const schedule = await db.first<Pick<db.DbSchedule, 'id'>>(
+    'SELECT id FROM schedules WHERE rule = ?',
+    [id],
+  );
+
+  if (schedule) {
+    return false;
+  }
+
+  await w.delete_('rules', id);
+  return true;
+}
