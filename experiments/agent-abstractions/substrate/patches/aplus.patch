+// Domain commands for `preferences`, `dashboard`, `dashboard_pages`,
+// `custom_reports` and `transaction_filters`.
+//
+// These tables are synced but hold user workspace configuration, not ledger
+// data. They get commands so that the write boundary has no hole; none carry
+// money. Name-uniqueness checks and import parsing stay in the `app.ts`
+// handlers. `reportModel` / `filterModel` stay in their app modules and are
+// only used inside command bodies.
+import { filterModel } from '#server/filters/app';
+import { reportModel } from '#server/reports/app';
+import type {
+  CustomReportEntity,
+  DashboardWidgetEntity,
+  NewDashboardWidgetEntity,
+  TransactionFilterEntity,
+} from '#types/models';
+import type { SyncedPrefs } from '#types/prefs';
+import type { EverythingButIdOptional, WithOptional } from '#types/util';
+
+import { w } from './internal';
+import type { Id, Patch } from './internal';
+
+// Filters as the handlers build them (`tombstone` is never set there).
+type FilterInput = Omit<TransactionFilterEntity, 'tombstone'> &
+  Partial<Pick<TransactionFilterEntity, 'tombstone'>>;
+
+// generic update [preferences/app saveSyncedPrefs]
+export function saveSyncedPref(
+  id: keyof SyncedPrefs,
+  value: string | undefined,
+): Promise<void> {
+  return w.update('preferences', {
+    id,
+    value,
+  });
+}
+
+// generic insertWithSchema [dashboard/app createDashboardPage]
+export function createDashboardPage(p: { id: Id; name: string }): Promise<Id> {
+  return w.insertWithSchema('dashboard_pages', { id: p.id, name: p.name });
+}
+
+// generic updateWithSchema [dashboard/app renameDashboardPage]
+export function renameDashboardPage(p: {
+  id: Id;
+  name: string;
+}): Promise<void> {
+  return w.updateWithSchema('dashboard_pages', { id: p.id, name: p.name });
+}
+
+// generic delete_ [dashboard/app deleteDashboardPage]
+export function deleteDashboardPage(id: Id): Promise<void> {
+  return w.delete_('dashboard_pages', id);
+}
+
+// generic insertWithSchema [dashboard/app add, reset, import]
+// `x`/`y` are optional because base `addDashboardWidget` only computes them
+// when both are missing and writes the widget as given otherwise.
+export function createWidget(
+  widget: WithOptional<NewDashboardWidgetEntity, 'x' | 'y'> & {
+    id?: Id;
+    dashboard_page_id: Id;
+  },
+): Promise<Id> {
+  return w.insertWithSchema('dashboard', widget);
+}
+
+// generic update / updateWithSchema (base uses both): `updateDashboard`
+// writes with plain `update`, `updateDashboardWidget` with the schema.
+export function updateWidget(
+  widget:
+    | Patch<DashboardWidgetEntity>
+    | EverythingButIdOptional<Omit<DashboardWidgetEntity, 'tombstone'>>,
+  opts?: { schema?: boolean },
+): Promise<void> {
+  return opts?.schema
+    ? w.updateWithSchema('dashboard', widget)
+    : w.update('dashboard', widget);
+}
+
+// generic delete_ [dashboard/app]
+export function deleteWidget(id: Id): Promise<void> {
+  return w.delete_('dashboard', id);
+}
+
+// generic insertWithSchema(reportModel.fromJS) [reports/app, dashboard import]
+export function createReport(r: CustomReportEntity): Promise<Id> {
+  return w.insertWithSchema('custom_reports', reportModel.fromJS(r));
+}
+
+// generic updateWithSchema(reportModel.fromJS) [reports/app updateReport]
+export function updateReport(r: Patch<CustomReportEntity>): Promise<void> {
+  return w.updateWithSchema(
+    'custom_reports',
+    reportModel.fromJS(r as CustomReportEntity),
+  );
+}
+
+// generic updateWithSchema [dashboard/app importDashboard: report that already
+// exists]. `undefined` values become `null` (null clears the value in the DB;
+// undefined breaks the operation) and the report is un-tombstoned.
+export function restoreReport(r: CustomReportEntity): Promise<void> {
+  return w.updateWithSchema('custom_reports', {
+    ...Object.fromEntries(
+      Object.entries(reportModel.fromJS(r)).map(([key, value]) => [
+        key,
+        value ?? null,
+      ]),
+    ),
+    tombstone: false,
+  });
+}
+
+// generic delete_ [reports/app]
+export function deleteReport(id: Id): Promise<void> {
+  return w.delete_('custom_reports', id);
+}
+
+// generic insertWithSchema(filterModel.fromJS) [filters/app]
+export function createFilter(f: FilterInput): Promise<Id> {
+  return w.insertWithSchema('transaction_filters', filterModel.fromJS(f));
+}
+
+// generic updateWithSchema(filterModel.fromJS) [filters/app]
+export function updateFilter(f: FilterInput): Promise<void> {
+  return w.updateWithSchema('transaction_filters', filterModel.fromJS(f));
+}
+
+// generic delete_ [filters/app]
+export function deleteFilter(id: Id): Promise<void> {
+  return w.delete_('transaction_filters', id);
+}
