+// Brands a row's integer `amount` as `Cents` for the transaction commands
+// without adding, removing or reordering keys: a row without `amount` is
+// passed through as is (the insert schema defaults it, as in base), and a
+// nullish `amount` keeps its value, so the write produces exactly the
+// messages base produced.
+function withCents<T extends { amount?: number | null }>(
+  t: T,
+): Omit<T, 'amount'> & { amount: Cents | null } {
+  if (!('amount' in t) || t.amount == null) {
+    return t as Omit<T, 'amount'> & { amount: null };
+  }
+  return { ...t, amount: cents.fromInteger(t.amount) };
+}
