diff --git a/packages/loot-core/src/server/domain/internal.ts b/packages/loot-core/src/server/domain/internal.ts
new file mode 100644
index 0000000..915267c
--- /dev/null
+++ b/packages/loot-core/src/server/domain/internal.ts
@@ -0,0 +1,53 @@
+// Internal to `src/server/domain/`: imported only by sibling domain modules
+// and never re-exported by `domain/index.ts`.
+//
+// It is the only door from the domain layer to the CRDT write API
+// (`#server/db/write`), plus the shared helper types of the command
+// signatures.
+//
+// Commands implemented with the generic API (`update`, `insert`,
+// `insertWithUUID`, `delete_`, `insertWithSchema`, `updateWithSchema`)
+// because base has no data-specific write function for that table:
+//   accounts.createLinkedAccount, accounts.setAccountFields, accounts.createBank,
+//   payees.createPayeeLocation, payees.deletePayeeLocation,
+//   categories.setCategoryTemplateFields,
+//   budget.setBudgetAmount, budget.setBudgetGoal, budget.setBuffered,
+//   budget.setCarryover, budget.restoreCleanupGroup, budget.createCleanupGroup,
+//   schedules.createScheduleRows, schedules.updateScheduleRow,
+//   schedules.setScheduleNextDate, schedules.replaceScheduleRule,
+//   schedules.deleteScheduleWithRule,
+//   rules.createRule, rules.updateRule, rules.deleteRule,
+//   notes.saveNote, notes.appendToNote,
+//   every command of workspace.ts.
+//
+// Pre-existing raw SQL writes on synced tables (no CRDT messages, as in base),
+// preserved verbatim behind named commands:
+//   categories.resetGoalDefsWithoutTemplates  UPDATE categories SET goal_def = NULL   (was budget/statements.ts)
+//   categories.clearDefaultExpenseCategories  DELETE FROM categories / category_groups WHERE is_income = 0 (was api.ts start-import)
+//   budget.tombstoneOrphanCleanupGroups       UPDATE cleanup_groups SET tombstone = 1 (was budget/cleanup-groups.ts)
+//
+// Raw INSERT/UPDATE/DELETE sites left in place (local non-synced tables, the
+// db/sync engine itself, or test infrastructure):
+//   db/index.ts (loadClock), sync/index.ts, sync/repair.ts, budgetfiles/app.ts
+//                                   messages_clock, messages_crdt, messages_pending  (sync engine)
+//   sync/replay.ts, sync/reset.ts   CRDT apply, messages_pending, kvcache_key        (sync engine)
+//   sheet.ts, cloud-storage.ts, importers/actual.ts
+//                                   kvcache, kvcache_key                             (local spreadsheet cache)
+//   update.ts                       __meta__                                         (migration metadata)
+//   schedules/app.ts                schedules_json_paths                             (local derived index)
+//   mocks/setup.ts, mocks/budget.ts db_version, categories, category_groups          (test fixtures)
+import * as w from '#server/db/write';
+
+import type { Cents } from './money';
+
+export { w };
+
+export type Id = string;
+export type Patch<T extends { id: Id }> = Pick<T, 'id'> &
+  Partial<Omit<T, 'id'>>;
+export type WithCents<T, K extends keyof T> = Omit<T, K> & {
+  [P in K]: Cents;
+};
+export type WithCentsOpt<T, K extends keyof T> = Omit<T, K> & {
+  [P in K]?: Cents | null;
+};
