+// Domain commands for `accounts`, `account_groups` and `banks`.
+import type { DbAccount, DbAccountGroup, DbBank } from '#server/db';
+import type {
+  AccountEntity,
+  AccountGroupEntity,
+  BankEntity,
+} from '#types/models';
+import type { WithRequired } from '#types/util';
+
+import { w } from './internal';
+import type { Id, Patch, WithCentsOpt } from './internal';
+import type { Cents } from './money';
+
+type MoneyFields = 'balance_current' | 'balance_available' | 'balance_limit';
+
+export type NewAccount = WithRequired<
+  Partial<Omit<DbAccount, 'id' | MoneyFields>>,
+  'name'
+> & { id?: Id } & { [K in MoneyFields]?: Cents | null };
+
+export type AccountPatch = WithCentsOpt<Patch<DbAccount>, MoneyFields>;
+
+// [insertAccount (sort order + validate)]
+export function createAccount(a: NewAccount): Promise<AccountEntity['id']> {
+  return w.insertAccount(a);
+}
+
+// generic insertWithUUID [accounts/app: 5 link flows]
+export function createLinkedAccount(
+  a: NewAccount & { id: Id },
+): Promise<AccountEntity['id']> {
+  return w.insertWithUUID('accounts', a);
+}
+
+// [updateAccount (validate): api, accounts/app]
+export function updateAccount(a: AccountPatch): Promise<void> {
+  return w.updateAccount(a);
+}
+
+// generic update, no validate [accounts/app: rename, link, close/reopen, sync
+// status; accounts/sync balance]
+export function setAccountFields(a: AccountPatch): Promise<void> {
+  return w.update('accounts', a);
+}
+
+// [deleteAccount]
+export function deleteAccount(a: { id: Id }): Promise<void> {
+  return w.deleteAccount(a);
+}
+
+// [moveAccount]
+export function moveAccount(
+  id: Id,
+  targetId: Id | null,
+  accountGroupId?: Id | null,
+): Promise<void> {
+  return w.moveAccount(id, targetId, accountGroupId);
+}
+
+// [insertAccountGroup]
+export function createAccountGroup(
+  g: WithRequired<Partial<DbAccountGroup>, 'name'>,
+): Promise<AccountGroupEntity['id']> {
+  return w.insertAccountGroup(g);
+}
+
+// [updateAccountGroup]
+export function updateAccountGroup(
+  g: WithRequired<Partial<DbAccountGroup>, 'id' | 'name'>,
+): Promise<void> {
+  return w.updateAccountGroup(g);
+}
+
+// [moveAccountGroup]
+export function moveAccountGroup(id: Id, targetId?: Id | null): Promise<void> {
+  return w.moveAccountGroup(id, targetId);
+}
+
+// [deleteAccountGroup]
+export function deleteAccountGroup(g: { id: Id }): Promise<void> {
+  return w.deleteAccountGroup(g);
+}
+
+// generic insertWithUUID [accounts/link]
+export function createBank(
+  b: Omit<DbBank, 'tombstone'>,
+): Promise<BankEntity['id']> {
+  return w.insertWithUUID('banks', b);
+}
diff --git a/packages/loot-core/src/server/domain/budget.ts b/packages/loot-core/src/server/domain/budget.ts
new file mode 100644
index 0000000..9bf9fe2
--- /dev/null
+++ b/packages/loot-core/src/server/domain/budget.ts
@@ -0,0 +1,160 @@
+// Domain commands for `zero_budgets` / `reflect_budgets`,
+// `zero_budget_months` and `cleanup_groups`.
+//
+// The read-then-insert-or-update logic of base `budget/actions.ts`
+// (`setBudget`, `setGoal`, `setBuffer`, `setCarryover`) lives here unchanged.
+// These commands are deliberately not `async`: base ran the existence check
+// synchronously (`firstSync`) and returned the write promise, and callers
+// rely on that inside `batchMessages` (`void setBudget(...)` in loops).
+import * as db from '#server/db';
+import type { CategoryEntity } from '#types/models';
+
+import { w } from './internal';
+import type { Id } from './internal';
+import type { Cents } from './money';
+
+type BudgetCell = { category: CategoryEntity['id']; month: string };
+type BudgetTable = 'reflect_budgets' | 'zero_budgets';
+
+// Same query as base `budget/actions.ts` `getBudgetTable()`.
+function activeBudgetTable(): BudgetTable {
+  const budgetType = db.firstSync<Pick<db.DbPreference, 'value'>>(
+    `SELECT value FROM preferences WHERE id = ?`,
+    ['budgetType'],
+  );
+  const val = budgetType ? budgetType.value : 'envelope';
+  return val === 'tracking' ? 'reflect_budgets' : 'zero_budgets';
+}
+
+// Same conversion as base `budget/actions.ts` `dbMonth()`.
+function dbMonth(month: string): number {
+  return parseInt(month.replace('-', ''));
+}
+
+function existingCell(
+  table: BudgetTable,
+  month: number | string,
+  category: CategoryEntity['id'],
+) {
+  return db.firstSync<Pick<db.DbZeroBudget | db.DbReflectBudget, 'id'>>(
+    `SELECT id FROM ${table} WHERE month = ? AND category = ?`,
+    [month, category],
+  );
+}
+
+// [actions.setBudget: update | insert on the active budget table]
+export function setBudgetAmount({
+  category,
+  month,
+  amount,
+}: BudgetCell & { amount: Cents }): Promise<void> {
+  const table = activeBudgetTable();
+  const existing = existingCell(table, dbMonth(month), category);
+  if (existing) {
+    return w.update(table, { id: existing.id, amount });
+  }
+  return w.insert(table, {
+    id: `${dbMonth(month)}-${category}`,
+    month: dbMonth(month),
+    category,
+    amount,
+  });
+}
+
+// [actions.setGoal]. `goal` is money; `long_goal` is a flag.
+export function setBudgetGoal({
+  category,
+  month,
+  goal,
+  long_goal,
+}: BudgetCell & {
+  goal: Cents | null;
+  long_goal: 0 | 1 | null;
+}): Promise<void> {
+  const table = activeBudgetTable();
+  const existing = existingCell(table, dbMonth(month), category);
+  if (existing) {
+    return w.update(table, {
+      id: existing.id,
+      goal,
+      long_goal,
+    });
+  }
+  return w.insert(table, {
+    id: `${dbMonth(month)}-${category}`,
+    month: dbMonth(month),
+    category,
+    goal,
+    long_goal,
+  });
+}
+
+// [actions.setBuffer: zero_budget_months]
+export function setBuffered(month: string, amount: Cents): Promise<void> {
+  const existing = db.firstSync<Pick<db.DbZeroBudget, 'id'>>(
+    `SELECT id FROM zero_budget_months WHERE id = ?`,
+    [month],
+  );
+  if (existing) {
+    return w.update('zero_budget_months', {
+      id: existing.id,
+      buffered: amount,
+    });
+  }
+  return w.insert('zero_budget_months', { id: month, buffered: amount });
+}
+
+// [actions.setCarryover: update | insert on the active budget table].
+// Takes `month` as YYYY-MM; the row id and `month` value are the `dbMonth`
+// string, exactly as base wrote them.
+export function setCarryover({
+  category,
+  month,
+  flag,
+}: BudgetCell & { flag: boolean }): Promise<void> {
+  const table = activeBudgetTable();
+  const m = dbMonth(month).toString();
+  const existing = existingCell(table, m, category);
+  if (existing) {
+    return w.update(table, { id: existing.id, carryover: flag ? 1 : 0 });
+  }
+  return w.insert(table, {
+    id: `${m}-${category}`,
+    month: m,
+    category,
+    carryover: flag ? 1 : 0,
+  });
+}
+
+// generic update tombstone = 0 [cleanup-groups]
+export function restoreCleanupGroup(id: Id): Promise<void> {
+  return w.update('cleanup_groups', { id, tombstone: 0 });
+}
+
+// generic insertWithSchema [cleanup-groups]
+export function createCleanupGroup(g: { id: Id; name: string }): Promise<Id> {
+  return w.insertWithSchema('cleanup_groups', {
+    id: g.id,
+    name: g.name,
+    tombstone: 0,
+  });
+}
+
+// Pre-existing raw SQL write, preserved verbatim (no CRDT messages, as in
+// base). [cleanup-groups tombstoneOrphanCleanupGroups]
+export async function tombstoneOrphanCleanupGroups(): Promise<void> {
+  await db.run(
+    `
+      UPDATE cleanup_groups
+      SET tombstone = 1
+      WHERE tombstone = 0
+        AND id NOT IN (
+          SELECT json_extract(je.value, '$.groupId') AS group_id
+          FROM categories c, json_each(c.cleanup_def) je
+          WHERE c.tombstone = 0
+            AND c.cleanup_def IS NOT NULL
+            AND json_extract(je.value, '$.groupId') IS NOT NULL
+        )
+    `,
+  );
+}
diff --git a/packages/loot-core/src/server/domain/categories.ts b/packages/loot-core/src/server/domain/categories.ts
