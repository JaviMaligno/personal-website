@@ -0,0 +1,31 @@
+import { amountToInteger, integerToAmount } from '#shared/util';
+import type { Amount } from '#shared/util';
+
+declare const brand: unique symbol;
+
+/**
+ * Integer minor units of the budget currency (`decimals` defaults to 2, as
+ * `amountToInteger` does). Money crosses the domain boundary only as `Cents`.
+ * The only ways to obtain one are the constructors on `cents`.
+ */
+export type Cents = number & { readonly [brand]: 'Cents' };
+
+function fromInteger(n: number): Cents {
+  if (!Number.isInteger(n)) {
+    throw new Error('Cents must be an integer');
+  }
+  return n as Cents;
+}
+
+export const cents = {
+  fromInteger,
+  fromAmount: (a: Amount, decimals = 2): Cents =>
+    fromInteger(amountToInteger(a, decimals)),
+  toAmount: (c: Cents, decimals = 2): Amount => integerToAmount(c, decimals),
+  add: (a: Cents, b: Cents): Cents => (a + b) as Cents,
+  sub: (a: Cents, b: Cents): Cents => (a - b) as Cents,
+  neg: (a: Cents): Cents => -a as Cents,
+  sum: (xs: readonly Cents[]): Cents =>
+    xs.reduce<number>((s, x) => s + x, 0) as Cents,
+  zero: 0 as Cents,
+};
diff --git a/packages/loot-core/src/server/domain/mutation.ts b/packages/loot-core/src/server/domain/mutation.ts
new file mode 100644
index 0000000..cbacbe5
--- /dev/null
+++ b/packages/loot-core/src/server/domain/mutation.ts
@@ -0,0 +1,24 @@
+import { mutator } from '#server/mutators';
+import { undoable } from '#server/undo';
+import type { HandlerFunctions } from '#types/handlers';
+
+/**
+ * Register a user-facing, undoable mutation in one named call:
+ *
+ *   app.method(...mutation('budget/budget-amount', actions.setBudget))
+ *
+ * is exactly
+ *
+ *   app.method('budget/budget-amount', mutator(undoable(actions.setBudget)))
+ *
+ * `meta` is passed to `undoable` unchanged (base uses it for `payees-merge`).
+ * Handlers that base registers as `mutator(handler)` without undo keep that
+ * form: wrapping them here would add undo and change behaviour.
+ */
+export function mutation<K extends string, H extends HandlerFunctions>(
+  name: K,
+  handler: H,
+  meta?: (...args: Parameters<H>) => unknown,
+): readonly [K, ReturnType<typeof undoable<H>>] {
+  return [name, mutator(undoable(handler, meta))] as const;
+}
