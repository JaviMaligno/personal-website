+// Domain commands for `schedules` and `schedules_next_date`.
+//
+// Schedule amounts live inside rule conditions (`_amount` JSON) and are not
+// typed as `Cents` (a-plus-design §5).
+import type { DbSchedule, DbScheduleNextDate } from '#server/db';
+import { toDateRepr } from '#server/models';
+import { batchMessages } from '#server/sync';
+import type { ScheduleEntity } from '#types/models';
+
+import { w } from './internal';
+import type { Id, Patch } from './internal';
+
+// generic insertWithUUID schedules_next_date + insertWithSchema schedules
+// [schedules/app createSchedule]. `nextDate` is the YYYY-MM-DD next date (or
+// null when there is none); it is stored as its date repr, as base did.
+export async function createScheduleRows({
+  schedule,
+  id,
+  ruleId,
+  nextDate,
+  now,
+}: {
+  schedule: Omit<Partial<DbSchedule>, 'id' | 'rule'>;
+  id: Id;
+  ruleId: Id;
+  nextDate: string | null;
+  now: number;
+}): Promise<void> {
+  const nextDateRepr = nextDate ? toDateRepr(nextDate) : null;
+  await w.insertWithUUID('schedules_next_date', {
+    schedule_id: id,
+    local_next_date: nextDateRepr,
+    local_next_date_ts: now,
+    base_next_date: nextDateRepr,
+    base_next_date_ts: now,
+  });
+
+  await w.insertWithSchema('schedules', {
+    ...schedule,
+    id,
+    rule: ruleId,
+  });
+}
+
+// generic updateWithSchema [schedules/app updateSchedule]
+export function updateScheduleRow(s: Patch<ScheduleEntity>): Promise<void> {
+  return w.updateWithSchema('schedules', s);
+}
+
+// generic update [schedules/app setNextDate]
+export function setScheduleNextDate(
+  n: Patch<DbScheduleNextDate>,
+): Promise<void> {
+  return w.update('schedules_next_date', n);
+}
+
+// generic delete_ rules + updateWithSchema [fixRuleForSchedule]: retires the
+// schedule's old rule (when there is one) and links the new one.
+export async function replaceScheduleRule(
+  id: Id,
+  oldRuleId: Id | null,
+  newRuleId: Id,
+): Promise<void> {
+  if (oldRuleId) {
+    await w.delete_('rules', oldRuleId);
+  }
+  await w.updateWithSchema('schedules', { id, rule: newRuleId });
+}
+
+// generic delete_ rules + schedules in batchMessages [deleteSchedule]
+export async function deleteScheduleWithRule(
+  id: Id,
+  ruleId: Id,
+): Promise<void> {
+  await batchMessages(async () => {
+    await w.delete_('rules', ruleId);
+    await w.delete_('schedules', id);
+  });
+}
+
+// [moveSchedule]
+export function moveSchedule(id: Id, targetId: Id | null): Promise<void> {
+  return w.moveSchedule(id, targetId);
+}
