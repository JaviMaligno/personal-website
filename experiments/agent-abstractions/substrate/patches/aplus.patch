@@ -0,0 +1,117 @@
+// Domain commands for `categories` and `category_groups`.
+import { GOAL_PREFIX, TEMPLATE_PREFIX } from '#server/budget/template-prefixes';
+import * as db from '#server/db';
+import type { DbCategory, DbCategoryGroup } from '#server/db';
+import type { CategoryEntity, CategoryGroupEntity } from '#types/models';
+import type { WithRequired } from '#types/util';
+
+import { w } from './internal';
+import type { Id } from './internal';
+
+// [insertCategory]
+export function createCategory(
+  c: WithRequired<Partial<DbCategory>, 'name' | 'cat_group'>,
+  opts?: { atEnd?: boolean },
+): Promise<CategoryEntity['id']> {
+  // An omitted `opts` reaches the write function as `undefined`, which
+  // triggers its own default parameter, exactly as an omitted argument does.
+  return w.insertCategory(c, opts);
+}
+
+// [updateCategory]
+export function updateCategory(
+  c: WithRequired<Partial<DbCategory>, 'name' | 'is_income' | 'cat_group'>,
+): Promise<void> {
+  return w.updateCategory(c);
+}
+
+// generic updateWithSchema [cleanup-template-notes, goal-template].
+// Accepts the field shapes base passes: `goal_def`/`cleanup_def` as JSON
+// strings or null, `template_settings` as an object converted by the schema.
+export function setCategoryTemplateFields(
+  p: Pick<DbCategory, 'id'> & {
+    goal_def?: string | null;
+    cleanup_def?: string | null;
+    template_settings?: unknown;
+  },
+): Promise<void> {
+  return w.updateWithSchema('categories', p);
+}
+
+// [moveCategory: budget/app, sort-categories]
+export function moveCategory(
+  id: Id,
+  groupId: Id,
+  targetId?: Id | null,
+): Promise<void> {
+  return w.moveCategory(id, groupId, targetId);
+}
+
+// [deleteCategory]
+export function deleteCategory(
+  c: { id: Id },
+  transferId?: Id | null,
+): Promise<void> {
+  return w.deleteCategory(c, transferId);
+}
+
+// [insertCategoryGroup]
+export function createCategoryGroup(
+  g: WithRequired<Partial<DbCategoryGroup>, 'name'>,
+): Promise<CategoryGroupEntity['id']> {
+  return w.insertCategoryGroup(g);
+}
+
+// [updateCategoryGroup]
+export function updateCategoryGroup(
+  g: WithRequired<Partial<DbCategoryGroup>, 'id' | 'name' | 'is_income'>,
+): Promise<void> {
+  return w.updateCategoryGroup(g);
+}
+
+// [moveCategoryGroup]
+export function moveCategoryGroup(id: Id, targetId?: Id | null): Promise<void> {
+  return w.moveCategoryGroup(id, targetId);
+}
+
+// [deleteCategoryGroup]
+export function deleteCategoryGroup(
+  g: { id: Id },
+  transferId?: Id | null,
+): Promise<void> {
+  return w.deleteCategoryGroup(g, transferId);
+}
+
+// Pre-existing raw SQL writes, preserved verbatim (no CRDT messages, as in
+// base).
+
+// raw db.run UPDATE categories [budget/statements
+// resetCategoryGoalDefsWithNoTemplates]
+export async function resetGoalDefsWithoutTemplates(
+  categoryIds?: Id[],
+): Promise<void> {
+  if (categoryIds?.length === 0) return;
+  const scopeClause = categoryIds
+    ? `AND id IN (${categoryIds.map(() => '?').join(',')})`
+    : '';
+  await db.run(
+    `
+      UPDATE categories
+      SET goal_def = NULL
+      WHERE id NOT IN (SELECT n.id
+                       FROM notes n
+                       WHERE lower(note) LIKE '%${TEMPLATE_PREFIX}%'
+                          OR lower(note) LIKE '%${GOAL_PREFIX}%')
+        AND COALESCE(JSON_EXTRACT(template_settings, '$.source'), 'notes') <> 'ui'
+        ${scopeClause}
+    `,
+    categoryIds ?? [],
+  );
+}
+
+// raw runQuery DELETE categories + category_groups WHERE is_income = 0
+// [api.ts start-import]
+export function clearDefaultExpenseCategories(): void {
+  db.runQuery('DELETE FROM categories WHERE is_income = 0');
+  db.runQuery('DELETE FROM category_groups WHERE is_income = 0');
+}
