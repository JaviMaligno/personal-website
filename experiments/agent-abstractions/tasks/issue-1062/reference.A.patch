+// Months that do not have the given day of the month (29 is only missing
+// from February in common years, which is handled by the de-duplication of
+// occurrences: in leap years both rules produce the 29th).
+function monthsWithoutDay(day: number): number[] {
+  if (day >= 31) {
+    return [2, 4, 6, 9, 11];
+  } else if (day >= 29) {
+    return [2];
+  }
+  return [];
+}
+
+function lastDayOfMonth(year: number, month: number): number {
+  return new Date(year, month + 1, 0).getDate();
+}
+
+// Date of the `count`-th occurrence of a monthly schedule on `days` (days of
+// the month, -1 meaning the last day), where days a month does not have fall on
+// its last day.
+function nthMonthlyOccurrence(
+  start: Date,
+  interval: number,
+  days: number[],
+  count: number,
+): Date | null {
+  if (!(count > 0)) {
+    return null;
+  }
+  const startDay = d.startOfDay(start);
+  let seen = 0;
+  // Bounded loop: every month yields at least one occurrence after the first
+  for (let i = 0; i < count + 1; i++) {
+    const month = d.addMonths(d.startOfMonth(startDay), i * interval);
+    const last = lastDayOfMonth(month.getFullYear(), month.getMonth());
+    const monthDays = [
+      ...new Set(days.map(day => (day === -1 ? last : Math.min(day, last)))),
+    ].sort((a, b) => a - b);
+    for (const day of monthDays) {
+      const date = new Date(month.getFullYear(), month.getMonth(), day);
+      if (date >= startDay) {
+        seen++;
+        if (seen === count) {
+          return date;
+        }
+      }
+    }
+  }
+  return null;
+}
+
+// Rules for a monthly schedule on the given days of the month. A day that a
+// month does not have (29th, 30th or 31st) falls on the last day of that month
+// instead of skipping it: an extra rule produces the last day of the short
+// months, and the schedule de-duplicates dates produced by both rules.
+function monthlyDayRules(
+  rule: ScheduleRuleOptions,
+  days: number[],
+): ScheduleRuleOptions[] {
+  const shortMonths = monthsWithoutDay(Math.max(...days));
+  if (shortMonths.length === 0) {
+    return [rule];
+  }
+
+  const rules: ScheduleRuleOptions[] = [
+    { ...rule },
+    { ...rule, byDayOfMonth: [-1], byMonthOfYear: shortMonths },
+  ];
