+    // A count is per rule: replace it by the date of the last occurrence
+    const end = nthMonthlyOccurrence(
+      rule.start as Date,
+      rule.interval || 1,
+      days,
+      rule.count,
+    );
+    for (const r of rules) {
+      delete r.count;
+      r.end = d.endOfDay(end ?? (rule.start as Date));
+    }
+  }
+
+  return rules;
+}
