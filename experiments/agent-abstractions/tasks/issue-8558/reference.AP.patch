+ */
+function getPreviousCloseOccurrence(
+  dateCond: RuleConditionEntity | undefined,
+  occurrenceDate: string,
+): string | null {
+  if (!dateCond || dateCond.value == null) {
+    return null;
+  }
+
+  let value;
+  try {
+    value = new Condition(dateCond.op, 'date', dateCond.value, null).getValue();
+  } catch {
+    return null;
+  }
+  if (value?.type !== 'recur') {
+    return null;
+  }
