+// A preview decision for one imported row: a string is the id of the
+// existing transaction the preview matched it to, `null` means the preview
+// found no match, and `undefined` means no decision was given.
+type MatchDecision = string | null | undefined;
+
+function normalizeMatchDecision(value: unknown): MatchDecision {
+  if (value === undefined) {
+    return undefined;
+  }
+  if (value === null) {
+    return null;
+  }
+  if (typeof value !== 'string' || value === '') {
+    throw new TransactionError(
+      `matchedTransactionId is invalid, must be a transaction id or null: ${String(value)}`,
+    );
+  }
+  return value;
+}
