+function hasOneOfCategoryRule(payeeId: string, category: string) {
+  // Any stage: a "payee one of" rule setting the same category makes a
+  // learned "payee is" rule redundant regardless of when it runs.
+  for (const stage of [null, 'pre', 'post']) {
+    const rule = getOneOfSetterRules(stage, 'payee', 'category', {
+      condValue: payeeId,
+      actionValue: category,
+    }).next().value;
+    if (rule) {
+      return true;
+    }
+  }
+  return false;
+}
