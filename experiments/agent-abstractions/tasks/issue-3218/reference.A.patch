+/**
+ * Whether an account has no transactions of its own: it is empty, or
+ * everything it holds (up to today) is a transfer leg whose other side lives
+ * in another account and that was not imported into this account. Bank sync
+ * treats such an account like a brand-new one (it gets a Starting Balance).
+ * `oldestDate` is the date of the oldest of those transfer legs, if any.
+ */
+async function getAccountOwnHistory(
+  id: AccountEntity['id'],
+): Promise<{ isNew: boolean; oldestDate: string | null }> {
+  const { data: rows } = await aqlQuery(
+    q('transactions')
+      .filter({
+        account: id,
+        date: { $lte: monthUtils.currentDay() },
+      })
+      .select(['id', 'date', 'transfer_id', 'imported_id'])
+      .options({ splits: 'all' }),
+  );
+
+  if (!rows || rows.length === 0) {
+    return { isNew: true, oldestDate: null };
+  }
+
+  if (rows.some(row => row.transfer_id == null || row.imported_id != null)) {
+    return { isNew: false, oldestDate: null };
+  }
+
+  const { data: partners } = await aqlQuery(
+    q('transactions')
+      .filter({ id: { $oneof: rows.map(row => row.transfer_id) } })
+      .select(['id', 'account'])
+      .options({ splits: 'all' }),
+  );
+  const partnerAccounts = new Map<string, string>(
+    (partners || []).map(partner => [partner.id, partner.account]),
+  );
+
+  const onlyIncomingTransfers = rows.every(row => {
+    const partnerAccount = partnerAccounts.get(row.transfer_id);
+    return partnerAccount != null && partnerAccount !== id;
+  });
+  if (!onlyIncomingTransfers) {
+    return { isNew: false, oldestDate: null };
+  }
+
+  const oldestDate: string | null = rows.reduce(
+    (oldest: string | null, row) =>
+      oldest == null || row.date < oldest ? row.date : oldest,
+    null,
+  );
+  return { isNew: true, oldestDate };
+}
