+// An existing transaction in the transferred account that is the other side
+// of this one: same date, opposite amount, and not part of a transfer yet.
+async function findCounterpart(transaction, transferredAccount) {
+  if (!transaction.date || transaction.amount == null) {
+    return null;
+  }
+
+  return db.first<Pick<db.DbViewTransactionInternal, 'id'>>(
+    `SELECT id FROM v_transactions_internal
+     WHERE account = ? AND date = ? AND amount = ? AND id != ?
+       AND transfer_id IS NULL AND is_parent = 0 AND tombstone = 0
+     ORDER BY sort_order DESC, id
+     LIMIT 1`,
+    [
+      transferredAccount,
+      toDateRepr(transaction.date),
+      cents.neg(cents.fromInteger(transaction.amount)),
+      transaction.id,
+    ],
+  );
+}
+
+// Link two existing transactions as the two sides of one transfer instead of
+// creating a new leg in the transferred account.
+async function linkTransfer(transaction, counterpartId, transferredAccount) {
+  const { id: fromPayee } = await db.first<Pick<db.DbPayee, 'id'>>(
+    'SELECT id FROM payees WHERE transfer_acct = ?',
+    [transaction.account],
+  );
+
+  await transactions.updateTransaction({
+    id: counterpartId,
+    payee: fromPayee,
+    transfer_id: transaction.id,
+  });
+  await transactions.updateTransaction({
+    id: transaction.id,
+    transfer_id: counterpartId,
+  });
+
+  const categoryCleared = await clearCategory(
+    { ...transaction, transfer_id: counterpartId },
+    transferredAccount,
+  );
+
+  return {
+    id: transaction.id,
+    transfer_id: counterpartId,
+    ...(categoryCleared ? { category: null } : {}),
+  };
+}
+
