+// Reads a transaction, dead or alive, with its fields in schema form
+async function getRow(id: string | null | undefined) {
+  if (!id) {
+    return null;
+  }
+  const rows = await db.selectWithSchema(
+    'transactions',
+    'SELECT * FROM v_transactions_internal WHERE id = ?',
+    [id],
+  );
+  return rows[0] || null;
+}
+
+// The alive lines of a split transaction
+async function getLines(parentId: string) {
+  return db.selectWithSchema(
+    'transactions',
+    `SELECT * FROM v_transactions_internal
+       WHERE parent_id = ? AND is_child = 1 AND IFNULL(tombstone, 0) = 0`,
+    [parentId],
+  );
+}
+
+// Two splits are mirrored when their parents are linked as the two
+// sides of a transfer. `line` and `counterpart` are lines of splits.
+async function isMirroredLine(line, counterpart) {
+  if (!line.parent_id || !counterpart.parent_id) {
+    return false;
+  }
+  const [parent, otherParent] = await Promise.all([
+    getRow(line.parent_id),
+    getRow(counterpart.parent_id),
+  ]);
+  return Boolean(
+    parent &&
+    otherParent &&
+    (parent.transfer_id === otherParent.id ||
+      otherParent.transfer_id === parent.id),
+  );
+}
