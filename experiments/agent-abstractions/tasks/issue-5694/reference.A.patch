+
+function sumAmounts(transactions) {
+  return transactions.reduce((total, t) => total + (t.amount || 0), 0);
+}
+
+// Writes only the fields that differ from `row`, and returns the patch
+async function setFields(row, fields) {
+  const patch = Object.fromEntries(
+    Object.entries(fields).filter(([key, value]) => row[key] !== value),
+  );
+  if (Object.keys(patch).length === 0) {
+    return null;
+  }
+  await db.updateTransaction({ id: row.id, ...patch });
+  Object.assign(row, patch);
+  return { id: row.id, ...patch };
+}
+
+// The account that every line of the split transfers to, if there is
+// exactly one such account and every line is a linked transfer
+async function mirroredAccount(parent, lines) {
+  if (lines.length === 0) {
+    return null;
+  }
+  let target = null;
+  for (const line of lines) {
+    if (!line.transfer_id || line.account !== parent.account) {
+      return null;
+    }
+    const account = await getTransferredAccount(line);
+    if (!account || account === parent.account) {
+      return null;
+    }
+    if (target && target !== account) {
+      return null;
+    }
+    target = account;
+  }
+  return target;
+}
+
+// Deletes an alive split that has lost all of its lines, or keeps its
+// total equal to the sum of the lines it still has
+async function tidySplit(parentId: string) {
+  const parent = await getRow(parentId);
+  if (!parent || parent.tombstone || !parent.is_parent) {
+    return;
+  }
+  const lines = await getLines(parent.id);
+  if (lines.length === 0) {
+    await db.deleteTransaction({ id: parent.id });
+  } else {
+    await setFields(parent, { amount: sumAmounts(lines) });
+  }
+}
+
+// Makes `mirror` (created when missing) the split in `target` whose lines
+// are the counterparts of the lines of `source`, and links both parents
+async function syncMirror(source, lines, target, mirror, patches) {
+  const counterparts = (
+    await Promise.all(lines.map(line => getRow(line.transfer_id)))
+  ).filter(t => t && !t.tombstone && !t.is_parent);
+
+  if (!mirror) {
+    // Adopt a split that already holds exactly these counterparts
+    const parentIds = new Set(counterparts.map(t => t.parent_id));
+    const [parentId] = [...parentIds];
+    if (
+      parentId &&
+      parentIds.size === 1 &&
+      counterparts.length === lines.length
+    ) {
+      const candidate = await getRow(parentId);
+      if (
+        candidate &&
+        !candidate.tombstone &&
+        candidate.account === target &&
+        !candidate.transfer_id &&
+        (await getLines(candidate.id)).length === counterparts.length
+      ) {
+        mirror = candidate;
+      }
+    }
+  }
+
+  if (!mirror) {
+    const fromPayee = await getPayee(source.account);
+    const sourceTarget = await getTransferredAccount(source);
+    const id = await db.insertTransaction({
+      account: target,
+      amount: sumAmounts(counterparts),
+      payee: sourceTarget === target && fromPayee ? fromPayee.id : null,
+      date: source.date,
+      notes: source.notes || null,
+      is_parent: true,
+      transfer_id: source.id,
+      cleared: false,
+    });
+    mirror = await getRow(id);
+  }
+
+  const oldParents = new Set<string>();
+  for (const counterpart of counterparts) {
+    if (counterpart.parent_id !== mirror.id || !counterpart.is_child) {
+      if (counterpart.parent_id) {
+        oldParents.add(counterpart.parent_id);
+      }
+      await db.updateTransaction({
+        id: counterpart.id,
+        parent_id: mirror.id,
+        is_child: true,
+      });
+    }
+  }
+
+  const mirrorLines = await getLines(mirror.id);
+  const mirrorPatch = await setFields(mirror, {
+    account: target,
+    amount: sumAmounts(mirrorLines),
+    is_parent: true,
+    transfer_id: source.id,
+  });
+  const sourcePatch = await setFields(source, {
+    amount: sumAmounts(lines),
+    transfer_id: mirror.id,
+  });
+  patches.push(...[mirrorPatch, sourcePatch].filter(Boolean));
+
+  for (const parentId of oldParents) {
+    if (parentId !== mirror.id && parentId !== source.id) {
+      await tidySplit(parentId);
+    }
+  }
+}
+
+// Two linked splits that no longer mirror each other: unlink them. A side
+// with lines that moved to other accounts was generated as a mirror, so its
+// lines become ordinary transfers and its parent goes away.
+async function dissolveMirror(split, lines, other, otherLines, patches) {
+  const linesMoved = (parent, parentLines) =>
+    parentLines.some(line => line.account !== parent.account);
+
+  for (const parent of [split, other]) {
+    const patch = await setFields(parent, { transfer_id: null });
+    if (patch) {
+      patches.push(patch);
+    }
+  }
+
+  for (const [parent, parentLines] of [
+    [split, lines],
+    [other, otherLines],
+  ]) {
+    if (linesMoved(parent, parentLines)) {
+      for (const line of parentLines) {
+        await db.updateTransaction({
+          id: line.id,
+          parent_id: null,
+          is_child: false,
+        });
+      }
+      await db.deleteTransaction({ id: parent.id });
+    } else {
+      await tidySplit(parent.id);
+    }
+  }
+}
+
+async function reconcileSplit(id: string, done: Set<string>, patches) {
+  done.add(id);
+  const row = await getRow(id);
+  if (!row) {
+    return;
+  }
+  const partner = await getRow(row.transfer_id);
+
+  if (row.tombstone || !row.is_parent) {
+    // A deleted split leaves no lines behind
+    if (row.tombstone && row.is_parent) {
+      for (const line of await getLines(row.id)) {
+        await db.deleteTransaction({ id: line.id });
+      }
+    }
+    // A split that was deleted or turned back into a single transaction
+    // takes its mirrored split with it, or turns it back too
+    if (partner && partner.is_parent && partner.transfer_id === row.id) {
+      done.add(partner.id);
+      for (const line of await getLines(partner.id)) {
+        await db.deleteTransaction({ id: line.id });
+      }
+      if (row.tombstone) {
+        if (!partner.tombstone) {
+          await db.deleteTransaction({ id: partner.id });
+        }
+      } else if (!partner.tombstone) {
+        await setFields(partner, { is_parent: false, amount: -row.amount });
+      }
+    }
+    return;
+  }
+
+  const lines = await getLines(row.id);
+  const target = await mirroredAccount(row, lines);
+  const mirror =
+    partner && partner.is_parent && !partner.tombstone ? partner : null;
+
+  if (mirror) {
+    done.add(mirror.id);
+    if (target) {
+      return syncMirror(row, lines, target, mirror, patches);
+    }
+    const mirrorLines = await getLines(mirror.id);
+    const mirrorTarget = await mirroredAccount(mirror, mirrorLines);
+    if (mirrorTarget) {
+      return syncMirror(mirror, mirrorLines, mirrorTarget, row, patches);
+    }
+    return dissolveMirror(row, lines, mirror, mirrorLines, patches);
+  }
+
+  if (target && !partner) {
+    return syncMirror(row, lines, target, null, patches);
+  }
+}
+
+// When every line of a split transfers to the same account, the other
+// account gets one split for the full amount whose lines mirror these
+// lines, instead of one loose transaction per line. Runs after the
+// per-transaction transfer logic, on the transactions of a batch.
+export async function reconcileSplitTransfers(ids: string[]) {
+  const candidates = new Set<string>();
+  for (const id of new Set(ids)) {
+    const row = await getRow(id);
+    if (!row) {
+      continue;
+    }
+    if (row.is_parent) {
+      candidates.add(row.id);
+    }
+    if (row.parent_id) {
+      candidates.add(row.parent_id);
+    }
+    if (row.transfer_id) {
+      if (!row.is_parent && !row.parent_id) {
+        candidates.add(row.id);
+      }
+      const counterpart = await getRow(row.transfer_id);
+      if (counterpart?.is_parent) {
+        candidates.add(counterpart.id);
+      } else if (counterpart?.parent_id) {
+        candidates.add(counterpart.parent_id);
+      }
+    }
+  }
+
+  const done = new Set<string>();
+  const patches = [];
+  for (const id of candidates) {
+    if (!done.has(id)) {
+      await reconcileSplit(id, done, patches);
+    }
+  }
+  return patches;
+}
