+// A part of a split whose parent already corresponds to an imported
+// transaction is accounted for by that import: it must never be taken as the
+// fuzzy match of a different incoming transaction (the incoming transaction
+// would otherwise be swallowed by the part, overwriting its imported data).
+// Parts of splits with no imported counterpart (e.g. entered by hand) stay
+// eligible.
+const NOT_CHILD_OF_IMPORTED_PARENT = `(
+  parent_id IS NULL
+  OR parent_id NOT IN (
+    SELECT id FROM v_transactions
+    WHERE is_parent = 1 AND imported_id IS NOT NULL
+  )
+)`;
+
 export async function matchTransactions(
   acctId,
   transactions,
@@ -924,7 +938,8 @@ export async function matchTransactions(
             -- If both ids are set, and we didn't match earlier then skip dedup
