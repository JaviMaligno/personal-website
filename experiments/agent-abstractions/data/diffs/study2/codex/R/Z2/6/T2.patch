+import { describe, expect, it } from 'vitest';
+import type { ScheduleEntity } from '#types/models';
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  it('includes the expected schedule amount', () => {
+    const schedule = {
+      id: 'schedule',
+      name: 'Schedule',
+      rule: 'rule',
+      next_date: '2024-01-01',
+      completed: false,
+      posts_transaction: false,
+      tombstone: false,
+      _payee: 'payee',
+      _account: 'account',
+      _amount: -10100,
+      _amountOp: 'isbetween',
+      _date: '2024-01-01',
+      _conditions: [],
+      _actions: [],
+    } satisfies ScheduleEntity;
+
+    expect(scheduleModel.toExternal(schedule).expectedAmount).toBe(-10100);
+    expect(
+      scheduleModel.toExternal({
+        ...schedule,
+        _amount: { num1: -10100, num2: -20000 },
+      }).expectedAmount,
+    ).toBe(-20000);
+    expect(
+      scheduleModel.toExternal({ ...schedule, _amount: 20000 }).expectedAmount,
+    ).toBe(20000);
+  });
+});
