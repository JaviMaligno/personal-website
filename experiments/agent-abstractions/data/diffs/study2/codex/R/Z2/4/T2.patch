+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,36 @@
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  const schedule = {
+    id: 'schedule-1',
+    name: 'Test schedule',
+    rule: 'rule-1',
+    next_date: '2026-01-01',
+    completed: false,
+    posts_transaction: true,
+    tombstone: false,
+    _payee: 'payee-1',
+    _account: 'account-1',
+    _amountOp: 'isbetween',
+    _date: '2026-01-01',
+    _conditions: [],
+    _actions: [],
+  };
+
+  it.each([
+    [1200, 1200],
+    [{ num1: 10100, num2: 20000 }, 20000],
+    [{ num1: -10100, num2: -20000 }, -20000],
+    [{ num1: -20000, num2: 10100 }, -20000],
+  ])('exposes expectedAmount for amount %j', (amount, expectedAmount) => {
+    expect(
+      scheduleModel.toExternal({ ...schedule, _amount: amount }),
+    ).toMatchObject({ amount, expectedAmount });
+  });
+
+  it('uses zero when the schedule has no amount', () => {
+    expect(
+      scheduleModel.toExternal({ ...schedule, _amount: null }),
+    ).toMatchObject({ amount: null, expectedAmount: 0 });
+  });
+});
