+/** Return the ranged schedule amount with the greatest magnitude. */
+export function getWorstCaseScheduleAmount(num1: number, num2: number) {
+  const abs1 = Math.abs(num1);
+  const abs2 = Math.abs(num2);
+  return abs1 === abs2 ? Math.max(num1, num2) : abs1 > abs2 ? num1 : num2;
