+import { describe, expect, it } from 'vitest';
+
+import { normalizeSchedule } from './forecast-schedules';
+
+describe('normalizeSchedule', () => {
+  it.each([
+    [-10100, -20000, -20000],
+    [-20000, -10100, -20000],
+    [10100, 20000, 20000],
+    [20000, 10100, 20000],
+  ])('uses the worst-case ranged amount %i to %i', (num1, num2, expected) => {
+    const schedule = normalizeSchedule({
+      id: 'schedule',
+      name: 'Variable bill',
+      next_date: '2024-01-01',
+      _amount: { num1, num2 },
+      _date: '2024-01-01',
+    });
+
+    expect(schedule?._amount).toBe(expected);
+  });
+
+  it('keeps a single amount unchanged', () => {
+    const schedule = normalizeSchedule({
+      id: 'schedule',
+      name: 'Fixed bill',
+      next_date: '2024-01-01',
+      _amount: -12345,
+      _date: '2024-01-01',
+    });
+
+    expect(schedule?._amount).toBe(-12345);
+  });
+});
