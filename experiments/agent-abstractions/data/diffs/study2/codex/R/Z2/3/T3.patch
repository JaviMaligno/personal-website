+/** Return the approximate schedule amount at the end furthest from zero. */
+export function getWorstCaseApproximateScheduleAmount(amount: number) {
+  const tolerance = Math.round(Math.abs(amount) * 0.075);
+  return amount < 0 ? amount - tolerance : amount + tolerance;
+}
