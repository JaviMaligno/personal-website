+      _amountOp: 'isbetween',
+      _date: '2024-01-01',
+      _conditions: [],
+      _actions: [],
+    });
+
+  it('uses the endpoint furthest from zero for ranged amounts', () => {
+    expect(schedule({ num1: -10100, num2: -20000 }).expectedAmount).toBe(
+      -20000,
+    );
+    expect(schedule({ num1: 10100, num2: 20000 }).expectedAmount).toBe(
+      20000,
+    );
+  });
+
+  it('uses the single amount or zero when no amount is set', () => {
+    expect(schedule(12345).expectedAmount).toBe(12345);
+    expect(schedule(0).expectedAmount).toBe(0);
+  });
