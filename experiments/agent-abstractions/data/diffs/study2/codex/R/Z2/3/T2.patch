+describe('scheduleModel', () => {
+  const schedule = (amount: ScheduleEntity['_amount']) =>
+    scheduleModel.toExternal({
+      id: 'schedule1',
+      name: 'Schedule',
+      rule: 'rule1',
+      next_date: '2024-01-01',
+      completed: false,
+      posts_transaction: false,
+      tombstone: false,
+      _payee: 'payee1',
+      _account: 'account1',
