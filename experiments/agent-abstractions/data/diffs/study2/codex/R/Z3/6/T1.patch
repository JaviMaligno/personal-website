 beforeEach(async () => {
   await global.emptyDatabase()();
@@ -87,3 +87,77 @@ describe('findOrCreateBank', () => {
     expect(await getBanks()).toHaveLength(1);
   });
 });
+
+describe('assertAccountNotLinked', () => {
+  async function addLinkedAccount({
+    id,
+    provider = 'simpleFin',
+    accountId = 'provider-account',
+    tombstone = 0,
+    closed = 0,
+  }: {
+    id: string;
+    provider?: string;
+    accountId?: string;
+    tombstone?: number;
+    closed?: number;
+  }) {
+    await db.insertWithUUID('accounts', {
+      id,
+      name: id,
+      account_id: accountId,
+      account_sync_source: provider,
+      tombstone,
+      closed,
+    });
+  }
+
+  it('rejects linking the same provider account to a different local account', async () => {
+    await addLinkedAccount({ id: 'existing' });
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'provider-account', undefined),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows relinking into the account that already holds the link', async () => {
+    await addLinkedAccount({ id: 'existing' });
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'provider-account', 'existing'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('counts closed accounts but ignores deleted accounts', async () => {
+    await addLinkedAccount({ id: 'closed', closed: 1 });
+    await expect(
+      assertAccountNotLinked('simpleFin', 'provider-account', undefined),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    await global.emptyDatabase()();
+    await loadMappings();
+    await addLinkedAccount({ id: 'deleted', tombstone: 1 });
+    await expect(
+      assertAccountNotLinked('simpleFin', 'provider-account', undefined),
+    ).resolves.toBeUndefined();
+  });
+
+  it('matches both provider and provider account id', async () => {
+    await addLinkedAccount({ id: 'other-provider', provider: 'akahu' });
+    await expect(
+      assertAccountNotLinked('simpleFin', 'provider-account', undefined),
+    ).resolves.toBeUndefined();
+
+    await addLinkedAccount({
+      id: 'other-account',
+      accountId: 'different-provider-account',
+    });
+    await expect(
+      assertAccountNotLinked('simpleFin', 'provider-account', undefined),
+    ).resolves.toBeUndefined();
+  });
+});
diff --git a/packages/loot-core/src/server/accounts/link.ts b/packages/loot-core/src/server/accounts/link.ts
index 19f9163..81bc8aa 100644
--- a/packages/loot-core/src/server/accounts/link.ts
+++ b/packages/loot-core/src/server/accounts/link.ts
@@ -50,3 +50,19 @@ export async function findOrCreateBank(
 
   return bankData;
 }
+
+export async function assertAccountNotLinked(
+  provider: string,
+  providerAccountId: string,
+  upgradingId: string | undefined,
+) {
+  const existing = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?`,
+    [provider, providerAccountId],
+  );
+
+  if (existing && existing.id !== upgradingId) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
