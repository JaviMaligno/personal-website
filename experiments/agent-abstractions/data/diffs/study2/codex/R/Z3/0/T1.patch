+async function assertBankAccountNotLinked(
+  provider: AccountEntity['account_sync_source'],
+  bankAccountId: string,
+  upgradingId?: AccountEntity['id'],
+) {
+  const existing = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, bankAccountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (existing) {
+    throw APIError('This bank account is already linked to another account.');
+  }
+}
