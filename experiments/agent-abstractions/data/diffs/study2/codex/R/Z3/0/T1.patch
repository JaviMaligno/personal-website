+import { app } from '#server/accounts/app';
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+beforeEach(async () => {
+  await global.emptyDatabase()();
+  await loadMappings();
+}, 60_000);
+
+const goCardlessAccount = {
+  balance: 0,
+  institution: 'Test Bank',
+  account_id: 'bank-account-1',
+  mask: '1234',
+  name: 'Checking',
+  official_name: 'Checking Account',
+};
+
+describe('bank account linking', () => {
+  it('rejects a second link without creating an account or payee', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing',
+      account_id: goCardlessAccount.account_id,
+      account_sync_source: 'goCardless',
+      closed: 1,
+    });
+
+    await expect(
+      app.handlers['gocardless-accounts-link']({
+        requisitionId: 'requisition',
+        account: goCardlessAccount,
+      }),
+    ).rejects.toMatchObject({
+      message: 'This bank account is already linked to another account.',
+    });
+
+    expect(await db.getAccounts()).toHaveLength(1);
+    expect(
+      await db.first('SELECT id FROM payees WHERE transfer_acct IS NOT NULL'),
+    ).toBeNull();
+  });
+
+});
