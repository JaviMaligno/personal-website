+describe('linking a SimpleFin account', () => {
+  it('rejects a closed account before changing it or syncing', async () => {
+    await db.insertAccount({
+      id: 'closed-account',
+      name: 'Closed account',
+      closed: 1,
+      account_id: 'existing-external-id',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        upgradingId: 'closed-account',
+        externalAccount: {
+          balance: 0,
+          account_id: 'existing-external-id',
+          name: 'Bank account',
+          orgId: 'org',
+        },
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(
+      await db.first(
+        'SELECT id, name, closed, account_id, account_sync_source, bank FROM accounts WHERE id = ?',
+        ['closed-account'],
+      ),
+    ).toEqual({
+      id: 'closed-account',
+      name: 'Closed account',
+      closed: 1,
+      account_id: 'existing-external-id',
+      account_sync_source: 'simpleFin',
+      bank: null,
+    });
+    expect(await db.all('SELECT * FROM banks')).toEqual([]);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
