+/** Frees an existing local account for a replacement link without contacting its provider. */
+export async function replaceExistingLink(
+  provider: string,
+  accountId: string,
+  upgradingId?: string,
+): Promise<void> {
+  const existingAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, accountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (existingAccount) {
+    await db.updateAccount({
+      id: existingAccount.id,
+      account_id: null,
+      bank: null,
+      balance_current: null,
+      balance_available: null,
+      balance_limit: null,
+      account_sync_source: null,
+      bank_sync_status: null,
+    });
+  }
+}
