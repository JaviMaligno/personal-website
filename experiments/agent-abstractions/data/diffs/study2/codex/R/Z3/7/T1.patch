+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+describe('bank account linking', () => {
+  it('refuses an account already linked by the same provider without changing data', async () => {
+    db.runQuery(
+      'INSERT INTO banks (id, bank_id, name, tombstone) VALUES (?, ?, ?, 0)',
+      ['bank1', 'org', 'Bank'],
+    );
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing',
+      bank: 'bank1',
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount: {
+          account_id: 'external-1',
+          name: 'Imported',
+          balance: 100,
+          orgId: 'org',
+        },
+      }),
+    ).rejects.toEqual({
+      type: 'APIError',
+      message: 'This bank account is already linked to another account.',
+      meta: undefined,
+    });
+
+    expect(await db.all('SELECT * FROM accounts')).toHaveLength(1);
+    expect(await db.all('SELECT * FROM payees')).toHaveLength(0);
+    expect(await db.all('SELECT * FROM banks')).toHaveLength(1);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows the same provider account id under a different provider', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing',
+      account_id: 'external-1',
+      account_sync_source: 'akahu',
+    });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount: {
+          account_id: 'external-1',
+          name: 'Imported',
+          balance: 100,
+          orgId: 'org',
+        },
+      }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows re-linking the account that already holds the bank link', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing',
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+    });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount: {
+          account_id: 'external-1',
+          name: 'Existing',
+          balance: 100,
+          orgId: 'org',
+        },
+        upgradingId: 'existing',
+      }),
+    ).resolves.toBe('ok');
+  });
+});
