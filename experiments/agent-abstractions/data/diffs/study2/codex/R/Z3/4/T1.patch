diff --git a/packages/loot-core/src/server/accounts/link.ts b/packages/loot-core/src/server/accounts/link.ts
index 19f9163..6b03fa9 100644
--- a/packages/loot-core/src/server/accounts/link.ts
+++ b/packages/loot-core/src/server/accounts/link.ts
@@ -2,6 +2,28 @@
 import { v4 as uuidv4 } from 'uuid';
 
 import * as db from '#server/db';
+import { APIError } from '#server/errors';
+
+const DUPLICATE_ACCOUNT_ERROR =
+  'This bank account is already linked to another account.';
+
+/** Reject a bank account that is already attached to a different live account. */
+export async function ensureAccountIsNotLinked(
+  provider: string,
+  accountId: db.DbAccount['account_id'],
+  upgradingId?: db.DbAccount['id'],
+) {
+  const existingAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0
+       AND id != ?`,
+    [provider, accountId, upgradingId ?? ''],
+  );
+
+  if (existingAccount) {
+    throw APIError(DUPLICATE_ACCOUNT_ERROR);
+  }
+}
 
 type Institution = string | { name?: string | null };
 
