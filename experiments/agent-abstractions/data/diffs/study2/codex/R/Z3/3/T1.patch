+async function assertBankAccountIsNotLinked(
+  provider: NonNullable<AccountEntity['account_sync_source']>,
+  accountId: string,
+  upgradingId?: AccountEntity['id'],
+) {
+  const existingAccount = await db.first<{ id: string }>(
+    `SELECT a.id FROM accounts a
+     WHERE a.tombstone = 0 AND a.account_sync_source = ? AND a.account_id = ?
+       AND (? IS NULL OR a.id != ?)
+     LIMIT 1`,
+    [provider, accountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (existingAccount) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
