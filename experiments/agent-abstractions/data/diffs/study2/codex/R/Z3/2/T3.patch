diff --git a/packages/loot-core/src/server/accounts/link.ts b/packages/loot-core/src/server/accounts/link.ts
index ed72501..467073d 100644
--- a/packages/loot-core/src/server/accounts/link.ts
+++ b/packages/loot-core/src/server/accounts/link.ts
@@ -69,3 +69,17 @@ export async function ensureAccountIsNotLinked(
     throw new Error('This bank account is already linked to another account.');
   }
 }
+
+/** Refuses to link a bank account into a closed local account. */
+export async function ensureAccountIsOpen(accountId: string): Promise<void> {
+  const account = await db.first<{ closed: number }>(
+    'SELECT closed FROM accounts WHERE id = ?',
+    [accountId],
+  );
+
+  if (account?.closed) {
+    throw new Error(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+  }
+}
