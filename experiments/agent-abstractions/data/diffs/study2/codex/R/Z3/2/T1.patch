+
+describe('ensureAccountIsNotLinked', () => {
+  async function insertLinkedAccount({
+    id,
+    provider = 'simpleFin',
+    accountId = 'external-1',
+    tombstone = 0,
+    closed = 0,
+  }: {
+    id: string;
+    provider?: string;
+    accountId?: string;
+    tombstone?: number;
+    closed?: number;
+  }) {
+    await db.insertAccount({
+      id,
+      name: id,
+      account_sync_source: provider,
+      account_id: accountId,
+      tombstone,
+      closed,
+    });
+  }
+
+  it('rejects an account held by another non-deleted local account', async () => {
+    await insertLinkedAccount({ id: 'existing' });
+
+    await expect(
+      ensureAccountIsNotLinked('simpleFin', 'external-1'),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows relinking into the account that already holds it', async () => {
+    await insertLinkedAccount({ id: 'existing', closed: 1 });
+
+    await expect(
+      ensureAccountIsNotLinked('simpleFin', 'external-1', 'existing'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted accounts and identifiers held by another provider', async () => {
+    await insertLinkedAccount({ id: 'deleted', tombstone: 1 });
+    await insertLinkedAccount({ id: 'other-provider', provider: 'akahu' });
+
+    await expect(
+      ensureAccountIsNotLinked('simpleFin', 'external-1'),
+    ).resolves.toBeUndefined();
+  });
+});
diff --git a/packages/loot-core/src/server/accounts/link.ts b/packages/loot-core/src/server/accounts/link.ts
