+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // Weekend adjustment can move a Sunday occurrence two days earlier or a
+    // Saturday occurrence two days later. Include those source dates around
+    // the requested final-date range.
+    const rangeStart = d.subDays(new Date(`${start}T00:00:00`), 3);
+    const rangeEnd = d.addDays(new Date(`${end}T00:00:00`), 2);
+    const isDaily = config.frequency === 'daily';
+
+    return schedule
+      .occurrences({ start: rangeStart, end: rangeEnd })
+      .toArray()
+      .flatMap(({ date }) => {
+        if (config.skipWeekend && isDaily && d.isWeekend(date)) {
+          return [];
+        }
+        const finalDate = config.skipWeekend
+          ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+          : date;
+        const day = dayFromDate(finalDate);
+        return day >= start && day <= end ? [day] : [];
+      })
+      .filter((day, index, days) => days.indexOf(day) === index)
+      .sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
