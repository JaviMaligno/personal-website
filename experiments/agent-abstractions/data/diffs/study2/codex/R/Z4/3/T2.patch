+async function getDatesInRange({ config, start, end }) {
+  if (start > end) {
+    return [];
+  }
+
+  const rules = recurConfigToRSchedule(config);
+  const isDaily = config.frequency === 'daily';
+  // Weekend adjustments can move an occurrence by at most two days (Sunday
+  // moved to Friday), so include nearby original occurrences and then apply
+  // the requested range to the adjusted day below.
+  const rangeStart = d.subDays(new Date(`${start}T00:00:00`), 2);
+  const rangeEnd = d.addDays(new Date(`${end}T00:00:00`), 2);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const occurrences = schedule
+      .occurrences({ start: rangeStart, end: rangeEnd })
+      .toArray();
+    const dates = new Set<string>();
+
+    for (const { date } of occurrences) {
+      if (config.skipWeekend && isDaily && d.isWeekend(date)) {
+        continue;
+      }
+
+      const finalDate =
+        config.skipWeekend && !isDaily
+          ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+          : date;
+      const day = dayFromDate(finalDate);
+      if (day >= start && day <= end) {
+        dates.add(day);
+      }
+    }
+
+    return [...dates].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
