+        if (value.schedule.data.frequency === 'daily') {
+          // Daily schedules skip weekend occurrences instead of moving them.
+          // Advance from the actual occurrence so a weekend start can never
+          // resolve to a date before the schedule starts.
+          while (d.isWeekend(date)) {
+            const nextStart = d.addDays(date, 1);
+            const nextDates = value.schedule
+              .occurrences({ start: nextStart, take: 1 })
+              .toArray();
+            if (nextDates.length === 0) {
+              return null;
+            }
+            date = nextDates[0].date;
+          }
+        } else {
+          date = getDateWithSkippedWeekend(
+            date,
+            value.schedule.data.weekendSolve,
+          );
+        }
       }
