+export function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const startDate = d.parseISO(start);
+  const endDate = d.parseISO(end);
+  const padding = 3;
+  const isDaily = config.frequency.toUpperCase() === 'DAILY';
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const dates = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(startDate, padding)),
+        end: d.endOfDay(d.addDays(endDate, padding)),
+      })
+      .toArray()
+      .map(({ date }) => {
+        if (!config.skipWeekend) {
+          return date;
+        }
+        if (isDaily && d.isWeekend(date)) {
+          return null;
+        }
+        return getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      })
+      .filter(Boolean)
+      .map(dayFromDate)
+      .filter(date => date >= start && date <= end);
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
