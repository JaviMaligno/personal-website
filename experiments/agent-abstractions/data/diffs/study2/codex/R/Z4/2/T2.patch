+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const rangeStart = d.subDays(parseDate(start), 3);
+  const rangeEnd = d.addDays(parseDate(end), 3);
+  const rangeLength = d.differenceInCalendarDays(rangeEnd, rangeStart) + 1;
+  const isDaily = config.frequency?.toLowerCase() === 'daily';
+
+  return [
+    ...new Set(
+      schedule
+        .occurrences({ start: rangeStart, take: rangeLength })
+        .toArray()
+        .map(({ date }) => {
+          if (config.skipWeekend && isDaily && d.isWeekend(date)) {
+            return null;
+          }
+          if (!config.skipWeekend) {
+            return date;
+          }
+          return getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        })
+        .filter(date => date !== null)
+        .map(dayFromDate)
+        .filter(date => date >= start && date <= end),
+    ),
+  ].sort();
+}
