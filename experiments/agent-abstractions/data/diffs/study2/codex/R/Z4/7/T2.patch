+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const isDailySchedule = config.frequency === 'daily';
+  // Weekend adjustment can move an occurrence by at most two days. Generate
+  // those neighboring raw dates too, then apply the period bounds to the final
+  // adjusted day.
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), 2)),
+      end: d.startOfDay(d.addDays(parseDate(end), 3)),
+    })
+    .toArray();
+
+  return [
+    ...new Set(
+      occurrences.flatMap(({ date }) => {
+        if (config.skipWeekend && isDailySchedule && d.isWeekend(date)) {
+          return [];
+        }
+        const finalDate =
+          config.skipWeekend && !isDailySchedule
+            ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+            : date;
+        const day = dayFromDate(finalDate);
+        return day >= start && day <= end ? [day] : [];
+      }),
+    ),
+  ].sort();
+}
