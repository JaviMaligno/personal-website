+export async function getDatesInRange({ config, start, end }) {
+  if (start > end) {
+    return [];
+  }
+
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  // Weekend adjustments can move an occurrence by at most two days. Query
+  // outside the requested period so adjusted occurrences crossing either
+  // boundary are still considered.
+  const occurrenceStart = d.subDays(d.parseISO(start), 2);
+  const occurrenceEnd = d.addDays(d.parseISO(end), 2);
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(occurrenceStart),
+      end: d.endOfDay(occurrenceEnd),
+    })
+    .toArray();
+
+  const dates = new Set<string>();
+  for (const occurrence of occurrences) {
+    const rawDate = occurrence.date;
+    // Daily schedules skip weekend occurrences instead of moving them.
+    if (config.skipWeekend && config.frequency === 'daily' && d.isWeekend(rawDate)) {
+      continue;
+    }
+    const date = config.skipWeekend
+      ? getDateWithSkippedWeekend(rawDate, config.weekendSolveMode)
+      : rawDate;
+    const day = dayFromDate(date);
+    if (day >= start && day <= end) {
+      dates.add(day);
+    }
+  }
+  return [...dates].sort();
+}
