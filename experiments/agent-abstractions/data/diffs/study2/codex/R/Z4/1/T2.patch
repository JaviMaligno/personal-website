+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const startDate = d.startOfDay(new Date(`${start}T00:00:00`));
+  const endDate = d.startOfDay(new Date(`${end}T00:00:00`));
+  // A weekend occurrence can move by at most three days (Sunday to Friday).
+  const occurrences = new RSchedule({ rrules: rules })
+    .occurrences({ start: d.subDays(startDate, 3), end: d.addDays(endDate, 3) })
+    .toArray();
+
+  return [
+    ...new Set(
+      occurrences
+        .map(({ date }) => {
+          if (config.frequency === 'daily') {
+            return config.skipWeekend && d.isWeekend(date) ? null : date;
+          }
+          return config.skipWeekend
+            ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+            : date;
+        })
+        .filter(date => date != null)
+        .map(dayFromDate)
+        .filter(date => date >= start && date <= end),
+    ),
+  ].sort();
+}
