+describe('month-wide last month spending action', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('budgets previous month spending and received income, preserving ineligible categories', async () => {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+    await db.insertCategoryGroup({ id: 'income-group', name: 'Income', is_income: 1 });
+    await db.insertCategory({ id: 'income-cat', name: 'Income', cat_group: 'income-group', is_income: 1 });
+    await db.insertCategoryGroup({ id: 'visible', name: 'Visible', is_income: 0 });
+    await db.insertCategoryGroup({ id: 'hidden', name: 'Hidden', is_income: 0, hidden: 1 });
+    await db.insertCategory({ id: 'spent', name: 'Spent', cat_group: 'visible', is_income: 0 });
+    await db.insertCategory({ id: 'nothing', name: 'Nothing', cat_group: 'visible', is_income: 0 });
+    await db.insertCategory({ id: 'hidden-cat', name: 'Hidden', cat_group: 'hidden', is_income: 0 });
+    await db.insertCategory({ id: 'templated', name: 'Templated', cat_group: 'visible', is_income: 0, goal_def: '[]' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+    await db.insertTransaction({ date: '2024-01-10', amount: -3000, account: 'account1', category: 'spent' });
+    await db.insertTransaction({ date: '2024-01-11', amount: 5500, account: 'account1', category: 'income-cat' });
+    await setBudget({ category: 'hidden-cat', month: '2024-02', amount: 125 });
+    await setBudget({ category: 'templated', month: '2024-02', amount: 125 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-spent')).toBe(3000);
+    expect(await getSheetValue('budget202402', 'budget-nothing')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(125);
+    expect(await getSheetValue('budget202402', 'budget-templated')).toBe(125);
+    expect(await getSheetValue('budget202402', 'budget-income-cat')).toBe(5500);
+  });
+});
