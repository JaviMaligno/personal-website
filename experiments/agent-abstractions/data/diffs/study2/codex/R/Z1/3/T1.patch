+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves hidden and template-managed categories unchanged when setting zero', async () => {
+    await db.insertCategoryGroup({ id: 'income', name: 'Income', is_income: 1 });
+    await db.insertCategoryGroup({ id: 'visible', name: 'Visible', is_income: 0 });
+    await db.insertCategoryGroup({ id: 'hidden-group', name: 'Hidden', is_income: 0, hidden: 1 });
+    await db.insertCategory({ id: 'regular', name: 'Regular', cat_group: 'visible' });
+    await db.insertCategory({ id: 'hidden-cat', name: 'Hidden', cat_group: 'visible', hidden: 1 });
+    await db.insertCategory({ id: 'group-hidden-cat', name: 'Group hidden', cat_group: 'hidden-group' });
+    await db.insertCategory({ id: 'templated', name: 'Templated', cat_group: 'visible', goal_def: '[]' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+
+    for (const category of ['regular', 'hidden-cat', 'group-hidden-cat', 'templated']) {
+      await setBudget({ category, month: '2024-01', amount: 100 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-regular')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-hidden-cat')).toBe(100);
+    expect(await getSheetValue('budget202401', 'budget-group-hidden-cat')).toBe(100);
+    expect(await getSheetValue('budget202401', 'budget-templated')).toBe(100);
+  });
+});
