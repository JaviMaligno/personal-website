+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getBulkBudgetCategories();
+  const previousMonth = monthUtils.prevMonth(month);
+  const startDate = Number(previousMonth.replace('-', '') + '01');
+  const endDate = Number(
+    monthUtils.subDays(`${month}-01`, 1).replaceAll('-', ''),
+  );
+  const spending = await db.all<{ category: string; amount: number }>(
+    `SELECT t.category, SUM(t.amount) AS amount
+       FROM v_transactions_internal_alive t
+       LEFT JOIN accounts a ON a.id = t.account
+      WHERE t.date >= ? AND t.date <= ?
+        AND t.category IS NOT NULL AND a.offbudget = 0
+      GROUP BY t.category`,
+    [startDate, endDate],
+  );
+  const amounts = new Map(spending.map(row => [row.category, row.amount || 0]));
+
+  await batchMessages(async () => {
+    for (const category of categories) {
+      if (category.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+      const activity = amounts.get(category.id) || 0;
+      const amount = category.is_income === 1 ? activity : -activity;
+      void setBudget({ category: category.id, month, amount });
+    }
+  });
+}
