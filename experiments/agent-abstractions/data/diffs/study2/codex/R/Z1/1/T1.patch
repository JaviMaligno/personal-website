+describe('month-wide zero action', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves hidden and template-managed categories unchanged', async () => {
+    await db.insertCategoryGroup({ id: 'income-group', name: 'Income', is_income: 1 });
+    await db.insertCategory({ id: 'income-cat', name: 'Income', cat_group: 'income-group', is_income: 1 });
+    await db.insertCategoryGroup({ id: 'visible', name: 'Visible', is_income: 0 });
+    await db.insertCategoryGroup({ id: 'hidden', name: 'Hidden', is_income: 0, hidden: 1 });
+    await db.insertCategory({ id: 'normal', name: 'Normal', cat_group: 'visible', is_income: 0 });
+    await db.insertCategory({ id: 'hidden-cat', name: 'Hidden category', cat_group: 'visible', is_income: 0, hidden: 1 });
+    await db.insertCategory({ id: 'hidden-group-cat', name: 'Hidden group category', cat_group: 'hidden', is_income: 0 });
+    await db.insertCategory({ id: 'templated', name: 'Templated', cat_group: 'visible', is_income: 0, goal_def: '[]' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+    for (const category of ['normal', 'hidden-cat', 'hidden-group-cat', 'templated']) {
+      await setBudget({ category, month: '2024-01', amount: 125 });
+    }
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-normal')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-hidden-cat')).toBe(125);
+    expect(await getSheetValue('budget202401', 'budget-hidden-group-cat')).toBe(125);
+    expect(await getSheetValue('budget202401', 'budget-templated')).toBe(125);
+  });
+});
