+describe('setZero with hidden categories', () => {
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    await setupAverageDatabase();
+  });
+  afterEach(global.emptyDatabase());
+
+  it('includes hidden categories and groups when requested, preserving other exclusions', async () => {
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'hidden-group-cat',
+      name: 'Hidden group category',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'Hidden category',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'template-cat',
+      name: 'Template category',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: JSON.stringify([{ directive: 'template', amount: 100 }]),
+    });
+    await db.insertCategoryGroup({
+      id: 'fixed-group',
+      name: 'Fixed group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'fixed-cat',
+      name: 'Fixed category',
+      cat_group: 'fixed-group',
+      is_income: 0,
+    });
+    await db.insert('notes', { id: 'fixed-group', note: '#fixed' });
+    await sheet.loadSpreadsheet(db);
+    await setBudget({ category: 'hidden-cat', month: '2024-04', amount: 111 });
+    await setBudget({ category: 'hidden-group-cat', month: '2024-04', amount: 222 });
+    await setBudget({ category: 'template-cat', month: '2024-04', amount: 333 });
+    await setBudget({ category: 'fixed-cat', month: '2024-04', amount: 444 });
+
+    await setZero({ month: '2024-04', includeHiddenCategories: true });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-hidden-group-cat')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-template-cat')).toBe(333);
+    expect(await getSheetValue('budget202404', 'budget-fixed-cat')).toBe(444);
+  });
+});
