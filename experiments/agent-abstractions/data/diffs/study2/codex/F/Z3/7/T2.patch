+async function downloadFintegraTransactions(acctId: string, since: string) {
+  const userToken = await asyncStorage.getItem('user-token');
+  if (!userToken) return;
+
+  logger.log('Pulling transactions from Fintegra');
+  const res = await post(
+    getServer().FINTEGRA_SERVER + '/transactions',
+    { accountId: acctId, startDate: since },
+    { 'X-ACTUAL-TOKEN': userToken },
+    60000,
+  );
+
+  if (res.error_code) {
+    throw BankSyncError(res.error_type, res.error_code);
+  }
+
+  return {
+    transactions: res.transactions.all,
+    accountBalance: res.balances,
+    startingBalance: res.startingBalance,
+  };
+}
