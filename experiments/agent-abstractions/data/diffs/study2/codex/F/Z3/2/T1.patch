diff --git a/packages/loot-core/src/server/accounts/link.ts b/packages/loot-core/src/server/accounts/link.ts
index 19f9163..c31b8cd 100644
--- a/packages/loot-core/src/server/accounts/link.ts
+++ b/packages/loot-core/src/server/accounts/link.ts
@@ -2,6 +2,29 @@
 import { v4 as uuidv4 } from 'uuid';
 
 import * as db from '#server/db';
+import type { AccountSyncSource } from '#types/models';
+
+const BANK_ACCOUNT_ALREADY_LINKED_ERROR =
+  'This bank account is already linked to another account.';
+
+/** Rejects a provider account already held by another live local account. */
+export async function ensureBankAccountIsNotLinked(
+  accountId: string,
+  syncSource: AccountSyncSource,
+  upgradingId?: string,
+) {
+  const existingAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE account_id = ? AND account_sync_source = ? AND tombstone = 0
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [accountId, syncSource, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (existingAccount) {
+    throw new Error(BANK_ACCOUNT_ALREADY_LINKED_ERROR);
+  }
+}
 
 type Institution = string | { name?: string | null };
 
