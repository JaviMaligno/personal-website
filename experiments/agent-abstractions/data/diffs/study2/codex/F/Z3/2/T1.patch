+describe('ensureBankAccountIsNotLinked', () => {
+  it('rejects a second link from the same provider without creating anything', async () => {
+    await db.insertAccount({
+      id: 'linked',
+      name: 'Checking',
+      account_id: 'provider-account',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      ensureBankAccountIsNotLinked('provider-account', 'simpleFin'),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(await db.all('SELECT * FROM accounts')).toHaveLength(1);
+    expect(await db.all('SELECT * FROM payees')).toHaveLength(0);
+    expect(await getBanks()).toHaveLength(0);
+  });
+
+  it('allows relinking into the account that already holds it', async () => {
+    await db.insertAccount({
+      id: 'linked',
+      name: 'Checking',
+      account_id: 'provider-account',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      ensureBankAccountIsNotLinked('provider-account', 'simpleFin', 'linked'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted accounts, closed status, and other providers', async () => {
+    await db.insertAccount({
+      id: 'deleted',
+      name: 'Deleted',
+      account_id: 'provider-account',
+      account_sync_source: 'simpleFin',
+      tombstone: 1,
+    });
+    await db.insertAccount({
+      id: 'other-provider',
+      name: 'Other provider',
+      account_id: 'provider-account',
+      account_sync_source: 'goCardless',
+      closed: 1,
+    });
+
+    await expect(
+      ensureBankAccountIsNotLinked('provider-account', 'simpleFin'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('counts closed accounts as holding their link', async () => {
+    await db.insertAccount({
+      id: 'closed',
+      name: 'Closed',
+      account_id: 'provider-account',
+      account_sync_source: 'simpleFin',
