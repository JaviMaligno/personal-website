+// @ts-strict-ignore
+import * as asyncStorage from '#platform/server/asyncStorage';
+import * as connection from '#platform/server/connection';
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn().mockResolvedValue({ added: 0, updated: 0 }),
+}));
+
+const linkAccount = app.handlers['simplefin-accounts-link'];
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(bankSync.syncAccount).mockResolvedValue({
+    added: [],
+    updated: [],
+    updatedPreview: [],
+  });
+  vi.mocked(asyncStorage.multiGet).mockResolvedValue({
+    'user-id': 'user-1',
+    'user-key': 'key-1',
+  });
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+function account(accountId: string) {
+  return {
+    externalAccount: {
+      account_id: accountId,
+      balance: 0,
+      name: 'Checking',
+      institution: 'Bank',
+      orgDomain: 'bank.example',
+    },
+  };
+}
+
+async function insertLinkedAccount(
+  id: string,
+  accountId: string,
+  tombstone = 0,
+  syncSource = 'simpleFin',
+) {
+  await db.insertAccount({
+    id,
+    name: 'Checking',
+    account_id: accountId,
+    account_sync_source: syncSource,
+    tombstone,
+  });
+}
+
+describe('bank account linking', () => {
+  it('refuses an account already linked elsewhere without changing anything', async () => {
+    await insertLinkedAccount('existing', 'external-1');
+    const beforeAccounts = await db.runQuery('SELECT * FROM accounts', [], true);
+    const beforePayees = await db.runQuery('SELECT * FROM payees', [], true);
+    const beforeBanks = await db.runQuery('SELECT * FROM banks', [], true);
+    const send = vi.spyOn(connection, 'send');
+    send.mockClear();
+
+    await expect(linkAccount(account('external-1'))).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(send).not.toHaveBeenCalledWith('sync-event', expect.anything());
+    expect(await db.runQuery('SELECT * FROM accounts', [], true)).toEqual(
+      beforeAccounts,
+    );
+    expect(await db.runQuery('SELECT * FROM payees', [], true)).toEqual(
+      beforePayees,
+    );
+    expect(await db.runQuery('SELECT * FROM banks', [], true)).toEqual(
+      beforeBanks,
+    );
+  });
+
+  it('allows re-linking the local account that already holds the link', async () => {
+    await insertLinkedAccount('existing', 'external-1');
+
+    await expect(
+      linkAccount({ ...account('external-1'), upgradingId: 'existing' }),
+    ).resolves.toBe('ok');
+
+    expect(bankSync.syncAccount).toHaveBeenCalledOnce();
+  });
+
+  it('does not treat deleted accounts or another provider as an existing link', async () => {
+    await insertLinkedAccount('deleted', 'external-1', 1);
+    await insertLinkedAccount('other-provider', 'external-1', 0, 'goCardless');
+
+    await expect(linkAccount(account('external-1'))).resolves.toBe('ok');
+  });
+});
