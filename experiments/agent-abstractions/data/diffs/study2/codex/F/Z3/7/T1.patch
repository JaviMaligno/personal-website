+async function ensureBankAccountIsNotLinked(
+  syncSource: AccountSyncSource,
+  accountId: string,
+  upgradingId?: string,
+) {
+  const existing = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0
+       AND account_sync_source = ?
+       AND account_id = ?`,
+    [syncSource, accountId],
+  );
+
+  if (existing && existing.id !== upgradingId) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
