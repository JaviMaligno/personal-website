@@ -6,6 +6,24 @@ import type { AccountSyncSource } from '#types/models';
 
 const BANK_ACCOUNT_ALREADY_LINKED_ERROR =
   'This bank account is already linked to another account.';
+const CLOSED_ACCOUNT_CANNOT_BE_LINKED_ERROR =
+  'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+/** Rejects linking into a closed local account before creating bank records. */
+export async function ensureAccountIsOpen(accountId?: string) {
+  if (!accountId) {
+    return;
+  }
+
+  const account = await db.first<{ closed: number }>(
+    'SELECT closed FROM accounts WHERE id = ?',
+    [accountId],
+  );
+
+  if (account?.closed) {
+    throw new Error(CLOSED_ACCOUNT_CANNOT_BE_LINKED_ERROR);
+  }
+}
 
