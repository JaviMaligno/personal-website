+async function ensureBankAccountIsNotLinked(
+  syncSource: AccountSyncSource,
+  accountId: string,
+  upgradingId?: string,
+) {
+  const linkedAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [syncSource, accountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (linkedAccount) {
+    throw APIError(BANK_ACCOUNT_ALREADY_LINKED_ERROR);
+  }
+}
