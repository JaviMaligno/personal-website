+describe('budget last month spending', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('uses previous month net activity and keeps excluded budgets unchanged', async () => {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group', name: 'Income', is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income', name: 'Income', cat_group: 'income-group', is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'group1', name: 'Group', is_income: 0 });
+    await db.insertCategory({
+      id: 'spent', name: 'Spent', cat_group: 'group1', is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'none', name: 'None', cat_group: 'group1', is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden', name: 'Hidden', cat_group: 'group1', is_income: 0, hidden: 1,
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2023-12', '2024-01']);
+    await db.insertTransaction({
+      date: '2023-12-15', amount: -300, account: 'account1', category: 'spent',
+    });
+    await db.insertTransaction({
+      date: '2023-12-20', amount: 50, account: 'account1', category: 'spent',
+    });
+    await setBudget({ category: 'hidden', month: '2024-01', amount: 1234 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-spent')).toBe(250);
+    expect(await getSheetValue('budget202401', 'budget-none')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-hidden')).toBe(1234);
+  });
+});
