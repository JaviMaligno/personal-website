+describe('set last month spending', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('budgets prior month expense spending and tracking income', async () => {
+    await db.insertAccount({ id: 'account', name: 'Account' });
+    await db.insertCategoryGroup({
+      id: 'expenses',
+      name: 'Expenses',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'income',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'expense',
+      name: 'Expense',
+      cat_group: 'expenses',
+    });
+    await db.insertCategory({
+      id: 'income-category',
+      name: 'Income',
+      cat_group: 'income',
+      is_income: 1,
+    });
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+    await db.insertTransaction({
+      date: '2024-01-10',
+      amount: -300,
+      account: 'account',
+      category: 'expense',
+    });
+    await db.insertTransaction({
+      date: '2024-01-12',
+      amount: 500,
+      account: 'account',
+      category: 'income-category',
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-expense')).toBe(300);
+    expect(
+      await getSheetValue('budget202402', 'budget-income-category'),
+    ).toBe(500);
+  });
+});
