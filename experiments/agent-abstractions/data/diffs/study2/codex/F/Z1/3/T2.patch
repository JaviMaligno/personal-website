+describe('set last month spending', () => {
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    await setupAverageDatabase();
+  });
+
+  afterEach(global.emptyDatabase());
+
+  it('uses the previous calendar month net activity and preserves skipped categories', async () => {
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'empty-cat',
+      name: 'Empty',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'Hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+    await db.insertTransaction({
+      date: '2024-03-10',
+      amount: -450,
+      account: 'account1',
+      category: 'cat1',
+    });
+    await db.insertTransaction({
+      date: '2024-03-20',
+      amount: 100,
+      account: 'account1',
+      category: 'cat1',
+    });
+    await db.insertTransaction({
+      date: '2024-03-15',
+      amount: 700,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await setBudget({ category: 'hidden-cat', month: '2024-04', amount: 250 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(1550);
+    expect(await getSheetValue('budget202404', 'budget-empty-cat')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(700);
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(250);
+  });
+});
