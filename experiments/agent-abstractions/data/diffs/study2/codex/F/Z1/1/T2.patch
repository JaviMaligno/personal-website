+describe('set last month spending', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('budgets net spending and income from the previous calendar month', async () => {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({ id: 'expenses', name: 'Expenses' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'expense', name: 'Expense', cat_group: 'expenses',
+    });
+    await db.insertCategory({
+      id: 'income', name: 'Income', cat_group: 'income-group', is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'no-spend', name: 'No spend', cat_group: 'expenses',
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+    await db.insertTransaction({
+      date: '2024-01-03', amount: -3000, account: 'account1', category: 'expense',
+    });
+    await db.insertTransaction({
+      date: '2024-01-20', amount: 500, account: 'account1', category: 'expense',
+    });
+    await db.insertTransaction({
+      date: '2024-01-15', amount: 8000, account: 'account1', category: 'income',
+    });
+    await setBudget({ category: 'no-spend', month: '2024-02', amount: 900 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-expense')).toBe(2500);
+    expect(await getSheetValue('budget202402', 'budget-income')).toBe(8000);
+    expect(await getSheetValue('budget202402', 'budget-no-spend')).toBe(0);
+  });
+});
