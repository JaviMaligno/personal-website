+describe('month-wide budget actions respect hidden and templated categories', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('skips hidden, hidden-group, and saved-template categories for bulk actions', async () => {
+    await db.insertCategoryGroup({
+      id: 'income',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'visible',
+      name: 'Visible',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'normal',
+      name: 'Normal',
+      cat_group: 'visible',
+    });
+    await db.insertCategory({
+      id: 'hidden',
+      name: 'Hidden category',
+      cat_group: 'visible',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'in-hidden-group',
+      name: 'In hidden group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'Templated',
+      cat_group: 'visible',
+      goal_def: '[]',
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    for (const category of [
+      'normal',
+      'hidden',
+      'in-hidden-group',
+      'templated',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 100 });
+      await setBudget({ category, month: '2024-02', amount: 50 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    for (const category of ['hidden', 'in-hidden-group', 'templated']) {
+      expect(await getSheetValue('budget202402', `budget-${category}`)).toBe(
+        50,
+      );
+    }
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    for (const category of ['hidden', 'in-hidden-group', 'templated']) {
+      expect(await getSheetValue('budget202402', `budget-${category}`)).toBe(
+        50,
+      );
+    }
+    expect(await getSheetValue('budget202402', 'budget-normal')).toBe(0);
+  });
+});
