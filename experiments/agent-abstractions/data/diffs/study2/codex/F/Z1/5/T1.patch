+describe('bulk budget category exclusions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves hidden, hidden-group, and saved-template categories unchanged', async () => {
+    await db.insertCategoryGroup({
+      id: 'income',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'visible',
+      name: 'Visible',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    for (const [id, group, hidden, goal_def] of [
+      ['visible-cat', 'visible', 0, null],
+      ['hidden-cat', 'visible', 1, null],
+      ['hidden-group-cat', 'hidden-group', 0, null],
+      ['template-cat', 'visible', 0, '[{"directive":"template"}]'],
+    ] as const) {
+      await db.insertCategory({
+        id,
+        name: id,
+        cat_group: group,
+        is_income: 0,
+        hidden,
+        goal_def,
+      });
+    }
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    for (const category of [
+      'visible-cat',
+      'hidden-cat',
+      'hidden-group-cat',
+      'template-cat',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 1234 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-visible-cat')).toBe(0);
+    for (const category of ['hidden-cat', 'hidden-group-cat', 'template-cat']) {
+      expect(await getSheetValue('budget202402', `budget-${category}`)).toBe(
+        1234,
+      );
+    }
+  });
+});
