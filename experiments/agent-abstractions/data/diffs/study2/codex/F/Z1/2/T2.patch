+describe('setLastMonthSpending', () => {
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    await setupAverageDatabase();
+  });
+
+  afterEach(global.emptyDatabase());
+
+  it('budgets previous month net spending and income, and skips untouched categories', async () => {
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'zero-cat',
+      name: 'No activity',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'Hidden',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await setBudget({ category: 'zero-cat', month: '2024-04', amount: 123 });
+    await setBudget({ category: 'hidden-cat', month: '2024-04', amount: 456 });
+    await setBudget({ category: 'cat1', month: '2024-04', amount: 999 });
+    await db.insertTransaction({
+      date: '2024-03-10',
+      amount: -800,
+      account: 'account1',
+      category: 'cat1',
+    });
+    await db.insertTransaction({
+      date: '2024-03-20',
+      amount: 200,
+      account: 'account1',
+      category: 'cat1',
+    });
+    await db.insertTransaction({
+      date: '2024-03-15',
+      amount: 5000,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(1800);
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(5000);
+    expect(await getSheetValue('budget202404', 'budget-zero-cat')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(456);
+  });
+});
