+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const previousMonth = monthUtils.prevMonth(month);
+  const categories = await getBulkBudgetCategories({
+    skipMissingGroup: false,
+  });
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const sumAmount = await getSheetValue(
+        monthUtils.sheetForMonth(previousMonth),
+        'sum-amount-' + cat.id,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudget(cat, sumAmount),
+      });
+    }
+  });
+}
