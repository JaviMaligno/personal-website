 } from './actions';
 import * as budget from './base';
 
+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves hidden, hidden-group, and template-managed categories untouched', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'visible',
+      name: 'Visible',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'ordinary',
+      name: 'Ordinary',
+      cat_group: 'visible',
+    });
+    await db.insertCategory({
+      id: 'hidden',
+      name: 'Hidden category',
+      cat_group: 'visible',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'in-hidden-group',
+      name: 'In hidden group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'Templated',
+      cat_group: 'visible',
+      goal_def: JSON.stringify([{ type: 'simple', amount: 100 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    for (const category of [
+      'ordinary',
+      'hidden',
+      'in-hidden-group',
+      'templated',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 700 });
+      await setBudget({ category, month: '2024-02', amount: 900 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202402', 'budget-hidden')).toBe(900);
+    expect(await getSheetValue('budget202402', 'budget-in-hidden-group')).toBe(
+      900,
+    );
+    expect(await getSheetValue('budget202402', 'budget-templated')).toBe(900);
+    expect(await getSheetValue('budget202402', 'budget-ordinary')).toBe(700);
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202402', 'budget-hidden')).toBe(900);
+    expect(await getSheetValue('budget202402', 'budget-in-hidden-group')).toBe(
+      900,
+    );
+    expect(await getSheetValue('budget202402', 'budget-templated')).toBe(900);
+    expect(await getSheetValue('budget202402', 'budget-ordinary')).toBe(0);
+  });
+});
