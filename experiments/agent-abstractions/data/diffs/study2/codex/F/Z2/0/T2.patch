@@ -0,0 +1,46 @@
+import { describe, expect, it } from 'vitest';
+
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function schedule(amount: ScheduleEntity['_amount']): ScheduleEntity {
+  return {
+    id: 'schedule',
+    name: 'Schedule',
+    rule: 'rule',
+    next_date: '2024-01-01',
+    completed: false,
+    posts_transaction: true,
+    tombstone: false,
+    _payee: null,
+    _account: null,
+    _amount: amount,
+    _amountOp: 'isbetween',
+    _date: '2024-01-01',
+    _conditions: [],
+    _actions: [],
+  };
+}
+
+describe('scheduleModel', () => {
+  it('returns the expected amount while preserving the entered amount and operator', () => {
+    const result = scheduleModel.toExternal(
+      schedule({ num1: -10100, num2: -20000 }),
+    );
+
+    expect(result).toMatchObject({
+      amount: { num1: -10100, num2: -20000 },
+      amountOp: 'isbetween',
+      expectedAmount: -20000,
+    });
+  });
+
+  it('uses a single amount as the expected amount', () => {
+    expect(scheduleModel.toExternal(schedule(1234)).expectedAmount).toBe(1234);
+  });
+
+  it('returns zero when the schedule has no amount', () => {
+    expect(scheduleModel.toExternal(schedule(null)).expectedAmount).toBe(0);
+  });
+});
