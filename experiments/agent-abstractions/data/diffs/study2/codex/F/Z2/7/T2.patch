@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest';
+
+import type { ScheduleEntity } from '#types/models/schedule';
+
+import { scheduleModel } from './api-models';
+
+function createSchedule(amount: ScheduleEntity['_amount']): ScheduleEntity {
+  return {
+    id: 'schedule-id',
+    rule: 'rule-id',
+    next_date: '2024-01-01',
+    completed: false,
+    posts_transaction: false,
+    tombstone: false,
+    _payee: 'payee-id',
+    _account: 'account-id',
+    _amount: amount,
+    _amountOp: 'is',
+    _date: '2024-01-01',
+    _conditions: [],
+    _actions: [],
+  };
+}
+
+describe('scheduleModel', () => {
+  it('returns the single amount as the expected amount', () => {
+    expect(scheduleModel.toExternal(createSchedule(12345)).expectedAmount).toBe(
+      12345,
+    );
+  });
+
+  it('uses the range end furthest from zero as the expected amount', () => {
+    expect(
+      scheduleModel.toExternal(
+        createSchedule({ num1: -10100, num2: -20000 }),
+      ).expectedAmount,
+    ).toBe(-20000);
+  });
+
+  it('uses zero when the schedule has no amount', () => {
+    const schedule = createSchedule(0);
+    schedule._amount = null as unknown as number;
+    expect(scheduleModel.toExternal(schedule).expectedAmount).toBe(0);
+  });
+});
