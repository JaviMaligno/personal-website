--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,33 @@
+import { scheduleModel } from './api-models';
+import type { ScheduleEntity } from '#types/models';
+
+describe('scheduleModel', () => {
+  it.each([
+    [{ num1: -10100, num2: -20000 }, -20000],
+    [12500, 12500],
+    [null, 0],
+  ])('includes the expected schedule amount for %j', (amount, expectedAmount) => {
+    const schedule = {
+      id: 'schedule-id',
+      name: 'Schedule',
+      rule: 'rule-id',
+      next_date: '2024-01-01',
+      completed: false,
+      posts_transaction: true,
+      tombstone: false,
+      _payee: 'payee-id',
+      _account: 'account-id',
+      _amount: amount,
+      _amountOp: 'isbetween',
+      _date: '2024-01-01',
+      _conditions: [],
+      _actions: [],
+    } satisfies ScheduleEntity;
+
+    const result = scheduleModel.toExternal(schedule);
+
+    expect(result.amount).toEqual(amount);
+    expect(result.amountOp).toBe('isbetween');
+    expect(result.expectedAmount).toBe(expectedAmount);
+  });
+});
