+export async function getDatesInRange({ config, start, end }) {
+  if (start > end) {
+    return [];
+  }
+
+  const rules = recurConfigToRSchedule(config);
+  const isDaily = config.frequency === 'daily';
+  const firstOccurrence = d.subDays(new Date(`${start}T12:00:00`), 7);
+  const lastOccurrence = d.addDays(new Date(`${end}T12:00:00`), 7);
+  const dates = new Set<string>();
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    for (const { date } of schedule.occurrences({
+      start: d.startOfDay(firstOccurrence),
+      end: d.endOfDay(lastOccurrence),
+    })) {
+      if (isDaily && config.skipWeekend && d.isWeekend(date)) {
+        continue;
+      }
+
+      const adjustedDate = applyWeekendRule(date, {
+        skipWeekend: config.skipWeekend,
+        solveMode: config.weekendSolveMode,
+      });
+      const day = dayFromDate(adjustedDate);
+      if (day >= start && day <= end) {
+        dates.add(day);
+      }
+    }
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+
+  return [...dates].sort();
+}
