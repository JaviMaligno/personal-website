+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // Weekend adjustments can move an occurrence by at most two days. Include
+    // those neighboring base dates, then apply the range to the adjusted day.
+    const occurrences = schedule
+      .occurrences({
+        start: d.subDays(parseDate(start), 3),
+        end: d.addDays(parseDate(end), 3),
+      })
+      .toArray();
+    const days = occurrences
+      .map(({ date }) => {
+        if (config.frequency === 'daily' && d.isWeekend(date)) return null;
+        return dayFromDate(
+          applyWeekendRule(date, {
+            skipWeekend: config.frequency !== 'daily' && config.skipWeekend,
+            solveMode: config.weekendSolveMode,
+          }),
+        );
+      })
+      .filter(day => day != null && day >= start && day <= end);
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
