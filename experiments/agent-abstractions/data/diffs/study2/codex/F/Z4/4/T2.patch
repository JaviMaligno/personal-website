+export async function getDatesInRange({ config, start, end }) {
+  if (start > end) {
+    return [];
+  }
+
+  const rules = recurConfigToRSchedule(config);
+  const rangeStart = d.subDays(new Date(`${start}T12:00:00`), 3);
+  const rangeEnd = d.addDays(new Date(`${end}T12:00:00`), 3);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const dates = schedule
+      .occurrences({ start: d.startOfDay(rangeStart), end: d.endOfDay(rangeEnd) })
+      .toArray()
+      .filter(({ date }) =>
+        config.frequency !== 'daily' || !config.skipWeekend || !d.isWeekend(date),
+      )
+      .map(({ date }) =>
+        dayFromDate(
+          applyWeekendRule(date, {
+            skipWeekend: config.skipWeekend,
+            solveMode: config.weekendSolveMode,
+          }),
+        ),
+      )
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
