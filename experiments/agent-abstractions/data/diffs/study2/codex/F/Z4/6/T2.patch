+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const rangeStart = d.subDays(parseDate(start), 3);
+  const rangeEnd = d.addDays(parseDate(end), 3);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const skipDailyWeekends =
+      config.frequency === 'daily' && config.skipWeekend;
+
+    return [
+      ...new Set(
+        schedule
+          .occurrences({ start: rangeStart, end: rangeEnd })
+          .toArray()
+          .map(({ date }) => {
+            if (skipDailyWeekends && d.isWeekend(date)) {
+              return null;
+            }
+            const finalDate = applyWeekendRule(date, {
+              skipWeekend: config.skipWeekend && !skipDailyWeekends,
+              solveMode: config.weekendSolveMode,
+            });
+            return dayFromDate(finalDate);
+          })
+          .filter((date): date is string => date != null)
+          .filter(date => date >= start && date <= end),
+      ),
+    ].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
