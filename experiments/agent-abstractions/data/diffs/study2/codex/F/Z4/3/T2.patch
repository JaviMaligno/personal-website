+function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const startDate = d.subDays(d.startOfDay(new Date(start)), 3);
+  const endDate = d.addDays(d.startOfDay(new Date(end)), 3);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const isDaily = config.frequency === 'daily';
+    const dates = schedule
+      .occurrences({ start: startDate, end: endDate })
+      .toArray()
+      .flatMap(({ date }) => {
+        if (config.skipWeekend && isDaily && d.isWeekend(date)) {
+          return [];
+        }
+
+        const finalDate = applyWeekendRule(date, {
+          skipWeekend: config.skipWeekend && !isDaily,
+          solveMode: config.weekendSolveMode,
+        });
+        const day = dayFromDate(finalDate);
+        return day >= start && day <= end ? [day] : [];
+      });
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
