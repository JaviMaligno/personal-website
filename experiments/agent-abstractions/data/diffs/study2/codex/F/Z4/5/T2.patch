+export async function getDatesInRange({ config, start, end }) {
+  if (start > end) {
+    return [];
+  }
+
+  const rules = recurConfigToRSchedule(config);
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // Weekend adjustments can move an occurrence by at most two days.
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(d.parseISO(start), 2)),
+        end: d.endOfDay(d.addDays(d.parseISO(end), 2)),
+      })
+      .toArray();
+
+    return [
+      ...new Set(
+        occurrences
+          .filter(
+            ({ date }) =>
+              !(
+                config.frequency === 'daily' &&
+                config.skipWeekend &&
+                d.isWeekend(date)
+              ),
+          )
+          .map(({ date }) =>
+            dayFromDate(
+              applyWeekendRule(date, {
+                skipWeekend: config.skipWeekend,
+                solveMode: config.weekendSolveMode,
+              }),
+            ),
+          )
+          .filter(day => day >= start && day <= end),
+      ),
+    ].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
