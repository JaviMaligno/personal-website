+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // Weekend adjustments can move a Saturday/Sunday occurrence across either
+    // boundary, so generate a small buffer and filter on the final day below.
+    const startDate = d.startOfDay(d.subDays(new Date(`${start}T00:00:00`), 2));
+    const endDate = d.endOfDay(d.addDays(new Date(`${end}T00:00:00`), 2));
+    const isDaily = config.frequency === 'daily';
+    const skipWeekend = config.skipWeekend;
+    const dates = schedule
+      .occurrences({ start: startDate, end: endDate })
+      .toArray()
+      .map(({ date }) => {
+        if (skipWeekend && isDaily && d.isWeekend(date)) {
+          return null;
+        }
+        return dayFromDate(
+          applyWeekendRule(date, {
+            skipWeekend,
+            solveMode: config.weekendSolveMode,
+          }),
+        );
+      })
+      .filter((date): date is string => date != null && date >= start && date <= end);
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
