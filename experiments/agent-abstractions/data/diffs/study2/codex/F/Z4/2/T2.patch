+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  // Weekend adjustment can move a Saturday/Sunday occurrence by up to two days.
+  // Generate a small margin on each side, then apply the period bounds to the
+  // final schedule day.
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), 2)),
+      end: d.endOfDay(d.addDays(parseDate(end), 2)),
+    })
+    .toArray();
+  const isDailyWithWeekendSkip =
+    config.frequency === 'daily' && config.skipWeekend;
+
+  return [...new Set(
+    occurrences
+      .filter(({ date }) => !isDailyWithWeekendSkip || !d.isWeekend(date))
+      .map(({ date }) =>
+        applyWeekendRule(date, {
+          skipWeekend: config.skipWeekend && !isDailyWithWeekendSkip,
+          solveMode: config.weekendSolveMode,
+        }),
+      )
+      .map(dayFromDate)
+      .filter(day => day >= start && day <= end),
+  )].sort();
+}
