+import * as db from '#server/db';
+
+import { app as accountsApp } from './app';
+
+beforeEach(async () => {
+  await global.emptyDatabase()();
+});
+
+const externalAccount = {
+  account_id: 'ext-1',
+  name: 'Bank',
+  institution: 'Inst',
+  orgDomain: 'inst.example',
+  balance: 0,
+};
+
+describe('linking closed accounts', () => {
+  it.each([false, true])(
+    'refuses a closed account (already linked: %s)',
+    async alreadyLinked => {
+      await db.insertAccount({
+        id: 'acct',
+        name: 'Closed',
+        closed: 1,
+        ...(alreadyLinked
+          ? { account_id: 'ext-1', account_sync_source: 'simpleFin' }
+          : {}),
+      });
+      const before = await db.all('SELECT * FROM accounts');
+
+      await expect(
+        accountsApp.handlers['simplefin-accounts-link']({
+          externalAccount,
+          upgradingId: 'acct',
+        } as never),
+      ).rejects.toThrow(
+        'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+      );
+
+      expect(await db.all('SELECT * FROM accounts')).toEqual(before);
+    },
+  );
+});
