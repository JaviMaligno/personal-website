+const FIXED_GROUP_TAG = /(^|\s)#fixed(?![\w-])/;
+
+// Month-wide actions leave categories with saved templates and categories in
+// groups tagged `#fixed` (in the group's notes) untouched.
+function isSkippedCategory(cat: {
+  goal_def?: string | null;
+  group_notes?: string | null;
+}): boolean {
+  return (
+    hasSavedTemplates(cat.goal_def) ||
+    FIXED_GROUP_TAG.test(cat.group_notes ?? '')
+  );
+}
