+// Categories that month-wide actions may write to: not hidden, not in a
+// hidden group, and without saved budget templates.
+function getFillableCategories() {
+  return db.all<db.DbViewCategoryWithGroupHidden>(
+    `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND COALESCE(c.hidden, 0) = 0
+    AND COALESCE(g.hidden, 0) = 0
+    AND (c.goal_def IS NULL OR TRIM(c.goal_def) IN ('', '[]', 'null'))
+  `,
+  );
+}
