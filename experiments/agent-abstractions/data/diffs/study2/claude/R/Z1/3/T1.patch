+async function getTemplatedCategoryIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; goal_def: string | null }>(
+    'SELECT id, goal_def FROM categories WHERE tombstone = 0 AND goal_def IS NOT NULL',
+  );
+  const ids = new Set<string>();
+  for (const row of rows) {
+    let defs: unknown;
+    try {
+      defs = JSON.parse(row.goal_def ?? 'null');
+    } catch {
+      defs = row.goal_def;
+    }
+    if (Array.isArray(defs) ? defs.length > 0 : Boolean(defs)) {
+      ids.add(row.id);
+    }
+  }
+  return ids;
+}
