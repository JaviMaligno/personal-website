+// Ids of categories in a group whose notes carry the `#fixed` tag. Month-wide
+// actions leave these alone. Only the group's notes count.
+export async function getFixedCategoryIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `
+  SELECT c.id, n.note
+  FROM categories c
+  JOIN category_groups g ON c.cat_group = g.id
+  JOIN notes n ON n.id = g.id
+  WHERE c.tombstone = 0 AND n.note IS NOT NULL
+  `,
+  );
+  return new Set(
+    rows
+      .filter(r => extractTagsFromText(r.note ?? '').includes('fixed'))
+      .map(r => r.id),
+  );
+}
