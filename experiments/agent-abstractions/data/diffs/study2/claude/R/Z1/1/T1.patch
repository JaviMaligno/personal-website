+async function getTemplateCategoryIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; goal_def: string | null }>(
+    'SELECT id, goal_def FROM categories WHERE tombstone = 0 AND goal_def IS NOT NULL',
+  );
+  const ids = new Set<string>();
+  for (const row of rows) {
+    try {
+      const templates = JSON.parse(row.goal_def);
+      if (Array.isArray(templates) && templates.length > 0) {
+        ids.add(row.id);
+      }
+    } catch {
+      // Unparseable definitions are not saved templates
+    }
+  }
+  return ids;
+}
