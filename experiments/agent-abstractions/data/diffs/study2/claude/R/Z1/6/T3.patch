+const FIXED_TAG = /(?:^|[^\w#])#fixed(?![\w-])/i;
+
+// Ids of categories in a group whose notes carry the `#fixed` tag. Month-wide
+// actions leave these alone.
+async function getFixedCategoryIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `
+  SELECT c.id, n.note
+  FROM categories c
+  JOIN notes n ON n.id = c.cat_group
+  WHERE c.tombstone = 0
+  `,
+  );
+  return new Set(rows.filter(r => FIXED_TAG.test(r.note ?? '')).map(r => r.id));
+}
