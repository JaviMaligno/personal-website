   return ids;
 }
 
+const FIXED_TAG = /(^|\s)#fixed(?![\w-])/;
+
+async function getFixedGroupCategoryIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `SELECT c.id, n.note
+     FROM categories c
+     JOIN category_groups g ON c.cat_group = g.id
+     JOIN notes n ON n.id = g.id
+     WHERE c.tombstone = 0 AND g.tombstone = 0 AND n.note LIKE '%#fixed%'`,
+  );
+  return new Set(
+    rows.filter(row => FIXED_TAG.test(row.note ?? '')).map(row => row.id),
+  );
+}
+
+// Categories that month-wide actions must leave untouched
+async function getSkippedCategoryIds(): Promise<Set<string>> {
+  const [templated, fixed] = await Promise.all([
+    getTemplatedCategoryIds(),
+    getFixedGroupCategoryIds(),
+  ]);
+  return new Set([...templated, ...fixed]);
+}
