+  });
+
+  afterEach(async () => {
+    await global.emptyDatabase()();
+  });
+
+  it('skips hidden categories by default', async () => {
+    await setZero({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(9);
+  });
+
+  it('fills hidden categories when requested', async () => {
+    await setZero({ month: '2024-04', includeHiddenCategories: true });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(0);
+  });
+});
