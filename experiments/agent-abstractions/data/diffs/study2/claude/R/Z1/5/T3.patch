+// Groups tagged `#fixed` in their notes hold fixed costs that month-wide
+// actions must not change.
+function isInFixedGroup({
+  group_notes,
+}: {
+  group_notes?: string | null;
+}): boolean {
+  return !!group_notes && /(^|\s)#fixed(?![\w-])/.test(group_notes);
+}
+
+function isSkippedByMonthActions(category: {
+  goal_def?: string | null;
+  group_notes?: string | null;
+}): boolean {
+  return hasSavedTemplates(category) || isInFixedGroup(category);
+}
