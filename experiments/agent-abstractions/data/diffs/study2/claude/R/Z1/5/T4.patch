+async function getMonthActionCategories(includeHiddenCategories?: boolean) {
+  const allCategories = await db.all<
+    db.DbCategory & { group_notes: string | null }
+  >(
+    `
+  SELECT c.*, n.note AS group_notes
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  LEFT JOIN notes n ON n.id = g.id
+  WHERE c.tombstone = 0 ${includeHiddenCategories ? '' : 'AND c.hidden = 0 AND g.hidden = 0'}
+  `,
+  );
+  return allCategories.filter(cat => !isSkippedByMonthActions(cat));
+}
