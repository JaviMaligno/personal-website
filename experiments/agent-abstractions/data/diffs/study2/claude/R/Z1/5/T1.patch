+// Categories with saved templates are managed by the template system, so
+// month-wide actions leave them alone.
+function hasSavedTemplates({
+  goal_def,
+}: {
+  goal_def?: string | null;
+}): boolean {
+  if (!goal_def) {
+    return false;
+  }
+  try {
+    const parsed: unknown = JSON.parse(goal_def);
+    return Array.isArray(parsed) ? parsed.length > 0 : true;
+  } catch {
+    return true;
+  }
+}
