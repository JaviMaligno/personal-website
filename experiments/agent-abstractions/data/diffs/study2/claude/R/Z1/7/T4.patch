+
+describe('includeHiddenCategories', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('fills hidden categories and hidden groups only when requested', async () => {
+    await db.insertCategoryGroup({ id: 'inc-g', name: 'Income', is_income: 1 });
+    await db.insertCategory({
+      id: 'inc',
+      name: 'Inc',
+      cat_group: 'inc-g',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'g', name: 'G', is_income: 0 });
+    await db.insertCategoryGroup({
+      id: 'hg',
+      name: 'HG',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'hc',
+      name: 'HC',
+      cat_group: 'g',
+      hidden: 1,
+    });
+    await db.insertCategory({ id: 'ingroup', name: 'In', cat_group: 'hg' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+
+    await setBudget({ category: 'hc', month: '2024-01', amount: 100 });
+    await setBudget({ category: 'ingroup', month: '2024-01', amount: 200 });
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202401', 'budget-hc')).toBe(100);
+    expect(await getSheetValue('budget202401', 'budget-ingroup')).toBe(200);
+
+    await setZero({ month: '2024-01', includeHiddenCategories: true });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202401', 'budget-hc')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-ingroup')).toBe(0);
+  });
+});
