   if (amount == null) return 0;
 
-  if (typeof amount === 'number') {
-    return inverse ? -amount : amount;
-  }
-  const worst = getRangeAmount(amount);
+  const worst = getExpectedAmount(amount, op);
   return inverse ? -worst : worst;
 }
 
