+// An approximate amount is planned at the end of its matching tolerance
+// furthest from zero.
+export function getApproxAmount(amount: number): number {
+  const threshold = getApproxNumberThreshold(amount);
+  return amount < 0 ? amount - threshold : amount + threshold;
+}
+
+// The amount a schedule is expected to cost, planned at the worst case:
+// ranges and approximate amounts resolve to their end furthest from zero.
+export function getExpectedAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getRangeAmount(amount);
+  return op === 'isapprox' ? getApproxAmount(amount) : amount;
+}
+
 export function getScheduledAmount(
