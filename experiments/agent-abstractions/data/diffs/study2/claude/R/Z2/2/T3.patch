+// An amount is expected at its worst case: a ranged amount at the end furthest
+// from zero, an approximate amount at the end of its tolerance furthest from
+// zero. Other amounts are unchanged.
+export function getWorstCaseAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getRangeWorstCaseAmount(amount);
+  if (op === 'isapprox') {
+    const threshold = getApproxNumberThreshold(amount);
+    return amount < 0 ? amount - threshold : amount + threshold;
+  }
+  return amount;
+}
