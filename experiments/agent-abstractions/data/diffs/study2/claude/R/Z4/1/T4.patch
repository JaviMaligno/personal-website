+const YEARLY_HOLIDAY = /^\d{2}-\d{2}$/;
+
+function isFullDate(day: string) {
+  return !YEARLY_HOLIDAY.test(day);
+}
+
+// `MM-DD` holidays recur every year, so they are excluded with a yearly rule
+export function recurConfigToExrules(config): ScheduleRuleOptions[] {
+  if (!config.skipWeekend || config.frequency !== 'daily') {
+    return [];
+  }
+  return (config.holidays ?? [])
+    .filter((day: string) => YEARLY_HOLIDAY.test(day))
+    .map((day: string) => {
+      const [month, dayOfMonth] = day.split('-').map(Number);
+      return {
+        start: monthUtils.parseDate(config.start),
+        frequency: 'YEARLY',
+        byMonthOfYear: [month],
+        byDayOfMonth: [dayOfMonth],
+        byHourOfDay: [12],
+      } as ScheduleRuleOptions;
+    });
+}
