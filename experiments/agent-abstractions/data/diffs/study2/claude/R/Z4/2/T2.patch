+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: Parameters<typeof recurConfigToRSchedule>[0];
+  start: string;
+  end: string;
+}) {
+  if (start > end) return [];
+
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const skipsWeekendDays = config.skipWeekend && config.frequency === 'daily';
+
+    // Weekend adjustment moves a date by at most two days, so look slightly
+    // beyond the period and decide on the final day.
+    const dates = new Set<string>();
+    for (const occ of schedule.occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), 2)),
+      end: d.endOfDay(d.addDays(parseDate(end), 2)),
+    })) {
+      let date: Date = occ.date;
+      if (skipsWeekendDays) {
+        if (d.isWeekend(date)) continue;
+      } else if (config.skipWeekend) {
+        date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) dates.add(day);
+    }
+    return [...dates].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
