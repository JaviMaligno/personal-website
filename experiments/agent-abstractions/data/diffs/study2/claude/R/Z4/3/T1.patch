+// Enough to get past any weekend run; an interval that only ever lands on
+// weekends (e.g. every 7 days) has no weekday occurrence at all.
+const MAX_DAILY_WEEKDAY_SEARCH = 14;
+
+function findDailyWeekday(schedule, start: Date): Date | null {
+  let found = 0;
+  for (const { date } of schedule.occurrences({
+    start,
+    take: MAX_DAILY_WEEKDAY_SEARCH,
+  })) {
+    if (!d.isWeekend(date)) return date;
+    found++;
+  }
+  if (found > 0) return null;
+
+  // Could be a schedule with limited occurrences, so we try to find the
+  // last occurrence on a weekday
+  let seen = 0;
+  for (const { date } of schedule.occurrences({ reverse: true })) {
+    if (!d.isWeekend(date)) return date;
+    if (++seen >= MAX_DAILY_WEEKDAY_SEARCH) break;
+  }
+  return null;
+}
