+describe('schedule/get-dates-in-range', () => {
+  const call = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences and decides by the final day', async () => {
+    // 2024-06-01 is a Saturday, 2024-06-02 a Sunday
+    const config = {
+      start: '2024-06-01',
+      frequency: 'monthly',
+      patterns: [],
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await call(config, '2024-06-03', '2024-06-30')).toEqual([
+      '2024-06-03',
+    ]);
+    expect(await call(config, '2024-05-01', '2024-05-31')).toEqual([]);
+    const before = { ...config, weekendSolveMode: 'before' };
+    expect(await call(before, '2024-05-31', '2024-05-31')).toEqual([
+      '2024-05-31',
+    ]);
+  });
+
+  it('skips weekend occurrences of daily schedules', async () => {
+    const config = {
+      start: '2024-06-01',
+      frequency: 'daily',
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await call(config, '2024-06-01', '2024-06-04')).toEqual([
+      '2024-06-03',
+      '2024-06-04',
+    ]);
+  });
+});
