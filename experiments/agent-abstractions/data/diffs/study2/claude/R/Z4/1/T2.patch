+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+    // A weekend occurrence moves by at most two days, so look slightly
+    // beyond the period on both sides and decide on the adjusted day.
+    const from = d.subDays(parseDate(start), 3);
+    const to = d.endOfDay(d.addDays(parseDate(end), 3));
+    const isDaily = config.frequency === 'daily';
+
+    const days = new Set<string>();
+    for (const occurrence of schedule
+      .occurrences({ start: d.startOfDay(from), end: to })
+      .toArray()) {
+      const date =
+        config.skipWeekend && !isDaily
+          ? getDateWithSkippedWeekend(
+              occurrence.date,
+              config.weekendSolveMode ?? 'before',
+            )
+          : occurrence.date;
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
