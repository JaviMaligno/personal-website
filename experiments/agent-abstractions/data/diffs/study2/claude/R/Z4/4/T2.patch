+describe('schedule/get-dates-in-range', () => {
+  const base = {
+    start: '2024-01-01',
+    frequency: 'monthly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: true,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('moves weekend occurrences and decides by the final day', async () => {
+    // 2024-06-01 is a Saturday -> Monday 2024-06-03
+    const config = { ...base, start: '2024-06-01' };
+    const call = (start, end) =>
+      schedulesApp.handlers['schedule/get-dates-in-range']({
+        config,
+        start,
+        end,
+      });
+    expect(await call('2024-06-02', '2024-06-30')).toEqual(['2024-06-03']);
+    expect(await call('2024-05-01', '2024-06-02')).toEqual([]);
+    expect(await call('2024-06-03', '2024-06-03')).toEqual(['2024-06-03']);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    const config = { ...base, frequency: 'daily', start: '2024-06-01' };
+    expect(
+      await schedulesApp.handlers['schedule/get-dates-in-range']({
+        config,
+        start: '2024-06-01',
+        end: '2024-06-05',
+      }),
+    ).toEqual(['2024-06-03', '2024-06-04', '2024-06-05']);
+  });
+});
