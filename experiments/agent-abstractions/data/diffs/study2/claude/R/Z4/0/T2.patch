+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  if (start > end) return [];
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const skipDaily = config.skipWeekend && config.frequency === 'daily';
+    // Weekend adjustment moves an occurrence by at most two days, so look
+    // slightly outside the period and decide by the final day.
+    const searchStart = d.subDays(parseDate(start), 3);
+    const searchEnd = dayFromDate(d.addDays(parseDate(end), 3));
+    const days = new Set<string>();
+    for (const occurrence of schedule.occurrences({
+      start: d.startOfDay(searchStart),
+    })) {
+      if (dayFromDate(occurrence.date) > searchEnd) break;
+      let date = occurrence.date;
+      if (config.skipWeekend) {
+        if (skipDaily) {
+          if (d.isWeekend(date)) continue;
+        } else {
+          date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        }
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) days.add(day);
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
