+describe('schedule/get-dates-in-range', () => {
+  const call = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+  const monthly = {
+    start: '2025-01-01',
+    frequency: 'monthly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: true,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('moves weekend occurrences and decides by the final day', async () => {
+    // 2025-03-01 is a Saturday -> Monday 2025-03-03
+    expect(
+      await call(
+        { ...monthly, start: '2025-03-01' },
+        '2025-03-03',
+        '2025-03-10',
+      ),
+    ).toEqual(['2025-03-03']);
+    expect(
+      await call(
+        { ...monthly, start: '2025-03-01' },
+        '2025-03-01',
+        '2025-03-02',
+      ),
+    ).toEqual([]);
+    expect(
+      await call(
+        { ...monthly, start: '2025-03-01', weekendSolveMode: 'before' },
+        '2025-02-28',
+        '2025-02-28',
+      ),
+    ).toEqual(['2025-02-28']);
+  });
+
+  it('skips weekend days for daily schedules', async () => {
+    expect(
+      await call(
+        { ...monthly, frequency: 'daily', start: '2025-03-01' },
+        '2025-03-01',
+        '2025-03-04',
+      ),
+    ).toEqual(['2025-03-03', '2025-03-04']);
+  });
+});
