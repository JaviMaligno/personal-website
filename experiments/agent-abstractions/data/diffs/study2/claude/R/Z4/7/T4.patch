+// Entries are either `YYYY-MM-DD` (that day only) or `MM-DD` (every year)
+function isHoliday(date: Date, holidays?: string[]): boolean {
+  if (holidays == null || holidays.length === 0) return false;
+  const day = monthUtils.dayFromDate(date);
+  return holidays.includes(day) || holidays.includes(day.slice(5));
+}
