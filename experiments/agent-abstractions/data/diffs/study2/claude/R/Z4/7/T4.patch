+
+describe('recurring MM-DD holidays', () => {
+  it('skips the same day in every year', () => {
+    for (const day of ['2020-12-25', '2021-12-25', '2024-12-25']) {
+      const date = monthUtils.parseDate(day);
+      expect(isNonWorkingDay(date, ['12-25'])).toBe(true);
+    }
+    expect(isNonWorkingDay(monthUtils.parseDate('2020-12-24'), ['12-25'])).toBe(
+      false,
+    );
+  });
+
+  it('still treats YYYY-MM-DD as one day only and allows mixing', () => {
+    const holidays = ['2020-12-14', '12-25'];
+    expect(isNonWorkingDay(monthUtils.parseDate('2020-12-14'), holidays)).toBe(
+      true,
+    );
+    expect(isNonWorkingDay(monthUtils.parseDate('2021-12-14'), holidays)).toBe(
+      false,
+    );
+    expect(
+      monthUtils.dayFromDate(
+        getDateWithSkippedWeekend(
+          monthUtils.parseDate('2021-12-25'),
+          'after',
+          holidays,
+        ),
+      ),
+    ).toBe('2021-12-27');
+  });
+});
