+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  if (start > end) {
+    return [];
+  }
+
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+    // Daily schedules skip weekend occurrences instead of moving them
+    const skipsWeekendDays = config.skipWeekend && config.frequency === 'daily';
+
+    // Weekend adjustment moves an occurrence by at most 2 days, so look a bit
+    // beyond the period and decide on the final day.
+    const searchStart = d.subDays(parseDate(start), 3);
+    const searchEnd = d.endOfDay(d.addDays(parseDate(end), 3));
+
+    const days = new Set<string>();
+    schedule
+      .occurrences({ start: d.startOfDay(searchStart), end: searchEnd })
+      .toArray()
+      .forEach(occ => {
+        if (skipsWeekendDays && d.isWeekend(occ.date)) {
+          return;
+        }
+        const date =
+          config.skipWeekend && !skipsWeekendDays
+            ? getDateWithSkippedWeekend(occ.date, config.weekendSolveMode)
+            : occ.date;
+        const day = dayFromDate(date);
+        if (day >= start && day <= end) {
+          days.add(day);
+        }
+      });
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
