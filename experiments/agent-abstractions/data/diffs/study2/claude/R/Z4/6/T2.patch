+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: Parameters<typeof recurConfigToRSchedule>[0];
+  start: string;
+  end: string;
+}) {
+  if (start > end) {
+    return [];
+  }
+
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+    // Daily schedules skip weekend occurrences instead of moving them
+    const skipsWeekend = config.skipWeekend && config.frequency === 'daily';
+
+    // Weekend adjustment moves an occurrence by at most two days, so
+    // look a little beyond the period on both sides
+    const days = new Set<string>();
+    for (const occurrence of schedule.occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), 3)),
+      end: d.endOfDay(d.addDays(parseDate(end), 3)),
+    })) {
+      let date = occurrence.date;
+      if (config.skipWeekend) {
+        if (skipsWeekend) {
+          if (d.isWeekend(date)) continue;
+        } else {
+          date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        }
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
