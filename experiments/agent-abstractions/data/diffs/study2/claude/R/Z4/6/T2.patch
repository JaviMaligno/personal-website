+describe('schedule/get-dates-in-range', () => {
+  const base = {
+    start: '2024-01-01',
+    frequency: 'weekly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: false,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('returns days in range inclusive', async () => {
+    const days = await schedulesApp.handlers['schedule/get-dates-in-range']({
+      config: base,
+      start: '2024-01-01',
+      end: '2024-01-15',
+    });
+    expect(days).toEqual(['2024-01-01', '2024-01-08', '2024-01-15']);
+  });
+
+  it('moves weekend occurrences into and out of the range', async () => {
+    const config = {
+      ...base,
+      start: '2024-01-06', // Saturday
+      skipWeekend: true,
+    };
+    expect(
+      await schedulesApp.handlers['schedule/get-dates-in-range']({
+        config,
+        start: '2024-01-08',
+        end: '2024-01-08',
+      }),
+    ).toEqual(['2024-01-08']);
+    expect(
+      await schedulesApp.handlers['schedule/get-dates-in-range']({
+        config,
+        start: '2024-01-06',
+        end: '2024-01-07',
+      }),
+    ).toEqual([]);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    const days = await schedulesApp.handlers['schedule/get-dates-in-range']({
+      config: { ...base, frequency: 'daily', skipWeekend: true },
+      start: '2024-01-05',
+      end: '2024-01-09',
+    });
+    expect(days).toEqual(['2024-01-05', '2024-01-08', '2024-01-09']);
+  });
+});
