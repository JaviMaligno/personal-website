+// A daily schedule with an interval that is a multiple of 7 can stay on a
+// weekend forever, so only look a bounded number of occurrences ahead.
+const MAX_WEEKEND_SKIPS = 7;
+
+function findWeekdayOccurrence(
+  schedule,
+  options: { start?: Date; reverse?: boolean },
+): Date | null {
+  const occurrences = schedule
+    .occurrences({ ...options, take: MAX_WEEKEND_SKIPS })
+    .toArray();
+  const found = occurrences.find(o => !d.isWeekend(o.date));
+  return found ? found.date : null;
+}
