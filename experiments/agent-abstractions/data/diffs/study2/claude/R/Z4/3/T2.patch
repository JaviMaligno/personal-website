+describe('schedule/get-dates-in-range', () => {
+  const base = {
+    start: '2024-01-01',
+    frequency: 'weekly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: false,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+  const call = (config, start, end) => getDatesInRange({ config, start, end });
+
+  it('lists plain occurrences inclusively', async () => {
+    expect(await call(base, '2024-01-01', '2024-01-15')).toEqual([
+      '2024-01-01',
+      '2024-01-08',
+      '2024-01-15',
+    ]);
+  });
+
+  it('decides membership by the moved day', async () => {
+    const config = {
+      ...base,
+      start: '2024-01-06', // Saturday
+      skipWeekend: true,
+    };
+    // Saturday -> Monday the 8th
+    expect(await call(config, '2024-01-07', '2024-01-08')).toEqual([
+      '2024-01-08',
+    ]);
+    expect(await call(config, '2024-01-06', '2024-01-07')).toEqual([]);
+    expect(
+      await call(
+        { ...config, weekendSolveMode: 'before' },
+        '2024-01-05',
+        '2024-01-05',
+      ),
+    ).toEqual(['2024-01-05']);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    expect(
+      await call(
+        { ...base, frequency: 'daily', skipWeekend: true },
+        '2024-01-05',
+        '2024-01-09',
+      ),
+    ).toEqual(['2024-01-05', '2024-01-08', '2024-01-09']);
+  });
+});
