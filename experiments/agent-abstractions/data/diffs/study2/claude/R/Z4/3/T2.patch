+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const skipsWeekendDays = config.skipWeekend && config.frequency === 'daily';
+    // Weekend adjustment moves an occurrence by at most two days, so look
+    // slightly beyond the period and decide by the adjusted day.
+    const from = d.startOfDay(d.subDays(parseDate(start), 2));
+    const until = dayFromDate(d.addDays(parseDate(end), 2));
+    const dates = new Set<string>();
+
+    for (const { date } of schedule.occurrences({ start: from })) {
+      if (dayFromDate(date) > until) break;
+
+      let day: string;
+      if (!config.skipWeekend) {
+        day = dayFromDate(date);
+      } else if (skipsWeekendDays) {
+        if (d.isWeekend(date)) continue;
+        day = dayFromDate(date);
+      } else {
+        day = dayFromDate(
+          getDateWithSkippedWeekend(date, config.weekendSolveMode),
+        );
+      }
+
+      if (day >= start && day <= end) dates.add(day);
+    }
+
+    return [...dates].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
