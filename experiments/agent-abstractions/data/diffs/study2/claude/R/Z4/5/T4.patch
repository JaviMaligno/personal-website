+
+// Entries are either `YYYY-MM-DD` (that day only) or `MM-DD` (every year).
+function isHoliday(date: Date, holidays: string[]) {
+  const day = monthUtils.dayFromDate(date);
+  return holidays.includes(day) || holidays.includes(day.slice(5));
+}
+
+// Upper bound of how many days within `days` days can be holidays. Yearly
+// (`MM-DD`) entries can repeat for every year the span touches.
+export function getHolidayAllowance(
+  holidays: string[] | undefined,
+  days: number,
+) {
+  if (!holidays) {
+    return 0;
+  }
+  const yearly = holidays.filter(h => h.length === 5).length;
+  const years = Math.ceil(days / 365) + 1;
+  return holidays.length - yearly + yearly * years;
 }
 
