+      skipWeekend: true,
+      weekendSolveMode,
+      endMode: 'never',
+    },
+  });
+
+  it.each(['before', 'after'] as const)(
+    'skips weekend occurrences instead of moving them (%s)',
+    mode => {
+      expect(getNextDate(daily(mode), new Date(2025, 5, 7))).toBe('2025-06-09');
+      expect(getNextDate(daily(mode), new Date(2025, 5, 8))).toBe('2025-06-09');
+      expect(getNextDate(daily(mode), new Date(2025, 5, 10))).toBe(
+        '2025-06-10',
+      );
+    },
+  );
+});
