+// Upper bound on occurrences inspected while looking for a non-weekend one
+// (an interval like every 7 days can land on weekends forever)
+const MAX_WEEKEND_SCAN = 1000;
+
+function firstWeekday(
+  occurrences: Iterable<{ date: Date }>,
+  limit: number,
+): Date | null {
+  let seen = 0;
+  for (const occurrence of occurrences) {
+    if (!d.isWeekend(occurrence.date)) {
+      return occurrence.date;
+    }
+    if (++seen >= limit) {
+      break;
+    }
+  }
+  return null;
+}
