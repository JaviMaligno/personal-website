+// Refuses to link a provider account that another (non-deleted) local account
+// already holds. Must run before any write.
+async function assertNotLinkedElsewhere(
+  syncSource: AccountSyncSource,
+  providerAccountId: string,
+  upgradingId?: string,
+) {
+  const existing = await db.first<Pick<db.DbAccount, 'id'>>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+       AND id IS NOT ?`,
+    [syncSource, providerAccountId, upgradingId ?? null],
+  );
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
