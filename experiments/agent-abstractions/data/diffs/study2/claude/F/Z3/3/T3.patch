+
+describe('linking a bank account to a closed account', () => {
+  const message =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Ext',
+    institution: 'Inst',
+    orgDomain: null,
+    orgId: 'org-1',
+  };
+
+  it('refuses without changing anything', async () => {
+    await db.insertAccount({ id: 'acct1', name: 'Old', closed: 1 });
+
+    await expect(
+      app.handlers['enablebanking-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+      } as never),
+    ).rejects.toThrow(message);
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    const banks = await db.all('SELECT id FROM banks');
+    expect(banks).toEqual([]);
+    const acct = await db.first<{ account_id: string | null }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(acct!.account_id).toBeNull();
+  });
+
+  it('refuses re-linking a closed account that holds the link', async () => {
+    insertBank({ id: 'bank1', bank_id: 'eb', name: 'EB' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Old',
+      closed: 1,
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'enableBanking',
+    });
+
+    await expect(
+      app.handlers['enablebanking-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+      } as never),
+    ).rejects.toThrow(message);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
