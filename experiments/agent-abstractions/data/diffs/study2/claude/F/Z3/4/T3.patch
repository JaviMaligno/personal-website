+
+describe('linking a bank account to a closed account', () => {
+  const closedMessage =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    orgId: 'org-1',
+    balance: 0,
+  };
+
+  it('refuses a closed account and changes nothing', async () => {
+    await db.insertAccount({ id: 'acct1', name: 'Old', closed: 1 });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+      }),
+    ).rejects.toThrow(closedMessage);
+
+    const row = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(row.account_id).toBeNull();
+    expect(row.bank).toBeNull();
+    expect(await db.all('SELECT id FROM banks')).toHaveLength(0);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses re-linking a closed account that already holds the link', async () => {
+    insertBank({ id: 'bank1', bank_id: 'sfin-bank', name: 'SimpleFin' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Old',
+      closed: 1,
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+      }),
+    ).rejects.toThrow(closedMessage);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
