+// A bank account may feed only one local account. Deleted accounts don't hold
+// a link; closed ones do. Re-linking into the holding account is allowed.
+async function assertNotLinkedElsewhere(
+  syncSource: AccountSyncSource,
+  providerAccountId: string,
+  upgradingId?: string,
+) {
+  const existing = await db.first<Pick<db.DbAccount, 'id'>>(
+    'SELECT id FROM accounts WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ? AND id IS NOT ?',
+    [syncSource, providerAccountId, upgradingId ?? null],
+  );
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
