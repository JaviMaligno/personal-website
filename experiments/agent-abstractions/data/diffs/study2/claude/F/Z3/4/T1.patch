+// A bank account may feed only one local account per provider. Must run
+// before anything is written (including the bank record).
+async function assertBankAccountNotLinked(
+  syncSource: AccountSyncSource,
+  providerAccountId: string,
+  upgradingId?: string,
+) {
+  const existing = await db.first<Pick<db.DbAccount, 'id'>>(
+    'SELECT id FROM accounts WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ? AND id IS NOT ? LIMIT 1',
+    [syncSource, providerAccountId, upgradingId ?? null],
+  );
+
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
