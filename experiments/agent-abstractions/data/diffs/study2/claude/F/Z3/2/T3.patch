+describe('simplefin-accounts-link', () => {
+  const linkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    orgId: 'org1',
+    balance: 0,
+  };
+
+  it.each([false, true])(
+    'refuses to link a closed account (already linked: %s)',
+    async alreadyLinked => {
+      insertBank({ id: 'bank1', bank_id: 'sfin-bank', name: 'SimpleFin' });
+      await db.insertAccount({
+        id: 'acct1',
+        name: 'Checking',
+        closed: 1,
+        ...(alreadyLinked && {
+          bank: 'bank1',
+          account_id: 'ext-1',
+          account_sync_source: 'simpleFin',
+        }),
+      });
+      const before = await db.first('SELECT * FROM accounts WHERE id = ?', [
+        'acct1',
+      ]);
+
+      await expect(
+        runMutator(() =>
+          linkHandler({ externalAccount, upgradingId: 'acct1' } as never),
+        ),
+      ).rejects.toThrow(
+        'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+      );
+
+      expect(
+        await db.first('SELECT * FROM accounts WHERE id = ?', ['acct1']),
+      ).toEqual(before);
+      expect((await db.all('SELECT id FROM banks')).length).toBe(1);
+      expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    },
+  );
+});
