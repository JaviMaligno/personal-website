@@ -391,3 +391,78 @@ describe('linking a bank account to a closed account', () => {
     expect(bankSync.syncAccount).not.toHaveBeenCalled();
   });
 });
+
+describe('linking with replaceExistingLink', () => {
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Ext',
+    institution: 'Inst',
+    orgDomain: null,
+    orgId: 'org-1',
+  };
+
+  async function insertHolder(closed = 0) {
+    insertBank({ id: 'bank1', bank_id: 'eb', name: 'EB' });
+    await db.insertAccount({
+      id: 'old',
+      name: 'Old',
+      closed,
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'enableBanking',
+    });
+  }
+
+  it('refuses without the flag', async () => {
+    await insertHolder();
+    await expect(
+      app.handlers['enablebanking-accounts-link']({
+        externalAccount,
+      } as never),
+    ).rejects.toThrow('already linked');
+  });
+
+  it('unlinks the previous holder when linking a new account', async () => {
+    await insertHolder(1);
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+    } as never);
+    await app.handlers['enablebanking-accounts-link']({
+      externalAccount,
+      replaceExistingLink: true,
+    } as never);
+
+    const old = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['old'],
+    );
+    expect(old.bank).toBeNull();
+    expect(old.account_id).toBeNull();
+    expect(old.account_sync_source).toBeNull();
+    expect(old.closed).toBe(1);
+    expect(old.tombstone).toBe(0);
+    const linked = await db.all(
+      'SELECT id FROM accounts WHERE account_id = ? AND tombstone = 0',
+      ['ext-1'],
+    );
+    expect(linked).toHaveLength(1);
+  });
+
+  it('does not lift the closed-account rule', async () => {
+    await insertHolder();
+    await db.insertAccount({ id: 'target', name: 'Target', closed: 1 });
+    await expect(
+      app.handlers['enablebanking-accounts-link']({
+        externalAccount,
+        upgradingId: 'target',
+        replaceExistingLink: true,
+      } as never),
+    ).rejects.toThrow('Closed accounts');
+    const old = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['old'],
+    );
+    expect(old.account_id).toBe('ext-1');
+  });
+});
