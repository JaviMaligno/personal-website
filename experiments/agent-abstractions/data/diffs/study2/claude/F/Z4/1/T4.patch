+
+  it('treats MM-DD holidays as recurring every year', () => {
+    const yearly = {
+      skipWeekend: true,
+      solveMode: 'after' as const,
+      frequency: 'weekly',
+      holidays: ['01-08', '2024-01-09'],
+    };
+    // Saturday 2024-01-06 -> Mon 8th (yearly) and Tue 9th (one-off) skipped
+    expect(
+      monthUtils.dayFromDate(applyWeekendRule(new Date(2024, 0, 6), yearly)),
+    ).toBe('2024-01-10');
+    // 2025-01-08 is a Wednesday and a yearly holiday; 2025-01-09 is not
+    expect(
+      monthUtils.dayFromDate(applyWeekendRule(new Date(2025, 0, 8), yearly)),
+    ).toBe('2025-01-09');
+  });
 });
