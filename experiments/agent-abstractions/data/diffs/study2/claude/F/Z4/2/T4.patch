@@ -691,4 +691,18 @@ describe('holidays', () => {
       '2025-01-06',
     );
   });
+
+  it('treats MM-DD holidays as recurring every year', () => {
+    const holidays = ['01-06', '2026-01-08'];
+    const opts = { skipWeekend: true, solveMode: 'after' as const, holidays };
+    // 2025-01-04 Sat -> Mon 01-06 is a recurring holiday -> Tue
+    expect(applyWeekendRuleToDay('2025-01-04', opts)).toBe('2025-01-07');
+    // 2026-01-03 Sat -> Mon 01-05 is fine
+    expect(applyWeekendRuleToDay('2026-01-03', opts)).toBe('2026-01-05');
+    // Full dates still apply to one year only
+    expect(applyWeekendRuleToDay('2026-01-08', opts)).toBe('2026-01-09');
+    expect(applyWeekendRuleToDay('2025-01-08', opts)).toBe('2025-01-08');
+    // 2026-01-06 is a Tuesday and recurring holiday
+    expect(applyWeekendRuleToDay('2026-01-06', opts)).toBe('2026-01-07');
+  });
 });
