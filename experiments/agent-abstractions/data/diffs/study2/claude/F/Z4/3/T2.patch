+describe('schedule/get-dates-in-range', () => {
+  const run = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+  const monthly = {
+    start: '2024-01-01',
+    frequency: 'monthly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: true,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('moves weekend occurrences into and out of the period', async () => {
+    // 2024-06-01 is a Saturday -> Monday 06-03; 2024-09-01 Sunday -> 09-02
+    const c = { ...monthly, start: '2024-06-01' };
+    expect(await run(c, '2024-06-03', '2024-06-03')).toEqual(['2024-06-03']);
+    expect(await run(c, '2024-05-30', '2024-06-02')).toEqual([]);
+    const before = { ...c, weekendSolveMode: 'before' };
+    expect(await run(before, '2024-05-31', '2024-05-31')).toEqual([
+      '2024-05-31',
+    ]);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    const c = { ...monthly, frequency: 'daily' };
+    expect(await run(c, '2024-06-07', '2024-06-11')).toEqual([
+      '2024-06-07',
+      '2024-06-10',
+      '2024-06-11',
+    ]);
+  });
+});
