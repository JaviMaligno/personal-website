+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const rule = {
+      skipWeekend: config.skipWeekend,
+      solveMode: config.weekendSolveMode,
+      frequency: config.frequency,
+    };
+    const skipsWeekend = skipsWeekendOccurrences(rule);
+
+    // Weekend adjustment moves an occurrence by at most two days either way
+    const from = d.subDays(parseDate(start), 2);
+    const lastRaw = dayFromDate(d.addDays(parseDate(end), 2));
+    const days = new Set<string>();
+
+    for (const occurrence of schedule.occurrences({
+      start: d.startOfDay(from),
+    })) {
+      if (dayFromDate(occurrence.date) > lastRaw) break;
+      if (skipsWeekend && d.isWeekend(occurrence.date)) continue;
+      const day = dayFromDate(applyWeekendRule(occurrence.date, rule));
+      if (day >= start && day <= end) days.add(day);
+    }
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
