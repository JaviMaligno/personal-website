+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+    // Weekend handling moves an occurrence by at most two days, so widen the
+    // search and decide membership by the adjusted day.
+    const days = new Set<string>();
+    schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.endOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray()
+      .forEach(occurrence => {
+        const date = applyWeekendRule(occurrence.date, {
+          skipWeekend: config.skipWeekend,
+          frequency: config.frequency,
+          solveMode: config.weekendSolveMode,
+        });
+        if (date == null) return;
+        const day = dayFromDate(date);
+        if (day >= start && day <= end) days.add(day);
+      });
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
