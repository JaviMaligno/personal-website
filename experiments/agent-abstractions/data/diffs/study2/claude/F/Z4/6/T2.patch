+  it('includes occurrences moved into the period and excludes moved out', async () => {
+    // 2024-06-01 is Saturday -> Fri 05-31; 2024-09-01 is Sunday -> Fri 08-30
+    const run = (start, end) =>
+      schedulesApp.handlers['schedule/get-dates-in-range']({
+        config: { ...base, start: '2024-06-01' },
+        start,
+        end,
+      });
+    expect(await run('2024-05-31', '2024-05-31')).toEqual(['2024-05-31']);
+    expect(await run('2024-06-01', '2024-06-30')).toEqual([]);
+  });
+
+  it('skips weekend days for daily schedules', async () => {
+    const result = await schedulesApp.handlers['schedule/get-dates-in-range']({
+      config: { ...base, frequency: 'daily', start: '2024-06-01' },
+      start: '2024-06-01',
+      end: '2024-06-04',
+    });
+    expect(result).toEqual(['2024-06-03', '2024-06-04']);
+  });
+});
