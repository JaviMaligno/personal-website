+    // 2024-06-01 is a Saturday -> moved to Monday 2024-06-03
+    expect(
+      await getDatesInRange({
+        config: { ...base, start: '2024-06-01' },
+        start: '2024-06-02',
+        end: '2024-06-30',
+      }),
+    ).toEqual(['2024-06-03']);
+    expect(
+      await getDatesInRange({
+        config: { ...base, start: '2024-06-01' },
+        start: '2024-05-01',
+        end: '2024-06-02',
+      }),
+    ).toEqual([]);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    expect(
+      await getDatesInRange({
+        config: { ...base, frequency: 'daily' },
+        start: '2024-06-07',
+        end: '2024-06-10',
+      }),
+    ).toEqual(['2024-06-07', '2024-06-10']);
+  });
