+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const rule = {
+      skipWeekend: config.skipWeekend,
+      solveMode: config.weekendSolveMode,
+      frequency: config.frequency,
+    };
+
+    // Weekend adjustment moves an occurrence by at most 2 days, so look a
+    // little beyond the period and decide by the adjusted day.
+    const from = d.subDays(parseDate(start), 3);
+    const to = d.endOfDay(d.addDays(parseDate(end), 3));
+
+    const days = new Set<string>();
+    for (const occurrence of schedule.occurrences({ start: from, end: to })) {
+      if (isSkippedByWeekendRule(occurrence.date, rule)) continue;
+      const day = dayFromDate(applyWeekendRule(occurrence.date, rule));
+      if (day >= start && day <= end) days.add(day);
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
