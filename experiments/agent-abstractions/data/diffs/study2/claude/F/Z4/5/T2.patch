+// A weekend occurrence moves at most two days (Sunday to the Friday before).
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    const weekendRule = {
+      skipWeekend: config.skipWeekend,
+      solveMode: config.weekendSolveMode,
+      frequency: config.frequency,
+    };
+    const dropWeekends = skipsWeekendOccurrences(weekendRule);
+
+    // Search a wider window, since the final day can differ from the
+    // occurrence date; membership is decided on the final day below.
+    const days = new Set<string>();
+    for (const occurrence of schedule.occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS)),
+      end: d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS)),
+    })) {
+      if (dropWeekends && d.isWeekend(occurrence.date)) {
+        continue;
+      }
+      const day = dayFromDate(applyWeekendRule(occurrence.date, weekendRule));
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
