+// Daily schedules drop weekend occurrences instead of moving them.
+export function skipsWeekendOccurrences(rule: {
+  skipWeekend?: boolean;
+  frequency?: string;
+}): boolean {
+  return !!rule.skipWeekend && rule.frequency === 'daily';
+}
