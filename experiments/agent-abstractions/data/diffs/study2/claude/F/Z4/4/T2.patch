+describe('schedule/get-dates-in-range', () => {
+  const run = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  const monthly = {
+    start: '2024-06-01',
+    frequency: 'monthly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: true,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('includes occurrences moved into the period and excludes ones moved out', async () => {
+    // 2024-06-01 is a Saturday -> Monday 06-03; 2024-06-30 Sunday -> 07-01
+    expect(await run(monthly, '2024-06-02', '2024-06-30')).toEqual([
+      '2024-06-03',
+    ]);
+    expect(await run(monthly, '2024-07-01', '2024-07-01')).toEqual([
+      '2024-07-01',
+    ]);
+    expect(
+      await run(
+        { ...monthly, start: '2024-06-30' },
+        '2024-06-01',
+        '2024-06-30',
+      ),
+    ).toEqual([]);
+  });
+
+  it('moves before and skips weekends for daily schedules', async () => {
+    expect(
+      await run(
+        { ...monthly, weekendSolveMode: 'before' },
+        '2024-05-31',
+        '2024-06-01',
+      ),
+    ).toEqual(['2024-05-31']);
+    expect(
+      await run(
+        { ...monthly, frequency: 'daily', start: '2024-06-03' },
+        '2024-06-07',
+        '2024-06-10',
+      ),
+    ).toEqual(['2024-06-07', '2024-06-10']);
+  });
+});
