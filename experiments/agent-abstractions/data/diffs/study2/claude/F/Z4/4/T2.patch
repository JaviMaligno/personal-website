+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const isDaily = config.frequency === 'daily';
+
+    // A weekend occurrence moves at most two days, so look slightly beyond
+    // the period and decide by the final day.
+    const from = d.startOfDay(d.subDays(parseDate(start), 2));
+    const to = d.endOfDay(d.addDays(parseDate(end), 2));
+
+    const days = new Set<string>();
+    for (const occurrence of schedule.occurrences({ start: from, end: to })) {
+      let date = occurrence.date;
+      if (config.skipWeekend) {
+        if (isDaily) {
+          if (d.isWeekend(date)) continue;
+        } else {
+          date = applyWeekendRule(date, {
+            skipWeekend: true,
+            solveMode: config.weekendSolveMode,
+          });
+        }
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) days.add(day);
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
