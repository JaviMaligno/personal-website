+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}) {
+  if (start > end) {
+    return [];
+  }
+
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+  // A weekend occurrence moves at most 2 days, so look a little wider than
+  // the period and decide membership by the final day.
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(monthUtils.parseDate(start), 3)),
+      end: d.endOfDay(d.addDays(monthUtils.parseDate(end), 3)),
+    })
+    .toArray();
+
+  const skipsWeekendDays = !!config.skipWeekend && config.frequency === 'daily';
+
+  const days = new Set<string>();
+  for (const occurrence of occurrences) {
+    if (skipsWeekendDays && d.isWeekend(occurrence.date)) {
+      continue;
+    }
+    const day = dayFromDate(
+      skipsWeekendDays
+        ? occurrence.date
+        : applyWeekendRule(occurrence.date, {
+            skipWeekend: config.skipWeekend,
+            solveMode: config.weekendSolveMode,
+          }),
+    );
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
