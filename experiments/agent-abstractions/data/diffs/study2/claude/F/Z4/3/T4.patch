+
+  it('treats MM-DD holidays as recurring every year', () => {
+    const holidays = ['01-08', '2024-01-12'];
+    const rule = { skipWeekend: true, solveMode: 'after' as const, holidays };
+    // Jan 8 is a holiday in every year
+    expect(
+      monthUtils.dayFromDate(applyWeekendRule(new Date(2024, 0, 8), rule)),
+    ).toBe('2024-01-09');
+    expect(
+      monthUtils.dayFromDate(applyWeekendRule(new Date(2025, 0, 8), rule)),
+    ).toBe('2025-01-09');
+    // A full date applies to that year only
+    expect(
+      monthUtils.dayFromDate(applyWeekendRule(new Date(2024, 0, 12), rule)),
+    ).toBe('2024-01-15');
+    expect(
+      monthUtils.dayFromDate(applyWeekendRule(new Date(2025, 0, 13), rule)),
+    ).toBe('2025-01-13');
+  });
 });
