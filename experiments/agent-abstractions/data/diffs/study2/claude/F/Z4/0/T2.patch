+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+  const skipDailyWeekends = config.skipWeekend && config.frequency === 'daily';
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    // A weekend occurrence moves by at most two days, so look slightly beyond
+    // the period and decide membership by the adjusted day.
+    const days = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 2)),
+        end: d.endOfDay(d.addDays(parseDate(end), 2)),
+      })
+      .toArray()
+      .filter(date => !skipDailyWeekends || !d.isWeekend(date.date))
+      .map(date =>
+        dayFromDate(
+          applyWeekendRule(date.date, {
+            skipWeekend: config.skipWeekend && !skipDailyWeekends,
+            solveMode: config.weekendSolveMode,
+          }),
+        ),
+      )
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
