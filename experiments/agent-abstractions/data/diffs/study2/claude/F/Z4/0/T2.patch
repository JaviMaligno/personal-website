+describe('schedule/get-dates-in-range', () => {
+  const run = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences by their final day', async () => {
+    // 2024-06-01 is a Saturday, 2024-06-02 a Sunday
+    const config = {
+      start: '2024-06-01',
+      frequency: 'monthly',
+      skipWeekend: true,
+      weekendSolveMode: 'before',
+    };
+    expect(await run(config, '2024-05-31', '2024-05-31')).toEqual([
+      '2024-05-31',
+    ]);
+    expect(await run(config, '2024-06-01', '2024-06-30')).toEqual([]);
+    const after = { ...config, weekendSolveMode: 'after' };
+    expect(await run(after, '2024-06-03', '2024-06-03')).toEqual([
+      '2024-06-03',
+    ]);
+    expect(await run(after, '2024-05-01', '2024-05-31')).toEqual([]);
+  });
+
+  it('skips daily weekends', async () => {
+    const config = {
+      start: '2024-06-03',
+      frequency: 'daily',
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await run(config, '2024-06-07', '2024-06-10')).toEqual([
+      '2024-06-07',
+      '2024-06-10',
+    ]);
+  });
+});
