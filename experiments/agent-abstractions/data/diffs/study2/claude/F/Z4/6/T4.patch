+    const holidays = ['12-25', '2026-07-01'];
+    // 2025-12-25 is a Thursday, 2027-07-01 is a Thursday
+    expect(isNonWorkingDay(new Date(2025, 11, 25), holidays)).toBe(true);
+    expect(isNonWorkingDay(new Date(2027, 11, 25), holidays)).toBe(true);
