+// Daily schedules skip weekend occurrences instead of moving them. An interval
+// that is a multiple of 7 can stay on a weekend forever, so only look a week
+// of occurrences ahead.
+const MAX_DAILY_WEEKEND_LOOKUP = 7;
+
+function isDailyRecurrence(schedule: {
+  data?: { frequency?: string };
+}): boolean {
+  return schedule.data?.frequency === 'daily';
+}
+
+function getNextDailyDateSkippingWeekends(
+  schedule: {
+    occurrences: (opts: object) => { toArray: () => Array<{ date: Date }> };
+  },
+  start: Date,
+): string | null {
+  const find = (reverse: boolean, from?: Date) =>
+    schedule
+      .occurrences({
+        ...(from ? { start: from } : {}),
+        reverse,
+        take: MAX_DAILY_WEEKEND_LOOKUP,
+      })
+      .toArray()
+      .find(o => !d.isWeekend(o.date));
+
+  let found = find(false, start);
+  if (!found) {
+    // Could be a schedule with limited occurrences, so we try to find the
+    // last one that isn't on a weekend
+    found = find(true);
+  }
+  return found ? monthUtils.dayFromDate(found.date) : null;
+}
