+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: Parameters<typeof recurConfigToRSchedule>[0];
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  try {
+    const schedule = new RSchedule({
+      rrules: recurConfigToRSchedule(config),
+    });
+    const rule = {
+      skipWeekend: config.skipWeekend,
+      solveMode: config.weekendSolveMode,
+      frequency: config.frequency,
+    };
+    const skipsWeekendDays = skipsWeekendOccurrences(rule);
+
+    // Weekend adjustment moves a day by at most 2, so look slightly wider.
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.endOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray();
+
+    const days = new Set<string>();
+    for (const occurrence of occurrences) {
+      if (skipsWeekendDays && d.isWeekend(occurrence.date)) {
+        continue;
+      }
+      const day = dayFromDate(applyWeekendRule(occurrence.date, rule));
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
