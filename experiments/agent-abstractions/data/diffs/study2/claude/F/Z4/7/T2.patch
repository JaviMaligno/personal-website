+describe('schedule/get-dates-in-range', () => {
+  const call = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences and judges the final day', async () => {
+    // 2024-06-01 is a Saturday; monthly on the 1st
+    const config = {
+      start: '2024-01-01',
+      frequency: 'monthly',
+      interval: 1,
+      patterns: [],
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+      endMode: 'never',
+    };
+    expect(await call(config, '2024-06-03', '2024-06-30')).toEqual([
+      '2024-06-03',
+    ]);
+    expect(await call(config, '2024-06-01', '2024-06-02')).toEqual([]);
+    expect(
+      await call(
+        { ...config, weekendSolveMode: 'before' },
+        '2024-05-31',
+        '2024-05-31',
+      ),
+    ).toEqual(['2024-05-31']);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    const config = {
+      start: '2024-01-01',
+      frequency: 'daily',
+      interval: 1,
+      patterns: [],
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+      endMode: 'never',
+    };
+    expect(await call(config, '2024-06-07', '2024-06-10')).toEqual([
+      '2024-06-07',
+      '2024-06-10',
+    ]);
+  });
+});
