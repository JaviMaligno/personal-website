+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getBulkBudgetCategories({
+    skipMissingGroup: true,
+  });
+  const sheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const activity = await getSheetValue(sheetName, 'sum-amount-' + cat.id);
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudget(cat, activity),
+      });
+    }
+  });
+}
