+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevSheet = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = await getBulkBudgetCategories({
+    skipMissingGroup: false,
+  });
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const activity =
+        (await getSheetValue(prevSheet, 'sum-amount-' + cat.id)) || 0;
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudget(cat, activity) || 0,
+      });
+    }
+  });
+}
