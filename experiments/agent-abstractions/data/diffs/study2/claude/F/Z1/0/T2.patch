+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevSheet = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = await getBulkBudgetCategories({
+    skipMissingGroup: true,
+  });
+
+  const amounts: { id: string; amount: number }[] = [];
+  for (const cat of categories) {
+    const activity = await getSheetValue(prevSheet, 'sum-amount-' + cat.id);
+    amounts.push({ id: cat.id, amount: averageToBudget(cat, activity) + 0 });
+  }
+
+  await batchMessages(async () => {
+    for (const { id, amount } of amounts) {
+      void setBudget({ category: id, month, amount: amount || 0 });
+    }
+  });
+}
