+const FIXED_TAG = /(^|\s)#fixed(?![\w-])/i;
+
+// Groups marked with `#fixed` in the group's own notes are left out of
+// month-wide budget actions.
+export function hasFixedTag(note: string | null | undefined): boolean {
+  return !!note && FIXED_TAG.test(note);
+}
+
+export async function getFixedGroupIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
