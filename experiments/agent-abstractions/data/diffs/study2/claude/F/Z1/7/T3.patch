+  SELECT g.id, n.note
+  FROM category_groups g
+  JOIN notes n ON n.id = g.id
+  WHERE g.tombstone = 0
+  `,
+  );
+  return new Set(rows.filter(r => hasFixedTag(r.note)).map(r => r.id));
+}
