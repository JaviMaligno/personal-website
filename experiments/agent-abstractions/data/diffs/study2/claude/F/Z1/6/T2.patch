+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getBulkBudgetCategories({
+    skipMissingGroup: false,
+  });
+  const { start, end } = monthUtils.bounds(monthUtils.prevMonth(month));
+  const rows = await db.all<{ category: string; amount: number | null }>(
+    `SELECT t.category, SUM(t.amount) AS amount
+       FROM v_transactions_internal_alive t
+       LEFT JOIN accounts a ON a.id = t.account
+      WHERE t.date >= ? AND t.date <= ? AND a.offbudget = 0
+        AND t.category IS NOT NULL
+      GROUP BY t.category`,
+    [start, end],
+  );
+  const totals = new Map(rows.map(row => [row.category, row.amount || 0]));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const total = totals.get(cat.id) ?? 0;
+      // Spending is negative; income keeps its sign.
+      const amount = cat.is_income === 1 ? total : -total;
+      void setBudget({ category: cat.id, month, amount });
+    }
+  });
+}
