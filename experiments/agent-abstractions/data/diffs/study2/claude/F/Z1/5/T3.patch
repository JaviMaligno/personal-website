+const FIXED_TAG = /(?<![\w#])#fixed(?![\w-])/i;
+
+export function hasFixedTag(note: string | null | undefined): boolean {
+  return !!note && FIXED_TAG.test(note);
+}
+
+// Ids of the category groups whose own notes carry the `#fixed` tag.
+export async function getFixedGroupIds(): Promise<Set<string>> {
+  const groups = await db.all<{ id: string; note: string | null }>(
+    `SELECT g.id, n.note FROM category_groups g
+     JOIN notes n ON n.id = g.id
+     WHERE g.tombstone = 0`,
+  );
+  return new Set(groups.filter(g => hasFixedTag(g.note)).map(g => g.id));
+}
