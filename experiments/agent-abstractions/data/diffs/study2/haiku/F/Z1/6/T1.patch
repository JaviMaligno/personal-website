+describe('setZero', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'group1', name: 'group1' });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      hidden: 1,
+    });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'hidden-group-cat',
+      name: 'hidden-group-cat',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'template-cat',
+      name: 'template-cat',
+      cat_group: 'group1',
+      goal_def: JSON.stringify([{ type: 'periodic', amount: 100 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+  }
+
+  it('zeroes visible categories and leaves hidden and template-managed categories untouched', async () => {
+    await setupDatabase();
+
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'hidden-group-cat',
+      'template-cat',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-hidden-cat')).toBe(500);
+    expect(await getSheetValue('budget202401', 'budget-hidden-group-cat')).toBe(
+      500,
+    );
+    expect(await getSheetValue('budget202401', 'budget-template-cat')).toBe(
+      500,
+    );
+  });
+});
