+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevMonthSheet = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = await getBulkBudgetCategories({
+    skipMissingGroup: true,
+  });
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const net = await getSheetValue(prevMonthSheet, 'sum-amount-' + cat.id);
+
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? net : Math.max(-net, 0),
+      });
+    }
+  });
+}
