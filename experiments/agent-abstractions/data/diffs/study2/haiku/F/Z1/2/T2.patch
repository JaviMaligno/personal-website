+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevMonth = monthUtils.prevMonth(month);
+  const categories = await getBulkBudgetCategories({ skipMissingGroup: false });
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const net = await getSheetValue(
+        monthUtils.sheetForMonth(prevMonth),
+        'sum-amount-' + cat.id,
+      );
+
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudget(cat, net),
+      });
+    }
+  });
+}
