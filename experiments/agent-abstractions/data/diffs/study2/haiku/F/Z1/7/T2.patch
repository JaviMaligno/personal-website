+describe('setLastMonthSpending', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'spender',
+      name: 'spender',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'no-spend',
+      name: 'no-spend',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'templated',
+      cat_group: 'group1',
+      goal_def: JSON.stringify([{ type: 'fixed', amount: 100, priority: 1 }]),
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-02', '2024-03']);
+
+    await db.insertTransaction({
+      date: '2024-02-10',
+      amount: -3000,
+      account: 'account1',
+      category: 'spender',
+    });
+    await db.insertTransaction({
+      date: '2024-02-12',
+      amount: 5000,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await db.insertTransaction({
+      date: '2024-03-10',
+      amount: -999,
+      account: 'account1',
+      category: 'spender',
+    });
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('budgets each expense category its net spending from the previous month', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'no-spend', month: '2024-03', amount: 500 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202403', 'budget-spender')).toBe(3000);
+    expect(await getSheetValue('budget202403', 'budget-no-spend')).toBe(0);
+  });
+
+  it('leaves hidden and templated categories unchanged', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'hidden-cat', month: '2024-03', amount: 700 });
+    await setBudget({ category: 'templated', month: '2024-03', amount: 800 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202403', 'budget-hidden-cat')).toBe(700);
+    expect(await getSheetValue('budget202403', 'budget-templated')).toBe(800);
+  });
+
+  it('leaves income categories alone in envelope budgets', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'income-cat', month: '2024-03', amount: 400 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'income-cat', month: '2024-03' })).toBe(400);
+  });
+
+  it('budgets income categories with the amount received in tracking budgets', async () => {
+    await setupDatabase();
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+
+    await setLastMonthSpending({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'income-cat', month: '2024-03' })).toBe(5000);
+    expect(await getSheetValue('budget202403', 'budget-spender')).toBe(3000);
+  });
+});
