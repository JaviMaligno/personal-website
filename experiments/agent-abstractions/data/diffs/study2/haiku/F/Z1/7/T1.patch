+describe('month-wide budget actions skip hidden and template categories', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'normal',
+      name: 'normal',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'in-hidden-group',
+      name: 'in-hidden-group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'templated',
+      cat_group: 'group1',
+      goal_def: JSON.stringify([{ type: 'fixed', amount: 100, priority: 1 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  it('setZero leaves hidden, hidden group and templated categories unchanged', async () => {
+    await setupDatabase();
+    for (const category of [
+      'normal',
+      'hidden-cat',
+      'in-hidden-group',
+      'templated',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 5000 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-normal')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(5000);
+    expect(await getSheetValue('budget202402', 'budget-in-hidden-group')).toBe(
+      5000,
+    );
+    expect(await getSheetValue('budget202402', 'budget-templated')).toBe(5000);
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden group and templated categories unchanged', async () => {
+    await setupDatabase();
+    for (const category of [
+      'normal',
+      'hidden-cat',
+      'in-hidden-group',
+      'templated',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 300 });
+    }
+    for (const category of [
+      'normal',
+      'hidden-cat',
+      'in-hidden-group',
+      'templated',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 900 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-normal')).toBe(300);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(900);
+    expect(await getSheetValue('budget202402', 'budget-in-hidden-group')).toBe(
+      900,
+    );
+    expect(await getSheetValue('budget202402', 'budget-templated')).toBe(900);
+  });
+});
