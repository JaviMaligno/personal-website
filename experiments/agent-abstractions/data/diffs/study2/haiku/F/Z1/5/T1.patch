+
+describe('bulk budget actions leave some categories alone', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  const template = JSON.stringify([
+    {
+      type: 'periodic',
+      amount: 100,
+      period: { period: 'month', amount: 1 },
+      starting: '2024-01',
+      priority: 1,
+      directive: 'template',
+    },
+  ]);
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'group1', name: 'group1' });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      hidden: 1,
+    });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'cat-hidden',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'cat-in-hidden-group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'cat-templated',
+      name: 'cat-templated',
+      cat_group: 'group1',
+      goal_def: template,
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+  }
+
+  it('setZero zeroes visible categories only', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat1',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-templated',
+    ]) {
+      await setBudget({ category, month: '2024-04', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden')).toBe(500);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-hidden-group'),
+    ).toBe(500);
+    expect(await getSheetValue('budget202404', 'budget-cat-templated')).toBe(
+      500,
+    );
+  });
+
+  it('copyPreviousMonth copies to visible categories only', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat1',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-templated',
+    ]) {
+      await setBudget({ category, month: '2024-03', amount: 1000 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(1000);
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden')).toBe(0);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-hidden-group'),
+    ).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-cat-templated')).toBe(0);
+  });
+});
