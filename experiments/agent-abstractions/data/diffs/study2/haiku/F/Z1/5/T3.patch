+describe('bulk budget actions leave #fixed groups alone', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'group1', name: 'group1' });
+    await db.insertCategoryGroup({
+      id: 'fixed-group',
+      name: 'fixed-group',
+    });
+    await db.insert('notes', { id: 'fixed-group', note: 'Rent #fixed' });
+    await db.insertCategoryGroup({
+      id: 'fixed-costs-group',
+      name: 'fixed-costs-group',
+    });
+    await db.insert('notes', {
+      id: 'fixed-costs-group',
+      note: '#fixed-costs',
+    });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'cat-in-fixed-group',
+      name: 'cat-in-fixed-group',
+      cat_group: 'fixed-group',
+    });
+    await db.insertCategory({
+      id: 'cat-in-fixed-costs-group',
+      name: 'cat-in-fixed-costs-group',
+      cat_group: 'fixed-costs-group',
+    });
+    await db.insertCategory({
+      id: 'cat-fixed-note',
+      name: 'cat-fixed-note',
+      cat_group: 'group1',
+    });
+    await db.insert('notes', { id: 'cat-fixed-note', note: '#fixed' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+  }
+
+  it('setZero leaves categories in #fixed groups alone', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat1',
+      'cat-in-fixed-group',
+      'cat-in-fixed-costs-group',
+      'cat-fixed-note',
+    ]) {
+      await setBudget({ category, month: '2024-04', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(0);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-fixed-group'),
+    ).toBe(500);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-fixed-costs-group'),
+    ).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-cat-fixed-note')).toBe(
+      0,
+    );
+  });
+
+  it('copyPreviousMonth leaves categories in #fixed groups alone', async () => {
+    await setupDatabase();
+    for (const category of ['cat1', 'cat-in-fixed-group']) {
+      await setBudget({ category, month: '2024-03', amount: 1000 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(1000);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-fixed-group'),
+    ).toBe(0);
+  });
+});
+
