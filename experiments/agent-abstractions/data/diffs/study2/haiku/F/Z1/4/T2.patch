+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(3000);
+  });
+
+  it('budgets a category with no spending in the previous month as zero', async () => {
+    await setupDatabase();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat-empty')).toBe(0);
