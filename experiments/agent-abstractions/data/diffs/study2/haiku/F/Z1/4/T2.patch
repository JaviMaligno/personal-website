+    });
+    await db.update('categories', {
+      id: 'cat-templated',
+      goal_def: JSON.stringify([
+        { type: 'simple', monthly: 100, directive: 'template', priority: 1 },
+      ]),
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+
+    for (const category of [
+      'cat1',
+      'cat-empty',
+      'cat-hidden',
+      'cat-templated',
+      'income-cat',
+    ]) {
+      await setBudget({ category, month: '2024-04', amount: 700 });
+    }
+
+    await db.insertTransaction({
