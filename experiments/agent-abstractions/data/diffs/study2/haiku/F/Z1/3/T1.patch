+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'normal',
+      name: 'normal',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'in-hidden-group',
+      name: 'in-hidden-group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'templated',
+      cat_group: 'group1',
+    });
+    await db.updateWithSchema('categories', {
+      id: 'templated',
+      goal_def: JSON.stringify([
+        {
+          type: 'simple',
+          monthly: 50,
+          directive: 'template',
+          priority: null,
+        },
+      ]),
+      template_settings: { source: 'ui' },
+    });
+    await db.insertCategory({
+      id: 'goal-only',
+      name: 'goal-only',
+      cat_group: 'group1',
+    });
+    await db.updateWithSchema('categories', {
+      id: 'goal-only',
+      goal_def: JSON.stringify([
+        { type: 'goal', amount: 100, directive: 'goal' },
+      ]),
+      template_settings: { source: 'ui' },
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  it('copyPreviousMonth skips hidden, hidden-group, and templated categories', async () => {
+    await setupDatabase();
+    for (const category of [
+      'normal',
+      'hidden-cat',
+      'in-hidden-group',
+      'templated',
+      'goal-only',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 500 });
+    }
+    await setBudget({ category: 'templated', month: '2024-02', amount: 7 });
+
+    await copyPreviousMonth({ month: '2024-02' });
+
+    expect(getBudget({ category: 'normal', month: '2024-02' })).toBe(500);
+    expect(getBudget({ category: 'goal-only', month: '2024-02' })).toBe(500);
+    expect(getBudget({ category: 'hidden-cat', month: '2024-02' })).toBe(0);
+    expect(getBudget({ category: 'in-hidden-group', month: '2024-02' })).toBe(
+      0,
+    );
+    expect(getBudget({ category: 'templated', month: '2024-02' })).toBe(7);
+  });
+
+  it('setZero leaves hidden, hidden-group, and templated categories untouched', async () => {
+    await setupDatabase();
+    for (const category of [
+      'normal',
+      'hidden-cat',
+      'in-hidden-group',
+      'templated',
+      'goal-only',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 300 });
+    }
+
+    await setZero({ month: '2024-02' });
+
+    expect(getBudget({ category: 'normal', month: '2024-02' })).toBe(0);
+    expect(getBudget({ category: 'goal-only', month: '2024-02' })).toBe(0);
+    expect(getBudget({ category: 'hidden-cat', month: '2024-02' })).toBe(300);
+    expect(getBudget({ category: 'in-hidden-group', month: '2024-02' })).toBe(
+      300,
+    );
+    expect(getBudget({ category: 'templated', month: '2024-02' })).toBe(300);
+  });
+});
