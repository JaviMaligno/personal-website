+describe('month-wide budget actions skip #fixed groups', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'group1', name: 'group1' });
+    await db.insertCategoryGroup({ id: 'fixed-group', name: 'fixed-group' });
+    await db.insertCategoryGroup({
+      id: 'fixed-word-group',
+      name: 'fixed-word-group',
+    });
+    await db.insertCategoryGroup({
+      id: 'cat-note-group',
+      name: 'cat-note-group',
+    });
+    await db.insert('notes', { id: 'fixed-group', note: 'Rent\n#fixed' });
+    await db.insert('notes', { id: 'fixed-word-group', note: '#fixedcost' });
+    await db.insert('notes', { id: 'cat-note-group', note: 'Groceries' });
+    await db.insertCategory({
+      id: 'normal',
+      name: 'normal',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'in-fixed-group',
+      name: 'in-fixed-group',
+      cat_group: 'fixed-group',
+    });
+    await db.insertCategory({
+      id: 'in-fixed-word-group',
+      name: 'in-fixed-word-group',
+      cat_group: 'fixed-word-group',
+    });
+    await db.insertCategory({
+      id: 'cat-tagged',
+      name: 'cat-tagged',
+      cat_group: 'cat-note-group',
+    });
+    await db.insert('notes', { id: 'cat-tagged', note: '#fixed' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  it('setZero leaves categories in #fixed groups unchanged', async () => {
+    await setupDatabase();
+    for (const category of [
+      'normal',
+      'in-fixed-group',
+      'in-fixed-word-group',
+      'cat-tagged',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 5000 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-normal')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-in-fixed-group')).toBe(
+      5000,
+    );
+    expect(
+      await getSheetValue('budget202402', 'budget-in-fixed-word-group'),
+    ).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-cat-tagged')).toBe(0);
+  });
+
+  it('copyPreviousMonth leaves categories in #fixed groups unchanged', async () => {
+    await setupDatabase();
+    for (const category of ['normal', 'in-fixed-group']) {
+      await setBudget({ category, month: '2024-01', amount: 300 });
+    }
+    for (const category of ['normal', 'in-fixed-group']) {
+      await setBudget({ category, month: '2024-02', amount: 900 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-normal')).toBe(300);
+    expect(await getSheetValue('budget202402', 'budget-in-fixed-group')).toBe(
+      900,
+    );
+  });
+});
