+describe('bulk budget actions skip #fixed groups', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'fixed-group',
+      name: 'fixed-group',
+      is_income: 0,
+    });
+    await db.update('notes', { id: 'fixed-group', note: 'Rent #fixed' });
+    await db.insertCategoryGroup({
+      id: 'fixed-like-group',
+      name: 'fixed-like-group',
+      is_income: 0,
+    });
+    await db.update('notes', {
+      id: 'fixed-like-group',
+      note: '#fixed-costs are not tagged',
+    });
+    await db.insertCategoryGroup({
+      id: 'plain-group',
+      name: 'plain-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'fixed-cat',
+      name: 'fixed-cat',
+      cat_group: 'fixed-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'fixed-like-cat',
+      name: 'fixed-like-cat',
+      cat_group: 'fixed-like-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'plain-cat',
+      name: 'plain-cat',
+      cat_group: 'plain-group',
+      is_income: 0,
+    });
+    await db.update('notes', { id: 'plain-cat', note: '#fixed' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    for (const category of ['fixed-cat', 'fixed-like-cat', 'plain-cat']) {
+      await setBudget({ category, month: '2024-01', amount: 500 });
+      await setBudget({ category, month: '2024-02', amount: 900 });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('copyPreviousMonth leaves categories in a #fixed group untouched', async () => {
+    await setupDatabase();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-fixed-cat')).toBe(900);
+    expect(await getSheetValue('budget202402', 'budget-fixed-like-cat')).toBe(
+      500,
+    );
+    expect(await getSheetValue('budget202402', 'budget-plain-cat')).toBe(500);
+  });
+
+  it('setZero leaves categories in a #fixed group untouched', async () => {
+    await setupDatabase();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-fixed-cat')).toBe(900);
+    expect(await getSheetValue('budget202402', 'budget-fixed-like-cat')).toBe(
+      0,
+    );
+    expect(await getSheetValue('budget202402', 'budget-plain-cat')).toBe(0);
+  });
+
+  it('set3MonthAvg leaves categories in a #fixed group untouched', async () => {
+    await setupDatabase();
+
+    await set3MonthAvg({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-fixed-cat')).toBe(900);
+    expect(await getSheetValue('budget202402', 'budget-fixed-like-cat')).toBe(
+      0,
+    );
+    expect(await getSheetValue('budget202402', 'budget-plain-cat')).toBe(0);
+  });
+});
+
