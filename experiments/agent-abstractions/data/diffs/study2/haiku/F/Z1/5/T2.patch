+describe('setLastMonthSpending', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'group1', name: 'group1' });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({ id: 'cat2', name: 'cat2', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'cat-hidden',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+  }
+
+  it('budgets each expense category its spending from the previous month', async () => {
+    await setupDatabase();
+    await db.insertTransaction({
+      date: '2024-03-10',
+      amount: -3000,
+      account: 'account1',
+      category: 'cat1',
+    });
+    await db.insertTransaction({
+      date: '2024-03-20',
+      amount: 1000,
+      account: 'account1',
+      category: 'cat1',
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(2000);
+  });
+
+  it('budgets a category that spent nothing last month as zero', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'cat2', month: '2024-04', amount: 500 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat2')).toBe(0);
+  });
+
+  it('leaves hidden categories untouched', async () => {
+    await setupDatabase();
+    await db.insertTransaction({
+      date: '2024-03-10',
+      amount: -3000,
+      account: 'account1',
+      category: 'cat-hidden',
+    });
+    await setBudget({ category: 'cat-hidden', month: '2024-04', amount: 500 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden')).toBe(500);
+  });
+
+  it('ignores income categories in envelope budgets', async () => {
+    await setupDatabase();
+    await db.insertTransaction({
+      date: '2024-03-10',
+      amount: 5000,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await setBudget({ category: 'income-cat', month: '2024-04', amount: 700 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(700);
+  });
+
+  it('budgets income categories the amount received in tracking budgets', async () => {
+    await setupDatabase();
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+    await db.insertTransaction({
+      date: '2024-03-10',
+      amount: 5000,
+      account: 'account1',
