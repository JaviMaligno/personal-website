+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevSheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = await getBulkBudgetCategories({ skipMissingGroup: false });
+
+  const amounts: { category: BulkBudgetCategory; amount: number }[] = [];
+  for (const cat of categories) {
+    const activity = await getSheetValue(prevSheetName, 'sum-amount-' + cat.id);
+    amounts.push({ category: cat, amount: averageToBudget(cat, activity) });
+  }
+
+  await batchMessages(async () => {
+    for (const { category, amount } of amounts) {
+      void setBudget({ category: category.id, month, amount });
+    }
+  });
+}
