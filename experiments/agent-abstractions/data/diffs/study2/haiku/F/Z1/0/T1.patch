+describe('bulk budget actions skip hidden and templated categories', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+
+    await db.insertCategory({
+      id: 'normal',
+      name: 'normal',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'in-hidden-group',
+      name: 'in-hidden-group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'templated',
+      cat_group: 'group1',
+      goal_def: JSON.stringify([{ type: 'fixed', amount: 100 }]),
+    });
+    await db.insertCategory({
+      id: 'income',
+      name: 'income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    for (const category of [
+      'normal',
+      'hidden-cat',
+      'in-hidden-group',
+      'templated',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 500 });
+      await setBudget({ category, month: '2024-02', amount: 42 });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('copyPreviousMonth only overwrites categories that are not hidden or templated', async () => {
+    await setupDatabase();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-normal')).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(42);
+    expect(await getSheetValue('budget202402', 'budget-in-hidden-group')).toBe(
+      42,
+    );
+    expect(await getSheetValue('budget202402', 'budget-templated')).toBe(42);
+  });
+
+  it('setZero only zeroes categories that are not hidden or templated', async () => {
+    await setupDatabase();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-normal')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(42);
+    expect(await getSheetValue('budget202402', 'budget-in-hidden-group')).toBe(
+      42,
+    );
+    expect(await getSheetValue('budget202402', 'budget-templated')).toBe(42);
+  });
+});
