+      JSON.stringify([
+        { type: 'simple', monthly: 500, directive: 'template', priority: 1 },
+      ]),
+      'cat-templated',
+    ]);
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  async function setBudgets(month: string, amount: number) {
+    for (const category of [
+      'cat-open',
+      'cat-templated',
+      'cat-hidden',
+      'cat-in-hidden-group',
+    ]) {
+      await setBudget({ category, month, amount });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('setZero leaves templated, hidden and hidden-group categories unchanged', async () => {
+    await setupDatabase();
+    await setBudgets('2024-02', 200);
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat-open')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-cat-templated')).toBe(
+      200,
+    );
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(200);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(200);
+  });
+
+  it('copyPreviousMonth leaves templated, hidden and hidden-group categories unchanged', async () => {
+    await setupDatabase();
+    await setBudgets('2024-01', 100);
+    await setBudgets('2024-02', 300);
+
+    await copyPreviousMonth({ month: '2024-02' });
