+    );
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(300);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(300);
+  });
+
+  it('set3MonthAvg leaves templated, hidden and hidden-group categories unchanged', async () => {
+    await setupDatabase();
+    await db.insertTransaction({
+      date: '2024-01-15',
+      amount: -300,
+      account: 'account1',
+      category: 'cat-open',
+    });
+    await db.insertTransaction({
+      date: '2024-01-15',
+      amount: -300,
+      account: 'account1',
+      category: 'cat-templated',
+    });
+    await setBudgets('2024-02', 999);
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat-open')).toBe(300);
+    expect(await getSheetValue('budget202402', 'budget-cat-templated')).toBe(
+      999,
+    );
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(999);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(999);
+  });
+});
