@@ -257,11 +257,13 @@ async function getBulkBudgetCategories({
 
 // An average of past activity becomes a budgeted amount: spending is negative,
 // so the sign is inverted for expense categories; income keeps its sign.
+// Subtracting from 0 rather than multiplying by -1 keeps a zero activity from
+// becoming -0.
 function averageToBudget(
   category: Pick<db.DbCategory, 'is_income'>,
   average: number,
 ): number {
-  return category.is_income === 0 ? average * -1 : average;
+  return category.is_income === 0 ? 0 - average : average;
 }
 
 // Actions
@@ -321,6 +323,27 @@ export async function setZero({ month }: { month: string }): Promise<void> {
   });
 }
 
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getBulkBudgetCategories({ skipMissingGroup: true });
+  const sheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const activity = await getSheetValue(sheetName, 'sum-amount-' + cat.id);
+
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudget(cat, activity),
+      });
+    }
+  });
+}
