+
+describe('setLastMonthSpending', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'spent',
+      name: 'spent',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'unspent',
+      name: 'unspent',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+
+    await db.insertTransaction({
+      date: '2024-03-10',
+      amount: -3000,
+      account: 'account1',
+      category: 'spent',
+    });
+    await db.insertTransaction({
+      date: '2024-03-12',
+      amount: 500,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await db.insertTransaction({
+      date: '2024-03-15',
+      amount: -700,
+      account: 'account1',
+      category: 'hidden-cat',
+    });
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('budgets each expense category its previous month spending', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'unspent', month: '2024-04', amount: 400 });
+
+    await setLastMonthSpending({ month: '2024-04' });
+
+    expect(getBudget({ category: 'spent', month: '2024-04' })).toBe(3000);
+    expect(getBudget({ category: 'unspent', month: '2024-04' })).toBe(0);
+  });
+
+  it('leaves income and hidden categories untouched in envelope budgets', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'income-cat', month: '2024-04', amount: 80 });
+    await setBudget({ category: 'hidden-cat', month: '2024-04', amount: 90 });
+
+    await setLastMonthSpending({ month: '2024-04' });
+
+    expect(getBudget({ category: 'income-cat', month: '2024-04' })).toBe(80);
+    expect(getBudget({ category: 'hidden-cat', month: '2024-04' })).toBe(90);
+  });
+});
