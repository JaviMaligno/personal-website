+
+describe('linking a Fintegra account', () => {
+  const fintegraAccountLink = app.handlers['fintegra-accounts-link'];
+  const externalAccount = {
+    balance: 100,
+    account_id: 'fin-1',
+    name: 'Everyday',
+    institution: 'Bank',
+    orgId: 'org-1',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a Fintegra-synced account named after the external account and imports it', async () => {
+    const result = await fintegraAccountLink({
+      externalAccount,
+      offBudget: false,
+      startingDate: '2024-01-01',
+      startingBalance: 0,
+    });
+
+    expect(result).toBe('ok');
+    const acct = await db.first<{
+      name: string;
+      official_name: string;
+      account_id: string;
+      account_sync_source: string;
+    }>(
+      'SELECT name, official_name, account_id, account_sync_source FROM accounts WHERE account_id = ?',
+      ['fin-1'],
+    );
+    expect(acct).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      expect.any(String),
+      'fin-1',
+      expect.any(String),
+      '2024-01-01',
+      0,
+      undefined,
+    );
+  });
+
+  it('refuses to link a Fintegra account already linked to another account', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Everyday',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      fintegraAccountLink({ externalAccount, startingDate: '2024-01-01' }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('groups accounts into one bank per organisation and institution', async () => {
+    await fintegraAccountLink({ externalAccount, startingDate: '2024-01-01' });
+    await fintegraAccountLink({
+      externalAccount: { ...externalAccount, account_id: 'fin-2' },
+      startingDate: '2024-01-01',
+    });
+    await fintegraAccountLink({
+      externalAccount: {
+        ...externalAccount,
+        account_id: 'fin-3',
+        orgId: 'org-2',
+      },
+      startingDate: '2024-01-01',
+    });
+
+    const rows = await db.all<{ bank: string; account_id: string }>(
+      'SELECT bank, account_id FROM accounts WHERE account_sync_source = ? ORDER BY account_id',
+      ['fintegra'],
+    );
+    const bankOf = Object.fromEntries(rows.map(r => [r.account_id, r.bank]));
+    expect(bankOf['fin-1']).toBe(bankOf['fin-2']);
+    expect(bankOf['fin-3']).not.toBe(bankOf['fin-1']);
+    expect(await countRowsOf('banks')).toBe(2);
+  });
+
+  async function countRowsOf(table: string) {
+    const row = await db.first<{ count: number }>(
+      `SELECT COUNT(*) AS count FROM ${table}`,
+    );
+    return row.count;
+  }
+});
