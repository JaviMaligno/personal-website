+      },
+      startingDate: '2017-10-01',
+    });
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_sync_source = ?',
+      ['fintegra'],
+    );
+    expect(account).toMatchObject({
+      account_id: 'fin-acct-1',
+      name: 'Checking',
+      official_name: 'Checking',
+    });
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account.bank,
+    ]);
+    expect(bank).toMatchObject({ bank_id: 'org-1', name: 'Fintegra Bank' });
+
+    const amounts = (await getAllTransactions())
+      .filter(t => t.account === account.id)
+      .map(t => t.amount)
+      .sort((a, b) => a - b);
+    expect(amounts).toEqual([-1234, 11234]);
+  });
+
+  test('refuses to link a Fintegra account that another local account already holds', async () => {
+    await db.insertAccount({
+      name: 'Existing',
+      account_id: 'fin-acct-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
