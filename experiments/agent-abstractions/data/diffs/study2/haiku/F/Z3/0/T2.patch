+      'user-key': 'key-1',
+    });
+    handlers['/fintegra/transactions'] = () => transactionsResponse;
+  });
+
+  afterEach(() => {
+    delete handlers['/fintegra/transactions'];
+  });
+
+  test('links a new account under its organisation bank and imports its transactions', async () => {
+    await accountsApp.handlers['fintegra-accounts-link']({
+      externalAccount: {
+        account_id: 'fin-acct-1',
+        name: 'Checking',
+        institution: 'Fintegra Bank',
+        orgId: 'org-1',
