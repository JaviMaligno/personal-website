+describe('linking a bank account that is already linked', () => {
+  const simpleFinAccountsLinkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'sfin-acct-1',
+    name: 'Checking',
+    balance: 0,
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    orgId: 'org-1',
+  };
+
+  async function countRows(table: string) {
+    const row = await db.first<{ n: number }>(
+      `SELECT COUNT(*) AS n FROM ${table}`,
+      [],
+    );
+    return row.n;
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses a new account when the bank account is already linked', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'sfin-acct-1' },
+    ]);
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+    const banksBefore = await countRows('banks');
+
+    await expect(
+      simpleFinAccountsLinkHandler({ externalAccount }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(await countRows('banks')).toBe(banksBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses upgrading another account to a bank account already linked elsewhere', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'sfin-acct-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      simpleFinAccountsLinkHandler({ externalAccount, upgradingId: 'acct2' }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const acct2 = await db.first<{ account_id: string | null }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(acct2.account_id).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link is on a closed account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'sfin-acct-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      simpleFinAccountsLinkHandler({ externalAccount }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'sfin-acct-1' },
+    ]);
+
+    await expect(
+      simpleFinAccountsLinkHandler({ externalAccount, upgradingId: 'acct1' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows linking when the existing link was deleted', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'sfin-acct-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      simpleFinAccountsLinkHandler({ externalAccount }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows linking the same account id held by a different provider', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      account_id: 'sfin-acct-1',
+      account_sync_source: 'pluggyai',
+    });
+
+    await expect(
+      simpleFinAccountsLinkHandler({ externalAccount }),
+    ).resolves.toBe('ok');
+  });
+});
+
