diff --git a/packages/loot-core/src/server/accounts/link.test.ts b/packages/loot-core/src/server/accounts/link.test.ts
index 4d5667b..0cc8528 100644
--- a/packages/loot-core/src/server/accounts/link.test.ts
+++ b/packages/loot-core/src/server/accounts/link.test.ts
@@ -1,13 +1,104 @@
 import * as db from '#server/db';
 import { loadMappings } from '#server/db/mappings';
 
-import { findOrCreateBank } from './link';
+import { assertBankAccountNotLinked, findOrCreateBank } from './link';
 
 beforeEach(async () => {
   await global.emptyDatabase()();
   await loadMappings();
 });
 
+describe('assertBankAccountNotLinked', () => {
+  const linkedMessage =
+    'This bank account is already linked to another account.';
+
+  async function insertLinkedAccount(
+    overrides: Partial<db.DbAccount> = {},
+  ): Promise<string> {
+    return db.insertAccount({
+      name: 'Checking',
+      offbudget: 0,
+      closed: 0,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      ...overrides,
+    });
+  }
+
+  it('refuses a bank account that is already linked to another account', async () => {
+    await insertLinkedAccount();
+
+    await expect(
+      assertBankAccountNotLinked({
+        syncSource: 'simpleFin',
+        accountId: 'ext-1',
+      }),
+    ).rejects.toThrow(linkedMessage);
+  });
+
+  it('refuses when the existing link belongs to a closed account', async () => {
+    await insertLinkedAccount({ closed: 1 });
+
+    await expect(
+      assertBankAccountNotLinked({
+        syncSource: 'simpleFin',
+        accountId: 'ext-1',
+      }),
+    ).rejects.toThrow(linkedMessage);
+  });
+
+  it('allows a bank account whose previous link was deleted', async () => {
+    await insertLinkedAccount({ tombstone: 1 });
+
+    await expect(
+      assertBankAccountNotLinked({
+        syncSource: 'simpleFin',
+        accountId: 'ext-1',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('allows the same provider account id under a different provider', async () => {
+    await insertLinkedAccount();
+
+    await expect(
+      assertBankAccountNotLinked({
+        syncSource: 'akahu',
+        accountId: 'ext-1',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('allows re-linking the account that already holds the bank account', async () => {
+    const id = await insertLinkedAccount();
+
+    await expect(
+      assertBankAccountNotLinked({
+        syncSource: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: id,
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('refuses linking into a different account while another holds the bank account', async () => {
+    await insertLinkedAccount();
+    const other = await db.insertAccount({
+      name: 'Savings',
+      offbudget: 0,
+      closed: 0,
+    });
+
+    await expect(
+      assertBankAccountNotLinked({
+        syncSource: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: other,
+      }),
+    ).rejects.toThrow(linkedMessage);
+  });
+});
+
