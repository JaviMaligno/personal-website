@@ -441,3 +441,90 @@ describe('simplefin-accounts-link', () => {
     expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
   });
 });
+
+describe('fintegra-accounts-link', () => {
+  const linkFintegra = app.handlers['fintegra-accounts-link'];
+  const externalAccount = {
+    account_id: 'fin-acct-1',
+    name: 'Everyday',
+    balance: 100,
+    institution: 'Bank',
+    orgId: 'org-1',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates an account named after the Fintegra account and syncs it', async () => {
+    await expect(linkFintegra({ externalAccount })).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['fin-acct-1'],
+    );
+    expect(account).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      account_sync_source: 'fintegra',
+      offbudget: 0,
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('creates an off-budget account when requested', async () => {
+    await linkFintegra({ externalAccount, offBudget: true });
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['fin-acct-1'],
+    );
+    expect(account!.offbudget).toBe(1);
+  });
+
+  it('groups accounts into one bank per organisation and institution', async () => {
+    await linkFintegra({ externalAccount });
+    await linkFintegra({
+      externalAccount: { ...externalAccount, account_id: 'fin-acct-2' },
+    });
+
+    const banks = await db.all<db.DbBank>('SELECT * FROM banks');
+    expect(banks).toHaveLength(1);
+    expect(banks[0]).toMatchObject({ bank_id: 'org-1', name: 'Bank' });
+  });
+
+  it('upgrades an existing local account into a Fintegra account', async () => {
+    await db.insertAccount({ id: 'local', name: 'Local' });
+
+    await expect(
+      linkFintegra({ externalAccount, upgradingId: 'local' }),
+    ).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['local'],
+    );
+    expect(account).toMatchObject({
+      account_id: 'fin-acct-1',
+      account_sync_source: 'fintegra',
+    });
+  });
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Existing',
+      account_id: 'fin-acct-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(linkFintegra({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
