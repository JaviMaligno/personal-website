@@ -439,3 +439,69 @@ describe('simplefin-accounts-link', () => {
     expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
   });
 });
+
+describe('fintegra-accounts-link', () => {
+  const fintegraLinkHandler = app.handlers['fintegra-accounts-link'];
+  const externalAccount = {
+    balance: 0,
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'Bank',
+    orgId: 'org-1',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a bank-synced account named after the Fintegra account', async () => {
+    await expect(fintegraLinkHandler({ externalAccount })).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['ext-1'],
+    );
+    expect(account!.name).toBe('Checking');
+    expect(account!.official_name).toBe('Checking');
+    expect(account!.account_sync_source).toBe('fintegra');
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account!.bank,
+    ]);
+    expect(bank!.bank_id).toBe('org-1');
+    expect(bank!.name).toBe('Bank');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('groups accounts from the same organisation under one bank', async () => {
+    await fintegraLinkHandler({ externalAccount });
+    await fintegraLinkHandler({
+      externalAccount: {
+        ...externalAccount,
+        account_id: 'ext-2',
+        name: 'Savings',
+      },
+    });
+
+    const banks = await db.all<db.DbBank>('SELECT id FROM banks');
+    expect(banks).toHaveLength(1);
+  });
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(fintegraLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
