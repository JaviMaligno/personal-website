     expect(result.errors).toEqual([]);
   });
 });
+
+describe('linking a bank account', () => {
+  const simpleFinAccountLink = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    balance: 0,
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'Bank',
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+  };
+
+  function linkWith(extra: { upgradingId?: string } = {}) {
+    return simpleFinAccountLink({
+      externalAccount,
+      upgradingId: extra.upgradingId,
+      offBudget: false,
+      startingDate: '2024-01-01',
+    });
+  }
+
+  async function countRows(table: string) {
+    const row = await db.first<{ count: number }>(
+      `SELECT COUNT(*) AS count FROM ${table}`,
+    );
+    return row.count;
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+
+    await expect(linkWith()).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into a different existing account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Other' });
+
+    await expect(linkWith({ upgradingId: 'acct2' })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const acct2 = await db.first<{ account_id: string | null }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(acct2.account_id).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link belongs to a closed account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', closed: 1 });
+
+    await expect(linkWith()).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the existing link belongs to a deleted account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', tombstone: 1 });
+
+    await expect(linkWith()).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(linkWith({ upgradingId: 'acct1' })).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('treats the same account id under a different provider as a different bank account', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(linkWith()).resolves.toBe('ok');
+  });
+});
