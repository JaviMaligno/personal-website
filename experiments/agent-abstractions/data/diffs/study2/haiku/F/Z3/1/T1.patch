+describe('linking a bank account', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+
+  const externalAccount = {
+    balance: 0,
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'Bank',
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    } as never);
+  });
+
+  async function seedLinkedAccount(
+    id: string,
+    overrides: Record<string, unknown> = {},
+  ) {
+    await db.insertAccount({
+      id,
+      name: id,
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      offbudget: 0,
+      closed: 0,
+      tombstone: 0,
+      ...overrides,
+    });
+  }
+
+  async function accountCount() {
+    const row = await db.first<{ count: number }>(
+      'SELECT COUNT(*) AS count FROM accounts',
+    );
+    return row?.count ?? 0;
+  }
+
+  it('refuses to link a bank account that is already linked as a new account', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Bank' });
+    await seedLinkedAccount('acct1');
+    const banksBefore = await db.first<{ count: number }>(
+      'SELECT COUNT(*) AS count FROM banks',
+    );
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await accountCount()).toBe(1);
+    expect(
+      (await db.first<{ count: number }>('SELECT COUNT(*) AS count FROM banks'))
+        ?.count,
+    ).toBe(banksBefore?.count);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link a bank account into a different existing account', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Bank' });
+    await seedLinkedAccount('acct1');
+    await db.insertAccount({
+      id: 'acct2',
+      name: 'Savings',
+      account_sync_source: null,
+      account_id: null,
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'acct2' }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const acct2 = await db.first<{
+      account_id: string | null;
+      account_sync_source: string | null;
+    }>('SELECT account_id, account_sync_source FROM accounts WHERE id = ?', [
+      'acct2',
+    ]);
+    expect(acct2).toEqual({ account_id: null, account_sync_source: null });
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link is on a closed account', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Bank' });
+    await seedLinkedAccount('acct1', { closed: 1 });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the existing link belongs to a deleted account', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Bank' });
+    await seedLinkedAccount('acct1', { tombstone: 1 });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Bank' });
+    await seedLinkedAccount('acct1', { account_sync_source: 'pluggyai' });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the link', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Bank' });
+    await seedLinkedAccount('acct1');
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'acct1' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
+
