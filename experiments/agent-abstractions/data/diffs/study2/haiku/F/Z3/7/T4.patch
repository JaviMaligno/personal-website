+
+describe('replacing an existing link', () => {
+  it('links a new account and unlinks the account that held the bank account', async () => {
+    await insertLinkedAccount({
+      id: 'holder',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    const holder = await getAccountRow('holder');
+    expect(holder).toMatchObject({
+      tombstone: 0,
+      closed: 0,
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+    });
+
+    const linked = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0 AND id != ?',
+      ['ext-1', 'holder'],
+    );
+    expect(linked).toMatchObject({
+      account_sync_source: 'simpleFin',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('keeps the unlinked account closed when it was closed', async () => {
+    await insertLinkedAccount({ id: 'holder', closed: true });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    expect(await getAccountRow('holder')).toMatchObject({
+      closed: 1,
+      account_id: null,
+      account_sync_source: null,
+    });
+  });
+
+  it('moves the link into the chosen existing account', async () => {
+    await insertLinkedAccount({ id: 'holder' });
+    await db.insertAccount({ id: 'target', name: 'Target' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount,
+        upgradingId: 'target',
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(await getAccountRow('target')).toMatchObject({
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    expect(await getAccountRow('holder')).toMatchObject({
+      account_id: null,
+      account_sync_source: null,
+    });
+  });
+
+  it('links normally when no other account holds the bank account', async () => {
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('still refuses to link into a closed account', async () => {
+    await insertLinkedAccount({ id: 'holder' });
+    await db.insertAccount({ id: 'closed', name: 'Closed', closed: 1 });
+    const holderBefore = await getAccountRow('holder');
+    const closedBefore = await getAccountRow('closed');
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount,
+        upgradingId: 'closed',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await getAccountRow('holder')).toEqual(holderBefore);
+    expect(await getAccountRow('closed')).toEqual(closedBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
