+// @ts-strict-ignore
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+const goCardlessLinkHandler = app.handlers['gocardless-accounts-link'];
+
+const ALREADY_LINKED_ERROR =
+  'This bank account is already linked to another account.';
+
+const externalAccount = {
+  account_id: 'ext-1',
+  name: 'Checking',
+  institution: 'SimpleFin Bank',
+  orgId: 'org-1',
+  orgDomain: 'bank.example',
+  balance: 0,
+};
+
+async function insertLinkedAccount(
+  overrides: Partial<{
+    id: string;
+    account_id: string;
+    account_sync_source: 'simpleFin' | 'goCardless';
+    closed: boolean;
+    tombstone: boolean;
+  }> = {},
+) {
+  const id = overrides.id ?? 'linked';
+  await db.insertAccount({
+    id,
+    name: 'Linked',
+    account_id: overrides.account_id ?? 'ext-1',
+    account_sync_source: overrides.account_sync_source ?? 'simpleFin',
+    closed: overrides.closed ? 1 : 0,
+  });
+  if (overrides.tombstone) {
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', [id]);
+  }
+  return id;
+}
+
+async function getAccountRow(id: string) {
+  return db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [id]);
+}
+
+async function countRows(table: 'accounts' | 'banks' | 'payees') {
+  const row = await db.first<{ count: number }>(
+    `SELECT count(*) as count FROM ${table} WHERE tombstone = 0`,
+  );
+  return row.count;
+}
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(bankSync.syncAccount).mockResolvedValue({
+    added: [],
+    updated: [],
+    updatedPreview: [],
+  });
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+describe('linking a bank account that is already linked', () => {
+  it('refuses to create a second local account for the same bank account', async () => {
+    await insertLinkedAccount();
+    const accountsBefore = await countRows('accounts');
+    const banksBefore = await countRows('banks');
+    const payeesBefore = await countRows('payees');
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      ALREADY_LINKED_ERROR,
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('banks')).toBe(banksBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another existing account and leaves it untouched', async () => {
+    await insertLinkedAccount();
+    await db.insertAccount({ id: 'target', name: 'Target' });
+    const before = await getAccountRow('target');
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'target' }),
+    ).rejects.toThrow(ALREADY_LINKED_ERROR);
+
+    expect(await getAccountRow('target')).toEqual(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link belongs to a closed account', async () => {
+    await insertLinkedAccount({ closed: true });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      ALREADY_LINKED_ERROR,
+    );
+  });
+});
+
+describe('linking a bank account that is not already linked', () => {
+  it('allows re-linking into the account that already holds the link', async () => {
+    await insertLinkedAccount({ id: 'holder' });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'holder' }),
+    ).resolves.toBe('ok');
+
+    expect((await getAccountRow('holder')).account_id).toBe('ext-1');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('allows linking when the existing link is on a deleted account', async () => {
+    await insertLinkedAccount({ tombstone: true });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows the same provider account id under a different provider', async () => {
+    await insertLinkedAccount({ account_sync_source: 'goCardless' });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows a GoCardless link when the same account id is held under SimpleFIN', async () => {
+    await insertLinkedAccount({ account_sync_source: 'simpleFin' });
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-1',
+        account: {
+          account_id: 'ext-1',
+          name: 'Checking',
+          institution: { name: 'GoCardless Bank' },
+          mask: '1234',
+          official_name: 'Checking',
+          balance: 0,
+        },
+      }),
+    ).resolves.toBe('ok');
+  });
+});
