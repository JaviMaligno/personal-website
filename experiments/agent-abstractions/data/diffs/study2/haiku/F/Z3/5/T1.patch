     expect(result.errors).toEqual([]);
   });
 });
+
+describe('simplefin-accounts-link', () => {
+  const linkSimpleFin = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'sfin-acct-1',
+    name: 'Checking',
+    balance: 100,
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    orgId: 'org-1',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  async function insertLinkedAccount(
+    fields: Partial<{
+      id: string;
+      account_id: string;
+      account_sync_source: 'simpleFin' | 'goCardless';
+      tombstone: 0 | 1;
+      closed: 0 | 1;
+    }> = {},
+  ) {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Existing',
+      account_id: 'sfin-acct-1',
+      account_sync_source: 'simpleFin',
+      ...fields,
+    });
+  }
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    await insertLinkedAccount();
+    const accountsBefore = await db.all('SELECT id FROM accounts');
+    const payeesBefore = await db.all('SELECT id FROM payees');
+    const banksBefore = await db.all('SELECT id FROM banks');
+
+    await expect(linkSimpleFin({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await db.all('SELECT id FROM accounts')).toEqual(accountsBefore);
+    expect(await db.all('SELECT id FROM payees')).toEqual(payeesBefore);
+    expect(await db.all('SELECT id FROM banks')).toEqual(banksBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to move a bank account into another existing account', async () => {
+    await insertLinkedAccount();
+    await db.insertAccount({ id: 'other', name: 'Other' });
+
+    await expect(
+      linkSimpleFin({ externalAccount, upgradingId: 'other' }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const other = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['other'],
+    );
+    expect(other!.account_id).toBeNull();
+    expect(other!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('still refuses when the holder is closed', async () => {
+    await insertLinkedAccount({ closed: 1 });
+
+    await expect(linkSimpleFin({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the holder is deleted', async () => {
+    await insertLinkedAccount({ tombstone: 1 });
+
+    await expect(linkSimpleFin({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows linking when the same account id belongs to another provider', async () => {
+    await insertLinkedAccount({ account_sync_source: 'goCardless' });
+
+    await expect(linkSimpleFin({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await insertLinkedAccount();
+
+    await expect(
+      linkSimpleFin({ externalAccount, upgradingId: 'holder' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
