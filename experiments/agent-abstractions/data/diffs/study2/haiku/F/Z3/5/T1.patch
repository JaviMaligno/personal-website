+// Two local accounts linked to the same bank account would both import every
+// transaction from that feed, so refuse unless the holder is the account being
+// re-linked.
+async function assertBankAccountNotLinked({
+  syncSource,
+  accountId,
+  upgradingId,
+}: {
+  syncSource: AccountSyncSource;
+  accountId: string;
+  upgradingId?: AccountEntity['id'];
+}) {
+  const holder = await db.first<Pick<db.DbAccount, 'id'>>(
+    'SELECT id FROM accounts WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ? AND id != ?',
+    [syncSource, accountId, upgradingId ?? ''],
+  );
+
+  if (holder) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
