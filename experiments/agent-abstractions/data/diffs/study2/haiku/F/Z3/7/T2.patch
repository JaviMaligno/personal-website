+    vi.mocked(asyncStorage.getItem).mockResolvedValue('test-token');
+    vi.mocked(asyncStorage.multiGet).mockResolvedValue({
+      'user-id': 'user-1',
+      'user-key': 'key-1',
+    });
+    handlers['/fintegra/transactions'] = () => ({
+      transactions: {
+        all: [
+          {
+            booked: true,
+            date: '2017-10-02',
+            payeeName: 'Coffee Shop',
+            transactionAmount: { amount: '-12.34' },
+            transactionId: 'fintegra-tx-1',
+          },
+        ],
+        booked: [],
+        pending: [],
+      },
+      balances: [],
+      startingBalance: -1234,
+    });
+
+    db.runQuery(
+      'INSERT INTO banks (id, bank_id, name, tombstone) VALUES (?, ?, ?, 0)',
+      ['bank-fg-1', 'fg-org-1', 'Fintegra Bank'],
+    );
+
+    const acctId = await db.insertAccount({
+      id: 'acct-fg-1',
+      account_id: 'fg-1',
+      name: 'Fintegra Everyday',
+      bank: 'bank-fg-1',
+      account_sync_source: 'fintegra',
+    });
+    await db.insertPayee({
+      id: 'transfer-' + acctId,
+      name: '',
+      transfer_acct: acctId,
+    });
+
+    const result = await accountsApp.handlers['accounts-bank-sync']({
+      ids: [acctId],
+    });
+
+    expect(result.errors).toHaveLength(0);
+    const transactions = await getAllTransactions();
+    expect(transactions.map(t => t.amount).sort((a, b) => a - b)).toEqual([
+      -1234, 0,
+    ]);
+  });
+});
