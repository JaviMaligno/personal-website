+describe('fintegraAccountsLink', () => {
+  const alreadyLinkedMessage =
+    'This bank account is already linked to another account.';
+  const fintegraAccountsLinkHandler = app.handlers['fintegra-accounts-link'];
+
+  const externalFintegraAccount = {
+    balance: 0,
+    account_id: 'fin-1',
+    name: 'Current Account',
+    institution: 'Fintegra Bank',
+    orgId: 'org-1',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates an account synced from Fintegra, named after the external account', async () => {
+    await fintegraAccountsLinkHandler({
+      externalAccount: externalFintegraAccount,
+      offBudget: true,
+      startingDate: '2024-01-01',
+      startingBalance: 1000,
+    });
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['fin-1'],
+    );
+    expect(account!.account_sync_source).toBe('fintegra');
+    expect(account!.name).toBe('Current Account');
+    expect(account!.official_name).toBe('Current Account');
+    expect(account!.offbudget).toBe(1);
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks');
+    expect(bank!.bank_id).toBe('org-1');
+    expect(bank!.name).toBe('Fintegra Bank');
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      account!.id,
+      'fin-1',
+      'org-1',
+      '2024-01-01',
+      1000,
+      undefined,
+    );
+  });
+
+  it('groups accounts from the same organisation and institution under one bank', async () => {
+    await fintegraAccountsLinkHandler({
+      externalAccount: externalFintegraAccount,
+    });
+    await fintegraAccountsLinkHandler({
+      externalAccount: { ...externalFintegraAccount, account_id: 'fin-2' },
+    });
+
+    const banks = await db.all<db.DbBank>('SELECT * FROM banks');
+    expect(banks).toHaveLength(1);
+
+    const accounts = await db.all<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_sync_source = ?',
+      ['fintegra'],
+    );
+    expect(accounts.map(a => a.bank)).toEqual([banks[0].id, banks[0].id]);
+  });
+
+  it('refuses to link a Fintegra account that another local account already holds', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Fintegra Bank' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Current Account',
+      bank: 'bank1',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      fintegraAccountsLinkHandler({
+        externalAccount: externalFintegraAccount,
+      }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('upgrades an existing local account into a Fintegra-synced account', async () => {
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await fintegraAccountsLinkHandler({
+      externalAccount: externalFintegraAccount,
+      upgradingId: 'acct2',
+    });
+
+    const target = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(target!.account_id).toBe('fin-1');
+    expect(target!.account_sync_source).toBe('fintegra');
+    expect(target!.name).toBe('Savings');
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      'acct2',
+      'fin-1',
+      'org-1',
+      undefined,
+      undefined,
+      undefined,
+    );
+  });
+});
