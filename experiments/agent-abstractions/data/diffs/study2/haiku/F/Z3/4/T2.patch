+describe('linking a Fintegra account', () => {
+  const fintegraAccountsLinkHandler = app.handlers['fintegra-accounts-link'];
+  const externalAccount = {
+    account_id: 'fin-acct-1',
+    name: 'Checking',
+    balance: 0,
+    institution: 'Bank',
+    orgId: 'org-1',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a bank-synced account under a bank for the organisation', async () => {
+    await expect(
+      fintegraAccountsLinkHandler({ externalAccount, offBudget: true }),
+    ).resolves.toBe('ok');
+
+    const account = await db.first<{
+      name: string;
+      official_name: string;
+      account_sync_source: string;
+      offbudget: number;
+      bank: string;
+    }>(
+      'SELECT name, official_name, account_sync_source, offbudget, bank FROM accounts WHERE account_id = ?',
+      ['fin-acct-1'],
+    );
+    expect(account).toMatchObject({
+      name: 'Checking',
+      official_name: 'Checking',
+      account_sync_source: 'fintegra',
+      offbudget: 1,
+    });
+
+    const bank = await db.first<{ bank_id: string; name: string }>(
+      'SELECT bank_id, name FROM banks WHERE id = ?',
+      [account.bank],
+    );
+    expect(bank).toEqual({ bank_id: 'org-1', name: 'Bank' });
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('refuses a new account when the bank account is already linked', async () => {
+    await setupSimpleFinAccounts([]);
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      bank: 'bank1',
+      account_id: 'fin-acct-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      fintegraAccountsLinkHandler({ externalAccount }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
+
