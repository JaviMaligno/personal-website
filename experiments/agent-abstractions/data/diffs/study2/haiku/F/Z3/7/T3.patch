+describe('linking into a closed account', () => {
+  const CLOSED_ERROR =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+  it('refuses to link a bank account into a closed local account', async () => {
+    await db.insertAccount({ id: 'closed', name: 'Closed', closed: 1 });
+    const before = await getAccountRow('closed');
+    const accountsBefore = await countRows('accounts');
+    const banksBefore = await countRows('banks');
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'closed' }),
+    ).rejects.toThrow(CLOSED_ERROR);
+
+    expect(await getAccountRow('closed')).toEqual(before);
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('banks')).toBe(banksBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to re-link the closed account that already holds the link', async () => {
+    await insertLinkedAccount({ id: 'linked', closed: true });
+    const before = await getAccountRow('linked');
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'linked' }),
+    ).rejects.toThrow(CLOSED_ERROR);
+
+    expect(await getAccountRow('linked')).toEqual(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('links once the account is reopened', async () => {
+    await db.insertAccount({ id: 'reopened', name: 'Reopened', closed: 1 });
+    await db.update('accounts', { id: 'reopened', closed: 0 });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'reopened' }),
+    ).resolves.toBe('ok');
+
+    expect(await getAccountRow('reopened')).toMatchObject({
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
+
