diff --git a/packages/loot-core/src/server/api-models.test.ts b/packages/loot-core/src/server/api-models.test.ts
new file mode 100644
index 0000000..7cf3e9d
--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,46 @@
+import type { ScheduleEntity } from '#types/models/schedule';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(amount: ScheduleEntity['_amount'] | undefined) {
+  return {
+    id: 'sched-1',
+    name: 'Test',
+    rule: 'rule-1',
+    next_date: '2026-11-01',
+    completed: false,
+    posts_transaction: false,
+    tombstone: false,
+    _payee: 'payee-1',
+    _account: 'account-1',
+    _amount: amount,
+    _amountOp: 'isbetween',
+    _date: '2026-11-01',
+    _conditions: [],
+    _actions: [],
+  } as ScheduleEntity;
+}
+
+describe('scheduleModel.toExternal', () => {
+  it('uses the end of a ranged amount furthest from zero as expectedAmount', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule({ num1: -10100, num2: -20000 }),
+    );
+
+    expect(result.amount).toEqual({ num1: -10100, num2: -20000 });
+    expect(result.expectedAmount).toBe(-20000);
+  });
+
+  it('uses a single amount as expectedAmount', () => {
+    const result = scheduleModel.toExternal(makeSchedule(-5000));
+
+    expect(result.amount).toBe(-5000);
+    expect(result.expectedAmount).toBe(-5000);
+  });
+
+  it('uses 0 as expectedAmount when there is no amount', () => {
+    const result = scheduleModel.toExternal(makeSchedule(undefined));
+
+    expect(result.expectedAmount).toBe(0);
+  });
+});
