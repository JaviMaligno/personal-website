new file mode 100644
index 0000000..79c72a2
--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,52 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(overrides: Partial<ScheduleEntity> = {}): ScheduleEntity {
+  return {
+    id: 'schedule1',
+    name: 'Rent',
+    rule: 'rule1',
+    next_date: '2026-11-01',
+    completed: false,
+    posts_transaction: false,
+    tombstone: false,
+    _payee: 'payee1',
+    _account: 'account1',
+    _amount: -50000,
+    _amountOp: 'is',
+    _date: { frequency: 'monthly', interval: 1, startDate: '2026-01-01' },
+    _conditions: [],
+    ...overrides,
+  } as ScheduleEntity;
+}
+
+describe('scheduleModel.toExternal', () => {
+  it('keeps the entered amount and operator alongside expectedAmount', () => {
+    const result = scheduleModel.toExternal(makeSchedule());
+
+    expect(result.amount).toBe(-50000);
+    expect(result.amountOp).toBe('is');
+    expect(result.expectedAmount).toBe(-50000);
+  });
+
+  it('uses the end of a ranged amount furthest from zero', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule({
+        _amount: { num1: -10100, num2: -20000 },
+        _amountOp: 'isbetween',
+      }),
+    );
+
+    expect(result.amount).toEqual({ num1: -10100, num2: -20000 });
+    expect(result.expectedAmount).toBe(-20000);
+  });
+
+  it('gives 0 when the schedule has no amount', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule({ _amount: null as unknown as number }),
+    );
+
+    expect(result.expectedAmount).toBe(0);
+  });
+});
