--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,58 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(amount: ScheduleEntity['_amount'] | undefined) {
+  return {
+    id: 'schedule-1',
+    name: 'Test',
+    rule: 'rule-1',
+    next_date: '2026-01-01',
+    completed: false,
+    posts_transaction: false,
+    tombstone: false,
+    _payee: 'payee-1',
+    _account: 'account-1',
+    _amount: amount,
+    _amountOp: 'isbetween',
+    _date: '2026-01-01',
+    _conditions: [],
+    _actions: [],
+  } as ScheduleEntity;
+}
+
+describe('scheduleModel.toExternal expectedAmount', () => {
+  it('gives a single amount itself', () => {
+    expect(scheduleModel.toExternal(makeSchedule(-5000)).expectedAmount).toBe(
+      -5000,
+    );
+  });
+
+  it('gives the end of a range furthest from zero', () => {
+    expect(
+      scheduleModel.toExternal(makeSchedule({ num1: -10100, num2: -20000 }))
+        .expectedAmount,
+    ).toBe(-20000);
+    expect(
+      scheduleModel.toExternal(makeSchedule({ num1: 3000, num2: -1000 }))
+        .expectedAmount,
+    ).toBe(3000);
+  });
+
+  it('gives 0 when the schedule has no amount', () => {
+    expect(
+      scheduleModel.toExternal(makeSchedule(undefined)).expectedAmount,
+    ).toBe(0);
+  });
+
+  it('keeps the existing fields unchanged', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule({ num1: -1, num2: -2 }),
+    );
+    expect(result).toMatchObject({
+      id: 'schedule-1',
+      amount: { num1: -1, num2: -2 },
+      amountOp: 'isbetween',
+    });
+  });
+});
