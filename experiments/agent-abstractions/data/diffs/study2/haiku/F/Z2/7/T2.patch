diff --git a/packages/loot-core/src/server/api-models.test.ts b/packages/loot-core/src/server/api-models.test.ts
new file mode 100644
index 0000000..9c315bd
--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,66 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(overrides: Partial<ScheduleEntity> = {}): ScheduleEntity {
+  return {
+    id: 'schedule-1',
+    name: 'Test',
+    rule: 'rule-1',
+    next_date: '2026-01-01',
+    completed: false,
+    posts_transaction: true,
+    tombstone: false,
+    _payee: null,
+    _account: null,
+    _amount: -100,
+    _amountOp: 'is',
+    _date: '2026-01-01',
+    _conditions: [],
+    _actions: [],
+    ...overrides,
+  } as ScheduleEntity;
+}
+
+describe('scheduleModel.toExternal', () => {
+  it('uses a single amount as the expected amount', () => {
+    expect(scheduleModel.toExternal(makeSchedule({ _amount: -5000 }))).toEqual(
+      expect.objectContaining({ amount: -5000, expectedAmount: -5000 }),
+    );
+  });
+
+  it('uses the end of a ranged amount furthest from zero', () => {
+    expect(
+      scheduleModel.toExternal(
+        makeSchedule({
+          _amount: { num1: -10100, num2: -20000 },
+          _amountOp: 'isbetween',
+        }),
+      ),
+    ).toEqual(
+      expect.objectContaining({
+        amount: { num1: -10100, num2: -20000 },
+        expectedAmount: -20000,
+      }),
+    );
+  });
+
+  it('uses the furthest end when it is the first bound', () => {
+    expect(
+      scheduleModel.toExternal(
+        makeSchedule({
+          _amount: { num1: 20000, num2: 10100 },
+          _amountOp: 'isbetween',
+        }),
+      ),
+    ).toEqual(expect.objectContaining({ expectedAmount: 20000 }));
+  });
+
+  it('gives 0 when the schedule has no amount', () => {
+    expect(
+      scheduleModel.toExternal(
+        makeSchedule({ _amount: null as unknown as number }),
+      ),
+    ).toEqual(expect.objectContaining({ expectedAmount: 0 }));
+  });
+});
