+export type APIScheduleListEntity = APIScheduleEntity & {
+  expectedAmount: number; // The single amount the schedule is expected to post
+};
+
+export function getScheduleExpectedAmount(
+  amount: ScheduleEntity['_amount'] | null | undefined,
+): number {
+  if (amount == null) {
+    return 0;
+  }
+  if (typeof amount === 'number') {
+    return amount;
+  }
+  return Math.abs(amount.num1) >= Math.abs(amount.num2)
+    ? amount.num1
+    : amount.num2;
+}
