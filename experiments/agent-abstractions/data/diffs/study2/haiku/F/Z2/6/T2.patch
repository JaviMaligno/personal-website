+import { getScheduleExpectedAmount } from './api-models';
+
+describe('getScheduleExpectedAmount', () => {
+  it('returns 0 when the schedule has no amount', () => {
+    expect(getScheduleExpectedAmount(null)).toBe(0);
+    expect(getScheduleExpectedAmount(undefined)).toBe(0);
+  });
+
+  it('returns a single amount as is', () => {
+    expect(getScheduleExpectedAmount(-5000)).toBe(-5000);
+    expect(getScheduleExpectedAmount(1234)).toBe(1234);
+  });
+
+  it('returns the end of a range furthest from zero', () => {
+    expect(getScheduleExpectedAmount({ num1: -10100, num2: -20000 })).toBe(
+      -20000,
+    );
+    expect(getScheduleExpectedAmount({ num1: -20000, num2: -10100 })).toBe(
+      -20000,
+    );
+    expect(getScheduleExpectedAmount({ num1: -5000, num2: 10000 })).toBe(10000);
+    expect(getScheduleExpectedAmount({ num1: 3000, num2: 7000 })).toBe(7000);
+  });
+});
