+export function isDailyWeekendSkip(rule: {
+  skipWeekend?: boolean;
+  frequency?: string;
+}): boolean {
+  return !!rule.skipWeekend && rule.frequency === 'daily';
+}
+
+// A daily pattern repeats its weekday mix within seven occurrences, so if the
+// pattern has any weekday occurrence, one is among the first seven.
+function getWeekdayOccurrence(schedule: Schedule, start: Date): Date | null {
+  let dates = schedule.occurrences({ start, take: 7 }).toArray();
+  if (dates.length === 0) {
+    // Ended before `start`: fall back to the last occurrence, as for other schedules
+    dates = schedule.occurrences({ reverse: true, take: 7 }).toArray();
+  }
+  return (
+    dates.map(occurrence => occurrence.date).find(date => !d.isWeekend(date)) ??
+    null
+  );
+}
