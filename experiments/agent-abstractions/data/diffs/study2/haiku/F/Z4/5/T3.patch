+
+      it('skips a holiday occurrence like a weekend day', () => {
+        expect(
+          getNextDate(
+            daily({ holidays: ['2020-12-08'] }),
+            new Date(2020, 11, 8),
+          ),
+        ).toBe('2020-12-09');
+      });
+
+      it('skips consecutive holidays and weekend days', () => {
+        expect(
+          getNextDate(
+            daily({ holidays: ['2020-12-07', '2020-12-08'] }),
+            new Date(2020, 11, 5),
+          ),
+        ).toBe('2020-12-09');
+      });
+
+      it('ignores holidays when weekend handling is off', () => {
+        expect(
+          getNextDate(
+            daily({ skipWeekend: false, holidays: ['2020-12-07'] }),
+            new Date(2020, 11, 7),
+          ),
+        ).toBe('2020-12-07');
+      });
+    });
+
+    describe('weekly schedules with holidays', () => {
+      /* Dec 2020 calendar for reference:
+        | Su | Mo | Tu | We | Th | Fr | Sa |
+        |    |    | 01 | 02 | 03 | 04 | 05 |
+        | 06 | 07 | 08 | 09 | 10 | 11 | 12 |
+        */
+      function weeklyOnSaturday(extra = {}) {
+        return {
+          op: 'isapprox',
+          value: {
+            start: '2020-12-05',
+            frequency: 'weekly',
+            patterns: [],
+            skipWeekend: true,
+            weekendSolveMode: 'after',
+            ...extra,
+          },
+        };
+      }
+
+      it('moves a weekend occurrence past a holiday Monday when moving after', () => {
+        expect(
+          getNextDate(
+            weeklyOnSaturday({ holidays: ['2020-12-07'] }),
+            new Date(2020, 11, 1),
+          ),
+        ).toBe('2020-12-08');
+      });
+
+      it('moves a weekend occurrence past a holiday Friday when moving before', () => {
+        expect(
+          getNextDate(
+            weeklyOnSaturday({
+              weekendSolveMode: 'before',
+              holidays: ['2020-12-04'],
+            }),
+            new Date(2020, 11, 1),
+          ),
+        ).toBe('2020-12-03');
+      });
+
+      it('moves a weekday occurrence on a holiday to the next business day', () => {
+        expect(
+          getNextDate(
+            weeklyOnSaturday({
+              start: '2020-12-07',
+              holidays: ['2020-12-07'],
+            }),
+            new Date(2020, 11, 1),
+          ),
+        ).toBe('2020-12-08');
+      });
+
+      it('keeps a weekend occurrence when weekend handling is off', () => {
+        expect(
+          getNextDate(
+            weeklyOnSaturday({
+              skipWeekend: false,
+              holidays: ['2020-12-07'],
+            }),
+            new Date(2020, 11, 1),
+          ),
+        ).toBe('2020-12-05');
+      });
     });
   });
 
