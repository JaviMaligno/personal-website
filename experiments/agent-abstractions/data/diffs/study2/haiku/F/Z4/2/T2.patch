+// A weekend occurrence moves at most two days, to the Friday before or the Monday after
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const skipsWeekendDays = skipsWeekendOccurrences(config);
+
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS)),
+      end: d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS)),
+    })
+    .toArray();
+
+  const days = new Set<string>();
+  for (const occurrence of occurrences) {
+    if (skipsWeekendDays && d.isWeekend(occurrence.date)) {
+      continue;
+    }
+
+    const day = dayFromDate(
+      applyWeekendRule(occurrence.date, {
+        skipWeekend: config.skipWeekend && !skipsWeekendDays,
+        solveMode: config.weekendSolveMode,
+      }),
+    );
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
