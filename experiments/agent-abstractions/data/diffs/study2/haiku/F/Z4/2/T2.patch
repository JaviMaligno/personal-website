+describe('schedule/get-dates-in-range', () => {
+  const getDatesInRange = (config, start: string, end: string) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  const monthlyFirst = {
+    start: '2024-01-01',
+    frequency: 'monthly',
+    interval: 1,
+    patterns: [{ type: 'day', value: 1 }],
+    endMode: 'never',
+  } as const;
+
+  it('lists occurrences within the period', async () => {
+    expect(
+      await getDatesInRange(monthlyFirst, '2024-06-04', '2024-07-31'),
+    ).toEqual(['2024-07-01']);
+  });
+
+  it('lists a weekend occurrence moved into the period', async () => {
+    const config = {
+      ...monthlyFirst,
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await getDatesInRange(config, '2024-06-02', '2024-06-30')).toEqual([
+      '2024-06-03',
+    ]);
+  });
+
+  it('drops a weekend occurrence moved out of the period', async () => {
+    const config = {
+      ...monthlyFirst,
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await getDatesInRange(config, '2024-06-04', '2024-06-30')).toEqual(
+      [],
+    );
+  });
+
+  it('moves a weekend occurrence before the weekend when set', async () => {
+    const config = {
+      ...monthlyFirst,
+      skipWeekend: true,
+      weekendSolveMode: 'before',
+    };
+    expect(await getDatesInRange(config, '2024-06-01', '2024-06-30')).toEqual(
+      [],
+    );
+    expect(await getDatesInRange(config, '2024-05-31', '2024-05-31')).toEqual([
+      '2024-05-31',
+    ]);
+  });
+
+  it('lists a day once when several occurrences move onto it', async () => {
+    const config = {
+      ...monthlyFirst,
+      patterns: [
+        { type: 'day', value: 1 },
+        { type: 'day', value: 2 },
+      ],
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await getDatesInRange(config, '2024-06-01', '2024-06-30')).toEqual([
+      '2024-06-03',
+    ]);
+  });
+
+  it('skips weekend occurrences of daily schedules', async () => {
+    const config = {
+      start: '2024-06-01',
+      frequency: 'daily',
+      interval: 1,
+      endMode: 'never',
+      skipWeekend: true,
+    } as const;
+    expect(await getDatesInRange(config, '2024-06-01', '2024-06-09')).toEqual([
+      '2024-06-03',
+      '2024-06-04',
+      '2024-06-05',
+      '2024-06-06',
+      '2024-06-07',
+    ]);
+  });
+
+  it('stops at the end date', async () => {
+    const config = {
+      ...monthlyFirst,
+      endMode: 'on_date',
+      endDate: '2024-06-01',
+    } as const;
+    expect(await getDatesInRange(config, '2024-05-01', '2024-07-31')).toEqual([
+      '2024-05-01',
+      '2024-06-01',
+    ]);
+  });
+});
