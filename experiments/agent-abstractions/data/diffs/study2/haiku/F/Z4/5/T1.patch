+const DAILY_WEEKDAY_SEARCH_LIMIT = 14;
+
+function getFirstWeekdayOccurrence(
+  schedule: RSchedule,
+  start: Date,
+): Date | null {
+  let occurrences = schedule
+    .occurrences({ start, take: DAILY_WEEKDAY_SEARCH_LIMIT })
+    .toArray();
+
+  if (occurrences.length === 0) {
+    occurrences = schedule
+      .occurrences({ reverse: true, take: DAILY_WEEKDAY_SEARCH_LIMIT })
+      .toArray();
+  }
+
+  return occurrences.map(o => o.date).find(date => !d.isWeekend(date)) ?? null;
