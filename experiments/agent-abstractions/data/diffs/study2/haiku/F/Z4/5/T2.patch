+// A weekend rule moves an occurrence by at most two days, so occurrences just
+// outside the period can land inside it.
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const skipsWeekendDays = config.frequency === 'daily' && config.skipWeekend;
+  const searchStart = d.startOfDay(
+    d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS),
+  );
+  const searchEnd = d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS));
+
+  try {
+    const days = schedule
+      .occurrences({ start: searchStart, end: searchEnd })
+      .toArray()
+      .map(occurrence => occurrence.date)
+      .filter(date => !skipsWeekendDays || !d.isWeekend(date))
+      .map(date =>
+        applyWeekendRule(date, {
+          skipWeekend: config.skipWeekend,
+          solveMode: config.weekendSolveMode,
+        }),
+      )
+      .map(date => dayFromDate(date))
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
