+// The weekend rule moves an occurrence at most two days, so occurrences within
+// this margin of the period can land inside it.
+const WEEKEND_SHIFT_MARGIN_DAYS = 2;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rule = {
+    skipWeekend: config.skipWeekend,
+    solveMode: config.weekendSolveMode,
+    daily: config.frequency === 'daily',
+  };
+
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(
+          d.subDays(parseDate(start), WEEKEND_SHIFT_MARGIN_DAYS),
+        ),
+        end: d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_MARGIN_DAYS)),
+      })
+      .toArray();
+
+    const days = new Set(
+      occurrences
+        .map(occurrence => occurrence.date)
+        .filter(date => !isDroppedWeekendOccurrence(date, rule))
+        .map(date => dayFromDate(applyWeekendRule(date, rule)))
+        .filter(day => day >= start && day <= end),
+    );
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
