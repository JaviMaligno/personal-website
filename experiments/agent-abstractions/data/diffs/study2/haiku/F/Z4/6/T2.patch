+// A weekend occurrence moves at most this many days, so occurrences this close
+// to a period can land inside it.
+const WEEKEND_SHIFT_DAYS = 2;
+
+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const weekendRule = {
+      skipWeekend: config.skipWeekend,
+      solveMode: config.weekendSolveMode,
+      frequency: config.frequency,
+    };
+
+    const days = new Set<string>();
+    schedule
+      .occurrences({
+        start: parseDate(subDays(start, WEEKEND_SHIFT_DAYS)),
+        end: parseDate(addDays(end, WEEKEND_SHIFT_DAYS + 1)),
+      })
+      .toArray()
+      .forEach(occurrence => {
+        const date = applyWeekendRule(occurrence.date, weekendRule);
+        if (date === null) {
+          return;
+        }
+        const day = dayFromDate(date);
+        if (day >= start && day <= end) {
+          days.add(day);
+        }
+      });
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
