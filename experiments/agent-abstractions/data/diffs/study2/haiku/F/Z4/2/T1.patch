+  schedule: RSchedule,
+  start: Date,
+): string | null {
+  const upcoming = schedule
+    .occurrences({ start, take: DAILY_WEEKDAY_SEARCH_LENGTH })
+    .toArray();
+  const candidates =
+    upcoming.length > 0
+      ? upcoming
+      : schedule
+          .occurrences({
+            reverse: true,
+            take: DAILY_WEEKDAY_SEARCH_LENGTH,
+          })
+          .toArray();
+  const weekday = candidates.find(occurrence => !d.isWeekend(occurrence.date));
+  return weekday ? monthUtils.dayFromDate(weekday.date) : null;
+}
