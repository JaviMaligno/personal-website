+
+describe('schedule/get-dates-in-range', () => {
+  const getDatesInRange = (config, start: string, end: string) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('includes an occurrence moved into the period from before it', async () => {
+    // 2024-08-03 is a Saturday; 'after' moves it to Monday 2024-08-05.
+    const config = {
+      frequency: 'monthly',
+      patterns: [{ type: 'day', value: 3 }],
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+      start: '2024-01-01',
+      endMode: 'never',
+    };
+
+    expect(await getDatesInRange(config, '2024-08-05', '2024-08-05')).toEqual([
+      '2024-08-05',
+    ]);
+    expect(await getDatesInRange(config, '2024-08-03', '2024-08-04')).toEqual(
+      [],
+    );
+  });
+
+  it('excludes an occurrence moved out of the period', async () => {
+    // 2024-08-31 is a Saturday; 'after' moves it to Monday 2024-09-02.
+    const config = {
+      frequency: 'monthly',
+      patterns: [{ type: 'day', value: 31 }],
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+      start: '2024-01-01',
+      endMode: 'never',
+    };
+
+    expect(await getDatesInRange(config, '2024-08-01', '2024-08-31')).toEqual(
+      [],
+    );
+    expect(await getDatesInRange(config, '2024-09-01', '2024-09-02')).toEqual([
+      '2024-09-02',
+    ]);
+  });
+
+  it('moves weekend occurrences to the Friday before', async () => {
+    // 2024-08-03 is a Saturday; 'before' moves it to Friday 2024-08-02.
+    const config = {
+      frequency: 'monthly',
+      patterns: [{ type: 'day', value: 3 }],
+      skipWeekend: true,
+      weekendSolveMode: 'before',
+      start: '2024-01-01',
+      endMode: 'never',
+    };
+
+    expect(await getDatesInRange(config, '2024-08-01', '2024-08-31')).toEqual([
+      '2024-08-02',
+    ]);
+  });
+
+  it('skips weekend occurrences of daily schedules', async () => {
+    const config = {
+      frequency: 'daily',
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+      start: '2024-07-01',
+      endMode: 'never',
+    };
+
+    expect(await getDatesInRange(config, '2024-08-01', '2024-08-07')).toEqual([
+      '2024-08-01',
+      '2024-08-02',
+      '2024-08-05',
+      '2024-08-06',
+      '2024-08-07',
+    ]);
+  });
+
+  it('lists a day once when several occurrences move onto it', async () => {
+    // 2024-08-02 (Friday) and 2024-08-03 (Saturday, moved back to Friday).
+    const config = {
+      frequency: 'monthly',
+      patterns: [
+        { type: 'day', value: 2 },
+        { type: 'day', value: 3 },
+      ],
+      skipWeekend: true,
+      weekendSolveMode: 'before',
+      start: '2024-01-01',
+      endMode: 'never',
+    };
+
+    expect(await getDatesInRange(config, '2024-08-01', '2024-08-04')).toEqual([
+      '2024-08-02',
+    ]);
+  });
+
+  it('returns nothing after the schedule has ended', async () => {
+    const config = {
+      frequency: 'weekly',
+      interval: 1,
+      start: '2024-01-01',
+      endMode: 'on_date',
+      endDate: '2024-03-01',
+    };
+
+    expect(await getDatesInRange(config, '2024-08-01', '2024-08-31')).toEqual(
+      [],
+    );
+  });
+});
