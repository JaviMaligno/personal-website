+// The weekend rule moves an occurrence by at most two days, so an occurrence
+// just outside the period can land inside it and vice versa.
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const weekendRule = {
+    skipWeekend: config.skipWeekend,
+    solveMode: config.weekendSolveMode,
+    frequency: config.frequency,
+  };
+
+  const days = new Set<string>();
+  const occurrences = schedule.occurrences({
+    start: d.startOfDay(parseDate(addDays(start, -WEEKEND_SHIFT_DAYS))),
+    end: d.endOfDay(parseDate(addDays(end, WEEKEND_SHIFT_DAYS))),
+  });
+
+  for (const { date } of occurrences.toArray()) {
+    const scheduled = applyWeekendRule(date, weekendRule);
+    if (scheduled) {
+      const day = dayFromDate(scheduled);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+  }
+
+  return [...days].sort();
+}
