+// A weekend occurrence moves at most two days, so occurrences just outside the
+// period can land inside it.
+const WEEKEND_SHIFT_MARGIN_DAYS = 3;
+
+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    const isDailySkip = isDailyWeekendSkip(config);
+    const days = schedule
+      .occurrences({
+        start: parseDate(subDays(start, WEEKEND_SHIFT_MARGIN_DAYS)),
+        end: parseDate(addDays(end, WEEKEND_SHIFT_MARGIN_DAYS)),
+      })
+      .toArray()
+      .map(occurrence => occurrence.date)
+      .filter(date => !isDailySkip || !d.isWeekend(date))
+      .map(date =>
+        applyWeekendRule(date, {
+          skipWeekend: config.skipWeekend,
+          solveMode: config.weekendSolveMode,
+        }),
+      )
+      .map(date => dayFromDate(date))
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
