+// A daily schedule cycles through the days of the week, so if none of 7
+// consecutive occurrences falls on a weekday, none ever will.
+const DAILY_CANDIDATES_PER_OCCURRENCE = 7;
+
+// Up to `take` occurrences, with the weekend rule applied. For daily schedules
+// weekend occurrences are dropped; otherwise they are moved by applyWeekendRule.
+export function getRecurOccurrences(
+  schedule: RSchedule,
+  rule: WeekendRule,
+  {
+    start,
+    reverse = false,
+    take,
+  }: { start?: Date; reverse?: boolean; take: number },
+): Date[] {
+  const dropsWeekendDays = Boolean(rule.skipWeekend && rule.daily);
+  const candidates = schedule
+    .occurrences({
+      start,
+      reverse,
+      take: dropsWeekendDays ? take * DAILY_CANDIDATES_PER_OCCURRENCE : take,
+    })
+    .toArray();
+
+  return candidates
+    .map(occurrence => occurrence.date)
+    .filter(date => !dropsWeekendDays || !d.isWeekend(date))
+    .slice(0, take)
+    .map(date => applyWeekendRule(date, rule));
+}
