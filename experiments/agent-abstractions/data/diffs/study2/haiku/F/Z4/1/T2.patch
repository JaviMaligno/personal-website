+describe('schedule/get-dates-in-range', () => {
+  const getDatesInRange = (args: {
+    config: RecurConfig;
+    start: string;
+    end: string;
+  }) => schedulesApp.handlers['schedule/get-dates-in-range'](args);
+
+  it('lists the occurrences inside the period, both ends included', async () => {
+    const dates = await getDatesInRange({
+      config: { frequency: 'daily', start: '2026-01-01', endMode: 'never' },
+      start: '2026-01-05',
+      end: '2026-01-07',
+    });
+
+    expect(dates).toEqual(['2026-01-05', '2026-01-06', '2026-01-07']);
+  });
+
+  it('stops at the end date of the schedule', async () => {
+    const dates = await getDatesInRange({
+      config: {
+        frequency: 'daily',
+        start: '2026-01-01',
+        endMode: 'on_date',
+        endDate: '2026-01-10',
+      },
+      start: '2026-01-08',
+      end: '2026-01-20',
+    });
+
+    expect(dates).toEqual(['2026-01-08', '2026-01-09', '2026-01-10']);
+  });
+
+  it('skips weekend occurrences of daily schedules', async () => {
+    const dates = await getDatesInRange({
+      config: {
+        frequency: 'daily',
+        start: '2026-01-01',
+        endMode: 'never',
+        skipWeekend: true,
+      },
+      start: '2026-01-01',
+      end: '2026-01-06',
+    });
+
+    expect(dates).toEqual([
+      '2026-01-01',
+      '2026-01-02',
+      '2026-01-05',
+      '2026-01-06',
+    ]);
+  });
+
+  it('moves a weekend occurrence to the Friday before', async () => {
+    const config: RecurConfig = {
+      frequency: 'monthly',
+      start: '2026-01-01',
+      endMode: 'never',
+      patterns: [{ type: 'day', value: 3 }],
+      skipWeekend: true,
+      weekendSolveMode: 'before',
+    };
+
+    expect(
+      await getDatesInRange({ config, start: '2026-01-02', end: '2026-01-02' }),
+    ).toEqual(['2026-01-02']);
+    expect(
+      await getDatesInRange({ config, start: '2026-01-03', end: '2026-01-31' }),
+    ).toEqual([]);
+  });
+
+  it('moves a weekend occurrence to the Monday after', async () => {
+    const config: RecurConfig = {
+      frequency: 'monthly',
+      start: '2026-01-01',
+      endMode: 'never',
+      patterns: [{ type: 'day', value: 3 }],
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+
+    expect(
+      await getDatesInRange({ config, start: '2026-01-04', end: '2026-01-05' }),
+    ).toEqual(['2026-01-05']);
+    expect(
+      await getDatesInRange({ config, start: '2026-01-01', end: '2026-01-04' }),
+    ).toEqual([]);
+  });
+
+  it('lists a day once when two weekend occurrences move to it', async () => {
+    const dates = await getDatesInRange({
+      config: {
+        frequency: 'monthly',
+        start: '2026-01-01',
+        endMode: 'never',
+        patterns: [
+          { type: 'day', value: 3 },
+          { type: 'day', value: 4 },
+        ],
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      },
+      start: '2026-01-01',
+      end: '2026-01-31',
+    });
+
+    expect(dates).toEqual(['2026-01-05']);
+  });
+});
