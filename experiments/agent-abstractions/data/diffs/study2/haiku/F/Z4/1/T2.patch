+// A weekend occurrence moves at most two days: Saturday to Monday or Friday,
+// Sunday to Monday or Friday.
+const MAX_WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const schedule = new RSchedule({
+    rrules: recurConfigToRSchedule(config),
+  });
+  const skipsDays = skipsWeekendOccurrences(
+    config.skipWeekend,
+    config.frequency,
+  );
+  const weekendRule = {
+    skipWeekend: config.skipWeekend,
+    solveMode: config.weekendSolveMode,
+  };
+
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), MAX_WEEKEND_SHIFT_DAYS)),
+      end: d.endOfDay(d.addDays(parseDate(end), MAX_WEEKEND_SHIFT_DAYS)),
+    })
+    .toArray();
+
+  const days = new Set<string>();
+  for (const { date } of occurrences) {
+    if (skipsDays && d.isWeekend(date)) {
+      continue;
+    }
+
+    const day = dayFromDate(applyWeekendRule(date, weekendRule));
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
