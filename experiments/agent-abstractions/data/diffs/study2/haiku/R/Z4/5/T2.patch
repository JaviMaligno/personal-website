+// Weekend solving moves an occurrence at most two days, so occurrences up to
+// three days outside the period may land inside it.
+const WEEKEND_SHIFT_PADDING_DAYS = 3;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const skipsDailyWeekend = isDailySkippingWeekend(config);
+
+    const occurrences = schedule
+      .occurrences({
+        start: d.subDays(parseDate(start), WEEKEND_SHIFT_PADDING_DAYS),
+        end: d.addDays(parseDate(end), WEEKEND_SHIFT_PADDING_DAYS),
+      })
+      .toArray()
+      .map(occurrence => occurrence.date);
+
+    const days = new Set<string>();
+    for (const date of occurrences) {
+      if (skipsDailyWeekend) {
+        if (!d.isWeekend(date)) {
+          days.add(dayFromDate(date));
+        }
+        continue;
+      }
+
+      const finalDate = config.skipWeekend
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date;
+      days.add(dayFromDate(finalDate));
+    }
+
+    return [...days].filter(day => day >= start && day <= end).sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
