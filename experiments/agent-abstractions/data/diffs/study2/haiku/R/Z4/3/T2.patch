+export async function getDatesInRange({ config, start, end }) {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const skipsDays = skipsWeekendOccurrences(config);
+
+  // Weekend solving shifts an occurrence by at most 2 days, so pad the window
+  const windowStart = d.subDays(parseDate(start), 2);
+  const windowEnd = d.endOfDay(d.addDays(parseDate(end), 2));
+
+  const days = new Set<string>();
+  schedule
+    .occurrences({ start: windowStart, end: windowEnd })
+    .toArray()
+    .forEach(({ date }) => {
+      if (skipsDays && d.isWeekend(date)) {
+        return;
+      }
+      const finalDate =
+        config.skipWeekend && !skipsDays
+          ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+          : date;
+      const day = dayFromDate(finalDate);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    });
+
+  return [...days].sort();
+}
