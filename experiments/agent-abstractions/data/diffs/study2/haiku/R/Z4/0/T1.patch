+// Daily occurrences on a weekend are dropped rather than moved. Looking at 7
+// consecutive occurrences covers every weekday for any daily interval that is
+// not a multiple of 7.
+const DAILY_WEEKEND_LOOKAHEAD = 7;
+
+export function applyWeekendRule(
+  date: Date,
+  recur: Pick<RecurConfig, 'skipWeekend' | 'frequency' | 'weekendSolveMode'>,
+): Date | null {
+  if (!recur.skipWeekend || !d.isWeekend(date)) {
+    return date;
+  }
+  if (recur.frequency === 'daily') {
+    return null;
+  }
+  return getDateWithSkippedWeekend(date, recur.weekendSolveMode);
+}
+
+export function getDailyWeekendLookahead(
+  count: number,
+  recur: Pick<RecurConfig, 'skipWeekend' | 'frequency'>,
+): number {
+  return recur.skipWeekend && recur.frequency === 'daily'
+    ? count * DAILY_WEEKEND_LOOKAHEAD
+    : count;
+}
