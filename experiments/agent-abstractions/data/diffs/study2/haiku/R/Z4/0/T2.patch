+// Weekend solving moves an occurrence by at most two days, so occurrences just
+// outside the period can land inside it and must be considered.
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const windowStart = d.startOfDay(
+      d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS),
+    );
+    const windowEnd = d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS));
+
+    const days = new Set<string>();
+    for (const { date } of schedule
+      .occurrences({ start: windowStart, end: windowEnd })
+      .toArray()) {
+      const adjusted = applyWeekendRule(date, config);
+      if (adjusted === null) {
+        continue;
+      }
+      const day = dayFromDate(adjusted);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
