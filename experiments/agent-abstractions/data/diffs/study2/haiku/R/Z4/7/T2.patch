+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+  // A weekend move shifts an occurrence by at most two days, so scan past both bounds
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), 2)),
+      end: d.endOfDay(d.addDays(parseDate(end), 2)),
+    })
+    .toArray();
+
+  const days = new Set<string>();
+  for (const { date } of occurrences) {
+    if (isSkippedWeekendOccurrence(config, date)) {
+      continue;
+    }
+    const day = dayFromDate(
+      config.skipWeekend
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date,
+    );
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
