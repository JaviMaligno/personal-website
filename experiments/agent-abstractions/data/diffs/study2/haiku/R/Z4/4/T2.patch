+// A weekend occurrence moves at most two days, so occurrences this far outside
+// the period can still land inside it.
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({ config, start, end }) {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const skipsDailyWeekend = isDailyWeekendSkip(config);
+
+  const occurrences = schedule
+    .occurrences({
+      start: d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS),
+      end: d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS + 1),
+    })
+    .toArray()
+    .map(occurrence => occurrence.date);
+
+  const days = new Set<string>();
+  for (const date of occurrences) {
+    if (skipsDailyWeekend && d.isWeekend(date)) {
+      continue;
+    }
+
+    const day = dayFromDate(
+      config.skipWeekend && !skipsDailyWeekend
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date,
+    );
+
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
