+const MAX_WEEKEND_SHIFT_DAYS = 2;
+
+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+
+  const searchStart = d.subDays(parseDate(start), MAX_WEEKEND_SHIFT_DAYS);
+  const searchEnd = d.addDays(parseDate(end), MAX_WEEKEND_SHIFT_DAYS);
+
+  const days = schedule
+    .occurrences({ start: searchStart, end: searchEnd })
+    .toArray()
+    .map(occurrence => occurrence.date)
+    .filter(date => !isSkippedWeekendOccurrence(config, date))
+    .map(date =>
+      config.skipWeekend
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date,
+    )
+    .map(date => dayFromDate(date))
+    .filter(day => day >= start && day <= end);
+
+  return [...new Set(days)].sort();
+}
