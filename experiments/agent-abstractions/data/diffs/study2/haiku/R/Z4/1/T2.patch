+// A weekend occurrence moves at most two days (Sunday before → Friday, Saturday after → Monday)
+const MAX_WEEKEND_SHIFT_DAYS = 2;
+
+function getOccurrenceDay(date: Date, config): string | null {
+  if (isDailyWeekendSkip(config)) {
+    return d.isWeekend(date) ? null : dayFromDate(date);
+  }
+  return dayFromDate(
+    config.skipWeekend
+      ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+      : date,
+  );
+}
+
+export function getDatesInRange({ config, start, end }) {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const scanStart = d.subDays(parseDate(start), MAX_WEEKEND_SHIFT_DAYS);
+  const scanEnd = d.addDays(parseDate(end), MAX_WEEKEND_SHIFT_DAYS);
+
+  const days = new Set<string>();
+  for (const occurrence of schedule
+    .occurrences({ start: scanStart, end: scanEnd })
+    .toArray()) {
+    const day = getOccurrenceDay(occurrence.date, config);
+    if (day !== null && day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
