+describe('getDatesInRange', () => {
+  const monthlyOn = (
+    value: number,
+    weekendSolveMode: 'before' | 'after' = 'before',
+  ): RecurConfig => ({
+    frequency: 'monthly',
+    start: '2026-01-01',
+    endMode: 'never',
+    patterns: [{ type: 'day', value }],
+    skipWeekend: true,
+    weekendSolveMode,
+  });
+
+  it('returns the days of a plain recurrence inside the period', async () => {
+    const config: RecurConfig = { ...monthlyOn(15), skipWeekend: false };
+
+    expect(
+      await getDatesInRange({
+        config,
+        start: '2026-10-01',
+        end: '2026-12-31',
+      }),
+    ).toEqual(['2026-10-15', '2026-11-15', '2026-12-15']);
+  });
+
+  it('moves a Saturday occurrence back to Friday when solving before', async () => {
+    const config = monthlyOn(10, 'before');
+
+    expect(
+      await getDatesInRange({
+        config,
+        start: '2026-10-09',
+        end: '2026-10-09',
+      }),
+    ).toEqual(['2026-10-09']);
+    expect(
+      await getDatesInRange({
+        config,
+        start: '2026-10-10',
+        end: '2026-10-31',
+      }),
+    ).toEqual([]);
+  });
+
+  it('moves a Saturday occurrence forward to Monday when solving after', async () => {
+    const config = monthlyOn(10, 'after');
+
+    expect(
+      await getDatesInRange({
+        config,
+        start: '2026-10-12',
+        end: '2026-10-12',
+      }),
+    ).toEqual(['2026-10-12']);
+    expect(
+      await getDatesInRange({
+        config,
+        start: '2026-10-01',
+        end: '2026-10-11',
+      }),
+    ).toEqual([]);
+  });
+
+  it('lists an occurrence once when weekend moves collapse it onto the same day', async () => {
+    const config: RecurConfig = {
+      ...monthlyOn(10, 'before'),
+      patterns: [
+        { type: 'day', value: 10 },
+        { type: 'day', value: 11 },
+      ],
+    };
+
+    expect(
+      await getDatesInRange({
+        config,
+        start: '2026-10-01',
+        end: '2026-10-31',
+      }),
+    ).toEqual(['2026-10-09']);
+  });
+
+  it('skips weekend occurrences of daily schedules without moving them', async () => {
+    const config: RecurConfig = {
+      frequency: 'daily',
+      start: '2026-10-01',
+      endMode: 'never',
+      skipWeekend: true,
+      weekendSolveMode: 'before',
+    };
+
+    expect(
+      await getDatesInRange({
+        config,
+        start: '2026-10-09',
+        end: '2026-10-12',
+      }),
+    ).toEqual(['2026-10-09', '2026-10-12']);
+  });
+
+  it('keeps weekend occurrences of daily schedules when weekend skipping is off', async () => {
+    const config: RecurConfig = {
+      frequency: 'daily',
+      start: '2026-10-01',
+      endMode: 'never',
+      skipWeekend: false,
+    };
+
+    expect(
+      await getDatesInRange({
+        config,
+        start: '2026-10-09',
+        end: '2026-10-12',
+      }),
+    ).toEqual(['2026-10-09', '2026-10-10', '2026-10-11', '2026-10-12']);
+  });
+
+  it('stops at the end of the schedule', async () => {
+    const config: RecurConfig = {
+      frequency: 'daily',
+      start: '2026-10-01',
+      endMode: 'after_n_occurrences',
+      endOccurrences: 2,
+      skipWeekend: false,
+    };
+
+    expect(
+      await getDatesInRange({
+        config,
+        start: '2026-10-01',
+        end: '2026-10-31',
+      }),
+    ).toEqual(['2026-10-01', '2026-10-02']);
+  });
+});
