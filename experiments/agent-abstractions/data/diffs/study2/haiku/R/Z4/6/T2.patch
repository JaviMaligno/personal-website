+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    // Weekend handling moves an occurrence by at most two days, so occurrences
+    // just outside the period can land inside it and must be included.
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS)),
+        end: d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS)),
+      })
+      .toArray()
+      .map(occurrence => occurrence.date);
+
+    const skipDaily = skipsDailyWeekend(config);
+    const days = new Set<string>();
+
+    for (const date of occurrences) {
+      if (skipDaily && d.isWeekend(date)) {
+        continue;
+      }
+
+      const finalDate =
+        config.skipWeekend && !skipDaily
+          ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+          : date;
+      const day = dayFromDate(finalDate);
+
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
