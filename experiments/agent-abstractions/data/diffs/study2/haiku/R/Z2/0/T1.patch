+  describe('getScheduledAmount', () => {
+    it('returns a single amount unchanged', () => {
+      expect(getScheduledAmount(-5000)).toBe(-5000);
+      expect(getScheduledAmount(-5000, true)).toBe(5000);
+    });
+
+    it('returns 0 when there is no amount', () => {
+      expect(getScheduledAmount(null)).toBe(0);
+      expect(getScheduledAmount(undefined)).toBe(0);
+    });
+
+    it('uses the end of a range furthest from zero for expenses', () => {
+      expect(getScheduledAmount({ num1: -10100, num2: -20000 })).toBe(-20000);
