+    });
+
+    it('uses the end of a range furthest from zero for income', () => {
+      expect(getScheduledAmount({ num1: 10100, num2: 20000 })).toBe(20000);
+      expect(getScheduledAmount({ num1: 20000, num2: 10100 })).toBe(20000);
+    });
+
+    it('inverts the worst-case amount', () => {
+      expect(getScheduledAmount({ num1: -10100, num2: -20000 }, true)).toBe(
+        20000,
+      );
+    });
+  });
 });
