+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat1',
+      name: 'cat1',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'templated-cat',
+      name: 'templated-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: JSON.stringify([
+        { directive: 'template', type: 'fixed', amount: 10000, priority: 0 },
+      ]),
+    });
+    await db.insertCategory({
+      id: 'hidden-group-cat',
+      name: 'hidden-group-cat',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  const untouchedCategories = [
+    'hidden-cat',
+    'templated-cat',
+    'hidden-group-cat',
+  ];
+
+  it('setZero only zeroes categories that are not hidden or template-managed', async () => {
+    await setupDatabase();
+
+    for (const category of ['cat1', ...untouchedCategories]) {
+      await setBudget({ category, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(0);
+    for (const category of untouchedCategories) {
+      expect(await getSheetValue('budget202402', `budget-${category}`)).toBe(
+        500,
+      );
+    }
+  });
+
+  it('copyPreviousMonth only copies to categories that are not hidden or template-managed', async () => {
+    await setupDatabase();
+
+    for (const category of ['cat1', ...untouchedCategories]) {
+      await setBudget({ category, month: '2024-01', amount: 300 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(300);
+    for (const category of untouchedCategories) {
+      expect(await getSheetValue('budget202402', `budget-${category}`)).toBe(0);
+    }
+  });
+});
