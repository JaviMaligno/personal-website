+      name: 'cat-spent',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-refunded',
+      name: 'cat-refunded',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-unspent',
+      name: 'cat-unspent',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+
+    await db.insertTransaction({
+      date: '2024-03-10',
+      amount: -3000,
+      account: 'account1',
+      category: 'cat-spent',
+    });
+    await db.insertTransaction({
+      date: '2024-03-11',
+      amount: 500,
+      account: 'account1',
+      category: 'cat-spent',
+    });
+    await db.insertTransaction({
+      date: '2024-03-12',
+      amount: 400,
+      account: 'account1',
+      category: 'cat-refunded',
+    });
+    await db.insertTransaction({
+      date: '2024-03-13',
+      amount: 5000,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('budgets each expense category its net spending from the previous month', async () => {
+    await setupDatabase();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat-spent')).toBe(2500);
+    expect(await getSheetValue('budget202404', 'budget-cat-unspent')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-cat-refunded')).toBe(0);
