+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat1',
+      name: 'cat1',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'hidden-group-cat',
+      name: 'hidden-group-cat',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'template-cat',
+      name: 'template-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: JSON.stringify([{ type: 'fixed', amount: 100 }]),
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+  }
+
+  it('setZero leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'hidden-group-cat',
+      'template-cat',
+    ]) {
+      await setBudget({ category, month: '2024-04', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(500);
+    expect(await getSheetValue('budget202404', 'budget-hidden-group-cat')).toBe(
+      500,
+    );
+    expect(await getSheetValue('budget202404', 'budget-template-cat')).toBe(
+      500,
+    );
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'hidden-group-cat',
+      'template-cat',
+    ]) {
+      await setBudget({ category, month: '2024-03', amount: 300 });
+    }
+    await setBudget({
+      category: 'template-cat',
+      month: '2024-04',
+      amount: 700,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(300);
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-hidden-group-cat')).toBe(
+      0,
+    );
+    expect(await getSheetValue('budget202404', 'budget-template-cat')).toBe(
+      700,
+    );
+  });
+});
