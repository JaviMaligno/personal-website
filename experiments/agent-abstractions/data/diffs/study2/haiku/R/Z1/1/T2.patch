+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevSheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = await getMonthWideCategories();
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      const netAmount = await getSheetValue(
+        prevSheetName,
+        'sum-amount-' + cat.id,
+      );
+      const amount = cat.is_income === 1 ? netAmount : -netAmount;
+
+      void setBudget({ category: cat.id, month, amount: Math.max(amount, 0) });
+    }
+  });
+}
