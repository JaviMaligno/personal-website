+describe('month-wide budget actions skip #fixed groups', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'fixed-group',
+      name: 'fixed-group',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'fixed-among-tags',
+      name: 'fixed-among-tags',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'similar-tag-group',
+      name: 'similar-tag-group',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'fixed-cat',
+      name: 'fixed-cat',
+      cat_group: 'fixed-group',
+    });
+    await db.insertCategory({
+      id: 'fixed-among-tags-cat',
+      name: 'fixed-among-tags-cat',
+      cat_group: 'fixed-among-tags',
+    });
+    await db.insertCategory({
+      id: 'similar-tag-cat',
+      name: 'similar-tag-cat',
+      cat_group: 'similar-tag-group',
+    });
+    await db.insertCategory({
+      id: 'group1-cat',
+      name: 'group1-cat',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'cat-with-fixed-note',
+      name: 'cat-with-fixed-note',
+      cat_group: 'group1',
+    });
+    db.runQuery('INSERT INTO notes (id, note) VALUES (?, ?)', [
+      'fixed-group',
+      '#fixed',
+    ]);
+    db.runQuery('INSERT INTO notes (id, note) VALUES (?, ?)', [
+      'fixed-among-tags',
+      'Rent and loans #utilities #fixed',
+    ]);
+    db.runQuery('INSERT INTO notes (id, note) VALUES (?, ?)', [
+      'similar-tag-group',
+      '#fixed-costs',
+    ]);
+    db.runQuery('INSERT INTO notes (id, note) VALUES (?, ?)', [
+      'cat-with-fixed-note',
+      '#fixed',
+    ]);
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  async function setAllBudgets(month: string, amount: number) {
+    for (const category of [
+      'fixed-cat',
+      'fixed-among-tags-cat',
+      'similar-tag-cat',
+      'group1-cat',
+      'cat-with-fixed-note',
+    ]) {
+      await setBudget({ category, month, amount });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('setZero leaves categories in #fixed groups untouched', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-02', 500);
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-fixed-cat')).toBe(500);
+    expect(
+      await getSheetValue('budget202402', 'budget-fixed-among-tags-cat'),
+    ).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-similar-tag-cat')).toBe(
+      0,
+    );
+    expect(await getSheetValue('budget202402', 'budget-group1-cat')).toBe(0);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-with-fixed-note'),
+    ).toBe(0);
+  });
+
+  it('copyPreviousMonth leaves categories in #fixed groups untouched', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-01', 300);
+    await setAllBudgets('2024-02', 500);
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-fixed-cat')).toBe(500);
+    expect(
+      await getSheetValue('budget202402', 'budget-fixed-among-tags-cat'),
+    ).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-similar-tag-cat')).toBe(
+      300,
+    );
+    expect(await getSheetValue('budget202402', 'budget-group1-cat')).toBe(300);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-with-fixed-note'),
+    ).toBe(300);
+  });
+});
