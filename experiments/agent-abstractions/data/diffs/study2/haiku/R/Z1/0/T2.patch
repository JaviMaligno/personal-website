+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevMonthSheet = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = await getCategoriesForMonthActions();
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      const net = await getSheetValue(prevMonthSheet, 'sum-amount-' + cat.id);
+      const amount = cat.is_income === 1 ? net : net === 0 ? 0 : -net;
+
+      void setBudget({ category: cat.id, month, amount });
+    }
+  });
+}
