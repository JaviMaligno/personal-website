+describe('month-wide budget actions', () => {
+  let originalCurrentMonth: string | null;
+
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    originalCurrentMonth = global.currentMonth;
+    global.currentMonth = '2024-02';
+  });
+
+  afterEach(async () => {
+    global.currentMonth = originalCurrentMonth;
+    await global.emptyDatabase()();
+  });
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat1',
+      name: 'cat1',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'cat-hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-templated',
+      name: 'cat-templated',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: '[{"type":"fixed","amount":10000,"priority":null}]',
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'cat-in-hidden-group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  it('setZero leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat1',
+      'cat-hidden',
+      'cat-templated',
+      'cat-in-hidden-group',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-cat-templated')).toBe(
+      500,
+    );
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(500);
+  });
+
+  it('set3MonthAvg leaves hidden and templated categories untouched', async () => {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await setupDatabase();
+    await db.insertTransaction({
+      date: '2024-01-15',
+      amount: -300,
+      account: 'account1',
+      category: 'cat1',
+    });
+    await setBudget({
+      category: 'cat-templated',
+      month: '2024-02',
+      amount: 500,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(300);
+    expect(await getSheetValue('budget202402', 'budget-cat-templated')).toBe(
+      500,
+    );
+  });
+
+  it('copyPreviousMonth skips hidden, hidden-group and templated categories', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat1',
+      'cat-hidden',
+      'cat-templated',
+      'cat-in-hidden-group',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 100 });
+    }
+    await setBudget({ category: 'cat-templated', month: '2024-02', amount: 7 });
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(100);
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-cat-templated')).toBe(7);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(0);
+  });
+});
