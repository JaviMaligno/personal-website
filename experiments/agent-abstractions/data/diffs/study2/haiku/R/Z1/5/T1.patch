+describe('month-wide budget actions skip protected categories', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'visible',
+      name: 'visible',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'in-hidden-group',
+      name: 'in-hidden-group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'templated',
+      cat_group: 'group1',
+    });
+    db.runQuery('UPDATE categories SET goal_def = ? WHERE id = ?', [
+      JSON.stringify([{ type: 'fixed', amount: 100, priority: null }]),
+      'templated',
+    ]);
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  async function setAllBudgets(month: string, amount: number) {
+    for (const category of [
+      'visible',
+      'hidden-cat',
+      'in-hidden-group',
+      'templated',
+    ]) {
+      await setBudget({ category, month, amount });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('setZero leaves hidden, hidden-group, and templated categories untouched', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-02', 500);
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-visible')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-in-hidden-group')).toBe(
+      500,
+    );
+    expect(await getSheetValue('budget202402', 'budget-templated')).toBe(500);
+  });
+
+  it('copyPreviousMonth leaves templated categories untouched', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-01', 300);
+    await setAllBudgets('2024-02', 500);
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-visible')).toBe(300);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-in-hidden-group')).toBe(
+      500,
+    );
+    expect(await getSheetValue('budget202402', 'budget-templated')).toBe(500);
+  });
+});
