+describe('setLastMonthSpending', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  const templateDef = JSON.stringify([
+    {
+      type: 'simple',
+      monthly: 10,
+      limit: null,
+      priority: 0,
+      directive: 'template',
+    },
+  ]);
+
+  async function setupDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-spent',
+      name: 'spent',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-unspent',
+      name: 'unspent',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-template',
+      name: 'template',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: templateDef,
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02', '2024-03']);
+
+    await db.insertTransaction({
+      date: '2024-02-10',
+      amount: -3000,
+      account: 'account1',
+      category: 'cat-spent',
+    });
+    await db.insertTransaction({
+      date: '2024-02-20',
+      amount: -1000,
+      account: 'account1',
+      category: 'cat-spent',
+    });
+    await db.insertTransaction({
+      date: '2024-02-15',
+      amount: 2000,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await db.insertTransaction({
+      date: '2024-02-15',
+      amount: -700,
+      account: 'account1',
+      category: 'cat-hidden',
+    });
+    await db.insertTransaction({
+      date: '2024-02-15',
+      amount: -700,
+      account: 'account1',
+      category: 'cat-template',
+    });
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('budgets each eligible expense category its previous month spending', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'cat-spent', month: '2024-03', amount: 1 });
+    await setBudget({ category: 'cat-unspent', month: '2024-03', amount: 500 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202403', 'budget-cat-spent')).toBe(4000);
+    expect(await getSheetValue('budget202403', 'budget-cat-unspent')).toBe(0);
+  });
+
+  it('leaves hidden and template categories untouched', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'cat-hidden', month: '2024-03', amount: 300 });
+    await setBudget({
+      category: 'cat-template',
+      month: '2024-03',
+      amount: 400,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202403', 'budget-cat-hidden')).toBe(300);
+    expect(await getSheetValue('budget202403', 'budget-cat-template')).toBe(
+      400,
+    );
+  });
+
+  it('skips income categories in envelope budgets', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'income-cat', month: '2024-03', amount: 700 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202403', 'budget-income-cat')).toBe(700);
+  });
+});
