+// in hidden groups, categories in #fixed groups and categories managed by budget
+// templates are left alone.
+async function getMonthWideCategories(): Promise<db.DbCategory[]> {
+  const fixedGroupIds = new Set(
+    (
+      await db.all<Pick<db.DbNote, 'id' | 'note'>>(`
+        SELECT n.id, n.note
+        FROM notes n
+        JOIN category_groups g ON g.id = n.id
+        WHERE n.note LIKE '%#fixed%'
+      `)
+    )
+      .filter(({ note }) => FIXED_GROUP_TAG.test(note ?? ''))
+      .map(({ id }) => id),
+  );
+
+  const categories = await db.all<db.DbCategory>(`
     SELECT c.*
     FROM categories c
     LEFT JOIN category_groups g ON c.cat_group = g.id
     WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0 AND c.goal_def IS NULL
   `);
+
+  return categories.filter(
+    cat => cat.cat_group == null || !fixedGroupIds.has(cat.cat_group),
+  );
 }
 
