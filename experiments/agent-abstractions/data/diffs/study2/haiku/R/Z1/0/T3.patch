+// Groups whose notes carry the #fixed tag hold fixed costs whose budgets are
+// set by hand, so month-wide actions leave them alone.
+async function getFixedCostGroupIds(): Promise<Set<string>> {
+  const groupNotes = await db.all<Pick<db.DbNote, 'id' | 'note'>>(`
+    SELECT n.id, n.note
+    FROM notes n
+    JOIN category_groups g ON g.id = n.id
+    WHERE g.tombstone = 0
+  `);
+  return new Set(
+    groupNotes
+      .filter(({ note }) => extractTagsFromText(note).includes('fixed'))
+      .map(({ id }) => id),
+  );
+}
