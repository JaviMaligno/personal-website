+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getMonthActionCategories();
+  const prevMonth = monthUtils.prevMonth(month);
+  const sheetName = monthUtils.sheetForMonth(prevMonth);
+
+  const amounts = [];
+  for (const cat of categories) {
+    if (cat.is_income === 1 && !isTrackingBudget()) {
+      continue;
+    }
+    const activity = await getSheetValue(sheetName, 'sum-amount-' + cat.id);
+    amounts.push({
+      category: cat.id,
+      amount: cat.is_income === 1 ? activity : Math.max(0, -activity),
+    });
+  }
+
+  await batchMessages(async () => {
+    amounts.forEach(({ category, amount }) => {
+      void setBudget({ category, month, amount });
+    });
+  });
+}
