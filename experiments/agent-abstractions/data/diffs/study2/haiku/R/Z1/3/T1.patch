+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  const templateDef = JSON.stringify([
+    {
+      type: 'simple',
+      monthly: 10,
+      limit: null,
+      priority: 0,
+      directive: 'template',
+    },
+  ]);
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-normal',
+      name: 'normal',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'in hidden group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-template',
+      name: 'template',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: templateDef,
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  async function setAllBudgets(month: string, amount: number) {
+    for (const category of [
+      'cat-normal',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-template',
+    ]) {
+      await setBudget({ category, month, amount });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('setZero leaves hidden, hidden-group and template categories untouched', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-02', 500);
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat-normal')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(500);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-cat-template')).toBe(
+      500,
+    );
+  });
+
+  it('copyPreviousMonth copies only to eligible categories', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-01', 1000);
+    await setAllBudgets('2024-02', 500);
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat-normal')).toBe(1000);
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(500);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-cat-template')).toBe(
+      500,
+    );
+  });
+
+  it('set3MonthAvg leaves template categories untouched', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-02', 500);
+
+    await set3MonthAvg({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat-template')).toBe(
+      500,
+    );
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(500);
+  });
+});
