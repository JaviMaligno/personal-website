+// Categories that month-wide actions may write to. Hidden categories, categories
+// in hidden groups, and categories managed by budget templates are left alone.
+async function getMonthWideCategories(): Promise<
+  Pick<db.DbViewCategoryWithGroupHidden, 'id' | 'is_income'>[]
+> {
+  return db.all<Pick<db.DbViewCategoryWithGroupHidden, 'id' | 'is_income'>>(
+    `
+  SELECT c.id, c.is_income
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+    AND (c.goal_def IS NULL OR c.goal_def = '')
+  `,
+  );
+}
