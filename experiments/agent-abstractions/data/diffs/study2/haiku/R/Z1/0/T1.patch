+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-visible',
+      name: 'visible',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'in hidden group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-templated',
+      name: 'templated',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: JSON.stringify([{ name: 'template', directive: 'template' }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+  }
+
+  it('setZero leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat-visible',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-templated',
+    ]) {
+      await setBudget({ category, month: '2024-04', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat-visible')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden')).toBe(500);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-hidden-group'),
+    ).toBe(500);
+    expect(await getSheetValue('budget202404', 'budget-cat-templated')).toBe(
+      500,
+    );
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat-visible',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-templated',
+    ]) {
+      await setBudget({ category, month: '2024-03', amount: 300 });
+    }
+    await setBudget({
+      category: 'cat-templated',
+      month: '2024-04',
+      amount: 900,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat-visible')).toBe(300);
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden')).toBe(0);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-hidden-group'),
+    ).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-cat-templated')).toBe(
+      900,
+    );
+  });
+
+  it('set3MonthAvg leaves templated categories untouched', async () => {
+    await setupDatabase();
+    await setBudget({
+      category: 'cat-templated',
+      month: '2024-04',
+      amount: 900,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat-templated')).toBe(
+      900,
+    );
+  });
+});
