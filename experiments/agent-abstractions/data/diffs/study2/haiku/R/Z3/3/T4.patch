+  describe('with replaceExistingLink', () => {
+    function getAccount(id: string) {
+      return db.first<{
+        name: string;
+        account_id: string | null;
+        bank: string | null;
+        account_sync_source: string | null;
+        closed: number;
+        tombstone: number;
+      }>(
+        'SELECT name, account_id, bank, account_sync_source, closed, tombstone FROM accounts WHERE id = ?',
+        [id],
+      );
+    }
+
+    it('moves the bank account to a new account and unlinks the previous holder', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+      ]);
+
+      await expect(
+        simpleFinLinkHandler({
+          externalAccount: simpleFinAccount('ext-1'),
+          replaceExistingLink: true,
+        }),
+      ).resolves.toBe('ok');
+
+      expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+      expect(await countAccounts()).toBe(2);
+      expect(await getAccount('existing')).toEqual({
+        name: 'Checking',
+        account_id: null,
+        bank: null,
+        account_sync_source: null,
+        closed: 0,
+        tombstone: 0,
+      });
+    });
+
+    it('moves the bank account into a chosen existing account', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+        { id: 'other', name: 'Savings', accountId: null },
+      ]);
+
+      await expect(
+        simpleFinLinkHandler({
+          externalAccount: simpleFinAccount('ext-1'),
+          upgradingId: 'other',
+          replaceExistingLink: true,
+        }),
+      ).resolves.toBe('ok');
+
+      expect(await getAccount('existing')).toMatchObject({
+        account_id: null,
+        bank: null,
+        account_sync_source: null,
+      });
+      expect(await getAccount('other')).toMatchObject({
+        account_id: 'ext-1',
+        account_sync_source: 'simpleFin',
+      });
+    });
+
+    it('keeps the previous holder closed when it was closed', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+      ]);
+      await db.update('accounts', { id: 'existing', closed: 1 });
+
+      await expect(
+        simpleFinLinkHandler({
+          externalAccount: simpleFinAccount('ext-1'),
+          replaceExistingLink: true,
+        }),
+      ).resolves.toBe('ok');
+
+      expect(await getAccount('existing')).toMatchObject({
+        account_id: null,
+        closed: 1,
+      });
+    });
+
+    it('still refuses to link into a closed account', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+        { id: 'other', name: 'Savings', accountId: null },
+      ]);
+      await db.update('accounts', { id: 'other', closed: 1 });
+
+      await expect(
+        simpleFinLinkHandler({
+          externalAccount: simpleFinAccount('ext-1'),
+          upgradingId: 'other',
+          replaceExistingLink: true,
+        }),
+      ).rejects.toThrow(
+        'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+      );
+
+      expect(bankSync.syncAccount).not.toHaveBeenCalled();
+      expect(await getAccount('existing')).toMatchObject({
+        account_id: 'ext-1',
+        account_sync_source: 'simpleFin',
+      });
+      expect(await getAccount('other')).toMatchObject({ account_id: null });
+    });
+
+    it('links normally when no other account holds the bank account', async () => {
+      await expect(
+        simpleFinLinkHandler({
+          externalAccount: simpleFinAccount('ext-1'),
+          replaceExistingLink: true,
+        }),
+      ).resolves.toBe('ok');
+
+      expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+      expect(await countAccounts()).toBe(1);
+    });
+
+    it('still refuses when the flag is false', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+      ]);
+
+      await expect(
+        simpleFinLinkHandler({
+          externalAccount: simpleFinAccount('ext-1'),
+          replaceExistingLink: false,
+        }),
+      ).rejects.toThrow(
+        'This bank account is already linked to another account.',
+      );
+
+      expect(bankSync.syncAccount).not.toHaveBeenCalled();
+      expect(await getAccount('existing')).toMatchObject({
+        account_id: 'ext-1',
+      });
+    });
+  });
 });
 
