+
+describe('linking a Fintegra account', () => {
+  const fintegraLinkHandler = app.handlers['fintegra-accounts-link'];
+
+  function externalFintegraAccount(
+    accountId: string,
+    overrides: { institution?: string; orgId?: string } = {},
+  ) {
+    return {
+      account_id: accountId,
+      balance: 0,
+      name: 'Everyday',
+      institution: overrides.institution ?? 'Fintegra Bank',
+      orgId: overrides.orgId ?? 'org-1',
+    };
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a bank-synced account with the Fintegra name and sync source', async () => {
+    await expect(
+      fintegraLinkHandler({
+        externalAccount: externalFintegraAccount('fg-1'),
+        offBudget: true,
+        startingDate: '2026-01-01',
+        startingBalance: 5000,
+      }),
+    ).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0',
+      ['fg-1'],
+    );
+    expect(account).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      account_sync_source: 'fintegra',
+      offbudget: 1,
+    });
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account!.bank,
+    ]);
+    expect(bank).toMatchObject({ bank_id: 'org-1', name: 'Fintegra Bank' });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      account!.id,
+      'fg-1',
+      'org-1',
+      '2026-01-01',
+      5000,
+    );
+  });
+
+  it('groups accounts under one bank per organisation and institution', async () => {
+    await fintegraLinkHandler({
+      externalAccount: externalFintegraAccount('fg-1'),
+    });
+    await fintegraLinkHandler({
+      externalAccount: externalFintegraAccount('fg-2'),
+    });
+    await fintegraLinkHandler({
+      externalAccount: externalFintegraAccount('fg-3', {
+        institution: 'Other Bank',
+      }),
+    });
+
+    const banks = await db.all<db.DbBank>(
+      'SELECT * FROM banks WHERE tombstone = 0',
+    );
+    expect(banks).toHaveLength(2);
+
+    const first = await db.first<db.DbAccount>(
+      'SELECT bank FROM accounts WHERE account_id = ?',
+      ['fg-1'],
+    );
+    const second = await db.first<db.DbAccount>(
+      'SELECT bank FROM accounts WHERE account_id = ?',
+      ['fg-2'],
+    );
+    const third = await db.first<db.DbAccount>(
+      'SELECT bank FROM accounts WHERE account_id = ?',
+      ['fg-3'],
+    );
+    expect(first!.bank).toBe(second!.bank);
+    expect(third!.bank).not.toBe(first!.bank);
+  });
+
+  it('turns an existing local account into a Fintegra-synced one', async () => {
+    await db.insertAccount({ id: 'acct1', name: 'Local' });
+
+    await expect(
+      fintegraLinkHandler({
+        externalAccount: externalFintegraAccount('fg-1'),
+        upgradingId: 'acct1',
+      }),
+    ).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(account).toMatchObject({
+      name: 'Local',
+      account_id: 'fg-1',
+      account_sync_source: 'fintegra',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      'acct1',
+      'fg-1',
+      'org-1',
+      undefined,
+      undefined,
+    );
+  });
+
+  it('refuses to link a Fintegra account already linked to another account', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      account_id: 'fg-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      fintegraLinkHandler({
+        externalAccount: externalFintegraAccount('fg-1'),
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
