+export async function assertBankAccountNotLinked({
+  provider,
+  accountId,
+  linkingAccountId,
+}: {
+  provider: string;
+  accountId: string;
+  linkingAccountId: string | undefined;
+}) {
+  const existing = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND id IS NOT ? AND tombstone = 0
+     LIMIT 1`,
+    [provider, accountId, linkingAccountId ?? null],
+  );
+
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
