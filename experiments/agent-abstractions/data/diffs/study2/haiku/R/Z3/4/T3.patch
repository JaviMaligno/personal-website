+export async function assertUpgradingAccountNotClosed(
+  upgradingId?: db.DbAccount['id'],
+) {
+  if (!upgradingId) {
+    return;
+  }
+
+  const account = await db.first<Pick<db.DbAccount, 'closed'>>(
+    'SELECT closed FROM accounts WHERE id = ?',
+    [upgradingId],
+  );
+
+  if (account?.closed === 1) {
+    throw new Error(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+  }
+}
