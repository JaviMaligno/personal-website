     expect(result.errors).toEqual([]);
   });
 });
+
+describe('linking a bank account that is already linked', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+
+  function externalSimpleFinAccount(accountId: string) {
+    return {
+      account_id: accountId,
+      balance: 0,
+      name: 'Checking',
+      institution: 'SimpleFin Bank',
+      orgDomain: 'sfin.example',
+      orgId: 'org-1',
+    };
+  }
+
+  async function countRows(table: 'accounts' | 'banks' | 'payees') {
+    const row = await db.first<{ count: number }>(
+      `SELECT count(*) as count FROM ${table} WHERE tombstone = 0`,
+    );
+    return row!.count;
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    const accountsBefore = await countRows('accounts');
+    const banksBefore = await countRows('banks');
+    const payeesBefore = await countRows('payees');
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('banks')).toBe(banksBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another existing account and leaves it unchanged', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+        upgradingId: 'acct2',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(account!.account_id).toBeNull();
+    expect(account!.account_sync_source).toBeNull();
+    expect(account!.bank).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link is on a closed account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', closed: 1 });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the existing link is on a deleted account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', tombstone: 1 });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+      }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+      }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+        upgradingId: 'acct1',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
