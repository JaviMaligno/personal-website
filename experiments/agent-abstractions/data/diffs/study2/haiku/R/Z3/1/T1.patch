+export async function assertBankAccountNotLinked({
+  provider,
+  accountId,
+  upgradingId,
+}: {
+  provider: AccountSyncSource;
+  accountId: string;
+  upgradingId?: string;
+}) {
+  const existing = await db.first<Pick<db.DbAccount, 'id'>>(
+    'SELECT id FROM accounts WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0 AND id IS NOT ?',
+    [provider, accountId, upgradingId ?? null],
+  );
+
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
