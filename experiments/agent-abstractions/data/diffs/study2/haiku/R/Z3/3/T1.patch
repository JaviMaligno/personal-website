+
+describe('linking a bank account that is already linked', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+
+  function simpleFinAccount(accountId: string) {
+    return {
+      balance: 0,
+      account_id: accountId,
+      institution: 'Bank',
+      orgDomain: 'bank.example',
+      name: 'Checking',
+    };
+  }
+
+  function countAccounts() {
+    return db
+      .first<{ count: number }>('SELECT count(*) as count FROM accounts')
+      .then(row => row?.count);
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(await countAccounts()).toBe(1);
+  });
+
+  it('refuses to link into another account when the bank account is linked elsewhere', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+      { id: 'other', name: 'Savings', accountId: null },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'other',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    const other = await db.first<{ account_id: string | null }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['other'],
+    );
+    expect(other?.account_id).toBeNull();
+  });
+
+  it('refuses when the existing link is on a closed account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'existing', closed: 1 });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the existing link is on a deleted account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'existing', tombstone: 1 });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'existing',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await db.insertAccount({
+      id: 'gc-account',
+      name: 'GoCardless Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
