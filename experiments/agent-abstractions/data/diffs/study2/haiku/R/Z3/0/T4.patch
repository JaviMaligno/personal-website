@@ -594,4 +594,107 @@ describe('linking a bank account', () => {
     ).resolves.toBe('ok');
     expect(bankSync.syncAccount).toHaveBeenCalled();
   });
+
+  it('moves a bank account from its previous holder when replacing the link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    const previous = await db.first<{
+      account_id: string | null;
+      bank: string | null;
+      account_sync_source: string | null;
+      tombstone: number;
+    }>(
+      'SELECT account_id, bank, account_sync_source, tombstone FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(previous).toEqual({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      tombstone: 0,
+    });
+    expect(await countAccounts()).toBe(2);
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('moves a bank account into an existing account when replacing the link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'acct2',
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    const holder = await db.first<{ account_id: string | null }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    const linked = await db.first<{ account_id: string | null }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(holder!.account_id).toBeNull();
+    expect(linked!.account_id).toBe('ext-1');
+  });
+
+  it('keeps a closed holder closed when replacing the link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    const holder = await db.first<{
+      closed: number;
+      account_id: string | null;
+    }>('SELECT closed, account_id FROM accounts WHERE id = ?', ['acct1']);
+    expect(holder!.closed).toBe(1);
+    expect(holder!.account_id).toBeNull();
+  });
+
+  it('still refuses linking into a closed account when replacing the link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct2']);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'acct2',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    const holder = await db.first<{ account_id: string | null }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(holder!.account_id).toBe('ext-1');
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
 });
