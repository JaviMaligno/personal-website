+
+describe('bank account link uniqueness', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    balance: 0,
+    account_id: 'sfin-acct-1',
+    name: 'Checking',
+    institution: 'SimpleFin Bank',
+    orgDomain: 'sfin.example',
+    orgId: 'sfin-org',
+  };
+  const alreadyLinked =
+    'This bank account is already linked to another account.';
+
+  async function countRows(table: 'accounts' | 'payees') {
+    const row = await db.first<{ n: number }>(
+      `SELECT count(*) AS n FROM ${table} WHERE tombstone = 0`,
+    );
+    return row!.n;
+  }
+
+  beforeEach(async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing',
+      account_id: 'sfin-acct-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+
+  it('refuses to link a bank account that is already linked to a new account', async () => {
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      alreadyLinked,
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link a bank account into a different account and leaves that account unchanged', async () => {
+    await db.insertAccount({ id: 'other', name: 'Other' });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'other' }),
+    ).rejects.toThrow(alreadyLinked);
+
+    const other = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['other'],
+    );
+    expect(other!.account_id).toBeNull();
+    expect(other!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('still refuses when the holding account is closed', async () => {
+    await db.update('accounts', { id: 'existing', closed: 1 });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      alreadyLinked,
+    );
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    const result = await simpleFinLinkHandler({
+      externalAccount,
+      upgradingId: 'existing',
+    });
+
+    expect(result).toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('does not count a deleted account as holding the link', async () => {
+    await db.update('accounts', { id: 'existing', tombstone: 1 });
+
+    const result = await simpleFinLinkHandler({ externalAccount });
+
+    expect(result).toBe('ok');
+  });
+
+  it('does not treat the same account id under a different provider as linked', async () => {
+    const result = await app.handlers['akahu-accounts-link']({
+      externalAccount: { ...externalAccount, institution: 'Akahu Bank' },
+    });
+
+    expect(result).toBe('ok');
+  });
+});
