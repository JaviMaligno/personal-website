+
+export async function assertBankAccountNotLinked({
+  provider,
+  externalAccountId,
+  upgradingId,
+}: {
+  provider: string;
+  externalAccountId: string;
+  upgradingId?: db.DbAccount['id'];
+}) {
+  const holders = await db.all<Pick<db.DbAccount, 'id'>>(
+    'SELECT id FROM accounts WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0',
+    [provider, externalAccountId],
+  );
+
+  if (holders.some(holder => holder.id !== upgradingId)) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
