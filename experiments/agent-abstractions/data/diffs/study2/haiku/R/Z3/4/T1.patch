+
+describe('linking a bank account that is already linked', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+
+  function externalSimpleFinAccount(accountId: string) {
+    return {
+      account_id: accountId,
+      name: 'Checking',
+      institution: 'Bank',
+      orgId: 'org-1',
+      orgDomain: 'bank.example',
+      balance: 0,
+    };
+  }
+
+  async function countRows(table: 'accounts' | 'payees' | 'banks') {
+    const row = await db.first<{ count: number }>(
+      `SELECT count(*) as count FROM ${table} WHERE tombstone = 0`,
+    );
+    return row!.count;
+  }
+
+  beforeEach(async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Bank' });
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    await db.insertAccount({
+      id: 'empty',
+      name: 'Empty',
+    });
+  });
+
+  it('refuses a new account for a bank account that is already linked', async () => {
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses linking an existing account to a bank account held by another account', async () => {
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+        upgradingId: 'empty',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const empty = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['empty'],
+    );
+    expect(empty!.account_id).toBeNull();
+    expect(empty!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the holding account is closed', async () => {
+    await db.update('accounts', { id: 'holder', closed: 1 });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the holding account is deleted', async () => {
+    await db.update('accounts', { id: 'holder', tombstone: 1 });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+      }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(
+      app.handlers['akahu-accounts-link']({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+      }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+        upgradingId: 'holder',
+      }),
+    ).resolves.toBe('ok');
+  });
+});
