+
+describe('assertBankAccountNotLinked', () => {
+  async function insertLocalAccount({
+    id,
+    closed,
+    accountId,
+  }: {
+    id: string;
+    closed: 0 | 1;
+    accountId?: string;
+  }) {
+    await db.insertAccount({
+      id,
+      name: id,
+      closed,
+      ...(accountId && {
+        account_id: accountId,
+        account_sync_source: 'simpleFin',
+      }),
+    });
+  }
+
+  it('refuses to link into a closed account', async () => {
+    await insertLocalAccount({ id: 'closed-acct', closed: 1 });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        linkingAccountId: 'closed-acct',
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+  });
+
+  it('refuses to re-link a closed account that already holds the link', async () => {
+    await insertLocalAccount({
+      id: 'closed-linked',
+      closed: 1,
+      accountId: 'ext-1',
+    });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        linkingAccountId: 'closed-linked',
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+  });
+
+  it('allows linking into an open account', async () => {
+    await insertLocalAccount({ id: 'open-acct', closed: 0 });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        linkingAccountId: 'open-acct',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('allows linking a new account when no account is being upgraded', async () => {
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        linkingAccountId: undefined,
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('still refuses a bank account already linked to a different account', async () => {
+    await insertLocalAccount({
+      id: 'other-acct',
+      closed: 0,
+      accountId: 'ext-1',
+    });
+    await insertLocalAccount({ id: 'open-acct', closed: 0 });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        linkingAccountId: 'open-acct',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+});
