 });
+
+describe('linking a bank account', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+
+  function simpleFinAccount(accountId: string) {
+    return {
+      account_id: accountId,
+      name: 'Checking',
+      balance: 0,
+      institution: 'Test Bank',
+      orgId: 'test-org',
+    };
+  }
+
+  async function countAccounts() {
+    const row = await db.first<{ count: number }>(
+      'SELECT COUNT(*) as count FROM accounts',
+    );
+    return row!.count;
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses a new account for a bank account that is already linked', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await countAccounts()).toBe(1);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses linking an existing account to a bank account held by another account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'acct2',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const acct2 = await db.first<{
+      account_id: string | null;
+      bank: string | null;
+    }>('SELECT account_id, bank FROM accounts WHERE id = ?', ['acct2']);
+    expect(acct2!.account_id).toBeNull();
+    expect(acct2!.bank).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('still refuses when the holding account is closed', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking a bank account whose previous holder was deleted', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'pluggyai',
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'acct1',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
