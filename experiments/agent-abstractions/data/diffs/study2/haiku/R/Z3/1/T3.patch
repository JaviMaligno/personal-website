+describe('assertCanLinkBankAccount', () => {
+  const closedError =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+  async function insertAccount(id: string, closed: 0 | 1, accountId: string) {
+    await db.insertWithUUID('accounts', {
+      id,
+      name: 'Checking',
+      offbudget: 0,
+      closed,
+      account_id: accountId,
+      account_sync_source: 'simpleFin',
+    });
+  }
+
+  it('allows linking a new account', async () => {
+    await expect(
+      assertCanLinkBankAccount({ provider: 'simpleFin', accountId: 'ext-1' }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('refuses to link into a closed account', async () => {
+    await insertAccount('closed-acc', 1, 'ext-old');
+
+    await expect(
+      assertCanLinkBankAccount({
+        provider: 'simpleFin',
+        accountId: 'ext-new',
+        upgradingId: 'closed-acc',
+      }),
+    ).rejects.toThrow(closedError);
+  });
+
+  it('refuses to re-link a closed account that already holds the link', async () => {
+    await insertAccount('closed-acc', 1, 'ext-1');
+
+    await expect(
+      assertCanLinkBankAccount({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: 'closed-acc',
+      }),
+    ).rejects.toThrow(closedError);
+  });
+
+  it('allows linking into an open account', async () => {
+    await insertAccount('open-acc', 0, 'ext-old');
+
+    await expect(
+      assertCanLinkBankAccount({
+        provider: 'simpleFin',
+        accountId: 'ext-new',
+        upgradingId: 'open-acc',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('allows linking once the account is reopened', async () => {
+    await insertAccount('acc', 1, 'ext-1');
+    await db.update('accounts', { id: 'acc', closed: 0 });
+
+    await expect(
+      assertCanLinkBankAccount({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: 'acc',
+      }),
+    ).resolves.toBeUndefined();
+  });
+});
+
