@@ -540,4 +540,58 @@ describe('linking a bank account', () => {
     ).resolves.toBe('ok');
     expect(bankSync.syncAccount).toHaveBeenCalled();
   });
+
+  it('refuses linking into a closed account', async () => {
+    await db.insertAccount({ id: 'acct1', name: 'Savings' });
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'acct1',
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    const acct1 = await db.first<{
+      account_id: string | null;
+      bank: string | null;
+    }>('SELECT account_id, bank FROM accounts WHERE id = ?', ['acct1']);
+    expect(acct1!.account_id).toBeNull();
+    expect(acct1!.bank).toBeNull();
+    expect(await countAccounts()).toBe(1);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses re-linking when the closed account already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'acct1',
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows linking into an account once it is reopened', async () => {
+    await db.insertAccount({ id: 'acct1', name: 'Savings' });
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+    db.runQuery('UPDATE accounts SET closed = 0 WHERE id = ?', ['acct1']);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'acct1',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
 });
