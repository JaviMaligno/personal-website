     expect(result.errors).toEqual([]);
   });
 });
+
+describe('linking a bank account', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+  const goCardlessLinkHandler = app.handlers['gocardless-accounts-link'];
+
+  const externalAccount = (accountId: string) => ({
+    account_id: accountId,
+    name: 'Checking',
+    institution: 'Bank',
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+    balance: 0,
+  });
+
+  async function countRows(table: 'accounts' | 'payees') {
+    const row = await db.first<{ n: number }>(
+      `SELECT count(*) as n FROM ${table} WHERE tombstone = 0`,
+    );
+    return row.n;
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses to link a bank account that is already linked to another account', async () => {
+    await simpleFinLinkHandler({ externalAccount: externalAccount('ext-1') });
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+    vi.mocked(bankSync.syncAccount).mockClear();
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: externalAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into an existing account when another account holds the bank account', async () => {
+    await simpleFinLinkHandler({ externalAccount: externalAccount('ext-1') });
+    await db.insertAccount({ id: 'target', name: 'Target' });
+    const targetBefore = await db.first<{ account_id: string | null }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['target'],
+    );
+    vi.mocked(bankSync.syncAccount).mockClear();
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalAccount('ext-1'),
+        upgradingId: 'target',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const targetAfter = await db.first<{ account_id: string | null }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['target'],
+    );
+    expect(targetAfter).toEqual(targetBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('still allows re-linking into the account that already holds the bank account', async () => {
+    await simpleFinLinkHandler({ externalAccount: externalAccount('ext-1') });
+    const holder = await db.first<{ id: string }>(
+      'SELECT id FROM accounts WHERE account_id = ?',
+      ['ext-1'],
+    );
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalAccount('ext-1'),
+        upgradingId: holder.id,
+      }),
+    ).resolves.toBe('ok');
+  });
+
+  it('refuses when the holding account is closed', async () => {
+    await simpleFinLinkHandler({ externalAccount: externalAccount('ext-1') });
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE account_id = ?', [
+      'ext-1',
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: externalAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the holding account was deleted', async () => {
+    await simpleFinLinkHandler({ externalAccount: externalAccount('ext-1') });
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE account_id = ?', [
+      'ext-1',
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: externalAccount('ext-1') }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await simpleFinLinkHandler({ externalAccount: externalAccount('ext-1') });
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-1',
+        account: {
+          account_id: 'ext-1',
+          name: 'Checking',
+          official_name: 'Checking',
+          mask: '1234',
+          balance: 0,
+          institution: { name: 'Bank' },
+        },
+      }),
+    ).resolves.toBe('ok');
+  });
+});
