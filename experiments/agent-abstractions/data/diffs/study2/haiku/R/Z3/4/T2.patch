+describe('linking a Fintegra account', () => {
+  const fintegraLinkHandler = app.handlers['fintegra-accounts-link'];
+
+  function externalFintegraAccount(accountId: string) {
+    return {
+      account_id: accountId,
+      name: 'Savings',
+      institution: 'Fin Bank',
+      orgId: 'fin-org-1',
+      balance: 0,
+    };
+  }
+
+  beforeEach(async () => {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+    await db.insertAccount({
+      id: 'empty',
+      name: 'Empty',
+    });
+  });
+
+  it('creates a Fintegra-synced account grouped under its organisation and imports from the chosen date', async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(
+      fintegraLinkHandler({
+        externalAccount: externalFintegraAccount('fin-2'),
+        startingDate: '2024-01-01',
+        startingBalance: 1000,
+      }),
+    ).resolves.toBe('ok');
+
+    const created = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0',
+      ['fin-2'],
+    );
+    expect(created!.account_sync_source).toBe('fintegra');
+    expect(created!.name).toBe('Savings');
+    expect(created!.official_name).toBe('Savings');
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      created!.bank,
+    ]);
+    expect(bank!.bank_id).toBe('fin-org-1');
+    expect(bank!.name).toBe('Fin Bank');
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      created!.id,
+      'fin-2',
+      'fin-org-1',
+      '2024-01-01',
+      1000,
+    );
+  });
+
+  it('refuses a Fintegra bank account that another local account already holds', async () => {
+    await expect(
+      fintegraLinkHandler({
+        externalAccount: externalFintegraAccount('fin-1'),
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
