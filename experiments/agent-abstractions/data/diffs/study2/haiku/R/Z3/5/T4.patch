 });
+
+describe('simplefin-accounts-link replaceExistingLink', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    balance: 0,
+    institution: 'SimpleFin Bank',
+    orgDomain: 'sfin.example',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  async function getAccount(id: string) {
+    return db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [id]);
+  }
+
+  it('moves the bank account to a new account and unlinks the holder', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    const holder = await getAccount('acct1');
+    expect(holder).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      tombstone: 0,
+    });
+    const linked = await db.all<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0',
+      ['simpleFin', 'ext-1'],
+    );
+    expect(linked).toHaveLength(1);
+    expect(linked[0].id).not.toBe('acct1');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('moves the bank account into a chosen existing account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      { id: 'acct2', name: 'Savings', accountId: null },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount,
+        upgradingId: 'acct2',
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(await getAccount('acct1')).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+    });
+    expect(await getAccount('acct2')).toMatchObject({
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+
+  it('keeps the holder open or closed as it was', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    expect(await getAccount('acct1')).toMatchObject({
+      closed: 1,
+      account_id: null,
+    });
+  });
+
+  it('links as usual when no other account holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Savings', accountId: null },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount,
+        upgradingId: 'acct1',
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(await getAccount('acct1')).toMatchObject({
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+
+  it('still refuses without the flag', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    const before = await db.all('SELECT * FROM accounts ORDER BY id');
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: false }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await db.all('SELECT * FROM accounts ORDER BY id')).toEqual(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('still refuses to link into a closed account and changes nothing', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      { id: 'acct2', name: 'Savings', accountId: null },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct2']);
+    const before = await db.all('SELECT * FROM accounts ORDER BY id');
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount,
+        upgradingId: 'acct2',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await db.all('SELECT * FROM accounts ORDER BY id')).toEqual(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
