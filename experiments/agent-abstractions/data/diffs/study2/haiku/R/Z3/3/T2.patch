+
+describe('linking a Fintegra account', () => {
+  const fintegraLinkHandler = app.handlers['fintegra-accounts-link'];
+
+  function fintegraAccount(accountId: string) {
+    return {
+      account_id: accountId,
+      name: 'Checking',
+      institution: 'Bank',
+      orgId: 'org-1',
+      balance: 0,
+    };
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a bank-synced account named after the Fintegra account', async () => {
+    await expect(
+      fintegraLinkHandler({
+        externalAccount: fintegraAccount('ext-1'),
+        offBudget: true,
+        startingDate: '2024-01-01',
+        startingBalance: 1000,
+      }),
+    ).resolves.toBe('ok');
+
+    const acct = await db.first<{
+      name: string;
+      official_name: string;
+      account_sync_source: string;
+      offbudget: number;
+      bank_id: string;
+      bank_name: string;
+    }>(
+      `SELECT a.name, a.official_name, a.account_sync_source, a.offbudget,
+              b.bank_id, b.name AS bank_name
+       FROM accounts a JOIN banks b ON a.bank = b.id
+       WHERE a.account_id = ?`,
+      ['ext-1'],
+    );
+    expect(acct).toEqual({
+      name: 'Checking',
+      official_name: 'Checking',
+      account_sync_source: 'fintegra',
+      offbudget: 1,
+      bank_id: 'org-1',
+      bank_name: 'Bank',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      expect.any(String),
+      'ext-1',
+      'org-1',
+      '2024-01-01',
+      1000,
+    );
+  });
+
+  it('groups accounts under one bank per organisation and institution', async () => {
+    await fintegraLinkHandler({ externalAccount: fintegraAccount('ext-1') });
+    await fintegraLinkHandler({ externalAccount: fintegraAccount('ext-2') });
+
+    const banks = await db.all<{ id: string }>(
+      'SELECT id FROM banks WHERE bank_id = ? AND name = ? AND tombstone = 0',
+      ['org-1', 'Bank'],
+    );
+    expect(banks).toHaveLength(1);
+  });
+
+  it('upgrades an existing local account into a Fintegra-synced account', async () => {
+    await db.insertAccount({ id: 'local', name: 'Cash' });
+
+    await expect(
+      fintegraLinkHandler({
+        externalAccount: fintegraAccount('ext-1'),
+        upgradingId: 'local',
+      }),
+    ).resolves.toBe('ok');
+
+    const acct = await db.first<{
+      account_id: string;
+      account_sync_source: string;
+    }>('SELECT account_id, account_sync_source FROM accounts WHERE id = ?', [
+      'local',
+    ]);
+    expect(acct).toEqual({
+      account_id: 'ext-1',
+      account_sync_source: 'fintegra',
+    });
+  });
+
+  it('refuses to link a Fintegra account already linked to another account', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      fintegraLinkHandler({ externalAccount: fintegraAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
