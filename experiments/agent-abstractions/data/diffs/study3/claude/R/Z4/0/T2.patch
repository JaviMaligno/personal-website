+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}) {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    // Weekend adjustment moves an occurrence by at most 2 days, so widen the
+    // search and decide membership on the adjusted day.
+    const from = d.startOfDay(d.subDays(parseDate(start), 3));
+    const to = d.endOfDay(d.addDays(parseDate(end), 3));
+
+    const days = schedule
+      .occurrences({ start: from, end: to })
+      .toArray()
+      .filter(o => !isDailyWeekendSkip(config) || !d.isWeekend(o.date))
+      .map(o =>
+        config.skipWeekend && !isDailyWeekendSkip(config)
+          ? getDateWithSkippedWeekend(
+              o.date,
+              config.weekendSolveMode ?? 'after',
+            )
+          : o.date,
+      )
+      .map(date => dayFromDate(date))
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort((a, b) => a.localeCompare(b));
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
