+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+    // Weekend handling moves an occurrence by at most two days, so look
+    // slightly outside the period and decide on the final day.
+    const found = schedule
+      .occurrences({
+        start: d.subDays(d.startOfDay(parseDate(start)), 2),
+        end: d.addDays(d.endOfDay(parseDate(end)), 2),
+      })
+      .toArray();
+
+    const days = new Set<string>();
+    for (const { date } of found) {
+      if (config.skipWeekend) {
+        if (config.frequency === 'daily') {
+          if (d.isWeekend(date)) continue;
+          days.add(dayFromDate(date));
+          continue;
+        }
+        days.add(
+          dayFromDate(
+            getDateWithSkippedWeekend(date, config.weekendSolveMode ?? 'after'),
+          ),
+        );
+      } else {
+        days.add(dayFromDate(date));
+      }
+    }
+
+    return [...days].filter(day => day >= start && day <= end).sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
