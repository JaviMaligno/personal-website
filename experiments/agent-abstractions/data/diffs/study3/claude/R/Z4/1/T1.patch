+// A daily schedule with an interval that is a multiple of 7 can land on the
+// same weekday forever, so the search is bounded.
+const MAX_WEEKDAY_SEARCH = 14;
+
+export function findWeekdayOccurrence(
+  schedule,
+  options: { start?: Date; reverse?: boolean },
+): Date | null {
+  const occurrences = schedule.occurrences({
+    ...options,
+    take: MAX_WEEKDAY_SEARCH,
+  });
+  for (const occurrence of occurrences) {
+    if (!d.isWeekend(occurrence.date)) {
+      return occurrence.date;
+    }
+  }
+  return null;
+}
