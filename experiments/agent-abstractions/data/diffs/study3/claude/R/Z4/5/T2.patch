+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: Parameters<typeof recurConfigToRSchedule>[0];
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+  const rangeStart = d.startOfDay(parseDate(start));
+  const rangeEnd = d.startOfDay(parseDate(end));
+  const result = new Set<string>();
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    // Weekend adjustment moves an occurrence by at most 2 days, so look a bit
+    // outside of the period and decide on the final day.
+    const iterator = schedule.occurrences({
+      start: d.subDays(rangeStart, 3),
+    });
+    for (const occurrence of iterator) {
+      if (occurrence.date >= d.addDays(rangeEnd, 4)) break;
+
+      let date = occurrence.date;
+      if (config.skipWeekend) {
+        if (config.frequency === 'daily') {
+          if (d.isWeekend(date)) continue;
+        } else {
+          date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        }
+      }
+
+      const day = d.startOfDay(date);
+      if (day >= rangeStart && day <= rangeEnd) {
+        result.add(dayFromDate(day));
+      }
+    }
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+
+  return [...result].sort();
+}
+
