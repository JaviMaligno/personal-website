+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: Parameters<typeof recurConfigToRSchedule>[0];
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const skipsWeekendDays = config.skipWeekend && config.frequency === 'daily';
+
+    // A weekend adjustment moves a date by at most two days, so look a
+    // little beyond the period on both sides
+    const margin = 3;
+    const days = new Set<string>();
+    for (const occ of schedule
+      .occurrences({
+        start: d.subDays(d.startOfDay(parseDate(start)), margin),
+        end: d.addDays(d.endOfDay(parseDate(end)), margin),
+      })
+      .toArray()) {
+      let date = occ.date;
+      if (config.skipWeekend) {
+        if (skipsWeekendDays) {
+          if (d.isWeekend(date)) continue;
+        } else {
+          date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        }
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) days.add(day);
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
