+describe('schedule/get-dates-in-range', () => {
+  const run = (config, start, end) => getDatesInRange({ config, start, end });
+  const base = {
+    start: '2024-01-01',
+    frequency: 'monthly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: true,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('includes occurrences moved into the period and excludes those moved out', async () => {
+    // 2024-06-01 is a Saturday -> Monday 2024-06-03
+    expect(await run(base, '2024-06-03', '2024-06-30')).toEqual(['2024-06-03']);
+    expect(await run(base, '2024-05-25', '2024-06-02')).toEqual([]);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    const daily = { ...base, frequency: 'daily', start: '2024-06-01' };
+    expect(await run(daily, '2024-06-01', '2024-06-04')).toEqual([
+      '2024-06-03',
+      '2024-06-04',
+    ]);
+  });
+
+  it('lists each day once', async () => {
+    const weekly = { ...base, frequency: 'daily', skipWeekend: false };
+    const r = await run(weekly, '2024-06-01', '2024-06-03');
+    expect(r).toEqual(['2024-06-01', '2024-06-02', '2024-06-03']);
+  });
+});
