+// Holidays are either `YYYY-MM-DD` (that day only) or `MM-DD` (every year).
+export function createHolidayChecker(holidays?: readonly string[]) {
+  const holidaySet = new Set<string>(holidays ?? []);
+  return (date: Date) => {
+    const day = monthUtils.dayFromDate(date);
+    return holidaySet.has(day) || holidaySet.has(day.slice(5));
+  };
