+describe('createHolidayChecker', () => {
+  it('matches MM-DD every year and YYYY-MM-DD only once', () => {
+    const isHoliday = createHolidayChecker(['12-25', '2024-07-04']);
+    expect(isHoliday(new Date(2024, 11, 25))).toBe(true);
+    expect(isHoliday(new Date(2031, 11, 25))).toBe(true);
+    expect(isHoliday(new Date(2024, 6, 4))).toBe(true);
+    expect(isHoliday(new Date(2025, 6, 4))).toBe(false);
+  });
+
+  it('moves a weekend-skipping date past a yearly holiday', () => {
+    // 2026-12-25 is a Friday
+    const result = getDateWithSkippedWeekend(new Date(2026, 11, 25), 'after', [
+      '12-25',
+    ]);
+    expect(monthUtils.dayFromDate(result)).toBe('2026-12-28');
+  });
+});
