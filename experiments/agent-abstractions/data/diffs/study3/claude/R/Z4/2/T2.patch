+describe('schedule/get-dates-in-range', () => {
+  const base = {
+    start: '2024-01-01',
+    frequency: 'weekly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: false,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+  const call = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences by their final day', async () => {
+    // Saturdays: 2024-01-06, 01-13
+    const config = {
+      ...base,
+      start: '2024-01-06',
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await call(config, '2024-01-08', '2024-01-14')).toEqual([
+      '2024-01-08',
+    ]);
+    expect(await call(config, '2024-01-06', '2024-01-07')).toEqual([]);
+    expect(
+      await call(
+        { ...config, weekendSolveMode: 'before' },
+        '2024-01-05',
+        '2024-01-05',
+      ),
+    ).toEqual(['2024-01-05']);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    const config = { ...base, frequency: 'daily', skipWeekend: true };
+    expect(await call(config, '2024-01-05', '2024-01-09')).toEqual([
+      '2024-01-05',
+      '2024-01-08',
+      '2024-01-09',
+    ]);
+  });
+});
