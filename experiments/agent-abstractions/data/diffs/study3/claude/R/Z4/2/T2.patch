+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: Parameters<typeof recurConfigToRSchedule>[0];
+  start: string;
+  end: string;
+}) {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+    const skipsDailyWeekends =
+      config.skipWeekend && config.frequency === 'daily';
+
+    // Weekend occurrences move by at most two days, so look a bit beyond the
+    // period and decide on the final day.
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.endOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray();
+
+    const days = new Set<string>();
+    for (const { date } of occurrences) {
+      if (skipsDailyWeekends && d.isWeekend(date)) {
+        continue;
+      }
+      const final =
+        config.skipWeekend && !skipsDailyWeekends
+          ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+          : date;
+      const day = dayFromDate(final);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
