+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: Parameters<typeof recurConfigToRSchedule>[0];
+  start: string;
+  end: string;
+}) {
+  try {
+    const schedule = new RSchedule({
+      rrules: recurConfigToRSchedule(config),
+      exrules: recurConfigToExcludedRules(config),
+    });
+
+    // Weekend adjustment moves an occurrence by at most 2 days, so look a
+    // little beyond the period and filter on the adjusted day.
+    const days = new Set<string>();
+    schedule
+      .occurrences({
+        start: d.subDays(d.startOfDay(parseDate(start)), 3),
+        end: d.addDays(d.endOfDay(parseDate(end)), 3),
+      })
+      .toArray()
+      .forEach(occurrence => {
+        const date = config.skipWeekend
+          ? getDateWithSkippedWeekend(occurrence.date, config.weekendSolveMode)
+          : occurrence.date;
+        const day = dayFromDate(date);
+        if (day >= start && day <= end) {
+          days.add(day);
+        }
+      });
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
