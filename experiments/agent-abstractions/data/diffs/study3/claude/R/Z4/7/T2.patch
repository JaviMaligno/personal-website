+describe('schedule/get-dates-in-range', () => {
+  const call = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences by their final day', async () => {
+    // 2026-10-03 is a Saturday, 2026-10-04 a Sunday
+    const config = {
+      start: '2026-10-03',
+      frequency: 'weekly',
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await call(config, '2026-10-05', '2026-10-05')).toEqual([
+      '2026-10-05',
+    ]);
+    expect(await call(config, '2026-10-02', '2026-10-04')).toEqual([]);
+  });
+
+  it('skips weekend days for daily schedules', async () => {
+    const config = {
+      start: '2026-10-01',
+      frequency: 'daily',
+      skipWeekend: true,
+    };
+    expect(await call(config, '2026-10-02', '2026-10-06')).toEqual([
+      '2026-10-02',
+      '2026-10-05',
+      '2026-10-06',
+    ]);
+  });
+});
