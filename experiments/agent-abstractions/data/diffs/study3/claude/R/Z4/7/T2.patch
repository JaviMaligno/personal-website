+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const skipDaily = config.skipWeekend && config.frequency === 'daily';
+
+    // Weekend adjustment moves an occurrence by at most 2 days, so look
+    // slightly outside the period and filter on the final day.
+    const days = new Set<string>();
+    schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.endOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray()
+      .forEach(occurrence => {
+        if (skipDaily && d.isWeekend(occurrence.date)) {
+          return;
+        }
+        const date = config.skipWeekend
+          ? getDateWithSkippedWeekend(
+              occurrence.date,
+              config.weekendSolveMode ?? 'after',
+            )
+          : occurrence.date;
+        const day = dayFromDate(date);
+        if (day >= start && day <= end) {
+          days.add(day);
+        }
+      });
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
