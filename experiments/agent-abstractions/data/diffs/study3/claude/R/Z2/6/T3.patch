+// The amount a schedule is planned at: a ranged ("is between") amount at the
+// end furthest from zero, an approximate amount at the end of its tolerance
+// furthest from zero, and any other amount as is.
+export function getExpectedAmount(
+  amount: number | { num1: number; num2: number },
+  op?: string,
+): number {
+  if (typeof amount !== 'number') {
+    return getWorstCaseAmount(amount);
+  }
+  if (op === 'isapprox') {
+    const threshold = getApproxNumberThreshold(amount);
+    return amount < 0 ? amount - threshold : amount + threshold;
+  }
+  return amount;
+}
