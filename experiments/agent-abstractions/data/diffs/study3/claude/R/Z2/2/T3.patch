+// The amount a schedule is planned at: a ranged ("is between") amount at the
+// end of the range furthest from zero, an approximate amount at the end of its
+// matching tolerance furthest from zero, anything else as is. A missing amount
+// is 0.
+export function getExpectedAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getWorstCaseAmount(amount);
+  if (op === 'isapprox') {
+    const threshold = getApproxNumberThreshold(amount);
+    return amount < 0 ? amount - threshold : amount + threshold;
+  }
+  return amount;
+}
