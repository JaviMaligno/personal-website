+// The amount a schedule is planned at: a ranged amount at the end of its range
+// furthest from zero, an approximate amount at the end of its tolerance
+// furthest from zero, anything else as is.
+export function getExpectedAmount(
+  amount: number | { num1: number; num2: number },
+  op?: string | null,
+): number {
+  if (typeof amount !== 'number') {
+    return getWorstCaseAmount(amount);
+  }
+  if (op === 'isapprox') {
+    return amount + Math.sign(amount) * getApproxNumberThreshold(amount);
+  }
+  return amount;
+}
