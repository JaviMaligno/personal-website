diff --git a/packages/loot-core/src/server/accounts/link-closed.test.ts b/packages/loot-core/src/server/accounts/link-closed.test.ts
new file mode 100644
index 0000000..d247390
--- /dev/null
+++ b/packages/loot-core/src/server/accounts/link-closed.test.ts
@@ -0,0 +1,66 @@
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+const closedError =
+  'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+const externalAccount = {
+  account_id: 'ext-1',
+  name: 'Ext',
+  institution: 'Bank',
+  orgDomain: 'bank.example',
+  balance: 0,
+} as never;
+
+describe('linking a bank account to a closed account', () => {
+  it('refuses and changes nothing', async () => {
+    await db.insertAccount({ id: 'acct1', name: 'Closed', closed: 1 });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+      } as never),
+    ).rejects.toThrow(closedError);
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(await db.all('SELECT * FROM banks')).toEqual([]);
+    const row = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(row?.account_sync_source).toBeNull();
+  });
+
+  it('refuses re-linking a closed account that holds the link', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Closed',
+      closed: 1,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+      } as never),
+    ).rejects.toThrow(closedError);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
