 });
+
+describe('replaceExistingLink', () => {
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Bank',
+    institution: 'Inst',
+    orgDomain: 'inst.example',
+    orgId: 'org',
+    balance: 0,
+  };
+
+  async function insertLinked(closed = 0) {
+    await db.insertAccount({ id: 'old', name: 'Old', closed });
+    db.runQuery(
+      "UPDATE accounts SET account_id = 'ext-1', account_sync_source = 'simpleFin' WHERE id = 'old'",
+    );
+  }
+
+  it('is refused without the flag', async () => {
+    await insertLinked();
+    await expect(
+      app.handlers['simplefin-accounts-link']({ externalAccount } as never),
+    ).rejects.toThrow('already linked');
+  });
+
+  it('unlinks the previous holder', async () => {
+    await insertLinked(1);
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+    await app.handlers['simplefin-accounts-link']({
+      externalAccount,
+      replaceExistingLink: true,
+    } as never);
+
+    const old = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['old'],
+    );
+    expect(old.account_id).toBeNull();
+    expect(old.account_sync_source).toBeNull();
+    expect(old.bank).toBeNull();
+    expect(old.closed).toBe(1);
+    const linked = await db.all(
+      "SELECT id FROM accounts WHERE account_id = 'ext-1' AND tombstone = 0",
+    );
+    expect(linked).toHaveLength(1);
+  });
+
+  it('does not lift the closed-account rule', async () => {
+    await insertLinked();
+    await db.insertAccount({ id: 'closed', name: 'Closed', closed: 1 });
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'closed',
+        replaceExistingLink: true,
+      } as never),
+    ).rejects.toThrow('Closed accounts');
+    const old = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['old'],
+    );
+    expect(old.account_id).toBe('ext-1');
+  });
+});
