+async function assertNotClosed(upgradingId?: string) {
+  if (!upgradingId) return;
+  const row = await db.first<{ closed: number }>(
+    'SELECT closed FROM accounts WHERE id = ? AND tombstone = 0',
+    [upgradingId],
+  );
+  if (row?.closed === 1) {
+    throw new Error(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+  }
+}
