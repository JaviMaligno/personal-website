+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getFillableCategories();
+  const { start, end } = monthUtils.bounds(monthUtils.prevMonth(month));
+
+  // Query transactions directly: the previous month's sheet may not exist
+  const rows = await db.all<{ category: string; amount: number }>(
+    `SELECT t.category AS category, SUM(t.amount) AS amount
+       FROM v_transactions_internal_alive t
+       LEFT JOIN accounts a ON a.id = t.account
+      WHERE t.date >= ? AND t.date <= ? AND a.offbudget = 0
+        AND t.category IS NOT NULL
+      GROUP BY t.category`,
+    [start, end],
+  );
+  const totals = new Map(rows.map(row => [row.category, row.amount ?? 0]));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      let amount = totals.get(cat.id) ?? 0;
+      if (cat.is_income === 0) {
+        amount = -amount;
+      }
+
+      void setBudget({ category: cat.id, month, amount: safeNumber(amount) });
+    }
+  });
+}
