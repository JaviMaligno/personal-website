+function hasSavedTemplates(goalDef: string | null | undefined): boolean {
+  if (!goalDef) {
+    return false;
+  }
+  try {
+    const parsed = JSON.parse(goalDef);
+    return Array.isArray(parsed) ? parsed.length > 0 : parsed != null;
+  } catch {
+    return true;
+  }
+}
+
+// Categories that month-wide actions must not write to.
+function isSkippedByMonthActions(cat: {
+  hidden: 1 | 0;
+  group_hidden: 1 | 0;
+  goal_def?: string | null;
+}): boolean {
+  return (
+    cat.hidden === 1 ||
+    cat.group_hidden === 1 ||
+    hasSavedTemplates(cat.goal_def)
+  );
+}
