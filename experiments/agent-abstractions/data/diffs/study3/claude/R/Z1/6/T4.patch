+// Month-wide actions also skip hidden categories and categories in hidden
+// groups, unless the caller asks to include them
+function hiddenSql(
+  includeHiddenCategories: boolean | undefined,
+  { requireGroup = false } = {},
+): string {
+  if (includeHiddenCategories) {
+    return '1 = 1';
+  }
+  return requireGroup
+    ? 'c.hidden = 0 AND g.hidden = 0'
+    : 'c.hidden = 0 AND COALESCE(g.hidden, 0) = 0';
+}
