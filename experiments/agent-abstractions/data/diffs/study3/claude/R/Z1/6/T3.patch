 const NO_TEMPLATE_SQL = `(c.goal_def IS NULL OR TRIM(c.goal_def) IN ('', '[]', 'null'))`;
 
+const FIXED_TAG = /(^|\s)#fixed(?![\w-])/i;
+
+// Month-wide actions also skip categories in groups tagged #fixed in the
+// group's notes
+async function getFixedCategoryIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `SELECT c.id, n.note FROM categories c
+     JOIN notes n ON n.id = c.cat_group
+     WHERE n.note LIKE '%#fixed%'`,
+  );
+  return new Set(rows.filter(r => FIXED_TAG.test(r.note ?? '')).map(r => r.id));
+}
