+// Categories with templates saved by the template editor are managed by
+// those templates, so month-wide actions must not overwrite them.
+const NO_SAVED_TEMPLATE = `(c.goal_def IS NULL OR TRIM(c.goal_def) IN ('', '[]'))`;
+
+async function getCategoriesWithSavedTemplates(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string }>(
+    `SELECT c.id FROM categories c WHERE c.tombstone = 0 AND NOT ${NO_SAVED_TEMPLATE}`,
+  );
+  return new Set(rows.map(r => r.id));
+}
