+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevSheet = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden>(
+    `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+    AND ${NO_SAVED_TEMPLATE}
+  `,
+  );
+
+  const amounts: { id: string; amount: number }[] = [];
+  for (const cat of categories) {
+    if (cat.is_income === 1 && !isTrackingBudget()) {
+      continue;
+    }
+    const sum = await getSheetValue(prevSheet, 'sum-amount-' + cat.id);
+    amounts.push({
+      id: cat.id,
+      amount: cat.is_income === 1 ? sum : -sum || 0,
+    });
+  }
+
+  await batchMessages(async () => {
+    for (const { id, amount } of amounts) {
+      void setBudget({ category: id, month, amount });
+    }
+  });
+}
