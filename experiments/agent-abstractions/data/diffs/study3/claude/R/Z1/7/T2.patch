+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevSheet = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = (
+    await db.all<db.DbViewCategoryWithGroupHidden>(
+      `SELECT c.*, g.hidden AS group_hidden
+       FROM categories c
+       LEFT JOIN category_groups g ON c.cat_group = g.id
+       WHERE c.tombstone = 0`,
+    )
+  ).filter(cat => !isExcludedFromBulkActions(cat));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      const sum = await getSheetValue(prevSheet, 'sum-amount-' + cat.id);
+      const amount = cat.is_income === 1 ? sum : 0 - sum;
+
+      void setBudget({ category: cat.id, month, amount });
+    }
+  });
+}
