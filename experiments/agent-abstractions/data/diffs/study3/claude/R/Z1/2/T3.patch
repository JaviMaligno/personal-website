+describe('month-wide actions and #fixed groups', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('skips categories in groups whose notes contain #fixed', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    for (const [group, note] of [
+      ['fixed-group', 'Rent etc #fixed'],
+      ['plain-group', null],
+    ] as const) {
+      await db.insertCategoryGroup({ id: group, name: group, is_income: 0 });
+      await db.insertCategory({
+        id: `${group}-cat`,
+        name: group,
+        cat_group: group,
+        is_income: 0,
+        // The tag in a category's own notes must have no effect.
+      });
+      if (note) {
+        await db.insert('notes', { id: group, note });
+      }
+    }
+    await db.insert('notes', { id: 'plain-group-cat', note: '#fixed' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    await setBudget({
+      category: 'fixed-group-cat',
+      month: '2024-02',
+      amount: 700,
+    });
+    await setBudget({
+      category: 'plain-group-cat',
+      month: '2024-02',
+      amount: 700,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    const sheetName = 'budget202402';
+    expect(await getSheetValue(sheetName, 'budget-fixed-group-cat')).toBe(700);
+    expect(await getSheetValue(sheetName, 'budget-plain-group-cat')).toBe(0);
+  });
+});
