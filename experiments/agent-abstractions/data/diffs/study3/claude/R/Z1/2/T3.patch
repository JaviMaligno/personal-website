+// Groups tagged `#fixed` in their notes are left alone by month-wide actions.
+function hasFixedTag(notes: string | null | undefined): boolean {
+  return !!notes && /(^|\s)#fixed(?![\w-])/.test(notes);
+}
+
 // Categories that month-wide actions must not write to.
 function isSkippedByMonthActions(cat: {
   hidden: 1 | 0;
   group_hidden: 1 | 0;
   goal_def?: string | null;
+  group_notes?: string | null;
 }): boolean {
   return (
     cat.hidden === 1 ||
     cat.group_hidden === 1 ||
+    hasFixedTag(cat.group_notes) ||
     hasSavedTemplates(cat.goal_def)
   );
 }
