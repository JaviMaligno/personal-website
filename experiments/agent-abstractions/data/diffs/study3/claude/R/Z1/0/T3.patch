+describe('#fixed groups', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('are left untouched by month-wide actions', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'fixed', name: 'Fixed' });
+    await db.insertCategoryGroup({ id: 'other', name: 'Other' });
+    await db.insertCategory({ id: 'rent', name: 'Rent', cat_group: 'fixed' });
+    await db.insertCategory({ id: 'food', name: 'Food', cat_group: 'other' });
+    db.runQuery('INSERT INTO notes (id, note) VALUES (?, ?)', [
+      'fixed',
+      'Monthly #fixed costs',
+    ]);
+    db.runQuery('INSERT INTO notes (id, note) VALUES (?, ?)', [
+      'food',
+      '#fixed',
+    ]);
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    for (const category of ['rent', 'food']) {
+      await setBudget({ category, month: '2024-01', amount: 5000 });
+      await setBudget({ category, month: '2024-02', amount: 7000 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202402', 'budget-rent')).toBe(7000);
+    expect(await getSheetValue('budget202402', 'budget-food')).toBe(0);
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202402', 'budget-rent')).toBe(7000);
+    expect(await getSheetValue('budget202402', 'budget-food')).toBe(5000);
+  });
+});
