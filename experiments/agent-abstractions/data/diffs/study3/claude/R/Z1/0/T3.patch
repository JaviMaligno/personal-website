+const FIXED_TAG = /(^|\s)#fixed(?![\w-])/i;
+
+// Groups tagged `#fixed` in their notes are skipped by month-wide actions.
+export async function getFixedGroupIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `SELECT g.id, n.note
+     FROM category_groups g
+     JOIN notes n ON n.id = g.id
+     WHERE g.tombstone = 0`,
+  );
+  return new Set(
+    rows.filter(row => row.note && FIXED_TAG.test(row.note)).map(r => r.id),
+  );
+}
