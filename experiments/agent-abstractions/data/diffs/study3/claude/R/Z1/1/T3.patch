 const NO_SAVED_TEMPLATES = `(c.goal_def IS NULL OR TRIM(c.goal_def) IN ('', '[]'))`;
 
+const FIXED_TAG = /(?<![\w#])#fixed(?![\w-])/i;
+
+// Categories in a group whose notes carry the #fixed tag are left alone too
+async function getFixedCategoryIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `SELECT c.id, n.note FROM categories c
+     JOIN notes n ON n.id = c.cat_group
+     WHERE c.tombstone = 0`,
+  );
+  return new Set(
+    rows.filter(r => r.note && FIXED_TAG.test(r.note)).map(r => r.id),
+  );
+}
