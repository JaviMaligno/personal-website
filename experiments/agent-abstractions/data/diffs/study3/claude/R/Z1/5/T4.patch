+describe('hidden categories', () => {
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    await setupAverageDatabase();
+    await db.insertCategoryGroup({ id: 'g2', name: 'g2', is_income: 0 });
+    await db.insertCategory({
+      id: 'hiddenCat',
+      name: 'hiddenCat',
+      cat_group: 'g2',
+      hidden: 1,
+    });
+    await setBudget({ category: 'hiddenCat', month: '2024-04', amount: 700 });
+    await sheet.waitOnSpreadsheet();
+  });
+
+  afterEach(async () => {
+    await global.emptyDatabase()();
+  });
+
+  it('skips hidden categories by default', async () => {
+    await setZero({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202404', 'budget-hiddenCat')).toBe(700);
+  });
+
+  it('fills hidden categories when requested', async () => {
+    await setZero({ month: '2024-04', includeHiddenCategories: true });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202404', 'budget-hiddenCat')).toBe(0);
+  });
+});
+
