+async function getFillableCategories(
+  includeHiddenCategories: boolean,
+): Promise<db.DbViewCategoryWithGroupHidden[]> {
+  const hiddenFilter = includeHiddenCategories
+    ? ''
+    : 'AND c.hidden = 0 AND g.hidden = 0';
+  return db.all<db.DbViewCategoryWithGroupHidden>(
+    `SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 ${hiddenFilter}
+    AND ${NO_SAVED_TEMPLATE}`,
+  );
+}
