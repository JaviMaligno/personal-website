+// Groups tagged `#fixed` in their own notes hold fixed costs that month-wide
+// actions must leave alone. Tags in category notes are ignored.
+const FIXED_TAG = /(^|[^\w#])#fixed(?![\w-])/i;
+
+async function getCategoriesInFixedGroups(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string }>(
+    `SELECT c.id, n.note
+     FROM categories c
+     JOIN notes n ON n.id = c.cat_group
+     WHERE c.tombstone = 0 AND n.note LIKE '%#fixed%'`,
+  );
+  return new Set(rows.filter(r => FIXED_TAG.test(r.note)).map(r => r.id));
+}
