+describe('fixed groups', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setup(groupNote: string | null, catNote: string | null) {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'g1', name: 'g1', is_income: 0 });
+    await db.insertCategory({ id: 'c1', name: 'c1', cat_group: 'g1' });
+    if (groupNote != null) {
+      db.runQuery('INSERT INTO notes (id, note) VALUES (?, ?)', [
+        'g1',
+        groupNote,
+      ]);
+    }
+    if (catNote != null) {
+      db.runQuery('INSERT INTO notes (id, note) VALUES (?, ?)', [
+        'c1',
+        catNote,
+      ]);
+    }
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+    await setBudget({ category: 'c1', month: '2024-01', amount: 700 });
+    await setBudget({ category: 'c1', month: '2024-02', amount: 500 });
+    await sheet.waitOnSpreadsheet();
+  }
+
+  async function run() {
+    await setZero({ month: '2024-02' });
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    return getSheetValue('budget202402', 'budget-c1');
+  }
+
+  it('leaves categories in #fixed groups untouched', async () => {
+    await setup('Rent etc #fixed', null);
+    expect(await run()).toBe(500);
+  });
+
+  it('ignores the tag in category notes and untagged groups', async () => {
+    await setup('other', '#fixed');
+    expect(await run()).toBe(700);
+  });
+});
