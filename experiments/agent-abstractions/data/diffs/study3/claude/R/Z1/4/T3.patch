+const FIXED_TAG = /(^|\s)#fixed(?![\w-])/;
+
+// Categories in groups tagged `#fixed` in the group's notes are skipped by
+// month-wide actions.
+async function getFixedGroupIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `SELECT g.id, n.note
+     FROM category_groups g
+     JOIN notes n ON n.id = g.id
+     WHERE g.tombstone = 0 AND n.note LIKE '%#fixed%'`,
+  );
+  return new Set(rows.filter(r => FIXED_TAG.test(r.note ?? '')).map(r => r.id));
+}
+
+async function getEditableCategories() {
+  const [categories, fixedGroupIds] = await Promise.all([
+    db.all<db.DbViewCategoryWithGroupHidden & { cat_group: string }>(
+      `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE ${EDITABLE_CATEGORY_FILTER}
+  `,
+    ),
+    getFixedGroupIds(),
+  ]);
+  return categories.filter(c => !fixedGroupIds.has(c.cat_group));
+}
