+describe('month-wide actions skip protected categories', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setup() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'g1', name: 'G', is_income: 0 });
+    await db.insertCategoryGroup({
+      id: 'g2',
+      name: 'H',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({ id: 'plain', name: 'plain', cat_group: 'g1' });
+    await db.insertCategory({
+      id: 'hid',
+      name: 'hid',
+      cat_group: 'g1',
+      hidden: 1,
+    });
+    await db.insertCategory({ id: 'ing', name: 'ing', cat_group: 'g2' });
+    await db.insertCategory({ id: 'tpl', name: 'tpl', cat_group: 'g1' });
+    await db.updateWithSchema('categories', {
+      id: 'tpl',
+      goal_def: '[{"type":"simple"}]',
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+    for (const id of ['plain', 'hid', 'ing', 'tpl']) {
+      await setBudget({ category: id, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  async function values() {
+    const get = (id: string) => getSheetValue('budget202402', 'budget-' + id);
+    return [
+      await get('plain'),
+      await get('hid'),
+      await get('ing'),
+      await get('tpl'),
+    ];
+  }
+
+  it('setZero', async () => {
+    await setup();
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    expect(await values()).toEqual([0, 500, 500, 500]);
+  });
+
+  it('copyPreviousMonth', async () => {
+    await setup();
+    for (const id of ['plain', 'hid', 'ing', 'tpl']) {
+      await setBudget({ category: id, month: '2024-01', amount: 200 });
+    }
+    await sheet.waitOnSpreadsheet();
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    expect(await values()).toEqual([200, 500, 500, 500]);
+  });
+});
