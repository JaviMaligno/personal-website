index 0000000..db9fa1c
--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,32 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function toExternal(amount: unknown) {
+  return scheduleModel.toExternal({
+    id: 's1',
+    _amount: amount,
+    _amountOp: 'is',
+  } as ScheduleEntity);
+}
+
+describe('scheduleModel.toExternal expectedAmount', () => {
+  it('keeps amount and gives a single amount as itself', () => {
+    const result = toExternal(-5000);
+    expect(result.amount).toBe(-5000);
+    expect(result.expectedAmount).toBe(-5000);
+  });
+
+  it('gives the end furthest from zero for a range', () => {
+    const range = { num1: -10100, num2: -20000 };
+    const result = toExternal(range);
+    expect(result.amount).toEqual(range);
+    expect(result.expectedAmount).toBe(-20000);
+    expect(toExternal({ num1: 100, num2: -300 }).expectedAmount).toBe(-300);
+  });
+
+  it('gives 0 without an amount', () => {
+    expect(toExternal(undefined).expectedAmount).toBe(0);
+    expect(toExternal(null).expectedAmount).toBe(0);
+  });
+});
