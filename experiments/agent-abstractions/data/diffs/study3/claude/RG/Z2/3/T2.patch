@@ -0,0 +1,36 @@
+import { describe, expect, it } from 'vitest';
+
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function toExternal(fields: Partial<ScheduleEntity>) {
+  return scheduleModel.toExternal({
+    id: 's1',
+    ...fields,
+  } as ScheduleEntity);
+}
+
+describe('scheduleModel.toExternal expectedAmount', () => {
+  it('uses a single amount as is', () => {
+    expect(toExternal({ _amount: -5000 }).expectedAmount).toBe(-5000);
+  });
+
+  it('uses the end of a range furthest from zero', () => {
+    expect(
+      toExternal({ _amount: { num1: -10100, num2: -20000 } }).expectedAmount,
+    ).toBe(-20000);
+    expect(
+      toExternal({ _amount: { num1: 20000, num2: 10100 } }).expectedAmount,
+    ).toBe(20000);
+  });
+
+  it('is 0 without an amount', () => {
+    expect(toExternal({}).expectedAmount).toBe(0);
+  });
+
+  it('keeps the original amount field', () => {
+    const range = { num1: -10100, num2: -20000 };
+    expect(toExternal({ _amount: range }).amount).toEqual(range);
+  });
+});
