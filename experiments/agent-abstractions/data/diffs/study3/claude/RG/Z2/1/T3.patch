+// The amount a schedule is expected to post for planning: the worst case. A
+// ranged ("is between") amount is its end furthest from zero; an approximate
+// amount is the end of its matching tolerance furthest from zero. Single
+// amounts are used as-is and a missing amount is 0.
+export function getExpectedAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getRangeAmount(amount);
+  if (op === 'isapprox') {
+    const threshold = getApproxNumberThreshold(amount);
+    return amount < 0 ? amount - threshold : amount + threshold;
+  }
+  return amount;
+}
