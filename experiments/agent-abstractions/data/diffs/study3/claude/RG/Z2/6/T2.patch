@@ -0,0 +1,31 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function make(_amount: ScheduleEntity['_amount']): ScheduleEntity {
+  return { id: 's', _amount, _amountOp: 'is' } as ScheduleEntity;
+}
+
+describe('scheduleModel.toExternal expectedAmount', () => {
+  it('uses a single amount as-is', () => {
+    expect(scheduleModel.toExternal(make(-5000)).expectedAmount).toBe(-5000);
+  });
+
+  it('uses the end of a range furthest from zero', () => {
+    expect(
+      scheduleModel.toExternal(make({ num1: -10100, num2: -20000 }))
+        .expectedAmount,
+    ).toBe(-20000);
+    expect(
+      scheduleModel.toExternal(make({ num1: 20000, num2: 10100 }))
+        .expectedAmount,
+    ).toBe(20000);
+  });
+
+  it('is 0 without an amount', () => {
+    expect(
+      scheduleModel.toExternal(make(undefined as unknown as number))
+        .expectedAmount,
+    ).toBe(0);
+  });
+});
