+// The amount a schedule is expected at: a ranged ("is between") amount at its
+// end furthest from zero, an approximate amount at the end of its matching
+// tolerance furthest from zero, and any other amount as is.
+export function getWorstCaseAmount(
+  amount: number | { num1: number; num2: number },
+  op?: string | null,
+): number {
+  if (typeof amount !== 'number') {
+    return getRangedAmount(amount);
+  }
+  if (op === 'isapprox') {
+    return amount + Math.sign(amount) * getApproxNumberThreshold(amount);
+  }
+  return amount;
+}
