+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevMonth = monthUtils.prevMonth(month);
+  const categories = await db.all<db.DbViewCategory>(
+    `SELECT c.* FROM v_categories c
+     LEFT JOIN category_groups g ON c.cat_group = g.id
+     WHERE c.tombstone = 0 AND c.hidden = 0 AND (g.hidden = 0 OR g.hidden IS NULL)`,
+  );
+  const templated = await getTemplatedCategoryIds();
+  const isTracking = isTrackingBudget();
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if ((cat.is_income === 1 && !isTracking) || templated.has(cat.id)) {
+        continue;
+      }
+
+      const activity = await getSheetValue(
+        monthUtils.sheetForMonth(prevMonth),
+        'sum-amount-' + cat.id,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? activity : -activity || 0,
+      });
+    }
+  });
+}
