+// Month-wide actions leave hidden categories, categories in hidden groups,
+// and categories with saved budget templates untouched.
+function hasSavedTemplates(goalDef: string | null | undefined): boolean {
+  if (!goalDef) return false;
+  try {
+    const parsed = JSON.parse(goalDef);
+    return Array.isArray(parsed) && parsed.length > 0;
+  } catch {
+    return false;
+  }
+}
+
+function isSkippedByMonthWideAction(cat: {
+  hidden: number | boolean;
+  group_hidden?: number | boolean | null;
+  goal_def?: string | null;
+}): boolean {
+  return !!cat.hidden || !!cat.group_hidden || hasSavedTemplates(cat.goal_def);
+}
+
+async function getMonthWideCategories() {
+  const categories = await db.all<
+    Pick<db.DbViewCategory, 'id' | 'is_income'> & {
+      hidden: number;
+      group_hidden: number | null;
+      goal_def: string | null;
+    }
+  >(
+    `
+  SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden, c.goal_def
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0
+  `,
+  );
+  return categories.filter(cat => !isSkippedByMonthWideAction(cat));
+}
