+describe('#fixed groups', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('month-wide actions skip categories in groups tagged #fixed', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    for (const [id, note] of [
+      ['fixed-group', 'Rent etc #fixed'],
+      ['other-group', 'no tag'],
+    ]) {
+      await db.insertCategoryGroup({ id, name: id, is_income: 0 });
+      await db.insertCategory({
+        id: id + '-cat',
+        name: id + '-cat',
+        cat_group: id,
+        is_income: 0,
+      });
+      await db.insertWithSchema('notes', { id, note });
+    }
+    await db.insertWithSchema('notes', {
+      id: 'other-group-cat',
+      note: '#fixed',
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    await setBudget({
+      category: 'fixed-group-cat',
+      month: '2024-02',
+      amount: 700,
+    });
+    await setBudget({
+      category: 'other-group-cat',
+      month: '2024-02',
+      amount: 700,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    const sheetName = 'budget202402';
+    expect(await getSheetValue(sheetName, 'budget-fixed-group-cat')).toBe(700);
+    expect(await getSheetValue(sheetName, 'budget-other-group-cat')).toBe(0);
+  });
+});
