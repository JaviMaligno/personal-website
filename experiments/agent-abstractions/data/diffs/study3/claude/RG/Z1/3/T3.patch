+
+  async function setup(groupNote: string | null, catNote: string | null) {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'g1', name: 'g1', is_income: 0 });
+    await db.insertCategory({
+      id: 'cat1',
+      name: 'cat1',
+      cat_group: 'g1',
+      is_income: 0,
+    });
+    if (groupNote) {
+      await db.insertWithSchema('notes', { id: 'g1', note: groupNote });
+    }
+    if (catNote) {
+      await db.insertWithSchema('notes', { id: 'cat1', note: catNote });
+    }
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+    await setBudget({ category: 'cat1', month: '2024-01', amount: 1000 });
+    await setBudget({ category: 'cat1', month: '2024-02', amount: 500 });
+    await sheet.waitOnSpreadsheet();
+  }
+
+  async function run() {
+    await setZero({ month: '2024-02' });
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    return getSheetValue('budget202402', 'budget-cat1');
+  }
+
+  it('leaves categories in a #fixed group untouched', async () => {
+    await setup('Rent etc #fixed', null);
+    expect(await run()).toBe(500);
+  });
+
+  it('ignores the tag in category notes and in groups without it', async () => {
+    await setup('#fixedcosts', '#fixed');
+    expect(await run()).toBe(1000);
+  });
+});
