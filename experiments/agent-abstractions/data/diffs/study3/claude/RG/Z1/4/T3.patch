+const FIXED_GROUP_TAG = /(^|\s)#fixed(?![\w-])/i;
+
+// Ids of category groups whose notes carry the `#fixed` tag.
+async function getFixedGroupIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `SELECT g.id, n.note
+     FROM category_groups g
+     JOIN notes n ON n.id = g.id
+     WHERE g.tombstone = 0 AND n.note LIKE '%#fixed%'`,
+  );
+  return new Set(
+    rows.filter(r => r.note && FIXED_GROUP_TAG.test(r.note)).map(r => r.id),
+  );
+}
