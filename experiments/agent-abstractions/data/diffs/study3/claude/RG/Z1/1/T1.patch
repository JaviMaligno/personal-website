+function hasSavedTemplates(goalDef: string | null | undefined): boolean {
+  if (!goalDef) {
+    return false;
+  }
+  try {
+    const parsed = JSON.parse(goalDef);
+    return Array.isArray(parsed) && parsed.length > 0;
+  } catch {
+    return false;
+  }
+}
+
+// Categories that month-wide actions may write to: not hidden, not in a
+// hidden group, and without saved budget templates.
+async function getFillableCategories(): Promise<
+  (db.DbViewCategoryWithGroupHidden & Pick<db.DbCategory, 'goal_def'>)[]
+> {
+  const categories = await db.all<
+    db.DbViewCategoryWithGroupHidden & Pick<db.DbCategory, 'goal_def'>
+  >(
+    `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+  `,
+  );
+  return categories.filter(c => !hasSavedTemplates(c.goal_def));
+}
