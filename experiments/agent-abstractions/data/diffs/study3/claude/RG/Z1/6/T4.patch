+// SQL condition excluding hidden categories and categories in hidden groups,
+// unless the caller asked to include them.
+function hiddenFilter(includeHidden: boolean, strictGroup = false): string {
+  if (includeHidden) {
+    return '';
+  }
+  return strictGroup
+    ? 'AND c.hidden = 0 AND g.hidden = 0'
+    : 'AND c.hidden = 0 AND (g.hidden = 0 OR g.hidden IS NULL)';
+}
