+function hasSavedTemplates(goalDef?: string | null): boolean {
+  if (!goalDef) {
+    return false;
+  }
+  try {
+    const templates: unknown = JSON.parse(goalDef);
+    return Array.isArray(templates) && templates.length > 0;
+  } catch {
+    return false;
+  }
+}
+
+// Categories that month-wide actions may write to: not hidden, not in a
+// hidden group, and without saved budget templates.
+async function getFillableCategories(): Promise<
+  db.DbViewCategoryWithGroupHidden[]
+> {
+  const categories = await db.all<
+    db.DbViewCategoryWithGroupHidden & { goal_def?: string | null }
+  >(
+    `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+  `,
+  );
+  return categories.filter(cat => !hasSavedTemplates(cat.goal_def));
+}
