+  async function setup() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    for (const [group, note] of [
+      ['fixed-group', 'Rent etc #fixed'],
+      ['lookalike-group', '#fixedcosts'],
+      ['plain-group', null],
+    ]) {
+      await db.insertCategoryGroup({ id: group, name: group, is_income: 0 });
+      if (note) {
+        await db.insert('notes', { id: group, note });
+      }
+    }
+    await db.insertCategoryGroup({
+      id: 'cat-note-group',
+      name: 'c',
+      is_income: 0,
+    });
+    for (const [cat, group] of [
+      ['fixed-cat', 'fixed-group'],
+      ['lookalike-cat', 'lookalike-group'],
+      ['plain-cat', 'plain-group'],
+      ['cat-note-cat', 'cat-note-group'],
+    ]) {
+      await db.insertCategory({
+        id: cat,
+        name: cat,
+        cat_group: group,
+        is_income: 0,
+      });
+    }
+    await db.insert('notes', { id: 'cat-note-cat', note: '#fixed' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+    for (const cat of [
+      'fixed-cat',
+      'lookalike-cat',
+      'plain-cat',
+      'cat-note-cat',
+    ]) {
+      await setBudget({ category: cat, month: '2024-01', amount: 700 });
+      await setBudget({ category: cat, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('setZero skips categories in #fixed groups only', async () => {
+    await setup();
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202402', 'budget-fixed-cat')).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-lookalike-cat')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-plain-cat')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-cat-note-cat')).toBe(0);
+  });
+
+  it('copyPreviousMonth skips categories in #fixed groups', async () => {
+    await setup();
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202402', 'budget-fixed-cat')).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-plain-cat')).toBe(700);
+  });
+});
