+const FIXED_TAG = /(^|[^\w#])#fixed(?![\w-])/i;
+
+// Ids of categories in groups whose notes carry the `#fixed` tag. Only the
+// group's own notes count.
+async function getFixedCategoryIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `
+  SELECT c.id, n.note
+  FROM categories c
+  JOIN category_groups g ON c.cat_group = g.id
+  JOIN notes n ON n.id = g.id
+  WHERE c.tombstone = 0 AND n.note LIKE '%#fixed%'
+  `,
+  );
+  return new Set(
+    rows.filter(row => FIXED_TAG.test(row.note ?? '')).map(row => row.id),
+  );
+}
