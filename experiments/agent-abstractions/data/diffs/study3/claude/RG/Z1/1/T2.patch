+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getFillableCategories();
+  const prevMonth = monthUtils.prevMonth(month);
+  const rows = await db.all<{ category: string; amount: number | null }>(
+    `SELECT t.category AS category, SUM(t.amount) AS amount
+       FROM v_transactions_internal_alive t
+       LEFT JOIN accounts a ON a.id = t.account
+      WHERE t.date >= ? AND t.date <= ?
+        AND t.category IS NOT NULL AND a.offbudget = 0
+      GROUP BY t.category`,
+    [dbMonth(prevMonth) * 100 + 1, dbMonth(prevMonth) * 100 + 31],
+  );
+  const sums = new Map(rows.map(r => [r.category, r.amount || 0]));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+      const sum = sums.get(cat.id) ?? 0;
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? sum : -sum || 0,
+      });
+    }
+  });
+}
