+describe('linking a bank account to a closed account', () => {
+  const message =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+  it('refuses and leaves the account untouched', async () => {
+    await db.insertAccount({ id: 'closed1', name: 'Old', closed: 1 });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount: {
+          account_id: 'ext-1',
+          name: 'Ext',
+          institution: 'Inst',
+          orgDomain: 'x.test',
+          orgId: 'x',
+          balance: 0,
+        },
+        upgradingId: 'closed1',
+      } as never),
+    ).rejects.toThrow(message);
+
+    const row = await db.first<{
+      closed: number;
+      account_id: string | null;
+    }>('SELECT closed, account_id FROM accounts WHERE id = ?', ['closed1']);
+    expect(row.closed).toBe(1);
+    expect(row.account_id).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
