+describe('linking to a closed account', () => {
+  it('refuses to link and leaves the account untouched', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', closed: 1 });
+
+    const link = app.handlers['simplefin-accounts-link'];
+    await expect(
+      link({
+        externalAccount: { account_id: 'ext-1', name: 'X' },
+        upgradingId: 'acct1',
+      } as never),
+    ).rejects.toThrow(
