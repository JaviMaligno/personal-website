+    'SELECT id FROM accounts WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ? AND id IS NOT ? LIMIT 1',
+    [syncSource, bankAccountId, upgradingId ?? null],
+  );
+
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
