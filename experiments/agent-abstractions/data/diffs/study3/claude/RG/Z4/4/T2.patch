+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const drops = config.skipWeekend && config.frequency === 'daily';
+    // Weekend occurrences can move up to two days, so look a bit beyond
+    const from = d.subDays(parseDate(start), 3);
+    const to = d.endOfDay(d.addDays(parseDate(end), 3));
+
+    const days = new Set<string>();
+    for (const occurrence of schedule.occurrences({ start: from, end: to })) {
+      let date = occurrence.date;
+      if (config.skipWeekend) {
+        if (drops) {
+          if (d.isWeekend(date)) continue;
+        } else {
+          date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        }
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) days.add(day);
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
