+
+describe('holidays', () => {
+  const base = {
+    frequency: 'monthly',
+    start: '2025-01-01',
+    skipWeekend: true,
+    patterns: [],
+  };
+
+  it('moves holiday occurrences and weekends past holidays', () => {
+    const cond = (extra: Record<string, unknown>, start = '2025-03-01') => ({
+      op: 'is',
+      field: 'date',
+      value: { ...base, start, ...extra },
+    });
+    // 2025-03-01 is Saturday; Monday the 3rd is a holiday
+    expect(
+      getNextDate(
+        cond({ weekendSolveMode: 'after', holidays: ['2025-03-03'] }),
+        new Date(2025, 2, 1),
+      ),
+    ).toBe('2025-03-04');
+    // 2025-04-01 is Tuesday, a holiday; moves before to Monday
+    expect(
+      getNextDate(
+        cond(
+          { weekendSolveMode: 'before', holidays: ['2025-04-01'] },
+          '2025-04-01',
+        ),
+        new Date(2025, 3, 1),
+      ),
+    ).toBe('2025-03-31');
+    // off: no effect
+    expect(
+      getNextDate(
+        cond(
+          {
+            skipWeekend: false,
+            weekendSolveMode: 'after',
+            holidays: ['2025-04-01'],
+          },
+          '2025-04-01',
+        ),
+        new Date(2025, 3, 1),
+      ),
+    ).toBe('2025-04-01');
+  });
+
+  it('skips holidays for daily schedules', () => {
+    const config = {
+      frequency: 'daily',
+      start: '2025-03-03',
+      skipWeekend: true,
+      holidays: ['2025-03-04'],
+    };
+    const days = new RSchedule({
+      rrules: recurConfigToRSchedule(config) as IRuleOptions[],
+      exdates: recurConfigToExdates(config),
+    })
+      .occurrences({ take: 3 })
+      .toArray()
+      .map(o => o.date.getDate());
+    expect(days).toEqual([3, 5, 6]);
+  });
+});
