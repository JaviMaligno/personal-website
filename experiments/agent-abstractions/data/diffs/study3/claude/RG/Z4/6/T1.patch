+// Enough to get past any weekend run; a daily schedule with an interval
+// that is a multiple of 7 can land only on weekends and never match.
+const MAX_WEEKDAY_SEARCH = 1000;
+
+function firstWeekdayOccurrence(
+  schedule: RSchedule,
+  options: { start?: Date; reverse?: boolean },
+): Date | null {
+  let checked = 0;
+  for (const occurrence of schedule.occurrences(options)) {
+    if (!d.isWeekend(occurrence.date)) {
+      return occurrence.date;
+    }
+    if (++checked >= MAX_WEEKDAY_SEARCH) {
+      break;
+    }
+  }
+  return null;
+}
