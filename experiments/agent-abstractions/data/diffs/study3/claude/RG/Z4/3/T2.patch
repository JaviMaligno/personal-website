+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  if (start > end) {
+    return [];
+  }
+
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const moveWeekend = config.skipWeekend && config.frequency !== 'daily';
+
+    // Weekend occurrences can move up to 2 days in either direction, so
+    // look a bit beyond the period and decide on the final day
+    const margin = moveWeekend ? 3 : 0;
+    const days = new Set<string>();
+    schedule
+      .occurrences({
+        start: d.subDays(d.startOfDay(monthUtils.parseDate(start)), margin),
+        end: d.addDays(d.endOfDay(monthUtils.parseDate(end)), margin),
+      })
+      .toArray()
+      .forEach(occurrence => {
+        const day = dayFromDate(
+          moveWeekend
+            ? getDateWithSkippedWeekend(
+                occurrence.date,
+                config.weekendSolveMode,
+              )
+            : occurrence.date,
+        );
+        if (day >= start && day <= end) {
+          days.add(day);
+        }
+      });
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
