+describe('schedule/get-dates-in-range', () => {
+  const base = {
+    start: '2025-01-01',
+    frequency: 'monthly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: true,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('moves weekend occurrences by their final day', async () => {
+    // 2025-02-01 is a Saturday -> Monday 2025-02-03; 2025-03-01 Sat -> 03-03
+    const run = (start, end, mode = 'after') =>
+      schedulesApp.handlers['schedule/get-dates-in-range']({
+        config: { ...base, weekendSolveMode: mode },
+        start,
+        end,
+      });
+    expect(await run('2025-02-02', '2025-02-28')).toEqual(['2025-02-03']);
+    expect(await run('2025-01-15', '2025-02-02')).toEqual([]);
+    expect(await run('2025-02-01', '2025-02-01')).toEqual([]);
+    expect(await run('2025-01-31', '2025-01-31', 'before')).toEqual([
+      '2025-01-31',
+    ]);
+  });
+});
