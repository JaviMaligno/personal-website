   try {
     const schedule = new RSchedule({ rrules: rules });
 
+    if (config.skipWeekend && config.frequency === 'daily') {
+      // Weekend occurrences are dropped, not moved
+      const dates: Date[] = [];
+      // Cap the scan: an interval of 7 days on a weekend never hits a weekday
+      let scanned = 0;
+      for (const occurrence of schedule.occurrences({
+        start: d.startOfDay(new Date()),
+      })) {
+        if (dates.length >= count || scanned++ >= count * 7 + 7) break;
+        if (!d.isWeekend(occurrence.date)) dates.push(occurrence.date);
+      }
+      return dates.map(date => dayFromDate(date));
+    }
+
     return schedule
