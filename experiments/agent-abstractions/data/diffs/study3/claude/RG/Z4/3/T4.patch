+  const holidays: string[] = config.holidays ?? [];
+  const exdates = holidays
+    .filter(h => !isYearlyHoliday(h))
+    .map(h => d.setHours(monthUtils.parseDate(h), 12));
+
+  // Yearly holidays (MM-DD) are expanded over a wide span of years
+  const yearly = holidays.filter(isYearlyHoliday);
+  if (yearly.length > 0) {
+    const startYear = config.start
+      ? monthUtils.parseDate(config.start).getFullYear()
+      : new Date().getFullYear();
+    for (let year = startYear - 1; year <= startYear + 200; year++) {
+      for (const h of yearly) {
+        const date = `${year}-${h}`;
+        // Skips invalid dates such as 02-29 in non-leap years
+        if (monthUtils.dayFromDate(monthUtils.parseDate(date)) === date) {
+          exdates.push(d.setHours(monthUtils.parseDate(date), 12));
+        }
+      }
+    }
+  }
+  return exdates;
+}
+
+function isYearlyHoliday(holiday: string): boolean {
+  return /^\d{2}-\d{2}$/.test(holiday);
+}
+
+function isHoliday(day: Date, holidays: string[]): boolean {
+  const date = monthUtils.dayFromDate(day);
+  return holidays.includes(date) || holidays.includes(date.slice(5));
