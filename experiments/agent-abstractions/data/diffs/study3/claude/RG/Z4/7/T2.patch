+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    // Weekend adjustment moves an occurrence by at most two days, so look
+    // a little beyond the period and filter on the adjusted day.
+    const days = new Set<string>();
+    for (const occurrence of schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 2)),
+        end: d.endOfDay(d.addDays(parseDate(end), 2)),
+      })
+      .toArray()) {
+      const date = getAdjustedOccurrence(config, occurrence.date);
+      if (!date) continue;
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) days.add(day);
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
