+describe('schedule/get-dates-in-range', () => {
+  const base = {
+    start: '2024-01-01',
+    frequency: 'weekly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: false,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('lists days in range inclusively', async () => {
+    const days = await getDatesInRange({
+      config: base,
+      start: '2024-01-08',
+      end: '2024-01-22',
+    });
+    expect(days).toEqual(['2024-01-08', '2024-01-15', '2024-01-22']);
+  });
+
+  it('uses the weekend-adjusted day to decide membership', async () => {
+    // 2024-01-06 is a Saturday
+    const config = { ...base, start: '2024-01-06', skipWeekend: true };
+    expect(
+      await getDatesInRange({ config, start: '2024-01-08', end: '2024-01-09' }),
+    ).toEqual(['2024-01-08']);
+    expect(
+      await getDatesInRange({ config, start: '2024-01-01', end: '2024-01-06' }),
+    ).toEqual([]);
+    expect(
+      await getDatesInRange({
+        config: { ...config, weekendSolveMode: 'before' },
+        start: '2024-01-05',
+        end: '2024-01-05',
+      }),
+    ).toEqual(['2024-01-05']);
+  });
+});
