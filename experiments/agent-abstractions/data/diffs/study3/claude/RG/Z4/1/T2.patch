+describe('schedule/get-dates-in-range', () => {
+  const run = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences and decides by the final day', async () => {
+    // 2024-06-01 is a Saturday, 2024-06-09 a Sunday
+    const config = {
+      start: '2024-06-01',
+      frequency: 'weekly',
+      interval: 1,
+      patterns: [],
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+      endMode: 'never',
+    };
+    expect(await run(config, '2024-06-03', '2024-06-10')).toEqual([
+      '2024-06-03',
+      '2024-06-10',
+    ]);
+    expect(await run(config, '2024-05-31', '2024-06-02')).toEqual([]);
+    expect(
+      await run(
+        { ...config, weekendSolveMode: 'before' },
+        '2024-05-31',
+        '2024-05-31',
+      ),
+    ).toEqual(['2024-05-31']);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    expect(
+      await run(
+        {
+          start: '2024-06-01',
+          frequency: 'daily',
+          interval: 1,
+          patterns: [],
+          skipWeekend: true,
+          weekendSolveMode: 'after',
+          endMode: 'never',
+        },
+        '2024-06-01',
+        '2024-06-04',
+      ),
+    ).toEqual(['2024-06-03', '2024-06-04']);
+  });
+});
