+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const skipsWeekendDays = isDailyWeekendSkipping({
+      skipWeekend: config.skipWeekend,
+      frequency: config.frequency,
+    });
+
+    // Weekend adjustment moves an occurrence by at most two days, so look
+    // that far outside the period and decide by the adjusted day.
+    const days = new Set<string>();
+    for (const occurrence of schedule.occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), 2)),
+      end: d.endOfDay(d.addDays(parseDate(end), 2)),
+    })) {
+      let date = occurrence.date;
+      if (skipsWeekendDays) {
+        if (d.isWeekend(date)) {
+          continue;
+        }
+      } else if (config.skipWeekend) {
+        date = getDateWithSkippedWeekend(
+          date,
+          config.weekendSolveMode ?? 'after',
+        );
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
