+
+describe('holidays', () => {
+  const weekly = (extra = {}) => ({
+    op: 'isapprox',
+    value: {
+      start: '2020-12-05',
+      frequency: 'weekly',
+      patterns: [],
+      skipWeekend: true,
+      ...extra,
+    },
+  });
+  const from = new Date(2020, 11, 1);
+
+  it('moves a weekend occurrence past a holiday Monday', () => {
+    const cond = weekly({
+      weekendSolveMode: 'after',
+      holidays: ['2020-12-07'],
+    });
+    expect(getNextDate(cond, from)).toBe('2020-12-08');
+  });
+
+  it('moves a holiday occurrence before', () => {
+    const cond = weekly({
+      start: '2020-12-09',
+      weekendSolveMode: 'before',
+      holidays: ['2020-12-09', '2020-12-08'],
+    });
+    expect(getNextDate(cond, from)).toBe('2020-12-07');
+  });
+
+  it('ignores holidays when weekend handling is off', () => {
+    const cond = weekly({
+      start: '2020-12-09',
+      skipWeekend: false,
+      weekendSolveMode: 'after',
+      holidays: ['2020-12-09'],
+    });
+    expect(getNextDate(cond, from)).toBe('2020-12-09');
+  });
+
+  it('skips holidays for daily schedules', () => {
+    const cond = weekly({
+      frequency: 'daily',
+      start: '2020-12-01',
+      holidays: ['2020-12-01', '2020-12-02'],
+    });
+    expect(getNextDate(cond, from)).toBe('2020-12-03');
+  });
+});
