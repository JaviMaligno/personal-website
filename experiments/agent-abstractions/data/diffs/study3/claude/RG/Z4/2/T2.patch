+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  if (start > end) return [];
+
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const skipsWeekends = skipsWeekendOccurrences(config);
+
+    // Weekend adjustment moves an occurrence by at most two days, so look
+    // slightly outside the period and decide on the final day.
+    const searchStart = d.subDays(parseDate(start), 2);
+    const searchEnd = dayFromDate(d.addDays(parseDate(end), 2));
+
+    const days = new Set<string>();
+    for (const occurrence of schedule.occurrences({
+      start: d.startOfDay(searchStart),
+    })) {
+      if (dayFromDate(occurrence.date) > searchEnd) break;
+
+      let date = occurrence.date;
+      if (skipsWeekends) {
+        if (d.isWeekend(date)) continue;
+      } else if (config.skipWeekend) {
+        date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      }
+
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) days.add(day);
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
