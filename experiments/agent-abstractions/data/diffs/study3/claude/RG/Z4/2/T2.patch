+describe('schedule/get-dates-in-range', () => {
+  const run = args =>
+    schedulesApp.handlers['schedule/get-dates-in-range'](args);
+  const weekly = {
+    start: '2024-01-05',
+    frequency: 'weekly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: false,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('lists days in range inclusively', async () => {
+    expect(
+      await run({ config: weekly, start: '2024-01-05', end: '2024-01-19' }),
+    ).toEqual(['2024-01-05', '2024-01-12', '2024-01-19']);
+  });
+
+  it('decides on the adjusted day and dedupes', async () => {
+    const config = {
+      ...weekly,
+      start: '2024-01-06',
+      frequency: 'daily',
+      skipWeekend: false,
+    };
+    const sat = { ...weekly, start: '2024-01-06', skipWeekend: true };
+    // Saturday 6th moves to Monday 8th
+    expect(
+      await run({ config: sat, start: '2024-01-08', end: '2024-01-08' }),
+    ).toEqual(['2024-01-08']);
+    expect(
+      await run({ config: sat, start: '2024-01-01', end: '2024-01-07' }),
+    ).toEqual([]);
+    const before = { ...sat, weekendSolveMode: 'before' };
+    expect(
+      await run({ config: before, start: '2024-01-05', end: '2024-01-05' }),
+    ).toEqual(['2024-01-05']);
+    const daily = { ...config, skipWeekend: true };
+    expect(
+      await run({ config: daily, start: '2024-01-05', end: '2024-01-09' }),
+    ).toEqual(['2024-01-08', '2024-01-09']);
+  });
+});
