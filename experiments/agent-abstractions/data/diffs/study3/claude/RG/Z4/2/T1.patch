+// Daily schedules skip weekend occurrences instead of moving them.
+export function skipsWeekendOccurrences(data: {
+  skipWeekend?: boolean;
+  frequency?: string;
+}): boolean {
+  return !!data?.skipWeekend && data.frequency?.toLowerCase() === 'daily';
+}
+
+// Guards against schedules (e.g. every 7 days) that only land on weekends.
+const MAX_WEEKDAY_SEARCH = 1000;
+
+function firstWeekdayOccurrence(schedule, start: Date) {
+  let checked = 0;
+  for (const date of schedule.occurrences({ start })) {
+    if (!d.isWeekend(date.date)) return [date];
+    if (++checked >= MAX_WEEKDAY_SEARCH) break;
+  }
+  return [];
+}
+
+function lastWeekdayOccurrence(schedule) {
+  let checked = 0;
+  for (const date of schedule.occurrences({ reverse: true })) {
+    if (!d.isWeekend(date.date)) return [date];
+    if (++checked >= MAX_WEEKDAY_SEARCH) break;
+  }
+  return [];
+}
