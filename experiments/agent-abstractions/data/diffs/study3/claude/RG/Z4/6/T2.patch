+
+  it('decides by the moved day', async () => {
+    const config = {
+      ...weekly,
+      start: '2024-01-06', // Saturday
+      skipWeekend: true,
+    };
+    // Saturday 6th -> Monday 8th
+    expect(
+      await call({ config, start: '2024-01-08', end: '2024-01-08' }),
+    ).toEqual(['2024-01-08']);
+    expect(
+      await call({ config, start: '2024-01-01', end: '2024-01-07' }),
+    ).toEqual([]);
+    expect(
+      await call({
+        config: { ...config, weekendSolveMode: 'before' },
+        start: '2024-01-05',
+        end: '2024-01-05',
+      }),
+    ).toEqual(['2024-01-05']);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    const config = { ...weekly, frequency: 'daily', skipWeekend: true };
