+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const skipsWeekendDays = config.skipWeekend && config.frequency === 'daily';
+
+    // Weekend occurrences move by at most two days, so look a bit beyond the
+    // period and decide on the final (adjusted) day
+    const dates = new Set<string>();
+    for (const occurrence of schedule.occurrences({
+      start: d.subDays(d.startOfDay(parseDate(start)), 3),
+      end: d.addDays(d.endOfDay(parseDate(end)), 3),
+    })) {
+      let date = occurrence.date;
+      if (config.skipWeekend) {
+        if (skipsWeekendDays) {
+          if (d.isWeekend(date)) {
+            continue;
+          }
+        } else {
+          date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        }
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        dates.add(day);
+      }
+    }
+    return [...dates].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
