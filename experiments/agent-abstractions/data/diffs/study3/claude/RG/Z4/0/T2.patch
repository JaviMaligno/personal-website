+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    // Weekend handling moves an occurrence by at most two days, so look a
+    // little beyond the period on both sides and filter on the final day.
+    const days = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.endOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray()
+      .map(occurrence =>
+        config.skipWeekend && config.frequency !== 'daily'
+          ? getDateWithSkippedWeekend(
+              occurrence.date,
+              config.weekendSolveMode ?? 'after',
+            )
+          : occurrence.date,
+      )
+      .map(date => dayFromDate(date))
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
