+describe('schedule/get-dates-in-range', () => {
+  const call = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences by their final day', async () => {
+    // 2024-06-01 is a Saturday, 2024-06-30 is a Sunday
+    const monthly = {
+      start: '2024-05-01',
+      frequency: 'monthly' as const,
+      patterns: [],
+      skipWeekend: true,
+      weekendSolveMode: 'after' as const,
+      endMode: 'never' as const,
+    };
+    expect(
+      await call(
+        { ...monthly, start: '2024-06-01' },
+        '2024-06-01',
+        '2024-06-02',
+      ),
+    ).toEqual([]);
+    expect(
+      await call(
+        { ...monthly, start: '2024-06-01' },
+        '2024-06-03',
+        '2024-06-30',
+      ),
+    ).toEqual(['2024-06-03']);
+    const before = {
+      ...monthly,
+      start: '2024-06-01',
+      weekendSolveMode: 'before' as const,
+    };
+    expect(await call(before, '2024-05-31', '2024-05-31')).toEqual([
+      '2024-05-31',
+    ]);
+  });
+
+  it('skips weekends for daily schedules and dedupes', async () => {
+    const daily = {
+      start: '2024-06-01',
+      frequency: 'daily' as const,
+      skipWeekend: true,
+      weekendSolveMode: 'after' as const,
+    };
+    expect(await call(daily, '2024-06-01', '2024-06-04')).toEqual([
+      '2024-06-03',
+      '2024-06-04',
+    ]);
+    const weekly = {
+      start: '2024-06-01',
+      frequency: 'weekly' as const,
+      interval: 1,
+      skipWeekend: true,
+      weekendSolveMode: 'after' as const,
+    };
+    expect(await call(weekly, '2024-06-01', '2024-06-10')).toEqual([
+      '2024-06-03',
+      '2024-06-10',
+    ]);
+  });
+});
