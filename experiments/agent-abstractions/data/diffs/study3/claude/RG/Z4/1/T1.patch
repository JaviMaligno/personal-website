+// Daily schedules skip weekend occurrences instead of moving them
+export function isDailyWeekendSkipping(
+  data: { skipWeekend?: boolean; frequency?: string } | undefined,
+): boolean {
+  return !!data?.skipWeekend && data.frequency === 'daily';
+}
+
+const MAX_WEEKEND_SCAN = 1000;
+
+function firstWeekdayOccurrence(occurrences: Iterable<{ date: Date }>) {
+  let scanned = 0;
+  for (const occurrence of occurrences) {
+    if (!d.isWeekend(occurrence.date)) {
+      return [occurrence];
+    }
+    if (++scanned >= MAX_WEEKEND_SCAN) {
+      break;
+    }
+  }
+  return [];
+}
