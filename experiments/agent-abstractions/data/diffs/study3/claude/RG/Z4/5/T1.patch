+
+function firstWeekdayOccurrence(
+  schedule,
+  options: { start?: Date; reverse?: boolean },
+) {
+  const found = schedule
+    .occurrences({ ...options, take: MAX_WEEKEND_SKIPS })
+    .toArray()
+    .find(occurrence => !d.isWeekend(occurrence.date));
+  return found ? [found] : [];
