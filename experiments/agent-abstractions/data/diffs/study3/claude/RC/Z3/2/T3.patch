+
+describe('linking a closed account', () => {
+  const message =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+  function linkArgs(upgradingId: string) {
+    return {
+      requisitionId: 'req-1',
+      account: {
+        account_id: 'ext-1',
+        name: 'Bank Checking',
+        official_name: 'Bank Checking',
+        mask: '1234',
+        institution: { name: 'Bank' },
+      },
+      upgradingId,
+    } as unknown as Parameters<
+      (typeof app.handlers)['gocardless-accounts-link']
+    >[0];
+  }
+
+  it('refuses to link a closed account without changing anything', async () => {
+    await db.insertAccount({ id: 'acct1', name: 'Old', closed: 1 });
+
+    await expect(
+      app.handlers['gocardless-accounts-link'](linkArgs('acct1')),
+    ).rejects.toThrow(message);
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(account!.account_id).toBeNull();
+    expect(account!.account_sync_source).toBeNull();
+    expect(account!.bank).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    const banks = await db.all('SELECT * FROM banks');
+    expect(banks).toEqual([]);
+  });
+
+  it('refuses to re-link a closed account that already holds the link', async () => {
+    insertBank({ id: 'bank1', bank_id: 'gc-bank', name: 'GoCardless' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Old',
+      closed: 1,
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(
+      app.handlers['gocardless-accounts-link'](linkArgs('acct1')),
+    ).rejects.toThrow(message);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
