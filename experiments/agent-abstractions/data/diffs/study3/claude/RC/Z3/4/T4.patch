+
+describe('replaceExistingLink', () => {
+  const linkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    balance: 0,
+    org: { name: 'Bank', domain: 'bank.example' },
+  } as unknown as Parameters<typeof linkHandler>[0]['externalAccount'];
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    } as unknown as Awaited<ReturnType<typeof bankSync.syncAccount>>);
+  });
+
+  async function getAccount(id: string) {
+    return db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [id]);
+  }
+
+  it('refuses without the flag', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'old', name: 'Old', accountId: 'ext-1' },
+    ]);
+    await expect(linkHandler({ externalAccount })).rejects.toThrow(
+      'already linked',
+    );
+    expect((await getAccount('old')).account_id).toBe('ext-1');
+  });
+
+  it('unlinks the previous holder when set', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'old', name: 'Old', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'new', name: 'New' });
+    await linkHandler({
+      externalAccount,
+      upgradingId: 'new',
+      replaceExistingLink: true,
+    });
+    const old = await getAccount('old');
+    expect(old.account_id).toBeNull();
+    expect(old.bank).toBeNull();
+    expect(old.account_sync_source).toBeNull();
+    expect((await getAccount('new')).account_id).toBe('ext-1');
+  });
+
+  it('still refuses closed accounts and changes nothing', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'old', name: 'Old', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'new', name: 'New', closed: 1 });
+    await expect(
+      linkHandler({
+        externalAccount,
+        upgradingId: 'new',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow('Closed');
+    expect((await getAccount('old')).account_id).toBe('ext-1');
+  });
+});
