+describe('simplefin-accounts-link', () => {
+  const linkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Bank Checking',
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    balance: 0,
+    orgId: 'org',
+  };
+
+  async function link(upgradingId: string) {
+    return runMutator(() => linkHandler({ externalAccount, upgradingId }));
+  }
+
+  it('refuses to link a closed account and changes nothing', async () => {
+    await db.insertAccount({ id: 'acct1', name: 'Old', closed: 1 });
+
+    await expect(link('acct1')).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    const acct = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(acct.account_id).toBeNull();
+    expect(acct.closed).toBe(1);
+    const banks = await db.all('SELECT id FROM banks');
+    expect(banks).toHaveLength(0);
+  });
+
+  it('refuses to re-link a closed account that holds the link', async () => {
+    insertBank({ id: 'bank1', bank_id: 'sfin-bank', name: 'SimpleFin' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Old',
+      closed: 1,
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(link('acct1')).rejects.toThrow(/Closed accounts cannot/);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
