+// Unlinks any other local account holding the bank account. Only the local
+// link is cleared; nothing is sent to the provider since the bank connection
+// stays in use by the new link.
+async function releaseExistingLink(
+  syncSource: NonNullable<AccountEntity['account_sync_source']>,
+  externalAccountId: string,
+  newId: string,
+  replaceExistingLink: boolean,
+) {
+  if (!replaceExistingLink) {
+    return;
+  }
+  const holders = await db.all<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ? AND id != ?`,
+    [syncSource, externalAccountId, newId],
+  );
+  for (const { id } of holders) {
+    await db.updateAccount({
+      id,
+      account_id: null,
+      bank: null,
+      balance_current: null,
+      balance_available: null,
+      balance_limit: null,
+      account_sync_source: null,
+      bank_sync_status: null,
+    });
+  }
+}
