@@ -366,3 +366,55 @@ describe('linking to a closed account', () => {
     expect(bankSync.syncAccount).not.toHaveBeenCalled();
   });
 });
+
+describe('simplefin-accounts-link replaceExistingLink', () => {
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    orgId: 'org',
+    balance: 0,
+  };
+
+  it('refuses without the flag and unlinks the holder with it', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'old', name: 'Old', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'fresh', name: 'Fresh' });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+    } as never);
+    const link = app.handlers['simplefin-accounts-link'];
+
+    await expect(
+      link({ externalAccount, upgradingId: 'fresh' } as never),
+    ).rejects.toThrow('already linked');
+
+    await link({
+      externalAccount,
+      upgradingId: 'fresh',
+      replaceExistingLink: true,
+    } as never);
+
+    const old = await db.first<Record<string, unknown>>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['old'],
+    );
+    expect(old).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      tombstone: 0,
+    });
+    const fresh = await db.first<Record<string, unknown>>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['fresh'],
+    );
+    expect(fresh).toMatchObject({
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+});
