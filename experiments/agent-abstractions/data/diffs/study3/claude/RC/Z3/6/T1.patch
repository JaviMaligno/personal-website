+// Refuses to link a bank account that another (non-deleted) local account
+// already holds through the same provider.
+async function assertBankAccountNotLinked(
+  syncSource: NonNullable<AccountEntity['account_sync_source']>,
+  externalAccountId: string,
+  upgradingId?: string,
+) {
+  const existing = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+       AND (? IS NULL OR id != ?)`,
+    [syncSource, externalAccountId, upgradingId ?? null, upgradingId ?? null],
+  );
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
