+  await assertBankAccountNotLinked(
+    'fintegra',
+    externalAccount.account_id,
+    params.upgradingId,
+  );
+
+  const institution = {
+    name: externalAccount.institution ?? null,
+  };
+
+  const bank = await link.findOrCreateBank(institution, externalAccount.orgId);
+
+  return linkBankSyncAccount({
+    ...params,
+    bank,
+    accountId: externalAccount.account_id,
+    syncSource: 'fintegra',
+    newAccountFields: {
+      name: externalAccount.name,
+      official_name: externalAccount.name,
+    },
+    syncedTables: ['transactions', 'accounts'],
+  });
+}
