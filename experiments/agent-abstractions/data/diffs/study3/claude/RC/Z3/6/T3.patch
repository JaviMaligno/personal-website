@@ -0,0 +1,52 @@
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+
+beforeEach(async () => {
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+const externalAccount = {
+  account_id: 'ext-1',
+  name: 'Checking',
+  balance: 0,
+  orgId: 'org',
+  orgDomain: 'bank.example',
+  institution: 'Bank',
+};
+
+async function link(upgradingId: string) {
+  return app.handlers['simplefin-accounts-link']({
+    externalAccount,
+    upgradingId,
+  } as never);
+}
+
+describe('linking a bank account', () => {
+  it('refuses a closed account and leaves it untouched', async () => {
+    const id = await db.insertAccount({ name: 'Old', closed: 1 });
+    const before = await db.first('SELECT * FROM accounts WHERE id = ?', [id]);
+
+    await expect(link(id)).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await db.first('SELECT * FROM accounts WHERE id = ?', [id])).toEqual(
+      before,
+    );
+    expect(await db.all('SELECT id FROM banks')).toHaveLength(0);
+  });
+
+  it('refuses a closed account that already holds the link', async () => {
+    const id = await db.insertAccount({
+      name: 'Old',
+      closed: 1,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(link(id)).rejects.toThrow(/Closed accounts cannot be linked/);
+  });
+});
