+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const isDaily = config.frequency === 'daily';
+
+  // Weekend adjustment moves an occurrence by at most two days, so look
+  // slightly beyond the period and filter on the adjusted day.
+  const from = d.subDays(parseDate(start), 2);
+  const to = dayFromDate(d.addDays(parseDate(end), 2));
+
+  const days = new Set<string>();
+  for (const occurrence of schedule.occurrences({ start: from })) {
+    const raw = dayFromDate(occurrence.date);
+    if (raw > to) break;
+
+    let day = raw;
+    if (config.skipWeekend) {
+      if (isDaily) {
+        if (d.isWeekend(occurrence.date)) continue;
+      } else {
+        day = dayFromDate(
+          getDateWithWeekendRule(
+            occurrence.date,
+            config.skipWeekend,
+            config.weekendSolveMode,
+          ),
+        );
+      }
+    }
+
+    if (day >= start && day <= end) days.add(day);
+  }
+
+  return [...days].sort();
+}
