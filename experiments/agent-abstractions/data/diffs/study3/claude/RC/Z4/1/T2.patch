+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: Parameters<typeof recurConfigToRSchedule>[0];
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    // The weekend rule moves a date by at most two days, so look slightly
+    // beyond the period and decide on the adjusted day.
+    const days = schedule
+      .occurrences({
+        start: d.subDays(d.startOfDay(parseDate(start)), 3),
+        end: d.addDays(d.endOfDay(parseDate(end)), 3),
+      })
+      .toArray()
+      .map(date =>
+        dayFromDate(
+          applyWeekendRule(
+            date.date,
+            config.skipWeekend,
+            config.weekendSolveMode,
+          ),
+        ),
+      )
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
