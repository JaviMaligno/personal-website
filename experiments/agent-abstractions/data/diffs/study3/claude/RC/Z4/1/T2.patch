+describe('schedule/get-dates-in-range', () => {
+  const run = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences into and out of the period', async () => {
+    // 2024-06-01 is a Saturday, 2024-06-02 a Sunday
+    const config = {
+      start: '2024-06-01',
+      frequency: 'daily',
+      interval: 1,
+      patterns: [],
+      skipWeekend: false,
+      weekendSolveMode: 'after',
+      endMode: 'never',
+    };
+    expect(await run(config, '2024-06-03', '2024-06-04')).toEqual([
+      '2024-06-03',
+      '2024-06-04',
+    ]);
+    const weekly = {
+      ...config,
+      frequency: 'weekly',
+      skipWeekend: true,
+    };
+    // Sat 06-01 -> Mon 06-03; Sat 06-08 -> Mon 06-10
+    expect(await run(weekly, '2024-06-02', '2024-06-03')).toEqual([
+      '2024-06-03',
+    ]);
+    expect(await run(weekly, '2024-06-01', '2024-06-02')).toEqual([]);
+    expect(
+      await run(
+        { ...weekly, weekendSolveMode: 'before' },
+        '2024-05-31',
+        '2024-05-31',
+      ),
+    ).toEqual(['2024-05-31']);
+  });
+});
