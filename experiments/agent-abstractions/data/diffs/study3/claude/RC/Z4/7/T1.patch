diff --git a/packages/loot-core/src/shared/schedules.test.ts b/packages/loot-core/src/shared/schedules.test.ts
index 5bd000a..92d3578 100644
--- a/packages/loot-core/src/shared/schedules.test.ts
+++ b/packages/loot-core/src/shared/schedules.test.ts
@@ -643,3 +643,48 @@ describe('schedules', () => {
     });
   });
 });
+
+describe('daily schedules with weekend handling', () => {
+  function daily(start: string, mode: 'before' | 'after', interval = 1) {
+    return {
+      op: 'isapprox',
+      value: {
+        start,
+        frequency: 'daily',
+        interval,
+        patterns: [],
+        skipWeekend: true,
+        weekendSolveMode: mode,
+      },
+    };
+  }
+
+  it.each(['before', 'after'] as const)(
+    'skips weekend days when solving %s',
+    mode => {
+      // 2020-12-05 is a Saturday
+      expect(
+        getNextDate(daily('2020-12-01', mode), new Date(2020, 11, 5)),
+      ).toBe('2020-12-07');
+      expect(
+        getNextDate(daily('2020-12-05', mode), new Date(2020, 11, 5)),
+      ).toBe('2020-12-07');
+      expect(
+        getNextDate(daily('2020-12-01', mode), new Date(2020, 11, 3)),
+      ).toBe('2020-12-03');
+    },
+  );
+
+  it('skips weekends for every-few-days schedules', () => {
+    // Every 3 days from Thursday 2020-12-03: Thu, Sun (skipped), Wed
+    expect(
+      getNextDate(daily('2020-12-03', 'before', 3), new Date(2020, 11, 4)),
+    ).toBe('2020-12-09');
+  });
+
+  it('does not skip when weekend handling is off', () => {
+    const cond = daily('2020-12-01', 'before');
+    cond.value.skipWeekend = false;
+    expect(getNextDate(cond, new Date(2020, 11, 5))).toBe('2020-12-05');
+  });
+});
