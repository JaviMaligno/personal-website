+
+it('supports yearly MM-DD holidays alongside full dates', () => {
+  const mk = (from: string, holidays: string[]) =>
+    getNextDate(
+      {
+        op: 'is',
+        value: {
+          frequency: 'daily',
+          skipWeekend: true,
+          weekendSolveMode: 'after',
+          start: '2024-01-01',
+          holidays,
+        },
+      },
+      new Date(from),
+    );
+  expect(mk('2025-12-25', ['12-25'])).toBe('2025-12-26');
+  expect(mk('2030-12-25', ['12-25'])).toBe('2030-12-26');
+  expect(mk('2024-12-25', ['2024-12-25', '07-04'])).toBe('2024-12-26');
+  expect(mk('2025-12-25', ['2024-12-25'])).toBe('2025-12-25');
+});
