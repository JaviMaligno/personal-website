+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: Parameters<typeof recurConfigToRSchedule>[0];
+  start: string;
+  end: string;
+}) {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+    // A weekend occurrence moves by at most two days in either direction, so
+    // look slightly outside the period and decide on the adjusted day.
+    const days = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 2)),
+        end: d.endOfDay(d.addDays(parseDate(end), 2)),
+      })
+      .toArray()
+      .map(date =>
+        dayFromDate(
+          applyWeekendRule(
+            date.date,
+            config.skipWeekend,
+            config.weekendSolveMode,
+          ),
+        ),
+      )
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
