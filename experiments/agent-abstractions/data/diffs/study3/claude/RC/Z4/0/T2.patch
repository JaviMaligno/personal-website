+  it('moves weekend occurrences and decides by the final day', async () => {
+    const config = { ...base, start: '2024-01-06', skipWeekend: true };
+    // Sat 6th -> Mon 8th, Sat 13th -> Mon 15th
+    expect(
+      await schedulesApp.handlers['schedule/get-dates-in-range']({
+        config: config as never,
+        start: '2024-01-08',
+        end: '2024-01-15',
+      }),
+    ).toEqual(['2024-01-08', '2024-01-15']);
+    expect(
+      await schedulesApp.handlers['schedule/get-dates-in-range']({
+        config: config as never,
+        start: '2024-01-06',
+        end: '2024-01-07',
+      }),
+    ).toEqual([]);
+  });
+});
