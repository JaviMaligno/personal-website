+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+    // Weekend adjustment moves an occurrence by at most 2 days in either
+    // direction, so look slightly beyond the period and filter afterwards.
+    const dates = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.endOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray();
+
+    const days = new Set<string>();
+    for (const { date } of dates) {
+      if (config.skipWeekend && config.frequency === 'daily') {
+        if (d.isWeekend(date)) continue;
+        days.add(dayFromDate(date));
+      } else {
+        days.add(
+          dayFromDate(
+            applyWeekendRule(date, config.skipWeekend, config.weekendSolveMode),
+          ),
+        );
+      }
+    }
+
+    return [...days].filter(day => day >= start && day <= end).sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
