+describe('holidays', () => {
+  const base = {
+    start: '2024-05-01',
+    frequency: 'monthly',
+    skipWeekend: true,
+    weekendSolveMode: 'after',
+  };
+  it('moves a weekend occurrence past a holiday Monday', () => {
+    const cond = {
+      op: 'isapprox',
+      value: { ...base, start: '2024-06-01', holidays: ['2024-06-03'] },
+    };
+    expect(getNextDate(cond, new Date(2024, 5, 1))).toBe('2024-06-04');
+  });
+  it('moves a holiday occurrence before', () => {
+    const cond = {
+      op: 'isapprox',
+      value: {
+        ...base,
+        start: '2024-06-05',
+        weekendSolveMode: 'before',
+        holidays: ['2024-06-05', '2024-06-04'],
+      },
+    };
+    expect(getNextDate(cond, new Date(2024, 5, 5))).toBe('2024-06-03');
+  });
+  it('skips holidays for daily schedules', () => {
+    const cond = {
+      op: 'isapprox',
+      value: {
+        start: '2024-06-03',
+        frequency: 'daily',
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+        holidays: ['2024-06-03'],
+      },
+    };
+    expect(getNextDate(cond, new Date(2024, 5, 3))).toBe('2024-06-04');
+  });
+  it('ignores holidays when weekend handling is off', () => {
+    const cond = {
+      op: 'isapprox',
+      value: {
+        ...base,
+        skipWeekend: false,
+        start: '2024-06-05',
+        holidays: ['2024-06-05'],
+      },
+    };
+    expect(getNextDate(cond, new Date(2024, 5, 5))).toBe('2024-06-05');
+  });
+});
