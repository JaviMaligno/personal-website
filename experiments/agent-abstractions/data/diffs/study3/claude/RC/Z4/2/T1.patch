+describe('daily schedules with weekend handling', () => {
+  function daily(mode: 'before' | 'after') {
+    return {
+      op: 'isapprox',
+      value: {
+        start: '2020-12-05', // Saturday
+        frequency: 'daily',
+        patterns: [],
+        skipWeekend: true,
+        weekendSolveMode: mode,
+        endMode: 'never',
+      },
+    };
+  }
+
+  it.each(['before', 'after'] as const)(
+    'skips weekend days instead of moving them (%s)',
+    mode => {
+      expect(getNextDate(daily(mode), new Date(2020, 11, 5))).toBe(
+        '2020-12-07',
+      );
+      expect(getNextDate(daily(mode), new Date(2020, 11, 11))).toBe(
+        '2020-12-11',
+      );
+      expect(getNextDate(daily(mode), new Date(2020, 11, 12))).toBe(
+        '2020-12-14',
+      );
+      expect(getNextDateAfter(daily(mode), '2020-12-11')).toBe('2020-12-14');
+    },
+  );
+});
