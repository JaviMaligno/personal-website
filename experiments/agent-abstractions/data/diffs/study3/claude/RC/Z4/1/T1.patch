--- a/packages/loot-core/src/shared/schedules.test.ts
+++ b/packages/loot-core/src/shared/schedules.test.ts
@@ -28,6 +28,37 @@ describe('schedules', () => {
   beforeEach(() => {
     MockDate.set(new Date(2021, 4, 14));
   });
+
+  describe('daily schedules with weekend handling', () => {
+    // 2021-05-14 is a Friday
+    const cond = (weekendSolveMode: 'before' | 'after') => ({
+      op: 'isapprox',
+      field: 'date',
+      value: {
+        start: '2021-05-14',
+        frequency: 'daily',
+        patterns: [],
+        skipWeekend: true,
+        weekendSolveMode,
+        endMode: 'never',
+      },
+    });
+
+    it.each(['before', 'after'] as const)(
+      'skips weekend days when solving %s',
+      mode => {
+        expect(getNextDate(cond(mode), new Date(2021, 4, 15))).toBe(
+          '2021-05-17',
+        );
+        expect(getNextDate(cond(mode), new Date(2021, 4, 16))).toBe(
+          '2021-05-17',
+        );
+        expect(getNextDate(cond(mode), new Date(2021, 4, 14))).toBe(
+          '2021-05-14',
+        );
+      },
+    );
+  });
   afterEach(() => {
     MockDate.reset();
   });
