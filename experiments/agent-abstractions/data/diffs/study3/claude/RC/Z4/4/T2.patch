+describe('schedule/get-dates-in-range', () => {
+  const run = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences and decides by the final day', async () => {
+    // 2024-06-01 is a Saturday, 2024-06-02 a Sunday
+    const config = {
+      start: '2024-06-01',
+      frequency: 'daily' as const,
+      skipWeekend: false,
+    };
+    expect(await run(config, '2024-06-01', '2024-06-03')).toHaveLength(3);
+
+    const monthly = {
+      start: '2024-06-01',
+      frequency: 'monthly' as const,
+      skipWeekend: true,
+      weekendSolveMode: 'before' as const,
+    };
+    // Saturday June 1 moves back to Friday May 31
+    expect(await run(monthly, '2024-05-31', '2024-05-31')).toEqual([
+      '2024-05-31',
+    ]);
+    expect(await run(monthly, '2024-06-01', '2024-06-30')).toEqual([]);
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    const config = {
+      start: '2024-06-03',
+      frequency: 'daily' as const,
+      skipWeekend: true,
+      weekendSolveMode: 'after' as const,
+    };
+    expect(await run(config, '2024-06-07', '2024-06-10')).toEqual([
+      '2024-06-07',
+      '2024-06-10',
+    ]);
+  });
+});
