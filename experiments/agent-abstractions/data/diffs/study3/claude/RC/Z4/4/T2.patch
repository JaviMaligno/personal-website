+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}) {
+  if (start > end) {
+    return [];
+  }
+
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    // A weekend occurrence moves at most two days, so look a bit beyond the
+    // period and decide membership by the adjusted day.
+    const from = d.startOfDay(d.subDays(parseDate(start), 3));
+    const to = d.endOfDay(d.addDays(parseDate(end), 3));
+    // Daily schedules skip weekends (handled by the recurrence) rather than
+    // moving them.
+    const moveWeekend = config.frequency !== 'daily';
+
+    const days = new Set<string>();
+    for (const occurrence of schedule
+      .occurrences({ start: from, end: to })
+      .toArray()) {
+      const day = dayFromDate(
+        moveWeekend
+          ? applyWeekendRule(
+              occurrence.date,
+              config.skipWeekend,
+              config.weekendSolveMode,
+            )
+          : occurrence.date,
+      );
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
