+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const isDaily = config.frequency === 'daily';
+    // A weekend occurrence moves at most two days, so look slightly outside
+    // the period and decide membership by the final day.
+    const found = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.endOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray();
+
+    const result = new Set<string>();
+    for (const { date } of found) {
+      if (config.skipWeekend && isDaily && d.isWeekend(date)) continue;
+      const day = dayFromDate(
+        applyWeekendRule(
+          date,
+          config.skipWeekend && !isDaily,
+          config.weekendSolveMode,
+        ),
+      );
+      if (day >= start && day <= end) result.add(day);
+    }
+    return [...result].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
