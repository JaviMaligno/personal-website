+describe('schedule/get-dates-in-range', () => {
+  const run = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences and decides by the final day', async () => {
+    // 2024-06-01 is a Saturday, 2024-06-02 a Sunday
+    const monthly = (day, solve) => ({
+      start: '2024-01-01',
+      frequency: 'monthly',
+      interval: 1,
+      patterns: [{ type: 'day', value: day }],
+      skipWeekend: true,
+      weekendSolveMode: solve,
+      endMode: 'never',
+    });
+    expect(await run(monthly(1, 'after'), '2024-06-03', '2024-06-30')).toEqual([
+      '2024-06-03',
+    ]);
+    expect(await run(monthly(1, 'before'), '2024-06-01', '2024-06-30')).toEqual(
+      [],
+    );
+    expect(await run(monthly(1, 'before'), '2024-05-31', '2024-05-31')).toEqual(
+      ['2024-05-31'],
+    );
+  });
+
+  it('skips weekends for daily schedules', async () => {
+    expect(
+      await run(
+        {
+          start: '2024-01-01',
+          frequency: 'daily',
+          interval: 1,
+          patterns: [],
+          skipWeekend: true,
+          weekendSolveMode: 'after',
+          endMode: 'never',
+        },
+        '2024-05-31',
+        '2024-06-04',
+      ),
+    ).toEqual(['2024-05-31', '2024-06-03', '2024-06-04']);
+  });
+});
