+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const skipsWeekendDays = skipsWeekendOccurrences(config);
+
+    // Weekend adjustment moves an occurrence by at most 2 days, so look a
+    // little outside of the period and decide by the final day.
+    const days = new Set<string>();
+    schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.endOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray()
+      .filter(o => !skipsWeekendDays || !d.isWeekend(o.date))
+      .forEach(o => {
+        const day = dayFromDate(
+          applyWeekendRule(o.date, config.skipWeekend, config.weekendSolveMode),
+        );
+        if (day >= start && day <= end) {
+          days.add(day);
+        }
+      });
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
