       getDateWithWeekendRule(new Date(2024, 0, 12), false, 'before', holidays),
     ).toEqual(new Date(2024, 0, 12));
   });
+
+  it('treats MM-DD entries as holidays every year', () => {
+    const holidays = ['01-08', '2024-01-12'];
+    expect(
+      getDateWithWeekendRule(new Date(2024, 0, 6), true, 'after', holidays),
+    ).toEqual(new Date(2024, 0, 9));
+    // Other year: 01-08-2029 is a Monday, recurring entry applies
+    expect(
+      getDateWithWeekendRule(new Date(2029, 0, 8), true, 'after', holidays),
+    ).toEqual(new Date(2029, 0, 9));
+    // Full-date entry applies to its own year only
+    expect(
+      getDateWithWeekendRule(new Date(2025, 0, 12), false, 'before', holidays),
+    ).toEqual(new Date(2025, 0, 12));
+    expect(
+      getDateWithWeekendRule(new Date(2029, 0, 12), true, 'before', holidays),
+    ).toEqual(new Date(2029, 0, 12));
+  });
 });
