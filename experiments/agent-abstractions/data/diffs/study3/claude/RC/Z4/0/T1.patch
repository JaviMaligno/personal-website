+  describe('getNextDate with daily schedules skipping weekends', () => {
+    function daily(start: string, interval: number, mode: string) {
+      return {
+        op: 'is',
+        value: {
+          start,
+          frequency: 'daily',
+          interval,
+          patterns: [],
+          skipWeekend: true,
+          weekendSolveMode: mode,
+        },
+      };
+    }
+
+    it.each(['before', 'after'])(
+      'skips weekend days instead of moving them (%s)',
+      mode => {
+        // 2020-12-05 is a Saturday
+        const cond = daily('2020-12-01', 1, mode);
+        expect(getNextDate(cond, new Date(2020, 11, 5))).toBe('2020-12-07');
+        expect(getNextDate(cond, new Date(2020, 11, 6))).toBe('2020-12-07');
+        expect(getNextDate(cond, new Date(2020, 11, 4))).toBe('2020-12-04');
+      },
+    );
+
+    it('never reports a date before a weekend start', () => {
+      const cond = daily('2020-12-05', 1, 'before');
+      expect(getNextDate(cond, new Date(2020, 11, 1))).toBe('2020-12-07');
+    });
+
+    it('keeps the interval when skipping', () => {
+      // Sat 5, Mon 7, Wed 9 ...
+      const cond = daily('2020-12-05', 2, 'after');
+      expect(getNextDate(cond, new Date(2020, 11, 5))).toBe('2020-12-07');
+    });
+
+    it('returns null when every occurrence is on a weekend', () => {
+      const cond = daily('2020-12-05', 7, 'after');
+      expect(getNextDate(cond, new Date(2020, 11, 1))).toBeNull();
+    });
+
+    it('still moves weekend occurrences for weekly schedules', () => {
+      const cond = {
+        op: 'is',
+        value: {
+          start: '2020-12-05',
+          frequency: 'weekly',
+          patterns: [],
+          skipWeekend: true,
+          weekendSolveMode: 'after',
+        },
+      };
+      expect(getNextDate(cond, new Date(2020, 11, 1))).toBe('2020-12-07');
+    });
+  });
