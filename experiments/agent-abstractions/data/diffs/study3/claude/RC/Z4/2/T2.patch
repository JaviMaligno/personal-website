+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const skipsWeekendDays = isDailyWeekendSkip(
+      config.skipWeekend,
+      config.frequency,
+    );
+
+    // Weekend adjustment moves an occurrence by at most two days, so widen
+    // the search and decide membership on the adjusted day.
+    const days = new Set<string>();
+    schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.endOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray()
+      .forEach(occurrence => {
+        if (skipsWeekendDays) {
+          if (d.isWeekend(occurrence.date)) return;
+          days.add(dayFromDate(occurrence.date));
+          return;
+        }
+        days.add(
+          dayFromDate(
+            applyWeekendRule(
+              occurrence.date,
+              config.skipWeekend,
+              config.weekendSolveMode,
+            ),
+          ),
+        );
+      });
+
+    return [...days].filter(day => day >= start && day <= end).sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
