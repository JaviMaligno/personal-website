+describe('getDatesInRange', () => {
+  const base = {
+    start: '2024-01-01',
+    frequency: 'monthly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: true,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('moves weekend occurrences and decides membership on the final day', async () => {
+    // 2024-06-01 is a Saturday -> Monday the 3rd
+    const config = { ...base, start: '2024-06-01' };
+    expect(
+      await getDatesInRange({ config, start: '2024-06-03', end: '2024-06-03' }),
+    ).toEqual(['2024-06-03']);
+    expect(
+      await getDatesInRange({ config, start: '2024-06-01', end: '2024-06-02' }),
+    ).toEqual([]);
+  });
+
+  it('moves occurrences before and skips daily weekends', async () => {
+    const config = { ...base, start: '2024-06-02', weekendSolveMode: 'before' };
+    expect(
+      await getDatesInRange({ config, start: '2024-05-30', end: '2024-06-02' }),
+    ).toEqual(['2024-05-31']);
+    const daily = { ...base, frequency: 'daily' };
+    expect(
+      await getDatesInRange({
+        config: { ...daily, start: '2024-06-03' },
+        start: '2024-06-07',
+        end: '2024-06-10',
+      }),
+    ).toEqual(['2024-06-07', '2024-06-10']);
+  });
+});
