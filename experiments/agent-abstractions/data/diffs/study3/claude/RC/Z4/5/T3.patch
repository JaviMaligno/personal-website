+describe('holidays', () => {
+  it('moves a weekend date past a holiday Monday', async () => {
+    const { applyWeekendRule } = await import('./schedules');
+    // 2024-06-01 is a Saturday
+    const date = monthUtils.parseDate('2024-06-01');
+    expect(
+      monthUtils.dayFromDate(
+        applyWeekendRule(date, true, 'after', ['2024-06-03']),
+      ),
+    ).toBe('2024-06-04');
+    expect(
+      monthUtils.dayFromDate(
+        applyWeekendRule(date, true, 'before', ['2024-05-31']),
+      ),
+    ).toBe('2024-05-30');
+    expect(
+      monthUtils.dayFromDate(
+        applyWeekendRule(date, false, 'after', ['2024-06-03']),
+      ),
+    ).toBe('2024-06-01');
+  });
+});
