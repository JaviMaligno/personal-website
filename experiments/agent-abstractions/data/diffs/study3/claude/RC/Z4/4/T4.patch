+  const startYear = config.start
+    ? monthUtils.parseDate(config.start).getFullYear()
+    : new Date().getFullYear();
+  const lastYear = Math.max(startYear, new Date().getFullYear()) + 100;
+  const exdates: Date[] = [];
+  for (const day of (config.holidays ?? []) as string[]) {
+    if (day.length === 5) {
+      // MM-DD: every year (Feb 29 only exists in leap years)
+      for (let year = startYear; year <= lastYear; year++) {
+        const date = d.setHours(monthUtils.parseDate(`${year}-${day}`), 12);
+        if (monthUtils.dayFromDate(date) === `${year}-${day}`) {
+          exdates.push(date);
+        }
+      }
+    } else {
+      exdates.push(d.setHours(monthUtils.parseDate(day), 12));
+    }
+  }
+  return exdates;
 }
 
