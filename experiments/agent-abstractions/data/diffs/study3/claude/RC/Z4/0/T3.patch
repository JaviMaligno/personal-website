diff --git a/packages/loot-core/src/shared/schedules-holidays.test.ts b/packages/loot-core/src/shared/schedules-holidays.test.ts
new file mode 100644
index 0000000..e5b7ade
--- /dev/null
+++ b/packages/loot-core/src/shared/schedules-holidays.test.ts
@@ -0,0 +1,39 @@
+import { getNextDate } from './schedules';
+
+it('treats holidays like weekend days', () => {
+  const mk = (c: Record<string, unknown>, from: string) =>
+    getNextDate(
+      { op: 'is', value: { ...c, start: '2024-01-01' } },
+      new Date(from),
+    );
+  // Sat 2024-01-06 -> after, Mon 8 holiday -> Tue 9
+  expect(
+    mk(
+      {
+        frequency: 'weekly',
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+        start: '2024-01-06',
+        holidays: ['2024-01-08'],
+      },
+      '2024-01-06',
+    ),
+  ).toBe('2024-01-09');
+  expect(
+    mk(
+      {
+        frequency: 'daily',
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+        holidays: ['2024-01-02'],
+      },
+      '2024-01-02',
+    ),
+  ).toBe('2024-01-03');
+  expect(
+    mk(
+      { frequency: 'daily', skipWeekend: false, holidays: ['2024-01-02'] },
+      '2024-01-02',
+    ),
+  ).toBe('2024-01-02');
+});
