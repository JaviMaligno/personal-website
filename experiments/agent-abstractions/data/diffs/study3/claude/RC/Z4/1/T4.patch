+
+  it('treats MM-DD holidays as recurring every year', () => {
+    const holidays = ['01-08', '2024-01-12'];
+    // 2024-01-08 is a Monday holiday; before -> Friday 2024-01-05
+    expect(
+      monthUtils.dayFromDate(
+        applyWeekendRule(new Date(2024, 0, 8, 12), true, 'before', holidays),
+      ),
+    ).toBe('2024-01-05');
+    // Same day in a later year (2027-01-08 is a Friday) -> Thursday
+    expect(
+      monthUtils.dayFromDate(
+        applyWeekendRule(new Date(2027, 0, 8, 12), true, 'before', holidays),
+      ),
+    ).toBe('2027-01-07');
+    // Full dates still only apply to that year
+    expect(
+      monthUtils.dayFromDate(
+        applyWeekendRule(new Date(2025, 0, 12, 12), true, 'before', holidays),
+      ),
+    ).toBe('2025-01-10'); // Sunday anyway
+    expect(
+      monthUtils.dayFromDate(
+        applyWeekendRule(new Date(2026, 0, 12, 12), true, 'before', holidays),
+      ),
+    ).toBe('2026-01-12');
+  });
+
+  it('skips MM-DD holidays in daily schedules across years', () => {
+    const config = {
+      frequency: 'daily',
+      start: '2024-12-30',
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+      holidays: ['12-31', '01-01'],
+    };
+    const days = new RSchedule({
+      rrules: recurConfigToRSchedule(config),
+      exdates: recurConfigToExdates(config),
+    })
+      .occurrences({ take: 3 })
+      .toArray()
+      .map(x => monthUtils.dayFromDate(x.date));
+    expect(days).toEqual(['2024-12-30', '2025-01-02', '2025-01-03']);
+  });
 });
