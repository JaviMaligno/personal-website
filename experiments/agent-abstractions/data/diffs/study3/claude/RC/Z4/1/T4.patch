+  const holidays: string[] = config.holidays || [];
+  const startYear = config.start
+    ? monthUtils.parseDate(config.start).getFullYear()
+    : new Date().getFullYear();
+  const lastYear = Math.max(startYear, new Date().getFullYear()) + 100;
+  const exdates: Date[] = [];
+  for (const day of holidays) {
+    if (isYearlyHoliday(day)) {
+      for (let year = startYear; year <= lastYear; year++) {
+        const date = d.setHours(monthUtils.parseDate(`${year}-${day}`), 12);
+        // Skip invalid dates like 02-29 in non-leap years
+        if (dayMatchesMonthDay(date, day)) exdates.push(date);
+      }
+    } else {
+      exdates.push(d.setHours(monthUtils.parseDate(day), 12));
+    }
+  }
+  return exdates;
+}
+
+// A holiday is either `YYYY-MM-DD` (one day) or `MM-DD` (every year).
+function isYearlyHoliday(holiday: string): boolean {
+  return /^\d{2}-\d{2}$/.test(holiday);
+}
+
+function dayMatchesMonthDay(date: Date, monthDay: string): boolean {
+  return monthUtils.dayFromDate(date).slice(5) === monthDay;
 }
 
