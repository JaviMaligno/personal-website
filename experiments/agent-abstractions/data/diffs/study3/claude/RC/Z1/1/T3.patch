+
+  it('leaves categories in a #fixed group untouched', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'fixed', name: 'f', is_income: 0 });
+    await db.insertCategoryGroup({ id: 'other', name: 'o', is_income: 0 });
+    await db.insertCategory({ id: 'rent', name: 'rent', cat_group: 'fixed' });
+    await db.insertCategory({
+      id: 'food',
+      name: 'food',
+      cat_group: 'other',
+    });
+    await db.insertCategory({
+      id: 'cattag',
+      name: 'cattag',
+      cat_group: 'other',
+    });
+    await db.insert('notes', { id: 'fixed', note: 'Costs #fixed' });
+    await db.insert('notes', { id: 'cattag', note: '#fixed' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+    for (const id of ['rent', 'food', 'cattag']) {
+      await setBudget({ category: id, month: '2024-01', amount: 100 });
+      await sheet.waitOnSpreadsheet();
+    }
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-rent')).toBe(100);
+    expect(await getSheetValue('budget202401', 'budget-food')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-cattag')).toBe(0);
+  });
 });
