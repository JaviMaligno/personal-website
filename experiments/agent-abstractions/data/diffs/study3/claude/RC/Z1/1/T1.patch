+describe('setZero', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves hidden, hidden-group and templated categories untouched', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'g', name: 'g', is_income: 0 });
+    await db.insertCategoryGroup({
+      id: 'hg',
+      name: 'hg',
+      is_income: 0,
+      hidden: 1,
+    });
+    const cats = [
+      { id: 'plain', cat_group: 'g' },
+      { id: 'hidden', cat_group: 'g', hidden: 1 },
+      { id: 'ingroup', cat_group: 'hg' },
+      {
+        id: 'templated',
+        cat_group: 'g',
+        goal_def: JSON.stringify([{ type: 'simple', monthly: 5 }]),
+      },
+    ];
+    for (const c of cats) {
+      await db.insertCategory({ name: c.id, is_income: 0, ...c });
+    }
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+    for (const c of cats) {
+      await setBudget({ category: c.id, month: '2024-01', amount: 100 });
+      await sheet.waitOnSpreadsheet();
+    }
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    const sheetName = 'budget202401';
+    expect(await getSheetValue(sheetName, 'budget-plain')).toBe(0);
+    expect(await getSheetValue(sheetName, 'budget-hidden')).toBe(100);
+    expect(await getSheetValue(sheetName, 'budget-ingroup')).toBe(100);
+    expect(await getSheetValue(sheetName, 'budget-templated')).toBe(100);
+  });
+});
