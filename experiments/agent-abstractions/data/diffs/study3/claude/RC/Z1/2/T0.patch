diff --git a/packages/loot-core/src/server/budget/fill-rules.ts b/packages/loot-core/src/server/budget/fill-rules.ts
new file mode 100644
index 0000000..8d713dd
--- /dev/null
+++ b/packages/loot-core/src/server/budget/fill-rules.ts
@@ -0,0 +1,44 @@
+// The single definition of which categories a month-wide budget action
+// fills, and how an average is turned into the amount to budget.
+
+type FillCategory = {
+  is_income: 1 | 0;
+  hidden?: 1 | 0 | null;
+  group_hidden?: 1 | 0 | null;
+};
+
+// How an action treats hidden categories and categories in hidden groups:
+// - 'include': they are filled like any other category
+// - 'skip-hidden': skipped when explicitly flagged hidden
+// - 'require-visible': filled only when category and group are known visible
+//   (a category without a group is therefore not filled)
+export type HiddenPolicy = 'include' | 'skip-hidden' | 'require-visible';
+
+export function shouldFillCategory(
+  cat: FillCategory,
+  {
+    hiddenPolicy,
+    isTrackingBudget,
+  }: { hiddenPolicy: HiddenPolicy; isTrackingBudget: boolean },
+): boolean {
+  // Income categories are only budgeted in tracking budgets
+  if (cat.is_income === 1 && !isTrackingBudget) {
+    return false;
+  }
+  if (hiddenPolicy === 'include') {
+    return true;
+  }
+  if (hiddenPolicy === 'skip-hidden') {
+    return cat.hidden !== 1 && cat.group_hidden !== 1;
+  }
+  return cat.hidden === 0 && cat.group_hidden === 0;
+}
+
+// Averages are computed from spending (negative for expenses), so expense
+// categories are flipped into a positive amount to budget.
+export function averageToBudgetAmount(
+  cat: Pick<FillCategory, 'is_income'>,
+  average: number,
+): number {
+  return cat.is_income === 0 ? average * -1 : average;
+}
