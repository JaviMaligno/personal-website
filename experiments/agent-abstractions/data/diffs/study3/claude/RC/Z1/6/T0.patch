+// Month-wide fills (copy previous month, set to zero, averages) all decide
+// here which categories they write and how an average becomes an amount.
+type MonthFillKind = 'copy' | 'zero' | 'average';
+
+type MonthFillCategory = {
+  is_income: 1 | 0;
+  hidden: 1 | 0;
+  group_hidden?: 1 | 0 | null;
+};
+
+function isCategoryFilled(
+  cat: MonthFillCategory,
+  kind: MonthFillKind,
+): boolean {
+  if (cat.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+
+  switch (kind) {
+    case 'zero':
+      return true;
+    case 'copy':
+      return cat.hidden !== 1 && cat.group_hidden !== 1;
+    default:
+      // A category without a group is not visible, so it is not filled
+      return cat.hidden === 0 && cat.group_hidden === 0;
+  }
+}
+
+// Past spending is negative in the sheet; budget it as a positive amount
+function averageToBudgetAmount(avg: number, isIncome: 1 | 0): number {
+  return isIncome === 0 ? avg * -1 : avg;
+}
+
+async function getAverageFillCategories(): Promise<db.DbViewCategory[]> {
+  const categories = await db.all<
+    db.DbViewCategory & { group_hidden: 1 | 0 | null }
+  >(
+    `
+  SELECT c.*, g.hidden AS group_hidden
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0
+  `,
+  );
+  return categories.filter(cat => isCategoryFilled(cat, 'average'));
+}
