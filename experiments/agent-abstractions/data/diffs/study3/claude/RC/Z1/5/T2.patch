+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getCategoriesForAverage();
+  const prevMonth = monthUtils.prevMonth(month);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const activity = await getSheetValue(
+        monthUtils.sheetForMonth(prevMonth),
+        'sum-amount-' + cat.id,
+      );
+
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudgetAmount(activity, cat.is_income),
+      });
+    }
+  });
+}
