+// Which categories a month-wide action (copy previous month, set to zero,
+// averages) writes, and how past spending becomes a budgeted amount.
+type FillCategory = {
+  is_income: 1 | 0;
+  hidden: 1 | 0;
+  // null when the category's group doesn't exist
+  group_hidden: 1 | 0 | null;
+};
+
+function shouldFillCategory(
+  cat: FillCategory,
+  {
+    includeHidden,
+    requireGroup,
+  }: { includeHidden: boolean; requireGroup: boolean },
+): boolean {
+  // Income categories are only budgeted in tracking budgets
+  if (cat.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+  if (includeHidden) {
+    return true;
+  }
+  if (cat.hidden === 1 || cat.group_hidden === 1) {
+    return false;
+  }
+  // Averages only cover categories that belong to a visible group
+  return !requireGroup || cat.group_hidden === 0;
+}
+
+// Past spending is negative for expense categories; budget it as positive
+function spendingToBudgetAmount(
+  cat: Pick<FillCategory, 'is_income'>,
+  amount: number,
+): number {
+  return cat.is_income === 0 ? amount * -1 : amount;
+}
+
+function getFillCategories(): Promise<(FillCategory & { id: string })[]> {
+  return db.all<FillCategory & { id: string }>(
+    `
+  SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0
+  `,
+  );
+}
+
+async function getAverageFillCategories() {
+  const categories = await getFillCategories();
+  return categories.filter(cat =>
+    shouldFillCategory(cat, { includeHidden: false, requireGroup: true }),
+  );
+}
+
