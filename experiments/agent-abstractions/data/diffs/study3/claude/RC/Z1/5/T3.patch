 import * as budget from './base';
 
@@ -340,3 +341,57 @@ async function setupAverageDatabase() {
 
   await sheet.waitOnSpreadsheet();
 }
+
+describe('setZero with #fixed groups', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves categories in groups tagged #fixed untouched', async () => {
+    const groups = [
+      ['fixed', 'Rent #fixed'],
+      ['plain', null],
+      ['other', 'about #fixedcosts'],
+    ];
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    for (const [id, note] of groups) {
+      await db.insertCategoryGroup({ id, name: id, is_income: 0 });
+      await db.insertCategory({
+        id: `cat-${id}`,
+        name: id,
+        cat_group: id,
+        is_income: 0,
+      });
+      if (note) {
+        db.runQuery('INSERT INTO notes (id, note) VALUES (?, ?)', [id, note]);
+      }
+    }
+    // The tag in a category's own notes has no effect.
+    db.runQuery('INSERT INTO notes (id, note) VALUES (?, ?)', [
+      'cat-plain',
+      '#fixed',
+    ]);
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+    for (const [id] of groups) {
+      await setBudget({ category: `cat-${id}`, month: '2024-01', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-cat-fixed')).toBe(500);
+    expect(await getSheetValue('budget202401', 'budget-cat-plain')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-cat-other')).toBe(0);
+  });
+});
