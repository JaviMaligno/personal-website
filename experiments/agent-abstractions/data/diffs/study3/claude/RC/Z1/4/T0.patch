diff --git a/packages/loot-core/src/server/budget/fill-categories.ts b/packages/loot-core/src/server/budget/fill-categories.ts
new file mode 100644
index 0000000..47c7465
--- /dev/null
+++ b/packages/loot-core/src/server/budget/fill-categories.ts
@@ -0,0 +1,43 @@
+// The single definition of which categories a month-wide budget action
+// (copy previous month, set to zero, N-month averages) writes to, and of
+// how a past average becomes the amount to budget.
+
+export type FillCandidate = {
+  is_income: 1 | 0;
+  hidden?: 1 | 0;
+  group_hidden?: 1 | 0 | null;
+};
+
+// How an action treats hidden categories and categories in hidden groups:
+// - 'include': hidden categories are filled too
+// - 'skip-hidden': skipped if the category or its group is hidden
+// - 'require-visible-group': like 'skip-hidden', but a category without a
+//   group is skipped as well (the group must exist and be visible)
+export type HiddenPolicy = 'include' | 'skip-hidden' | 'require-visible-group';
+
+export function shouldFillCategory(
+  category: FillCandidate,
+  { hidden, isTracking }: { hidden: HiddenPolicy; isTracking: boolean },
+): boolean {
+  // Income categories are only budgeted in tracking budgets
+  if (category.is_income === 1 && !isTracking) {
+    return false;
+  }
+
+  if (hidden === 'include') {
+    return true;
+  }
+  if (hidden === 'skip-hidden') {
+    return category.hidden !== 1 && category.group_hidden !== 1;
+  }
+  return category.hidden === 0 && category.group_hidden === 0;
+}
+
+// Past spending is negative in the sheets, so for expense categories the
+// average is flipped into a positive amount to budget.
+export function averageToBudgetAmount(
+  category: Pick<FillCandidate, 'is_income'>,
+  average: number,
+): number {
+  return category.is_income === 0 ? average * -1 : average;
+}
