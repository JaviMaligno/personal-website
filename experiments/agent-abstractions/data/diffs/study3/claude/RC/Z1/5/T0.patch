+type FillableCategory = {
+  is_income: 1 | 0;
+  hidden: 1 | 0;
+  group_hidden: 1 | 0 | null;
+};
+
+// The single definition of which categories a month-wide budget action
+// writes. Income categories are only written in tracking budgets. Hidden
+// categories and categories in hidden groups are skipped unless
+// `includeHidden` is set. `requireGroup` additionally skips categories
+// that have no group at all.
+function shouldFillCategory(
+  cat: FillableCategory,
+  {
+    includeHidden = false,
+    requireGroup = false,
+  }: { includeHidden?: boolean; requireGroup?: boolean } = {},
+): boolean {
+  if (cat.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+  if (includeHidden) {
+    return true;
+  }
+  if (cat.hidden === 1 || cat.group_hidden === 1) {
+    return false;
+  }
+  return !requireGroup || cat.group_hidden != null;
+}
+
+// Averages are computed from (negative) spending in expense categories, so
+// they are flipped into a positive amount to budget.
+function averageToBudgetAmount(avg: number, isIncome: 1 | 0): number {
+  return isIncome === 0 ? avg * -1 : avg;
+}
+
+function getAllCategoriesWithGroupHidden() {
+  return db.all<db.DbViewCategoryWithGroupHidden>(
+    `
+  SELECT c.*, g.hidden AS group_hidden
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0
+  `,
+  );
+}
+
+async function getCategoriesForAverage() {
+  const categories = await getAllCategoriesWithGroupHidden();
+  return categories.filter(cat =>
+    shouldFillCategory(cat, { requireGroup: true }),
+  );
+}
+
