+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getAverageCategories();
+  const sheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const amount = await getSheetValue(sheetName, 'sum-amount-' + cat.id);
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudgetAmount(cat, amount),
+      });
+    }
+  });
+}
