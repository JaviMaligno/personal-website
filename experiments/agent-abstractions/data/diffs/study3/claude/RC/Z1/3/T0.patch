+// How a month-wide action treats hidden categories:
+// - 'include': hidden categories and hidden groups are filled
+// - 'skip': skipped when the category or its group is flagged hidden
+// - 'skip-unless-visible': filled only if both the category and its group
+//   are positively known to be visible (a category without a group is skipped)
+type MonthFillHiddenMode = 'include' | 'skip' | 'skip-unless-visible';
+
+type MonthFillCategory = Pick<BudgetData, 'is_income' | 'hidden'> & {
+  // null when the category has no matching group row
+  group_hidden: BudgetData['group_hidden'] | null;
+};
+
+// The single definition of which categories a month-wide budget action
+// (copy previous month, set to zero, averages) writes. Income categories are
+// only written in tracking budgets.
+function shouldFillCategory(
+  cat: MonthFillCategory,
+  hiddenMode: MonthFillHiddenMode,
+): boolean {
+  if (cat.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+
+  if (hiddenMode === 'include') {
+    return true;
+  }
+  if (hiddenMode === 'skip') {
+    return cat.hidden !== 1 && cat.group_hidden !== 1;
+  }
+  return cat.hidden === 0 && cat.group_hidden === 0;
+}
+
+async function getMonthFillCategories(
+  hiddenMode: MonthFillHiddenMode,
+): Promise<Array<MonthFillCategory & { id: string }>> {
+  const categories = await db.all<MonthFillCategory & { id: string }>(
+    `
+  SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0
+  `,
+  );
+  return categories.filter(cat => shouldFillCategory(cat, hiddenMode));
+}
+
+// Spending is negative in the sheet but expense budgets are positive.
+function averageToBudgetAmount(
+  cat: Pick<MonthFillCategory, 'is_income'>,
+  average: number,
+): number {
+  return cat.is_income === 0 ? average * -1 : average;
+}
