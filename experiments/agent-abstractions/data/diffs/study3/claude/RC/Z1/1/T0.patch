+// The single definition of which categories a month-wide action fills.
+// - `hiddenRule` decides how hidden categories / hidden groups are treated:
+//   - 'include': hidden state is ignored
+//   - 'skip': skip categories or groups flagged hidden (a missing group is
+//     not hidden)
+//   - 'skip-unless-visible': only categories that are visible and belong to
+//     an existing visible group are kept (a missing group is dropped)
+// - income categories are only filled in tracking budgets.
+type FillHiddenRule = 'include' | 'skip' | 'skip-unless-visible';
+
+type FillCandidate = {
+  is_income: 1 | 0;
+  hidden: 1 | 0;
+  group_hidden: 1 | 0 | null;
+};
+
+function shouldFillCategory(
+  cat: FillCandidate,
+  hiddenRule: FillHiddenRule,
+  isTracking: boolean,
+): boolean {
+  if (cat.is_income === 1 && !isTracking) {
+    return false;
+  }
+  if (hiddenRule === 'include') {
+    return true;
+  }
+  if (hiddenRule === 'skip') {
+    return cat.hidden !== 1 && cat.group_hidden !== 1;
+  }
+  return cat.hidden === 0 && cat.group_hidden === 0;
+}
+
+function filterFillCategories<T extends FillCandidate>(
+  categories: T[],
+  hiddenRule: FillHiddenRule,
+): T[] {
+  const isTracking = isTrackingBudget();
+  return categories.filter(cat =>
+    shouldFillCategory(cat, hiddenRule, isTracking),
+  );
+}
+
+type FillCategory = FillCandidate & { id: string };
+
+async function getFillCategories(
+  hiddenRule: FillHiddenRule,
+): Promise<FillCategory[]> {
+  const categories = await db.all<FillCategory>(
+    `
+  SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0
+  `,
+  );
+  return filterFillCategories(categories, hiddenRule);
+}
+
+// Spending is stored as a negative number; expense categories are budgeted
+// with the positive equivalent of their average.
+function averageToBudgetAmount(average: number, isIncome: 1 | 0): number {
+  return isIncome === 0 ? average * -1 : average;
+}
