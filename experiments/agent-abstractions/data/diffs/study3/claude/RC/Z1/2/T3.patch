+// Groups tagged #fixed in their notes hold fixed costs that are set once
+export function isFixedGroup(groupNotes?: string | null): boolean {
+  return !!groupNotes && /(^|\s)#fixed(?![\w-])/i.test(groupNotes);
+}
+
 // How an action treats hidden categories and categories in hidden groups:
 // - 'skip-hidden': skipped when explicitly flagged hidden
 // - 'require-visible': filled only when category and group are known visible
@@ -41,6 +47,9 @@ export function shouldFillCategory(
   if (hasSavedTemplates(cat.goal_def)) {
     return false;
   }
+  if (isFixedGroup(cat.group_notes)) {
+    return false;
+  }
   if (hiddenPolicy === 'skip-hidden') {
     return cat.hidden !== 1 && cat.group_hidden !== 1;
