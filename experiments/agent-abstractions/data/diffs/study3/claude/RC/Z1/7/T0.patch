+// The single definition of which categories a month-wide action fills.
+//
+// - `isIncome` categories are only filled in tracking budgets.
+// - Hidden categories (and categories in hidden groups) are handled according
+//   to `hidden`:
+//     'keep'    - filled regardless of hidden state
+//     'flagged' - skipped when the category or its group is flagged hidden
+//                 (a category with no group row is still filled)
+//     'visible' - filled only when the category and its group are both
+//                 explicitly not hidden (a category with no group row is skipped)
+type FillableCategory = {
+  is_income: 1 | 0;
+  hidden?: 1 | 0 | null;
+  group_hidden?: 1 | 0 | null;
+};
+
+function shouldFillCategory(
+  cat: FillableCategory,
+  hidden: 'keep' | 'flagged' | 'visible',
+): boolean {
+  if (cat.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+  if (hidden === 'flagged') {
+    return !(cat.hidden === 1 || cat.group_hidden === 1);
+  }
+  if (hidden === 'visible') {
+    return cat.hidden === 0 && cat.group_hidden === 0;
+  }
+  return true;
+}
+
+// Past spending is negative for expense categories, so flip it into a
+// positive amount to budget.
+function averageToBudgetAmount(avg: number, isIncome: 1 | 0): number {
+  return isIncome === 0 ? avg * -1 : avg;
+}
+
+async function getAverageFillCategories(): Promise<
+  db.DbViewCategoryWithGroupHidden[]
+> {
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden>(
+    `
+  SELECT c.*, g.hidden AS group_hidden
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0
+  `,
+  );
+  return categories.filter(cat => shouldFillCategory(cat, 'visible'));
+}
