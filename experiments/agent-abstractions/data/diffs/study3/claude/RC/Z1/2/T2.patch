+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden>(
+    `
+  SELECT c.*, c.goal_def, g.hidden AS group_hidden
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+  `,
+  );
+  const sheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (
+        !shouldFillCategory(cat, {
+          hiddenPolicy: 'require-visible',
+          isTrackingBudget: isTrackingBudget(),
+        })
+      ) {
+        continue;
+      }
+
+      const spent = await getSheetValue(sheetName, 'sum-amount-' + cat.id);
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudgetAmount(cat, spent),
+      });
+    }
+  });
+}
