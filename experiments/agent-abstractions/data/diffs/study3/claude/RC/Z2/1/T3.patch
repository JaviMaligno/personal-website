+// The amount a schedule is expected to come to: ranges and approximate
+// amounts are taken at their end furthest from zero (the worst case for
+// planning); exact and missing amounts are unchanged.
+export function getExpectedAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getRangedAmount(amount);
+  if (op === 'isapprox') {
+    const threshold = getApproxNumberThreshold(amount);
+    return amount < 0 ? amount - threshold : amount + threshold;
+  }
+  return amount;
+}
