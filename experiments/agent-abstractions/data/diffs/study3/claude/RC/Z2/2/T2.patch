@@ -0,0 +1,22 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function make(amount: unknown): ScheduleEntity {
+  return { id: 's', _amount: amount, _amountOp: 'is' } as ScheduleEntity;
+}
+
+describe('scheduleModel.toExternal expectedAmount', () => {
+  it('uses single amounts as-is', () => {
+    expect(scheduleModel.toExternal(make(-500)).expectedAmount).toBe(-500);
+  });
+  it('uses the end of a range furthest from zero', () => {
+    expect(
+      scheduleModel.toExternal(make({ num1: -10100, num2: -20000 }))
+        .expectedAmount,
+    ).toBe(-20000);
+  });
+  it('is 0 without an amount', () => {
+    expect(scheduleModel.toExternal(make(undefined)).expectedAmount).toBe(0);
+  });
+});
