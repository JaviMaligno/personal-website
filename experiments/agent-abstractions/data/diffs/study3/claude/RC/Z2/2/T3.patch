+// The single amount a schedule is expected to come to for planning: ranged
+// and approximate amounts resolve to the end furthest from zero (the worst
+// case); "is" amounts are used as-is and a missing amount is 0.
+export function getExpectedAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getRangeExpectedAmount(amount);
+  if (op === 'isapprox') {
+    return amount + Math.sign(amount) * getApproxNumberThreshold(amount);
+  }
+  return amount;
+}
