+// An amount is expected at its worst case for planning: the end of a range,
+// or of an "approximately" tolerance, furthest from zero.
+export function getExpectedScheduleAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getRangedScheduleAmount(amount);
+  if (op === 'isapprox') {
+    const threshold = getApproxNumberThreshold(amount);
+    return amount < 0 ? amount - threshold : amount + threshold;
+  }
+  return amount;
+}
