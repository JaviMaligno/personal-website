diff --git a/packages/loot-core/src/shared/schedules-worst-case.test.ts b/packages/loot-core/src/shared/schedules-worst-case.test.ts
new file mode 100644
index 0000000..d90b7e8
--- /dev/null
+++ b/packages/loot-core/src/shared/schedules-worst-case.test.ts
@@ -0,0 +1,17 @@
+import { getScheduledAmount } from './schedules';
+
+describe('getScheduledAmount with ranged amounts', () => {
+  it('uses the end furthest from zero for bills in either order', () => {
+    expect(getScheduledAmount({ num1: -10100, num2: -20000 })).toBe(-20000);
+    expect(getScheduledAmount({ num1: -20000, num2: -10100 })).toBe(-20000);
+  });
+
+  it('uses the largest value for income', () => {
+    expect(getScheduledAmount({ num1: 10100, num2: 20000 })).toBe(20000);
+  });
+
+  it('leaves single amounts and missing amounts alone', () => {
+    expect(getScheduledAmount(-500)).toBe(-500);
+    expect(getScheduledAmount(null as unknown as number)).toBe(0);
+  });
+});
