+
+describe('getScheduledAmount with approximate amounts', () => {
+  it('uses the end of the tolerance furthest from zero', () => {
+    expect(getScheduledAmount(-10000, false, 'isapprox')).toBe(-10750);
+    expect(getScheduledAmount(10000, false, 'isapprox')).toBe(10750);
+    expect(getScheduledAmount(-1234, false, 'isapprox')).toBe(-1327);
