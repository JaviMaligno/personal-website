+// the end closest to zero.
 export function getExpectedScheduleAmount(
   amount: number | { num1: number; num2: number },
   op?: string | null,
 ): number {
   if (typeof amount === 'number') {
     if (op === 'isapprox') {
-      return amount + Math.sign(amount) * getApproxNumberThreshold(amount);
+      return amount - getApproxNumberThreshold(amount);
     }
     return amount;
   }
-  return Math.abs(amount.num1) >= Math.abs(amount.num2)
-    ? amount.num1
-    : amount.num2;
+  return Math.min(amount.num1, amount.num2);
 }
 
