+// The single amount a schedule is expected to come to, for planning: the end
+// of its range or approximation tolerance furthest from zero (the worst case).
+export function getExpectedScheduleAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getRangeScheduleAmount(amount);
+  if (op === 'isapprox') {
+    const threshold = getApproxNumberThreshold(amount);
+    return amount < 0 ? amount - threshold : amount + threshold;
+  }
+  return amount;
+}
