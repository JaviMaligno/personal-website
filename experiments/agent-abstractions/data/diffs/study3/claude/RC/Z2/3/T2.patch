+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function toExternal(amount: ScheduleEntity['_amount'], amountOp: string) {
+  return scheduleModel.toExternal({
+    id: 's1',
+    _amount: amount,
+    _amountOp: amountOp,
+  } as ScheduleEntity);
+}
+
+describe('scheduleModel.toExternal expectedAmount', () => {
+  it('uses the end of a range furthest from zero', () => {
+    expect(
+      toExternal({ num1: -10100, num2: -20000 }, 'isbetween').expectedAmount,
+    ).toBe(-20000);
+  });
+
+  it('uses a single amount as is', () => {
+    expect(toExternal(-1234, 'is').expectedAmount).toBe(-1234);
+  });
+
+  it('is 0 without an amount', () => {
+    expect(
+      toExternal(undefined as unknown as number, 'is').expectedAmount,
+    ).toBe(0);
+  });
+});
