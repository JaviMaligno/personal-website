+describe('simplefin-accounts-link', () => {
+  const linkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    balance: 0,
+    orgId: 'org',
+  };
+
+  it('refuses to link a closed account and changes nothing', async () => {
+    await db.insertAccount({ id: 'closed1', name: 'Old', closed: 1 });
+
+    await expect(
+      linkHandler({ upgradingId: 'closed1', externalAccount } as never),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    const row = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['closed1'],
+    );
+    expect(row.account_id).toBeNull();
+    expect(row.closed).toBe(1);
+  });
+
+  it('refuses to re-link a closed account that already holds the link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'closed2', name: 'Old', accountId: 'ext-1' },
+    ]);
+    await db.updateAccount({ id: 'closed2', closed: 1 });
+
+    await expect(
+      linkHandler({ upgradingId: 'closed2', externalAccount } as never),
+    ).rejects.toThrow('Closed accounts cannot be linked');
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
