+async function getAccountToUpgrade(upgradingId: string) {
+  const accRow = await db.first<db.DbAccount>(
+    'SELECT * FROM accounts WHERE id = ?',
+    [upgradingId],
+  );
+  if (!accRow) {
+    throw new Error(`Account with ID ${upgradingId} not found.`);
+  }
+  return accRow;
+}
+
+async function assertBankAccountNotLinked(
+  provider: string,
+  providerAccountId: string,
+  upgradingId?: string,
+) {
+  const existing = await db.first<Pick<db.DbAccount, 'id'>>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+       AND id IS NOT ?`,
+    [provider, providerAccountId, upgradingId ?? null],
+  );
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
+
+async function saveLinkedAccount({
+  upgradingId,
+  provider,
+  providerAccountId,
+  bankId,
+  offBudget,
+  newAccountFields,
+}: {
+  upgradingId?: string;
+  provider: string;
+  providerAccountId: string;
+  bankId: string;
+  offBudget: boolean;
+  newAccountFields: Record<string, string | null | undefined>;
+}) {
+  if (upgradingId) {
+    const accRow = await getAccountToUpgrade(upgradingId);
+    await db.update('accounts', {
+      id: accRow.id,
+      account_id: providerAccountId,
+      bank: bankId,
+      account_sync_source: provider,
+    });
+    return accRow.id;
+  }
+
+  const id = uuidv4();
+  await db.insertWithUUID('accounts', {
+    id,
+    account_id: providerAccountId,
+    ...newAccountFields,
+    bank: bankId,
+    offbudget: offBudget ? 1 : 0,
+    account_sync_source: provider,
+  });
+  await db.insertPayee({
+    name: '',
+    transfer_acct: id,
+  });
+  return id;
+}
