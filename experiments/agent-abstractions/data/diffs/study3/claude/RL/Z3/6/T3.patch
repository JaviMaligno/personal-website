+describe('linking a closed account', () => {
+  it('is refused for both a new link and a re-link, leaving the account unchanged', async () => {
+    insertBank({ id: 'bank1', bank_id: 'sfin-bank', name: 'SimpleFin' });
+    await db.insertAccount({
+      id: 'closed1',
+      name: 'Old',
+      closed: 1,
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    const link = app.handlers['simplefin-accounts-link'];
+
+    for (const accountId of ['ext-1', 'ext-2']) {
+      await expect(
+        runHandler(link, {
+          externalAccount: { account_id: accountId, name: 'X', orgId: 'o' },
+          upgradingId: 'closed1',
+        }),
+      ).rejects.toThrow(
+        'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+      );
+    }
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    const row = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['closed1'],
+    );
+    expect(row.account_id).toBe('ext-1');
+  });
+});
