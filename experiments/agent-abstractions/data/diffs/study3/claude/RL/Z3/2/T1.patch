+// Refuses to link a bank account that another (non-deleted) local account
+// already holds through the same provider. Re-linking into the account that
+// already holds it is allowed.
+function refuseIfAlreadyLinked<
+  P extends { upgradingId?: AccountEntity['id'] },
+  R,
+>(
+  syncSource: NonNullable<AccountEntity['account_sync_source']>,
+  getProviderAccountId: (params: P) => string,
+  handler: (params: P) => Promise<R>,
+) {
+  return async (params: P) => {
+    const existing = await db.first<{ id: string }>(
+      'SELECT id FROM accounts WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ? AND id IS NOT ?',
+      [syncSource, getProviderAccountId(params), params.upgradingId ?? null],
+    );
+    if (existing) {
+      throw new Error(
+        'This bank account is already linked to another account.',
+      );
+    }
+    return handler(params);
+  };
+}
