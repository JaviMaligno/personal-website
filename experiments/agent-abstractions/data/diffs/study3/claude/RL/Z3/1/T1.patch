+async function assertBankAccountNotLinked(
+  provider: string,
+  providerAccountId: string,
+  upgradingId?: string,
+) {
+  const holder = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+       AND id IS NOT ?`,
+    [provider, providerAccountId, upgradingId ?? null],
+  );
+  if (holder) {
+    throw new Error('This bank account is already linked to another account.');
+  }
