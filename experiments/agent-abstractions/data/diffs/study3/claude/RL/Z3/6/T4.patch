+describe('replaceExistingLink', () => {
+  const externalAccount = { account_id: 'ext-1', name: 'X', orgId: 'o' };
+
+  beforeEach(async () => {
+    insertBank({ id: 'bank1', bank_id: 'sfin-bank', name: 'SimpleFin' });
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+
+  it('is refused without the flag', async () => {
+    await expect(
+      runHandler(app.handlers['simplefin-accounts-link'], { externalAccount }),
+    ).rejects.toThrow('already linked');
+  });
+
+  it('unlinks the previous holder when set', async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+    await runHandler(app.handlers['simplefin-accounts-link'], {
+      externalAccount,
+      replaceExistingLink: true,
+    });
+    const holder = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['holder'],
+    );
+    expect(holder.bank).toBeNull();
+    expect(holder.account_id).toBeNull();
+    expect(holder.account_sync_source).toBeNull();
+    expect(holder.tombstone).toBe(0);
+  });
+});
