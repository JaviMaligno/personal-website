@@ -643,3 +643,34 @@ describe('schedules', () => {
     });
   });
 });
+
+describe('getNextDate with daily schedules skipping weekends', () => {
+  function daily(solve: 'before' | 'after') {
+    return {
+      op: 'isapprox',
+      value: {
+        start: '2020-12-05', // Saturday
+        frequency: 'daily',
+        patterns: [],
+        skipWeekend: true,
+        weekendSolveMode: solve,
+        endMode: 'never',
+      },
+    };
+  }
+
+  it.each(['before', 'after'] as const)(
+    'skips weekend days when solving %s',
+    solve => {
+      expect(getNextDate(daily(solve), new Date(2020, 11, 5))).toBe(
+        '2020-12-07',
+      );
+      expect(getNextDate(daily(solve), new Date(2020, 11, 8))).toBe(
+        '2020-12-08',
+      );
+      expect(getNextDate(daily(solve), new Date(2020, 11, 12))).toBe(
+        '2020-12-14',
+      );
+    },
+  );
+});
