+++ b/packages/loot-core/src/shared/schedules.test.ts
@@ -687,4 +687,19 @@ describe('holidays', () => {
       getDateWithSkippedWeekend(new Date(2024, 5, 7), 'before', ['2024-06-07']),
     ).toEqual(new Date(2024, 5, 6));
   });
+
+  it('treats MM-DD entries as holidays every year', async () => {
+    const { getDateWithSkippedWeekend } = await import('./schedules');
+    for (const year of [2024, 2025]) {
+      // Fri 06-07-2024 / Sat 06-07-2025 style: use a weekday holiday each year
+      const date = new Date(year, 11, 25);
+      const result = getDateWithSkippedWeekend(date, 'after', ['12-25']);
+      expect(result.getTime()).toBeGreaterThan(date.getTime());
+    }
+    // full dates still apply to one year only
+    const date = new Date(2025, 11, 25);
+    expect(getDateWithSkippedWeekend(date, 'after', ['2024-12-25'])).toEqual(
+      date,
+    );
+  });
 });
