diff --git a/packages/loot-core/src/shared/schedules.test.ts b/packages/loot-core/src/shared/schedules.test.ts
index 5bd000a..56fef9c 100644
--- a/packages/loot-core/src/shared/schedules.test.ts
+++ b/packages/loot-core/src/shared/schedules.test.ts
@@ -643,3 +643,37 @@ describe('schedules', () => {
     });
   });
 });
+
+describe('daily schedules with weekend handling', () => {
+  function daily(weekendSolveMode: 'before' | 'after') {
+    return {
+      op: 'isapprox',
+      value: {
+        start: '2020-12-05', // Saturday
+        frequency: 'daily',
+        patterns: [],
+        skipWeekend: true,
+        weekendSolveMode,
+        endMode: 'never',
+      },
+    };
+  }
+
+  it.each(['before', 'after'] as const)(
+    'skips weekend days instead of moving them (%s)',
+    mode => {
+      expect(getNextDate(daily(mode), new Date(2020, 11, 1))).toBe(
+        '2020-12-07',
+      );
+      expect(getNextDate(daily(mode), new Date(2020, 11, 5))).toBe(
+        '2020-12-07',
+      );
+      expect(getNextDate(daily(mode), new Date(2020, 11, 8))).toBe(
+        '2020-12-08',
+      );
+      expect(getNextDate(daily(mode), new Date(2020, 11, 12))).toBe(
+        '2020-12-14',
+      );
+    },
+  );
+});
