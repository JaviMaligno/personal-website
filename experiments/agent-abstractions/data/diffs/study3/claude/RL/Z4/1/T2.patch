+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: Parameters<typeof recurConfigToRSchedule>[0];
+  start: string;
+  end: string;
+}) {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const isDaily = config.frequency === 'daily';
+
+    // Weekend adjustment moves an occurrence by at most 2 days, so scan a
+    // slightly wider window and filter on the final day.
+    const scanStart = d.subDays(d.startOfDay(parseDate(start)), 3);
+    const scanEnd = d.addDays(d.endOfDay(parseDate(end)), 3);
+
+    const days = new Set<string>();
+    for (const occurrence of schedule.occurrences({
+      start: scanStart,
+      end: scanEnd,
+    })) {
+      let date = occurrence.date;
+      if (config.skipWeekend) {
+        if (isDaily) {
+          if (d.isWeekend(date)) continue;
+        } else {
+          date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        }
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) days.add(day);
+    }
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
