   try {
     const schedule = new RSchedule({ rrules: rules });
 
+    if (config.skipWeekend && config.frequency === 'daily') {
+      // Daily schedules skip weekend occurrences instead of moving them
+      const dates: string[] = [];
+      let examined = 0;
+      for (const occurrence of schedule.occurrences({
+        start: d.startOfDay(new Date()),
+      })) {
+        if (dates.length >= count || examined++ >= count * 7 + 14) break;
+        if (!d.isWeekend(occurrence.date)) {
+          dates.push(dayFromDate(occurrence.date));
+        }
+      }
+      return dates;
+    }
+
     return schedule
       .occurrences({ start: d.startOfDay(new Date()), take: count })
       .toArray()
