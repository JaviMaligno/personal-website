+describe('getNextDate daily weekend skipping', () => {
+  const daily = (weekendSolveMode: 'before' | 'after') => ({
+    op: 'isapprox',
+    value: {
+      start: '2024-01-05',
+      frequency: 'daily',
+      patterns: [],
+      skipWeekend: true,
+      weekendSolveMode,
+      endMode: 'never',
+    },
+  });
+
+  it.each(['before', 'after'] as const)(
+    'skips weekend days instead of moving them (%s)',
+    mode => {
+      expect(getNextDate(daily(mode), new Date(2024, 0, 6))).toBe('2024-01-08');
