diff --git a/packages/loot-core/src/shared/schedules-holidays.test.ts b/packages/loot-core/src/shared/schedules-holidays.test.ts
new file mode 100644
index 0000000..ec27680
--- /dev/null
+++ b/packages/loot-core/src/shared/schedules-holidays.test.ts
@@ -0,0 +1,43 @@
+import { getDateWithSkippedWeekend, getNextDate } from './schedules';
+
+describe('holidays', () => {
+  it('moves a Saturday past a holiday Monday', () => {
+    const sat = new Date(2024, 0, 6);
+    const res = getDateWithSkippedWeekend(sat, 'after', ['2024-01-08']);
+    expect(res).toEqual(new Date(2024, 0, 9));
+  });
+
+  it('moves a holiday earlier when solving before', () => {
+    const wed = new Date(2024, 0, 10);
+    const res = getDateWithSkippedWeekend(wed, 'before', [
+      '2024-01-10',
+      '2024-01-09',
+    ]);
+    expect(res).toEqual(new Date(2024, 0, 8));
+  });
+
+  it('ignores holidays for weekdays', () => {
+    const wed = new Date(2024, 0, 10);
+    expect(getDateWithSkippedWeekend(wed, 'after', ['2024-01-11'])).toBe(wed);
+  });
+
+  it('skips holidays on daily schedules', () => {
+    const next = getNextDate(
+      {
+        op: 'is',
+        field: 'date',
+        value: {
+          start: '2024-01-01',
+          frequency: 'daily',
+          patterns: [],
+          skipWeekend: true,
+          weekendSolveMode: 'after',
+          endMode: 'never',
+          holidays: ['2024-01-09'],
+        },
+      },
+      new Date(2024, 0, 9),
+    );
+    expect(next).toBe('2024-01-10');
+  });
+});
