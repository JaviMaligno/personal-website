+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  if (start > end) return [];
+
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+  // Weekend handling moves an occurrence by at most two days, so look a bit
+  // beyond the period and decide membership by the adjusted day
+  const margin = 3;
+  const days = new Set<string>();
+  for (const occurrence of schedule.occurrences({
+    start: d.subDays(d.startOfDay(parseDate(start)), margin),
+    end: d.addDays(d.endOfDay(parseDate(end)), margin),
+  })) {
+    let date = occurrence.date;
+    if (config.skipWeekend) {
+      if (config.frequency === 'daily') {
+        if (d.isWeekend(date)) continue;
+      } else {
+        date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      }
+    }
+    const day = dayFromDate(date);
+    if (day >= start && day <= end) days.add(day);
+  }
+  return [...days].sort();
+}
