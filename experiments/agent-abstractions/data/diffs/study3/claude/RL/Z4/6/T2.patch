+describe('schedule/get-dates-in-range', () => {
+  const run = (config, start, end) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  it('moves weekend occurrences and decides by the final day', async () => {
+    // 2024-06-15 is a Saturday, 2024-06-16 a Sunday
+    const config = {
+      start: '2024-06-15',
+      frequency: 'monthly',
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    } as const;
+    expect(await run(config, '2024-06-17', '2024-06-17')).toEqual([
+      '2024-06-17',
+    ]);
+    expect(await run(config, '2024-06-15', '2024-06-16')).toEqual([]);
+    expect(
+      await run(
+        { ...config, weekendSolveMode: 'before' },
+        '2024-06-14',
+        '2024-06-14',
+      ),
+    ).toEqual(['2024-06-14']);
+  });
+
+  it('skips weekends for daily schedules and returns unique sorted days', async () => {
+    const config = {
+      start: '2024-06-13',
+      frequency: 'daily',
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    } as const;
+    expect(await run(config, '2024-06-13', '2024-06-18')).toEqual([
+      '2024-06-13',
+      '2024-06-14',
+      '2024-06-17',
+      '2024-06-18',
+    ]);
+  });
+});
