+describe('getDatesInRange', () => {
+  const weekly = {
+    start: '2024-01-05',
+    frequency: 'weekly',
+    interval: 1,
+    patterns: [],
+    skipWeekend: false,
+    weekendSolveMode: 'after',
+    endMode: 'never',
+  };
+
+  it('includes both ends of the period', async () => {
+    expect(
+      await getDatesInRange({
+        config: weekly,
+        start: '2024-01-05',
+        end: '2024-01-19',
+      }),
+    ).toEqual(['2024-01-05', '2024-01-12', '2024-01-19']);
+  });
+
+  it('judges membership by the weekend-adjusted day', async () => {
+    const config = {
+      ...weekly,
+      start: '2024-01-06', // Saturday
+      skipWeekend: true,
+    };
+    // Saturday 6th moves to Monday 8th
+    expect(
+      await getDatesInRange({ config, start: '2024-01-08', end: '2024-01-09' }),
+    ).toEqual(['2024-01-08']);
+    expect(
+      await getDatesInRange({ config, start: '2024-01-01', end: '2024-01-07' }),
+    ).toEqual([]);
+    // Moving before: Saturday 13th moves to Friday 12th
+    expect(
+      await getDatesInRange({
+        config: { ...config, weekendSolveMode: 'before' },
+        start: '2024-01-12',
+        end: '2024-01-12',
+      }),
+    ).toEqual(['2024-01-12']);
+  });
+
+  it('skips weekend occurrences of daily schedules', async () => {
+    expect(
+      await getDatesInRange({
+        config: { ...weekly, frequency: 'daily', skipWeekend: true },
+        start: '2024-01-05',
+        end: '2024-01-09',
+      }),
+    ).toEqual(['2024-01-05', '2024-01-08', '2024-01-09']);
+  });
+});
