+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // Weekend adjustment moves an occurrence by at most 2 days, so look a
+    // little beyond the period and decide membership by the final day.
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.endOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray();
+
+    const skipsWeekendDays = config.skipWeekend && config.frequency === 'daily';
+    const days = new Set<string>();
+    for (const o of occurrences) {
+      let date = o.date;
+      if (skipsWeekendDays) {
+        if (d.isWeekend(date)) continue;
+      } else if (config.skipWeekend) {
+        date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) days.add(day);
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
