+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const skipsWeekends = config.skipWeekend && config.frequency === 'daily';
+
+    // Weekend adjustment moves an occurrence by at most two days, so look
+    // slightly beyond the period and decide on the adjusted day.
+    const occurrences = schedule.occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), 2)),
+      end: d.endOfDay(d.addDays(parseDate(end), 2)),
+    });
+
+    const days = new Set<string>();
+    for (const occurrence of occurrences) {
+      let date = occurrence.date;
+      if (config.skipWeekend) {
+        if (skipsWeekends) {
+          if (d.isWeekend(date)) continue;
+        } else {
+          date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        }
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) days.add(day);
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
