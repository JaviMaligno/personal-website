+  it('treats MM-DD holidays as recurring every year', () => {
+    const holidays = ['01-08', '2024-01-09'];
+    expect(
+      getDateWithSkippedWeekend(new Date(2024, 0, 6), 'after', holidays),
+    ).toEqual(new Date(2024, 0, 10));
+    // 2025-01-08 is a Wednesday, a holiday every year
+    expect(
+      getDateWithSkippedWeekend(new Date(2025, 0, 8), 'after', holidays),
+    ).toEqual(new Date(2025, 0, 9));
+    // full dates remain one-off: 2025-01-09 is not a holiday
+    expect(
+      getDateWithSkippedWeekend(new Date(2025, 0, 9), 'after', holidays),
+    ).toEqual(new Date(2025, 0, 9));
+  });
