+    return {
+      op: 'isapprox',
+      value: {
+        start: '2020-12-05',
+        frequency: 'daily',
+        patterns: [],
+        skipWeekend: true,
+        weekendSolveMode: mode,
+        endMode: 'never',
+      },
+    };
+  }
+
+  it.each(['before', 'after'] as const)(
+    'skips weekend days when solving %s',
+    mode => {
+      // 2020-12-05 is a Saturday
+      expect(getNextDate(daily(mode), new Date(2020, 11, 5))).toBe(
+        '2020-12-07',
+      );
+      expect(getNextDate(daily(mode), new Date(2020, 11, 8))).toBe(
+        '2020-12-08',
+      );
