+// An interval that is a multiple of 7 can land on weekends forever, so
+// only look at a bounded number of occurrences.
+const MAX_WEEKDAY_SEARCH = 7;
+
+function firstWeekdayOccurrence(
+  schedule: { occurrences: (args: object) => Iterable<{ date: Date }> },
+  args: object = {},
+): Date | null {
+  let checked = 0;
+  for (const occurrence of schedule.occurrences(args)) {
+    if (!d.isWeekend(occurrence.date)) return occurrence.date;
+    if (++checked >= MAX_WEEKDAY_SEARCH) break;
+  }
+  return null;
+}
