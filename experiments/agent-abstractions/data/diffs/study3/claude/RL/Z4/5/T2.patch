+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  try {
+    const schedule = createRecurSchedule(config);
+    const isDaily = config.frequency === 'daily';
+
+    // Weekend adjustment moves an occurrence by at most 2 days, so look
+    // slightly outside the period and decide by the final day.
+    const from = d.subDays(d.startOfDay(parseDate(start)), 2);
+    const until = dayFromDate(d.addDays(parseDate(end), 2));
+
+    const dates = new Set<string>();
+    for (const occurrence of schedule.occurrences({ start: from })) {
+      if (dayFromDate(occurrence.date) > until) {
+        break;
+      }
+      let date = occurrence.date;
+      if (config.skipWeekend) {
+        if (isDaily) {
+          if (d.isWeekend(date)) continue;
+        } else {
+          date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        }
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        dates.add(day);
+      }
+    }
+    return [...dates].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
