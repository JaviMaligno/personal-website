+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config;
+  start: string;
+  end: string;
+}) {
+  try {
+    const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+    const moves = config.skipWeekend && config.frequency !== 'daily';
+    const skips = config.skipWeekend && config.frequency === 'daily';
+
+    // Weekend adjustment moves an occurrence by at most two days, so look a
+    // little beyond the period on both sides and filter on the final day.
+    const margin = moves ? 3 : 0;
+    const from = d.subDays(monthUtils.parseDate(start), margin);
+    const limit = d.addDays(monthUtils.parseDate(end), margin);
+
+    const days = new Set<string>();
+    for (const occurrence of schedule.occurrences({
+      start: d.startOfDay(from),
+    })) {
+      if (occurrence.date > limit) break;
+      let date = occurrence.date;
+      if (skips && d.isWeekend(date)) continue;
+      if (moves) {
+        date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) days.add(day);
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
