+  it('moves weekend occurrences by their final day', async () => {
+    // 2024-06-01 is a Saturday, 2024-06-02 Sunday
+    const config = {
+      start: '2024-06-01',
+      frequency: 'monthly',
+      patterns: [],
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+      endMode: 'never',
+    };
+    expect(await run(config, '2024-06-03', '2024-06-10')).toEqual([
+      '2024-06-03',
+    ]);
+    expect(await run(config, '2024-05-01', '2024-05-31')).toEqual([]);
+  });
+
+  it('skips weekend days for daily schedules', async () => {
+    const config = {
+      start: '2024-06-01',
+      frequency: 'daily',
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+      endMode: 'never',
+    };
+    expect(await run(config, '2024-06-01', '2024-06-04')).toEqual([
+      '2024-06-03',
+      '2024-06-04',
+    ]);
+  });
+});
