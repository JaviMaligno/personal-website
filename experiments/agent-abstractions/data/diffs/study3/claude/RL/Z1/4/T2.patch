+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const sheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await forEachBulkCategory(async cat => {
+    const activity = await getSheetValue(sheetName, 'sum-amount-' + cat.id);
+    const amount = cat.is_income === 1 ? activity : -activity;
+    void setBudget({ category: cat.id, month, amount: amount || 0 });
+  });
+}
+
+async function setBulkAvg(month: string, N: number): Promise<void> {
+  await forEachBulkCategory(cat =>
+    setNMonthAvg({ month, N, category: cat.id }),
+  );
+}
+
 export function set3MonthAvg({ month }: { month: string }): Promise<void> {
   return setBulkAvg(month, 3);
 }
