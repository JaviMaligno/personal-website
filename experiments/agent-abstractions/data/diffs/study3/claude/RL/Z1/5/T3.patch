+// Categories in groups whose notes carry the `#fixed` tag. Month-wide actions
+// leave these alone. Only the group's notes count, not the category's own.
+export async function getFixedGroupCategoryIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `SELECT c.id, n.note
+     FROM categories c
+     JOIN category_groups g ON c.cat_group = g.id
+     JOIN notes n ON n.id = g.id
+     WHERE c.tombstone = 0 AND n.note IS NOT NULL`,
+  );
+  return new Set(
+    rows
+      .filter(r => /(^|\s)#fixed(?![\w-])/i.test(r.note ?? ''))
+      .map(r => r.id),
+  );
+}
