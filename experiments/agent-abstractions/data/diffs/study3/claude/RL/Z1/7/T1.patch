+async function getCategoriesWithTemplates(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; goal_def: string | null }>(
+    'SELECT id, goal_def FROM categories WHERE tombstone = 0 AND goal_def IS NOT NULL',
+  );
+  const ids = new Set<string>();
+  for (const row of rows) {
+    try {
+      const defs = JSON.parse(row.goal_def ?? '');
+      if (Array.isArray(defs) && defs.length > 0) {
+        ids.add(row.id);
+      }
+    } catch {
+      // Unparseable definitions are not saved templates
+    }
+  }
+  return ids;
+}
+
+// Categories that month-wide actions may write to: not hidden, not in a
+// hidden group, not managed by saved budget templates, and (for income)
+// only in tracking budgets.
+async function getFillableCategories() {
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden>(
+    `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+  `,
+  );
+  const templated = await getCategoriesWithTemplates();
+  return categories.filter(
+    cat =>
+      !templated.has(cat.id) && (cat.is_income !== 1 || isTrackingBudget()),
+  );
+}
