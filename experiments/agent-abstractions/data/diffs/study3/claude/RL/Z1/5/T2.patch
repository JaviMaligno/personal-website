+// Visible categories that month-wide actions fill: income categories only
+// count in tracking budgets, and categories with saved templates are skipped.
+async function getMonthWideCategories(): Promise<
+  db.DbViewCategoryWithGroupHidden[]
+> {
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden>(
+    `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+  `,
+  );
+  const templated = await getCategoriesWithTemplates();
+  const isTracking = isTrackingBudget();
+  return categories.filter(
+    cat => !(cat.is_income === 1 && !isTracking) && !templated.has(cat.id),
+  );
+}
