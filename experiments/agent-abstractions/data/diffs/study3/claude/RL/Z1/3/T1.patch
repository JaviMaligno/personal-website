+function hasSavedTemplates(goalDef: string | null | undefined): boolean {
+  return goalDef != null && goalDef !== '' && goalDef.trim() !== '[]';
+}
+
+// Categories that month-wide actions may write to: visible, in a visible
+// group, without saved budget templates, and (outside tracking budgets) not
+// income.
+async function getBulkEditableCategories(): Promise<
+  (db.DbViewCategoryWithGroupHidden & { goal_def?: string | null })[]
+> {
+  const categories = await db.all<
+    db.DbViewCategoryWithGroupHidden & { goal_def?: string | null }
+  >(
+    `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+  `,
+  );
+  return categories.filter(
+    cat =>
+      !hasSavedTemplates(cat.goal_def) &&
+      (cat.is_income !== 1 || isTrackingBudget()),
+  );
+}
