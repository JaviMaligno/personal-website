+function hasSavedTemplates(goalDef: string | null | undefined): boolean {
+  if (!goalDef) {
+    return false;
+  }
+  try {
+    const templates = JSON.parse(goalDef);
+    return !Array.isArray(templates) || templates.length > 0;
+  } catch {
+    return true;
+  }
+}
+
+// Categories that month-wide actions may write to: not hidden, not in a
+// hidden group, and without saved budget templates. Income categories only
+// count for tracking budgets.
+async function getBudgetableCategories(): Promise<Array<db.DbCategory>> {
+  const categories = await db.all<db.DbCategory>(
+    `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+  `,
+  );
+  return categories.filter(
+    cat =>
+      !hasSavedTemplates(cat.goal_def) &&
+      (cat.is_income !== 1 || isTrackingBudget()),
+  );
+}
