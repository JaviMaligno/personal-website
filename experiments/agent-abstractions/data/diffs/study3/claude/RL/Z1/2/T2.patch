+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getBudgetableCategories();
+  const sheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const sum = await getSheetValue(sheetName, 'sum-amount-' + cat.id);
+      // `|| 0` avoids a negative zero for categories with no activity
+      const amount = (cat.is_income === 1 ? sum : -sum) || 0;
+      void setBudget({ category: cat.id, month, amount });
+    }
+  });
+}
