+// Categories in groups whose notes carry the #fixed tag. Only the group's
+// notes count, not the category's own.
+async function getCategoriesInFixedGroups(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string | null }>(
+    `SELECT c.id, n.note
+     FROM categories c
+     JOIN category_groups g ON c.cat_group = g.id
+     JOIN notes n ON n.id = g.id
+     WHERE c.tombstone = 0 AND n.note IS NOT NULL`,
+  );
+  const fixedTag = /(^|\s)#fixed(?![\w-])/i;
+  return new Set(
+    rows.filter(row => fixedTag.test(row.note ?? '')).map(row => row.id),
+  );
+}
