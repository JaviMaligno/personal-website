+// Categories with saved templates are managed by the templates, so
+// month-wide actions leave them alone.
+async function getCategoriesWithTemplates(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; goal_def: string | null }>(
+    'SELECT id, goal_def FROM categories WHERE tombstone = 0 AND goal_def IS NOT NULL',
+  );
+  const ids = new Set<string>();
+  for (const row of rows) {
+    try {
+      const defs = JSON.parse(row.goal_def ?? 'null');
+      if (Array.isArray(defs) ? defs.length > 0 : defs != null) {
+        ids.add(row.id);
+      }
+    } catch {
+      // Unparseable definition: treat as a saved template to be safe.
+      ids.add(row.id);
+    }
+  }
+  return ids;
+}
