   date: ScheduleEntity['_date']; // mandatory field in creating a schedule Mandatory field in creation
 };
 
+export type APIScheduleListEntity = APIScheduleEntity & {
+  expectedAmount: number; // Single amount the schedule is expected to post
+};
+
+function getExpectedAmount(amount: ScheduleEntity['_amount'] | null): number {
+  if (amount == null) {
+    return 0;
+  }
+  if (typeof amount === 'number') {
+    return amount;
+  }
+  // Ranged amount: the end furthest from zero
+  return Math.abs(amount.num1) >= Math.abs(amount.num2)
+    ? amount.num1
+    : amount.num2;
+}
+
 export const scheduleModel = {
