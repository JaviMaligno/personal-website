--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,37 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function toExternal(_amount: unknown) {
+  return scheduleModel.toExternal({
+    id: 's1',
+    _amount,
+    _amountOp: 'is',
+  } as unknown as ScheduleEntity);
+}
+
+describe('scheduleModel.toExternal expectedAmount', () => {
+  it('uses a single amount as is', () => {
+    expect(toExternal(-12300).expectedAmount).toBe(-12300);
+  });
+
+  it('uses the end of a range furthest from zero', () => {
+    expect(toExternal({ num1: -10100, num2: -20000 }).expectedAmount).toBe(
+      -20000,
+    );
+    expect(toExternal({ num1: -20000, num2: -10100 }).expectedAmount).toBe(
+      -20000,
+    );
+  });
+
+  it('is 0 without an amount', () => {
+    expect(toExternal(undefined).expectedAmount).toBe(0);
+  });
+
+  it('keeps the original amount', () => {
+    expect(toExternal({ num1: 1, num2: 2 }).amount).toEqual({
+      num1: 1,
+      num2: 2,
+    });
+  });
+});
