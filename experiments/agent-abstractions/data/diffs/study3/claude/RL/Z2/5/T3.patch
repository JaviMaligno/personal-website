+// The amount a schedule is planned at: a ranged amount at its end furthest
+// from zero, an approximate amount at the end of its tolerance furthest from
+// zero, and any other amount as is. A missing amount is 0.
+export function getPlannedAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getRangeAmount(amount);
+  if (op === 'isapprox') {
+    const threshold = getApproxNumberThreshold(amount);
+    return amount < 0 ? amount - threshold : amount + threshold;
+  }
+  return amount;
+}
