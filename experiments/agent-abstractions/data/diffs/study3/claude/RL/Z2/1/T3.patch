+// A ranged ("is between") amount is planned at the end furthest from zero; an
+// approximate amount at the end of its tolerance furthest from zero.
+export function getWorstCaseAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getRangeAmount(amount);
+  if (op === 'isapprox') {
+    return amount + Math.sign(amount) * getApproxNumberThreshold(amount);
+  }
+  return amount;
+}
