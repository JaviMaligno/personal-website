@@ -0,0 +1,48 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(
+  amount: ScheduleEntity['_amount'],
+  amountOp: ScheduleEntity['_amountOp'],
+): ScheduleEntity {
+  return {
+    id: 's1',
+    name: 'Rent',
+    rule: 'r1',
+    next_date: '2025-01-01',
+    completed: false,
+    posts_transaction: false,
+    tombstone: false,
+    _payee: 'p1',
+    _account: 'a1',
+    _amount: amount,
+    _amountOp: amountOp,
+    _date: '2025-01-01',
+    _conditions: [],
+    _actions: [],
+  } as ScheduleEntity;
+}
+
+describe('scheduleModel.toExternal expectedAmount', () => {
+  it('uses a single amount as is', () => {
+    const external = scheduleModel.toExternal(makeSchedule(-5000, 'is'));
+    expect(external.expectedAmount).toBe(-5000);
+    expect(external.amount).toBe(-5000);
+  });
+
+  it('uses the end of a range furthest from zero', () => {
+    const external = scheduleModel.toExternal(
+      makeSchedule({ num1: -10100, num2: -20000 }, 'isbetween'),
+    );
+    expect(external.expectedAmount).toBe(-20000);
+    expect(external.amount).toEqual({ num1: -10100, num2: -20000 });
+  });
+
+  it('is 0 when there is no amount', () => {
+    const external = scheduleModel.toExternal(
+      makeSchedule(undefined as unknown as number, 'is'),
+    );
+    expect(external.expectedAmount).toBe(0);
+  });
+});
