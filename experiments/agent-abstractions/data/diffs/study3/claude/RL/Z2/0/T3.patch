+// An approximate amount is planned for the worst case too: the end of its
+// tolerance furthest from zero.
+export function getApproxAmount(amount: number): number {
+  const tolerance = getApproxNumberThreshold(amount);
+  return amount < 0 ? amount - tolerance : amount + tolerance;
+}
+
+// Resolves the amount a schedule is expected at: ranges and approximate
+// amounts take their end furthest from zero, a missing amount is 0.
+export function getExpectedAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string | null,
+): number {
+  if (amount == null) return 0;
+  if (typeof amount !== 'number') return getRangedAmount(amount);
+  return op === 'isapprox' ? getApproxAmount(amount) : amount;
+}
