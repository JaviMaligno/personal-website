+async function getScheduleDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    const occurrences = schedule
+      .occurrences({
+        start: d.subDays(parseDate(start), WEEKEND_SHIFT_MAX_DAYS),
+        end: d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_MAX_DAYS)),
+      })
+      .toArray();
+
+    const days = new Set<string>();
+    for (const occurrence of occurrences) {
+      const date = applyWeekendRule(config, occurrence.date);
+      if (date == null) {
+        continue;
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
