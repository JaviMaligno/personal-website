+// Returns null when a daily schedule's occurrence falls on a weekend: those
+// occurrences are dropped rather than moved.
+export function applyWeekendRule(date: Date, rule: WeekendRule): Date | null {
+  if (!rule.skipWeekend || !d.isWeekend(date)) {
+    return date;
+  }
+  if (rule.frequency === 'daily') {
+    return null;
+  }
+  return getDateWithSkippedWeekend(date, rule.weekendSolveMode);
+}
