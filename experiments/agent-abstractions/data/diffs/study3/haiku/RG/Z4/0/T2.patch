+// Weekend solving moves an occurrence at most two days, so occurrences this far
+// outside the period can still land inside it.
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    const occurrences = schedule
+      .occurrences({
+        start: parseDate(subDays(start, WEEKEND_SHIFT_DAYS)),
+        end: parseDate(addDays(end, WEEKEND_SHIFT_DAYS)),
+      })
+      .toArray();
+
+    const days = new Set<string>();
+    for (const { date } of occurrences) {
+      const adjusted = applyWeekendRule(date, config);
+      if (adjusted) {
+        days.add(dayFromDate(adjusted));
+      }
+    }
+
+    return [...days].filter(day => day >= start && day <= end).sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
+
