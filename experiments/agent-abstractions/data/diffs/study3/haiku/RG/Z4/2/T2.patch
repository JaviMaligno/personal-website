+
+describe('schedule/get-dates-in-range', () => {
+  const getDatesInRange = (config, start: string, end: string) =>
+    schedulesApp.handlers['schedule/get-dates-in-range']({
+      config,
+      start,
+      end,
+    });
+
+  const monthlyOn15 = {
+    start: '2024-01-15',
+    frequency: 'monthly',
+    interval: 1,
+    patterns: [{ type: 'day', value: 15 }],
+    endMode: 'never',
+    skipWeekend: false,
+    weekendSolveMode: 'after',
+  };
+
+  it('lists the occurrences inside the period, both ends included', async () => {
+    expect(
+      await getDatesInRange(monthlyOn15, '2024-01-15', '2024-03-15'),
+    ).toEqual(['2024-01-15', '2024-02-15', '2024-03-15']);
+  });
+
+  it('returns nothing for a period without occurrences', async () => {
+    expect(
+      await getDatesInRange(monthlyOn15, '2024-01-16', '2024-02-14'),
+    ).toEqual([]);
+  });
+
+  it('does not list occurrences before the schedule starts', async () => {
+    expect(
+      await getDatesInRange(monthlyOn15, '2023-11-01', '2023-12-31'),
+    ).toEqual([]);
+  });
+
+  it('moves a Saturday occurrence to the Friday before', async () => {
+    const config = {
+      ...monthlyOn15,
+      skipWeekend: true,
+      weekendSolveMode: 'before',
+    };
+    expect(await getDatesInRange(config, '2024-06-01', '2024-06-30')).toEqual([
+      '2024-06-14',
+    ]);
+  });
+
+  it('moves a Saturday occurrence to the Monday after', async () => {
+    const config = {
+      ...monthlyOn15,
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await getDatesInRange(config, '2024-06-01', '2024-06-30')).toEqual([
+      '2024-06-17',
+    ]);
+  });
+
+  it('decides membership by the adjusted day, not the original one', async () => {
+    const before = {
+      ...monthlyOn15,
+      skipWeekend: true,
+      weekendSolveMode: 'before',
+    };
+    expect(await getDatesInRange(before, '2024-06-15', '2024-06-30')).toEqual(
+      [],
+    );
+
+    const after = {
+      ...monthlyOn15,
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await getDatesInRange(after, '2024-06-17', '2024-06-17')).toEqual([
+      '2024-06-17',
+    ]);
+    expect(await getDatesInRange(after, '2024-06-15', '2024-06-16')).toEqual(
+      [],
+    );
+  });
+
+  it('skips weekend occurrences of daily schedules', async () => {
+    const config = {
+      start: '2024-01-01',
+      frequency: 'daily',
+      interval: 1,
+      endMode: 'never',
+      skipWeekend: true,
+      weekendSolveMode: 'after',
+    };
+    expect(await getDatesInRange(config, '2024-01-05', '2024-01-10')).toEqual([
+      '2024-01-05',
+      '2024-01-08',
+      '2024-01-09',
+      '2024-01-10',
+    ]);
+  });
+
+  it('stops at the end date of the schedule', async () => {
+    const config = {
+      ...monthlyOn15,
+      endMode: 'on_date',
+      endDate: '2024-02-14',
+    };
+    expect(await getDatesInRange(config, '2024-01-01', '2024-03-31')).toEqual([
+      '2024-01-15',
+    ]);
+  });
+
+  it('lists each day once when patterns produce the same occurrence', async () => {
+    const config = {
+      ...monthlyOn15,
+      patterns: [
+        { type: 'day', value: 15 },
+        { type: 'day', value: 15 },
+      ],
+    };
+    expect(await getDatesInRange(config, '2024-01-01', '2024-02-29')).toEqual([
+      '2024-01-15',
+      '2024-02-15',
+    ]);
+  });
+});
