+type WeekendRule = {
+  skipWeekend?: boolean;
+  weekendSolveMode?: 'after' | 'before';
+  frequency?: string;
+};
+
+// Returns null when a daily occurrence falls on a weekend and must be skipped.
+export function getDateWithWeekendRule(
+  date: Date,
+  rule: WeekendRule,
+): Date | null {
+  if (!rule.skipWeekend || !d.isWeekend(date)) {
+    return date;
+  }
+  if (rule.frequency === 'daily') {
+    return null;
+  }
+  return getDateWithSkippedWeekend(date, rule.weekendSolveMode);
+}
