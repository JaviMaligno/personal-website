+// A weekend move shifts an occurrence by at most two days, so occurrences
+// just outside the period can land inside it.
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+
+  const days = new Set<string>();
+  schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS)),
+      end: d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS)),
+    })
+    .toArray()
+    .forEach(occurrence => {
+      const date = applyWeekendRule(config, occurrence.date);
+      if (date == null) {
+        return;
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    });
+
+  return [...days].sort();
+}
