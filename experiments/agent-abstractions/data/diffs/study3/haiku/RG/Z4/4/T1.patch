+type WeekendConfig = { skipWeekend?: boolean; frequency?: string };
+
+// Within any 7 consecutive occurrences of a daily schedule there is a weekday
+// unless every occurrence lands on the same weekday, so this window is enough.
+export const DAILY_WEEKEND_SCAN_LENGTH = 7;
+
+export function skipsWeekendDays(config: WeekendConfig): boolean {
+  return Boolean(config.skipWeekend) && config.frequency === 'daily';
+}
+
+export function isSkippedWeekendDay(
+  config: WeekendConfig,
+  date: Date,
+): boolean {
+  return skipsWeekendDays(config) && d.isWeekend(date);
+}
