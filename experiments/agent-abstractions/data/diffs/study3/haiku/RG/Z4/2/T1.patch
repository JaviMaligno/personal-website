+  describe('daily schedules with weekend skipping', () => {
+    /* Dec 2020 calendar for reference:
+      | Su | Mo | Tu | We | Th | Fr | Sa |
+      |    |    | 01 | 02 | 03 | 04 | 05 |
+      | 06 | 07 | 08 | 09 | 10 | 11 | 12 |
+      */
+    function daily(extra = {}) {
+      return {
+        op: 'isapprox',
+        value: {
+          start: '2020-12-04',
+          frequency: 'daily',
+          patterns: [],
+          skipWeekend: true,
+          ...extra,
+        },
+      };
+    }
+
+    it('skips weekend occurrences instead of moving them `after`', () => {
+      const dateCond = daily({ weekendSolveMode: 'after' });
+
+      expect(getNextDateAfter(dateCond, '2020-12-04')).toBe('2020-12-07');
+      expect(getNextDateAfter(dateCond, '2020-12-07')).toBe('2020-12-08');
+    });
+
+    it('skips weekend occurrences instead of moving them `before`', () => {
+      const dateCond = daily({ weekendSolveMode: 'before' });
+
+      expect(getNextDate(dateCond, new Date(2020, 11, 5))).toBe('2020-12-07');
+      expect(getNextDate(dateCond, new Date(2020, 11, 4))).toBe('2020-12-04');
+    });
+
+    it('never reports a date before the start of the schedule', () => {
+      const dateCond = daily({
+        start: '2020-12-05',
+        weekendSolveMode: 'before',
+      });
+
+      expect(getNextDate(dateCond, new Date(2020, 11, 5))).toBe('2020-12-07');
+    });
+
+    it('keeps weekend occurrences when weekend skipping is off', () => {
+      const dateCond = daily({ skipWeekend: false, weekendSolveMode: 'after' });
+
+      expect(getNextDateAfter(dateCond, '2020-12-04')).toBe('2020-12-05');
+    });
+
+    it('returns null when every occurrence falls on a weekend', () => {
+      const dateCond = daily({
+        start: '2020-12-05',
+        interval: 7,
+        weekendSolveMode: 'after',
+      });
+
+      expect(getNextDate(dateCond, new Date(2020, 11, 5))).toBeNull();
+    });
+  });
