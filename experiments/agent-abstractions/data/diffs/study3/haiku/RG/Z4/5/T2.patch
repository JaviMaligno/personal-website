+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    // Weekend handling moves an occurrence by at most two days, so widen the
+    // query window to catch occurrences that land inside the period.
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 2)),
+        end: d.endOfDay(d.addDays(parseDate(end), 2)),
+      })
+      .toArray();
+
+    const days = occurrences
+      .map(occurrence => getOccurrenceAfterWeekendRule(occurrence.date, config))
+      .filter(date => date !== null)
+      .map(date => dayFromDate(date))
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
