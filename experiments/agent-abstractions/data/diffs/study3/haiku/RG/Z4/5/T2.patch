+  describe('get-dates-in-range', () => {
+    const getDatesInRange = (config, start, end) =>
+      schedulesApp.handlers['schedule/get-dates-in-range']({
+        config,
+        start,
+        end,
+      });
+
+    const baseConfig = {
+      start: '2026-07-01',
+      frequency: 'monthly',
+      interval: 1,
+      patterns: [],
+      endMode: 'never',
+      skipWeekend: false,
+      weekendSolveMode: 'after',
+    };
+
+    it('lists monthly occurrences inside the period', async () => {
+      const config = { ...baseConfig, patterns: [{ type: 'day', value: 15 }] };
+
+      expect(await getDatesInRange(config, '2026-07-01', '2026-09-30')).toEqual(
+        ['2026-07-15', '2026-08-15', '2026-09-15'],
+      );
+    });
+
+    it('lists weekly occurrences with both bounds included', async () => {
+      const config = {
+        ...baseConfig,
+        start: '2026-10-01',
+        frequency: 'weekly',
+      };
+
+      expect(await getDatesInRange(config, '2026-10-01', '2026-10-29')).toEqual(
+        ['2026-10-01', '2026-10-08', '2026-10-15', '2026-10-22', '2026-10-29'],
+      );
+    });
+
+    it('returns an empty list when no occurrence falls in the period', async () => {
+      const config = { ...baseConfig, patterns: [{ type: 'day', value: 15 }] };
+
+      expect(await getDatesInRange(config, '2026-07-16', '2026-08-14')).toEqual(
+        [],
+      );
+    });
+
+    it('moves a weekend occurrence to the Friday before', async () => {
+      // 2026-08-01 is a Saturday
+      const config = {
+        ...baseConfig,
+        patterns: [{ type: 'day', value: 1 }],
+        skipWeekend: true,
+        weekendSolveMode: 'before',
+      };
+
+      expect(await getDatesInRange(config, '2026-07-31', '2026-07-31')).toEqual(
+        ['2026-07-31'],
+      );
+      expect(await getDatesInRange(config, '2026-08-01', '2026-08-31')).toEqual(
+        [],
+      );
+    });
+
+    it('moves a weekend occurrence to the Monday after', async () => {
+      // 2026-08-01 is a Saturday
+      const config = {
+        ...baseConfig,
+        patterns: [{ type: 'day', value: 1 }],
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      };
+
+      expect(await getDatesInRange(config, '2026-08-02', '2026-08-31')).toEqual(
+        ['2026-08-03'],
+      );
+      expect(await getDatesInRange(config, '2026-08-01', '2026-08-01')).toEqual(
+        [],
+      );
+    });
+
+    it('skips weekend occurrences of daily schedules', async () => {
+      const config = {
+        ...baseConfig,
+        start: '2026-10-01',
+        frequency: 'daily',
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      };
+
+      expect(await getDatesInRange(config, '2026-10-02', '2026-10-05')).toEqual(
+        ['2026-10-02', '2026-10-05'],
+      );
+    });
+  });
 });
