+// A weekend occurrence moves at most two days, so occurrences up to two days
+// outside the period may land inside it.
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const days = new Set<string>();
+
+    schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS)),
+        end: d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS)),
+      })
+      .toArray()
+      .forEach(occurrence => {
+        const date = getDateWithWeekendRule(occurrence.date, config);
+        if (!date) {
+          return;
+        }
+        const day = dayFromDate(date);
+        if (day >= start && day <= end) {
+          days.add(day);
+        }
+      });
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
