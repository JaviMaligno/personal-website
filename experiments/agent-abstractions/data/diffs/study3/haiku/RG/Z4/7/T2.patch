+// Weekend adjustment can move an occurrence up to two days, so raw occurrences
+// are read with that margin and filtered on the final day.
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS)),
+        end: d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS)),
+      })
+      .toArray();
+
+    const days = new Set(
+      occurrences
+        .map(occurrence => applyWeekendSkip(config, occurrence.date))
+        .filter(date => date != null)
+        .map(date => dayFromDate(date)),
+    );
+
+    return [...days].filter(day => day >= start && day <= end).sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
