+// A weekend occurrence moves at most two days (Sat -> Mon, Sun -> Fri), so
+// occurrences just outside the range can land inside it.
+const WEEKEND_SHIFT_DAYS = 2;
+
+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+
+  const days = new Set(
+    schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS)),
+        end: d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS)),
+      })
+      .toArray()
+      .map(occurrence =>
+        config.skipWeekend
+          ? getDateWithSkippedWeekend(occurrence.date, config.weekendSolveMode)
+          : occurrence.date,
+      )
+      .map(date => dayFromDate(date))
+      .filter(day => day >= start && day <= end),
+  );
+
+  return [...days].sort();
+}
