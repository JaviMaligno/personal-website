+// An approximate amount is expected at the end of its tolerance furthest from zero.
+export function expectedScheduleAmount(
+  op: string,
+  value: number | { num1: number; num2: number },
+): number {
+  if (typeof value !== 'number') {
+    return worstCaseAmount(value.num1, value.num2);
+  }
+  if (op !== 'isapprox') {
+    return value;
+  }
+  const tolerance = getApproxNumberThreshold(value);
+  return value < 0 ? value - tolerance : value + tolerance;
+}
