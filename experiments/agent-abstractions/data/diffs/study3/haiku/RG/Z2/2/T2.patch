diff --git a/packages/loot-core/src/server/api-models.test.ts b/packages/loot-core/src/server/api-models.test.ts
new file mode 100644
index 0000000..fff76a0
--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'vitest';
+
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(amount: ScheduleEntity['_amount']): ScheduleEntity {
+  return {
+    id: 'schedule-1',
+    name: 'Rent',
+    rule: 'rule-1',
+    next_date: '2026-01-01',
+    completed: false,
+    posts_transaction: true,
+    tombstone: false,
+    _payee: 'payee-1',
+    _account: 'account-1',
+    _amount: amount,
+    _amountOp: 'isbetween',
+    _date: '2026-01-01',
+    _conditions: [],
+    _actions: [],
+  } as unknown as ScheduleEntity;
+}
+
+describe('scheduleModel.toExternal expectedAmount', () => {
+  it('returns a single amount as itself', () => {
+    const result = scheduleModel.toExternal(makeSchedule(-5000));
+    expect(result.amount).toBe(-5000);
+    expect(result.expectedAmount).toBe(-5000);
+  });
+
+  it('returns the end of a range furthest from zero', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule({ num1: -10100, num2: -20000 }),
+    );
+    expect(result.amount).toEqual({ num1: -10100, num2: -20000 });
+    expect(result.expectedAmount).toBe(-20000);
+  });
+
+  it('returns 0 when there is no amount', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule(null as unknown as number),
+    );
+    expect(result.expectedAmount).toBe(0);
+  });
+});
