@@ -0,0 +1,56 @@
+import { describe, expect, it } from 'vitest';
+
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(
+  amount: ScheduleEntity['_amount'] | null,
+): ScheduleEntity {
+  return {
+    id: 'schedule-1',
+    name: 'Rent',
+    rule: 'rule-1',
+    next_date: '2026-11-01',
+    completed: false,
+    posts_transaction: true,
+    tombstone: false,
+    _payee: 'payee-1',
+    _account: 'account-1',
+    _amount: amount as ScheduleEntity['_amount'],
+    _amountOp: 'isbetween',
+    _date: '2026-11-01',
+    _conditions: [],
+    _actions: [],
+  };
+}
+
+describe('scheduleModel.toExternal', () => {
+  it('uses a single amount as the expected amount', () => {
+    expect(scheduleModel.toExternal(makeSchedule(-5000))).toMatchObject({
+      amount: -5000,
+      expectedAmount: -5000,
+    });
+  });
+
+  it('uses the end of a range furthest from zero', () => {
+    expect(
+      scheduleModel.toExternal(makeSchedule({ num1: -10100, num2: -20000 })),
+    ).toMatchObject({
+      amount: { num1: -10100, num2: -20000 },
+      expectedAmount: -20000,
+    });
+  });
+
+  it('picks the furthest end when it is the first bound', () => {
+    expect(
+      scheduleModel.toExternal(makeSchedule({ num1: 30000, num2: 2000 })),
+    ).toMatchObject({ expectedAmount: 30000 });
+  });
+
+  it('gives 0 when the schedule has no amount', () => {
+    expect(scheduleModel.toExternal(makeSchedule(null))).toMatchObject({
+      expectedAmount: 0,
+    });
+  });
+});
