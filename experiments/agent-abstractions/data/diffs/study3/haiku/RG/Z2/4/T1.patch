@@ -642,4 +643,37 @@ describe('schedules', () => {
       expect(isCustomUpcomingLength(undefined)).toBe(false);
     });
   });
+
+  describe('getScheduledAmount', () => {
+    it('returns a single amount unchanged', () => {
+      expect(getScheduledAmount(-5000)).toBe(-5000);
+      expect(getScheduledAmount(-5000, true)).toBe(5000);
+    });
+
+    it('returns 0 when there is no amount', () => {
+      expect(getScheduledAmount(null)).toBe(0);
+      expect(getScheduledAmount(undefined)).toBe(0);
+    });
+
+    it('uses the end of a range furthest from zero for expenses', () => {
+      expect(getScheduledAmount({ num1: -10100, num2: -20000 })).toBe(-20000);
+      expect(getScheduledAmount({ num1: -20000, num2: -10100 })).toBe(-20000);
+    });
+
+    it('uses the end of a range furthest from zero for income', () => {
+      expect(getScheduledAmount({ num1: 10100, num2: 20000 })).toBe(20000);
+      expect(getScheduledAmount({ num1: 20000, num2: 10100 })).toBe(20000);
+    });
+
+    it('uses the end furthest from zero when the range crosses zero', () => {
+      expect(getScheduledAmount({ num1: -3000, num2: 5000 })).toBe(5000);
+      expect(getScheduledAmount({ num1: 5000, num2: -3000 })).toBe(5000);
+    });
+
+    it('inverts the range end when requested', () => {
+      expect(getScheduledAmount({ num1: -10100, num2: -20000 }, true)).toBe(
+        20000,
+      );
+    });
+  });
 });
