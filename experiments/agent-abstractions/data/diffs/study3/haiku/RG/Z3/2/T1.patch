+
+describe('linking a bank account that is already linked', () => {
+  const simpleFinAccount = {
+    balance: 0,
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'SimpleFin',
+    orgDomain: 'sfin-bank',
+    orgId: 'sfin-bank',
+  };
+
+  function linkSimpleFin(params: { upgradingId?: string } = {}) {
+    return app.handlers['simplefin-accounts-link']({
+      externalAccount: simpleFinAccount,
+      ...params,
+    });
+  }
+
+  async function getAccounts() {
+    return await db.all<db.DbAccount>(
+      'SELECT id, name, account_id, account_sync_source, bank, tombstone, closed FROM accounts ORDER BY id',
+    );
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses to link a new account to a bank account already linked elsewhere', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'ext-1' },
+    ]);
+    const before = await getAccounts();
+
+    await expect(linkSimpleFin()).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await getAccounts()).toEqual(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another account and leaves that account unchanged', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'holder', name: 'Holder', accountId: 'ext-1' },
+      { id: 'target', name: 'Target', accountId: null },
+    ]);
+    const before = await getAccounts();
+
+    await expect(linkSimpleFin({ upgradingId: 'target' })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await getAccounts()).toEqual(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the holding account is closed', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'holder', name: 'Holder', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'holder', closed: 1 });
+
+    await expect(linkSimpleFin()).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the holding account is deleted', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'holder', name: 'Holder', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'holder', tombstone: 1 });
+
+    await expect(linkSimpleFin()).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'holder', name: 'Holder', accountId: 'ext-1' },
+    ]);
+
+    await expect(linkSimpleFin({ upgradingId: 'holder' })).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows the same provider account id under a different provider', async () => {
+    insertBank({ id: 'bank2', bank_id: 'gc-bank', name: 'GoCardless' });
+    await db.insertAccount({
+      id: 'gc',
+      name: 'GoCardless account',
+      bank: 'bank2',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(linkSimpleFin()).resolves.toBe('ok');
+  });
+});
