+
+describe('linking a Fintegra account', () => {
+  const alreadyLinkedMessage =
+    'This bank account is already linked to another account.';
+  const linkFintegra = app.handlers['fintegra-accounts-link'];
+
+  function fintegraAccount(account_id: string, orgId = 'org-1') {
+    return {
+      balance: 100,
+      account_id,
+      name: 'Checking',
+      institution: 'Bank',
+      orgId,
+    };
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a Fintegra-synced account named after the external account', async () => {
+    await linkFintegra({ externalAccount: fintegraAccount('fin-1') });
+
+    const row = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['fin-1'],
+    );
+    expect(row!.name).toBe('Checking');
+    expect(row!.official_name).toBe('Checking');
+    expect(row!.account_sync_source).toBe('fintegra');
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      expect.any(String),
+      'fin-1',
+      'org-1',
+      undefined,
+      undefined,
+    );
+  });
+
+  it('groups accounts from the same organisation under one bank', async () => {
+    await linkFintegra({ externalAccount: fintegraAccount('fin-1') });
+    await linkFintegra({ externalAccount: fintegraAccount('fin-2') });
+
+    const row = await db.first<{ count: number }>(
+      'SELECT COUNT(*) as count FROM banks WHERE bank_id = ? AND tombstone = 0',
+      ['org-1'],
+    );
+    expect(row!.count).toBe(1);
+  });
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Bank' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      bank: 'bank1',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      linkFintegra({ externalAccount: fintegraAccount('fin-1') }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
