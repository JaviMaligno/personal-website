+    const closedError =
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+    it('refuses to link into a closed account and leaves it untouched', async () => {
+      await db.insertAccount({ id: 'closed', name: 'Savings', closed: 1 });
+
+      await expect(
+        simpleFinLink({ externalAccount, upgradingId: 'closed' }),
+      ).rejects.toThrow(closedError);
+
+      const target = await db.first<db.DbAccount>(
+        'SELECT * FROM accounts WHERE id = ?',
+        ['closed'],
+      );
+      expect(target!.closed).toBe(1);
+      expect(target!.account_id).toBeNull();
+      expect(target!.account_sync_source).toBeNull();
+      expect(await countRows('banks')).toBe(0);
+      expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    });
+
+    it('refuses to re-link into a closed account that holds the link', async () => {
+      await db.insertAccount({
+        id: 'closed',
+        name: 'Checking',
+        account_id: 'ext-1',
+        account_sync_source: 'simpleFin',
+        closed: 1,
+      });
+
+      await expect(
+        simpleFinLink({ externalAccount, upgradingId: 'closed' }),
+      ).rejects.toThrow(closedError);
+      expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    });
+
+    it('allows linking once the account is reopened', async () => {
+      await db.insertAccount({ id: 'closed', name: 'Savings', closed: 1 });
+      await db.update('accounts', { id: 'closed', closed: 0 });
+
+      await expect(
+        simpleFinLink({ externalAccount, upgradingId: 'closed' }),
+      ).resolves.toBe('ok');
+      expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+    });
+  });
 });
 
