+describe('linking a bank account that is already linked', () => {
+  const linkSimpleFinAccount = app.handlers['simplefin-accounts-link'];
+  const linkPluggyAiAccount = app.handlers['pluggyai-accounts-link'];
+  const alreadyLinkedMessage =
+    'This bank account is already linked to another account.';
+
+  function simpleFinAccount(accountId: string) {
+    return {
+      account_id: accountId,
+      name: 'Checking',
+      balance: 0,
+      institution: 'Bank',
+      orgId: 'org-1',
+      orgDomain: 'bank.example',
+    };
+  }
+
+  async function countRows(table: 'accounts' | 'payees') {
+    const row = await db.first<{ count: number }>(
+      `SELECT count(*) as count FROM ${table}`,
+    );
+    return row!.count;
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses to link a bank account as a new account and changes nothing', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+
+    await expect(
+      linkSimpleFinAccount({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link a bank account into a different existing account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      { id: 'acct2', name: 'Savings', accountId: 'ext-2' },
+    ]);
+
+    await expect(
+      linkSimpleFinAccount({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'acct2',
+      }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    const acct2 = await db.first<{ account_id: string }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(acct2!.account_id).toBe('ext-2');
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the holding account is closed', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      linkSimpleFinAccount({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+  });
+
+  it('allows linking when the holding account is deleted', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      linkSimpleFinAccount({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      linkPluggyAiAccount({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      linkSimpleFinAccount({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'acct1',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
+
