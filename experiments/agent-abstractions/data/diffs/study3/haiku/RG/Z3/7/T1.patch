+describe('linking a bank account that is already linked', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    balance: 0,
+    institution: 'SimpleFin',
+    orgDomain: 'sfin.example',
+  };
+
+  beforeEach(async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+    } as never);
+    insertBank({ id: 'bank1', bank_id: 'sfin.example', name: 'SimpleFin' });
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+
+  it('refuses to link into a new account', async () => {
+    const banksBefore = db.runQuery('SELECT id FROM banks', [], true);
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const accounts = db.runQuery<{ id: string }>(
+      'SELECT id FROM accounts WHERE tombstone = 0',
+      [],
+      true,
+    );
+    expect(accounts.map(a => a.id)).toEqual(['holder']);
+    expect(db.runQuery('SELECT id FROM banks', [], true)).toEqual(banksBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another existing account and leaves it untouched', async () => {
+    await db.insertAccount({
+      id: 'other',
+      name: 'Other',
+      account_sync_source: null,
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'other' }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const other = await db.first<{
+      account_id: string | null;
+      bank: string | null;
+    }>('SELECT account_id, bank FROM accounts WHERE id = ?', ['other']);
+    expect(other).toEqual({ account_id: null, bank: null });
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link is on a closed account', async () => {
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['holder']);
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows re-linking into the account that already holds the link', async () => {
+    await simpleFinLinkHandler({
+      externalAccount,
+      upgradingId: 'holder',
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('allows linking when the existing link is on a deleted account', async () => {
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', ['holder']);
+
+    await simpleFinLinkHandler({ externalAccount });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await db.insertAccount({
+      id: 'gc',
+      name: 'GoCardless account',
+      account_sync_source: null,
+    });
+    const gcHandler = app.handlers['gocardless-accounts-link'];
+
+    await gcHandler({
+      requisitionId: 'req-1',
+      account: {
+        account_id: 'ext-1',
+        name: 'Checking',
+        institution: 'Bank',
+      },
+      upgradingId: 'gc',
+    } as never);
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
