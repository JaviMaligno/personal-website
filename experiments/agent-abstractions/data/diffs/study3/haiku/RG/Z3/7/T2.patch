+      transactions: {
+        all: [
+          {
+            booked: true,
+            date: '2017-10-02',
+            payeeName: 'Coffee Shop',
+            transactionAmount: { amount: '-12.34' },
+            transactionId: 'fin-tx-1',
+          },
+        ],
+        booked: [],
+        pending: [],
+      },
+      balances: [],
+      startingBalance: 10000,
+    });
+
+    const linkResult = await accountsApp.handlers['fintegra-accounts-link']({
+      externalAccount: {
+        account_id: 'fin-acct-1',
+        name: 'Fintegra Checking',
+        balance: 100,
+        institution: 'Fin Bank',
+        orgId: 'org-1',
+      },
+      startingDate: '2017-10-01',
+    });
+
+    expect(linkResult).toBe('ok');
+
+    const account = await db.first<{
+      id: string;
+      name: string;
+      official_name: string;
+      account_sync_source: string;
+      bank_name: string;
+      bank_id: string;
+    }>(
+      `SELECT a.id, a.name, a.official_name, a.account_sync_source,
+              b.name AS bank_name, b.bank_id
+       FROM accounts a JOIN banks b ON b.id = a.bank
+       WHERE a.account_id = ? AND a.tombstone = 0`,
+      ['fin-acct-1'],
+    );
+    expect(account).toMatchObject({
+      name: 'Fintegra Checking',
+      official_name: 'Fintegra Checking',
+      account_sync_source: 'fintegra',
+      bank_name: 'Fin Bank',
+      bank_id: 'org-1',
+    });
+
+    const transactions = db.runQuery<{ amount: number; imported_id: string }>(
+      'SELECT amount, imported_id FROM v_transactions_internal_alive WHERE account = ? ORDER BY amount DESC',
+      [account!.id],
+      true,
+    );
+    expect(transactions).toEqual([
+      expect.objectContaining({ amount: 11234 }),
+      expect.objectContaining({ amount: -1234, imported_id: 'fin-tx-1' }),
+    ]);
+  });
+});
