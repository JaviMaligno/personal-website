+
+describe('linking a bank account', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    balance: 100,
+    institution: 'SimpleFin',
+    orgDomain: 'sfin.example',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    } as never);
+  });
+
+  async function countAccounts() {
+    const row = await db.first<{ count: number }>(
+      'SELECT count(*) as count FROM accounts WHERE tombstone = 0',
+    );
+    return row!.count;
+  }
+
+  it('refuses a second local account for a linked bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    const before = await countAccounts();
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await countAccounts()).toBe(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses linking into another account and leaves that account unchanged', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'acct2' }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const acct2 = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(acct2!.account_id).toBeNull();
+    expect(acct2!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the holding account is closed', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', closed: 1 });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the holding account was deleted', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', tombstone: 1 });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'acct1' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    insertBank({ id: 'bank2', bank_id: 'gc-bank', name: 'GoCardless' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      bank: 'bank2',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+});
