+import * as asyncStorage from '#platform/server/asyncStorage';
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+import type { SyncServerSimpleFinAccount } from '#types/models';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+const pluggyAiLinkHandler = app.handlers['pluggyai-accounts-link'];
+
+const ALREADY_LINKED_ERROR =
+  'This bank account is already linked to another account.';
+
+const externalAccount: SyncServerSimpleFinAccount = {
+  account_id: 'ext-1',
+  name: 'Checking',
+  balance: 0,
+  institution: 'Bank',
+  orgDomain: 'bank.example',
+  orgId: 'org-1',
+};
+
+async function insertLinkedAccount({
+  id,
+  source = 'simpleFin',
+  accountId = 'ext-1',
+  closed = false,
+  tombstone = false,
+}: {
+  id: string;
+  source?: string;
+  accountId?: string;
+  closed?: boolean;
+  tombstone?: boolean;
+}) {
+  await db.insertAccount({
+    id,
+    name: id,
+    account_id: accountId,
+    account_sync_source: source,
+  });
+  await db.update('accounts', {
+    id,
+    closed: closed ? 1 : 0,
+    tombstone: tombstone ? 1 : 0,
+  });
+}
+
+async function countRows(table: 'accounts' | 'payees' | 'banks') {
+  const row = await db.first<{ count: number }>(
+    `SELECT count(*) as count FROM ${table} WHERE tombstone = 0`,
+  );
+  return row?.count ?? 0;
+}
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(asyncStorage.multiGet).mockResolvedValue({
+    'user-id': 'user-1',
+    'user-key': 'key-1',
+  });
+  vi.mocked(bankSync.syncAccount).mockResolvedValue({
+    added: [],
+    updated: [],
+    updatedPreview: [],
+  });
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+describe('linking a bank account that is already linked', () => {
+  it('refuses to create a second local account for the same bank account', async () => {
+    await insertLinkedAccount({ id: 'existing' });
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+    const banksBefore = await countRows('banks');
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      ALREADY_LINKED_ERROR,
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(await countRows('banks')).toBe(banksBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another existing account and leaves it unchanged', async () => {
+    await insertLinkedAccount({ id: 'holder' });
+    await insertLinkedAccount({ id: 'target', accountId: 'ext-other' });
+    const targetBefore = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['target'],
+    );
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'target' }),
+    ).rejects.toThrow(ALREADY_LINKED_ERROR);
+
+    const targetAfter = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['target'],
+    );
+    expect(targetAfter).toEqual(targetBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing holder is closed', async () => {
+    await insertLinkedAccount({ id: 'existing', closed: true });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      ALREADY_LINKED_ERROR,
+    );
+  });
+
+  it('allows linking when the holder is deleted', async () => {
+    await insertLinkedAccount({ id: 'deleted', tombstone: true });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await insertLinkedAccount({ id: 'existing', source: 'pluggyai' });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await insertLinkedAccount({ id: 'holder' });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'holder' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('applies the same rule to the other providers', async () => {
+    await insertLinkedAccount({ id: 'existing', source: 'pluggyai' });
+
+    await expect(pluggyAiLinkHandler({ externalAccount })).rejects.toThrow(
+      ALREADY_LINKED_ERROR,
+    );
+  });
+});
