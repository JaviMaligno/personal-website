+/**
+ * Throws if the bank account is already linked to a local account other than
+ * `upgradingId`. Closed accounts still hold their link; deleted ones do not.
+ */
+export async function assertBankAccountNotLinked(
+  provider: string,
+  providerAccountId: string,
+  upgradingId: string | undefined,
+) {
+  const linked = await db.first<Pick<db.DbAccount, 'id'>>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0 AND id IS NOT ?`,
+    [provider, providerAccountId, upgradingId ?? null],
+  );
+
+  if (linked) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
