+
+describe('linking a bank account', () => {
+  const externalAccount = {
+    account_id: 'ext-1',
+    balance: 0,
+    name: 'Checking',
+    institution: 'SimpleFin Bank',
+    orgDomain: 'bank.example',
+    orgId: 'org-1',
+  };
+  const simpleFinLink = app.handlers['simplefin-accounts-link'];
+  const alreadyLinkedError =
+    'This bank account is already linked to another account.';
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  async function countRows(table: 'accounts' | 'banks') {
+    const row = await db.first<{ count: number }>(
+      `SELECT COUNT(*) as count FROM ${table}`,
+    );
+    return row!.count;
+  }
+
+  it('refuses to link into a new account when the bank account is already linked', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(simpleFinLink({ externalAccount })).rejects.toThrow(
+      alreadyLinkedError,
+    );
+
+    expect(await countRows('accounts')).toBe(1);
+    expect(await countRows('banks')).toBe(0);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another existing account and leaves it untouched', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    await db.insertAccount({ id: 'target', name: 'Savings' });
+
+    await expect(
+      simpleFinLink({ externalAccount, upgradingId: 'target' }),
+    ).rejects.toThrow(alreadyLinkedError);
+
+    const target = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['target'],
+    );
+    expect(target!.account_id).toBeNull();
+    expect(target!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link belongs to a closed account', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+
+    await expect(simpleFinLink({ externalAccount })).rejects.toThrow(
+      alreadyLinkedError,
+    );
+  });
+
+  it('allows linking when the existing link belongs to a deleted account', async () => {
+    await db.insertAccount({
+      id: 'deleted',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      tombstone: 1,
+    });
+
+    await expect(simpleFinLink({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(simpleFinLink({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      simpleFinLink({ externalAccount, upgradingId: 'existing' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
