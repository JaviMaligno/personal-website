+
+describe('linking a Fintegra account', () => {
+  const externalAccount = {
+    account_id: 'fin-1',
+    balance: 0,
+    name: 'Everyday',
+    institution: 'Fintegra Bank',
+    orgId: 'fin-org-1',
+  };
+  const fintegraLink = app.handlers['fintegra-accounts-link'];
+  const alreadyLinkedError =
+    'This bank account is already linked to another account.';
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a bank-synced account named after the Fintegra account', async () => {
+    await expect(fintegraLink({ externalAccount })).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['fin-1'],
+    );
+    expect(account!.name).toBe('Everyday');
+    expect(account!.official_name).toBe('Everyday');
+    expect(account!.account_sync_source).toBe('fintegra');
+    expect(account!.offbudget).toBe(0);
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('groups accounts under one bank per organisation and institution', async () => {
+    await fintegraLink({ externalAccount });
+    await fintegraLink({
+      externalAccount: { ...externalAccount, account_id: 'fin-2' },
+    });
+    await fintegraLink({
+      externalAccount: {
+        ...externalAccount,
+        account_id: 'fin-3',
+        orgId: 'fin-org-2',
+      },
+    });
+
+    const banks = await db.all<db.DbBank>('SELECT * FROM banks');
+    expect(banks).toHaveLength(2);
+    const accounts = await db.all<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id IN (?, ?, ?)',
+      ['fin-1', 'fin-2', 'fin-3'],
+    );
+    const bankForFirstOrg = accounts.find(a => a.account_id === 'fin-1')!.bank;
+    expect(accounts.find(a => a.account_id === 'fin-2')!.bank).toBe(
+      bankForFirstOrg,
+    );
+    expect(accounts.find(a => a.account_id === 'fin-3')!.bank).not.toBe(
+      bankForFirstOrg,
+    );
+  });
+
+  it('refuses to link a Fintegra account already held by another local account', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Everyday',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(fintegraLink({ externalAccount })).rejects.toThrow(
+      alreadyLinkedError,
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('upgrades an existing local account into a Fintegra-synced one', async () => {
+    await db.insertAccount({ id: 'target', name: 'Savings' });
+
+    await expect(
+      fintegraLink({ externalAccount, upgradingId: 'target', offBudget: true }),
+    ).resolves.toBe('ok');
+
+    const target = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['target'],
+    );
+    expect(target!.name).toBe('Savings');
+    expect(target!.account_id).toBe('fin-1');
+    expect(target!.account_sync_source).toBe('fintegra');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
