+  describe('with replaceExistingLink', () => {
+    async function getAccount(id: string) {
+      return db.first<{
+        account_id: string | null;
+        bank: string | null;
+        account_sync_source: string | null;
+        closed: number;
+        tombstone: number;
+      }>(
+        'SELECT account_id, bank, account_sync_source, closed, tombstone FROM accounts WHERE id = ?',
+        [id],
+      );
+    }
+
+    it('links into a new account and unlinks the account that held the bank account', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      ]);
+
+      await expect(
+        linkSimpleFinAccount({
+          externalAccount: simpleFinAccount('ext-1'),
+          replaceExistingLink: true,
+        }),
+      ).resolves.toBe('ok');
+
+      expect(await getAccount('acct1')).toEqual({
+        account_id: null,
+        bank: null,
+        account_sync_source: null,
+        closed: 0,
+        tombstone: 0,
+      });
+      const newAccount = await db.first<{ id: string }>(
+        'SELECT id FROM accounts WHERE account_id = ? AND tombstone = 0 AND id != ?',
+        ['ext-1', 'acct1'],
+      );
+      expect(newAccount).toBeTruthy();
+      expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+    });
+
+    it('links into the chosen existing account and unlinks the holder', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+        { id: 'acct2', name: 'Savings', accountId: 'ext-2' },
+      ]);
+
+      await expect(
+        linkSimpleFinAccount({
+          externalAccount: simpleFinAccount('ext-1'),
+          upgradingId: 'acct2',
+          replaceExistingLink: true,
+        }),
+      ).resolves.toBe('ok');
+
+      expect((await getAccount('acct1'))!.account_id).toBeNull();
+      expect((await getAccount('acct2'))!.account_id).toBe('ext-1');
+    });
+
+    it('keeps a closed holding account closed', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      ]);
+      db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+
+      await expect(
+        linkSimpleFinAccount({
+          externalAccount: simpleFinAccount('ext-1'),
+          replaceExistingLink: true,
+        }),
+      ).resolves.toBe('ok');
+
+      expect(await getAccount('acct1')).toEqual({
+        account_id: null,
+        bank: null,
+        account_sync_source: null,
+        closed: 1,
+        tombstone: 0,
+      });
+    });
+
+    it('links normally when no other account holds the bank account', async () => {
+      await expect(
+        linkSimpleFinAccount({
+          externalAccount: simpleFinAccount('ext-1'),
+          replaceExistingLink: true,
+        }),
+      ).resolves.toBe('ok');
+      expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+    });
+
+    it('still refuses to link into a closed account and changes nothing', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      ]);
+      await db.insertAccount({ id: 'acct2', name: 'Savings' });
+      db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct2']);
+
+      await expect(
+        linkSimpleFinAccount({
+          externalAccount: simpleFinAccount('ext-1'),
+          upgradingId: 'acct2',
+          replaceExistingLink: true,
+        }),
+      ).rejects.toThrow(
+        'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+      );
+
+      expect((await getAccount('acct1'))!.account_id).toBe('ext-1');
+      expect((await getAccount('acct2'))!.account_id).toBeNull();
+      expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    });
+  });
 });
 
