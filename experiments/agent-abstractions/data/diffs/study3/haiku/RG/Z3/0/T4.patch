+
+  describe('with replaceExistingLink', () => {
+    async function getAccount(id: string) {
+      return db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        id,
+      ]);
+    }
+
+    it('still refuses a second local account when the flag is false', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      ]);
+
+      await expect(
+        simpleFinLinkHandler({ externalAccount, replaceExistingLink: false }),
+      ).rejects.toThrow(
+        'This bank account is already linked to another account.',
+      );
+      expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    });
+
+    it('links a new account and unlinks the account that held the bank account', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      ]);
+      const before = await countAccounts();
+
+      await expect(
+        simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+      ).resolves.toBe('ok');
+
+      const holder = await getAccount('acct1');
+      expect(holder!.tombstone).toBe(0);
+      expect(holder!.closed).toBe(0);
+      expect(holder!.account_id).toBeNull();
+      expect(holder!.bank).toBeNull();
+      expect(holder!.account_sync_source).toBeNull();
+      expect(await countAccounts()).toBe(before + 1);
+
+      const linked = await db.first<db.DbAccount>(
+        'SELECT * FROM accounts WHERE account_id = ? AND account_sync_source = ? AND id != ?',
+        ['ext-1', 'simpleFin', 'acct1'],
+      );
+      expect(linked).toBeTruthy();
+      expect(bankSync.syncAccount).toHaveBeenCalledWith(
+        undefined,
+        undefined,
+        linked!.id,
+        'ext-1',
+        expect.anything(),
+        undefined,
+        undefined,
+      );
+    });
+
+    it('moves the bank account into the chosen existing account', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      ]);
+      await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+      await expect(
+        simpleFinLinkHandler({
+          externalAccount,
+          upgradingId: 'acct2',
+          replaceExistingLink: true,
+        }),
+      ).resolves.toBe('ok');
+
+      const holder = await getAccount('acct1');
+      expect(holder!.account_id).toBeNull();
+      expect(holder!.account_sync_source).toBeNull();
+
+      const target = await getAccount('acct2');
+      expect(target!.account_id).toBe('ext-1');
+      expect(target!.account_sync_source).toBe('simpleFin');
+      expect(bankSync.syncAccount).toHaveBeenCalled();
+    });
+
+    it('keeps a closed holding account closed', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      ]);
+      await db.update('accounts', { id: 'acct1', closed: 1 });
+
+      await expect(
+        simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+      ).resolves.toBe('ok');
+
+      const holder = await getAccount('acct1');
+      expect(holder!.closed).toBe(1);
+      expect(holder!.account_id).toBeNull();
+      expect(holder!.account_sync_source).toBeNull();
+    });
+
+    it('still refuses linking into a closed account', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+      ]);
+      await db.insertAccount({ id: 'acct2', name: 'Savings' });
+      await db.update('accounts', { id: 'acct2', closed: 1 });
+
+      await expect(
+        simpleFinLinkHandler({
+          externalAccount,
+          upgradingId: 'acct2',
+          replaceExistingLink: true,
+        }),
+      ).rejects.toThrow(
+        'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+      );
+
+      const holder = await getAccount('acct1');
+      expect(holder!.account_id).toBe('ext-1');
+      expect(holder!.account_sync_source).toBe('simpleFin');
+      expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    });
+
+    it('links normally when no other account holds the bank account', async () => {
+      await expect(
+        simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+      ).resolves.toBe('ok');
+      expect(bankSync.syncAccount).toHaveBeenCalled();
+    });
+  });
 });
 
