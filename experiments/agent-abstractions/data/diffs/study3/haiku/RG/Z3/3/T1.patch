 });
+
+describe('linking a bank account that is already linked', () => {
+  const alreadyLinkedMessage =
+    'This bank account is already linked to another account.';
+  const linkSimpleFin = app.handlers['simplefin-accounts-link'];
+
+  function simpleFinAccount(account_id: string) {
+    return {
+      balance: 100,
+      account_id,
+      name: 'Checking',
+      institution: 'Bank',
+      orgId: 'org-1',
+    };
+  }
+
+  async function countAccounts() {
+    const row = await db.first<{ count: number }>(
+      'SELECT COUNT(*) as count FROM accounts WHERE tombstone = 0',
+    );
+    return row!.count;
+  }
+
+  beforeEach(async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses to link a new account to a bank account already linked elsewhere', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    const before = await countAccounts();
+
+    await expect(
+      linkSimpleFin({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    expect(await countAccounts()).toBe(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link an existing account into a bank account held by another account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      linkSimpleFin({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'acct2',
+      }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    const acct2 = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(acct2!.account_id).toBeNull();
+    expect(acct2!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the holding account is closed', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.updateAccount({ id: 'acct1', closed: 1 });
+
+    await expect(
+      linkSimpleFin({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+  });
+
+  it('allows linking when the holding account is deleted', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.deleteAccount({ id: 'acct1' });
+
+    await linkSimpleFin({ externalAccount: simpleFinAccount('ext-1') });
+
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await linkSimpleFin({
+      externalAccount: simpleFinAccount('ext-1'),
+      upgradingId: 'acct1',
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    insertBank({ id: 'bank1', bank_id: 'gc-bank', name: 'GoCardless' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+    await db.insertAccount({ id: 'acct2', name: 'Other' });
+
+    await linkSimpleFin({
+      externalAccount: simpleFinAccount('ext-1'),
+      upgradingId: 'acct2',
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
