+describe('linking a bank account into a closed account', () => {
+  const linkSimpleFin = app.handlers['simplefin-accounts-link'];
+  const closedError =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+  const externalAccount = {
+    account_id: 'ext-1',
+    balance: 0,
+    name: 'Checking',
+    institution: 'SimpleFin Bank',
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+  };
+
+  beforeEach(async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    } as never);
+    await db.insertAccount({ id: 'closed', name: 'Old', bank: null });
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['closed']);
+  });
+
+  it('refuses to link into a closed account and leaves it unchanged', async () => {
+    const before = await db.getAccount('closed');
+    const accountsBefore = await db.first<{ n: number }>(
+      'SELECT COUNT(*) as n FROM accounts WHERE tombstone = 0',
+    );
+
+    await expect(
+      linkSimpleFin({ externalAccount, upgradingId: 'closed' }),
+    ).rejects.toThrow(closedError);
+
+    expect(await db.getAccount('closed')).toEqual(before);
+    expect(
+      await db.first<{ n: number }>(
+        'SELECT COUNT(*) as n FROM accounts WHERE tombstone = 0',
+      ),
+    ).toEqual(accountsBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to re-link a closed account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'holder', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['holder']);
+
+    await expect(
+      linkSimpleFin({ externalAccount, upgradingId: 'holder' }),
+    ).rejects.toThrow(closedError);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows linking once the account is reopened', async () => {
+    db.runQuery('UPDATE accounts SET closed = 0 WHERE id = ?', ['closed']);
+
+    await expect(
+      linkSimpleFin({ externalAccount, upgradingId: 'closed' }),
+    ).resolves.toBe('ok');
+    expect(await db.getAccount('closed')).toMatchObject({
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+
+  it('still allows linking as a new account', async () => {
+    await expect(linkSimpleFin({ externalAccount })).resolves.toBe('ok');
+  });
+});
+
