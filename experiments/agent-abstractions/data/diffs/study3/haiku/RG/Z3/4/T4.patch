+
+describe('replacing an existing bank link', () => {
+  async function findLinkedAccountId() {
+    const row = await db.first<Pick<db.DbAccount, 'id'>>(
+      'SELECT id FROM accounts WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0',
+      ['simpleFin', 'ext-1'],
+    );
+    return row?.id;
+  }
+
+  it('links a new account and unlinks the previous holder', async () => {
+    await insertLinkedAccount({ id: 'holder' });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      closed: 0,
+      tombstone: 0,
+    });
+    expect(await findLinkedAccountId()).not.toBe('holder');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('links into the chosen existing account and unlinks the previous holder', async () => {
+    await insertLinkedAccount({ id: 'holder' });
+    await insertLinkedAccount({ id: 'target', accountId: 'ext-other' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount,
+        upgradingId: 'target',
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(await findLinkedAccountId()).toBe('target');
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({ account_id: null, account_sync_source: null });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('keeps a closed previous holder closed', async () => {
+    await insertLinkedAccount({ id: 'holder', closed: true });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({ account_id: null, closed: 1 });
+  });
+
+  it('is an ordinary link when no other account holds the bank account', async () => {
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    expect(await findLinkedAccountId()).toBeDefined();
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('still refuses to link into a closed account and leaves the holder unchanged', async () => {
+    await insertLinkedAccount({ id: 'holder' });
+    await insertLinkedAccount({
+      id: 'closed-target',
+      accountId: 'ext-other',
+      closed: true,
+    });
+    const holderBefore = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['holder'],
+    );
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount,
+        upgradingId: 'closed-target',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(CLOSED_ERROR);
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toEqual(holderBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses without the flag and leaves the holder linked', async () => {
+    await insertLinkedAccount({ id: 'holder' });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: false }),
+    ).rejects.toThrow(ALREADY_LINKED_ERROR);
+
+    expect(await findLinkedAccountId()).toBe('holder');
+  });
+});
