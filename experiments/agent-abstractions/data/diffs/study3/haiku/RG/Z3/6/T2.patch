+
+describe('linking a Fintegra account', () => {
+  const linkFintegra = app.handlers['fintegra-accounts-link'];
+  const externalAccount = {
+    account_id: 'fin-1',
+    name: 'Everyday',
+    institution: 'Fintegra Bank',
+    orgId: 'org-1',
+    balance: 100,
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    } as never);
+  });
+
+  it('creates a fintegra-sourced account named after the Fintegra account and syncs it', async () => {
+    await expect(
+      linkFintegra({
+        externalAccount,
+        startingDate: '2024-01-01',
+        startingBalance: 500,
+      }),
+    ).resolves.toBe('ok');
+
+    const acct = await db.first<db.DbAccount>(
+      "SELECT * FROM accounts WHERE account_sync_source = 'fintegra'",
+    );
+    expect(acct).toMatchObject({
+      account_id: 'fin-1',
+      name: 'Everyday',
+      official_name: 'Everyday',
+      offbudget: 0,
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      acct.id,
+      'fin-1',
+      'org-1',
+      '2024-01-01',
+      500,
+      undefined,
+    );
+  });
+
+  it('creates an off-budget account when requested', async () => {
+    await linkFintegra({ externalAccount, offBudget: true });
+
+    const acct = await db.first<db.DbAccount>(
+      "SELECT * FROM accounts WHERE account_sync_source = 'fintegra'",
+    );
+    expect(acct.offbudget).toBe(1);
+  });
+
+  it('groups accounts by organisation and institution name', async () => {
+    await linkFintegra({ externalAccount });
+    await linkFintegra({
+      externalAccount: { ...externalAccount, account_id: 'fin-2' },
+    });
+    await linkFintegra({
+      externalAccount: {
+        ...externalAccount,
+        account_id: 'fin-3',
+        institution: 'Other Bank',
+      },
+    });
+
+    const banks = db.runQuery<{ bank_id: string; name: string }>(
+      `SELECT DISTINCT b.bank_id, b.name FROM accounts a
+       JOIN banks b ON a.bank = b.id
+       WHERE a.account_sync_source = 'fintegra' AND a.tombstone = 0`,
+      [],
+      true,
+    );
+    expect(banks).toHaveLength(2);
+    expect(banks).toEqual(
+      expect.arrayContaining([
+        { bank_id: 'org-1', name: 'Fintegra Bank' },
+        { bank_id: 'org-1', name: 'Other Bank' },
+      ]),
+    );
+  });
+
+  it('refuses to link a Fintegra account that another local account already holds', async () => {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Everyday',
+      bank: null,
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(linkFintegra({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('turns an existing local account into a Fintegra-synced account when upgrading', async () => {
+    await db.insertAccount({ id: 'manual', name: 'Cash', bank: null });
+
+    await expect(
+      linkFintegra({ externalAccount, upgradingId: 'manual' }),
+    ).resolves.toBe('ok');
+
+    expect(await db.getAccount('manual')).toMatchObject({
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+      name: 'Cash',
+    });
+  });
+});
