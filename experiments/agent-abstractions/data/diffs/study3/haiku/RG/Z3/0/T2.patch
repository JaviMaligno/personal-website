+type LinkBankSyncAccountParams = LinkAccountBaseParams & {
+  provider: AccountSyncSource;
+  externalAccount: {
+    account_id: string;
+    name: string;
+    institution?: string | null;
+    orgId?: string;
+  };
+};
+
+async function linkBankSyncAccount({
+  provider,
+  externalAccount,
+  upgradingId,
+  offBudget = false,
+  startingDate,
+  startingBalance,
+}: LinkBankSyncAccountParams) {
+  let id;
+  await assertBankAccountNotLinked({
+    provider,
+    accountId: externalAccount.account_id,
+    upgradingId,
+  });
+
+  const bank = await link.findOrCreateBank(
+    { name: externalAccount.institution ?? null },
+    externalAccount.orgId,
+  );
+
+  if (upgradingId) {
+    const accRow = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [upgradingId],
+    );
+
+    if (!accRow) {
+      throw new Error(`Account with ID ${upgradingId} not found.`);
+    }
+
+    id = accRow.id;
+    await db.update('accounts', {
+      id,
+      account_id: externalAccount.account_id,
+      bank: bank.id,
+      account_sync_source: provider,
+    });
+  } else {
+    id = uuidv4();
+    await db.insertWithUUID('accounts', {
+      id,
+      account_id: externalAccount.account_id,
+      name: externalAccount.name,
+      official_name: externalAccount.name,
+      bank: bank.id,
+      offbudget: offBudget ? 1 : 0,
+      account_sync_source: provider,
+    });
+    await db.insertPayee({
+      name: '',
+      transfer_acct: id,
+    });
+  }
+
+  const syncRes = await bankSync.syncAccount(
+    undefined,
+    undefined,
+    id,
+    externalAccount.account_id,
+    bank.bank_id,
+    startingDate,
+    startingBalance,
+  );
+
+  await handleSyncResponse(syncRes, id);
+
+  connection.send('sync-event', {
+    type: 'success',
+    tables: ['transactions', 'accounts'],
+  });
+
+  return 'ok';
+}
+
+async function linkFintegraAccount({
+  externalAccount,
+  ...params
+}: LinkAccountBaseParams & {
+  externalAccount: SyncServerFintegraAccount;
+}) {
+  return linkBankSyncAccount({
+    provider: 'fintegra',
+    externalAccount,
+    ...params,
+  });
+}
