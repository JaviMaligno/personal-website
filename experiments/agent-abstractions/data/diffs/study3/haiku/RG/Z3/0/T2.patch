+      updatedPreview: [],
+    } as never);
+  });
+
+  it('creates an account and a bank for the organisation and institution', async () => {
+    await expect(
+      fintegraLinkHandler({
+        externalAccount,
+        startingDate: '2024-01-01',
+        startingBalance: 5000,
+      }),
+    ).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['fin-1'],
+    );
+    expect(account).toMatchObject({
+      name: 'Checking',
+      official_name: 'Checking',
+      account_sync_source: 'fintegra',
+      offbudget: 0,
+    });
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account!.bank,
+    ]);
+    expect(bank).toMatchObject({ bank_id: 'org-1', name: 'Fintegra Bank' });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      account!.id,
+      'fin-1',
+      'org-1',
+      '2024-01-01',
+      5000,
+    );
+  });
+
+  it('refuses a second local account for a linked Fintegra account', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Fintegra Bank' });
