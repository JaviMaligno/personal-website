+async function getAccount(id: string) {
+  return await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+    id,
+  ]);
+}
+
+describe('prepareBankAccountLink', () => {
+  beforeEach(async () => {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Old',
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+    await db.insertAccount({
+      id: 'target',
+      name: 'New',
+    });
+  });
+
+  it('refuses when another account holds the bank account', async () => {
+    await expect(
+      prepareBankAccountLink({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: 'target',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await getAccount('holder')).toEqual(
+      expect.objectContaining({ account_id: 'ext-1', bank: 'bank1' }),
+    );
+  });
+
+  it('unlinks the holder locally when replacing the existing link', async () => {
+    await prepareBankAccountLink({
+      provider: 'simpleFin',
+      accountId: 'ext-1',
+      upgradingId: 'target',
+      replaceExistingLink: true,
+    });
+
+    expect(await getAccount('holder')).toEqual(
+      expect.objectContaining({
+        id: 'holder',
+        name: 'Old',
+        closed: 1,
+        tombstone: 0,
+        account_id: null,
+        bank: null,
+        account_sync_source: null,
+        bank_sync_status: null,
+      }),
+    );
+    expect(await getAccount('target')).toEqual(
+      expect.objectContaining({ account_id: null, bank: null }),
+    );
+  });
+
+  it('does nothing when replacing and no other account holds the bank account', async () => {
+    await prepareBankAccountLink({
+      provider: 'simpleFin',
+      accountId: 'ext-2',
+      upgradingId: 'target',
+      replaceExistingLink: true,
+    });
+
+    expect(await getAccount('holder')).toEqual(
+      expect.objectContaining({ account_id: 'ext-1', bank: 'bank1' }),
+    );
+  });
+
+  it('does not match the target account against itself', async () => {
+    await db.updateAccount({
+      id: 'holder',
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+    });
+    await db.updateAccount({
+      id: 'target',
+      account_id: 'ext-1',
+      bank: 'bank1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      prepareBankAccountLink({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: 'target',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('still refuses a closed target account when replacing', async () => {
+    await db.updateAccount({ id: 'target', closed: 1 });
+
+    await expect(
+      prepareBankAccountLink({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: 'target',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow('Closed accounts cannot be linked to a bank account.');
+
+    expect(await getAccount('holder')).toEqual(
+      expect.objectContaining({ account_id: 'ext-1', bank: 'bank1' }),
+    );
+  });
+});
