+// Categories that month-wide actions may write to. Hidden categories, categories
+// in hidden groups and categories managed by a saved template are left untouched.
+async function getMonthActionCategories(): Promise<
+  db.DbViewCategoryWithGroupHidden[]
+> {
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden>(`
+    SELECT c.*
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0 AND c.goal_def IS NULL
+  `);
+  return categories.filter(
+    cat => !(cat.is_income === 1 && !isTrackingBudget()),
+  );
+}
