+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'hidden-group-cat',
+      name: 'hidden-group-cat',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'template-cat',
+      name: 'template-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: JSON.stringify([{ type: 'fixed', amount: 100, priority: 1 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  async function setBudgetForAllCategories(month: string, amount: number) {
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'hidden-group-cat',
+      'template-cat',
+    ]) {
+      await setBudget({ category, month, amount });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('copyPreviousMonth skips hidden categories, hidden groups and templated categories', async () => {
+    await setupDatabase();
+    await setBudgetForAllCategories('2024-01', 100);
+    await setBudgetForAllCategories('2024-02', 999);
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(100);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(999);
+    expect(await getSheetValue('budget202402', 'budget-hidden-group-cat')).toBe(
+      999,
+    );
+    expect(await getSheetValue('budget202402', 'budget-template-cat')).toBe(
+      999,
+    );
+  });
+
+  it('setZero skips hidden categories, hidden groups and templated categories', async () => {
+    await setupDatabase();
+    await setBudgetForAllCategories('2024-02', 500);
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-hidden-group-cat')).toBe(
+      500,
+    );
+    expect(await getSheetValue('budget202402', 'budget-template-cat')).toBe(
+      500,
+    );
+  });
+
+  it('set3MonthAvg skips hidden categories, hidden groups and templated categories', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'hidden-group-cat',
+      'template-cat',
+    ]) {
+      await db.insertTransaction({
+        date: '2024-01-15',
+        amount: -300,
+        account: 'account1',
+        category,
+      });
+    }
+    await sheet.waitOnSpreadsheet();
+    await setBudgetForAllCategories('2024-02', 999);
+
+    await set3MonthAvg({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(300);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(999);
+    expect(await getSheetValue('budget202402', 'budget-hidden-group-cat')).toBe(
+      999,
+    );
+    expect(await getSheetValue('budget202402', 'budget-template-cat')).toBe(
+      999,
+    );
+  });
+});
