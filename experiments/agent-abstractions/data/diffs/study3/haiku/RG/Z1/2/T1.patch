+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupMonthWideDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'group1', name: 'group1' });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      hidden: 1,
+    });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'cat-hidden',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'cat-in-hidden-group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'cat-templated',
+      name: 'cat-templated',
+      cat_group: 'group1',
+    });
+    await db.update('categories', {
+      id: 'cat-templated',
+      goal_def: JSON.stringify([
+        {
+          type: 'simple',
+          monthly: 300,
+          directive: 'template',
+          priority: null,
+        },
+      ]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  const allCategories = [
+    'cat1',
+    'cat-hidden',
+    'cat-in-hidden-group',
+    'cat-templated',
+  ];
+
+  async function setBudgetsForAll(month: string, amount: number) {
+    for (const category of allCategories) {
+      await setBudget({ category, month, amount });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('setZero leaves hidden categories and template-managed categories untouched', async () => {
+    await setupMonthWideDatabase();
+    await setBudgetsForAll('2024-01', 500);
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-cat-hidden')).toBe(500);
+    expect(
+      await getSheetValue('budget202401', 'budget-cat-in-hidden-group'),
+    ).toBe(500);
+    expect(await getSheetValue('budget202401', 'budget-cat-templated')).toBe(
+      500,
+    );
+  });
+
+  it('copyPreviousMonth leaves hidden categories and template-managed categories untouched', async () => {
+    await setupMonthWideDatabase();
+    await setBudgetsForAll('2024-01', 500);
+    await setBudgetsForAll('2024-02', 0);
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(0);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-cat-templated')).toBe(0);
+  });
+});
