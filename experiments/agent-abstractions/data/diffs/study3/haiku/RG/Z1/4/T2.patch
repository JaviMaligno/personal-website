 }
 
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getMonthWideActionCategories();
+  const prevSheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  const amounts: { category: string; amount: number }[] = [];
+  for (const cat of categories) {
+    if (cat.is_income === 1 && !isTrackingBudget()) {
+      continue;
+    }
+
+    const net = await getSheetValue(prevSheetName, 'sum-amount-' + cat.id);
+    amounts.push({
+      category: cat.id,
+      amount: cat.is_income === 1 ? net : -net || 0,
+    });
+  }
+
+  await batchMessages(async () => {
+    for (const { category, amount } of amounts) {
+      void setBudget({ category, month, amount });
+    }
+  });
+}
