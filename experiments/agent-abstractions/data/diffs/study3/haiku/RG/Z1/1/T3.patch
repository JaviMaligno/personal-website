+const FIXED_GROUP_TAG = /(^|\s)#fixed(\s|$)/i;
+
+async function getFixedGroupIds(): Promise<Set<string>> {
+  const groupNotes = await db.all<
+    Pick<db.DbCategoryGroup, 'id'> & Pick<db.DbNote, 'note'>
+  >(`
+    SELECT g.id, n.note
+    FROM category_groups g
+    JOIN notes n ON n.id = g.id
+    WHERE g.tombstone = 0 AND n.note IS NOT NULL
+  `);
+  return new Set(
+    groupNotes
+      .filter(group => FIXED_GROUP_TAG.test(group.note))
+      .map(group => group.id),
+  );
+}
