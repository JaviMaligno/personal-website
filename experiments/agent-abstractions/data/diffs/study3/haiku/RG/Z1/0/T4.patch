+  it('setZero with includeHiddenCategories fills hidden and hidden group categories but still leaves templated and #fixed categories untouched', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'cat1', month: '2024-04', amount: 5000 });
+    await setSkippedBudgets('2024-04');
+    await setBudget({
+      category: 'fixed-group-cat',
+      month: '2024-04',
+      amount: SKIPPED_AMOUNT,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-04', includeHiddenCategories: true });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-hidden-group-cat')).toBe(
+      0,
+    );
+    expect(await getSheetValue('budget202404', 'budget-templated-cat')).toBe(
+      SKIPPED_AMOUNT,
+    );
+    expect(await getSheetValue('budget202404', 'budget-fixed-group-cat')).toBe(
+      SKIPPED_AMOUNT,
+    );
+  });
+
+  it('copyPreviousMonth with includeHiddenCategories copies hidden categories', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'hidden-cat', month: '2024-03', amount: 500 });
+    await setBudget({
+      category: 'templated-cat',
+      month: '2024-03',
+      amount: 500,
+    });
+    await setBudget({
+      category: 'hidden-cat',
+      month: '2024-04',
+      amount: SKIPPED_AMOUNT,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({
+      month: '2024-04',
+      includeHiddenCategories: true,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(500);
+    expect(await getSheetValue('budget202404', 'budget-templated-cat')).toBe(0);
+  });
 });
