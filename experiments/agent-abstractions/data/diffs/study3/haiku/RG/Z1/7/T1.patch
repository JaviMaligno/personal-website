+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'open',
+      name: 'open',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'in-hidden-group',
+      name: 'in-hidden-group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'templated',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.update('categories', {
+      id: 'templated',
+      goal_def: JSON.stringify([{ type: 'simple', monthly: 100 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  async function setBudgetsForJanuary() {
+    await setBudget({ category: 'open', month: '2024-01', amount: 1000 });
+    await setBudget({ category: 'hidden-cat', month: '2024-01', amount: 2000 });
+    await setBudget({
+      category: 'in-hidden-group',
+      month: '2024-01',
+      amount: 3000,
+    });
+    await setBudget({ category: 'templated', month: '2024-01', amount: 4000 });
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('setZero only clears categories that are not hidden and have no templates', async () => {
+    await setupDatabase();
+    await setBudgetsForJanuary();
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-open')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-hidden-cat')).toBe(2000);
+    expect(await getSheetValue('budget202401', 'budget-in-hidden-group')).toBe(
+      3000,
+    );
+    expect(await getSheetValue('budget202401', 'budget-templated')).toBe(4000);
+  });
+
+  it('copyPreviousMonth skips hidden categories and categories with templates', async () => {
+    await setupDatabase();
+    await setBudgetsForJanuary();
+    await setBudget({ category: 'templated', month: '2024-02', amount: 500 });
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-open')).toBe(1000);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-in-hidden-group')).toBe(
+      0,
+    );
+    expect(await getSheetValue('budget202402', 'budget-templated')).toBe(500);
+  });
+});
