+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  const SKIPPED_AMOUNT = 111;
+
+  async function setupDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat1',
+      name: 'cat1',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'hidden-group-cat',
+      name: 'hidden-group-cat',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'templated-cat',
+      name: 'templated-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: JSON.stringify([
+        { type: 'simple', monthly: 100, directive: 'template', priority: 1 },
+      ]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02', '2024-03', '2024-04']);
+  }
+
+  async function setSkippedBudgets(month: string) {
+    for (const category of [
+      'hidden-cat',
+      'hidden-group-cat',
+      'templated-cat',
+    ]) {
+      await setBudget({ category, month, amount: SKIPPED_AMOUNT });
+    }
+  }
+
+  async function expectSkippedUntouched(month: string) {
+    for (const category of [
+      'hidden-cat',
+      'hidden-group-cat',
+      'templated-cat',
+    ]) {
+      expect(
+        await getSheetValue(
+          `budget${month.replace('-', '')}`,
+          `budget-${category}`,
+        ),
+      ).toBe(SKIPPED_AMOUNT);
+    }
+  }
+
+  it('setZero leaves hidden, hidden group, and templated categories untouched', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'cat1', month: '2024-04', amount: 5000 });
+    await setSkippedBudgets('2024-04');
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(0);
+    await expectSkippedUntouched('2024-04');
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden group, and templated categories untouched', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'cat1', month: '2024-03', amount: 500 });
+    for (const category of [
+      'hidden-cat',
+      'hidden-group-cat',
+      'templated-cat',
+    ]) {
+      await setBudget({ category, month: '2024-03', amount: 500 });
+    }
+    await setSkippedBudgets('2024-04');
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(500);
+    await expectSkippedUntouched('2024-04');
+  });
+
+  it('set3MonthAvg leaves hidden, hidden group, and templated categories untouched', async () => {
+    await setupDatabase();
+    await db.insertTransaction({
+      date: '2024-03-15',
+      amount: -300,
+      account: 'account1',
+      category: 'cat1',
+    });
+    await sheet.waitOnSpreadsheet();
+    await setSkippedBudgets('2024-04');
+    await sheet.waitOnSpreadsheet();
+
+    const originalCurrentMonth = global.currentMonth;
+    global.currentMonth = '2024-04';
+    try {
+      await set3MonthAvg({ month: '2024-04' });
+      await sheet.waitOnSpreadsheet();
+    } finally {
+      global.currentMonth = originalCurrentMonth;
+    }
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(300);
+    await expectSkippedUntouched('2024-04');
+  });
+});
