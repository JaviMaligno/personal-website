@@ -266,6 +266,31 @@ export async function copySinglePreviousMonth({
   });
 }
 
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getMonthWideCategories();
+  const prevSheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      const netSpending = await getSheetValue(
+        prevSheetName,
+        'sum-amount-' + cat.id,
+      );
+      const amount = cat.is_income === 1 ? netSpending : 0 - netSpending;
+
+      void setBudget({ category: cat.id, month, amount });
+    }
+  });
+}
