+async function getFixedGroupIds(): Promise<Set<string>> {
+  const groupNotes = await db.all<db.DbNote>(`
+    SELECT n.id, n.note
+    FROM notes n
+    JOIN category_groups g ON g.id = n.id
+    WHERE g.tombstone = 0 AND n.note LIKE '%#fixed%'
+  `);
+  return new Set(
+    groupNotes
+      .filter(({ note }) => extractTagsFromText(note).includes('fixed'))
+      .map(({ id }) => id),
+  );
+}
