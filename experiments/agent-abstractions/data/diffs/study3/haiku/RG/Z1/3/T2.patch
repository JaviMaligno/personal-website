+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevMonthSheet = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = await getMonthWideBudgetCategories();
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      const prevSum = await getSheetValue(
+        prevMonthSheet,
+        'sum-amount-' + cat.id,
+      );
+      // 0 - x rather than -x so an empty expense month stores 0, not -0
+      const amount = cat.is_income === 1 ? prevSum : 0 - prevSum;
+      void setBudget({ category: cat.id, month, amount });
+    }
+  });
+}
