+// categories in fixed groups, and categories with saved budget templates
+// alone. Expects `c` = categories and `g` = category_groups in the query, and
+// a single parameter: the JSON array of fixed group ids from getFixedGroupIds.
+const MONTH_WIDE_CATEGORY_CONDITIONS = `c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0 AND c.goal_def IS NULL AND g.id NOT IN (SELECT value FROM json_each(?))`;
+
+async function getFixedGroupIds(): Promise<string> {
+  const groupNotes = await db.all<db.DbNote>(
+    `SELECT n.id, n.note
+       FROM notes n
+       JOIN category_groups g ON g.id = n.id
+      WHERE g.tombstone = 0 AND n.note LIKE '%#fixed%'`,
+  );
+  return JSON.stringify(
+    groupNotes
+      .filter(group => extractTagsFromText(group.note).includes('fixed'))
+      .map(group => group.id),
+  );
+}
 
