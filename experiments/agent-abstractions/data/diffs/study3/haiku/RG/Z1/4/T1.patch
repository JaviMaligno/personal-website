+describe('month-wide budget actions', () => {
+  let originalCurrentMonth: string | null;
+
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    originalCurrentMonth = global.currentMonth;
+    global.currentMonth = '2024-05';
+
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'hidden-group-cat',
+      name: 'hidden-group-cat',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'templated-cat',
+      name: 'templated-cat',
+      cat_group: 'group1',
+    });
+    await db.updateWithSchema('categories', {
+      id: 'templated-cat',
+      goal_def: JSON.stringify([{ name: 'monthly', amount: 100 }]),
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04', '2024-05']);
+
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'hidden-group-cat',
+      'templated-cat',
+    ]) {
+      await setBudget({ category, month: '2024-03', amount: 500 });
+      await setBudget({ category, month: '2024-04', amount: 1000 });
+    }
+    await sheet.waitOnSpreadsheet();
+  });
+
+  afterEach(async () => {
+    global.currentMonth = originalCurrentMonth;
+    await global.emptyDatabase()();
+  });
+
+  it('setZero only zeroes categories that are visible and not templated', async () => {
+    await setZero({ month: '2024-04' });
+
+    expect(getBudget({ category: 'cat1', month: '2024-04' })).toBe(0);
+    expect(getBudget({ category: 'hidden-cat', month: '2024-04' })).toBe(1000);
+    expect(getBudget({ category: 'hidden-group-cat', month: '2024-04' })).toBe(
+      1000,
+    );
+    expect(getBudget({ category: 'templated-cat', month: '2024-04' })).toBe(
+      1000,
+    );
+  });
+
+  it('copyPreviousMonth skips hidden, hidden-group and templated categories', async () => {
+    await copyPreviousMonth({ month: '2024-04' });
+
+    expect(getBudget({ category: 'cat1', month: '2024-04' })).toBe(500);
+    expect(getBudget({ category: 'hidden-cat', month: '2024-04' })).toBe(1000);
+    expect(getBudget({ category: 'hidden-group-cat', month: '2024-04' })).toBe(
+      1000,
+    );
+    expect(getBudget({ category: 'templated-cat', month: '2024-04' })).toBe(
+      1000,
+    );
+  });
+
+  it('set3MonthAvg skips templated categories', async () => {
+    await set3MonthAvg({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'cat1', month: '2024-04' })).toBe(0);
+    expect(getBudget({ category: 'templated-cat', month: '2024-04' })).toBe(
+      1000,
+    );
+  });
+});
