+const FIXED_COST_TAG = /(?:^|\s)#fixed(?=\s|$)/;
+
+async function getFixedCostGroupIds(): Promise<Set<string>> {
+  const groupNotes = await db.all<Pick<db.DbNote, 'id' | 'note'>>(`
+    SELECT n.id, n.note
+    FROM notes n
+    JOIN category_groups g ON g.id = n.id
+    WHERE n.note LIKE '%#fixed%'
+  `);
+  return new Set(
+    groupNotes
+      .filter(({ note }) => FIXED_COST_TAG.test(note))
+      .map(({ id }) => id),
+  );
+}
