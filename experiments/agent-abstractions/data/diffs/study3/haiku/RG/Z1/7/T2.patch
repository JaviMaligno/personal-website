+
+describe('setLastMonthSpending', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'spent',
+      name: 'spent',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'refunded',
+      name: 'refunded',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'unspent',
+      name: 'unspent',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    await db.insertTransaction({
+      date: '2024-01-10',
+      amount: -3000,
+      account: 'account1',
+      category: 'spent',
+    });
+    await db.insertTransaction({
+      date: '2024-01-12',
+      amount: 1000,
+      account: 'account1',
+      category: 'refunded',
+    });
+    await db.insertTransaction({
+      date: '2024-01-05',
+      amount: 5000,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await db.insertTransaction({
+      date: '2024-01-20',
+      amount: -700,
+      account: 'account1',
+      category: 'hidden-cat',
+    });
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('budgets each expense category at its net spending in the previous month', async () => {
+    await setupDatabase();
+
+    await setLastMonthSpending({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-spent')).toBe(3000);
+    expect(await getSheetValue('budget202402', 'budget-unspent')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-refunded')).toBe(0);
+  });
+
+  it('leaves income and hidden categories untouched in envelope budget mode', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'income-cat', month: '2024-02', amount: 42 });
+    await setBudget({ category: 'hidden-cat', month: '2024-02', amount: 99 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-income-cat')).toBe(42);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(99);
+  });
+
+  it('budgets income categories at the amount received in tracking budget mode', async () => {
+    await setupDatabase();
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+
+    await setLastMonthSpending({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-income-cat')).toBe(5000);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(0);
+  });
+});
