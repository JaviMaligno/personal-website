+// Month-wide actions leave hidden categories, categories in hidden groups,
+// categories in groups tagged #fixed in their notes and categories with saved
+// budget templates untouched.
+async function getMonthWideCategories(): Promise<
+  db.DbViewCategoryWithGroupHidden[]
+> {
+  const categories = await db.all<
+    db.DbViewCategoryWithGroupHidden & { group_note: string | null }
+  >(`
+    SELECT c.*, gn.note AS group_note
     FROM categories c
     LEFT JOIN category_groups g ON c.cat_group = g.id
+    LEFT JOIN notes gn ON gn.id = g.id
     WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0 AND c.goal_def IS NULL
   `);
+  return categories.filter(
+    cat => !extractTagsFromText(cat.group_note ?? '').includes('fixed'),
+  );
 }
 
