+describe('month-wide budget actions', () => {
+  let originalCurrentMonth: string | null;
+
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    originalCurrentMonth = global.currentMonth;
+    global.currentMonth = '2024-05';
+  });
+
+  afterEach(async () => {
+    global.currentMonth = originalCurrentMonth;
+    await global.emptyDatabase()();
+  });
+
+  async function setupMonthWideDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden',
+      is_income: 0,
+    });
+    await db.update('category_groups', { id: 'hidden-group', hidden: 1 });
+
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-open',
+      name: 'open',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'hidden',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.update('categories', { id: 'cat-hidden', hidden: 1 });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'in hidden group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-template',
+      name: 'template',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.update('categories', {
+      id: 'cat-template',
+      goal_def: JSON.stringify([
+        { type: 'fixed', amount: 100, priority: 1, directive: 'template' },
+      ]),
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02', '2024-03', '2024-04']);
+  }
+
+  async function setBudgetForAllCategories(month: string, amount: number) {
+    for (const category of [
+      'income-cat',
+      'cat-open',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-template',
+    ]) {
+      await setBudget({ category, month, amount });
+    }
+  }
+
+  it('setZero leaves hidden, hidden-group and template categories untouched', async () => {
+    await setupMonthWideDatabase();
+    await setBudgetForAllCategories('2024-04', 500);
+
+    await setZero({ month: '2024-04' });
+
+    expect(getBudget({ category: 'cat-open', month: '2024-04' })).toBe(0);
+    expect(getBudget({ category: 'cat-hidden', month: '2024-04' })).toBe(500);
+    expect(
+      getBudget({ category: 'cat-in-hidden-group', month: '2024-04' }),
+    ).toBe(500);
+    expect(getBudget({ category: 'cat-template', month: '2024-04' })).toBe(500);
+    expect(getBudget({ category: 'income-cat', month: '2024-04' })).toBe(500);
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and template categories untouched', async () => {
+    await setupMonthWideDatabase();
+    await setBudgetForAllCategories('2024-03', 500);
+
+    await copyPreviousMonth({ month: '2024-04' });
+
+    expect(getBudget({ category: 'cat-open', month: '2024-04' })).toBe(500);
+    expect(getBudget({ category: 'cat-hidden', month: '2024-04' })).toBe(0);
+    expect(
+      getBudget({ category: 'cat-in-hidden-group', month: '2024-04' }),
+    ).toBe(0);
+    expect(getBudget({ category: 'cat-template', month: '2024-04' })).toBe(0);
+    expect(getBudget({ category: 'income-cat', month: '2024-04' })).toBe(0);
+  });
+
+  it('set3MonthAvg leaves hidden, hidden-group and template categories untouched', async () => {
+    await setupMonthWideDatabase();
+    for (const category of ['cat-open', 'cat-hidden', 'cat-template']) {
+      for (const date of ['2024-01-15', '2024-02-15', '2024-03-15']) {
+        await db.insertTransaction({
+          date,
+          amount: -300,
+          account: 'account1',
+          category,
+        });
+      }
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'cat-open', month: '2024-04' })).toBe(300);
+    expect(getBudget({ category: 'cat-hidden', month: '2024-04' })).toBe(0);
+    expect(getBudget({ category: 'cat-template', month: '2024-04' })).toBe(0);
+  });
+});
