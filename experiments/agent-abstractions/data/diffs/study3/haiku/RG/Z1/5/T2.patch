+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevSheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = await getMonthActionCategories();
+
+  const amounts = await Promise.all(
+    categories.map(async cat => {
+      const netAmount = await getSheetValue(
+        prevSheetName,
+        'sum-amount-' + cat.id,
+      );
+      return {
+        category: cat.id,
+        amount: (cat.is_income === 1 ? netAmount : -netAmount) || 0,
+      };
+    }),
+  );
+
+  await batchMessages(async () => {
+    amounts.forEach(({ category, amount }) => {
+      void setBudget({ category, month, amount });
+    });
+  });
+}
