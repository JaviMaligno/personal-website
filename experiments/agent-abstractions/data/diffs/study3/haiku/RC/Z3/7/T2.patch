+describe('fintegra-accounts-link', () => {
+  const linkFintegra = app.handlers['fintegra-accounts-link'];
+  const externalAccount = {
+    account_id: 'fin-1',
+    name: 'Savings',
+    balance: 250,
+    institution: 'Fintegra Bank',
+    orgId: 'org-9',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+    } as never);
+  });
+
+  it('links a new account under a bank keyed by the organisation id', async () => {
+    await expect(linkFintegra({ externalAccount })).resolves.toBe('ok');
+
+    const accounts = db.runQuery<{
+      id: string;
+      name: string;
+      official_name: string;
+      account_sync_source: string;
+      bank: string;
+    }>(
+      'SELECT id, name, official_name, account_sync_source, bank FROM accounts WHERE account_id = ?',
+      ['fin-1'],
+      true,
+    );
+    expect(accounts).toHaveLength(1);
+    expect(accounts[0]).toMatchObject({
+      name: 'Savings',
+      official_name: 'Savings',
+      account_sync_source: 'fintegra',
+    });
+
+    const banks = db.runQuery<{ bank_id: string; name: string }>(
+      'SELECT bank_id, name FROM banks WHERE id = ?',
+      [accounts[0].bank],
+      true,
+    );
+    expect(banks[0]).toMatchObject({
+      bank_id: 'org-9',
+      name: 'Fintegra Bank',
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      accounts[0].id,
+      'fin-1',
+      'org-9',
+      undefined,
+      undefined,
+      undefined,
+    );
+  });
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(linkFintegra({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
