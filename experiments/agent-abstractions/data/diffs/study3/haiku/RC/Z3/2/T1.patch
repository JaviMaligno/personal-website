 });
+
+describe('linking a bank account that is already linked', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'sfin-ext-1',
+    name: 'Checking',
+    institution: null,
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+  };
+  const linkError = 'This bank account is already linked to another account.';
+
+  beforeEach(async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing',
+      bank: null,
+      account_id: 'sfin-ext-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+
+  it('refuses a new account and creates nothing', async () => {
+    const accountsBefore = await db.all('SELECT id FROM accounts');
+    const payeesBefore = await db.all('SELECT id FROM payees');
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      linkError,
+    );
+
+    expect(await db.all('SELECT id FROM accounts')).toEqual(accountsBefore);
+    expect(await db.all('SELECT id FROM payees')).toEqual(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses upgrading a different account and leaves it unchanged', async () => {
+    await db.insertAccount({
+      id: 'target',
+      name: 'Target',
+      bank: null,
+      account_id: 'other',
+      account_sync_source: 'simpleFin',
+    });
+    const targetBefore = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['target'],
+    );
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'target' }),
+    ).rejects.toThrow(linkError);
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'target',
+      ]),
+    ).toEqual(targetBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows re-linking into the account that already holds the link', async () => {
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'existing' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows linking when the existing holder is deleted', async () => {
+    await db.update('accounts', { id: 'existing', tombstone: 1 });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await expect(
+      app.handlers['gocardless-accounts-link']({
+        requisitionId: 'req-1',
+        account: {
+          ...externalAccount,
+          official_name: 'Checking',
+          mask: undefined,
+          institution: null,
+        },
+      }),
+    ).resolves.toBe('ok');
+  });
+});
