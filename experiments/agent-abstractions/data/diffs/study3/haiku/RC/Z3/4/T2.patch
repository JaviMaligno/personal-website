+
+describe('linking a Fintegra account', () => {
+  const linkFintegraAccountHandler = app.handlers['fintegra-accounts-link'];
+  const externalAccount = {
+    account_id: 'fin-1',
+    name: 'Everyday',
+    balance: 0,
+    institution: 'Bank',
+    orgId: 'org-1',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a bank-synced account named after the Fintegra account', async () => {
+    await expect(linkFintegraAccountHandler({ externalAccount })).resolves.toBe(
+      'ok',
+    );
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_sync_source = ?',
+      ['fintegra'],
+    );
+    expect(account).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      account_id: 'fin-1',
+    });
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account!.bank,
+    ]);
+    expect(bank).toMatchObject({ bank_id: 'org-1', name: 'Bank' });
+  });
+
+  it('groups accounts from the same organisation under one bank', async () => {
+    await linkFintegraAccountHandler({ externalAccount });
+    await linkFintegraAccountHandler({
+      externalAccount: {
+        ...externalAccount,
+        account_id: 'fin-2',
+        name: 'Savings',
+      },
+    });
+
+    const banks = await db.all<db.DbBank>('SELECT * FROM banks');
+    expect(banks).toHaveLength(1);
+  });
+
+  it('refuses to link a bank account that another local account already holds', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Bank' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Everyday',
+      bank: 'bank1',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      linkFintegraAccountHandler({ externalAccount }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
