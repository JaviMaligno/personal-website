+describe('linking into a closed account', () => {
+  const closedMessage =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+  it('refuses upgrading a closed account and leaves it untouched', async () => {
+    await db.insertAccount({
+      id: 'closed-1',
+      name: 'Old Savings',
+      offbudget: 0,
+      closed: 1,
+    });
+    const banksBefore = await db.all('SELECT * FROM banks');
+    const accountsBefore = await db.all('SELECT * FROM accounts');
+
+    await expect(
+      linkHandlers.simpleFin({
+        externalAccount: externalAccount(),
+        upgradingId: 'closed-1',
+      }),
+    ).rejects.toThrow(closedMessage);
+
+    expect(await db.all('SELECT * FROM banks')).toEqual(banksBefore);
+    expect(await db.all('SELECT * FROM accounts')).toEqual(accountsBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(sentSuccessEvents()).toEqual([]);
+  });
+
+  it('refuses re-linking the closed account that already holds the link', async () => {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      offbudget: 0,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+
+    await expect(
+      linkHandlers.simpleFin({
+        externalAccount: externalAccount(),
+        upgradingId: 'holder',
+      }),
+    ).rejects.toThrow(closedMessage);
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(sentSuccessEvents()).toEqual([]);
+  });
+
+  it('allows linking once the account is reopened', async () => {
+    await db.insertAccount({
+      id: 'closed-1',
+      name: 'Old Savings',
+      offbudget: 0,
+      closed: 1,
+    });
+    await db.update('accounts', { id: 'closed-1', closed: 0 });
+
+    const result = await linkHandlers.simpleFin({
+      externalAccount: externalAccount(),
+      upgradingId: 'closed-1',
+    });
+
+    expect(result).toBe('ok');
+    expect(await linkedAccount('ext-1')).toMatchObject({
+      id: 'closed-1',
+      closed: 0,
+    });
+  });
+});
+
