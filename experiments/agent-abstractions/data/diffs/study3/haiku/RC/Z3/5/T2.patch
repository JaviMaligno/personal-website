+
+describe('linking a Fintegra account', () => {
+  const fintegraLinkHandler = app.handlers['fintegra-accounts-link'];
+  const externalAccount = {
+    account_id: 'fin-ext-1',
+    name: 'Checking',
+    balance: 100,
+    orgId: 'org-1',
+    institution: 'Example Bank',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a bank-synced account named after the Fintegra account', async () => {
+    const result = await fintegraLinkHandler({
+      externalAccount,
+      offBudget: true,
+    });
+
+    expect(result).toBe('ok');
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_sync_source = ?',
+      ['fintegra'],
+    );
+    expect(account).toMatchObject({
+      account_id: 'fin-ext-1',
+      name: 'Checking',
+      official_name: 'Checking',
+      offbudget: 1,
+    });
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account.bank,
+    ]);
+    expect(bank).toMatchObject({ bank_id: 'org-1', name: 'Example Bank' });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('shares one bank between accounts of the same organisation and institution', async () => {
+    await fintegraLinkHandler({ externalAccount });
+    await fintegraLinkHandler({
+      externalAccount: { ...externalAccount, account_id: 'fin-ext-2' },
+    });
+
+    const banks = await db.all<db.DbBank>('SELECT * FROM banks');
+    expect(banks).toHaveLength(1);
+  });
+
+  it('refuses to link a bank account that another account already holds', async () => {
+    await fintegraLinkHandler({ externalAccount });
+
+    await expect(fintegraLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
