+import * as connection from '#platform/server/connection';
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+const goCardlessLinkHandler = app.handlers['gocardless-accounts-link'];
+const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+const pluggyAiLinkHandler = app.handlers['pluggyai-accounts-link'];
+const akahuLinkHandler = app.handlers['akahu-accounts-link'];
+const enableBankingLinkHandler = app.handlers['enablebanking-accounts-link'];
+
+async function getAccount(id: string) {
+  return db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [id]);
+}
+
+async function getBankByBankId(bankId: string) {
+  return db.first<db.DbBank>('SELECT * FROM banks WHERE bank_id = ?', [bankId]);
+}
+
+async function getTransferPayeeCount(accountId: string) {
+  const row = await db.first<{ count: number }>(
+    'SELECT count(*) as count FROM payees WHERE transfer_acct = ?',
+    [accountId],
+  );
+  return row?.count ?? 0;
+}
+
+async function insertExistingAccount(id: string) {
+  await db.insertAccount({
+    id,
+    name: 'Existing',
+    offbudget: 0,
+    account_id: null,
+    account_sync_source: null,
+  });
+}
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(bankSync.syncAccount).mockResolvedValue({
+    added: [],
+    updated: [],
+    updatedPreview: [],
+  });
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+describe('linkGoCardlessAccount', () => {
+  const account = {
+    balance: 0,
+    institution: { name: 'GC Bank' },
+    account_id: 'ext-gc-1',
+    mask: '1234',
+    name: 'Checking',
+    official_name: 'Official Checking',
+  };
+
+  it('creates the account with its transfer payee and syncs it', async () => {
+    const result = await goCardlessLinkHandler({
+      requisitionId: 'req-1',
+      account,
+      offBudget: true,
+    });
+
+    expect(result).toBe('ok');
+
+    const bank = await getBankByBankId('req-1');
+    expect(bank?.name).toBe('GC Bank');
+
+    const created = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['ext-gc-1'],
+    );
+    expect(created).toMatchObject({
+      name: 'Checking',
+      official_name: 'Official Checking',
+      mask: '1234',
+      bank: bank?.id,
+      offbudget: 1,
+      account_sync_source: 'goCardless',
+    });
+    expect(await getTransferPayeeCount(created!.id)).toBe(1);
+
+    const syncArgs = vi.mocked(bankSync.syncAccount).mock.calls[0];
+    expect(syncArgs.slice(2, 7)).toEqual([
+      created!.id,
+      'ext-gc-1',
+      'req-1',
+      undefined,
+      undefined,
+    ]);
+    expect(connection.send).toHaveBeenCalledWith('sync-event', {
+      type: 'success',
+      tables: ['transactions', 'accounts'],
+    });
+  });
+
+  it('keeps a string institution as the bank name', async () => {
+    await goCardlessLinkHandler({
+      requisitionId: 'req-2',
+      account: { ...account, institution: 'Plain Bank' },
+    });
+
+    expect((await getBankByBankId('req-2'))?.name).toBe('Plain Bank');
+  });
+
+  it('upgrades an existing account without renaming it or adding a payee', async () => {
+    await insertExistingAccount('acct1');
+
+    await goCardlessLinkHandler({
+      requisitionId: 'req-3',
+      account,
+      upgradingId: 'acct1',
+    });
+
+    const upgraded = await getAccount('acct1');
+    expect(upgraded).toMatchObject({
+      name: 'Existing',
+      account_id: 'ext-gc-1',
+      account_sync_source: 'goCardless',
+      bank_sync_status: 'ok',
+    });
+    expect(upgraded?.bank).toBe((await getBankByBankId('req-3'))?.id);
+    expect(await getTransferPayeeCount('acct1')).toBe(0);
+    const syncArgs = vi.mocked(bankSync.syncAccount).mock.calls[0];
+    expect(syncArgs.slice(2, 7)).toEqual([
+      'acct1',
+      'ext-gc-1',
+      'req-3',
+      undefined,
+      undefined,
+    ]);
+  });
+
+  it('throws for an unknown upgrade target after creating the bank', async () => {
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-4',
+        account,
+        upgradingId: 'missing',
+      }),
+    ).rejects.toThrow('Account with ID missing not found.');
+
+    expect(await getBankByBankId('req-4')).not.toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
+
+describe('linkSimpleFinAccount', () => {
+  const externalAccount = {
+    balance: 0,
+    account_id: 'ext-sf-1',
+    name: 'Savings',
+    institution: 'SF Bank',
+    orgDomain: 'sf.example',
+    orgId: 'org-1',
+  };
+
+  it('creates the account with its transfer payee and syncs it', async () => {
+    const result = await simpleFinLinkHandler({ externalAccount });
+
+    expect(result).toBe('ok');
+
+    const bank = await getBankByBankId('sf.example');
+    expect(bank?.name).toBe('SF Bank');
+
+    const created = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['ext-sf-1'],
+    );
+    expect(created).toMatchObject({
+      name: 'Savings',
+      official_name: 'Savings',
+      bank: bank?.id,
+      offbudget: 0,
+      account_sync_source: 'simpleFin',
+    });
+    expect(created?.mask).toBeFalsy();
+    expect(await getTransferPayeeCount(created!.id)).toBe(1);
+    expect(connection.send).toHaveBeenCalledWith('sync-event', {
+      type: 'success',
+      tables: ['transactions', 'accounts'],
+    });
+  });
+
+  it('stores a null bank name and falls back to orgId without orgDomain', async () => {
+    await simpleFinLinkHandler({
+      externalAccount: {
+        ...externalAccount,
+        institution: undefined,
+        orgDomain: undefined,
+      },
+    });
+
+    expect(await getBankByBankId('org-1')).toMatchObject({ name: null });
+  });
+
+  it('throws for an unknown upgrade target after creating the bank', async () => {
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'missing' }),
+    ).rejects.toThrow('Account with ID missing not found.');
+
+    expect(await getBankByBankId('sf.example')).not.toBeNull();
+  });
+});
+
+describe('linkPluggyAiAccount', () => {
+  it('creates the account with its transfer payee and syncs it', async () => {
+    const result = await pluggyAiLinkHandler({
+      externalAccount: {
+        balance: 0,
+        account_id: 'ext-py-1',
+        name: 'Card',
+        institution: 'Py Bank',
+        orgDomain: 'py.example',
+        orgId: 'org-py',
+      },
+      startingDate: '2024-01-01',
+      startingBalance: 500,
+    });
+
+    expect(result).toBe('ok');
+    const created = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['ext-py-1'],
+    );
+    expect(created).toMatchObject({
+      name: 'Card',
+      account_sync_source: 'pluggyai',
+    });
+    expect(await getTransferPayeeCount(created!.id)).toBe(1);
+    const syncArgs = vi.mocked(bankSync.syncAccount).mock.calls[0];
+    expect(syncArgs.slice(2, 7)).toEqual([
+      created!.id,
+      'ext-py-1',
+      'py.example',
+      '2024-01-01',
+      500,
+    ]);
+    expect(connection.send).toHaveBeenCalledWith('sync-event', {
+      type: 'success',
+      tables: ['transactions', 'accounts'],
+    });
+  });
+});
+
+describe('linkAkahuAccount', () => {
+  it('reports only transactions in the sync event', async () => {
+    await akahuLinkHandler({
+      externalAccount: {
+        balance: 0,
+        account_id: 'ext-ak-1',
+        name: 'Everyday',
+        institution: 'Akahu Bank',
+        orgDomain: 'ak.example',
+        orgId: 'org-ak',
+      },
+    });
+
+    const created = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['ext-ak-1'],
+    );
+    expect(created).toMatchObject({
+      name: 'Everyday',
+      account_sync_source: 'akahu',
+    });
+    expect(await getTransferPayeeCount(created!.id)).toBe(1);
+    expect(connection.send).toHaveBeenCalledWith('sync-event', {
+      type: 'success',
+      tables: ['transactions'],
+    });
+  });
+});
+
+describe('linkEnableBankingAccount', () => {
+  it('keys the bank on the account identifier and creates the account', async () => {
+    await enableBankingLinkHandler({
+      externalAccount: {
+        balance: 0,
+        account_id: 'ext-eb-1',
+        name: 'Main',
+        institution: 'EB Bank',
+      },
+    });
+
+    const bank = await getBankByBankId('ext-eb-1');
+    expect(bank?.name).toBe('EB Bank');
+
+    const created = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['ext-eb-1'],
+    );
+    expect(created).toMatchObject({
+      name: 'Main',
+      official_name: 'Main',
+      bank: bank?.id,
+      account_sync_source: 'enableBanking',
+    });
+    expect(await getTransferPayeeCount(created!.id)).toBe(1);
+    expect(connection.send).toHaveBeenCalledWith('sync-event', {
+      type: 'success',
+      tables: ['transactions', 'accounts'],
+    });
+  });
+});
