+describe('replaceExistingLink', () => {
+  const account = {
+    balance: 0,
+    institution: { name: 'GC Bank' },
+    account_id: 'ext-replace-1',
+    mask: '1234',
+    name: 'Checking',
+    official_name: 'Official Checking',
+  };
+
+  async function getHolder() {
+    return db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['ext-replace-1'],
+    );
+  }
+
+  it('moves the link to a new account and unlinks the previous holder', async () => {
+    await goCardlessLinkHandler({ requisitionId: 'req-r1', account });
+    const oldHolder = await getHolder();
+    vi.mocked(bankSync.syncAccount).mockClear();
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-r2',
+        account,
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    const newHolder = await getHolder();
+    expect(newHolder?.id).not.toBe(oldHolder!.id);
+    expect(newHolder?.bank).toBe((await getBankByBankId('req-r2'))?.id);
+
+    const unlinked = await getAccount(oldHolder!.id);
+    expect(unlinked).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      tombstone: 0,
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('moves the link into an existing account and unlinks the previous holder', async () => {
+    await goCardlessLinkHandler({ requisitionId: 'req-r3', account });
+    const oldHolder = await getHolder();
+    await insertExistingAccount('acct-target');
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-r4',
+        account,
+        upgradingId: 'acct-target',
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect((await getAccount('acct-target'))?.account_id).toBe('ext-replace-1');
+    expect((await getAccount(oldHolder!.id))?.account_id).toBeNull();
+  });
+
+  it('keeps a closed previous holder closed when it is unlinked', async () => {
+    await goCardlessLinkHandler({ requisitionId: 'req-r5', account });
+    const oldHolder = await getHolder();
+    await db.update('accounts', { id: oldHolder!.id, closed: 1 });
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-r6',
+        account,
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(await getAccount(oldHolder!.id)).toMatchObject({
+      closed: 1,
+      account_id: null,
+      bank: null,
+    });
+  });
+
+  it('still refuses to link into a closed account and leaves the previous holder linked', async () => {
+    await goCardlessLinkHandler({ requisitionId: 'req-r7', account });
+    const oldHolder = await getHolder();
+    await insertExistingAccount('acct-replace-closed');
+    await db.update('accounts', { id: 'acct-replace-closed', closed: 1 });
+    const before = await getAccount(oldHolder!.id);
+    vi.mocked(bankSync.syncAccount).mockClear();
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-r8',
+        account,
+        upgradingId: 'acct-replace-closed',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await getAccount(oldHolder!.id)).toEqual(before);
+    expect(await getAccount('acct-replace-closed')).toMatchObject({
+      account_id: null,
+    });
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('leaves the previous holder linked when the upgrade target does not exist', async () => {
+    await goCardlessLinkHandler({ requisitionId: 'req-r9', account });
+    const oldHolder = await getHolder();
+    const before = await getAccount(oldHolder!.id);
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-r10',
+        account,
+        upgradingId: 'acct-missing',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow('Account with ID acct-missing not found.');
+
+    expect(await getAccount(oldHolder!.id)).toEqual(before);
+  });
+
+  it('refuses when the flag is explicitly false', async () => {
+    await goCardlessLinkHandler({ requisitionId: 'req-r11', account });
+    const oldHolder = await getHolder();
+    const before = await getAccount(oldHolder!.id);
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-r12',
+        account,
+        replaceExistingLink: false,
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await getAccount(oldHolder!.id)).toEqual(before);
+  });
+
+  it('is an ordinary link when no other account holds the bank account', async () => {
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-r13',
+        account,
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect((await getHolder())?.bank).toBe(
+      (await getBankByBankId('req-r13'))?.id,
+    );
+  });
+});
