+describe('replacing an existing bank link', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'sfin-ext-1',
+    name: 'Checking',
+    institution: null,
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+    balance: 0,
+  };
+
+  beforeEach(async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      bank: null,
+      account_id: 'sfin-ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    await db.insertPayee({ name: '', transfer_acct: 'holder' });
+  });
+
+  it('links a new account and unlinks the account that held the bank account', async () => {
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    const holder = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['holder'],
+    );
+    expect(holder).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      tombstone: 0,
+      closed: 0,
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      expect.any(String),
+      'sfin-ext-1',
+      expect.anything(),
+      undefined,
+      undefined,
+      undefined,
+    );
+    const linked = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0 AND id != ?',
+      ['sfin-ext-1', 'holder'],
+    );
+    expect(linked?.account_sync_source).toBe('simpleFin');
+  });
+
+  it('links into the chosen account and unlinks the account that held the bank account', async () => {
+    await db.insertAccount({
+      id: 'target',
+      name: 'Target',
+      bank: null,
+      account_sync_source: null,
+    });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount,
+        upgradingId: 'target',
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(
+      await db.first<db.DbAccount>(
+        'SELECT account_id FROM accounts WHERE id = ?',
+        ['holder'],
+      ),
+    ).toMatchObject({ account_id: null });
+    expect(
+      await db.first<db.DbAccount>(
+        'SELECT account_id FROM accounts WHERE id = ?',
+        ['target'],
+      ),
+    ).toMatchObject({ account_id: 'sfin-ext-1' });
+  });
+
+  it('keeps the unlinked account open or closed as it was', async () => {
+    await db.update('accounts', { id: 'holder', closed: 1 });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({ account_id: null, closed: 1 });
+  });
+
+  it('keeps the existing link when the flag is not set', async () => {
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({
+      account_id: 'sfin-ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('links normally when no other account holds the bank account', async () => {
+    await db.update('accounts', {
+      id: 'holder',
+      account_id: null,
+      account_sync_source: null,
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('still refuses to link into a closed account', async () => {
+    await db.insertAccount({
+      id: 'closed',
+      name: 'Closed',
+      bank: null,
+      account_sync_source: null,
+    });
+    await db.update('accounts', { id: 'closed', closed: 1 });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount,
+        upgradingId: 'closed',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({
+      account_id: 'sfin-ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
