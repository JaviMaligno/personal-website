+// @ts-strict-ignore
+import * as asyncStorage from '#platform/server/asyncStorage';
+import * as connection from '#platform/server/connection';
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+const linkHandlers = {
+  goCardless: app.handlers['gocardless-accounts-link'],
+  simpleFin: app.handlers['simplefin-accounts-link'],
+  pluggyai: app.handlers['pluggyai-accounts-link'],
+  akahu: app.handlers['akahu-accounts-link'],
+  enableBanking: app.handlers['enablebanking-accounts-link'],
+};
+
+const syncResult = { added: [], updated: [], updatedPreview: [] };
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(asyncStorage.multiGet).mockResolvedValue({
+    'user-id': 'user-1',
+    'user-key': 'key-1',
+  });
+  vi.mocked(bankSync.syncAccount).mockResolvedValue(syncResult);
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+function externalAccount(overrides = {}) {
+  return {
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'Bank One',
+    orgDomain: 'bank.example',
+    orgId: 'org-1',
+    balance: 100,
+    ...overrides,
+  };
+}
+
+async function linkedAccount(accountId: string) {
+  return db.first<db.DbAccount>(
+    'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0',
+    [accountId],
+  );
+}
+
+async function transferPayeeFor(accountId: string) {
+  return db.first<{ transfer_acct: string; name: string }>(
+    'SELECT transfer_acct, name FROM payees WHERE transfer_acct = ? AND tombstone = 0',
+    [accountId],
+  );
+}
+
+function sentSuccessEvents() {
+  return vi
+    .mocked(connection.send)
+    .mock.calls.filter(
+      ([event, payload]) =>
+        event === 'sync-event' &&
+        'type' in payload &&
+        payload.type === 'success',
+    )
+    .map(([, payload]) => payload);
+}
+
+describe('linking a bank-sync account', () => {
+  it.each([
+    ['simpleFin', 'simpleFin'],
+    ['pluggyai', 'pluggyai'],
+    ['akahu', 'akahu'],
+    ['enableBanking', 'enableBanking'],
+  ] as const)(
+    'creates a %s account with its transfer payee and syncs it',
+    async (provider, syncSource) => {
+      const result = await linkHandlers[provider]({
+        externalAccount: externalAccount(),
+        offBudget: true,
+      });
+
+      expect(result).toBe('ok');
+
+      const acct = await linkedAccount('ext-1');
+      expect(acct).toMatchObject({
+        name: 'Checking',
+        official_name: 'Checking',
+        offbudget: 1,
+        account_sync_source: syncSource,
+      });
+      expect(acct.mask).toBeNull();
+      expect(await transferPayeeFor(acct.id)).toMatchObject({ name: '' });
+      expect(vi.mocked(bankSync.syncAccount).mock.calls[0][2]).toBe(acct.id);
+    },
+  );
+
+  it('creates a GoCardless account with its mask and official name', async () => {
+    const result = await linkHandlers.goCardless({
+      requisitionId: 'req-1',
+      account: {
+        account_id: 'ext-1',
+        mask: '1234',
+        name: 'Checking',
+        official_name: 'Checking Official',
+        institution: { name: 'Bank One' },
+        balance: 100,
+      },
+    });
+
+    expect(result).toBe('ok');
+    expect(await linkedAccount('ext-1')).toMatchObject({
+      mask: '1234',
+      name: 'Checking',
+      official_name: 'Checking Official',
+      account_sync_source: 'goCardless',
+    });
+  });
+
+  it.each([
+    [
+      'goCardless',
+      ['transactions', 'accounts'],
+      () =>
+        linkHandlers.goCardless({
+          requisitionId: 'req-1',
+          account: {
+            account_id: 'ext-1',
+            mask: '1234',
+            name: 'Checking',
+            official_name: 'Checking',
+            institution: 'Bank One',
+            balance: 100,
+          },
+        }),
+    ],
+    [
+      'simpleFin',
+      ['transactions', 'accounts'],
+      () => linkHandlers.simpleFin({ externalAccount: externalAccount() }),
+    ],
+    [
+      'pluggyai',
+      ['transactions', 'accounts'],
+      () => linkHandlers.pluggyai({ externalAccount: externalAccount() }),
+    ],
+    [
+      'akahu',
+      ['transactions'],
+      () => linkHandlers.akahu({ externalAccount: externalAccount() }),
+    ],
+    [
+      'enableBanking',
+      ['transactions', 'accounts'],
+      () => linkHandlers.enableBanking({ externalAccount: externalAccount() }),
+    ],
+  ])('reports the sync-event tables used by %s', async (_, tables, link) => {
+    await link();
+
+    expect(sentSuccessEvents()).toEqual([{ type: 'success', tables }]);
+  });
+
+  it('upgrades an existing account in place without creating a payee', async () => {
+    await db.insertAccount({
+      id: 'local-1',
+      name: 'Local Checking',
+      offbudget: 0,
+    });
+
+    const result = await linkHandlers.simpleFin({
+      externalAccount: externalAccount({ account_id: 'ext-9' }),
+      upgradingId: 'local-1',
+    });
+
+    expect(result).toBe('ok');
+    expect(await linkedAccount('ext-9')).toMatchObject({
+      id: 'local-1',
+      name: 'Local Checking',
+      account_sync_source: 'simpleFin',
+    });
+    expect(await transferPayeeFor('local-1')).toBeFalsy();
+    expect(vi.mocked(bankSync.syncAccount).mock.calls[0].slice(2, 4)).toEqual([
+      'local-1',
+      'ext-9',
+    ]);
+  });
+
+  it('throws when the account to upgrade does not exist', async () => {
+    await expect(
+      linkHandlers.akahu({
+        externalAccount: externalAccount(),
+        upgradingId: 'missing',
+      }),
+    ).rejects.toThrow('Account with ID missing not found.');
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
