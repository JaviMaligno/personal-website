+describe('linking into a closed account', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'sfin-ext-1',
+    name: 'Checking',
+    institution: null,
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+    balance: 0,
+  };
+  const closedError =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+  beforeEach(async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+    await db.insertAccount({
+      id: 'closed',
+      name: 'Closed',
+      bank: null,
+      account_sync_source: null,
+    });
+    await db.update('accounts', { id: 'closed', closed: 1 });
+  });
+
+  it('refuses to link a bank account and leaves the account unchanged', async () => {
+    const accountBefore = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['closed'],
+    );
+    const accountsBefore = await db.all('SELECT id FROM accounts');
+    const banksBefore = await db.all('SELECT id FROM banks');
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'closed' }),
+    ).rejects.toThrow(closedError);
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'closed',
+      ]),
+    ).toEqual(accountBefore);
+    expect(await db.all('SELECT id FROM accounts')).toEqual(accountsBefore);
+    expect(await db.all('SELECT id FROM banks')).toEqual(banksBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to re-link the closed account that already holds the link', async () => {
+    await db.update('accounts', {
+      id: 'closed',
+      account_id: 'sfin-ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'closed' }),
+    ).rejects.toThrow(closedError);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows linking once the account is reopened', async () => {
+    await db.update('accounts', { id: 'closed', closed: 0 });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'closed' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
+
