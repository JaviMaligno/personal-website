 });
+
+describe('replacing an existing link', () => {
+  it('moves the bank account to a new account and unlinks the holder', async () => {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      offbudget: 0,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      balance_current: 50,
+    });
+
+    const result = await linkHandlers.simpleFin({
+      externalAccount: externalAccount(),
+      replaceExistingLink: true,
+    });
+
+    expect(result).toBe('ok');
+    const newAcct = await linkedAccount('ext-1');
+    expect(newAcct).toMatchObject({
+      name: 'Checking',
+      account_sync_source: 'simpleFin',
+    });
+    expect(newAcct.id).not.toBe('holder');
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({
+      name: 'Holder',
+      tombstone: 0,
+      account_id: null,
+      bank: null,
+      balance_current: null,
+      account_sync_source: null,
+      bank_sync_status: null,
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+    expect(vi.mocked(bankSync.syncAccount).mock.calls[0][2]).toBe(newAcct.id);
+  });
+
+  it('moves the bank account into an existing account and unlinks the holder', async () => {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      offbudget: 0,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    await db.insertAccount({ id: 'local-1', name: 'Local', offbudget: 0 });
+
+    const result = await linkHandlers.simpleFin({
+      externalAccount: externalAccount(),
+      upgradingId: 'local-1',
+      replaceExistingLink: true,
+    });
+
+    expect(result).toBe('ok');
+    expect(await linkedAccount('ext-1')).toMatchObject({
+      id: 'local-1',
+      account_sync_source: 'simpleFin',
+    });
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({ account_id: null, account_sync_source: null });
+  });
+
+  it('keeps the holder closed when it is unlinked', async () => {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      offbudget: 0,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+
+    await linkHandlers.simpleFin({
+      externalAccount: externalAccount(),
+      replaceExistingLink: true,
+    });
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({ closed: 1, account_sync_source: null });
+  });
+
+  it('links normally when no other account holds the bank account', async () => {
+    const result = await linkHandlers.simpleFin({
+      externalAccount: externalAccount(),
+      replaceExistingLink: true,
+    });
+
+    expect(result).toBe('ok');
+    expect(await linkedAccount('ext-1')).toMatchObject({
+      account_sync_source: 'simpleFin',
+    });
+  });
+
+  it('still refuses to link into a closed account', async () => {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      offbudget: 0,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    await db.insertAccount({
+      id: 'closed-1',
+      name: 'Old Savings',
+      offbudget: 0,
+      closed: 1,
+    });
+
+    await expect(
+      linkHandlers.simpleFin({
+        externalAccount: externalAccount(),
+        upgradingId: 'closed-1',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({ account_id: 'ext-1', account_sync_source: 'simpleFin' });
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
