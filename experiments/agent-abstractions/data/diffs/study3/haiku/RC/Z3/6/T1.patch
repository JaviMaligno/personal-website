+export async function assertBankAccountNotLinkedElsewhere({
+  accountSyncSource,
+  providerAccountId,
+  accountId,
+}: {
+  accountSyncSource: AccountSyncSource;
+  providerAccountId: string;
+  accountId: db.DbAccount['id'] | undefined;
+}) {
+  const existing = await db.first<Pick<db.DbAccount, 'id'>>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND id IS NOT ? AND tombstone = 0`,
+    [accountSyncSource, providerAccountId, accountId ?? null],
+  );
+
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
