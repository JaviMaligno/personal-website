+import { assertBankAccountNotLinkedElsewhere, findOrCreateBank } from './link';
 
 beforeEach(async () => {
   await global.emptyDatabase()();
   await loadMappings();
 });
 
+async function insertAccount(fields: {
+  id: string;
+  account_id: string;
+  account_sync_source: 'simpleFin' | 'goCardless';
+  closed?: 1 | 0;
+  tombstone?: 1 | 0;
+}) {
+  await db.insertWithUUID('accounts', {
+    name: fields.id,
+    offbudget: 0,
+    closed: fields.closed ?? 0,
+    tombstone: fields.tombstone ?? 0,
+    sort_order: 0,
+    ...fields,
+  });
+}
+
+describe('assertBankAccountNotLinkedElsewhere', () => {
+  it('refuses a bank account already linked to another account', async () => {
+    await insertAccount({
+      id: 'acct-1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      assertBankAccountNotLinkedElsewhere({
+        accountSyncSource: 'simpleFin',
+        providerAccountId: 'ext-1',
+        accountId: undefined,
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows re-linking into the account that already holds the link', async () => {
+    await insertAccount({
+      id: 'acct-1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      assertBankAccountNotLinkedElsewhere({
+        accountSyncSource: 'simpleFin',
+        providerAccountId: 'ext-1',
+        accountId: 'acct-1',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('refuses linking into a different account when another account holds the link', async () => {
+    await insertAccount({
+      id: 'acct-1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    await insertAccount({
+      id: 'acct-2',
+      account_id: 'ext-2',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      assertBankAccountNotLinkedElsewhere({
+        accountSyncSource: 'simpleFin',
+        providerAccountId: 'ext-1',
+        accountId: 'acct-2',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('still counts closed accounts as holding the link', async () => {
+    await insertAccount({
+      id: 'acct-1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+
+    await expect(
+      assertBankAccountNotLinkedElsewhere({
+        accountSyncSource: 'simpleFin',
+        providerAccountId: 'ext-1',
+        accountId: undefined,
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('ignores deleted accounts', async () => {
+    await insertAccount({
+      id: 'acct-1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      tombstone: 1,
+    });
+
+    await expect(
+      assertBankAccountNotLinkedElsewhere({
+        accountSyncSource: 'simpleFin',
+        providerAccountId: 'ext-1',
+        accountId: undefined,
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('treats the same provider account id under a different provider as a different bank account', async () => {
+    await insertAccount({
+      id: 'acct-1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      assertBankAccountNotLinkedElsewhere({
+        accountSyncSource: 'goCardless',
+        providerAccountId: 'ext-1',
+        accountId: undefined,
+      }),
+    ).resolves.toBeUndefined();
+  });
+});
