+describe('linking a Fintegra account', () => {
+  const fintegraLinkHandler = app.handlers['fintegra-accounts-link'];
+  const externalAccount = {
+    account_id: 'fin-ext-1',
+    name: 'Everyday',
+    institution: 'Test Bank',
+    orgId: 'org-1',
+    balance: 1000,
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a Fintegra-synced account and runs the initial import', async () => {
+    await expect(
+      fintegraLinkHandler({
+        externalAccount,
+        startingDate: '2024-01-01',
+        startingBalance: 5000,
+      }),
+    ).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['fin-ext-1'],
+    );
+    expect(account).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      account_sync_source: 'fintegra',
+      offbudget: 0,
+    });
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account!.bank,
+    ]);
+    expect(bank).toMatchObject({ bank_id: 'org-1', name: 'Test Bank' });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      account!.id,
+      'fin-ext-1',
+      'org-1',
+      '2024-01-01',
+      5000,
+      undefined,
+    );
+  });
+
+  it('creates an off-budget account when requested', async () => {
+    await fintegraLinkHandler({ externalAccount, offBudget: true });
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['fin-ext-1'],
+    );
+    expect(account!.offbudget).toBe(1);
+  });
+
+  it('shares one bank between accounts of the same organisation and institution', async () => {
+    await fintegraLinkHandler({ externalAccount });
+    await fintegraLinkHandler({
+      externalAccount: { ...externalAccount, account_id: 'fin-ext-2' },
+    });
+
+    const banks = await db.all<db.DbBank>('SELECT * FROM banks');
+    expect(banks).toHaveLength(1);
+  });
+
+  it('refuses to link an account already held by another local account', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing',
+      bank: null,
+      account_id: 'fin-ext-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(fintegraLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
