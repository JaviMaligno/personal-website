 });
+
+describe('linking a bank account that is already linked', () => {
+  const linkSimpleFinAccountHandler = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    balance: 0,
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    orgId: 'org-1',
+  };
+  const alreadyLinkedMessage =
+    'This bank account is already linked to another account.';
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses to link a new account to a bank account that is already linked', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      linkSimpleFinAccountHandler({ externalAccount }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    const accounts = await db.all<db.DbAccount>('SELECT * FROM accounts');
+    expect(accounts.map(a => a.id)).toEqual(['acct1']);
+    const payees = await db.all<db.DbPayee>(
+      'SELECT * FROM payees WHERE transfer_acct IS NOT NULL',
+    );
+    expect(payees).toEqual([]);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link an existing account to a bank account linked to another account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      linkSimpleFinAccountHandler({
+        externalAccount,
+        upgradingId: 'acct2',
+      }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(account!.account_id).toBeNull();
+    expect(account!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link is on a closed account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      linkSimpleFinAccountHandler({ externalAccount }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+  });
+
+  it('allows linking when the existing link is on a deleted account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', ['acct1']);
+
+    await expect(
+      linkSimpleFinAccountHandler({ externalAccount }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    insertBank({ id: 'bank2', bank_id: 'gc-bank', name: 'GoCardless' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      bank: 'bank2',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(
+      linkSimpleFinAccountHandler({ externalAccount }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows re-linking a bank account into the account that already holds it', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      linkSimpleFinAccountHandler({
+        externalAccount,
+        upgradingId: 'acct1',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
