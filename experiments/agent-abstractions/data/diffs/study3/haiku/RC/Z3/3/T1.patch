index 1272506..d417c11 100644
--- a/packages/loot-core/src/server/accounts/app-link.test.ts
+++ b/packages/loot-core/src/server/accounts/app-link.test.ts
@@ -200,3 +200,104 @@ describe('linking a bank-sync account', () => {
     expect(bankSync.syncAccount).not.toHaveBeenCalled();
   });
 });
+
+describe('linking a bank account that is already linked', () => {
+  const alreadyLinkedMessage =
+    'This bank account is already linked to another account.';
+
+  async function insertLinkedAccount(overrides = {}) {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Holder',
+      offbudget: 0,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      ...overrides,
+    });
+  }
+
+  async function countRows(table: 'accounts' | 'banks' | 'payees') {
+    const row = await db.first<{ count: number }>(
+      `SELECT count(*) as count FROM ${table}`,
+    );
+    return row.count;
+  }
+
+  it('refuses a new account for an already linked bank account', async () => {
+    await insertLinkedAccount();
+    const accountsBefore = await countRows('accounts');
+    const banksBefore = await countRows('banks');
+    const payeesBefore = await countRows('payees');
+
+    await expect(
+      linkHandlers.simpleFin({ externalAccount: externalAccount() }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('banks')).toBe(banksBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(sentSuccessEvents()).toEqual([]);
+  });
+
+  it('refuses upgrading another account into an already linked bank account', async () => {
+    await insertLinkedAccount();
+    await db.insertAccount({ id: 'local-2', name: 'Local', offbudget: 0 });
+
+    await expect(
+      linkHandlers.simpleFin({
+        externalAccount: externalAccount(),
+        upgradingId: 'local-2',
+      }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    expect(
+      await db.first('SELECT * FROM accounts WHERE id = ?', ['local-2']),
+    ).toMatchObject({
+      name: 'Local',
+      account_id: null,
+      account_sync_source: null,
+    });
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows re-linking into the account that already holds the link', async () => {
+    await insertLinkedAccount();
+
+    const result = await linkHandlers.simpleFin({
+      externalAccount: externalAccount(),
+      upgradingId: 'holder',
+    });
+
+    expect(result).toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('still refuses when the holding account is closed', async () => {
+    await insertLinkedAccount({ closed: 1 });
+
+    await expect(
+      linkHandlers.simpleFin({ externalAccount: externalAccount() }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+  });
+
+  it('allows linking when the holding account is deleted', async () => {
+    await insertLinkedAccount({ tombstone: 1 });
+
+    const result = await linkHandlers.simpleFin({
+      externalAccount: externalAccount(),
+    });
+
+    expect(result).toBe('ok');
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await insertLinkedAccount({ account_sync_source: 'pluggyai' });
+
+    const result = await linkHandlers.simpleFin({
+      externalAccount: externalAccount(),
+    });
+
+    expect(result).toBe('ok');
+  });
+});
