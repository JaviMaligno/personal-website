     expect(result.errors).toEqual([]);
   });
 });
+
+describe('simplefin-accounts-link duplicate detection', () => {
+  const linkSimpleFin = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    balance: 100,
+    institution: 'Bank',
+    orgId: 'org-1',
+  };
+
+  function linkParams(extra = {}) {
+    return { externalAccount, ...extra };
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+    } as never);
+  });
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'ext-1' },
+    ]);
+
+    await expect(linkSimpleFin(linkParams())).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const count = db.runQuery('SELECT id FROM accounts', [], true);
+    expect(count).toHaveLength(1);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another existing account when it is linked elsewhere', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'ext-1' },
+      { id: 'target', name: 'Target', accountId: null },
+    ]);
+
+    await expect(
+      linkSimpleFin(linkParams({ upgradingId: 'target' })),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const target = db.runQuery<{ account_id: string | null }>(
+      'SELECT account_id FROM accounts WHERE id = ?',
+      ['target'],
+      true,
+    );
+    expect(target[0].account_id).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('still refuses when the existing link is on a closed account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['existing']);
+
+    await expect(linkSimpleFin(linkParams())).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the existing link belongs to a deleted account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'deleted', name: 'Deleted', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', ['deleted']);
+
+    await expect(linkSimpleFin(linkParams())).resolves.toBe('ok');
+  });
+
+  it('allows the same provider account id under a different provider', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'ext-1' },
+    ]);
+    db.runQuery(
+      "UPDATE accounts SET account_sync_source = 'goCardless' WHERE id = ?",
+      ['existing'],
+    );
+
+    await expect(linkSimpleFin(linkParams())).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      linkSimpleFin(linkParams({ upgradingId: 'existing' })),
+    ).resolves.toBe('ok');
+  });
+});
