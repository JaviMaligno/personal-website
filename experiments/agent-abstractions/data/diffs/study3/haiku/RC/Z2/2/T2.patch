@@ -0,0 +1,55 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(
+  overrides: Pick<ScheduleEntity, '_amount' | '_amountOp'> &
+    Partial<ScheduleEntity>,
+): ScheduleEntity {
+  return {
+    id: 'schedule-1',
+    name: 'Test',
+    rule: 'rule-1',
+    next_date: '2026-01-01',
+    completed: false,
+    posts_transaction: false,
+    tombstone: false,
+    _payee: 'payee-1',
+    _account: 'account-1',
+    _date: '2026-01-01',
+    _conditions: [],
+    _actions: [],
+    ...overrides,
+  };
+}
+
+describe('scheduleModel.toExternal expectedAmount', () => {
+  it('uses the single amount as expectedAmount', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule({ _amount: -5000, _amountOp: 'is' }),
+    );
+    expect(result.amount).toBe(-5000);
+    expect(result.expectedAmount).toBe(-5000);
+  });
+
+  it('uses the end of the range furthest from zero', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule({
+        _amount: { num1: -10100, num2: -20000 },
+        _amountOp: 'isbetween',
+      }),
+    );
+    expect(result.amount).toEqual({ num1: -10100, num2: -20000 });
+    expect(result.expectedAmount).toBe(-20000);
+  });
+
+  it('gives 0 when the schedule has no amount', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule({
+        _amount: null as unknown as ScheduleEntity['_amount'],
+        _amountOp: 'is',
+      }),
+    );
+    expect(result.expectedAmount).toBe(0);
+  });
+});
