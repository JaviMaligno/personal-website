--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,47 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(
+  overrides: Pick<ScheduleEntity, '_amount' | '_amountOp'>,
+): ScheduleEntity {
+  return {
+    id: 'schedule-1',
+    name: 'Rent',
+    rule: 'rule-1',
+    next_date: '2026-11-01',
+    completed: false,
+    posts_transaction: true,
+    tombstone: false,
+    _payee: 'payee-1',
+    _account: 'account-1',
+    _date: '2026-11-01',
+    _conditions: [],
+    _actions: [],
+    ...overrides,
+  };
+}
+
+describe('scheduleModel.toExternal', () => {
+  it('keeps a single amount as the expected amount', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule({ _amount: -5000, _amountOp: 'is' }),
+    );
+
+    expect(result.amount).toBe(-5000);
+    expect(result.amountOp).toBe('is');
+    expect(result.expectedAmount).toBe(-5000);
+  });
+
+  it('uses the end of a ranged amount furthest from zero', () => {
+    const result = scheduleModel.toExternal(
+      makeSchedule({
+        _amount: { num1: -10100, num2: -20000 },
+        _amountOp: 'isbetween',
+      }),
+    );
+
+    expect(result.amount).toEqual({ num1: -10100, num2: -20000 });
+    expect(result.expectedAmount).toBe(-20000);
+  });
+});
