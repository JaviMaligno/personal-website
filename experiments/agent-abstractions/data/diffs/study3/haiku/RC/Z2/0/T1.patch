+
+  describe('getRangeWorstCase', () => {
+    it('returns the end furthest from zero for a negative range', () => {
+      expect(getRangeWorstCase({ num1: -101, num2: -200 })).toBe(-200);
+      expect(getRangeWorstCase({ num1: -200, num2: -101 })).toBe(-200);
+    });
+
+    it('returns the end furthest from zero for a positive range', () => {
+      expect(getRangeWorstCase({ num1: 101, num2: 200 })).toBe(200);
+      expect(getRangeWorstCase({ num1: 200, num2: 101 })).toBe(200);
+    });
+
+    it('returns the end furthest from zero when the range spans zero', () => {
+      expect(getRangeWorstCase({ num1: -50, num2: 120 })).toBe(120);
+      expect(getRangeWorstCase({ num1: 50, num2: -120 })).toBe(-120);
+    });
+  });
+
+  describe('getScheduledAmount', () => {
+    it('uses the single amount as-is', () => {
+      expect(getScheduledAmount(-1000)).toBe(-1000);
+      expect(getScheduledAmount(-1000, true)).toBe(1000);
+    });
+
+    it('returns 0 when there is no amount', () => {
+      expect(getScheduledAmount(null)).toBe(0);
+    });
+
+    it('plans a ranged expense at the end furthest from zero', () => {
+      expect(getScheduledAmount({ num1: -10100, num2: -20000 })).toBe(-20000);
+      expect(getScheduledAmount({ num1: -20000, num2: -10100 })).toBe(-20000);
+    });
+
+    it('plans a ranged income at the end furthest from zero', () => {
+      expect(getScheduledAmount({ num1: 10100, num2: 20000 })).toBe(20000);
+      expect(getScheduledAmount({ num1: 20000, num2: 10100 })).toBe(20000);
+    });
+
+    it('inverts the worst-case amount when requested', () => {
+      expect(getScheduledAmount({ num1: -10100, num2: -20000 }, true)).toBe(
+        20000,
+      );
+    });
+  });
 });
