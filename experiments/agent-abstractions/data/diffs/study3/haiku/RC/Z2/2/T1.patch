+describe('getScheduledAmount', () => {
+  it('returns a single amount unchanged', () => {
+    expect(getScheduledAmount(-5000)).toBe(-5000);
+    expect(getScheduledAmount(-5000, true)).toBe(5000);
+  });
+
+  it('expects the end of a range furthest from zero for bills', () => {
+    expect(getScheduledAmount({ num1: -10100, num2: -20000 })).toBe(-20000);
+    expect(getScheduledAmount({ num1: -20000, num2: -10100 })).toBe(-20000);
+  });
+
+  it('expects the end of a range furthest from zero for income', () => {
+    expect(getScheduledAmount({ num1: 10100, num2: 20000 })).toBe(20000);
+    expect(getScheduledAmount({ num1: 20000, num2: 10100 })).toBe(20000);
+  });
+
+  it('uses the furthest end when the range spans zero', () => {
+    expect(getScheduledAmount({ num1: -3000, num2: 1000 })).toBe(-3000);
+    expect(getScheduledAmount({ num1: 1000, num2: -3000 })).toBe(-3000);
+  });
+
+  it('inverts the worst-case amount when requested', () => {
+    expect(getScheduledAmount({ num1: -10100, num2: -20000 }, true)).toBe(
+      20000,
+    );
+  });
+});
