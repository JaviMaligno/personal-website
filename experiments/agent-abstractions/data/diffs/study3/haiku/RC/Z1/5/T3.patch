+async function getFixedCostCategoryIds(): Promise<Set<string>> {
+  const rows = await db.all<{ id: string; note: string }>(`
+    SELECT c.id, n.note
+    FROM categories c
+    JOIN category_groups g ON c.cat_group = g.id
+    JOIN notes n ON n.id = g.id
+    WHERE c.tombstone = 0 AND g.tombstone = 0 AND n.note LIKE '%#fixed%'
+  `);
