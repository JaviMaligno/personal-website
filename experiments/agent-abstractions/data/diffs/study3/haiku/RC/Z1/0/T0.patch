+// Which categories a month-wide action writes. Income categories are only written
+// in tracking budgets. Hidden categories and categories in hidden groups are skipped
+// unless includeHidden is set.
+type MonthWideCategory = {
+  is_income: 0 | 1;
+  hidden: 0 | 1;
+  group_hidden?: 0 | 1 | null;
+};
+
+function isMonthWideCategory(
+  cat: MonthWideCategory,
+  { includeHidden }: { includeHidden: boolean },
+): boolean {
+  if (cat.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+  return includeHidden || (cat.hidden !== 1 && cat.group_hidden !== 1);
+}
+
+// Spending is stored as negative amounts but budgeted expenses are positive.
+function averageToBudgetAmount(
+  average: number,
+  cat: Pick<MonthWideCategory, 'is_income'>,
+): number {
+  return cat.is_income === 0 ? average * -1 : average;
+}
+
+// An inner join drops categories whose group row is missing, which averages never write.
+async function getAverageCategories(): Promise<
+  (MonthWideCategory & { id: string })[]
+> {
+  return db.all<MonthWideCategory & { id: string }>(`
+    SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+    FROM categories c
+    INNER JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+  `);
+}
