+describe('setZero', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves hidden categories, hidden groups and template-managed categories untouched', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'visible',
+      name: 'visible',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'in-hidden-group',
+      name: 'in-hidden-group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'templated',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.updateWithSchema('categories', {
+      id: 'templated',
+      goal_def: JSON.stringify([{ type: 'simple', monthly: 100, limit: null }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+
+    for (const id of [
+      'visible',
+      'hidden-cat',
+      'in-hidden-group',
+      'templated',
+    ]) {
+      await setBudget({ category: id, month: '2024-01', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'visible', month: '2024-01' })).toBe(0);
+    expect(getBudget({ category: 'hidden-cat', month: '2024-01' })).toBe(500);
+    expect(getBudget({ category: 'in-hidden-group', month: '2024-01' })).toBe(
+      500,
+    );
+    expect(getBudget({ category: 'templated', month: '2024-01' })).toBe(500);
+  });
+});
