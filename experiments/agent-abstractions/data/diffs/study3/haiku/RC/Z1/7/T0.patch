+type MonthAction = 'copy' | 'zero' | 'average';
+
+type CategoryFlags = {
+  is_income: 1 | 0;
+  hidden: 1 | 0;
+  group_hidden: 1 | 0;
+};
+
+// The single definition of which categories a month-wide action writes.
+// Copy keeps categories without a group, while average requires one.
+function isWrittenByMonthAction(
+  category: CategoryFlags,
+  action: MonthAction,
+  isTracking: boolean,
+): boolean {
+  if (category.is_income === 1 && !isTracking) {
+    return false;
+  }
+  if (action === 'copy') {
+    return category.hidden !== 1 && category.group_hidden !== 1;
+  }
+  if (action === 'average') {
+    return category.hidden === 0 && category.group_hidden === 0;
+  }
+  return true;
+}
+
+// Spending is negative in the sheet, so expense averages are budgeted as positive amounts.
+function toAverageBudgetAmount(
+  average: number,
+  category: Pick<CategoryFlags, 'is_income'>,
+): number {
+  return category.is_income === 0 ? average * -1 : average;
+}
+
+function getCategoriesWithGroupHidden(): Promise<
+  (CategoryFlags & { id: string })[]
+> {
+  return db.all<CategoryFlags & { id: string }>(`
+    SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+  `);
+}
+
