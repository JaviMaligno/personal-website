+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getMonthFillCategories('visible');
+  const prevSheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const spent = await getSheetValue(prevSheetName, 'sum-amount-' + cat.id);
+
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudgetAmount(cat, spent),
+      });
+    }
+  });
+}
