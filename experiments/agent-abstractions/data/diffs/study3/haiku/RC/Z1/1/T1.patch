+describe('month-wide budget actions', () => {
+  let originalCurrentMonth: string | null;
+
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    originalCurrentMonth = global.currentMonth;
+    global.currentMonth = '2024-05';
+    await setupMonthWideDatabase();
+  });
+
+  afterEach(async () => {
+    global.currentMonth = originalCurrentMonth;
+    await global.emptyDatabase()();
+  });
+
+  async function setupMonthWideDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat1',
+      name: 'cat1',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'cat-hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'cat-in-hidden-group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-template',
+      name: 'cat-template',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    db.runQuery('UPDATE categories SET goal_def = ? WHERE id = ?', [
+      JSON.stringify([{ type: 'fixed', amount: 10000 }]),
+      'cat-template',
+    ]);
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02', '2024-03', '2024-04']);
+  }
+
+  const skippedCategories = [
+    'cat-hidden',
+    'cat-in-hidden-group',
+    'cat-template',
+  ];
+
+  it('setZero leaves hidden and template categories untouched', async () => {
+    for (const category of ['cat1', ...skippedCategories]) {
+      await setBudget({ category, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(0);
+    for (const category of skippedCategories) {
+      expect(await getSheetValue('budget202402', `budget-${category}`)).toBe(
+        500,
+      );
+    }
+  });
+
+  it('copyPreviousMonth leaves hidden and template categories untouched', async () => {
+    for (const category of ['cat1', ...skippedCategories]) {
+      await setBudget({ category, month: '2024-01', amount: 700 });
+      await setBudget({ category, month: '2024-02', amount: 200 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(700);
+    for (const category of skippedCategories) {
+      expect(await getSheetValue('budget202402', `budget-${category}`)).toBe(
+        200,
+      );
+    }
+  });
+
+  it('set3MonthAvg leaves hidden and template categories untouched', async () => {
+    for (const category of ['cat1', ...skippedCategories]) {
+      await db.insertTransaction({
+        date: '2024-03-15',
+        amount: -300,
+        account: 'account1',
+        category,
+      });
+      await setBudget({ category, month: '2024-04', amount: 900 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(300);
+    for (const category of skippedCategories) {
+      expect(await getSheetValue('budget202404', `budget-${category}`)).toBe(
+        900,
+      );
+    }
+  });
+});
