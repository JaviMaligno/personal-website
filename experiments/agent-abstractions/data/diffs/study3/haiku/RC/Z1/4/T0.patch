+// Which categories a month-wide action writes. The income rule is shared by
+// all of them; each action picks how hidden categories are treated.
+type MonthFillCategory = {
+  is_income: number;
+  hidden: number | null;
+  group_hidden: number | null;
+};
+
+type MonthFillRules = {
+  includeHidden: boolean;
+  // Averages have always skipped categories with no group (or no hidden
+  // flag), while copying has not, so the two must stay distinguishable.
+  unknownVisibilityIsHidden: boolean;
+};
+
+const SET_ZERO_RULES: MonthFillRules = {
+  includeHidden: true,
+  unknownVisibilityIsHidden: false,
+};
+
+const COPY_RULES: MonthFillRules = {
+  includeHidden: false,
+  unknownVisibilityIsHidden: false,
+};
+
+const AVERAGE_RULES: MonthFillRules = {
+  includeHidden: false,
+  unknownVisibilityIsHidden: true,
+};
+
+function isMonthFillCategory(
+  category: MonthFillCategory,
+  rules: MonthFillRules,
+): boolean {
+  if (category.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+  if (rules.includeHidden) {
+    return true;
+  }
+  const isHiddenFlag = (flag: number | null) =>
+    rules.unknownVisibilityIsHidden ? flag !== 0 : flag === 1;
+  return !isHiddenFlag(category.hidden) && !isHiddenFlag(category.group_hidden);
+}
+
+async function getMonthFillCategories(
+  rules: MonthFillRules,
+): Promise<Array<{ id: string } & MonthFillCategory>> {
+  const categories = await db.all<{ id: string } & MonthFillCategory>(`
+    SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+  `);
+  return categories.filter(cat => isMonthFillCategory(cat, rules));
+}
+
+// Spending is stored as negative, so a budgeted expense is the inverse of its average.
+function averageToBudget(average: number, isIncome: number): number {
+  return isIncome === 0 ? -average : average;
+}
