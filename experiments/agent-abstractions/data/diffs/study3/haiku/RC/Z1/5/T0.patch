+type MonthFillCategory = {
+  id: string;
+  is_income: number;
+  hidden: number;
+  group_hidden: number | null;
+};
+
+// 'visibleOrUngrouped' keeps categories with no group row, as copying the previous month always has.
+type MonthFillScope = 'all' | 'visible' | 'visibleOrUngrouped';
+
+function isMonthFillCategory(
+  category: Omit<MonthFillCategory, 'id'>,
+  scope: MonthFillScope,
+): boolean {
+  if (category.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+  if (scope === 'all') {
+    return true;
+  }
+  if (scope === 'visible') {
+    return category.hidden === 0 && category.group_hidden === 0;
+  }
+  return category.hidden !== 1 && category.group_hidden !== 1;
+}
+
+async function getMonthFillCategories(
+  scope: MonthFillScope,
+): Promise<MonthFillCategory[]> {
+  const categories = await db.all<MonthFillCategory>(`
+    SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+  `);
+  return categories.filter(category => isMonthFillCategory(category, scope));
+}
+
+// Averages are spending (negative), so expense categories are budgeted as their positive counterpart.
+function averageToBudgetAmount(
+  category: Pick<MonthFillCategory, 'is_income'>,
+  average: number,
+): number {
+  return category.is_income === 0 ? -average : average;
+}
