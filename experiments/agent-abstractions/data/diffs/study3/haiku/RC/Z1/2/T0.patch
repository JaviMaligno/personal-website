+// Which categories a month-wide action fills. Income categories are only filled
+// in tracking budgets. 'copyable' differs from 'visible' only for categories with
+// no group row: copying keeps them, averaging skips them.
+type MonthFillScope = 'all' | 'visible' | 'copyable';
+
+type MonthFillCategory = {
+  is_income: 1 | 0;
+  hidden: 1 | 0;
+  group_hidden: 1 | 0 | null;
+};
+
+function isMonthFillCategory(
+  cat: MonthFillCategory,
+  scope: MonthFillScope,
+): boolean {
+  if (cat.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+  if (scope === 'all') {
+    return true;
+  }
+  if (scope === 'visible') {
+    return cat.hidden === 0 && cat.group_hidden === 0;
+  }
+  return cat.hidden !== 1 && cat.group_hidden !== 1;
+}
+
+async function getMonthFillCategories(scope: MonthFillScope) {
+  const categories = await db.all<{ id: string } & MonthFillCategory>(`
+    SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+  `);
+  return categories.filter(cat => isMonthFillCategory(cat, scope));
+}
+
+// Spending is stored as negative, so an expense's average is flipped to a
+// positive amount to budget. Income is already positive.
+function toBudgetedAverage(average: number, cat: { is_income: 1 | 0 }): number {
+  return cat.is_income === 0 ? average * -1 : average;
+}
