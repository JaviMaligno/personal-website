+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(1000);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-hidden-group'),
+    ).toBe(1000);
+    expect(await getSheetValue('budget202404', 'budget-template-cat')).toBe(
+      1000,
+    );
+  });
+
+  it('set3MonthAvg skips hidden categories and categories with a template', async () => {
+    await set3MonthAvg({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(300);
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(1000);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-hidden-group'),
+    ).toBe(1000);
+    expect(await getSheetValue('budget202404', 'budget-template-cat')).toBe(
+      1000,
+    );
+  });
+});
