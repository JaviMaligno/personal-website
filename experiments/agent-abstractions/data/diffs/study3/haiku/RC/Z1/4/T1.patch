+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'cat-in-hidden-group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'template-cat',
+      name: 'template-cat',
+      cat_group: 'group1',
+    });
+    await db.update('categories', {
+      id: 'template-cat',
+      goal_def: JSON.stringify([{ name: 'template', type: 'fixed' }]),
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-02', '2024-03', '2024-04']);
+
+    await db.insertTransaction({
+      date: '2024-03-15',
+      amount: -300,
+      account: 'account1',
+      category: 'cat1',
+    });
+
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'cat-in-hidden-group',
+      'template-cat',
+    ]) {
+      await setBudget({ category, month: '2024-03', amount: 500 });
