+      'hidden-cat',
+      'hidden-group-cat',
+      'template-cat',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'cat1', month: '2024-02' })).toBe(0);
+    expect(getBudget({ category: 'hidden-cat', month: '2024-02' })).toBe(500);
+    expect(getBudget({ category: 'hidden-group-cat', month: '2024-02' })).toBe(
