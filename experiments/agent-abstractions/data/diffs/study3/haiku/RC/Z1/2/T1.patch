+    );
+    expect(getBudget({ category: 'template-cat', month: '2024-02' })).toBe(500);
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and template categories untouched', async () => {
+    await setupDatabase();
+
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'hidden-group-cat',
+      'template-cat',
