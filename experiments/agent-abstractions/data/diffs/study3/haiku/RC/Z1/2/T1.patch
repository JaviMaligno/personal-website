+    await budget.createBudget(['2024-01', '2024-02', '2024-03']);
+  }
+
+  it('setZero leaves hidden, hidden-group and template categories untouched', async () => {
+    await setupDatabase();
+
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'hidden-group-cat',
+      'template-cat',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'cat1', month: '2024-02' })).toBe(0);
