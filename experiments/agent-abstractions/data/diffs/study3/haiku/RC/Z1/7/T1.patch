--- a/packages/loot-core/src/server/budget/actions.test.ts
+++ b/packages/loot-core/src/server/budget/actions.test.ts
@@ -5,16 +5,135 @@ import * as db from '#server/db';
 import * as sheet from '#server/sheet';
 
 import {
+  copyPreviousMonth,
   copyUntilYearEnd,
   coverOverbudgeted,
+  getBudget,
   getSheetValue,
   set3MonthAvg,
   setBudget,
   setCategoryCarryover,
   setNMonthAvg,
+  setZero,
 } from './actions';
 import * as budget from './base';
 
+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'visible-cat',
+      name: 'visible',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'hidden-group-cat',
+      name: 'in hidden group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'template-cat',
+      name: 'templated',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.update('categories', {
+      id: 'template-cat',
+      goal_def: JSON.stringify([{ type: 'fixed', amount: 100 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  const protectedCategories = [
+    'hidden-cat',
+    'hidden-group-cat',
+    'template-cat',
+  ];
+
+  it('setZero clears only categories that are not hidden or template-managed', async () => {
+    await setupDatabase();
+    for (const category of ['visible-cat', ...protectedCategories]) {
+      await setBudget({ category, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'visible-cat', month: '2024-02' })).toBe(0);
+    for (const category of protectedCategories) {
+      expect(getBudget({ category, month: '2024-02' })).toBe(500);
+    }
+  });
+
+  it('copyPreviousMonth skips hidden and template-managed categories', async () => {
+    await setupDatabase();
+    for (const category of ['visible-cat', ...protectedCategories]) {
+      await setBudget({ category, month: '2024-01', amount: 700 });
+      await setBudget({ category, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'visible-cat', month: '2024-02' })).toBe(700);
+    for (const category of protectedCategories) {
+      expect(getBudget({ category, month: '2024-02' })).toBe(500);
+    }
+  });
+
+  it('set3MonthAvg skips hidden and template-managed categories', async () => {
+    await setupDatabase();
+    for (const category of ['visible-cat', ...protectedCategories]) {
+      await setBudget({ category, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'visible-cat', month: '2024-02' })).toBe(0);
+    for (const category of protectedCategories) {
+      expect(getBudget({ category, month: '2024-02' })).toBe(500);
+    }
+  });
+});
+
 describe('copyUntilYearEnd', () => {
   beforeEach(global.emptyDatabase());
   afterEach(global.emptyDatabase());
