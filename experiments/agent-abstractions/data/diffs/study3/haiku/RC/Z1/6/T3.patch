+describe('fixed-cost groups', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'fixed-group',
+      name: 'fixed-group',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'fixed-ish-group',
+      name: 'fixed-ish-group',
+      is_income: 0,
+    });
+    await db.update('notes', { id: 'fixed-group', note: 'Rent #fixed' });
+    await db.update('notes', { id: 'fixed-ish-group', note: '#fixedish' });
+    await db.insertCategory({
+      id: 'visible',
+      name: 'visible',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-with-fixed-note',
+      name: 'cat-with-fixed-note',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.update('notes', {
+      id: 'cat-with-fixed-note',
+      note: '#fixed',
+    });
+    await db.insertCategory({
+      id: 'in-fixed-group',
+      name: 'in-fixed-group',
+      cat_group: 'fixed-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'in-fixed-ish-group',
+      name: 'in-fixed-ish-group',
+      cat_group: 'fixed-ish-group',
+      is_income: 0,
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  const categories = [
+    'visible',
+    'cat-with-fixed-note',
+    'in-fixed-group',
+    'in-fixed-ish-group',
+  ];
+
+  it('setZero leaves categories in a #fixed group untouched', async () => {
+    await setupDatabase();
+    for (const id of categories) {
+      await setBudget({ category: id, month: '2024-01', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'visible', month: '2024-01' })).toBe(0);
+    expect(
+      getBudget({ category: 'cat-with-fixed-note', month: '2024-01' }),
+    ).toBe(0);
+    expect(getBudget({ category: 'in-fixed-group', month: '2024-01' })).toBe(
+      500,
+    );
+    expect(
+      getBudget({ category: 'in-fixed-ish-group', month: '2024-01' }),
+    ).toBe(0);
+  });
+
+  it('copyPreviousMonth leaves categories in a #fixed group untouched', async () => {
+    await setupDatabase();
+    for (const id of categories) {
+      await setBudget({ category: id, month: '2024-01', amount: 500 });
+    }
+    await setBudget({
+      category: 'in-fixed-group',
+      month: '2024-02',
+      amount: 300,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'visible', month: '2024-02' })).toBe(500);
+    expect(
+      getBudget({ category: 'cat-with-fixed-note', month: '2024-02' }),
+    ).toBe(500);
+    expect(getBudget({ category: 'in-fixed-group', month: '2024-02' })).toBe(
+      300,
+    );
+    expect(
+      getBudget({ category: 'in-fixed-ish-group', month: '2024-02' }),
+    ).toBe(500);
+  });
+});
