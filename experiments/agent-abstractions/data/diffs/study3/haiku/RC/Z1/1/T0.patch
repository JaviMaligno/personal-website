+type MonthFillCategory = Pick<
+  BudgetData,
+  'is_income' | 'hidden' | 'group_hidden'
+>;
+
+// Income categories are only filled in tracking budgets. Hidden categories and
+// categories in hidden groups are skipped unless the action includes hidden ones.
+function isMonthFillCategory(
+  category: MonthFillCategory,
+  {
+    includeHidden,
+    isTracking,
+  }: { includeHidden: boolean; isTracking: boolean },
+): boolean {
+  if (category.is_income === 1 && !isTracking) {
+    return false;
+  }
+  return (
+    includeHidden || (category.hidden !== 1 && category.group_hidden !== 1)
+  );
+}
+
+// Average spending is negative for expenses, so budgeting it means flipping the sign.
+function getAverageBudgetAmount(
+  category: Pick<MonthFillCategory, 'is_income'>,
+  average: number,
+): number {
+  return category.is_income === 0 ? average * -1 : average;
+}
