+// Categories whose group row is missing are never averaged.
+async function getAverageFillCategories(): Promise<
+  (MonthFillCategory & Pick<db.DbCategory, 'id'>)[]
+> {
+  const isTracking = isTrackingBudget();
+  const categories = await db.all<
+    MonthFillCategory & Pick<db.DbCategory, 'id'>
+  >(
+    `
+  SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+  FROM categories c
+  INNER JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0
+  `,
+  );
+
+  return categories.filter(cat =>
+    isMonthFillCategory(cat, { includeHidden: false, isTracking }),
+  );
+}
