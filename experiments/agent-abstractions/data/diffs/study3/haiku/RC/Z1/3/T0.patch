+// Which categories a month-wide action writes to. 'all' includes hidden categories
+// and categories in hidden groups; 'visible' leaves them out and also leaves out
+// categories without a group; 'not-hidden' leaves out hidden ones but keeps
+// categories without a group.
+type MonthFillScope = 'all' | 'visible' | 'not-hidden';
+
+type FillFlags = {
+  is_income: 1 | 0;
+  hidden: 1 | 0;
+  group_hidden: 1 | 0 | null;
+};
+
+function isMonthFillTarget(cat: FillFlags, scope: MonthFillScope): boolean {
+  if (cat.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+  if (scope === 'all') {
+    return true;
+  }
+  if (scope === 'visible') {
+    return cat.hidden === 0 && cat.group_hidden === 0;
+  }
+  return cat.hidden !== 1 && cat.group_hidden !== 1;
+}
+
+async function getMonthFillCategories(
+  scope: MonthFillScope,
+): Promise<(FillFlags & { id: string })[]> {
+  const categories = await db.all<FillFlags & { id: string }>(`
+    SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+  `);
+  return categories.filter(cat => isMonthFillTarget(cat, scope));
+}
+
+// Averages are spending, which is negative for expenses; the budget is the positive amount.
+function spendingToBudgetAmount(spending: number, is_income: number): number {
+  return is_income === 0 ? -spending : spending;
+}
