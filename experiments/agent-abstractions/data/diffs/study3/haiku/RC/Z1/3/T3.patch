+      await db.insertCategory({
+        id: 'fixed-cat',
+        name: 'fixed-cat',
+        cat_group: 'fixed-group',
+      });
+
+      await db.insertCategoryGroup({
+        id: 'near-fixed-group',
+        name: 'near-fixed-group',
+      });
+      await db.insert('notes', {
+        id: 'near-fixed-group',
+        note: '#fixedcost',
+      });
+      await db.insertCategory({
+        id: 'near-fixed-cat',
+        name: 'near-fixed-cat',
+        cat_group: 'near-fixed-group',
+      });
+
+      await db.insertCategoryGroup({ id: 'group2', name: 'group2' });
+      await db.insert('notes', { id: 'group2', note: 'plain group notes' });
+      await db.insertCategory({
+        id: 'note-only-cat',
+        name: 'note-only-cat',
+        cat_group: 'group2',
+      });
+      await db.insert('notes', { id: 'note-only-cat', note: '#fixed' });
+      await db.insertCategory({
+        id: 'plain-cat',
+        name: 'plain-cat',
+        cat_group: 'group2',
+      });
+    }
+
+    it('setZero leaves categories in #fixed groups untouched', async () => {
+      await setupDatabase();
+      await setupFixedGroups();
+      await sheet.waitOnSpreadsheet();
+      for (const category of [
+        'fixed-cat',
+        'near-fixed-cat',
+        'note-only-cat',
+        'plain-cat',
+      ]) {
+        await setBudget({ category, month: '2024-02', amount: 700 });
+      }
+      await sheet.waitOnSpreadsheet();
+
+      await setZero({ month: '2024-02' });
+      await sheet.waitOnSpreadsheet();
+
+      expect(await getSheetValue('budget202402', 'budget-fixed-cat')).toBe(700);
+      expect(await getSheetValue('budget202402', 'budget-near-fixed-cat')).toBe(
+        0,
+      );
+      expect(await getSheetValue('budget202402', 'budget-note-only-cat')).toBe(
+        0,
+      );
+      expect(await getSheetValue('budget202402', 'budget-plain-cat')).toBe(0);
+    });
+
+    it('copyPreviousMonth leaves categories in #fixed groups untouched', async () => {
+      await setupDatabase();
+      await setupFixedGroups();
+      await sheet.waitOnSpreadsheet();
+      await setBudget({ category: 'fixed-cat', month: '2024-01', amount: 500 });
+      await setBudget({ category: 'fixed-cat', month: '2024-02', amount: 900 });
+      await setBudget({
+        category: 'near-fixed-cat',
+        month: '2024-01',
+        amount: 500,
+      });
+      await sheet.waitOnSpreadsheet();
+
+      await copyPreviousMonth({ month: '2024-02' });
+      await sheet.waitOnSpreadsheet();
+
+      expect(await getSheetValue('budget202402', 'budget-fixed-cat')).toBe(900);
+      expect(await getSheetValue('budget202402', 'budget-near-fixed-cat')).toBe(
+        500,
+      );
+    });
+  });
 });
 
