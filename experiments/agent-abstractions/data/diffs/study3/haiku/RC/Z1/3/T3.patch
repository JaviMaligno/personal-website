+  describe('#fixed group notes', () => {
+    async function setupFixedGroups() {
+      await db.insertCategoryGroup({ id: 'fixed-group', name: 'fixed-group' });
+      await db.insert('notes', {
+        id: 'fixed-group',
+        note: 'Rent and loans\n#fixed',
