diff --git a/packages/loot-core/src/server/budget/month-fill.ts b/packages/loot-core/src/server/budget/month-fill.ts
new file mode 100644
index 0000000..ee52ddb
--- /dev/null
+++ b/packages/loot-core/src/server/budget/month-fill.ts
@@ -0,0 +1,43 @@
+import * as db from '#server/db';
+
+// Which categories a month-wide budget action writes, and with what sign.
+// Income categories are only written in tracking budgets.
+
+type MonthFillCategory = Pick<db.DbViewCategory, 'id' | 'is_income'>;
+
+export function isMonthFillCategory(
+  category: Pick<db.DbViewCategory, 'is_income'>,
+  isTracking: boolean,
+): boolean {
+  return !(category.is_income === 1 && !isTracking);
+}
+
+// Averages are spending, so expense categories get them as positive amounts to budget.
+export function toAverageFillAmount(
+  average: number,
+  category: Pick<db.DbViewCategory, 'is_income'>,
+): number {
+  return category.is_income === 0 ? -average : average;
+}
+
+export function getMonthFillCategories({
+  includeHidden,
+}: {
+  includeHidden: boolean;
+}): Promise<MonthFillCategory[]> {
+  const hiddenFilter = includeHidden ? '' : 'AND c.hidden = 0 AND g.hidden = 0';
+  return db.all<MonthFillCategory>(`
+    SELECT c.id, c.is_income
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0 ${hiddenFilter}
+  `);
+}
+
+// Copying a previous month only skips categories explicitly marked hidden, so a
+// category without a group row is still copied.
+export function isHiddenForMonthCopy(
+  category: Pick<db.DbViewCategoryWithGroupHidden, 'hidden' | 'group_hidden'>,
+): boolean {
+  return category.hidden === 1 || category.group_hidden === 1;
+}
