+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getMonthFillCategories();
+  const isTracking = isTrackingBudget();
+  const prevSheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (!isMonthFillCategory(cat, isTracking)) {
+        continue;
+      }
+
+      const spent = await getSheetValue(prevSheetName, 'sum-amount-' + cat.id);
+
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: toAverageFillAmount(spent, cat),
+      });
+    }
+  });
+}
