+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'templated',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.updateWithSchema('categories', {
+      id: 'templated',
+      goal_def: JSON.stringify([{ type: 'simple', monthly: 100, limit: null }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    await db.insertTransaction({
+      date: '2024-01-10',
+      amount: -3000,
+      account: 'account1',
+      category: 'spent',
+    });
+    await db.insertTransaction({
+      date: '2024-01-12',
+      amount: 1000,
+      account: 'account1',
+      category: 'spent',
+    });
+    await db.insertTransaction({
+      date: '2024-01-15',
+      amount: 5000,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await db.insertTransaction({
+      date: '2024-01-16',
+      amount: -200,
+      account: 'account1',
+      category: 'hidden-cat',
+    });
+    await db.insertTransaction({
+      date: '2024-01-17',
+      amount: -100,
+      account: 'account1',
+      category: 'templated',
+    });
+    await sheet.waitOnSpreadsheet();
+
+    for (const id of ['spent', 'unspent', 'hidden-cat', 'templated']) {
+      await setBudget({ category: id, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('budgets each expense category its net spending from the previous month', async () => {
+    await setupDatabase();
+
+    await setLastMonthSpending({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'spent', month: '2024-02' })).toBe(2000);
+    expect(getBudget({ category: 'unspent', month: '2024-02' })).toBe(0);
+  });
+
+  it('leaves hidden and template-managed categories untouched', async () => {
+    await setupDatabase();
+
+    await setLastMonthSpending({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'hidden-cat', month: '2024-02' })).toBe(500);
+    expect(getBudget({ category: 'templated', month: '2024-02' })).toBe(500);
+  });
+
+  it('leaves income categories untouched in envelope budgets', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'income-cat', month: '2024-02', amount: 700 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'income-cat', month: '2024-02' })).toBe(700);
+  });
+
+  it('budgets income categories with the amount received in tracking budgets', async () => {
+    await setupDatabase();
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+    await setBudget({ category: 'income-cat', month: '2024-02', amount: 700 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'income-cat', month: '2024-02' })).toBe(5000);
+    expect(getBudget({ category: 'spent', month: '2024-02' })).toBe(2000);
+  });
+});
