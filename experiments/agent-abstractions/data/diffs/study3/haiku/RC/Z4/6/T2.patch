+// A weekend occurrence moves at most two days, so occurrences just outside the
+// period can land inside it after adjustment.
+const WEEKEND_SHIFT_DAYS = 2;
+
+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+
+  const days = new Set<string>();
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS)),
+      end: d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS)),
+    })
+    .toArray();
+
+  for (const { date } of occurrences) {
+    const adjusted = applyWeekendRule(date, config);
+    if (adjusted == null) {
+      continue;
+    }
+    const day = dayFromDate(adjusted);
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
