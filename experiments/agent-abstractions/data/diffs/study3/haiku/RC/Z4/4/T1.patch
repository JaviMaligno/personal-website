+      /* Dec 2020 calendar for reference:
+        | Su | Mo | Tu | We | Th | Fr | Sa |
+        |    |    | 01 | 02 | 03 | 04 | 05 |
+        | 06 | 07 | 08 | 09 | 10 | 11 | 12 |
+        */
+      function daily(extra = {}) {
+        return {
+          op: 'isapprox',
+          value: {
+            start: '2020-12-05',
+            frequency: 'daily',
+            patterns: [],
+            skipWeekend: true,
+            weekendSolveMode: 'before',
+            ...extra,
+          },
+        };
+      }
+
+      it('skips a weekend occurrence of a daily schedule instead of moving it', () => {
+        expect(getNextDate(daily(), new Date(2020, 11, 5))).toBe('2020-12-07');
+      });
+
+      it('skips a weekend occurrence of a daily schedule in `after` mode', () => {
+        expect(
+          getNextDate(
+            daily({ weekendSolveMode: 'after' }),
+            new Date(2020, 11, 5),
+          ),
+        ).toBe('2020-12-07');
+      });
+
+      it('does not report a daily schedule date before its start', () => {
+        const result = getNextDate(
+          daily({ start: '2020-12-06' }),
+          new Date(2020, 11, 6),
+        );
+        expect(result).toBe('2020-12-07');
+      });
+
+      it('returns the raw weekend occurrence when weekend skipping is disabled', () => {
+        expect(getNextDate(daily(), new Date(2020, 11, 5), true)).toBe(
+          '2020-12-05',
+        );
+      });
+
+      it('still moves weekend occurrences of a weekly schedule', () => {
+        const dateCond = {
+          op: 'isapprox',
+          value: {
+            start: '2020-12-05',
+            frequency: 'weekly',
+            patterns: [],
+            skipWeekend: true,
+            weekendSolveMode: 'before',
+          },
+        };
+
+        expect(getNextDate(dateCond, new Date(2020, 11, 5))).toBe('2020-12-04');
+      });
+
+      it('returns null when every occurrence of a daily schedule falls on a weekend', () => {
+        expect(
+          getNextDate(
+            daily({ start: '2020-12-05', interval: 7 }),
+            new Date(2020, 11, 5),
+          ),
+        ).toBeNull();
+      });
+    });
