+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    // Weekend rules move an occurrence by at most two days, so occurrences
+    // just outside the period can land inside it.
+    const occurrences = schedule
+      .occurrences({
+        start: d.subDays(parseDate(start), 3),
+        end: d.addDays(parseDate(end), 3),
+      })
+      .toArray();
+
+    const days = new Set<string>();
+    for (const { date } of occurrences) {
+      if (isSkippedWeekendOccurrence(config, date)) {
+        continue;
+      }
+      const day = dayFromDate(applyWeekendRule(date, config));
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
