+function isHoliday(date: Date, holidays: string[]): boolean {
+  const day = monthUtils.dayFromDate(date);
+  const monthDay = day.slice(5);
+  return holidays.some(holiday =>
+    holiday.length === 5 ? holiday === monthDay : holiday === day,
   );
 }
 
+function isNonWorkingDay(date: Date, rule: WeekendRule): boolean {
+  return d.isWeekend(date) || isHoliday(date, rule.holidays ?? []);
+}
+
 export function isSkippedWeekendOccurrence(date: Date, rule: WeekendRule) {
   return isDailyWeekendSkip(rule) && isNonWorkingDay(date, rule);
 }
