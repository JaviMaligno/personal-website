+export function isWeekendOrHoliday(
+  day: string,
+  holidays: readonly string[] = [],
+): boolean {
+  return d.isWeekend(monthUtils._parse(day)) || holidays.includes(day);
+}
+
+// Any 7 consecutive days hold at least 5 weekdays, and each holiday can rule
+// out at most one of them, so this window always contains a usable day.
+export function getDailyLookahead(holidays: readonly string[] = []): number {
+  return 7 * (holidays.length + 1);
+}
+
+// A run of consecutive non-business days contains at most two days per weekend
+// and one per holiday, which bounds how far an occurrence can move.
+export function getMaxShiftDays(holidays: readonly string[] = []): number {
+  return 2 + 3 * holidays.length;
+}
