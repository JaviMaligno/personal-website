+// A weekend occurrence moves at most two days (Sunday to the Friday before).
+const MAX_WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const dropsWeekendDays = skipsWeekendOccurrences(config);
+
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), MAX_WEEKEND_SHIFT_DAYS)),
+      end: d.startOfDay(d.addDays(parseDate(end), MAX_WEEKEND_SHIFT_DAYS + 1)),
+    })
+    .toArray()
+    .map(occurrence => occurrence.date);
+
+  const days = new Set<string>();
+  for (const occurrence of occurrences) {
+    if (dropsWeekendDays && d.isWeekend(occurrence)) {
+      continue;
+    }
+
+    const day = dayFromDate(
+      dropsWeekendDays
+        ? occurrence
+        : getDateWithSkippedWeekend(
+            occurrence,
+            config.skipWeekend,
+            config.weekendSolveMode,
+          ),
+    );
+
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
