+// Weekend moves shift an occurrence by at most two days, so padding the
+// generated range by three days on each side catches every occurrence that
+// can land inside [start, end] once adjusted.
+const WEEKEND_ADJUST_PADDING_DAYS = 3;
+
+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const occurrences = schedule
+      .occurrences({
+        start: d.subDays(parseDate(start), WEEKEND_ADJUST_PADDING_DAYS),
+        end: d.addDays(parseDate(end), WEEKEND_ADJUST_PADDING_DAYS),
+      })
+      .toArray();
+
+    const days = new Set<string>();
+    for (const occurrence of occurrences) {
+      const adjusted = applyWeekendRule(occurrence.date, config);
+      if (adjusted === null) {
+        continue;
+      }
+      const day = dayFromDate(adjusted);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
