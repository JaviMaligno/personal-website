+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    // A weekend occurrence moves at most two days, so pad the search window
+    // and filter on the final day after the weekend rule is applied.
+    const occurrences = schedule
+      .occurrences({
+        start: d.subDays(parseDate(start), 2),
+        end: d.addDays(parseDate(end), 3),
+      })
+      .toArray();
+
+    const days = new Set(
+      occurrences
+        .map(occurrence =>
+          applyWeekendRule(dayFromDate(occurrence.date), config),
+        )
+        .filter(day => day != null && day >= start && day <= end),
+    );
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
