+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    // A weekend move shifts an occurrence by at most two days, so occurrences
+    // just outside the period can land inside it.
+    const days = schedule
+      .occurrences({
+        start: d.startOfDay(parseDate(subDays(start, 2))),
+        end: d.endOfDay(parseDate(addDays(end, 2))),
+      })
+      .toArray()
+      .map(occurrence => occurrence.date)
+      .filter(date => !isSkippedWeekendOccurrence(date, config))
+      .map(date => dayFromDate(getDateWithSkippedWeekend(date, config)))
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
