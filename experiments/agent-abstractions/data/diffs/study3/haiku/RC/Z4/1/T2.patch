+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const skipsDailyWeekend = config.frequency === 'daily' && config.skipWeekend;
+
+  // Weekend adjustment moves an occurrence by at most two days, so occurrences
+  // just outside the period can land inside it.
+  const windowStart = d.startOfDay(parseDate(subDays(start, 2)));
+  const windowEnd = d.endOfDay(parseDate(addDays(end, 2)));
+
+  const days = new Set<string>();
+  for (const occurrence of schedule
+    .occurrences({ start: windowStart, end: windowEnd })
+    .toArray()) {
+    if (skipsDailyWeekend && d.isWeekend(occurrence.date)) {
+      continue;
+    }
+
+    const day = getWeekendAdjustedDay(dayFromDate(occurrence.date), {
+      skipWeekend: config.skipWeekend && !skipsDailyWeekend,
+      weekendSolveMode: config.weekendSolveMode,
+    });
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
