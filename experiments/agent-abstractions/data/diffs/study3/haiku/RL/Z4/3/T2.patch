+// Weekend moves shift an occurrence by at most two days, so occurrences
+// just outside the range can land inside it.
+const WEEKEND_SHIFT_DAYS = 2;
+
+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const scanStart = d.startOfDay(
+      d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS),
+    );
+    const scanEnd = d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS));
+    const skipsWeekend = skipsWeekendOccurrences(config);
+
+    const days = schedule
+      .occurrences({ start: scanStart, end: scanEnd })
+      .toArray()
+      .map(occurrence => occurrence.date)
+      .filter(date => !(skipsWeekend && d.isWeekend(date)))
+      .map(date =>
+        config.skipWeekend && !skipsWeekend
+          ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+          : date,
+      )
+      .map(date => dayFromDate(date))
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
