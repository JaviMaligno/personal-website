+// A weekend occurrence moves at most 2 days; the extra day also covers an exclusive range end.
+const DATES_IN_RANGE_SEARCH_PADDING_DAYS = 3;
+
+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const occurrences = schedule
+    .occurrences({
+      start: d.subDays(parseDate(start), DATES_IN_RANGE_SEARCH_PADDING_DAYS),
+      end: d.addDays(parseDate(end), DATES_IN_RANGE_SEARCH_PADDING_DAYS),
+    })
+    .toArray();
+
+  const days = new Set<string>();
+  for (const { date } of occurrences) {
+    if (isDroppedWeekendOccurrence(date, config)) {
+      continue;
+    }
+
+    const finalDate =
+      config.skipWeekend && !skipsWeekendOccurrences(config)
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date;
+    const day = dayFromDate(finalDate);
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
