+export function isDailyWeekendSkip(
+  frequency: string | undefined,
+  skipWeekend: boolean | undefined,
+): boolean {
+  return Boolean(skipWeekend) && frequency === 'daily';
+}
+
+// Daily occurrences repeat their weekday pattern within any 7 consecutive
+// occurrences, so a window of 7 is enough to find a weekday or rule one out.
+const WEEKDAY_SEARCH_WINDOW = 7;
+
+export function getWeekdayOccurrences(
+  schedule: RSchedule,
+  start: Date,
+  count: number,
+): Date[] {
+  const dates: Date[] = [];
+  let windowStart = start;
+
+  while (dates.length < count) {
+    const window = schedule
+      .occurrences({ start: windowStart, take: WEEKDAY_SEARCH_WINDOW })
+      .toArray()
+      .map(occurrence => occurrence.date);
+    const weekdays = window.filter(date => !d.isWeekend(date));
+
+    if (weekdays.length === 0) {
+      break;
+    }
+
+    dates.push(...weekdays);
+    windowStart = d.addDays(window[window.length - 1], 1);
+  }
+
+  return dates.slice(0, count);
+}
+
+function getLastWeekdayOccurrence(schedule: RSchedule): Date | null {
+  return (
+    schedule
+      .occurrences({ reverse: true, take: WEEKDAY_SEARCH_WINDOW })
+      .toArray()
+      .map(occurrence => occurrence.date)
+      .find(date => !d.isWeekend(date)) ?? null
+  );
+}
