+// A weekend shift moves an occurrence at most two days, so occurrences
+// just outside the period can still land inside it after adjustment.
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({ config, start, end }): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const dates = new Set<string>();
+
+    schedule
+      .occurrences({
+        start: d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS),
+        end: d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS),
+      })
+      .toArray()
+      .forEach(occurrence => {
+        const date = applyWeekendRule(occurrence.date, config);
+        if (date) {
+          const day = dayFromDate(date);
+          if (day >= start && day <= end) {
+            dates.add(day);
+          }
+        }
+      });
+
+    return [...dates].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
