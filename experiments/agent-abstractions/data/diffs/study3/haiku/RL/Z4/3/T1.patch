+// Enough consecutive daily occurrences to contain a weekday for any interval
+// that is not a multiple of 7.
+export const DAILY_WEEKDAY_LOOKAHEAD = 7;
+
+export function skipsWeekendOccurrences(recur: {
+  frequency?: string;
+  skipWeekend?: boolean;
+}): boolean {
+  return !!recur.skipWeekend && recur.frequency === 'daily';
+}
+
+function findWeekdayOccurrence(occurrences: { date: Date }[]): Date | null {
+  return occurrences.find(o => !d.isWeekend(o.date))?.date ?? null;
+}
+
+function getNextWeekdayOccurrence(
+  schedule: RSchedule,
+  start: Date,
+): Date | null {
+  const upcoming = schedule
+    .occurrences({ start, take: DAILY_WEEKDAY_LOOKAHEAD })
+    .toArray();
+  if (upcoming.length > 0) {
+    return findWeekdayOccurrence(upcoming);
+  }
+
+  // Could be a schedule with limited occurrences, so we try to
+  // find the last occurrence
+  return findWeekdayOccurrence(
+    schedule
+      .occurrences({ reverse: true, take: DAILY_WEEKDAY_LOOKAHEAD })
+      .toArray(),
+  );
+}
