+// Weekend solving moves an occurrence at most two days (Sat -> Mon, Sun -> Fri)
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+
+    const dates = schedule
+      .occurrences({
+        start: d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS),
+        end: d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS),
+      })
+      .toArray()
+      .map(occurrence => occurrence.date);
+
+    const days = applyWeekendHandling(config, dates)
+      .map(date => dayFromDate(date))
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
