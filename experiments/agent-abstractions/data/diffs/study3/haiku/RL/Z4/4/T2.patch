+// Weekend solving moves an occurrence by at most two days, so occurrences are
+// generated with this padding on both sides before filtering by adjusted day.
+const WEEKEND_SHIFT_PADDING_DAYS = 3;
+
+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const skipsWeekend = skipsWeekendOccurrences(config);
+
+  const days = new Set<string>();
+  for (const { date } of schedule
+    .occurrences({
+      start: d.subDays(parseDate(start), WEEKEND_SHIFT_PADDING_DAYS),
+      end: d.addDays(parseDate(end), WEEKEND_SHIFT_PADDING_DAYS),
+    })
+    .toArray()) {
+    let day: string;
+    if (skipsWeekend) {
+      if (d.isWeekend(date)) {
+        continue;
+      }
+      day = dayFromDate(date);
+    } else if (config.skipWeekend) {
+      day = dayFromDate(
+        getDateWithSkippedWeekend(date, config.weekendSolveMode),
+      );
+    } else {
+      day = dayFromDate(date);
+    }
+
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
