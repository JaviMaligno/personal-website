+// A daily schedule can have a run of weekend occurrences, and a weekday cycle
+// repeats within 7 occurrences, so looking ahead this far always finds one.
+export const RECUR_LOOKAHEAD_OCCURRENCES = 7;
+
+export function applyWeekendRule(
+  date: Date,
+  config: Pick<RecurConfig, 'frequency' | 'skipWeekend' | 'weekendSolveMode'>,
+): Date | null {
+  if (!config.skipWeekend || !d.isWeekend(date)) {
+    return date;
+  }
+  if (config.frequency === 'daily') {
+    return null;
+  }
+  return getDateWithSkippedWeekend(date, config.weekendSolveMode);
+}
