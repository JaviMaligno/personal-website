+
+    describe('daily schedules with weekend skipping', () => {
+      /* Aug 2026 calendar for reference:
+        | Su | Mo | Tu | We | Th | Fr | Sa |
+        | 23 | 24 | 25 | 26 | 27 | 28 | 29 |
+        | 30 | 31 |
+        */
+      function dailyCond(extra = {}) {
+        return {
+          op: 'isapprox',
+          value: {
+            start: '2026-08-21',
+            frequency: 'daily',
+            patterns: [],
+            ...extra,
+          },
+        };
+      }
+
+      it.each(['before', 'after'])(
+        'skips a Saturday occurrence when moving `%s` the weekend',
+        weekendSolveMode => {
+          const dateCond = dailyCond({ skipWeekend: true, weekendSolveMode });
+
+          expect(getNextDate(dateCond, new Date(2026, 7, 22))).toBe(
+            '2026-08-24',
+          );
+        },
+      );
+
+      it.each(['before', 'after'])(
+        'skips a Sunday occurrence when moving `%s` the weekend',
+        weekendSolveMode => {
+          const dateCond = dailyCond({ skipWeekend: true, weekendSolveMode });
+
+          expect(getNextDate(dateCond, new Date(2026, 7, 23))).toBe(
+            '2026-08-24',
+          );
+        },
+      );
+
+      it('keeps weekday occurrences unchanged', () => {
+        const dateCond = dailyCond({
+          skipWeekend: true,
+          weekendSolveMode: 'before',
+        });
+
+        expect(getNextDate(dateCond, new Date(2026, 7, 21))).toBe('2026-08-21');
+      });
+
+      it('finds the next weekday occurrence every few days', () => {
+        const dateCond = dailyCond({
+          interval: 2,
+          skipWeekend: true,
+          weekendSolveMode: 'after',
+        });
+
+        expect(getNextDate(dateCond, new Date(2026, 7, 23))).toBe('2026-08-25');
+      });
+
+      it('ignores weekend handling when noSkipWeekend is set', () => {
+        const dateCond = dailyCond({
+          skipWeekend: true,
+          weekendSolveMode: 'before',
+        });
+
+        expect(getNextDate(dateCond, new Date(2026, 7, 22), true)).toBe(
+          '2026-08-22',
+        );
+      });
+
+      it('returns null when every occurrence falls on a weekend', () => {
+        const dateCond = dailyCond({
+          start: '2026-08-22',
+          interval: 7,
+          skipWeekend: true,
+          weekendSolveMode: 'after',
+        });
+
+        expect(getNextDate(dateCond, new Date(2026, 7, 22))).toBeNull();
+      });
+    });
