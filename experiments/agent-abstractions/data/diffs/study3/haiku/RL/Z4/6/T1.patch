diff --git a/packages/loot-core/src/shared/schedules.test.ts b/packages/loot-core/src/shared/schedules.test.ts
index 5bd000a..857e182 100644
--- a/packages/loot-core/src/shared/schedules.test.ts
+++ b/packages/loot-core/src/shared/schedules.test.ts
@@ -497,6 +497,84 @@ describe('schedules', () => {
       const result = getNextDate(dateCond, new Date(2017, 0, 1));
       expect(result).toBeNull();
     });
+
+    describe('with weekend handling', () => {
+      /* Dec 2020 calendar for reference:
+        | Su | Mo | Tu | We | Th | Fr | Sa |
+        |    |    | 01 | 02 | 03 | 04 | 05 |
+        | 06 | 07 | 08 | 09 | 10 | 11 | 12 |
+        */
+      function dailyCond(extra = {}) {
+        return {
+          op: 'isapprox',
+          value: {
+            start: '2020-12-01',
+            frequency: 'daily',
+            patterns: [],
+            skipWeekend: true,
+            weekendSolveMode: 'before',
+            ...extra,
+          },
+        };
+      }
+
+      it('skips a daily weekend occurrence instead of moving it back to Friday', () => {
+        expect(getNextDate(dailyCond(), new Date(2020, 11, 5))).toBe(
+          '2020-12-07',
+        );
+      });
+
+      it('skips a daily weekend occurrence instead of moving it forward to Monday', () => {
+        expect(
+          getNextDate(
+            dailyCond({ weekendSolveMode: 'after' }),
+            new Date(2020, 11, 5),
+          ),
+        ).toBe('2020-12-07');
+      });
+
+      it('keeps a daily weekday occurrence unchanged', () => {
+        expect(getNextDate(dailyCond(), new Date(2020, 11, 4))).toBe(
+          '2020-12-04',
+        );
+      });
+
+      it('returns the raw weekend occurrence when weekend handling is disabled', () => {
+        expect(getNextDate(dailyCond(), new Date(2020, 11, 5), true)).toBe(
+          '2020-12-05',
+        );
+      });
+
+      it('skips weekend occurrences of a daily schedule with an interval', () => {
+        const dateCond = dailyCond({ start: '2020-12-04', interval: 2 });
+
+        expect(getNextDate(dateCond, new Date(2020, 11, 5))).toBe('2020-12-08');
+      });
+
+      it('moves a weekly weekend occurrence back to Friday', () => {
+        const dateCond = {
+          op: 'isapprox',
+          value: {
+            start: '2020-12-05',
+            frequency: 'weekly',
+            patterns: [],
+            skipWeekend: true,
+            weekendSolveMode: 'before',
+          },
+        };
+
+        expect(getNextDate(dateCond, new Date(2020, 11, 5))).toBe('2020-12-04');
+      });
+
+      it('returns the last weekday occurrence of a daily schedule that ended on a weekend', () => {
+        const dateCond = dailyCond({
+          endMode: 'on_date',
+          endDate: '2020-12-05',
+        });
+
+        expect(getNextDate(dateCond, new Date(2020, 11, 6))).toBe('2020-12-04');
+      });
+    });
   });
 
   describe('getNextDateAfter', () => {
