+const MAX_WEEKEND_SHIFT_DAYS = 2;
+
+function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): string[] {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const skipDailyWeekend = isDailyWeekendSkip(config);
+
+  const windowStart = d.startOfDay(
+    d.subDays(parseDate(start), MAX_WEEKEND_SHIFT_DAYS),
+  );
+  const windowEnd = d.endOfDay(
+    d.addDays(parseDate(end), MAX_WEEKEND_SHIFT_DAYS),
+  );
+
+  const days = schedule
+    .occurrences({ start: windowStart, end: windowEnd })
+    .toArray()
+    .map(occurrence => occurrence.date)
+    .filter(date => !skipDailyWeekend || !d.isWeekend(date))
+    .map(date =>
+      config.skipWeekend && !skipDailyWeekend
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date,
+    )
+    .map(date => dayFromDate(date))
+    .filter(day => day >= start && day <= end);
+
+  return [...new Set(days)].sort();
+}
