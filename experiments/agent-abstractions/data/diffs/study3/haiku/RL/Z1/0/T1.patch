+describe('month-wide budget actions', () => {
+  let originalCurrentMonth: string | null;
+
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    originalCurrentMonth = global.currentMonth;
+    global.currentMonth = '2024-03';
+  });
+
+  afterEach(async () => {
+    global.currentMonth = originalCurrentMonth;
+    await global.emptyDatabase()();
+  });
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-normal',
+      name: 'normal',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'in hidden group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-template',
+      name: 'template',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: JSON.stringify([{ type: 'simple', monthly: 100 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02', '2024-03']);
+
+    for (const category of [
+      'cat-normal',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-template',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 500 });
+      await setBudget({ category, month: '2024-03', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  async function expectBudgets(
+    month: string,
+    expected: Record<string, number>,
+  ) {
+    for (const [category, amount] of Object.entries(expected)) {
+      expect(
+        await getSheetValue(
+          `budget${month.replace('-', '')}`,
+          `budget-${category}`,
+        ),
+      ).toBe(amount);
+    }
+  }
+
+  it('setZero leaves hidden categories, hidden group categories and templated categories untouched', async () => {
+    await setupDatabase();
+
+    await setZero({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    await expectBudgets('2024-03', {
+      'cat-normal': 0,
+      'cat-hidden': 500,
+      'cat-in-hidden-group': 500,
+      'cat-template': 500,
+    });
+  });
+
+  it('copyPreviousMonth leaves hidden categories, hidden group categories and templated categories untouched', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'cat-normal', month: '2024-02', amount: 300 });
+    await setBudget({ category: 'cat-hidden', month: '2024-02', amount: 300 });
+    await setBudget({
+      category: 'cat-in-hidden-group',
+      month: '2024-02',
+      amount: 300,
+    });
+    await setBudget({
+      category: 'cat-template',
+      month: '2024-02',
+      amount: 300,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    await expectBudgets('2024-03', {
+      'cat-normal': 300,
+      'cat-hidden': 500,
+      'cat-in-hidden-group': 500,
+      'cat-template': 500,
+    });
+  });
+
+  it('set3MonthAvg leaves hidden categories, hidden group categories and templated categories untouched', async () => {
+    await setupDatabase();
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertTransaction({
+      date: '2024-01-15',
+      amount: -900,
+      account: 'account1',
+      category: 'cat-normal',
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    await expectBudgets('2024-03', {
+      'cat-hidden': 500,
+      'cat-in-hidden-group': 500,
+      'cat-template': 500,
+    });
+    expect(await getSheetValue('budget202403', 'budget-cat-normal')).toBe(450);
+  });
+});
