+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  const templateDef = JSON.stringify([{ type: 'fixed', amount: 100 }]);
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'group1', name: 'group1' });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'templated-cat',
+      name: 'templated-cat',
+      cat_group: 'group1',
+      goal_def: templateDef,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'group-hidden-cat',
+      name: 'group-hidden-cat',
+      cat_group: 'hidden-group',
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02', '2024-03']);
+  }
+
+  it('setZero leaves hidden, group-hidden and templated categories untouched', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'cat1', month: '2024-02', amount: 500 });
+    await setBudget({ category: 'hidden-cat', month: '2024-02', amount: 300 });
+    await setBudget({
+      category: 'templated-cat',
+      month: '2024-02',
+      amount: 200,
+    });
+    await setBudget({
+      category: 'group-hidden-cat',
+      month: '2024-02',
+      amount: 150,
+    });
+    await setBudget({ category: 'income-cat', month: '2024-02', amount: 900 });
+
+    await setZero({ month: '2024-02' });
+
+    expect(getBudget({ category: 'cat1', month: '2024-02' })).toBe(0);
+    expect(getBudget({ category: 'income-cat', month: '2024-02' })).toBe(900);
+    expect(getBudget({ category: 'hidden-cat', month: '2024-02' })).toBe(300);
+    expect(getBudget({ category: 'templated-cat', month: '2024-02' })).toBe(
+      200,
+    );
+    expect(getBudget({ category: 'group-hidden-cat', month: '2024-02' })).toBe(
+      150,
+    );
+  });
+
+  it('copyPreviousMonth does not write to templated categories', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'cat1', month: '2024-01', amount: 400 });
+    await setBudget({
+      category: 'templated-cat',
+      month: '2024-01',
+      amount: 250,
+    });
+    await setBudget({
+      category: 'templated-cat',
+      month: '2024-02',
+      amount: 80,
+    });
+
+    await copyPreviousMonth({ month: '2024-02' });
+
+    expect(getBudget({ category: 'cat1', month: '2024-02' })).toBe(400);
+    expect(getBudget({ category: 'templated-cat', month: '2024-02' })).toBe(80);
+  });
+
+  it('set3MonthAvg leaves hidden and templated categories untouched', async () => {
+    await setupDatabase();
+    await setBudget({ category: 'hidden-cat', month: '2024-03', amount: 300 });
+    await setBudget({
+      category: 'templated-cat',
+      month: '2024-03',
+      amount: 200,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'hidden-cat', month: '2024-03' })).toBe(300);
+    expect(getBudget({ category: 'templated-cat', month: '2024-03' })).toBe(
+      200,
+    );
+  });
+});
