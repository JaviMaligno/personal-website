+  );
+}
+
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevSheet = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await forEachMonthActionCategory(async cat => {
+    const sumAmount = await getSheetValue(prevSheet, 'sum-amount-' + cat.id);
+    // 0 - x rather than -x so an empty month yields 0 instead of -0
+    const amount = cat.is_income === 1 ? sumAmount : 0 - sumAmount;
+    void setBudget({ category: cat.id, month, amount });
+  });
+}
