+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupProtectedDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'cat-hidden',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden-group',
+      name: 'cat-hidden-group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'cat-template',
+      name: 'cat-template',
+      cat_group: 'group1',
+    });
+    await db.update('categories', {
+      id: 'cat-template',
+      goal_def: JSON.stringify([{ type: 'fixed', amount: 5000 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+
+    for (const category of [
+      'cat1',
+      'cat-hidden',
+      'cat-hidden-group',
+      'cat-template',
+    ]) {
+      await setBudget({ category, month: '2024-03', amount: 1000 });
+      await setBudget({ category, month: '2024-04', amount: 1000 });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('setZero leaves hidden, hidden-group and template categories untouched', async () => {
+    await setupProtectedDatabase();
+
+    await setZero({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden')).toBe(1000);
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden-group')).toBe(
+      1000,
+    );
+    expect(await getSheetValue('budget202404', 'budget-cat-template')).toBe(
+      1000,
+    );
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and template categories untouched', async () => {
+    await setupProtectedDatabase();
+    await setBudget({ category: 'cat1', month: '2024-03', amount: 300 });
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(300);
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden')).toBe(1000);
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden-group')).toBe(
+      1000,
+    );
+    expect(await getSheetValue('budget202404', 'budget-cat-template')).toBe(
+      1000,
+    );
+  });
+
+  it('set3MonthAvg leaves hidden, hidden-group and template categories untouched', async () => {
+    await setupProtectedDatabase();
+
+    await set3MonthAvg({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden')).toBe(1000);
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden-group')).toBe(
+      1000,
+    );
+    expect(await getSheetValue('budget202404', 'budget-cat-template')).toBe(
+      1000,
+    );
+  });
+});
