+const FIXED_GROUP_TAG = '#fixed';
+
+async function getFixedGroupIds(): Promise<Set<string>> {
+  const groupNotes = await db.all<Pick<db.DbNote, 'id' | 'note'>>(`
+  SELECT n.id, n.note
+  FROM notes n
+  JOIN category_groups g ON g.id = n.id
+  WHERE lower(n.note) LIKE '%${FIXED_GROUP_TAG}%'
+  `);
+  return new Set(
+    groupNotes
+      .filter(({ note }) =>
+        note.toLowerCase().split(/\s+/).includes(FIXED_GROUP_TAG),
+      )
+      .map(({ id }) => id),
+  );
+}
