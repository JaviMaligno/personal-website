+  });
+
+  afterEach(async () => {
+    global.currentMonth = originalCurrentMonth;
+    await global.emptyDatabase()();
+  });
+
+  async function setupMonthWideDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat1',
+      name: 'cat1',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-templated',
+      name: 'templated',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'in hidden group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+
+    await storeTemplates({
+      categoriesWithTemplates: [
+        {
+          id: 'cat-templated',
+          templates: [
+            {
+              type: 'simple',
+              monthly: 500,
+              limit: null,
+              priority: 0,
+              directive: 'template',
+            },
+          ],
+        },
+      ],
+      source: 'ui',
+    });
+  }
+
+  const untouchedCategories = [
+    'cat-hidden',
+    'cat-templated',
+    'cat-in-hidden-group',
+  ];
+
+  it.each([
+    ['set zero', () => setZero({ month: '2024-04' })],
+    ['3 month average', () => set3MonthAvg({ month: '2024-04' })],
+    ['6 month average', () => set6MonthAvg({ month: '2024-04' })],
+    ['12 month average', () => set12MonthAvg({ month: '2024-04' })],
+  ])(
+    '%s leaves hidden and template-managed categories untouched',
+    async (_name, runAction) => {
+      for (const category of ['cat1', ...untouchedCategories]) {
+        await setBudget({ category, month: '2024-04', amount: 1000 });
+      }
+      await sheet.waitOnSpreadsheet();
+
+      await runAction();
+      await sheet.waitOnSpreadsheet();
+
+      expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(0);
+      for (const category of untouchedCategories) {
+        expect(await getSheetValue('budget202404', `budget-${category}`)).toBe(
+          1000,
+        );
+      }
+    },
+  );
+
+  it('copy last month leaves hidden and template-managed categories untouched', async () => {
+    for (const category of ['cat1', ...untouchedCategories]) {
+      await setBudget({ category, month: '2024-03', amount: 500 });
+      await setBudget({ category, month: '2024-04', amount: 1000 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(500);
+    for (const category of untouchedCategories) {
+      expect(await getSheetValue('budget202404', `budget-${category}`)).toBe(
+        1000,
+      );
+    }
+  });
+
+  it('single category copy still writes to a template-managed category', async () => {
+    await setBudget({
+      category: 'cat-templated',
+      month: '2024-03',
+      amount: 500,
+    });
+    await setBudget({
+      category: 'cat-templated',
+      month: '2024-04',
+      amount: 1000,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await copySinglePreviousMonth({
+      month: '2024-04',
+      category: 'cat-templated',
+    });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat-templated')).toBe(
+      500,
+    );
+  });
+});
