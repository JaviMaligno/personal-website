+async function getCategoryIdsExcludedFromMonthWideActions(): Promise<
+  Set<string>
+> {
+  const rows = await db.all<{ id: string }>(
+    `
+    SELECT c.id
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.hidden = 1 OR g.hidden = 1 OR c.goal_def IS NOT NULL
+  `,
+  );
+  return new Set(rows.map(row => row.id));
+}
