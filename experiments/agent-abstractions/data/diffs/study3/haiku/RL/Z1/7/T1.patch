+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'visible',
+      name: 'visible',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'in-hidden-group',
+      name: 'in-hidden-group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'templated',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: JSON.stringify([{ type: 'simple', monthly: 100 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  async function setBudgets(month: string, amount: number) {
+    for (const category of [
+      'visible',
+      'hidden-cat',
+      'in-hidden-group',
+      'templated',
+    ]) {
+      await setBudget({ category, month, amount });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  async function expectBudgets(
+    month: string,
+    expected: Record<string, number>,
+  ) {
+    await sheet.waitOnSpreadsheet();
+    for (const [category, amount] of Object.entries(expected)) {
+      expect(
+        await getSheetValue(
+          `budget${month.replace('-', '')}`,
+          `budget-${category}`,
+        ),
+      ).toBe(amount);
+    }
+  }
+
+  it('setZero leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+    await setBudgets('2024-02', 5000);
+
+    await setZero({ month: '2024-02' });
+
+    await expectBudgets('2024-02', {
+      visible: 0,
+      'hidden-cat': 5000,
+      'in-hidden-group': 5000,
+      templated: 5000,
+    });
+  });
+
+  it('set3MonthAvg leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+    await setBudgets('2024-02', 5000);
+
+    await set3MonthAvg({ month: '2024-02' });
+
+    await expectBudgets('2024-02', {
+      visible: 0,
+      'hidden-cat': 5000,
+      'in-hidden-group': 5000,
+      templated: 5000,
+    });
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
