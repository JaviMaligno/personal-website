+const FIXED_COST_TAG_REGEX = /(^|\s)#fixed(?=\s|$)/m;
+
+async function getFixedCostGroupIdsJson(): Promise<string> {
+  const rows = await db.all<{ id: string; note: string }>(
+    `
+    SELECT g.id, n.note
+    FROM category_groups g
+    JOIN notes n ON n.id = g.id
+    WHERE g.tombstone = 0 AND n.note LIKE '%#fixed%'
+  `,
+  );
+  return JSON.stringify(
+    rows.filter(row => FIXED_COST_TAG_REGEX.test(row.note)).map(row => row.id),
+  );
+}
