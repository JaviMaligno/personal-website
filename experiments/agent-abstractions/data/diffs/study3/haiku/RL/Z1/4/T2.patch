+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat1',
+      name: 'cat1',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-no-spending',
+      name: 'no spending',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertTransaction(
+      generateTransaction({
+        id: 'spend1',
+        amount: -3000,
+        account: 'account1',
+        category: 'cat1',
+        date: '2024-03-10',
+      })[0],
+    );
+    await db.insertTransaction(
+      generateTransaction({
+        id: 'spend-hidden',
+        amount: -100,
+        account: 'account1',
+        category: 'cat-hidden',
+        date: '2024-03-11',
+      })[0],
+    );
+    await db.insertTransaction(
+      generateTransaction({
+        id: 'income1',
+        amount: 5000,
+        account: 'account1',
+        category: 'income-cat',
+        date: '2024-03-12',
+      })[0],
+    );
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+  });
+
+  afterEach(async () => {
+    await global.emptyDatabase()();
+  });
+
+  it('budgets each expense category at its previous month spending', async () => {
+    for (const category of ['cat1', 'cat-no-spending', 'cat-hidden']) {
+      await setBudget({ category, month: '2024-04', amount: 1000 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(3000);
+    expect(await getSheetValue('budget202404', 'budget-cat-no-spending')).toBe(
+      0,
+    );
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden')).toBe(1000);
+  });
+
+  it('skips income categories when not tracking the budget', async () => {
+    await setBudget({ category: 'income-cat', month: '2024-04', amount: 777 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(777);
+  });
+
+  it('budgets income categories at the previous month amount received when tracking', async () => {
+    sheet.get().meta().budgetType = 'tracking';
+    await db.update('preferences', { id: 'budgetType', value: 'tracking' });
+    await setBudget({ category: 'income-cat', month: '2024-04', amount: 777 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(5000);
+  });
+});
