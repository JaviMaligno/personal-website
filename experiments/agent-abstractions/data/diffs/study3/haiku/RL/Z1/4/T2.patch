+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const prevMonthSheet = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+  const categories = await getMonthWideTargetCategories();
+
+  const amounts: { category: string; amount: number }[] = [];
+  for (const cat of categories) {
+    if (cat.is_income === 1 && !isTrackingBudget()) {
+      continue;
+    }
+    const netActivity = await getSheetValue(
+      prevMonthSheet,
+      'sum-amount-' + cat.id,
+    );
+    amounts.push({
+      category: cat.id,
+      amount: cat.is_income === 1 ? netActivity : 0 - netActivity,
+    });
+  }
+
+  await batchMessages(async () => {
+    for (const { category, amount } of amounts) {
+      void setBudget({ category, month, amount });
+    }
+  });
+}
