+function setMonthWideAvg(month: string, N: number): Promise<void> {
+  return forEachMonthWideCategory(cat =>
+    setNMonthAvg({ month, N, category: cat.id }),
+  );
+}
+
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const sheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await forEachMonthWideCategory(async cat => {
+    const sumAmount = await getSheetValue(sheetName, 'sum-amount-' + cat.id);
+    const amount = (cat.is_income === 1 ? sumAmount : -sumAmount) || 0;
+    void setBudget({ category: cat.id, month, amount });
+  });
+}
