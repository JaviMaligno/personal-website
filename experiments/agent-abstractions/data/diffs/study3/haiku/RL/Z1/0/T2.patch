+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const sheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await setBudgetsForActionCategories(month, async cat => {
+    const sumAmount = await getSheetValue(sheetName, 'sum-amount-' + cat.id);
+    return cat.is_income === 1 ? sumAmount : 0 - sumAmount;
+  });
+}
