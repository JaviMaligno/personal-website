+async function setBudgetsForActionCategories(
+  month: string,
+  getAmount: (cat: Pick<db.DbCategory, 'id' | 'is_income'>) => Promise<number>,
+): Promise<void> {
+  const categories = await getMonthActionCategories();
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: await getAmount(cat),
+      });
+    }
+  });
+}
