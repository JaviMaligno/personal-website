+describe('month-wide budget actions', () => {
+  let originalCurrentMonth: string | null;
+
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    originalCurrentMonth = global.currentMonth;
+    global.currentMonth = '2024-02';
+
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'cat-in-hidden-group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'templated-cat',
+      name: 'templated-cat',
+      cat_group: 'group1',
+    });
+    await db.updateWithSchema('categories', {
+      id: 'templated-cat',
+      goal_def: JSON.stringify([
+        {
+          type: 'periodic',
+          amount: 500,
+          period: { period: 'month', amount: 1 },
+          starting: '2024-01',
+          priority: 1,
+          directive: 'template',
+        },
+      ]),
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget([
+      '2023-11',
+      '2023-12',
+      '2024-01',
+      '2024-02',
+      '2024-03',
+    ]);
+  });
+
+  afterEach(async () => {
+    global.currentMonth = originalCurrentMonth;
+    await global.emptyDatabase()();
+  });
+
+  async function setBudgetsForAllCategories(month: string, amount: number) {
+    for (const category of [
+      'income-cat',
+      'cat1',
+      'hidden-cat',
+      'cat-in-hidden-group',
+      'templated-cat',
+    ]) {
+      await setBudget({ category, month, amount });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('setZero leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setBudgetsForAllCategories('2024-02', 1000);
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(1000);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(1000);
+    expect(await getSheetValue('budget202402', 'budget-templated-cat')).toBe(
+      1000,
+    );
+    expect(await getSheetValue('budget202402', 'budget-income-cat')).toBe(1000);
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setBudgetsForAllCategories('2024-01', 1000);
+    await setBudgetsForAllCategories('2024-02', 0);
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(1000);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(0);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-templated-cat')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-income-cat')).toBe(0);
+  });
+
+  it('set3MonthAvg leaves hidden, hidden-group and templated categories untouched', async () => {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    for (const category of ['cat1', 'templated-cat']) {
+      await db.insertTransaction({
+        date: '2023-12-15',
+        amount: -300,
+        account: 'account1',
+        category,
+      });
+    }
+    await sheet.waitOnSpreadsheet();
+    await setBudgetsForAllCategories('2024-02', 1000);
+
+    await set3MonthAvg({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(150);
+    expect(await getSheetValue('budget202402', 'budget-templated-cat')).toBe(
+      1000,
+    );
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(1000);
+  });
+});
