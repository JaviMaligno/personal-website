+
+  describe('api/schedules-get', () => {
+    beforeEach(global.emptyDatabase());
+
+    beforeEach(async () => {
+      await prefs.loadPrefs();
+      await loadMappings();
+      await loadRules();
+    });
+
+    afterEach(async () => {
+      await schedulesApp.stopServices();
+      resetState();
+    });
+
+    async function createTestSchedule(
+      name: string,
+      amountCondition: RuleConditionEntity[],
+    ) {
+      const payeeId = await db.insertPayee({ name: `${name} payee` });
+      const id = await createSchedule({
+        schedule: { name, posts_transaction: false },
+        conditions: [
+          { op: 'is', field: 'payee', value: payeeId },
+          { op: 'is', field: 'date', value: '2026-01-15' },
+          ...amountCondition,
+        ],
+      });
+      return id;
+    }
+
+    it('returns the amount as entered and the expected amount for each schedule', async () => {
+      const singleId = await createTestSchedule('Single', [
+        { op: 'is', field: 'amount', value: -5000 },
+      ]);
+      const rangeId = await createTestSchedule('Range', [
+        {
+          op: 'isbetween',
+          field: 'amount',
+          value: { num1: -10100, num2: -20000 },
+        },
+      ]);
+      const noAmountId = await createTestSchedule('No amount', []);
+
+      await loadRules();
+      schedulesApp.startServices();
+
+      const schedules = await handlers['api/schedules-get']();
+      const byId = Object.fromEntries(schedules.map(s => [s.id, s]));
+
+      expect(byId[singleId]).toMatchObject({
+        name: 'Single',
+        amount: -5000,
+        amountOp: 'is',
+        expectedAmount: -5000,
+      });
+      expect(byId[rangeId]).toMatchObject({
+        name: 'Range',
+        amount: { num1: -10100, num2: -20000 },
+        amountOp: 'isbetween',
+        expectedAmount: -20000,
+      });
+      expect(byId[noAmountId].expectedAmount).toBe(0);
+    });
+  });
 });
