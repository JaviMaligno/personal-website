+      expect(getScheduledAmount({ num1: 10100, num2: 20000 })).toBe(20000);
+    });
+
+    it('negates the planned amount when inverse is set', () => {
+      expect(getScheduledAmount({ num1: -10100, num2: -20000 }, true)).toBe(
+        20000,
+      );
+      expect(getScheduledAmount(5000, true)).toBe(-5000);
+    });
+  });
 });
