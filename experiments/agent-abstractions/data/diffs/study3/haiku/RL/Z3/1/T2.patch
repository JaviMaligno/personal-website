+describe('fintegra-accounts-link', () => {
+  const externalAccount = {
+    account_id: 'fin-1',
+    name: 'Everyday',
+    balance: 100,
+    institution: 'Fintegra Bank',
+    orgId: 'org-1',
+  };
+
+  it('creates a bank-synced account grouped under the organisation', async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(
+      app.handlers['fintegra-accounts-link']({
+        externalAccount,
+        offBudget: false,
+      }),
+    ).resolves.toBe('ok');
+
+    const [account] = await db.all<db.DbAccount>(
+      'SELECT * FROM accounts WHERE tombstone = 0',
+    );
+    expect(account).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+      offbudget: 0,
+    });
+
+    const [bank] = await db.all<db.DbBank>(
+      'SELECT bank_id, name FROM banks WHERE id = ?',
+      [account.bank],
+    );
+    expect(bank).toEqual({ bank_id: 'org-1', name: 'Fintegra Bank' });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      account.id,
+      'fin-1',
+      'org-1',
+      undefined,
+      undefined,
+      undefined,
+    );
+  });
+
+  it('refuses a bank account that is already linked and changes nothing', async () => {
+    await setupSimpleFinAccounts([]);
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Existing',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      app.handlers['fintegra-accounts-link']({ externalAccount }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(
+      await db.all<db.DbAccount>('SELECT id FROM accounts WHERE tombstone = 0'),
+    ).toHaveLength(1);
+  });
+});
