 });
+
+describe('findOrCreateLinkedAccount with replaceExistingLink', () => {
+  const newAccount = { name: 'New', official_name: 'New' };
+
+  async function getAccount(id: string) {
+    return await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+      id,
+    ]);
+  }
+
+  it('links a new account and unlinks the account that held the bank account', async () => {
+    const holderId = await insertLinkedAccount({ accountId: 'acc-1' });
+
+    const result = await findOrCreateLinkedAccount({
+      provider: 'simpleFin',
+      providerAccountId: 'acc-1',
+      institution: { name: 'Bank' },
+      bankId: 'bank.example',
+      newAccount,
+      replaceExistingLink: true,
+    });
+
+    expect(await getAccount(result.id)).toEqual(
+      expect.objectContaining({
+        account_id: 'acc-1',
+        account_sync_source: 'simpleFin',
+        bank: result.bank.id,
+      }),
+    );
+    expect(await getAccount(holderId)).toEqual(
+      expect.objectContaining({
+        name: 'Linked',
+        tombstone: 0,
+        closed: 0,
+        account_id: null,
+        account_sync_source: null,
+        bank: null,
+        bank_sync_status: null,
+      }),
+    );
+  });
+
+  it('links into the chosen existing account and unlinks the previous holder', async () => {
+    const holderId = await insertLinkedAccount({ accountId: 'acc-1' });
+    const targetId = await db.insertWithUUID('accounts', {
+      name: 'Target',
+      offbudget: 0,
+      closed: 0,
+    });
+
+    const result = await findOrCreateLinkedAccount({
+      provider: 'simpleFin',
+      providerAccountId: 'acc-1',
+      upgradingId: targetId,
+      institution: { name: 'Bank' },
+      bankId: 'bank.example',
+      newAccount,
+      replaceExistingLink: true,
+    });
+
+    expect(result.id).toBe(targetId);
+    expect(await getAccount(targetId)).toEqual(
+      expect.objectContaining({ account_id: 'acc-1' }),
+    );
+    expect(await getAccount(holderId)).toEqual(
+      expect.objectContaining({ account_id: null, account_sync_source: null }),
+    );
+  });
+
+  it('keeps a closed account that held the bank account closed', async () => {
+    const holderId = await insertLinkedAccount({
+      accountId: 'acc-1',
+      closed: 1,
+    });
+
+    await findOrCreateLinkedAccount({
+      provider: 'simpleFin',
+      providerAccountId: 'acc-1',
+      institution: { name: 'Bank' },
+      bankId: 'bank.example',
+      newAccount,
+      replaceExistingLink: true,
+    });
+
+    expect(await getAccount(holderId)).toEqual(
+      expect.objectContaining({ closed: 1, account_id: null }),
+    );
+  });
+
+  it('makes an ordinary link when no other account holds the bank account', async () => {
+    const result = await findOrCreateLinkedAccount({
+      provider: 'simpleFin',
+      providerAccountId: 'acc-1',
+      institution: { name: 'Bank' },
+      bankId: 'bank.example',
+      newAccount,
+      replaceExistingLink: true,
+    });
+
+    expect(await getAccount(result.id)).toEqual(
+      expect.objectContaining({ account_id: 'acc-1' }),
+    );
+    expect(await db.all('SELECT id FROM accounts')).toHaveLength(1);
+  });
+
+  it('still refuses to link into a closed account and leaves the holder untouched', async () => {
+    const holderId = await insertLinkedAccount({ accountId: 'acc-1' });
+    const closedId = await db.insertWithUUID('accounts', {
+      name: 'Closed',
+      offbudget: 0,
+      closed: 1,
+    });
+    const banksBefore = await getBanks();
+
+    await expect(
+      findOrCreateLinkedAccount({
+        provider: 'simpleFin',
+        providerAccountId: 'acc-1',
+        upgradingId: closedId,
+        institution: { name: 'Bank' },
+        bankId: 'bank.example',
+        newAccount,
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await getBanks()).toEqual(banksBefore);
+    expect(await getAccount(holderId)).toEqual(
+      expect.objectContaining({
+        account_id: 'acc-1',
+        account_sync_source: 'simpleFin',
+      }),
+    );
+  });
+});
