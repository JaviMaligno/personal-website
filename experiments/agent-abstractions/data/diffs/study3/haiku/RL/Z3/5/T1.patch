+async function assertBankAccountNotLinked(
+  provider: AccountSyncSource,
+  accountId: string,
+  upgradingId: AccountEntity['id'] | undefined,
+) {
+  const linked = await db.first<Pick<db.DbAccount, 'id'>>(
+    'SELECT id FROM accounts WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0 AND id IS NOT ?',
+    [provider, accountId, upgradingId ?? null],
+  );
+
+  if (linked) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
+
+function withBankAccountLinkGuard<Args extends LinkAccountBaseParams>(
+  provider: AccountSyncSource,
+  getAccountId: (args: Args) => string,
+  linkHandler: (args: Args) => Promise<string>,
+) {
+  return async (args: Args) => {
+    await assertBankAccountNotLinked(
+      provider,
+      getAccountId(args),
+      args.upgradingId,
+    );
+    return linkHandler(args);
+  };
+}
