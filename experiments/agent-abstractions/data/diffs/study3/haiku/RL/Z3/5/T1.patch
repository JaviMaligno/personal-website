+describe('linking a bank account', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+  const goCardlessLinkHandler = app.handlers['gocardless-accounts-link'];
+
+  const simpleFinAccount = (accountId: string) => ({
+    balance: 0,
+    account_id: accountId,
+    name: 'Checking',
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    orgId: 'org-1',
+  });
+
+  const goCardlessAccount = (accountId: string) => ({
+    balance: 0,
+    account_id: accountId,
+    name: 'Checking',
+    mask: '1234',
+    official_name: 'Checking',
+    institution: { id: 'inst-1', name: 'Bank' },
+  });
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  async function countRows(table: 'accounts' | 'payees' | 'banks') {
+    const row = await db.first<{ count: number }>(
+      `SELECT count(*) as count FROM ${table} WHERE tombstone = 0`,
+    );
+    return row!.count;
+  }
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'ext-1' },
+    ]);
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into an existing account when the bank account is linked elsewhere', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'target', name: 'Target' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'target',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const target = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['target'],
+    );
+    expect(target!.account_id).toBeNull();
+    expect(target!.account_sync_source).toBeNull();
+    expect(target!.bank).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link belongs to a closed account', async () => {
+    insertBank({ id: 'bank1', bank_id: 'sfin-bank', name: 'SimpleFin' });
+    await db.insertAccount({
+      id: 'closed',
+      name: 'Closed',
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the existing link belongs to a deleted account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'deleted', name: 'Deleted', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', ['deleted']);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows the same provider account id under a different provider', async () => {
+    insertBank({ id: 'bank1', bank_id: 'gc-bank', name: 'GoCardless' });
+    await db.insertAccount({
+      id: 'gc',
+      name: 'GoCardless account',
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'existing',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('refuses a GoCardless link when the bank account is already linked through GoCardless', async () => {
+    insertBank({ id: 'bank1', bank_id: 'gc-bank', name: 'GoCardless' });
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing',
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-1',
+        account: goCardlessAccount('ext-1'),
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
