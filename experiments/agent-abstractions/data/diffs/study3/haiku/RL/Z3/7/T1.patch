+describe('assertBankAccountNotLinked', () => {
+  async function insertLinkedAccount(
+    id: string,
+    accountId: string,
+    accountSyncSource: 'simpleFin' | 'goCardless',
+    { closed = false, tombstone = false } = {},
+  ) {
+    await db.insertAccount({
+      id,
+      name: id,
+      account_id: accountId,
+      account_sync_source: accountSyncSource,
+      closed: closed ? 1 : 0,
+    });
+    if (tombstone) {
+      db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', [id]);
+    }
+  }
+
+  it('allows a bank account that no local account holds', async () => {
+    await insertLinkedAccount('acc1', 'bank-a', 'simpleFin');
+
+    await expect(
+      assertBankAccountNotLinked({
+        accountSyncSource: 'simpleFin',
+        accountId: 'bank-b',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('refuses a bank account already held by another account', async () => {
+    await insertLinkedAccount('acc1', 'bank-a', 'simpleFin');
+
+    await expect(
+      assertBankAccountNotLinked({
+        accountSyncSource: 'simpleFin',
+        accountId: 'bank-a',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('refuses when the holding account is closed', async () => {
+    await insertLinkedAccount('acc1', 'bank-a', 'simpleFin', { closed: true });
+
+    await expect(
+      assertBankAccountNotLinked({
+        accountSyncSource: 'simpleFin',
+        accountId: 'bank-a',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('ignores a deleted account', async () => {
+    await insertLinkedAccount('acc1', 'bank-a', 'simpleFin', {
+      tombstone: true,
+    });
+
+    await expect(
+      assertBankAccountNotLinked({
+        accountSyncSource: 'simpleFin',
+        accountId: 'bank-a',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('treats the same account id under a different provider as a different bank account', async () => {
+    await insertLinkedAccount('acc1', 'bank-a', 'goCardless');
+
+    await expect(
+      assertBankAccountNotLinked({
+        accountSyncSource: 'simpleFin',
+        accountId: 'bank-a',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await insertLinkedAccount('acc1', 'bank-a', 'simpleFin');
+
+    await expect(
+      assertBankAccountNotLinked({
+        accountSyncSource: 'simpleFin',
+        accountId: 'bank-a',
+        upgradingId: 'acc1',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('refuses re-linking into a different account when another holds the bank account', async () => {
+    await insertLinkedAccount('acc1', 'bank-a', 'simpleFin');
+    await insertLinkedAccount('acc2', 'bank-b', 'simpleFin');
+
+    await expect(
+      assertBankAccountNotLinked({
+        accountSyncSource: 'simpleFin',
+        accountId: 'bank-a',
+        upgradingId: 'acc2',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+});
