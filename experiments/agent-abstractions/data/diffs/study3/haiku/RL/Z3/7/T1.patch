+/**
+ * Throws if another local account already holds the link to this bank account.
+ * `upgradingId` is the account being linked, so re-linking it is allowed.
+ */
+export async function assertBankAccountNotLinked({
+  accountSyncSource,
+  accountId,
+  upgradingId,
+}: {
+  accountSyncSource: AccountSyncSource;
+  accountId: string;
+  upgradingId?: string;
+}) {
+  const linked = await db.first<Pick<db.DbAccount, 'id'>>(
+    'SELECT id FROM accounts WHERE account_sync_source = ? AND account_id = ? AND id IS NOT ? AND tombstone = 0',
+    [accountSyncSource, accountId, upgradingId ?? null],
+  );
+
+  if (linked) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
