+async function insertLinkedAccount({
+  id,
+  provider = 'simpleFin',
+  accountId,
+  tombstone = 0,
+  closed = 0,
+}: {
+  id: string;
+  provider?: 'simpleFin' | 'goCardless';
+  accountId: string;
+  tombstone?: 0 | 1;
+  closed?: 0 | 1;
+}) {
+  await db.insertWithUUID('accounts', {
+    id,
+    name: id,
+    offbudget: 0,
+    closed,
+    tombstone,
+    account_id: accountId,
+    account_sync_source: provider,
+  });
+}
+
+describe('assertBankAccountNotLinked', () => {
+  it('refuses a bank account already linked to another account', async () => {
+    await insertLinkedAccount({ id: 'existing', accountId: 'ext-1' });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: undefined,
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('refuses when the existing link is on a closed account', async () => {
+    await insertLinkedAccount({ id: 'closed', accountId: 'ext-1', closed: 1 });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: undefined,
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking into the account that already holds the link', async () => {
+    await insertLinkedAccount({ id: 'existing', accountId: 'ext-1' });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: 'existing',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted accounts', async () => {
+    await insertLinkedAccount({
+      id: 'deleted',
+      accountId: 'ext-1',
+      tombstone: 1,
+    });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: undefined,
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('treats the same account id under a different provider as a different bank account', async () => {
+    await insertLinkedAccount({
+      id: 'existing',
+      provider: 'goCardless',
+      accountId: 'ext-1',
+    });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'ext-1',
+        upgradingId: undefined,
+      }),
+    ).resolves.toBeUndefined();
+  });
+});
