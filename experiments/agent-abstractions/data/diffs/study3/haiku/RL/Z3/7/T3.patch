+describe('linking into a closed account', () => {
+  const externalAccount = {
+    account_id: 'sfin-ext-closed',
+    name: 'Checking',
+    balance: 0,
+    institution: 'SimpleFin',
+    orgDomain: 'sfin-bank',
+    orgId: 'sfin-bank',
+  };
+
+  async function setupClosedAccount(linked: boolean) {
+    insertBank({ id: 'bank1', bank_id: 'sfin-bank', name: 'SimpleFin' });
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      bank: linked ? 'bank1' : null,
+      account_id: linked ? 'sfin-ext-closed' : null,
+      account_sync_source: linked ? 'simpleFin' : null,
+    });
+    await db.update('accounts', { id: 'acct1', closed: 1 });
+  }
+
+  const closedError =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+  it('refuses to link a closed account without changing anything', async () => {
+    await setupClosedAccount(false);
+    const countRows = async (table: string) =>
+      (await db.first<{ count: number }>(
+        `SELECT count(*) as count FROM ${table}`,
+      ))!.count;
+    const before = {
+      accounts: await countRows('accounts'),
+      banks: await countRows('banks'),
+      payees: await countRows('payees'),
+    };
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+      }),
+    ).rejects.toThrow(closedError);
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect({
+      accounts: await countRows('accounts'),
+      banks: await countRows('banks'),
+      payees: await countRows('payees'),
+    }).toEqual(before);
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(account).toMatchObject({ account_id: null, closed: 1 });
+  });
+
+  it('refuses to re-link a closed account that already holds the link', async () => {
+    await setupClosedAccount(true);
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+      }),
+    ).rejects.toThrow(closedError);
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('links the account once it is reopened', async () => {
+    await setupClosedAccount(false);
+    await app.handlers['account-reopen']({ id: 'acct1' });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await app.handlers['simplefin-accounts-link']({
+      externalAccount,
+      upgradingId: 'acct1',
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(account).toMatchObject({
+      account_id: 'sfin-ext-closed',
+      account_sync_source: 'simpleFin',
+      closed: 0,
+    });
+  });
+});
