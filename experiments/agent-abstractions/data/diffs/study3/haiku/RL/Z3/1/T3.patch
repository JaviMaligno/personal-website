+describe('closed accounts cannot be linked', () => {
+  const externalAccount = {
+    account_id: 'ext-9',
+    name: 'Savings',
+    balance: 50,
+    institution: 'SimpleFin',
+    orgDomain: 'sfin-bank',
+  };
+  const closedMessage =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+  it('refuses to link into a closed account and changes nothing', async () => {
+    await setupSimpleFinAccounts([]);
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Old',
+      closed: 1,
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+        offBudget: false,
+      }),
+    ).rejects.toThrow(closedMessage);
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    const [account] = await db.all<db.DbAccount>(
+      'SELECT id, account_id, account_sync_source, closed FROM accounts WHERE tombstone = 0',
+    );
+    expect(account).toEqual({
+      id: 'acct1',
+      account_id: null,
+      account_sync_source: null,
+      closed: 1,
+    });
+  });
+
+  it('refuses to re-link a closed account that already holds the link', async () => {
+    await setupSimpleFinAccounts([]);
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Linked',
+      account_id: 'ext-9',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+        offBudget: false,
+      }),
+    ).rejects.toThrow(closedMessage);
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('links a reopened account as usual', async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+    await setupSimpleFinAccounts([]);
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Reopened',
+      closed: 0,
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+        offBudget: false,
+      }),
+    ).resolves.toBe('ok');
+
+    const [account] = await db.all<db.DbAccount>(
+      'SELECT id, account_id, account_sync_source FROM accounts WHERE id = ?',
+      ['acct1'],
+    );
+    expect(account).toEqual({
+      id: 'acct1',
+      account_id: 'ext-9',
+      account_sync_source: 'simpleFin',
+    });
+  });
+});
