+function refuseAlreadyLinkedBankAccount<T extends LinkAccountBaseParams>(
+  provider: AccountSyncSource,
+  getExternalAccountId: (params: T) => string,
+  handler: (params: T) => Promise<string>,
+) {
+  return async (params: T) => {
+    await link.assertBankAccountNotLinked({
+      provider,
+      externalAccountId: getExternalAccountId(params),
+      upgradingId: params.upgradingId,
+    });
+    return handler(params);
+  };
+}
