+describe('assertBankAccountNotLinked', () => {
+  const duplicateMessage =
+    'This bank account is already linked to another account.';
+
+  async function insertLinkedAccount(overrides: {
+    id: string;
+    account_id?: string;
+    account_sync_source?: AccountSyncSource;
+    closed?: 0 | 1;
+    tombstone?: 0 | 1;
+  }) {
+    await db.insertAccount({
+      name: overrides.id,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      ...overrides,
+    });
+  }
+
+  it('allows linking when no account holds the bank account', async () => {
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        externalAccountId: 'ext-1',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('refuses a bank account already linked to another account', async () => {
+    await insertLinkedAccount({ id: 'acct1' });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        externalAccountId: 'ext-1',
+      }),
+    ).rejects.toThrow(duplicateMessage);
+  });
+
+  it('refuses when the existing link belongs to a closed account', async () => {
+    await insertLinkedAccount({ id: 'acct1', closed: 1 });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        externalAccountId: 'ext-1',
+      }),
+    ).rejects.toThrow(duplicateMessage);
+  });
+
+  it('allows linking when the existing link belongs to a deleted account', async () => {
+    await insertLinkedAccount({ id: 'acct1', tombstone: 1 });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        externalAccountId: 'ext-1',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('treats the same account id under a different provider as a different bank account', async () => {
+    await insertLinkedAccount({ id: 'acct1', account_sync_source: 'akahu' });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        externalAccountId: 'ext-1',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await insertLinkedAccount({ id: 'acct1' });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        externalAccountId: 'ext-1',
+        upgradingId: 'acct1',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('refuses linking into a different account when another holds the bank account', async () => {
+    await insertLinkedAccount({ id: 'acct1' });
+    await insertLinkedAccount({ id: 'acct2', account_id: 'ext-2' });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        externalAccountId: 'ext-1',
+        upgradingId: 'acct2',
+      }),
+    ).rejects.toThrow(duplicateMessage);
+  });
+});
