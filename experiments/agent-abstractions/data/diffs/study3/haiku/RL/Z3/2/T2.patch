+describe('linking a Fintegra account', () => {
+  const fintegraLinkHandler = app.handlers['fintegra-accounts-link'];
+
+  const externalAccount = {
+    account_id: 'fin-1',
+    name: 'Checking',
+    balance: 0,
+    institution: 'Fintegra Bank',
+    orgId: 'fin-org-1',
+  };
+
+  beforeEach(async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a bank-synced account named after the Fintegra account', async () => {
+    await expect(fintegraLinkHandler({ externalAccount })).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT a.*, b.bank_id, b.name AS bank_name FROM accounts a JOIN banks b ON b.id = a.bank WHERE a.account_id = ?',
+      ['fin-1'],
+    );
+    expect(account).toMatchObject({
+      name: 'Checking',
+      official_name: 'Checking',
+      account_sync_source: 'fintegra',
+      bank_id: 'fin-org-1',
+      bank_name: 'Fintegra Bank',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      expect.any(String),
+      'fin-1',
+      'fin-org-1',
+      undefined,
+      undefined,
+      undefined,
+    );
+  });
+
+  it('refuses to link a Fintegra account already held by another account', async () => {
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Checking',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(fintegraLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
