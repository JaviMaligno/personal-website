diff --git a/packages/loot-core/src/server/accounts/link.test.ts b/packages/loot-core/src/server/accounts/link.test.ts
index 645fab0..24c1f4b 100644
--- a/packages/loot-core/src/server/accounts/link.test.ts
+++ b/packages/loot-core/src/server/accounts/link.test.ts
@@ -233,4 +233,70 @@ describe('findOrCreateLinkedAccount', () => {
     expect(result.id).toBe(existingId);
     expect(await db.all('SELECT id FROM accounts')).toHaveLength(1);
   });
+
+  it('refuses to link into a closed account without creating a bank', async () => {
+    const closedId = await db.insertWithUUID('accounts', {
+      name: 'Closed',
+      offbudget: 0,
+      closed: 1,
+    });
+    const banksBefore = await getBanks();
+
+    await expect(
+      findOrCreateLinkedAccount({
+        provider: 'simpleFin',
+        providerAccountId: 'acc-3',
+        upgradingId: closedId,
+        institution: { name: 'Bank' },
+        bankId: 'bank.example',
+        newAccount,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await getBanks()).toEqual(banksBefore);
+    expect(
+      await db.all('SELECT account_id FROM accounts WHERE id = ?', [closedId]),
+    ).toEqual([{ account_id: null }]);
+  });
+
+  it('links into a closed account once it has been reopened', async () => {
+    const accountId = await db.insertWithUUID('accounts', {
+      name: 'Reopened',
+      offbudget: 0,
+      closed: 0,
+    });
+
+    const result = await findOrCreateLinkedAccount({
+      provider: 'simpleFin',
+      providerAccountId: 'acc-3',
+      upgradingId: accountId,
+      institution: { name: 'Bank' },
+      bankId: 'bank.example',
+      newAccount,
+    });
+
+    expect(result.id).toBe(accountId);
+  });
+
+  it('refuses to re-link the closed account that already holds the bank account', async () => {
+    const closedId = await insertLinkedAccount({
+      accountId: 'acc-1',
+      closed: 1,
+    });
+
+    await expect(
+      findOrCreateLinkedAccount({
+        provider: 'simpleFin',
+        providerAccountId: 'acc-1',
+        upgradingId: closedId,
+        institution: { name: 'Bank' },
+        bankId: 'bank.example',
+        newAccount,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+  });
 });
