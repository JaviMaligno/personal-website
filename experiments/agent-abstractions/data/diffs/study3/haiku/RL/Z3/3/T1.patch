+// @ts-strict-ignore
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+
+const ALREADY_LINKED_ERROR =
+  'This bank account is already linked to another account.';
+
+const externalAccount = {
+  account_id: 'ext-1',
+  name: 'Checking',
+  institution: 'Bank',
+  orgDomain: 'bank.test',
+  orgId: 'org-1',
+  balance: 0,
+};
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(bankSync.syncAccount).mockResolvedValue({
+    added: [],
+    updated: [],
+    updatedPreview: [],
+  });
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+async function insertExistingAccount(
+  fields: Partial<{
+    name: string;
+    account_id: string;
+    account_sync_source: 'simpleFin' | 'goCardless';
+    closed: number;
+  }> = {},
+) {
+  return db.insertAccount({
+    name: 'Existing',
+    account_id: 'ext-1',
+    account_sync_source: 'simpleFin',
+    ...fields,
+  });
+}
+
+async function countRows(table: 'accounts' | 'payees' | 'banks') {
+  const row = await db.first<{ count: number }>(
+    `SELECT count(*) as count FROM ${table} WHERE tombstone = 0`,
+  );
+  return row.count;
+}
+
+describe('linking a bank account', () => {
+  it('refuses a new account when the bank account is already linked, and creates nothing', async () => {
+    await insertExistingAccount();
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+    const banksBefore = await countRows('banks');
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      ALREADY_LINKED_ERROR,
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(await countRows('banks')).toBe(banksBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another account and leaves the target unchanged', async () => {
+    await insertExistingAccount();
+    const target = await db.insertAccount({ name: 'Target' });
+    const targetBefore = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [target],
+    );
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: target }),
+    ).rejects.toThrow(ALREADY_LINKED_ERROR);
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        target,
+      ]),
+    ).toEqual(targetBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows re-linking into the account that already holds the link', async () => {
+    const holder = await insertExistingAccount();
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: holder }),
+    ).resolves.toBe('ok');
+
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('treats a closed account as still holding the link', async () => {
+    await insertExistingAccount({ closed: 1 });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      ALREADY_LINKED_ERROR,
+    );
+  });
+
+  it('does not treat a deleted account as holding the link', async () => {
+    const deleted = await insertExistingAccount();
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', [deleted]);
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('does not treat the same account id under a different provider as linked', async () => {
+    await insertExistingAccount({ account_sync_source: 'goCardless' });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('does not treat a different account id under the same provider as linked', async () => {
+    await insertExistingAccount({ account_id: 'ext-2' });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+});
