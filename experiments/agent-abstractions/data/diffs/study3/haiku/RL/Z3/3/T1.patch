+async function assertBankAccountNotLinked(
+  provider: BankSyncProviders,
+  accountId: string,
+  upgradingId: AccountEntity['id'] | undefined,
+) {
+  const holder = await db.first<Pick<db.DbAccount, 'id'>>(
+    'SELECT id FROM accounts WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0 AND id IS NOT ?',
+    [provider, accountId, upgradingId ?? null],
+  );
+
+  if (holder) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
+
+function withBankAccountLinkCheck<Params extends LinkAccountBaseParams, Result>(
+  provider: BankSyncProviders,
+  getAccountId: (params: Params) => string,
+  linkAccount: (params: Params) => Promise<Result>,
+) {
+  return async (params: Params) => {
+    await assertBankAccountNotLinked(
+      provider,
+      getAccountId(params),
+      params.upgradingId,
+    );
+    return linkAccount(params);
+  };
+}
