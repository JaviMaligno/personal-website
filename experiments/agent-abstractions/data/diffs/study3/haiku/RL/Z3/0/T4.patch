+describe('linking a bank account already held by another account', () => {
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'External',
+    balance: 0,
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+    institution: 'Bank',
+  };
+
+  async function insertHolder({ closed = 0 }: { closed?: 0 | 1 } = {}) {
+    insertBank({ id: 'bank1', bank_id: 'sfin-bank', name: 'SimpleFin' });
+    await db.insertAccount({
+      id: 'holder',
+      name: 'Old',
+      bank: 'bank1',
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      bank_sync_status: 'ok',
+      closed,
+    });
+  }
+
+  it('is refused without the replace flag', async () => {
+    await insertHolder();
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({ externalAccount }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({ account_id: 'ext-1', account_sync_source: 'simpleFin' });
+  });
+
+  it('moves the bank feed to the new account and unlinks the holder locally', async () => {
+    await insertHolder({ closed: 1 });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await app.handlers['simplefin-accounts-link']({
+      externalAccount,
+      replaceExistingLink: true,
+    });
+
+    const newAccount = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND id != ?',
+      ['ext-1', 'holder'],
+    );
+    expect(newAccount).toMatchObject({
+      account_sync_source: 'simpleFin',
+      tombstone: 0,
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+    expect(vi.mocked(bankSync.syncAccount).mock.calls[0][2]).toBe(
+      newAccount!.id,
+    );
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({
+      name: 'Old',
+      closed: 1,
+      tombstone: 0,
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      bank_sync_status: null,
+    });
+  });
+
+  it('is refused into a closed account even with the replace flag', async () => {
+    await insertHolder();
+    await db.insertAccount({ id: 'closed', name: 'Closed', closed: 1 });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        upgradingId: 'closed',
+        externalAccount,
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'holder',
+      ]),
+    ).toMatchObject({ account_id: 'ext-1', account_sync_source: 'simpleFin' });
+  });
+});
+
