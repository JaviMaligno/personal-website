+  closed?: boolean;
+  tombstone?: boolean;
+}) {
+  await db.insertAccount({
+    id,
+    name: id,
+    account_id: accountId,
+    account_sync_source: provider,
+    closed: closed ? 1 : 0,
+  });
+  if (tombstone) {
+    await db.update('accounts', { id, tombstone: 1 });
+  }
+}
+
+describe('assertBankAccountNotLinked', () => {
+  it('refuses a bank account already linked to another account through the same provider', async () => {
+    await insertLinkedAccount({ id: 'existing', accountId: 'acc-1' });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'acc-1',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('refuses when the holding account is closed', async () => {
+    await insertLinkedAccount({
+      id: 'existing',
+      accountId: 'acc-1',
+      closed: true,
+    });
+
+    await expect(
+      assertBankAccountNotLinked({ provider: 'simpleFin', accountId: 'acc-1' }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking into the account that already holds the bank account', async () => {
+    await insertLinkedAccount({ id: 'existing', accountId: 'acc-1' });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'acc-1',
+        upgradingId: 'existing',
+      }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('refuses linking into a different account when another account holds the bank account', async () => {
+    await insertLinkedAccount({ id: 'existing', accountId: 'acc-1' });
+    await insertLinkedAccount({ id: 'other', accountId: 'acc-2' });
+
+    await expect(
+      assertBankAccountNotLinked({
+        provider: 'simpleFin',
+        accountId: 'acc-1',
+        upgradingId: 'other',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows a bank account whose holding account was deleted', async () => {
+    await insertLinkedAccount({
+      id: 'deleted',
+      accountId: 'acc-1',
+      tombstone: true,
+    });
+
+    await expect(
+      assertBankAccountNotLinked({ provider: 'simpleFin', accountId: 'acc-1' }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('allows the same provider account id under a different provider', async () => {
+    await insertLinkedAccount({
+      id: 'existing',
+      accountId: 'acc-1',
+      provider: 'goCardless',
+    });
+
+    await expect(
+      assertBankAccountNotLinked({ provider: 'simpleFin', accountId: 'acc-1' }),
+    ).resolves.toBeUndefined();
+  });
+
+  it('allows a different provider account id', async () => {
+    await insertLinkedAccount({ id: 'existing', accountId: 'acc-1' });
+
+    await expect(
+      assertBankAccountNotLinked({ provider: 'simpleFin', accountId: 'acc-2' }),
+    ).resolves.toBeUndefined();
+  });
+});
