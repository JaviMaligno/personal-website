+function refuseIfAlreadyLinked<Params extends LinkAccountBaseParams>(
+  provider: BankSyncProviders,
+  getAccountId: (params: Params) => string,
+  linkAccount: (params: Params) => Promise<string>,
+) {
+  return async (params: Params) => {
+    await link.assertBankAccountNotLinked({
+      provider,
+      accountId: getAccountId(params),
+      upgradingId: params.upgradingId,
+    });
+    return linkAccount(params);
+  };
+}
