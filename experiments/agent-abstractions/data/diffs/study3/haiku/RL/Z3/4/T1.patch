+export async function findOrCreateLinkedAccount({
+  provider,
+  providerAccountId,
+  upgradingId,
+  institution,
+  bankId,
+  newAccount,
+  offBudget = false,
+}: {
+  provider: BankSyncProviders;
+  providerAccountId: string;
+  upgradingId?: AccountEntity['id'];
+  institution: Institution | null | undefined;
+  bankId: db.DbBank['bank_id'] | undefined;
+  newAccount: Pick<db.DbAccount, 'name' | 'official_name' | 'mask'>;
+  offBudget?: boolean;
+}): Promise<{ id: string; bank: Pick<db.DbBank, 'id' | 'bank_id'> }> {
+  await assertBankAccountNotLinked({
+    provider,
+    providerAccountId,
+    upgradingId,
+  });
+
+  const bank = await findOrCreateBank(institution, bankId);
+
+  if (upgradingId) {
+    const accRow = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [upgradingId],
+    );
+
+    if (!accRow) {
+      throw new Error(`Account with ID ${upgradingId} not found.`);
+    }
+
+    await db.update('accounts', {
+      id: accRow.id,
+      account_id: providerAccountId,
+      bank: bank.id,
+      account_sync_source: provider,
+    });
+    return { id: accRow.id, bank };
+  }
+
+  const id = uuidv4();
+  await db.insertWithUUID('accounts', {
+    id,
+    account_id: providerAccountId,
+    ...newAccount,
+    bank: bank.id,
+    offbudget: offBudget ? 1 : 0,
+    account_sync_source: provider,
+  });
+  await db.insertPayee({
+    name: '',
+    transfer_acct: id,
+  });
+
+  return { id, bank };
+}
