+/**
+ * Refuses a link when the bank account is already held by another local account
+ * (not deleted, same provider). The account being re-linked is excluded so
+ * refreshing its own connection keeps working.
+ */
+export async function assertBankAccountNotLinked({
+  provider,
+  providerAccountId,
+  upgradingId,
+}: {
+  provider: BankSyncProviders;
+  providerAccountId: string;
+  upgradingId?: string;
+}) {
+  const linked = await db.first<Pick<db.DbAccount, 'id'>>(
+    'SELECT id FROM accounts WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0 AND id IS NOT ?',
+    [provider, providerAccountId, upgradingId ?? null],
+  );
+
+  if (linked) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
