+      startingDate: '2024-01-01',
+      startingBalance: 0,
+    });
+
+    expect(result).toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['fin-1'],
+    );
+    expect(account).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      account_sync_source: 'fintegra',
+    });
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account!.bank,
+    ]);
+    expect(bank).toMatchObject({ bank_id: 'org-1', name: 'Fintegra Bank' });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      account!.id,
+      'fin-1',
+      'org-1',
+      '2024-01-01',
+      0,
+      undefined,
+    );
+  });
+
+  it('refuses to link a bank account already held by another local account', async () => {
+    await linkFintegraAccount({ externalAccount });
+
+    await expect(linkFintegraAccount({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+});
