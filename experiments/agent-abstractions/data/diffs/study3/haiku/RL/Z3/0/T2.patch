+describe('Fintegra link and sync', () => {
+  const fintegraAccount = {
+    account_id: 'fin-account-1',
+    name: 'Fintegra Checking',
+    institution: 'Fintegra Bank',
+    orgId: 'org-1',
+    balance: 1000,
+  };
+
+  function mockFintegraTransactions(response) {
+    handlers['/fintegra/transactions'] = () => response;
+  }
+
+  function linkFintegra(externalAccount, extra = {}) {
+    return accountsApp.handlers['fintegra-accounts-link']({
+      externalAccount,
+      ...extra,
+    });
+  }
+
+  beforeEach(() => {
+    vi.mocked(asyncStorage.getItem).mockResolvedValue('test-token');
+    setSyncingMode('offline');
+    mockFintegraTransactions({
+      transactions: {
+        all: [
+          {
+            booked: true,
+            date: '2017-10-02',
+            payeeName: 'Coffee Shop',
+            transactionAmount: { amount: '-12.34' },
+            transactionId: 'fintegra-tx-1',
+          },
+        ],
+        booked: [],
+        pending: [],
+      },
+      balances: [],
+      startingBalance: 100000,
+    });
+  });
+
+  afterEach(() => {
+    delete handlers['/fintegra/transactions'];
+  });
+
+  test('links a new account and imports transactions with a starting balance', async () => {
+    const result = await linkFintegra(fintegraAccount, {
+      startingDate: '2017-10-01',
+    });
+    expect(result).toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      [fintegraAccount.account_id],
+    );
+    expect(account).toMatchObject({
+      name: 'Fintegra Checking',
+      official_name: 'Fintegra Checking',
+      account_sync_source: 'fintegra',
+      offbudget: 0,
+    });
+
+    const transactions = (await getAllTransactions()).filter(
+      t => t.account === account!.id,
+    );
+    expect(transactions).toHaveLength(2);
+    expect(transactions.reduce((total, t) => total + t.amount, 0)).toBe(100000);
+  });
+
+  test('groups accounts by organisation and institution', async () => {
+    await linkFintegra(fintegraAccount);
+    await linkFintegra({
+      ...fintegraAccount,
+      account_id: 'fin-account-2',
+      name: 'Fintegra Savings',
+    });
+    await linkFintegra({
+      ...fintegraAccount,
+      account_id: 'fin-account-3',
+      orgId: 'org-2',
+    });
+
+    const accounts = await db.all<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_sync_source = ? ORDER BY account_id',
+      ['fintegra'],
+    );
+    const banks = await db.all<db.DbBank>('SELECT * FROM banks');
+
+    expect(accounts[0].bank).toBe(accounts[1].bank);
+    expect(accounts[2].bank).not.toBe(accounts[0].bank);
+    expect(banks.filter(b => b.bank_id === 'org-1')).toHaveLength(1);
+    expect(banks.filter(b => b.bank_id === 'org-2')).toHaveLength(1);
+  });
+
+  test('turns an existing local account into a Fintegra account when upgrading', async () => {
+    const existingId = await db.insertAccount({
+      id: 'local-acct',
+      name: 'Local',
+      offbudget: 0,
+    });
+
+    const result = await linkFintegra(fintegraAccount, {
+      upgradingId: existingId,
+    });
+    expect(result).toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [existingId],
+    );
+    expect(account).toMatchObject({
+      account_id: fintegraAccount.account_id,
+      account_sync_source: 'fintegra',
+    });
+  });
+
+  test('refuses to link a bank account already held by another local account', async () => {
+    await linkFintegra(fintegraAccount);
+
+    await expect(linkFintegra(fintegraAccount)).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+});
