+      name: 'Savings',
+      official_name: 'Savings',
+      account_sync_source: 'fintegra',
+    });
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account.bank,
+    ]);
+    expect(bank).toMatchObject({ bank_id: 'fin-org-1', name: 'Fin Bank' });
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('refuses to link a Fintegra account already held by another local account', async () => {
+    await insertExistingAccount({
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      fintegraLinkHandler({ externalAccount: fintegraAccount }),
+    ).rejects.toThrow(ALREADY_LINKED_ERROR);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
