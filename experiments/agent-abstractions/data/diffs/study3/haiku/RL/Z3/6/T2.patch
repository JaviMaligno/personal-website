+describe('fintegra-accounts-link', () => {
+  const linkFintegraAccountHandler = app.handlers['fintegra-accounts-link'];
+
+  it('links a new account under a bank keyed by organisation and institution', async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    const result = await linkFintegraAccountHandler({
+      externalAccount: {
+        account_id: 'fin-1',
+        balance: 0,
+        name: 'Everyday',
+        institution: 'Fintegra Bank',
+        orgId: 'org-1',
+      },
+      startingDate: '2024-01-01',
+      startingBalance: 1000,
+    });
+
+    expect(result).toBe('ok');
+
+    const account = await db.first<{
+      id: string;
+      name: string;
+      official_name: string;
+      account_sync_source: string;
+      bank: string;
+    }>(
+      'SELECT a.id, a.name, a.official_name, a.account_sync_source, a.bank FROM accounts a WHERE a.account_id = ?',
+      ['fin-1'],
+    );
+    expect(account).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      account_sync_source: 'fintegra',
+    });
+
+    const bank = await db.first<{ bank_id: string; name: string }>(
+      'SELECT bank_id, name FROM banks WHERE id = ?',
+      [account.bank],
+    );
+    expect(bank).toEqual({ bank_id: 'org-1', name: 'Fintegra Bank' });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      account.id,
+      'fin-1',
+      'org-1',
+      '2024-01-01',
+      1000,
+      undefined,
+    );
+  });
+
+  it('refuses a bank account already linked to another account and changes nothing', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Everyday',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+    const accountsBefore = await db.all('SELECT id FROM accounts');
+    const payeesBefore = await db.all('SELECT id FROM payees');
+
+    await expect(
+      linkFintegraAccountHandler({
+        externalAccount: {
+          account_id: 'fin-1',
+          balance: 0,
+          name: 'Everyday again',
+          institution: 'Fintegra Bank',
+          orgId: 'org-1',
+        },
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(await db.all('SELECT id FROM accounts')).toEqual(accountsBefore);
+    expect(await db.all('SELECT id FROM payees')).toEqual(payeesBefore);
+  });
+});
