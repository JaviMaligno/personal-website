+describe('linking a Fintegra account', () => {
+  const fintegraLinkHandler = app.handlers['fintegra-accounts-link'];
+
+  const fintegraAccount = (accountId: string) => ({
+    account_id: accountId,
+    name: 'Everyday',
+    institution: 'Fintegra Bank',
+    orgId: 'org-9',
+    balance: 0,
+  });
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates an account with the fintegra sync source under a bank keyed by org and institution', async () => {
+    await expect(
+      fintegraLinkHandler({
+        externalAccount: fintegraAccount('fg-1'),
+        startingDate: '2026-01-01',
+        startingBalance: 5000,
+      }),
+    ).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0',
+      ['fg-1'],
+    );
+    expect(account!.name).toBe('Everyday');
+    expect(account!.official_name).toBe('Everyday');
+    expect(account!.account_sync_source).toBe('fintegra');
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account!.bank,
+    ]);
+    expect(bank!.bank_id).toBe('org-9');
+    expect(bank!.name).toBe('Fintegra Bank');
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      account!.id,
+      'fg-1',
+      'org-9',
+      '2026-01-01',
+      5000,
+      undefined,
+    );
+  });
+
+  it('refuses to link a Fintegra account already linked to another account', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-9', name: 'Fintegra Bank' });
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing',
+      bank: 'bank1',
+      account_id: 'fg-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      fintegraLinkHandler({ externalAccount: fintegraAccount('fg-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
