+
+describe('linking a bank account that is already linked', () => {
+  const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    balance: 0,
+    institution: 'SimpleFin Bank',
+    orgDomain: 'sfin.example',
+    orgId: 'org-1',
+  };
+
+  async function countAccounts() {
+    const row = await db.first<{ n: number }>(
+      'SELECT count(*) as n FROM accounts',
+    );
+    return row!.n;
+  }
+
+  beforeEach(async () => {
+    await setupSimpleFinAccounts([
+      { id: 'holder', name: 'Checking', accountId: 'ext-1' },
+    ]);
+  });
+
+  it('refuses to link into a new account', async () => {
+    const before = await countAccounts();
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await countAccounts()).toBe(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another existing account and leaves it untouched', async () => {
+    await db.insertAccount({
+      id: 'other',
+      name: 'Savings',
+      account_sync_source: null,
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'other' }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const other = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['other'],
+    );
+    expect(other!.account_id).toBeNull();
+    expect(other!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('still refuses when the holder is closed', async () => {
+    await db.update('accounts', { id: 'holder', closed: 1 });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'holder' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('ignores deleted accounts', async () => {
+    await db.update('accounts', { id: 'holder', tombstone: 1 });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('treats the same account id under a different provider as a different bank account', async () => {
+    await db.update('accounts', {
+      id: 'holder',
+      account_sync_source: 'goCardless',
+    });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+});
