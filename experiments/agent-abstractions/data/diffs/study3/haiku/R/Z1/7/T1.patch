+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat1',
+      name: 'cat1',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'cat-in-hidden-group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'templated-cat',
+      name: 'templated-cat',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await storeTemplates({
+      categoriesWithTemplates: [
+        {
+          id: 'templated-cat',
+          templates: [
+            {
+              type: 'simple',
+              monthly: 100,
+              directive: 'template',
+              priority: 1,
+            },
+          ],
+        },
+      ],
+      source: 'ui',
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+  }
+
+  it('setZero leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'cat-in-hidden-group',
+      'templated-cat',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 999 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(999);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(999);
+    expect(await getSheetValue('budget202402', 'budget-templated-cat')).toBe(
+      999,
+    );
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'cat-in-hidden-group',
+      'templated-cat',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 100 });
+      await setBudget({ category, month: '2024-02', amount: 999 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(100);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(999);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(999);
+    expect(await getSheetValue('budget202402', 'budget-templated-cat')).toBe(
+      999,
+    );
+  });
+});
