+
+describe('month-wide budget actions', () => {
+  let originalCurrentMonth: string | null;
+
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    originalCurrentMonth = global.currentMonth;
+    global.currentMonth = '2024-02';
+  });
+
+  afterEach(async () => {
+    global.currentMonth = originalCurrentMonth;
+    await global.emptyDatabase()();
+  });
+
+  async function setupMonthActionDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'open-cat',
+      name: 'open',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'hidden-group-cat',
+      name: 'in hidden group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'templated-cat',
+      name: 'templated',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await storeTemplates({
+      categoriesWithTemplates: [
+        {
+          id: 'templated-cat',
+          templates: [
+            {
+              type: 'simple',
+              monthly: 100,
+              directive: 'template',
+              priority: 1,
+            },
+          ],
+        },
+      ],
+      source: 'ui',
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02', '2024-03']);
+  }
+
+  const protectedCategories = [
+    'hidden-cat',
+    'hidden-group-cat',
+    'templated-cat',
+  ];
+
+  it('setZero leaves hidden, hidden-group and template-managed categories untouched', async () => {
+    await setupMonthActionDatabase();
+    for (const id of ['open-cat', ...protectedCategories]) {
+      await setBudget({ category: id, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-open-cat')).toBe(0);
+    for (const id of protectedCategories) {
+      expect(await getSheetValue('budget202402', `budget-${id}`)).toBe(500);
+    }
+  });
+
+  it('set3MonthAvg leaves hidden, hidden-group and template-managed categories untouched', async () => {
+    await setupMonthActionDatabase();
+    await db.insertTransaction({
+      date: '2024-01-15',
+      amount: -300,
+      account: 'account1',
+      category: 'open-cat',
+    });
+    for (const id of protectedCategories) {
+      await setBudget({ category: id, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-open-cat')).toBe(300);
+    for (const id of protectedCategories) {
+      expect(await getSheetValue('budget202402', `budget-${id}`)).toBe(500);
+    }
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and template-managed categories untouched', async () => {
+    await setupMonthActionDatabase();
+    for (const id of ['open-cat', ...protectedCategories]) {
+      await setBudget({ category: id, month: '2024-01', amount: 100 });
+      await setBudget({ category: id, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-open-cat')).toBe(100);
+    for (const id of protectedCategories) {
+      expect(await getSheetValue('budget202402', `budget-${id}`)).toBe(500);
+    }
+  });
+});
