+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'cat-in-hidden-group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'cat-with-template',
+      name: 'cat-with-template',
+      cat_group: 'group1',
+      goal_def: JSON.stringify([{ type: 'fixed', amount: 100 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+
+    for (const category of [
+      'cat1',
+      'hidden-cat',
+      'cat-in-hidden-group',
+      'cat-with-template',
+    ]) {
+      await setBudget({ category, month: '2024-03', amount: 300 });
+      await setBudget({ category, month: '2024-04', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('setZero zeroes only categories that are not hidden or template-managed', async () => {
+    await setupDatabase();
+
+    await setZero({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(500);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-hidden-group'),
+    ).toBe(500);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-with-template'),
+    ).toBe(500);
+  });
+
+  it('copyPreviousMonth skips hidden and template-managed categories', async () => {
+    await setupDatabase();
+
+    await copyPreviousMonth({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(300);
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(500);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-hidden-group'),
+    ).toBe(500);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-with-template'),
+    ).toBe(500);
+  });
+});
+
