+
+describe('month-wide budget actions', () => {
+  let originalCurrentMonth: string | null;
+
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    originalCurrentMonth = global.currentMonth;
+    global.currentMonth = '2024-04';
+  });
+
+  afterEach(async () => {
+    global.currentMonth = originalCurrentMonth;
+    await global.emptyDatabase()();
+  });
+
+  async function setupDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat1',
+      name: 'cat1',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'templated-cat',
+      name: 'templated-cat',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.update('categories', {
+      id: 'templated-cat',
+      goal_def: JSON.stringify([{ type: 'fixed', amount: 100 }]),
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'hidden-group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'cat-in-hidden-group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02', '2024-03', '2024-04']);
+  }
+
+  const excludedCategories = [
+    'hidden-cat',
+    'templated-cat',
+    'cat-in-hidden-group',
+  ];
+
+  async function setAllBudgets(month: string, amount: number) {
+    for (const category of ['income-cat', 'cat1', ...excludedCategories]) {
+      await setBudget({ category, month, amount });
+    }
+  }
+
+  it('setZero leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-02', 500);
+
+    await setZero({ month: '2024-02' });
+
+    expect(getBudget({ category: 'cat1', month: '2024-02' })).toBe(0);
+    for (const category of excludedCategories) {
+      expect(getBudget({ category, month: '2024-02' })).toBe(500);
+    }
+    expect(getBudget({ category: 'income-cat', month: '2024-02' })).toBe(500);
+  });
+
+  it('set3MonthAvg leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+    await db.insertTransaction({
+      date: '2024-03-15',
+      amount: -300,
+      account: 'account1',
+      category: 'cat1',
+    });
+    await sheet.waitOnSpreadsheet();
+    await setAllBudgets('2024-04', 500);
+
+    await set3MonthAvg({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: 'cat1', month: '2024-04' })).toBe(300);
+    for (const category of excludedCategories) {
+      expect(getBudget({ category, month: '2024-04' })).toBe(500);
+    }
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and templated categories untouched', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-01', 500);
+    await setAllBudgets('2024-02', 0);
+
+    await copyPreviousMonth({ month: '2024-02' });
+
+    expect(getBudget({ category: 'cat1', month: '2024-02' })).toBe(500);
+    for (const category of excludedCategories) {
+      expect(getBudget({ category, month: '2024-02' })).toBe(0);
+    }
+    expect(getBudget({ category: 'income-cat', month: '2024-02' })).toBe(0);
+  });
+});
