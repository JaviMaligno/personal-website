+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getMonthActionCategories();
+  const prevSheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      const net = await getSheetValue(prevSheetName, 'sum-amount-' + cat.id);
+      const amount = cat.is_income === 1 ? net : -net || 0;
+
+      void setBudget({ category: cat.id, month, amount });
+    }
+  });
+}
