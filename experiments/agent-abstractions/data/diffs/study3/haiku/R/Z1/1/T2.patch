+    await setBudget({ category: 'cat2', month: '2024-03', amount: 900 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202403', 'budget-cat2')).toBe(0);
+  });
+
+  it('leaves income categories untouched in envelope budget mode', async () => {
