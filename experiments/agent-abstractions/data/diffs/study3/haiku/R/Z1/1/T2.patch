+      await setBudget({ category: id, month: '2024-03', amount: 700 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202403', 'budget-cat1')).toBe(300);
