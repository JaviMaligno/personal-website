+      id: 'cat-open',
+      name: 'open',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-hidden',
+      name: 'hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-in-hidden-group',
+      name: 'in hidden group',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await db.insertCategory({
+      id: 'cat-templated',
+      name: 'templated',
+      cat_group: 'group1',
+      is_income: 0,
+      goal_def: JSON.stringify([{ type: 'simple', monthly: 100 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02', '2024-03']);
+  }
+
+  it('setZero leaves hidden and template-managed categories unchanged', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat-open',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-templated',
+    ]) {
+      await setBudget({ category, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat-open')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(500);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(500);
+    expect(await getSheetValue('budget202402', 'budget-cat-templated')).toBe(
+      500,
+    );
+  });
+
+  it('copyPreviousMonth leaves hidden and template-managed categories unchanged', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat-open',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-templated',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 700 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat-open')).toBe(700);
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(0);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-cat-templated')).toBe(0);
+  });
+
+  it('set3MonthAvg leaves hidden and template-managed categories unchanged', async () => {
+    await setupDatabase();
+    for (const category of [
+      'cat-open',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-templated',
+    ]) {
+      await db.insertTransaction({
+        date: '2024-02-15',
+        amount: -300,
+        account: 'account1',
+        category,
+      });
+      await setBudget({ category, month: '2024-03', amount: 999 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202403', 'budget-cat-open')).toBe(300);
+    expect(await getSheetValue('budget202403', 'budget-cat-hidden')).toBe(999);
+    expect(
+      await getSheetValue('budget202403', 'budget-cat-in-hidden-group'),
+    ).toBe(999);
+    expect(await getSheetValue('budget202403', 'budget-cat-templated')).toBe(
+      999,
+    );
+  });
