@@ -578,4 +578,39 @@ describe('month-wide budget actions', () => {
     }
     expect(getBudget({ category: 'income-cat', month: '2024-02' })).toBe(0);
   });
+
+  it('setZero includes hidden and hidden-group categories when requested, still skipping templated and #fixed', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-02', 500);
+
+    await setZero({ month: '2024-02', includeHiddenCategories: true });
+
+    expect(getBudget({ category: 'cat1', month: '2024-02' })).toBe(0);
+    for (const category of ['hidden-cat', 'cat-in-hidden-group']) {
+      expect(getBudget({ category, month: '2024-02' })).toBe(0);
+    }
+    for (const category of ['templated-cat', 'cat-in-fixed-group']) {
+      expect(getBudget({ category, month: '2024-02' })).toBe(500);
+    }
+    expect(getBudget({ category: 'income-cat', month: '2024-02' })).toBe(500);
+  });
+
+  it('copyPreviousMonth includes hidden and hidden-group categories when requested', async () => {
+    await setupDatabase();
+    await setAllBudgets('2024-01', 500);
+    await setAllBudgets('2024-02', 0);
+
+    await copyPreviousMonth({
+      month: '2024-02',
+      includeHiddenCategories: true,
+    });
+
+    for (const category of ['cat1', 'hidden-cat', 'cat-in-hidden-group']) {
+      expect(getBudget({ category, month: '2024-02' })).toBe(500);
+    }
+    for (const category of ['templated-cat', 'cat-in-fixed-group']) {
+      expect(getBudget({ category, month: '2024-02' })).toBe(0);
+    }
+    expect(getBudget({ category: 'income-cat', month: '2024-02' })).toBe(0);
+  });
 });
