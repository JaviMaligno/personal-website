+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden>(
+    `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+  `,
+  );
+
+  const skippedCategoryIds = await getCategoryIdsSkippedByMonthWideActions();
+  const prevSheetName = monthUtils.sheetForMonth(monthUtils.prevMonth(month));
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+      if (skippedCategoryIds.has(cat.id)) {
+        continue;
+      }
+
+      const netAmount = await getSheetValue(
+        prevSheetName,
+        'sum-amount-' + cat.id,
+      );
+
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? netAmount : 0 - netAmount,
+      });
+    }
+  });
+}
