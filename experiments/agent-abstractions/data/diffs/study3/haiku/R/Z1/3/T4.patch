+  it('setZero zeroes hidden and hidden-group categories when includeHiddenCategories is true', async () => {
+    await setupMonthActionDatabase();
+    for (const id of ['open-cat', ...protectedCategories]) {
+      await setBudget({ category: id, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02', includeHiddenCategories: true });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-open-cat')).toBe(0);
