+      500,
+    );
+  });
+
+  it('copyPreviousMonth copies hidden and hidden-group categories when includeHiddenCategories is true', async () => {
+    await setupMonthActionDatabase();
+    for (const id of ['open-cat', ...protectedCategories]) {
+      await setBudget({ category: id, month: '2024-01', amount: 100 });
+      await setBudget({ category: id, month: '2024-02', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({
+      month: '2024-02',
+      includeHiddenCategories: true,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-open-cat')).toBe(100);
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(100);
+    expect(await getSheetValue('budget202402', 'budget-hidden-group-cat')).toBe(
+      100,
+    );
+    expect(await getSheetValue('budget202402', 'budget-templated-cat')).toBe(
+      500,
+    );
+  });
+
+  it('setLastMonthSpending budgets hidden categories when includeHiddenCategories is true', async () => {
+    await setupMonthActionDatabase();
+    await db.insertTransaction({
+      date: '2024-01-15',
+      amount: -300,
+      account: 'account1',
+      category: 'hidden-cat',
+    });
+    await db.insertTransaction({
+      date: '2024-01-15',
+      amount: -300,
+      account: 'account1',
+      category: 'templated-cat',
+    });
+    await setBudget({
+      category: 'templated-cat',
+      month: '2024-02',
+      amount: 500,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({
+      month: '2024-02',
+      includeHiddenCategories: true,
+    });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-hidden-cat')).toBe(300);
+    expect(await getSheetValue('budget202402', 'budget-templated-cat')).toBe(
+      500,
+    );
+  });
 });
