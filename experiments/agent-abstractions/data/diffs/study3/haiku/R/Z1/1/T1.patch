+// Categories that month-wide actions must leave alone: hidden categories,
+// categories in hidden groups, and categories with saved budget templates.
+function getMonthActionCategories(): Promise<
+  db.DbViewCategoryWithGroupHidden[]
+> {
+  return db.all<db.DbViewCategoryWithGroupHidden>(`
+    SELECT c.*
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+      AND c.hidden = 0
+      AND g.hidden = 0
+      AND c.goal_def IS NULL
+  `);
+}
