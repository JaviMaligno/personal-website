+describe('month-wide budget actions skip protected categories', () => {
+  let originalCurrentMonth: string | null;
+
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    originalCurrentMonth = global.currentMonth;
+    global.currentMonth = '2024-03';
+    await setupMonthActionDatabase();
+  });
+
+  afterEach(async () => {
+    global.currentMonth = originalCurrentMonth;
+    await global.emptyDatabase()();
+  });
+
+  it('setZero leaves hidden, hidden-group and templated categories untouched', async () => {
+    for (const id of [
+      'cat1',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-template',
+    ]) {
+      await setBudget({ category: id, month: '2024-02', amount: 700 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202402', 'budget-cat1')).toBe(0);
+    expect(await getSheetValue('budget202402', 'budget-cat-hidden')).toBe(700);
+    expect(
+      await getSheetValue('budget202402', 'budget-cat-in-hidden-group'),
+    ).toBe(700);
+    expect(await getSheetValue('budget202402', 'budget-cat-template')).toBe(
+      700,
+    );
+  });
+
+  it('set3MonthAvg leaves hidden, hidden-group and templated categories untouched', async () => {
+    for (const id of [
+      'cat1',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-template',
+    ]) {
+      await setBudget({ category: id, month: '2024-04', amount: 700 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await set3MonthAvg({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(300);
+    expect(await getSheetValue('budget202404', 'budget-cat-hidden')).toBe(700);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-in-hidden-group'),
+    ).toBe(700);
+    expect(await getSheetValue('budget202404', 'budget-cat-template')).toBe(
+      700,
+    );
+  });
+
+  it('copyPreviousMonth leaves hidden, hidden-group and templated categories untouched', async () => {
+    for (const id of [
+      'cat1',
+      'cat-hidden',
+      'cat-in-hidden-group',
+      'cat-template',
+    ]) {
+      await setBudget({ category: id, month: '2024-02', amount: 300 });
+      await setBudget({ category: id, month: '2024-03', amount: 900 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await copyPreviousMonth({ month: '2024-03' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202403', 'budget-cat1')).toBe(300);
+    expect(await getSheetValue('budget202403', 'budget-cat-hidden')).toBe(900);
+    expect(
+      await getSheetValue('budget202403', 'budget-cat-in-hidden-group'),
+    ).toBe(900);
+    expect(await getSheetValue('budget202403', 'budget-cat-template')).toBe(
+      900,
+    );
+  });
+});
