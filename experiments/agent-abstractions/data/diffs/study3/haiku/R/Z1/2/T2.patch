+describe('setLastMonthSpending', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  async function setupDatabase() {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'group1',
+      name: 'group1',
+      is_income: 0,
+    });
+    await db.insertCategory({ id: 'cat1', name: 'cat1', cat_group: 'group1' });
+    await db.insertCategory({
+      id: 'cat-no-spending',
+      name: 'cat-no-spending',
+      cat_group: 'group1',
+    });
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'hidden-cat',
+      cat_group: 'group1',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'cat-with-template',
+      name: 'cat-with-template',
+      cat_group: 'group1',
+      goal_def: JSON.stringify([{ type: 'fixed', amount: 100 }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+
+    await db.insertTransaction({
+      date: '2024-03-10',
+      amount: -4500,
+      account: 'account1',
+      category: 'cat1',
+    });
+    await db.insertTransaction({
+      date: '2024-03-12',
+      amount: 2000,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await db.insertTransaction({
+      date: '2024-03-15',
+      amount: -100,
+      account: 'account1',
+      category: 'hidden-cat',
+    });
+    await db.insertTransaction({
+      date: '2024-03-15',
+      amount: -100,
+      account: 'account1',
+      category: 'cat-with-template',
+    });
+
+    for (const category of [
+      'cat1',
+      'cat-no-spending',
+      'income-cat',
+      'hidden-cat',
+      'cat-with-template',
+    ]) {
+      await setBudget({ category, month: '2024-04', amount: 999 });
+    }
+    await sheet.waitOnSpreadsheet();
+  }
+
+  it('budgets expense categories to their spending in the previous month', async () => {
+    await setupDatabase();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(4500);
+    expect(await getSheetValue('budget202404', 'budget-cat-no-spending')).toBe(
+      0,
+    );
+  });
+
+  it('leaves hidden and template-managed categories untouched', async () => {
+    await setupDatabase();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(999);
+    expect(
+      await getSheetValue('budget202404', 'budget-cat-with-template'),
+    ).toBe(999);
+  });
+
+  it('leaves income categories untouched in envelope budget mode', async () => {
+    await setupDatabase();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(999);
+  });
+
+  it('budgets income categories to the amount received in the previous month in tracking mode', async () => {
+    await setupDatabase();
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(2000);
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(4500);
+  });
+});
