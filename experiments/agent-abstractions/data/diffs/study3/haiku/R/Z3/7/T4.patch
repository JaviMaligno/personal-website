+describe('replacing an existing bank link', () => {
+  async function getAccount(id: string) {
+    return db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [id]);
+  }
+
+  it('links as a new account and unlinks the account that held the bank account', async () => {
+    await insertLinkedAccount({ id: 'acct1' });
+
+    await simpleFinLinkHandler({
+      externalAccount: externalSimpleFinAccount('ext-1'),
+      replaceExistingLink: true,
+    });
+
+    const previous = await getAccount('acct1');
+    expect(previous.tombstone).toBe(0);
+    expect(previous.account_id).toBeNull();
+    expect(previous.bank).toBeNull();
+    expect(previous.account_sync_source).toBeNull();
+
+    const linked = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0',
+      ['ext-1'],
+    );
+    expect(linked.id).not.toBe('acct1');
+    expect(linked.account_sync_source).toBe('simpleFin');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('keeps the unlinked account open or closed as it was', async () => {
+    await insertLinkedAccount({ id: 'acct1', closed: 1 });
+
+    await simpleFinLinkHandler({
+      externalAccount: externalSimpleFinAccount('ext-1'),
+      replaceExistingLink: true,
+    });
+
+    expect((await getAccount('acct1')).closed).toBe(1);
+  });
+
+  it('links into a chosen existing account and unlinks the previous holder', async () => {
+    await insertLinkedAccount({ id: 'acct1' });
+    await insertLinkedAccount({
+      id: 'acct2',
+      name: 'Other',
+      account_id: null,
+      account_sync_source: null,
+    });
+
+    await simpleFinLinkHandler({
+      externalAccount: externalSimpleFinAccount('ext-1'),
+      upgradingId: 'acct2',
+      replaceExistingLink: true,
+    });
+
+    expect((await getAccount('acct1')).account_sync_source).toBeNull();
+    const acct2 = await getAccount('acct2');
+    expect(acct2.account_id).toBe('ext-1');
+    expect(acct2.account_sync_source).toBe('simpleFin');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('is an ordinary link when no other account holds the bank account', async () => {
+    await simpleFinLinkHandler({
+      externalAccount: externalSimpleFinAccount('ext-1'),
+      replaceExistingLink: true,
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+    expect(await countAccounts()).toBe(1);
+  });
+
+  it('still refuses when the flag is false', async () => {
+    await insertLinkedAccount({ id: 'acct1' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+        replaceExistingLink: false,
+      }),
+    ).rejects.toThrow(ALREADY_LINKED_ERROR);
+
+    expect((await getAccount('acct1')).account_sync_source).toBe('simpleFin');
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into a closed account and leaves the holder untouched', async () => {
+    await insertLinkedAccount({ id: 'acct1' });
+    await insertLinkedAccount({
+      id: 'acct2',
+      closed: 1,
+      account_id: null,
+      account_sync_source: null,
+    });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+        upgradingId: 'acct2',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(CLOSED_ERROR);
+
+    expect((await getAccount('acct1')).account_sync_source).toBe('simpleFin');
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
