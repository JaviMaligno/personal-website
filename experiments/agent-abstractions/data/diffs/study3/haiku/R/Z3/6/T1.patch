+
+describe('linking a bank account that is already linked', () => {
+  const linkSimpleFin = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    balance: 0,
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'SimpleFin',
+    orgDomain: 'sfin-bank',
+    orgId: 'org-1',
+  };
+  const alreadyLinkedMessage =
+    'This bank account is already linked to another account.';
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  async function countRows(table: 'accounts' | 'payees') {
+    const row = await db.first<{ count: number }>(
+      `SELECT count(*) as count FROM ${table} WHERE tombstone = 0`,
+    );
+    return row!.count;
+  }
+
+  it('refuses a new account when the bank account is linked to an existing account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+
+    await expect(
+      linkSimpleFin({ externalAccount, startingBalance: 0 }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to upgrade a different existing account into the link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      linkSimpleFin({ externalAccount, upgradingId: 'acct2' }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    const acct2 = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(acct2!.account_id).toBeNull();
+    expect(acct2!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link belongs to a closed account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', closed: 1 });
+
+    await expect(
+      linkSimpleFin({ externalAccount, startingBalance: 0 }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+  });
+
+  it('allows linking when the existing link belongs to a deleted account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', tombstone: 1 });
+
+    await expect(
+      linkSimpleFin({ externalAccount, startingBalance: 0 }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('allows linking when the same account id is linked through a different provider', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', {
+      id: 'acct1',
+      account_sync_source: 'akahu',
+    });
+
+    await expect(
+      linkSimpleFin({ externalAccount, startingBalance: 0 }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      linkSimpleFin({ externalAccount, upgradingId: 'acct1' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
