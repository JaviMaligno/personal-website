+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+const goCardlessLinkHandler = app.handlers['gocardless-accounts-link'];
+
+const LINK_ERROR = 'This bank account is already linked to another account.';
+
+function insertBank(id: string, bankId: string) {
+  db.runQuery(
+    'INSERT INTO banks (id, bank_id, name, tombstone) VALUES (?, ?, ?, 0)',
+    [id, bankId, 'Bank'],
+  );
+}
+
+async function insertLinkedAccount(
+  id: string,
+  {
+    externalId,
+    source = 'simpleFin',
+    closed = false,
+    tombstone = false,
+  }: {
+    externalId: string;
+    source?: 'simpleFin' | 'goCardless';
+    closed?: boolean;
+    tombstone?: boolean;
+  },
+) {
+  await db.insertAccount({
+    id,
+    name: id,
+    bank: 'bank1',
+    account_id: externalId,
+    account_sync_source: source,
+  });
+  db.runQuery('UPDATE accounts SET closed = ?, tombstone = ? WHERE id = ?', [
+    closed ? 1 : 0,
+    tombstone ? 1 : 0,
+    id,
+  ]);
+}
+
+async function countAccounts() {
+  const row = await db.first<{ count: number }>(
+    'SELECT count(*) AS count FROM accounts',
+  );
+  return row?.count ?? 0;
+}
+
+function simpleFinAccount(accountId: string) {
+  return {
+    balance: 0,
+    account_id: accountId,
+    name: 'Checking',
+    institution: 'Bank',
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+  };
+}
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(bankSync.syncAccount).mockResolvedValue({
+    added: [],
+    updated: [],
+    updatedPreview: [],
+  } as never);
+  await global.emptyDatabase()();
+  await loadMappings();
+  insertBank('bank1', 'sfin-org-1');
+});
+
+describe('linking a bank account that is already linked', () => {
+  it('refuses to link a new account to a bank account held by another account', async () => {
+    await insertLinkedAccount('existing', { externalId: 'ext-1' });
+    const before = await countAccounts();
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(LINK_ERROR);
+
+    expect(await countAccounts()).toBe(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into an existing account when the bank account is held by another', async () => {
+    await insertLinkedAccount('holder', { externalId: 'ext-1' });
+    await insertLinkedAccount('target', { externalId: 'ext-2' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'target',
+      }),
+    ).rejects.toThrow(LINK_ERROR);
+
+    const target = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['target'],
+    );
+    expect(target?.account_id).toBe('ext-2');
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the holding account is closed', async () => {
+    await insertLinkedAccount('closed-holder', {
+      externalId: 'ext-1',
+      closed: true,
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).rejects.toThrow(LINK_ERROR);
+  });
+
+  it('refuses a GoCardless link when a GoCardless account already holds the bank account', async () => {
+    await insertLinkedAccount('gc-holder', {
+      externalId: 'ext-1',
+      source: 'goCardless',
+    });
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-1',
+        account: {
+          balance: 0,
+          account_id: 'ext-1',
+          institution: 'Bank',
+          mask: '0000',
+          name: 'Checking',
+          official_name: 'Checking',
+        },
+      }),
+    ).rejects.toThrow(LINK_ERROR);
+  });
+
+  it('allows linking when the holding account is deleted', async () => {
+    await insertLinkedAccount('deleted-holder', {
+      externalId: 'ext-1',
+      tombstone: true,
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await insertLinkedAccount('gc-holder', {
+      externalId: 'ext-1',
+      source: 'goCardless',
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await insertLinkedAccount('holder', { externalId: 'ext-1' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'holder',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
