+describe('replacing an existing bank account link', () => {
+  it('moves the bank account to a new account and unlinks the holder', async () => {
+    await insertLinkedAccount('holder', { externalId: 'ext-1' });
+    const before = await countAccounts();
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    const holder = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['holder'],
+    );
+    expect(holder).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      closed: 0,
+      tombstone: 0,
+    });
+    expect(await countAccounts()).toBe(before + 1);
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('moves the bank account into an existing account and unlinks the holder', async () => {
+    await insertLinkedAccount('holder', { externalId: 'ext-1' });
+    await insertLinkedAccount('target', { externalId: 'ext-2' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'target',
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    const holder = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['holder'],
+    );
+    const target = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['target'],
+    );
+    expect(holder?.account_id).toBeNull();
+    expect(holder?.account_sync_source).toBeNull();
+    expect(target?.account_id).toBe('ext-1');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('keeps a closed holder closed when unlinking it', async () => {
+    await insertLinkedAccount('closed-holder', {
+      externalId: 'ext-1',
+      closed: true,
+    });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    const holder = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['closed-holder'],
+    );
+    expect(holder).toMatchObject({
+      account_id: null,
+      account_sync_source: null,
+      closed: 1,
+    });
+  });
+
+  it('does not unlink the holder when the flag is false', async () => {
+    await insertLinkedAccount('holder', { externalId: 'ext-1' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        replaceExistingLink: false,
+      }),
+    ).rejects.toThrow(LINK_ERROR);
+
+    const holder = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['holder'],
+    );
+    expect(holder?.account_id).toBe('ext-1');
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('links normally when the flag is set but no account holds the bank account', async () => {
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('still refuses to link into a closed account when the flag is set', async () => {
+    await insertLinkedAccount('holder', { externalId: 'ext-1' });
+    await db.insertAccount({ id: 'closed-target', name: 'closed-target' });
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', [
+      'closed-target',
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'closed-target',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(CLOSED_ERROR);
+
+    const holder = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['holder'],
+    );
+    expect(holder?.account_id).toBe('ext-1');
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
+
 const CLOSED_ERROR =
   'Closed accounts cannot be linked to a bank account. Reopen the account first.';
 
