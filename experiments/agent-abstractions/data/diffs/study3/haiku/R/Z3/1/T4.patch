+    it('still refuses to link into a closed account and leaves the holder unchanged', async () => {
+      await insertLinkedAccount('acct1');
+      await db.insertAccount({ id: 'acct2', name: 'Savings', closed: 1 });
+
+      await expect(
+        simpleFinLink({
+          externalAccount: externalSimpleFinAccount('ext-1'),
+          upgradingId: 'acct2',
