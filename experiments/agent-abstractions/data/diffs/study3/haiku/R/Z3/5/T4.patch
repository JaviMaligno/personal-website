+describe('replacing an existing bank account link', () => {
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    balance: 0,
+    institution: 'Bank',
+    orgId: 'org1',
+    orgDomain: 'bank.example',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  async function getLinkedAccountIds() {
+    const rows = await db.all<{ id: string }>(
+      'SELECT id FROM accounts WHERE account_id = ? AND tombstone = 0',
+      ['ext-1'],
+    );
+    return rows.map(row => row.id);
+  }
+
+  it('creates a new account and unlinks the account that held the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertTransaction({
+      account: 'acct1',
+      date: '2024-01-01',
+      amount: -1000,
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    const previous = await db.getAccount('acct1');
+    expect(previous).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      tombstone: 0,
+      closed: 0,
+    });
+    const txRow = await db.first<{ count: number }>(
+      'SELECT COUNT(*) as count FROM transactions WHERE acct = ? AND tombstone = 0',
+      ['acct1'],
+    );
+    expect(txRow!.count).toBe(1);
+
+    const linked = await getLinkedAccountIds();
+    expect(linked).toHaveLength(1);
+    expect(linked[0]).not.toBe('acct1');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('links into an existing account and unlinks the account that held the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Fresh checking' });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct2',
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(await getLinkedAccountIds()).toEqual(['acct2']);
+    expect(await db.getAccount('acct1')).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('keeps a closed account closed when it is unlinked', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.updateAccount({ id: 'acct1', closed: 1 });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(await db.getAccount('acct1')).toMatchObject({
+      account_id: null,
+      account_sync_source: null,
+      closed: 1,
+    });
+  });
+
+  it('links normally when no other account holds the bank account', async () => {
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct2',
+        replaceExistingLink: true,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(await getLinkedAccountIds()).toEqual(['acct2']);
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('still refuses to link into a closed account even with the flag', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+    await db.updateAccount({ id: 'acct2', closed: 1 });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct2',
+        replaceExistingLink: true,
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await db.getAccount('acct1')).toMatchObject({
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    expect(await db.getAccount('acct2')).toMatchObject({
+      account_id: null,
+      account_sync_source: null,
+    });
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the flag is explicitly false', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        replaceExistingLink: false,
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(await db.getAccount('acct1')).toMatchObject({
+      account_id: 'ext-1',
+    });
+  });
+});
