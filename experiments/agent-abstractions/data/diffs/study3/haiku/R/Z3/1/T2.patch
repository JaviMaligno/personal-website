+
+describe('linking a Fintegra account', () => {
+  const fintegraLink = app.handlers['fintegra-accounts-link'];
+
+  const externalFintegraAccount = {
+    account_id: 'fin-1',
+    name: 'Everyday',
+    institution: 'Bank',
+    orgId: 'org-1',
+    balance: 0,
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a Fintegra-sourced account named after the external account', async () => {
+    await expect(
+      fintegraLink({
+        externalAccount: externalFintegraAccount,
+        offBudget: true,
+        startingDate: '2026-01-01',
+        startingBalance: 1000,
+      }),
+    ).resolves.toBe('ok');
+
+    const acct = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0',
+      ['fin-1'],
+    );
+    expect(acct).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      offbudget: 1,
+      account_sync_source: 'fintegra',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      acct!.id,
+      'fin-1',
+      'org-1',
+      '2026-01-01',
+      1000,
+    );
+  });
+
+  it('groups accounts under one bank per organisation and institution', async () => {
+    await fintegraLink({ externalAccount: externalFintegraAccount });
+    await fintegraLink({
+      externalAccount: { ...externalFintegraAccount, account_id: 'fin-2' },
+    });
+
+    const banks = await db.first<{ count: number }>(
+      'SELECT count(*) as count FROM banks WHERE bank_id = ?',
+      ['org-1'],
+    );
+    expect(banks!.count).toBe(1);
+  });
+
+  it('refuses a bank account already linked through Fintegra', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'acct1',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      fintegraLink({ externalAccount: externalFintegraAccount }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+});
