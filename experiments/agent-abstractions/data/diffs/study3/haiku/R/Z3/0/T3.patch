+
+  it('refuses linking into a closed account and leaves it unchanged', async () => {
+    await db.insertAccount({ id: 'acct2', name: 'Savings', closed: 1 });
+    const before = await accountRow('acct2');
+
+    await expect(
+      simpleFinLink({ externalAccount, upgradingId: 'acct2' }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await accountRow('acct2')).toEqual(before);
+    expect(await db.all('SELECT id FROM banks')).toHaveLength(0);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses re-linking when the closed account already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+    const before = await accountRow('acct1');
+
+    await expect(
+      simpleFinLink({ externalAccount, upgradingId: 'acct1' }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await accountRow('acct1')).toEqual(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows linking into an account once it has been reopened', async () => {
+    await db.insertAccount({ id: 'acct2', name: 'Savings', closed: 1 });
+    db.runQuery('UPDATE accounts SET closed = 0 WHERE id = ?', ['acct2']);
+
+    await simpleFinLink({ externalAccount, upgradingId: 'acct2' });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
 });
 
