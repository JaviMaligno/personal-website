+
+describe('linking a Fintegra account', () => {
+  const linkFintegra = app.handlers['fintegra-accounts-link'];
+  const externalAccount = {
+    balance: 0,
+    account_id: 'fin-1',
+    name: 'Everyday',
+    institution: 'Fintegra Bank',
+    orgId: 'org-1',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a bank-synced account named after the Fintegra account', async () => {
+    await expect(
+      linkFintegra({ externalAccount, startingBalance: 0 }),
+    ).resolves.toBe('ok');
+
+    const acct = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0',
+      ['fin-1'],
+    );
+    expect(acct).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      account_sync_source: 'fintegra',
+      offbudget: 0,
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      acct!.id,
+      'fin-1',
+      expect.any(String),
+      undefined,
+      0,
+    );
+  });
+
+  it('groups accounts under one bank per organisation and institution', async () => {
+    await linkFintegra({ externalAccount, startingBalance: 0 });
+    await linkFintegra({
+      externalAccount: { ...externalAccount, account_id: 'fin-2' },
+      startingBalance: 0,
+    });
+
+    const banks = await db.all<db.DbBank>(
+      'SELECT * FROM banks WHERE tombstone = 0',
+    );
+    expect(banks).toHaveLength(1);
+    expect(banks[0]).toMatchObject({
+      bank_id: 'org-1',
+      name: 'Fintegra Bank',
+    });
+  });
+
+  it('refuses a bank account already linked to another local account', async () => {
+    await linkFintegra({ externalAccount, startingBalance: 0 });
+
+    await expect(
+      linkFintegra({ externalAccount, startingBalance: 0 }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+});
