+describe('linking a bank account that is already linked', () => {
+  const duplicateError =
+    'This bank account is already linked to another account.';
+  const externalAccount = {
+    account_id: 'ext-1',
+    name: 'Checking',
+    balance: 0,
+    institution: 'Bank',
+    orgId: 'org1',
+    orgDomain: 'bank.example',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  async function countAccounts() {
+    const row = await db.first<{ count: number }>(
+      'SELECT COUNT(*) as count FROM accounts WHERE tombstone = 0',
+    );
+    return row!.count;
+  }
+
+  it('refuses to create a new account for an already linked bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    const before = await countAccounts();
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({ externalAccount }),
+    ).rejects.toThrow(duplicateError);
+
+    expect(await countAccounts()).toBe(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another account and leaves that account untouched', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct2',
+      }),
+    ).rejects.toThrow(duplicateError);
+
+    const account = await db.getAccount('acct2');
+    expect(account!.account_id).toBeNull();
+    expect(account!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('still refuses when the existing link belongs to a closed account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.updateAccount({ id: 'acct1', closed: 1 });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({ externalAccount }),
+    ).rejects.toThrow(duplicateError);
+  });
+
+  it('allows linking when the existing link belongs to a deleted account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.updateAccount({ id: 'acct1', tombstone: 1 });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({ externalAccount }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows linking when the same account id is linked under a different provider', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      app.handlers['gocardless-accounts-link']({
+        requisitionId: 'req-1',
+        account: {
+          account_id: 'ext-1',
+          name: 'Checking',
+          official_name: 'Checking',
+          mask: '1234',
+          balance: 0,
+          institution: { name: 'Bank' },
+        },
+      }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
+
