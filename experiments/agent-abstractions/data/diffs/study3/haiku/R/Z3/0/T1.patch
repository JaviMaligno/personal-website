+describe('linking a bank account', () => {
+  const simpleFinLink = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    balance: 0,
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'Bank',
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  async function accountRow(id: string) {
+    return db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [id]);
+  }
+
+  it('refuses a new account for a bank account that is already linked', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(simpleFinLink({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const rows = await db.all<db.DbAccount>('SELECT * FROM accounts');
+    expect(rows).toHaveLength(1);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses linking into another account and leaves that account unchanged', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+    const before = await accountRow('acct2');
+
+    await expect(
+      simpleFinLink({ externalAccount, upgradingId: 'acct2' }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await accountRow('acct2')).toEqual(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await simpleFinLink({ externalAccount, upgradingId: 'acct1' });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('allows the same provider account id under a different provider', async () => {
+    await db.insertAccount({
+      id: 'acct2',
+      name: 'Other',
+      account_id: 'ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await simpleFinLink({ externalAccount });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('allows linking a bank account whose previous holder was deleted', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', ['acct1']);
+
+    await simpleFinLink({ externalAccount });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('refuses when the holder is closed', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Checking',
+      closed: 1,
+      bank: null,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(simpleFinLink({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+});
+
