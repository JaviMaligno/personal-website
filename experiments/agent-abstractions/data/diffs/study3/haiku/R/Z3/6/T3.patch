+describe('linking into a closed account', () => {
+  const linkSimpleFin = app.handlers['simplefin-accounts-link'];
+  const externalAccount = {
+    balance: 0,
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'SimpleFin',
+    orgDomain: 'sfin-bank',
+    orgId: 'org-1',
+  };
+  const closedMessage =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses to upgrade a closed account and leaves it unchanged', async () => {
+    insertBank({ id: 'bank1', bank_id: 'sfin-bank', name: 'SimpleFin' });
+    await db.insertAccount({ id: 'acct2', name: 'Savings', closed: 1 });
+    const accountBefore = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    const accountsBefore = await db.first<{ count: number }>(
+      'SELECT count(*) as count FROM accounts WHERE tombstone = 0',
+    );
+
+    await expect(
+      linkSimpleFin({ externalAccount, upgradingId: 'acct2' }),
+    ).rejects.toThrow(closedMessage);
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'acct2',
+      ]),
+    ).toEqual(accountBefore);
+    expect(
+      await db.first<{ count: number }>(
+        'SELECT count(*) as count FROM accounts WHERE tombstone = 0',
+      ),
+    ).toEqual(accountsBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to re-link a closed account that already holds the link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', closed: 1 });
+
+    await expect(
+      linkSimpleFin({ externalAccount, upgradingId: 'acct1' }),
+    ).rejects.toThrow(closedMessage);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows linking once the account is reopened', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', closed: 1 });
+    await db.update('accounts', { id: 'acct1', closed: 0 });
+
+    await expect(
+      linkSimpleFin({ externalAccount, upgradingId: 'acct1' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
+
