+      account_sync_source: 'fintegra',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('groups accounts under one bank per organisation and institution', async () => {
+    await fintegraLink({ externalAccount });
