+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a fintegra account named after the external account and syncs it', async () => {
+    await expect(fintegraLink({ externalAccount })).resolves.toBe('ok');
+
+    const row = await db.first<db.DbAccount>('SELECT * FROM accounts');
+    expect(row).toMatchObject({
+      name: 'Checking',
+      official_name: 'Checking',
