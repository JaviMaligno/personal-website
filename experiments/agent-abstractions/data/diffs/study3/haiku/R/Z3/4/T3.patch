+const CLOSED_ERROR =
+  'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+describe('linking into a closed account', () => {
+  it('refuses to link into a closed account', async () => {
+    await db.insertAccount({ id: 'closed-target', name: 'closed-target' });
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', [
+      'closed-target',
+    ]);
+    const before = await countAccounts();
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'closed-target',
+      }),
+    ).rejects.toThrow(CLOSED_ERROR);
+
+    const target = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['closed-target'],
+    );
+    expect(target?.account_id).toBeNull();
+    expect(target?.account_sync_source).toBeNull();
+    expect(await countAccounts()).toBe(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to re-link the closed account that already holds the bank account', async () => {
+    await insertLinkedAccount('closed-holder', {
+      externalId: 'ext-1',
+      closed: true,
+    });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'closed-holder',
+      }),
+    ).rejects.toThrow(CLOSED_ERROR);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows linking once the account is reopened', async () => {
+    await db.insertAccount({ id: 'reopened', name: 'reopened' });
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['reopened']);
+    await app.handlers['account-reopen']({ id: 'reopened' });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: simpleFinAccount('ext-1'),
+        upgradingId: 'reopened',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('still allows linking a bank account as a new account', async () => {
+    await insertLinkedAccount('closed-other', {
+      externalId: 'ext-2',
+      closed: true,
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount: simpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+  });
+});
+
