+
+describe('linking a Fintegra account', () => {
+  const fintegraLinkHandler = app.handlers['fintegra-accounts-link'];
+
+  const externalAccount = {
+    account_id: 'fin-1',
+    name: 'Checking',
+    balance: 100,
+    institution: 'Fintegra Bank',
+    orgId: 'org-1',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('creates a bank-synced account grouped under the organisation', async () => {
+    await expect(
+      fintegraLinkHandler({
+        externalAccount,
+        startingDate: '2024-01-01',
+        startingBalance: 5000,
+      }),
+    ).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ?',
+      ['fin-1'],
+    );
+    expect(account!.account_sync_source).toBe('fintegra');
+    expect(account!.name).toBe('Checking');
+    expect(account!.official_name).toBe('Checking');
+
+    const bank = await db.first<db.DbBank>('SELECT * FROM banks WHERE id = ?', [
+      account!.bank,
+    ]);
+    expect(bank!.bank_id).toBe('org-1');
+    expect(bank!.name).toBe('Fintegra Bank');
+
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      account!.id,
+      'fin-1',
+      'org-1',
+      '2024-01-01',
+      5000,
+    );
+  });
+
+  it('refuses to link a Fintegra account already held by another account', async () => {
+    insertBank({ id: 'bank1', bank_id: 'org-1', name: 'Fintegra Bank' });
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      bank: 'bank1',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(fintegraLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('upgrades an existing local account into a bank-synced one', async () => {
+    await db.insertAccount({ id: 'local', name: 'Savings' });
+
+    await expect(
+      fintegraLinkHandler({ externalAccount, upgradingId: 'local' }),
+    ).resolves.toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['local'],
+    );
+    expect(account!.account_id).toBe('fin-1');
+    expect(account!.account_sync_source).toBe('fintegra');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
