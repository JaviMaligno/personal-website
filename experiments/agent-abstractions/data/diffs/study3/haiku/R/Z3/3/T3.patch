+
+  describe('when the target account is closed', () => {
+    const closedMessage =
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+    it('refuses to upgrade a closed account and leaves it and the banks unchanged', async () => {
+      await db.insertAccount({ id: 'closed', name: 'Savings' });
+      await db.update('accounts', { id: 'closed', closed: 1 });
+      const banksBefore = await db.all<db.DbBank>('SELECT id FROM banks');
+
+      await expect(
+        simpleFinLinkHandler({ externalAccount, upgradingId: 'closed' }),
+      ).rejects.toThrow(closedMessage);
+
+      const account = await db.first<db.DbAccount>(
+        'SELECT * FROM accounts WHERE id = ?',
+        ['closed'],
+      );
+      expect(account!.account_id).toBeNull();
+      expect(account!.account_sync_source).toBeNull();
+      expect(account!.closed).toBe(1);
+      expect(await db.all<db.DbBank>('SELECT id FROM banks')).toEqual(
+        banksBefore,
+      );
+      expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    });
+
+    it('refuses to re-link a closed account that already holds the link', async () => {
+      await setupSimpleFinAccounts([
+        { id: 'existing', name: 'Checking', accountId: 'ext-1' },
+      ]);
+      await db.update('accounts', { id: 'existing', closed: 1 });
+
+      await expect(
+        simpleFinLinkHandler({ externalAccount, upgradingId: 'existing' }),
+      ).rejects.toThrow(closedMessage);
+      expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    });
+
+    it('allows linking once the account is reopened', async () => {
+      await db.insertAccount({ id: 'closed', name: 'Savings' });
+      await db.update('accounts', { id: 'closed', closed: 1 });
+      await db.update('accounts', { id: 'closed', closed: 0 });
+
+      await expect(
+        simpleFinLinkHandler({ externalAccount, upgradingId: 'closed' }),
+      ).resolves.toBe('ok');
+      expect(bankSync.syncAccount).toHaveBeenCalled();
+    });
+  });
 });
 
