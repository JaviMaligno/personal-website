+// @ts-strict-ignore
+import * as asyncStorage from '#platform/server/asyncStorage';
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+const simpleFinLinkHandler = app.handlers['simplefin-accounts-link'];
+const goCardlessLinkHandler = app.handlers['gocardless-accounts-link'];
+
+const ALREADY_LINKED_ERROR =
+  'This bank account is already linked to another account.';
+
+function externalSimpleFinAccount(accountId: string) {
+  return {
+    account_id: accountId,
+    name: 'Checking',
+    institution: 'Bank',
+    orgDomain: 'bank.example',
+    orgId: 'org-1',
+    balance: 0,
+  };
+}
+
+async function countAccounts() {
+  const row = await db.first<{ n: number }>(
+    'SELECT count(*) as n FROM accounts WHERE tombstone = 0',
+  );
+  return row.n;
+}
+
+async function insertLinkedAccount(
+  overrides: Partial<db.DbAccount> & { id: string },
+) {
+  await db.insertAccount({
+    name: 'Existing',
+    bank: 'bank1',
+    account_id: 'ext-1',
+    account_sync_source: 'simpleFin',
+    ...overrides,
+  });
+}
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(asyncStorage.multiGet).mockResolvedValue({
+    'user-id': 'user-1',
+    'user-key': 'key-1',
+  });
+  vi.mocked(bankSync.syncAccount).mockResolvedValue({
+    added: [],
+    updated: [],
+    updatedPreview: [],
+  });
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+describe('linking a bank account that is already linked', () => {
+  it('refuses to link as a new account', async () => {
+    await insertLinkedAccount({ id: 'acct1' });
+    const before = await countAccounts();
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+      }),
+    ).rejects.toThrow(ALREADY_LINKED_ERROR);
+
+    expect(await countAccounts()).toBe(before);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into a different existing account', async () => {
+    await insertLinkedAccount({ id: 'acct1' });
+    await insertLinkedAccount({
+      id: 'acct2',
+      name: 'Other',
+      account_id: null,
+      account_sync_source: null,
+    });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+        upgradingId: 'acct2',
+      }),
+    ).rejects.toThrow(ALREADY_LINKED_ERROR);
+
+    const acct2 = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(acct2.account_id).toBeNull();
+    expect(acct2.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the holding account is closed', async () => {
+    await insertLinkedAccount({ id: 'acct1', closed: 1 });
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+      }),
+    ).rejects.toThrow(ALREADY_LINKED_ERROR);
+  });
+
+  it('ignores a deleted account that held the link', async () => {
+    await insertLinkedAccount({ id: 'acct1', tombstone: 1 });
+
+    await simpleFinLinkHandler({
+      externalAccount: externalSimpleFinAccount('ext-1'),
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('treats the same account id under a different provider as a different bank account', async () => {
+    await insertLinkedAccount({
+      id: 'acct1',
+      account_sync_source: 'goCardless',
+    });
+
+    await simpleFinLinkHandler({
+      externalAccount: externalSimpleFinAccount('ext-1'),
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('refuses a GoCardless link when the account is held by GoCardless', async () => {
+    await insertLinkedAccount({
+      id: 'acct1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(
+      goCardlessLinkHandler({
+        requisitionId: 'req-1',
+        account: {
+          account_id: 'ext-1',
+          name: 'Checking',
+          institution: { name: 'Bank' },
+          mask: null,
+          official_name: null,
+          balance: 0,
+        },
+      }),
+    ).rejects.toThrow(ALREADY_LINKED_ERROR);
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await insertLinkedAccount({ id: 'acct1' });
+
+    await simpleFinLinkHandler({
+      externalAccount: externalSimpleFinAccount('ext-1'),
+      upgradingId: 'acct1',
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
