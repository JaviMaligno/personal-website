+describe('simpleFinAccountsLink', () => {
+  const externalAccount = {
+    balance: 0,
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'SimpleFin Bank',
+    orgId: 'org-1',
+    orgDomain: 'bank.example',
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses to link a bank account already linked to another account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const accounts = await db.all<db.DbAccount>(
+      'SELECT id FROM accounts WHERE tombstone = 0',
+    );
+    expect(accounts.map(a => a.id)).toEqual(['acct1']);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses to link into another existing account when the bank account is linked elsewhere', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Empty' });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'acct2' }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const acct2 = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(acct2!.account_id).toBeNull();
+    expect(acct2!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('still refuses when the account holding the link is closed', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET closed = 1 WHERE id = ?', ['acct1']);
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows linking when the holder of the link has been deleted', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', ['acct1']);
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows the same provider account id under a different provider', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery(
+      "UPDATE accounts SET account_sync_source = 'goCardless' WHERE id = ?",
+      ['acct1'],
+    );
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'acct1' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
