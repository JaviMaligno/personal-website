+describe('Fintegra sync', () => {
+  afterEach(() => {
+    delete handlers['/fintegra/transactions'];
+  });
+
+  test('later syncs download transactions from the fintegra endpoint', async () => {
+    vi.mocked(asyncStorage.getItem).mockResolvedValue('test-token');
+    vi.mocked(asyncStorage.multiGet).mockResolvedValue({
+      'user-id': 'user-1',
+      'user-key': 'key-1',
+    });
+    const requests: unknown[] = [];
+    handlers['/fintegra/transactions'] = (body: unknown) => {
+      requests.push(body);
+      return {
+        transactions: {
+          all: [
+            {
+              booked: true,
+              date: '2017-10-02',
+              payeeName: 'Coffee Shop',
+              transactionAmount: { amount: '-12.34' },
+              transactionId: 'fintegra-tx-1',
+            },
+          ],
+          booked: [],
+          pending: [],
+        },
+        balances: [],
+        startingBalance: 10000,
+      };
+    };
+
+    const linkRes = await accountsApp.handlers['fintegra-accounts-link']({
+      externalAccount: {
+        account_id: 'fin-1',
+        name: 'Everyday',
+        institution: 'Fintegra Bank',
+        orgId: 'org-1',
+        balance: 100,
+      },
+    });
+    expect(linkRes).toBe('ok');
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0',
+      ['fin-1'],
+    );
+
+    setSyncingMode('offline');
+    try {
+      global.stepForwardInTime();
+      const res = await accountsApp.handlers['accounts-bank-sync']({
+        ids: [account!.id],
+      });
+      expect(res.errors).toHaveLength(0);
+    } finally {
+      setSyncingMode('enabled');
+    }
+
+    expect(requests).toEqual([
+      expect.objectContaining({ accountId: 'fin-1' }),
+      expect.objectContaining({ accountId: 'fin-1' }),
+    ]);
+  });
+});
