+describe('fintegra-accounts-link', () => {
+  const externalAccount = {
+    account_id: 'fin-1',
+    name: 'Everyday',
+    institution: 'Fintegra Bank',
+    orgId: 'org-1',
+    balance: 100,
+  };
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  async function getBanks() {
+    return db.all<{ bank_id: string; name: string }>(
+      'SELECT bank_id, name FROM banks WHERE tombstone = 0',
+    );
+  }
+
+  it('creates a fintegra account named after the external account and syncs it', async () => {
+    await expect(
+      app.handlers['fintegra-accounts-link']({
+        externalAccount,
+        offBudget: true,
+        startingDate: '2024-01-01',
+        startingBalance: 5000,
+      }),
+    ).resolves.toBe('ok');
+
+    const row = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0',
+      ['fin-1'],
+    );
+    expect(row).toMatchObject({
+      name: 'Everyday',
+      official_name: 'Everyday',
+      offbudget: 1,
+      account_sync_source: 'fintegra',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      row!.id,
+      'fin-1',
+      'org-1',
+      '2024-01-01',
+      5000,
+    );
+  });
+
+  it('groups accounts by organisation and institution name', async () => {
+    await app.handlers['fintegra-accounts-link']({ externalAccount });
+    await app.handlers['fintegra-accounts-link']({
+      externalAccount: { ...externalAccount, account_id: 'fin-2' },
+    });
+    await app.handlers['fintegra-accounts-link']({
+      externalAccount: {
+        ...externalAccount,
+        account_id: 'fin-3',
+        institution: 'Other Bank',
+      },
+    });
+
+    expect(await getBanks()).toEqual(
+      expect.arrayContaining([
+        { bank_id: 'org-1', name: 'Fintegra Bank' },
+        { bank_id: 'org-1', name: 'Other Bank' },
+      ]),
+    );
+    expect(await getBanks()).toHaveLength(2);
+  });
+
+  it('turns an existing local account into a fintegra account when upgrading', async () => {
+    await db.insertAccount({ id: 'acct1', name: 'Manual' });
+
+    await expect(
+      app.handlers['fintegra-accounts-link']({
+        externalAccount,
+        upgradingId: 'acct1',
+      }),
+    ).resolves.toBe('ok');
+
+    const account = await db.getAccount('acct1');
+    expect(account).toMatchObject({
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+    expect(account!.name).toBe('Manual');
+  });
+
+  it('refuses to link a fintegra account that another local account already holds', async () => {
+    await db.insertAccount({
+      id: 'acct1',
+      name: 'Everyday',
+      account_id: 'fin-1',
+      account_sync_source: 'fintegra',
+    });
+
+    await expect(
+      app.handlers['fintegra-accounts-link']({ externalAccount }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
