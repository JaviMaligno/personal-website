+
+describe('replacing an existing bank account link', () => {
+  const linkSimpleFin = app.handlers['simplefin-accounts-link'];
+  const linkGoCardless = app.handlers['gocardless-accounts-link'];
+  const externalAccount = {
+    balance: 0,
+    account_id: 'ext-1',
+    name: 'Checking',
+    institution: 'SimpleFin',
+    orgDomain: 'sfin-bank',
+    orgId: 'org-1',
+  };
+  const alreadyLinkedMessage =
+    'This bank account is already linked to another account.';
+  const closedMessage =
+    'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  async function getAccount(id: string) {
+    return db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [id]);
+  }
+
+  function expectUnlinked(account: db.DbAccount | null) {
+    expect(account).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      tombstone: 0,
+    });
+  }
+
+  it('moves the bank account to a new account and unlinks the previous holder', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      linkSimpleFin({
+        externalAccount,
+        replaceExistingLink: true,
+        startingBalance: 0,
+      }),
+    ).resolves.toBe('ok');
+
+    expectUnlinked(await getAccount('acct1'));
+    const newAccount = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE account_id = ? AND tombstone = 0 AND id != ?',
+      ['ext-1', 'acct1'],
+    );
+    expect(newAccount).toMatchObject({
+      account_sync_source: 'simpleFin',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledWith(
+      undefined,
+      undefined,
+      newAccount!.id,
+      'ext-1',
+      expect.anything(),
+      undefined,
+      0,
+    );
+  });
+
+  it('moves the bank account into a chosen existing account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      linkSimpleFin({
+        externalAccount,
+        upgradingId: 'acct2',
+        replaceExistingLink: true,
+        startingBalance: 0,
+      }),
+    ).resolves.toBe('ok');
+
+    expectUnlinked(await getAccount('acct1'));
+    expect(await getAccount('acct2')).toMatchObject({
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+
+  it('keeps a closed previous holder closed', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.update('accounts', { id: 'acct1', closed: 1 });
+
+    await expect(
+      linkSimpleFin({
+        externalAccount,
+        replaceExistingLink: true,
+        startingBalance: 0,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(await getAccount('acct1')).toMatchObject({
+      closed: 1,
+      tombstone: 0,
+    });
+    expectUnlinked(await getAccount('acct1'));
+  });
+
+  it('refuses to link into a closed account and leaves the previous holder linked', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    await db.insertAccount({ id: 'acct2', name: 'Savings', closed: 1 });
+
+    await expect(
+      linkSimpleFin({
+        externalAccount,
+        upgradingId: 'acct2',
+        replaceExistingLink: true,
+        startingBalance: 0,
+      }),
+    ).rejects.toThrow(closedMessage);
+
+    expect(await getAccount('acct1')).toMatchObject({
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('links as usual when no other account holds the bank account', async () => {
+    await expect(
+      linkSimpleFin({
+        externalAccount,
+        replaceExistingLink: true,
+        startingBalance: 0,
+      }),
+    ).resolves.toBe('ok');
+
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+
+  it('still refuses when replaceExistingLink is false', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      linkSimpleFin({
+        externalAccount,
+        replaceExistingLink: false,
+        startingBalance: 0,
+      }),
+    ).rejects.toThrow(alreadyLinkedMessage);
+
+    expect(await getAccount('acct1')).toMatchObject({
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+
+  it('does not send a removal to GoCardless for the previous holder', async () => {
+    insertBank({ id: 'bank-gc', bank_id: 'req-1', name: 'GC Bank' });
+    await db.insertAccount({
+      id: 'acct-gc',
+      name: 'Current',
+      bank: 'bank-gc',
+      account_id: 'gc-ext-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(
+      linkGoCardless({
+        requisitionId: 'req-1',
+        account: {
+          account_id: 'gc-ext-1',
+          balance: 0,
+          institution: { name: 'GC Bank' },
+          mask: '1234',
+          name: 'Current',
+          official_name: 'Current',
+        },
+        replaceExistingLink: true,
+        startingBalance: 0,
+      }),
+    ).resolves.toBe('ok');
+
+    expectUnlinked(await getAccount('acct-gc'));
+    expect(post).not.toHaveBeenCalled();
+  });
+});
