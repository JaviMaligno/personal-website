+/**
+ * Throws if the bank account is already linked, through the same provider, to a
+ * local account other than `upgradingId`. Deleted accounts don't hold a link.
+ */
+export async function assertBankAccountNotLinked({
+  provider,
+  accountId,
+  upgradingId,
+}: {
+  provider: BankSyncProviders;
+  accountId: string;
+  upgradingId: string | undefined;
+}) {
+  const linked = await db.first<Pick<db.DbAccount, 'id'>>(
+    'SELECT id FROM accounts WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ? AND id IS NOT ?',
+    [provider, accountId, upgradingId ?? null],
+  );
+
+  if (linked) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
