+
+describe('linking a bank account that is already linked', () => {
+  const simpleFinLink = app.handlers['simplefin-accounts-link'];
+  const goCardlessLink = app.handlers['gocardless-accounts-link'];
+
+  function externalSimpleFinAccount(accountId: string) {
+    return {
+      account_id: accountId,
+      balance: 0,
+      name: 'Checking',
+      institution: 'Bank',
+      orgDomain: 'bank.example',
+      orgId: 'org-1',
+    };
+  }
+
+  async function insertLinkedAccount(
+    id: string,
+    overrides: Partial<db.DbAccount> = {},
+  ) {
+    await db.insertAccount({
+      id,
+      name: id,
+      account_id: 'ext-1',
+      account_sync_source: 'simpleFin',
+      ...overrides,
+    });
+  }
+
+  async function countRows(table: 'accounts' | 'payees' | 'banks') {
+    const row = await db.first<{ count: number }>(
+      `SELECT count(*) as count FROM ${table}`,
+    );
+    return row!.count;
+  }
+
+  beforeEach(() => {
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+  });
+
+  it('refuses a new account when the bank account is already linked', async () => {
+    await insertLinkedAccount('acct1');
+    const accountsBefore = await countRows('accounts');
+    const payeesBefore = await countRows('payees');
+    const banksBefore = await countRows('banks');
+
+    await expect(
+      simpleFinLink({ externalAccount: externalSimpleFinAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await countRows('accounts')).toBe(accountsBefore);
+    expect(await countRows('payees')).toBe(payeesBefore);
+    expect(await countRows('banks')).toBe(banksBefore);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses linking into another account and leaves that account unchanged', async () => {
+    await insertLinkedAccount('acct1');
+    await db.insertAccount({ id: 'acct2', name: 'Savings' });
+
+    await expect(
+      simpleFinLink({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+        upgradingId: 'acct2',
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const acct2 = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['acct2'],
+    );
+    expect(acct2!.account_id).toBeNull();
+    expect(acct2!.account_sync_source).toBeNull();
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('refuses when the existing link belongs to a closed account', async () => {
+    await insertLinkedAccount('acct1', { closed: 1 });
+
+    await expect(
+      simpleFinLink({ externalAccount: externalSimpleFinAccount('ext-1') }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('refuses the same provider account id under goCardless when linked via goCardless', async () => {
+    await insertLinkedAccount('acct1', { account_sync_source: 'goCardless' });
+
+    await expect(
+      goCardlessLink({
+        requisitionId: 'req-1',
+        account: {
+          balance: 0,
+          account_id: 'ext-1',
+          name: 'Checking',
+          institution: 'Bank',
+          mask: '0000',
+          official_name: 'Checking',
+        },
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows the same account id under a different provider', async () => {
+    await insertLinkedAccount('acct1', { account_sync_source: 'goCardless' });
+
+    await expect(
+      simpleFinLink({ externalAccount: externalSimpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows linking when the existing link is on a deleted account', async () => {
+    await insertLinkedAccount('acct1', { tombstone: 1 });
+
+    await expect(
+      simpleFinLink({ externalAccount: externalSimpleFinAccount('ext-1') }),
+    ).resolves.toBe('ok');
+  });
+
+  it('allows re-linking into the account that already holds the bank account', async () => {
+    await insertLinkedAccount('acct1');
+
+    await expect(
+      simpleFinLink({
+        externalAccount: externalSimpleFinAccount('ext-1'),
+        upgradingId: 'acct1',
+      }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
