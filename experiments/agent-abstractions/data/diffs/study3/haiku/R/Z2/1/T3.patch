+// An approximate amount is expected at the end of its tolerance furthest from zero.
+export function getApproxWorstCaseAmount(value: number): number {
+  return value + Math.sign(value) * getApproxNumberThreshold(value);
+}
+
+function getPlannedAmount(
+  amount: number | { num1: number; num2: number },
+  op?: string | null,
+): number {
+  if (typeof amount !== 'number') {
+    return getWorstCaseAmount(amount);
+  }
+  if (op === 'isapprox') {
+    return getApproxWorstCaseAmount(amount);
+  }
+  return amount;
+}
+
 export function getScheduledAmount(
   amount: number | { num1: number; num2: number },
+  op?: string | null,
   inverse: boolean = false,
 ): number {
   // this check is temporary, and required at the moment as a schedule rule
   // allows the amount condition to be deleted which causes a crash
   if (amount == null) return 0;
 
-  const value =
-    typeof amount === 'number' ? amount : getWorstCaseAmount(amount);
+  const value = getPlannedAmount(amount, op);
   return inverse ? -value : value;
 }
 
