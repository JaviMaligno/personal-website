+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(overrides: Partial<ScheduleEntity>): ScheduleEntity {
+  const schedule: ScheduleEntity = {
+    id: 'schedule1',
+    name: 'Rent',
+    rule: 'rule1',
+    next_date: '2026-11-01',
+    completed: false,
+    posts_transaction: true,
+    tombstone: false,
+    _payee: 'payee1',
+    _account: 'account1',
+    _amount: -100,
+    _amountOp: 'is',
+    _date: '2026-11-01',
+    _conditions: [],
+    _actions: [],
+  };
+  return { ...schedule, ...overrides };
+}
+
+describe('scheduleModel.toExternal', () => {
+  it('exposes a single amount as the expected amount', () => {
+    expect(
+      scheduleModel.toExternal(makeSchedule({ _amount: -4500 })),
+    ).toMatchObject({ amount: -4500, expectedAmount: -4500 });
+  });
+
+  it('exposes the end of a range furthest from zero as the expected amount', () => {
+    expect(
+      scheduleModel.toExternal(
+        makeSchedule({
+          _amount: { num1: -10100, num2: -20000 },
+          _amountOp: 'isbetween',
+        }),
+      ),
+    ).toMatchObject({
+      amount: { num1: -10100, num2: -20000 },
+      amountOp: 'isbetween',
+      expectedAmount: -20000,
+    });
+  });
+
+  it('picks the positive end of a range that spans zero by magnitude', () => {
+    expect(
+      scheduleModel.toExternal(
+        makeSchedule({
+          _amount: { num1: -300, num2: 500 },
+          _amountOp: 'isbetween',
+        }),
+      ),
+    ).toMatchObject({ expectedAmount: 500 });
+  });
+
+  it('gives zero as the expected amount when there is no amount', () => {
+    expect(
+      scheduleModel.toExternal(
+        makeSchedule({ _amount: null as unknown as number }),
+      ),
+    ).toMatchObject({ expectedAmount: 0 });
+  });
+});
