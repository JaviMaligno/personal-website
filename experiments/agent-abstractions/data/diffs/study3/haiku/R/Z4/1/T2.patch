+// Weekend solving moves an occurrence by at most two days, so occurrences just
+// outside the period can land inside it and must be considered.
+const MAX_WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const occurrences = schedule
+      .occurrences({
+        start: d.subDays(parseDate(start), MAX_WEEKEND_SHIFT_DAYS),
+        end: d.addDays(parseDate(end), MAX_WEEKEND_SHIFT_DAYS),
+      })
+      .toArray();
+
+    const days = new Set<string>();
+    for (const occurrence of occurrences) {
+      const date = config.skipWeekend
+        ? getDateWithSkippedWeekend(
+            occurrence.date,
+            config.frequency,
+            config.weekendSolveMode,
+          )
+        : occurrence.date;
+      if (date) {
+        const day = dayFromDate(date);
+        if (day >= start && day <= end) {
+          days.add(day);
+        }
+      }
+    }
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
