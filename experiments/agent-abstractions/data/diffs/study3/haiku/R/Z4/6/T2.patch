+
+  describe('schedule/get-dates-in-range', () => {
+    const getDatesInRange = (config, start: string, end: string) =>
+      schedulesApp.handlers['schedule/get-dates-in-range']({
+        config,
+        start,
+        end,
+      });
+
+    it('lists every occurrence of a monthly schedule within the period', async () => {
+      const config = {
+        frequency: 'monthly',
+        start: '2017-01-15',
+        endMode: 'never',
+        patterns: [{ type: 'day', value: 15 }],
+      };
+
+      expect(await getDatesInRange(config, '2017-01-01', '2017-03-31')).toEqual(
+        ['2017-01-15', '2017-02-15', '2017-03-15'],
+      );
+    });
+
+    it('moves a weekend occurrence before the weekend into the period', async () => {
+      const config = {
+        frequency: 'monthly',
+        start: '2017-01-01',
+        endMode: 'never',
+        patterns: [{ type: 'day', value: 1 }],
+        skipWeekend: true,
+        weekendSolveMode: 'before',
+      };
+
+      expect(await getDatesInRange(config, '2016-12-30', '2016-12-31')).toEqual(
+        ['2016-12-30'],
+      );
+    });
+
+    it('drops a weekend occurrence moved out of the period', async () => {
+      const config = {
+        frequency: 'monthly',
+        start: '2017-01-01',
+        endMode: 'never',
+        patterns: [{ type: 'day', value: 1 }],
+        skipWeekend: true,
+        weekendSolveMode: 'before',
+      };
+
+      expect(await getDatesInRange(config, '2017-01-01', '2017-01-31')).toEqual(
+        [],
+      );
+    });
+
+    it('moves a weekend occurrence after the weekend into the period', async () => {
+      const config = {
+        frequency: 'monthly',
+        start: '2017-01-07',
+        endMode: 'never',
+        patterns: [{ type: 'day', value: 7 }],
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      };
+
+      expect(await getDatesInRange(config, '2017-01-08', '2017-01-31')).toEqual(
+        ['2017-01-09'],
+      );
+      expect(await getDatesInRange(config, '2017-01-01', '2017-01-08')).toEqual(
+        [],
+      );
+    });
+
+    it('lists a day once when several weekend occurrences move onto it', async () => {
+      const config = {
+        frequency: 'monthly',
+        start: '2017-01-07',
+        endMode: 'never',
+        patterns: [
+          { type: 'day', value: 7 },
+          { type: 'day', value: 8 },
+        ],
+        skipWeekend: true,
+        weekendSolveMode: 'before',
+      };
+
+      expect(await getDatesInRange(config, '2017-01-01', '2017-01-31')).toEqual(
+        ['2017-01-06'],
+      );
+    });
+
+    it('skips weekend occurrences of a daily schedule', async () => {
+      const config = {
+        frequency: 'daily',
+        start: '2017-01-01',
+        endMode: 'never',
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      };
+
+      expect(await getDatesInRange(config, '2017-01-07', '2017-01-10')).toEqual(
+        ['2017-01-09', '2017-01-10'],
+      );
+    });
+
+    it('respects the end date of the schedule', async () => {
+      const config = {
+        frequency: 'weekly',
+        start: '2017-01-02',
+        endMode: 'on_date',
+        endDate: '2017-01-16',
+      };
+
+      expect(await getDatesInRange(config, '2017-01-01', '2017-02-28')).toEqual(
+        ['2017-01-02', '2017-01-09', '2017-01-16'],
