+// A weekend occurrence moves at most two days, so the generated window must
+// reach this far on both sides of the requested period.
+const WEEKEND_MOVE_MAX_DAYS = 2;
+
+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const skipWeekendOccurrences = isDailyWeekendSkip(config);
+    const moveWeekend = config.skipWeekend && !skipWeekendOccurrences;
+
+    const days = schedule
+      .occurrences({
+        start: parseDate(subDays(start, WEEKEND_MOVE_MAX_DAYS)),
+        end: d.endOfDay(parseDate(addDays(end, WEEKEND_MOVE_MAX_DAYS))),
+      })
+      .toArray()
+      .map(({ date }) => date)
+      .filter(date => !(skipWeekendOccurrences && d.isWeekend(date)))
+      .map(date =>
+        moveWeekend
+          ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+          : date,
+      )
+      .map(date => dayFromDate(date))
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
