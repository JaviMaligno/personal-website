+// A weekend solve moves an occurrence at most two days, in either direction.
+const MAX_WEEKEND_SHIFT_DAYS = 2;
+
+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(
+          d.subDays(parseDate(start), MAX_WEEKEND_SHIFT_DAYS),
+        ),
+        end: d.endOfDay(d.addDays(parseDate(end), MAX_WEEKEND_SHIFT_DAYS)),
+      })
+      .toArray();
+
+    const days = new Set<string>();
+    for (const occurrence of occurrences) {
+      const date = config.skipWeekend
+        ? getDateWithSkippedWeekend(
+            occurrence.date,
+            config.weekendSolveMode,
+            config.frequency,
+          )
+        : occurrence.date;
+      if (date === null) {
+        continue;
+      }
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
