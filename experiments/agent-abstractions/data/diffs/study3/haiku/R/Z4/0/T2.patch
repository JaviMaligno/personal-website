+
+  describe('schedule/get-dates-in-range', () => {
+    const getDatesInRange = (config, start: string, end: string) =>
+      schedulesApp.handlers['schedule/get-dates-in-range']({
+        config,
+        start,
+        end,
+      });
+
+    const monthlyOn = (value: number, overrides = {}) => ({
+      frequency: 'monthly',
+      start: '2026-01-01',
+      patterns: [{ type: 'day', value }],
+      ...overrides,
+    });
+
+    it('lists every occurrence in the period in ascending order', async () => {
+      expect(
+        await getDatesInRange(monthlyOn(15), '2026-01-01', '2026-03-31'),
+      ).toEqual(['2026-01-15', '2026-02-15', '2026-03-15']);
+    });
+
+    it('excludes occurrences outside the period', async () => {
+      expect(
+        await getDatesInRange(monthlyOn(15), '2026-01-16', '2026-02-14'),
+      ).toEqual([]);
+    });
+
+    it('moves a weekend occurrence after the weekend to Monday', async () => {
+      const config = monthlyOn(9, {
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      });
+
+      expect(await getDatesInRange(config, '2026-05-01', '2026-05-31')).toEqual(
+        ['2026-05-11'],
+      );
+    });
+
+    it('drops a weekend occurrence moved out of the period', async () => {
+      const config = monthlyOn(9, {
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      });
+
+      expect(await getDatesInRange(config, '2026-05-01', '2026-05-10')).toEqual(
+        [],
+      );
+    });
+
+    it('includes a weekend occurrence moved into the period', async () => {
+      const config = monthlyOn(10, {
+        skipWeekend: true,
+        weekendSolveMode: 'before',
+      });
+
+      expect(await getDatesInRange(config, '2026-05-08', '2026-05-08')).toEqual(
+        ['2026-05-08'],
+      );
+    });
+
+    it('lists a day once when two weekend occurrences move onto it', async () => {
+      const config = {
+        frequency: 'monthly',
+        start: '2026-01-01',
+        patterns: [
+          { type: 'day', value: 7 },
+          { type: 'day', value: 8 },
+        ],
+        skipWeekend: true,
+        weekendSolveMode: 'before',
+      };
+
+      expect(await getDatesInRange(config, '2026-03-01', '2026-03-31')).toEqual(
+        ['2026-03-06'],
+      );
+    });
+
+    it('skips weekend days for daily schedules', async () => {
+      const config = {
+        frequency: 'daily',
+        start: '2026-05-01',
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      };
+
+      expect(await getDatesInRange(config, '2026-05-08', '2026-05-11')).toEqual(
+        ['2026-05-08', '2026-05-11'],
+      );
+    });
+  });
 });
