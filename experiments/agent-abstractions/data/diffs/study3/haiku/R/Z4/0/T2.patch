+// A weekend occurrence moves at most two days, so occurrences just outside
+// the period can still land inside it once adjusted.
+const MAX_WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  const dropsWeekendDays = isDailyWeekendSkip(config);
+
+  const days = schedule
+    .occurrences({
+      start: d.subDays(parseDate(start), MAX_WEEKEND_SHIFT_DAYS),
+      end: d.addDays(parseDate(end), MAX_WEEKEND_SHIFT_DAYS),
+    })
+    .toArray()
+    .map(occurrence => occurrence.date)
+    .filter(date => !dropsWeekendDays || !d.isWeekend(date))
+    .map(date =>
+      config.skipWeekend
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date,
+    )
+    .map(date => dayFromDate(date))
+    .filter(day => day >= start && day <= end);
+
+  return [...new Set(days)].sort();
+}
