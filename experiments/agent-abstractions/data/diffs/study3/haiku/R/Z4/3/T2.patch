+// A weekend solve moves an occurrence by at most two days, so the raw search
+// window has to reach that far beyond the period.
+const WEEKEND_SHIFT_DAYS = 2;
+
+export function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const isWeekendSkipping = isWeekendSkippedDaily(config);
+  const movesWeekend = Boolean(config.skipWeekend) && !isWeekendSkipping;
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const searchStart = d.subDays(parseDate(start), WEEKEND_SHIFT_DAYS);
+    const searchEnd = d.endOfDay(d.addDays(parseDate(end), WEEKEND_SHIFT_DAYS));
+
+    const days = schedule
+      .occurrences({ start: searchStart, end: searchEnd })
+      .toArray()
+      .map(occurrence => occurrence.date)
+      .filter(date => !isWeekendSkipping || !d.isWeekend(date))
+      .map(date =>
+        movesWeekend
+          ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+          : date,
+      )
+      .map(date => dayFromDate(date))
+      .filter(day => day >= start && day <= end);
+
+    return [...new Set(days)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
