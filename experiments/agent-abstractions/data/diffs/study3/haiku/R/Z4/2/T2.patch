+
+    it('lists nothing when the period has no occurrence', async () => {
+      const config = {
+        frequency: 'monthly',
+        start: '2026-03-10',
+        endMode: 'never',
+      };
+
+      expect(await getDatesInRange(config, '2026-04-01', '2026-04-05')).toEqual(
+        [],
+      );
+    });
+
+    it('moves a weekend occurrence after the weekend into the period', async () => {
+      // 2026-03-14 is a Saturday, moved to Monday 2026-03-16
+      const config = {
+        frequency: 'monthly',
+        start: '2026-01-14',
+        endMode: 'never',
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      };
+
+      expect(await getDatesInRange(config, '2026-03-16', '2026-03-20')).toEqual(
+        ['2026-03-16'],
+      );
+    });
+
+    it('drops a weekend occurrence moved out of the period', async () => {
+      const config = {
+        frequency: 'monthly',
+        start: '2026-01-14',
+        endMode: 'never',
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      };
+
+      expect(await getDatesInRange(config, '2026-03-14', '2026-03-15')).toEqual(
+        [],
+      );
+    });
+
+    it('moves a weekend occurrence before the weekend into the period', async () => {
+      // 2026-03-14 is a Saturday, moved to Friday 2026-03-13
+      const config = {
+        frequency: 'monthly',
+        start: '2026-01-14',
+        endMode: 'never',
+        skipWeekend: true,
+        weekendSolveMode: 'before',
+      };
+
+      expect(await getDatesInRange(config, '2026-03-13', '2026-03-13')).toEqual(
+        ['2026-03-13'],
+      );
+    });
+
+    it('lists a day once when several occurrences move onto it', async () => {
+      // 2026-03-14 (Saturday) and 2026-03-16 (Monday) both land on 2026-03-16
+      const config = {
+        frequency: 'monthly',
+        start: '2026-01-14',
+        endMode: 'never',
+        patterns: [
+          { type: 'day', value: 14 },
+          { type: 'day', value: 16 },
+        ],
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      };
+
+      expect(await getDatesInRange(config, '2026-03-01', '2026-03-31')).toEqual(
+        ['2026-03-16'],
+      );
+    });
+
+    it('skips weekend occurrences of daily schedules', async () => {
+      const config = {
+        frequency: 'daily',
+        start: '2026-03-13',
+        endMode: 'never',
+        skipWeekend: true,
+        weekendSolveMode: 'after',
+      };
+
+      expect(await getDatesInRange(config, '2026-03-13', '2026-03-17')).toEqual(
+        ['2026-03-13', '2026-03-16', '2026-03-17'],
+      );
+    });
+
+    it('stops at the end of the schedule', async () => {
+      const config = {
+        frequency: 'daily',
+        start: '2026-03-01',
+        endMode: 'after_n_occurrences',
+        endOccurrences: 2,
+      };
+
+      expect(await getDatesInRange(config, '2026-03-01', '2026-03-31')).toEqual(
+        ['2026-03-01', '2026-03-02'],
+      );
+    });
+  });
 });
