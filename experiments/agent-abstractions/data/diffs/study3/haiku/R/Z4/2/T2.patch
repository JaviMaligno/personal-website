+
+    it('lists every occurrence within the period, both bounds included', async () => {
+      const config = {
+        frequency: 'daily',
+        start: '2026-03-01',
+        endMode: 'never',
+      };
+
+      expect(await getDatesInRange(config, '2026-03-01', '2026-03-03')).toEqual(
+        ['2026-03-01', '2026-03-02', '2026-03-03'],
+      );
