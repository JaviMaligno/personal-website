+// Weekend solving moves an occurrence by at most two days (Sat -> Mon, Sun -> Fri),
+// so the raw search window has to be widened by that much on both sides.
+const WEEKEND_SHIFT_DAYS = 2;
+
+async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const skipsWeekendDays = skipsWeekendOccurrences(config);
+  const shiftsWeekend = Boolean(config.skipWeekend) && !skipsWeekendDays;
+
+  const occurrences = schedule
+    .occurrences({
+      start: parseDate(addDays(start, -WEEKEND_SHIFT_DAYS)),
+      end: parseDate(addDays(end, WEEKEND_SHIFT_DAYS)),
+    })
+    .toArray();
+
+  const days = new Set<string>();
+  for (const { date } of occurrences) {
+    if (skipsWeekendDays && d.isWeekend(date)) {
+      continue;
+    }
+    const finalDate = shiftsWeekend
+      ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+      : date;
+    const day = dayFromDate(finalDate);
+    if (day >= start && day <= end) {
+      days.add(day);
+    }
+  }
+
+  return [...days].sort();
+}
