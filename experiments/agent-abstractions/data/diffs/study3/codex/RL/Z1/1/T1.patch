+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('setZero leaves hidden, group-hidden, and UI-template categories unchanged', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'group', name: 'Group', is_income: 0 });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    for (const [id, group] of [
+      ['visible', 'group'],
+      ['hidden', 'group'],
+      ['group-hidden', 'hidden-group'],
+      ['templated', 'group'],
+    ]) {
+      await db.insertCategory({
+        id,
+        name: id,
+        cat_group: group,
+        is_income: 0,
+      });
+      await setBudget({ category: id, month: '2024-01', amount: 500 });
+    }
+    await db.update('categories', { id: 'hidden', hidden: 1 });
+    await db.updateWithSchema('categories', {
+      id: 'templated',
+      goal_def: JSON.stringify([{ type: 'monthly', amount: 500 }]),
+      template_settings: { source: 'ui' },
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-visible')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-hidden')).toBe(500);
+    expect(await getSheetValue('budget202401', 'budget-group-hidden')).toBe(500);
+    expect(await getSheetValue('budget202401', 'budget-templated')).toBe(500);
+  });
+});
