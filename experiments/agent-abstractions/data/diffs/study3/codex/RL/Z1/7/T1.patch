+describe('month-wide budget action category filtering', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves hidden, hidden-group, and template-managed categories unchanged', async () => {
+    await db.insertCategoryGroup({ id: 'visible', name: 'Visible' });
+    await db.insertCategoryGroup({ id: 'hidden-group', name: 'Hidden', hidden: 1 });
+    for (const [id, group, hidden, goal_def] of [
+      ['ordinary', 'visible', 0, null],
+      ['hidden-category', 'visible', 1, null],
+      ['hidden-group-category', 'hidden-group', 0, null],
+      ['templated', 'visible', 0, JSON.stringify([{ type: 'monthly', amount: 10 }])],
+    ] as const) {
+      await db.insertCategory({
+        id,
+        name: id,
+        cat_group: group,
+        hidden,
+        goal_def,
+      });
+      await setBudget({ category: id, month: '2024-01', amount: 1234 });
+    }
+
+    await setZero({ month: '2024-01' });
+
+    expect(db.firstSync<{ amount: number }>('SELECT amount FROM zero_budgets WHERE category = ?', ['ordinary'])?.amount).toBe(0);
+    for (const category of ['hidden-category', 'hidden-group-category', 'templated']) {
+      expect(db.firstSync<{ amount: number }>('SELECT amount FROM zero_budgets WHERE category = ?', [category])?.amount).toBe(1234);
+    }
+  });
+});
