+function hasSavedTemplate(settings: BulkBudgetCategory['template_settings']) {
+  if (typeof settings === 'string') {
+    try {
+      settings = JSON.parse(settings);
+    } catch {
+      return false;
+    }
+  }
+  return settings?.source === 'ui';
