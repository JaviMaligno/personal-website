+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getVisibleUntemplatedCategories();
+  const previousMonth = monthUtils.prevMonth(month);
+  const previousSheet = monthUtils.sheetForMonth(previousMonth);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (shouldSkipIncomeCategory(cat.is_income)) {
+        continue;
+      }
+      const amount = await getSheetValue(
+        previousSheet,
+        'sum-amount-' + cat.id,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? amount : -amount,
+      });
+    }
+  });
