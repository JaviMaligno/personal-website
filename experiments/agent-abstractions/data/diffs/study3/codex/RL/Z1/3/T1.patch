+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('set zero leaves hidden and template-managed categories unchanged', async () => {
+    await db.insertCategoryGroup({
+      id: 'income',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'visible',
+      name: 'Visible',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'normal',
+      name: 'Normal',
+      cat_group: 'visible',
+    });
+    await db.insertCategory({
+      id: 'hidden-category',
+      name: 'Hidden',
+      cat_group: 'visible',
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'group-hidden-category',
+      name: 'In hidden group',
+      cat_group: 'hidden-group',
+    });
+    await db.insertCategory({
+      id: 'templated',
+      name: 'Templated',
+      cat_group: 'visible',
+    });
+    await db.updateWithSchema('categories', {
+      id: 'templated',
+      goal_def: JSON.stringify([{ type: 'refill' }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+
+    for (const category of [
+      'normal',
+      'hidden-category',
+      'group-hidden-category',
+      'templated',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 123 });
+    }
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-normal')).toBe(0);
+    for (const category of [
+      'hidden-category',
+      'group-hidden-category',
+      'templated',
+    ]) {
+      expect(await getSheetValue('budget202401', `budget-${category}`)).toBe(
+        123,
+      );
+    }
+  });
+});
