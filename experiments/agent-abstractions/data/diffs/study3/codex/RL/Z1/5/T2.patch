   });
 }
 
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = (await getCategoriesForBulkBudgetAction()).filter(
+    cat => cat.is_income === 0 || isTrackingBudget(),
+  );
+  const previousMonth = monthUtils.prevMonth(month);
+  const previousSheet = monthUtils.sheetForMonth(previousMonth);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const amount = await getSheetValue(
+        previousSheet,
+        'sum-amount-' + cat.id,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? amount : Math.abs(amount),
+      });
+    }
+  });
+}
