+describe('set last month spending', () => {
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    await setupAverageDatabase();
+  });
+
+  afterEach(async () => {
+    await global.emptyDatabase()();
+  });
+
+  it('budgets expense categories to their previous month spending', async () => {
+    await db.insertCategory({
+      id: 'cat2',
+      name: 'No spending',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await setBudget({ category: 'cat1', month: '2024-04', amount: 2500 });
+    await setBudget({ category: 'cat2', month: '2024-04', amount: 1500 });
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(1200);
+    expect(await getSheetValue('budget202404', 'budget-cat2')).toBe(0);
+  });
+
+  it('uses income received for income categories in tracking budgets', async () => {
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.insertTransaction({
+      date: '2024-03-20',
+      amount: 4000,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(4000);
+  });
+});
