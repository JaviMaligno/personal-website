+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getBulkBudgetCategories();
+  const prevMonth = monthUtils.prevMonth(month);
+  const prevSheet = monthUtils.sheetForMonth(prevMonth);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (shouldSkipIncomeCategory(cat)) {
+        continue;
+      }
+
+      const spending = await getSheetValue(
+        prevSheet,
+        `sum-amount-${cat.id}`,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? spending : -spending,
+      });
+    }
+  });
+}
