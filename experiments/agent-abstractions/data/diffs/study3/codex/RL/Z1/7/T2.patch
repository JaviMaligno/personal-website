+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getMonthActionCategories();
+  const previousMonth = monthUtils.prevMonth(month);
+  const previousDbMonth = dbMonth(previousMonth);
+  const spending = await db.all<{ category: string; amount: number }>(
+    `SELECT t.category, SUM(t.amount) AS amount
+       FROM v_transactions_internal_alive t
+       LEFT JOIN accounts a ON a.id = t.account
+      WHERE CAST(t.date / 100 AS INTEGER) = ?
+        AND t.category IS NOT NULL
+        AND a.offbudget = 0
+      GROUP BY t.category`,
+    [previousDbMonth],
+  );
+  const amountByCategory = new Map(
+    spending.map(({ category, amount }) => [category, amount || 0]),
+  );
+
+  await batchMessages(async () => {
+    for (const category of categories) {
+      if (category.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+      const amount = amountByCategory.get(category.id) ?? 0;
+      void setBudget({
+        category: category.id,
+        month,
+        amount: category.is_income === 1 ? amount : -amount,
+      });
+    }
+  });
+}
