+async function downloadTokenTransactions(
+  provider: 'fintegra' | 'akahu',
+  acctId: AccountEntity['account_id'],
+  since: string,
+) {
+  const userToken = await asyncStorage.getItem('user-token');
+  if (!userToken) return;
+
+  const res = await post(
+    getServer()[provider === 'fintegra' ? 'FINTEGRA_SERVER' : 'AKAHU_SERVER'] +
+      '/transactions',
+    { accountId: acctId, startDate: since },
+    { 'X-ACTUAL-TOKEN': userToken },
+    60000,
+  );
+
+  if (res.error_code) {
+    throw BankSyncError(res.error_type, res.error_code);
+  }
+  return {
+    transactions: res.transactions.all,
+    accountBalance: res.balances,
+    startingBalance: res.startingBalance,
+  };
+}
+
+const downloadFintegraTransactions = (acctId, since) =>
+  downloadTokenTransactions('fintegra', acctId, since);
