+  upgradingId?: string,
+) {
+  const linkedAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, providerAccountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (linkedAccount) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
