+import * as connection from '#platform/server/connection';
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('#platform/server/connection', () => ({ send: vi.fn() }));
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi
+    .fn()
+    .mockResolvedValue({ added: [], updated: [], updatedPreview: [] }),
+}));
+
+const account = {
+  account_id: 'external-account',
+  name: 'Checking',
+  balance: 0,
+  orgDomain: 'example.com',
+};
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(bankSync.syncAccount).mockResolvedValue({
+    added: [],
+    updated: [],
+    updatedPreview: [],
+  });
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+async function insertLinkedAccount(id: string, tombstone = 0) {
+  await db.insertAccount({
+    id,
+    name: 'Existing account',
+    account_id: account.account_id,
+    account_sync_source: 'simpleFin',
+    tombstone,
+  });
+}
+
+describe('linking a bank account', () => {
+  it('refuses a second link without changing the database or syncing', async () => {
+    await insertLinkedAccount('existing');
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({ externalAccount: account }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await db.all('SELECT * FROM accounts')).toHaveLength(1);
+    expect(await db.all('SELECT * FROM payees')).toHaveLength(0);
+    expect(await db.all('SELECT * FROM banks')).toHaveLength(0);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(connection.send).not.toHaveBeenCalled();
+  });
+
+  it('allows refreshing the account that already holds the link', async () => {
+    await insertLinkedAccount('existing');
+
+    await app.handlers['simplefin-accounts-link']({
+      externalAccount: account,
+      upgradingId: 'existing',
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledOnce();
+    expect(await db.all('SELECT * FROM accounts')).toHaveLength(1);
+  });
+
+  it('ignores deleted accounts when checking for an existing link', async () => {
+    await insertLinkedAccount('deleted', 1);
+
+    await app.handlers['simplefin-accounts-link']({ externalAccount: account });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledOnce();
+  });
+});
