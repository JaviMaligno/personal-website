+  it('replaces another local SimpleFin link without deleting or remotely unlinking its account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'external-1', closed: true },
+    ]);
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await app.handlers['simplefin-accounts-link']({
+      replaceExistingLink: true,
+      externalAccount: {
+        account_id: 'external-1',
+        name: 'Checking',
+        orgId: 'org-1',
+        balance: 0,
+      },
+    });
+
+    const unlinked = await db.first('SELECT * FROM accounts WHERE id = ?', [
+      'existing',
+    ]);
+    expect(unlinked).toMatchObject({
+      id: 'existing',
+      closed: 1,
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      bank_sync_status: null,
+    });
+    expect(unlinked).toMatchObject({ name: 'Existing' });
+    expect(await db.all('SELECT * FROM accounts')).toHaveLength(2);
+    expect(bankSync.syncAccount).toHaveBeenCalledOnce();
+  });
+
+  it('does not replace an existing link when the destination account is closed', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'external-1' },
+      { id: 'closed-destination', name: 'Closed', accountId: 'other', closed: true },
+    ]);
+    const originalAccounts = await db.all('SELECT * FROM accounts');
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        upgradingId: 'closed-destination',
+        replaceExistingLink: true,
+        externalAccount: {
+          account_id: 'external-1',
+          name: 'Checking',
+          orgId: 'org-1',
+          balance: 0,
+        },
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await db.all('SELECT * FROM accounts')).toEqual(originalAccounts);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
