+
+describe('assertAccountNotLinked', () => {
+  async function addAccount({
+    id,
+    provider = 'simpleFin',
+    accountId = 'external-1',
+    tombstone = 0,
+  }: {
+    id: string;
+    provider?: string;
+    accountId?: string;
+    tombstone?: 0 | 1;
+  }) {
+    await db.insertAccount({
+      id,
+      name: id,
+      account_sync_source: provider,
+      account_id: accountId,
+      tombstone,
+    });
+  }
+
+  it('rejects another live account linked to the same provider account', async () => {
+    await addAccount({ id: 'existing' });
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'external-1', 'new-account'),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows refreshing the account that already holds the link', async () => {
+    await addAccount({ id: 'existing' });
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'external-1', 'existing'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted accounts and accounts linked through another provider', async () => {
+    await addAccount({ id: 'deleted', tombstone: 1 });
+    await addAccount({ id: 'other-provider', provider: 'akahu' });
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'external-1', 'new-account'),
+    ).resolves.toBeUndefined();
+  });
+});
