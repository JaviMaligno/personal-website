@@ -50,3 +50,22 @@ export async function findOrCreateBank(
 
   return bankData;
 }
+
+/** Reject a provider account that is already attached to another live account. */
+export async function assertAccountNotLinked(
+  provider: string,
+  accountId: db.DbAccount['account_id'],
+  upgradingId?: db.DbAccount['id'],
+): Promise<void> {
+  const linkedAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, accountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (linkedAccount) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
