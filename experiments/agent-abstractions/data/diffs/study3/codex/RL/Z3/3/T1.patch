+describe('ensureAccountNotLinked', () => {
+  it('rejects a second link through the same provider', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      account_id: 'provider-account',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      ensureAccountNotLinked('simpleFin', 'provider-account'),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows the existing account to be linked again', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      account_id: 'provider-account',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      ensureAccountNotLinked('simpleFin', 'provider-account', 'existing'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted accounts and links from other providers', async () => {
+    await db.insertAccount({
+      id: 'deleted',
+      name: 'Deleted',
+      account_id: 'provider-account',
+      account_sync_source: 'simpleFin',
+    });
+    await db.update('accounts', { id: 'deleted', tombstone: 1 });
+    await db.insertAccount({
+      id: 'other-provider',
+      name: 'Other provider',
+      account_id: 'provider-account',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(
+      ensureAccountNotLinked('simpleFin', 'provider-account'),
+    ).resolves.toBeUndefined();
+  });
+});
