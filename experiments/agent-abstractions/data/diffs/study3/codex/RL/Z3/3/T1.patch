@@ -5,6 +5,24 @@ import * as db from '#server/db';
 
 type Institution = string | { name?: string | null };
 
+export async function ensureAccountNotLinked(
+  provider: string,
+  providerAccountId: string,
+  upgradingId?: string,
+): Promise<void> {
+  const existingAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, providerAccountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (existingAccount) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
