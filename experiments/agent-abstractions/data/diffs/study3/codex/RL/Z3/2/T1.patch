+describe('simpleFin account linking', () => {
+  async function insertLinkedSimpleFinAccount(id: string, tombstone = 0) {
+    insertBank({
+      id: `bank-${id}`,
+      bank_id: 'simplefin-org',
+      name: 'SimpleFin',
+    });
+    await db.insertAccount({
+      id,
+      name: 'Existing',
+      bank: `bank-${id}`,
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+    });
+    if (tombstone) {
+      await db.update('accounts', { id, tombstone });
+    }
+  }
+
+  const externalAccount = {
+    account_id: 'external-1',
+    name: 'Checking',
+    balance: 0,
+    orgDomain: 'simplefin-org',
+    institution: 'SimpleFin',
+  };
+
+  it('refuses to link an account already linked to another local account without side effects', async () => {
+    await insertLinkedSimpleFinAccount('existing');
+    const accountBefore = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['existing'],
+    );
+    const bankCountBefore = await db.first<{ count: number }>(
+      'SELECT count(*) as count FROM banks',
+    );
+    const payeeCountBefore = await db.first<{ count: number }>(
+      'SELECT count(*) as count FROM payees',
+    );
+
+    await expect(simpleFinLinkHandler({ externalAccount })).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(
+      await db.first<{ count: number }>(
+        'SELECT count(*) as count FROM accounts',
+      ),
+    ).toEqual({ count: 1 });
+    expect(
+      await db.first<{ count: number }>('SELECT count(*) as count FROM banks'),
+    ).toEqual(bankCountBefore);
+    expect(
+      await db.first<{ count: number }>('SELECT count(*) as count FROM payees'),
+    ).toEqual(payeeCountBefore);
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'existing',
+      ]),
+    ).toEqual(accountBefore);
+  });
+
+  it('allows relinking into the account that already holds the link', async () => {
+    await insertLinkedSimpleFinAccount('existing');
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'existing' }),
+    ).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not treat deleted or differently provided accounts as holding the link', async () => {
+    await insertLinkedSimpleFinAccount('deleted', 1);
+    insertBank({ id: 'other-bank', bank_id: 'other', name: 'Other' });
+    await db.insertAccount({
+      id: 'different-provider',
+      name: 'Other provider',
+      bank: 'other-bank',
+      account_id: 'external-1',
+      account_sync_source: 'akahu',
+    });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await expect(simpleFinLinkHandler({ externalAccount })).resolves.toBe('ok');
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
