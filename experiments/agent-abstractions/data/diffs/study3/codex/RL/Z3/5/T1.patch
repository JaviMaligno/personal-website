+describe('bank account linking', () => {
+  it('refuses to link a SimpleFin account already held by another local account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'external-1' },
+    ]);
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount: {
+          account_id: 'external-1',
+          name: 'Checking',
+          orgId: 'org-1',
+          balance: 0,
+        },
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await db.all('SELECT * FROM accounts')).toHaveLength(1);
+    expect(await db.all('SELECT * FROM payees')).toHaveLength(0);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows relinking a SimpleFin account into its current local account', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'existing', name: 'Existing', accountId: 'external-1' },
+    ]);
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await app.handlers['simplefin-accounts-link']({
+      upgradingId: 'existing',
+      externalAccount: {
+        account_id: 'external-1',
+        name: 'Checking',
+        orgId: 'org-1',
+        balance: 0,
+      },
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledOnce();
+  });
+});
