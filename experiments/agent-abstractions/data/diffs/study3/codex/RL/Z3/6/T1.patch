+async function assertBankAccountNotLinked(
+  provider: string,
+  accountId: string,
+  upgradingId?: string,
+) {
+  const existingAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, accountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (existingAccount) {
+    throw APIError('This bank account is already linked to another account.');
+  }
+}
+
+function guardBankAccountLink<TParams extends LinkAccountBaseParams, TResult>(
+  provider: string,
+  getAccountId: (params: TParams) => string,
+  handler: (params: TParams) => Promise<TResult>,
+) {
+  return async (params: TParams) => {
+    await assertBankAccountNotLinked(
+      provider,
+      getAccountId(params),
+      params.upgradingId,
+    );
+    return handler(params);
+  };
+}
