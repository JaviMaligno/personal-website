+
+/** Refuse to attach bank data to an account that is hidden from normal views. */
+export async function assertAccountNotClosed(
+  accountId: db.DbAccount['id'] | undefined,
+): Promise<void> {
+  if (!accountId) {
+    return;
+  }
+
+  const account = await db.first<{ closed: number }>(
+    'SELECT closed FROM accounts WHERE id = ?',
+    [accountId],
+  );
+
+  if (account?.closed === 1) {
+    throw new Error(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+  }
+}
