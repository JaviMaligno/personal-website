+    await insertLinkedSimpleFinAccount('existing');
+    await db.update('accounts', { id: 'existing', closed: 1 });
+    await db.insertTransaction({
+      account: 'existing',
+      amount: 125,
+      date: '2024-01-01',
+      cleared: true,
+    });
+    await db.insertAccount({ id: 'replacement', name: 'Replacement' });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'replacement', replaceExistingLink: true }),
+    ).resolves.toBe('ok');
+
+    const oldAccount = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['existing'],
+    );
+    expect(oldAccount).toMatchObject({
+      id: 'existing',
+      closed: 1,
+      bank: null,
+      account_id: null,
+      account_sync_source: null,
+      bank_sync_status: null,
+    });
+    expect(
+      await db.first<{ count: number }>(
+        'SELECT count(*) as count FROM transactions WHERE acct = ?',
+        ['existing'],
+      ),
+    ).toEqual({ count: 1 });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not unlink the current link when a closed target is refused', async () => {
+    await insertLinkedSimpleFinAccount('existing');
+    await db.insertAccount({ id: 'closed-target', name: 'Closed', closed: 1 });
+
+    await expect(
+      simpleFinLinkHandler({ externalAccount, upgradingId: 'closed-target', replaceExistingLink: true }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'existing',
+      ]),
+    ).toMatchObject({
+      bank: 'bank-existing',
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+    });
+  });
+
