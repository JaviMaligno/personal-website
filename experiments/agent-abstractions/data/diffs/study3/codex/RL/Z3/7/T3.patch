diff --git a/packages/loot-core/src/server/accounts/sync.test.ts b/packages/loot-core/src/server/accounts/sync.test.ts
index 735a86f..eb937fb 100644
--- a/packages/loot-core/src/server/accounts/sync.test.ts
+++ b/packages/loot-core/src/server/accounts/sync.test.ts
@@ -1254,4 +1254,76 @@ describe('SimpleFin batch sync', () => {
     expect(await db.all('SELECT * FROM payees')).toHaveLength(0);
     expect(await db.all('SELECT * FROM banks')).toHaveLength(0);
   });
+
+  test('refuses linking a bank account to a closed local account', async () => {
+    await db.insertAccount({
+      id: 'closed',
+      name: 'Closed',
+      offbudget: 0,
+      closed: 1,
+      tombstone: 0,
+    });
+
+    await expect(
+      accountsApp.handlers['simplefin-accounts-link']({
+        upgradingId: 'closed',
+        externalAccount: {
+          account_id: 'external-1',
+          name: 'Bank account',
+          balance: 100,
+          institution: 'Example Bank',
+          orgDomain: 'example.com',
+        },
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await db.first('SELECT * FROM accounts WHERE id = ?', ['closed'])).toMatchObject({
+      id: 'closed',
+      closed: 1,
+      account_id: null,
+      account_sync_source: null,
+    });
+    expect(await db.all('SELECT * FROM accounts')).toHaveLength(1);
+    expect(await db.all('SELECT * FROM payees')).toHaveLength(0);
+    expect(await db.all('SELECT * FROM banks')).toHaveLength(0);
+  });
+
+  test('refuses re-linking a bank account already linked to a closed account', async () => {
+    await db.insertAccount({
+      id: 'closed',
+      name: 'Closed',
+      offbudget: 0,
+      closed: 1,
+      tombstone: 0,
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      accountsApp.handlers['simplefin-accounts-link']({
+        upgradingId: 'closed',
+        externalAccount: {
+          account_id: 'external-1',
+          name: 'Bank account',
+          balance: 100,
+          institution: 'Example Bank',
+          orgDomain: 'example.com',
+        },
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(await db.first('SELECT * FROM accounts WHERE id = ?', ['closed'])).toMatchObject({
+      id: 'closed',
+      closed: 1,
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+    });
+    expect(await db.all('SELECT * FROM accounts')).toHaveLength(1);
+    expect(await db.all('SELECT * FROM payees')).toHaveLength(0);
+    expect(await db.all('SELECT * FROM banks')).toHaveLength(0);
+  });
 });
