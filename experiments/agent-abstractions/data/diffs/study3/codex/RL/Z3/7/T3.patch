+async function assertAccountIsOpenForBankLink(upgradingId?: string) {
+  if (!upgradingId) {
+    return;
+  }
+
+  const account = await db.first<{ closed: 0 | 1 }>(
+    'SELECT closed FROM accounts WHERE id = ?',
+    [upgradingId],
+  );
+
+  if (account?.closed === 1) {
+    throw new Error(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+  }
+}
