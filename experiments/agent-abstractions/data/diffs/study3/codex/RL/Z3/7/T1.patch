+async function assertBankAccountIsNotLinked(
+  provider: NonNullable<db.DbAccount['account_sync_source']> | 'pluggyai' | 'akahu' | 'enableBanking',
+  accountId: string,
+  upgradingId?: string,
+) {
+  const existingAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, accountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (existingAccount) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
+
+function assertGoCardlessAccountAvailable(
+  accountId: string,
+  upgradingId?: string,
+) {
+  return assertBankAccountIsNotLinked('goCardless', accountId, upgradingId);
+}
+
+function assertSimpleFinAccountAvailable(
+  accountId: string,
+  upgradingId?: string,
+) {
+  return assertBankAccountIsNotLinked('simpleFin', accountId, upgradingId);
+}
+
+function assertPluggyAiAccountAvailable(
+  accountId: string,
+  upgradingId?: string,
+) {
+  return assertBankAccountIsNotLinked('pluggyai', accountId, upgradingId);
+}
+
+function assertAkahuAccountAvailable(
+  accountId: string,
+  upgradingId?: string,
+) {
+  return assertBankAccountIsNotLinked('akahu', accountId, upgradingId);
+}
+
+function assertEnableBankingAccountAvailable(
+  accountId: string,
+  upgradingId?: string,
+) {
+  return assertBankAccountIsNotLinked('enableBanking', accountId, upgradingId);
+}
+
