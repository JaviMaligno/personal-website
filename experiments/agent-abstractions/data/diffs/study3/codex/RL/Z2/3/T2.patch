@@ -0,0 +1,29 @@
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  const schedule = {
+    id: 'schedule-id',
+    name: 'Schedule',
+    posts_transaction: false,
+    rule: 'rule-id',
+    next_date: '2024-01-01',
+    completed: false,
+    _payee: null,
+    _account: null,
+    _amountOp: 'isbetween',
+    _date: { frequency: 'monthly' },
+    tombstone: false,
+  };
+
+  it.each([
+    [{ num1: -10100, num2: -20000 }, -20000],
+    [{ num1: 10100, num2: 20000 }, 20000],
+    [{ num1: -20000, num2: 10100 }, -20000],
+    [12345, 12345],
+    [undefined, 0],
+  ])('returns expectedAmount for amount %o', (amount, expectedAmount) => {
+    expect(
+      scheduleModel.toExternal({ ...schedule, _amount: amount } as never),
+    ).toMatchObject({ expectedAmount });
+  });
+});
