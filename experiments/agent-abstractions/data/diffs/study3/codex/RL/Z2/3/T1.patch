+import { describe, expect, it } from 'vitest';
+
+import { normalizeSchedule } from './forecast-schedules';
+
+describe('normalizeSchedule', () => {
+  it('uses the ranged amount endpoint furthest from zero', () => {
+    const schedule = {
+      id: 'schedule-1',
+      name: 'Variable bill',
+      next_date: '2026-10-15',
+      _date: '2026-10-15',
+      _amount: { num1: -10100, num2: -20000 },
+    };
+
+    expect(normalizeSchedule(schedule)?._amount).toBe(-20000);
+    expect(
+      normalizeSchedule({ ...schedule, _amount: { num1: -20000, num2: -10100 } })
+        ?._amount,
+    ).toBe(-20000);
+    expect(
+      normalizeSchedule({ ...schedule, _amount: { num1: 10100, num2: 20000 } })
+        ?._amount,
+    ).toBe(20000);
+  });
+});
