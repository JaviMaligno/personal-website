--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,38 @@
+import type { ScheduleEntity } from '#types/models/schedule';
+
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  const schedule = (amount: ScheduleEntity['_amount']) =>
+    ({
+      id: 'schedule-id',
+      name: 'Schedule',
+      rule: 'rule-id',
+      next_date: '2026-01-01',
+      completed: false,
+      posts_transaction: true,
+      tombstone: false,
+      _payee: 'payee-id',
+      _account: 'account-id',
+      _amount: amount,
+      _amountOp: 'isbetween',
+      _date: '2026-01-01',
+      _conditions: [],
+      _actions: [],
+    }) satisfies ScheduleEntity;
+
+  it('uses the amount for a single amount', () => {
+    expect(scheduleModel.toExternal(schedule(123)).expectedAmount).toBe(123);
+  });
+
+  it('uses the range endpoint furthest from zero', () => {
+    expect(
+      scheduleModel.toExternal(schedule({ num1: -10100, num2: -20000 }))
+        .expectedAmount,
+    ).toBe(-20000);
+  });
+
+  it('uses zero when the amount is zero', () => {
+    expect(scheduleModel.toExternal(schedule(0)).expectedAmount).toBe(0);
+  });
+});
