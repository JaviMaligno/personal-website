+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  it.each([
+    [125, 125],
+    [{ num1: 101, num2: 200 }, 200],
+    [{ num1: -101, num2: -200 }, -200],
+    [{ num1: -200, num2: 101 }, -200],
+  ])('returns the expected amount for %o', (amount, expectedAmount) => {
+    const schedule = scheduleModel.toExternal({
+      id: 'schedule-id',
+      rule: 'rule-id',
+      next_date: '2025-01-01',
+      completed: false,
+      posts_transaction: false,
+      tombstone: false,
+      _payee: 'payee-id',
+      _account: 'account-id',
+      _amount: amount,
+      _amountOp: 'isbetween',
+      _date: '2025-01-01',
+      _conditions: [],
+      _actions: [],
+    });
+
+    expect(schedule.amount).toEqual(amount);
+    expect(schedule.amountOp).toBe('isbetween');
+    expect(schedule.expectedAmount).toBe(expectedAmount);
+  });
+});
