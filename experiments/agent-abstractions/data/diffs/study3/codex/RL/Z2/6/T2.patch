+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  function createSchedule(
+    amount: ScheduleEntity['_amount'],
+  ): ScheduleEntity {
+    return {
+      id: 'schedule-id',
+      rule: 'rule-id',
+      next_date: '2024-01-01',
+      completed: false,
+      posts_transaction: true,
+      tombstone: false,
+      _payee: 'payee-id',
+      _account: 'account-id',
+      _amount: amount,
+      _amountOp: 'isbetween',
+      _date: '2024-01-01',
+      _conditions: [],
+      _actions: [],
+    };
+  }
+
+  it('returns the range endpoint furthest from zero as expectedAmount', () => {
+    expect(
+      scheduleModel.toExternal(createSchedule({ num1: 10100, num2: 20000 }))
+        .expectedAmount,
+    ).toBe(20000);
+    expect(
+      scheduleModel.toExternal(createSchedule({ num1: -10100, num2: -20000 }))
+        .expectedAmount,
+    ).toBe(-20000);
+  });
+
+  it('returns a single amount as expectedAmount', () => {
+    expect(scheduleModel.toExternal(createSchedule(12345)).expectedAmount).toBe(
+      12345,
+    );
+  });
+});
