--- /dev/null
+++ b/packages/loot-core/src/server/api-models.test.ts
@@ -0,0 +1,54 @@
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  it('returns the range endpoint furthest from zero as expectedAmount', () => {
+    const schedule = {
+      id: 'schedule-id',
+      name: 'Rent',
+      rule: 'rule-id',
+      next_date: '2024-01-01',
+      completed: false,
+      posts_transaction: true,
+      _payee: null,
+      _account: null,
+      _amount: { num1: -10100, num2: -20000 },
+      _amountOp: 'isbetween',
+      _date: '2024-01-01',
+      tombstone: false,
+      _conditions: [],
+      _actions: [],
+    };
+
+    expect(scheduleModel.toExternal(schedule)).toMatchObject({
+      amount: { num1: -10100, num2: -20000 },
+      amountOp: 'isbetween',
+      expectedAmount: -20000,
+    });
+  });
+
+  it('uses a single amount or zero when the amount is absent', () => {
+    const baseSchedule = {
+      id: 'schedule-id',
+      name: 'Rent',
+      rule: 'rule-id',
+      next_date: '2024-01-01',
+      completed: false,
+      posts_transaction: true,
+      _payee: null,
+      _account: null,
+      _amountOp: 'is',
+      _date: '2024-01-01',
+      tombstone: false,
+      _conditions: [],
+      _actions: [],
+    };
+
+    expect(
+      scheduleModel.toExternal({ ...baseSchedule, _amount: 12500 }).expectedAmount,
+    ).toBe(12500);
+    expect(
+      scheduleModel.toExternal({ ...baseSchedule, _amount: undefined! })
+        .expectedAmount,
+    ).toBe(0);
+  });
+});
