+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  const rules = recurConfigToRSchedule(config);
+  const rangeStart = d.subDays(new Date(`${start}T12:00:00`), 3);
+  const rangeEnd = d.addDays(new Date(`${end}T12:00:00`), 3);
+  const schedule = new RSchedule({ rrules: rules });
+  const dates = schedule
+    .occurrences({ start: rangeStart, end: rangeEnd })
+    .toArray()
+    .map(occurrence => {
+      const date = occurrence.date;
+      if (!config.skipWeekend) {
+        return dayFromDate(date);
+      }
+      if (config.frequency === 'daily') {
+        return d.isWeekend(date) ? null : dayFromDate(date);
+      }
+      return dayFromDate(
+        getDateWithSkippedWeekend(date, config.weekendSolveMode),
+      );
+    });
+
+  return [...new Set(dates.filter(date => date != null))]
+    .filter(date => date >= start && date <= end)
+    .sort();
+}
