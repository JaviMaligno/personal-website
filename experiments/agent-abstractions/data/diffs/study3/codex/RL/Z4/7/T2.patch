+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const isDaily = config.frequency === 'daily';
+  const rangeStart = d.subDays(parseDate(start), 2);
+  const rangeEnd = d.addDays(parseDate(end), 2);
+  const schedule = new RSchedule({ rrules: rules });
+
+  return schedule
+    .occurrences({ start: rangeStart, end: rangeEnd })
+    .toArray()
+    .flatMap(occurrence => {
+      const date = occurrence.date;
+      if (config.skipWeekend && d.isWeekend(date)) {
+        if (isDaily) {
+          return [];
+        }
+        return [getDateWithSkippedWeekend(date, config.weekendSolveMode)];
+      }
+      return [date];
+    })
+    .map(dayFromDate)
+    .filter(
+      (date, index, dates) =>
+        date >= start && date <= end && dates.indexOf(date) === index,
+    )
+    .sort();
+}
