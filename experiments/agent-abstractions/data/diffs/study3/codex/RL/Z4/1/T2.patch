+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}) {
+  if (start > end) {
+    return [];
+  }
+
+  const rules = recurConfigToRSchedule(config);
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const dates = schedule
+      .occurrences({
+        start: d.subDays(d.startOfDay(new Date(`${start}T12:00:00`)), 2),
+        end: d.addDays(d.startOfDay(new Date(`${end}T12:00:00`)), 2),
+      })
+      .toArray();
+
+    return [...new Set(
+      dates
+        .map(({ date }) => {
+          if (!config.skipWeekend) {
+            return date;
+          }
+          if (config.frequency === 'daily') {
+            return d.isWeekend(date) ? null : date;
+          }
+          return getDateWithSkippedWeekend(date, config.weekendSolveMode);
+        })
+        .filter(date => date != null)
+        .map(dayFromDate)
+        .filter(date => date >= start && date <= end),
+    )].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
