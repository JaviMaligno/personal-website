+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const rangeStart = d.startOfDay(parseDate(start));
+  const rangeEnd = d.startOfDay(parseDate(end));
+  // Weekend adjustments can move an occurrence by at most two days.
+  const occurrenceStart = d.subDays(rangeStart, 2);
+  const occurrenceEnd = d.addDays(rangeEnd, 2);
+  const occurrences = schedule
+    .occurrences({
+      start: occurrenceStart,
+      take: d.differenceInCalendarDays(occurrenceEnd, occurrenceStart) + 1,
+    })
+    .toArray();
+  const dates = new Set<string>();
+
+  for (const occurrence of occurrences) {
+    let date = occurrence.date;
+    if (config.skipWeekend) {
+      if (config.frequency === 'daily' && d.isWeekend(date)) {
+        continue;
+      }
+      if (config.frequency !== 'daily') {
+        date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      }
+    }
+
+    const day = dayFromDate(date);
+    if (day >= start && day <= end) {
+      dates.add(day);
+    }
+  }
+
+  return [...dates].sort();
+}
