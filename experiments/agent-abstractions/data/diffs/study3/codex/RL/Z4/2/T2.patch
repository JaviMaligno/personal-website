+export async function getDatesInRange({ config, start, end }) {
+  const startDate = monthUtils.parseDate(start);
+  const endDate = monthUtils.parseDate(end);
+  if (startDate > endDate) {
+    return [];
+  }
+
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  // A weekend occurrence can move by at most two days. Search outside the
+  // requested range so the range applies to the adjusted date.
+  const occurrences = schedule
+    .occurrences({
+      start: d.subDays(startDate, 2),
+      end: d.addDays(endDate, 2),
+    })
+    .toArray();
+  const dates = new Set<string>();
+
+  for (const occurrence of occurrences) {
+    const occurrenceDate = occurrence.date;
+    if (config.skipWeekend && config.frequency === 'daily' && d.isWeekend(occurrenceDate)) {
+      continue;
+    }
+    const date =
+      config.skipWeekend && config.frequency !== 'daily'
+        ? getDateWithSkippedWeekend(occurrenceDate, config.weekendSolveMode)
+        : occurrenceDate;
+    if (date >= startDate && date <= endDate) {
+      dates.add(dayFromDate(date));
+    }
+  }
+
+  return [...dates].sort();
+}
