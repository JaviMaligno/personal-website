+export async function getDatesInRange({ config, start, end }) {
+  const schedule = new RSchedule({ rrules: recurConfigToRSchedule(config) });
+  // Weekend adjustments can move an occurrence by at most three days. Include
+  // those raw occurrences so membership is based on the adjusted date.
+  const dates = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(new Date(`${start}T12:00:00`), 3)),
+      end: d.endOfDay(d.addDays(new Date(`${end}T12:00:00`), 3)),
+    })
+    .toArray()
+    .map(({ date }) => date);
+
+  const adjusted = dates.flatMap(date => {
+    if (!config.skipWeekend) return [date];
+    if (config.frequency === 'daily') {
+      return d.isWeekend(date) ? [] : [date];
+    }
+    return [getDateWithSkippedWeekend(date, config.weekendSolveMode)];
+  });
+
+  const firstDay = d.startOfDay(new Date(`${start}T00:00:00`));
+  const lastDay = d.endOfDay(new Date(`${end}T00:00:00`));
+  return [
+    ...new Set(
+      adjusted
+        .filter(date => date >= firstDay && date <= lastDay)
+        .map(dayFromDate),
+    ),
+  ].sort();
+}
