+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const startDate = d.subDays(new Date(start), 3);
+  const endDate = d.addDays(new Date(end), 3);
+  const isDaily = config.frequency === 'daily';
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const dates = schedule
+      .occurrences({ start: d.startOfDay(startDate), end: d.endOfDay(endDate) })
+      .toArray()
+      .map(occurrence => {
+        if (!config.skipWeekend) {
+          return occurrence.date;
+        }
+        if (isDaily) {
+          return d.isWeekend(occurrence.date) ? null : occurrence.date;
+        }
+        return getDateWithSkippedWeekend(
+          occurrence.date,
+          config.weekendSolveMode,
+        );
+      })
+      .filter(date => date != null)
+      .map(date => dayFromDate(date))
+      .filter(date => date >= start && date <= end);
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
