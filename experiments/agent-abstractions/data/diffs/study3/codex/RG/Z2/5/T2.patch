@@ -0,0 +1,55 @@
+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  it('exposes the amount furthest from zero as the expected amount', () => {
+    const schedule = {
+      id: 'schedule-id',
+      name: 'Schedule',
+      rule: 'rule-id',
+      next_date: '2026-10-12',
+      completed: false,
+      posts_transaction: false,
+      tombstone: false,
+      _payee: 'payee-id',
+      _account: 'account-id',
+      _amount: { num1: -10100, num2: -20000 },
+      _amountOp: 'isbetween',
+      _date: '2026-10-12',
+      _conditions: [],
+      _actions: [],
+    } satisfies ScheduleEntity;
+
+    expect(scheduleModel.toExternal(schedule)).toMatchObject({
+      amount: { num1: -10100, num2: -20000 },
+      amountOp: 'isbetween',
+      expectedAmount: -20000,
+    });
+  });
+
+  it('uses the single amount or zero when no amount is set', () => {
+    const baseSchedule = {
+      id: 'schedule-id',
+      name: 'Schedule',
+      rule: 'rule-id',
+      next_date: '2026-10-12',
+      completed: false,
+      posts_transaction: false,
+      tombstone: false,
+      _payee: 'payee-id',
+      _account: 'account-id',
+      _amountOp: 'is',
+      _date: '2026-10-12',
+      _conditions: [],
+      _actions: [],
+    };
+
+    expect(
+      scheduleModel.toExternal({ ...baseSchedule, _amount: 1250 }),
+    ).toMatchObject({ expectedAmount: 1250 });
+    expect(
+      scheduleModel.toExternal({ ...baseSchedule, _amount: undefined }),
+    ).toMatchObject({ expectedAmount: 0 });
+  });
+});
