@@ -0,0 +1,28 @@
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  it.each([
+    [125, 125],
+    [{ num1: -10100, num2: -20000 }, -20000],
+    [{ num1: 20000, num2: -10100 }, 20000],
+  ])('derives expected amount from %o', (amount, expectedAmount) => {
+    const schedule = scheduleModel.toExternal({
+      id: 'schedule',
+      name: 'Schedule',
+      rule: 'rule',
+      next_date: '2026-01-01',
+      completed: false,
+      posts_transaction: true,
+      tombstone: false,
+      _payee: 'payee',
+      _account: 'account',
+      _amount: amount,
+      _amountOp: 'isbetween',
+      _date: '2026-01-01',
+      _conditions: [],
+      _actions: [],
+    });
+
+    expect(schedule.expectedAmount).toBe(expectedAmount);
+  });
+});
