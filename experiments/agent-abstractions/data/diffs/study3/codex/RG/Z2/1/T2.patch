+import { scheduleModel } from './api-models';
+import type { ScheduleEntity } from '#types/models/schedule';
+
+describe('scheduleModel', () => {
+  it('includes the amount furthest from zero as expectedAmount', () => {
+    const schedule = {
+      id: 'schedule',
+      _amount: { num1: -10100, num2: -20000 },
+    } as ScheduleEntity;
+
+    expect(scheduleModel.toExternal(schedule).expectedAmount).toBe(-20000);
+    expect(
+      scheduleModel.toExternal({ ...schedule, _amount: { num1: 10100, num2: 20000 } })
+        .expectedAmount,
+    ).toBe(20000);
+  });
+
+  it('uses a single amount directly and defaults a missing amount to zero', () => {
+    const schedule = { id: 'schedule', _amount: -250 } as ScheduleEntity;
+
+    expect(scheduleModel.toExternal(schedule).expectedAmount).toBe(-250);
+    expect(
+      scheduleModel.toExternal({ ...schedule, _amount: undefined }).expectedAmount,
+    ).toBe(0);
+  });
+});
