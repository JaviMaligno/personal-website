+
+function expectedScheduleAmount(amount: ScheduleEntity['_amount'] | undefined): number {
+  if (amount === undefined) {
+    return 0;
+  }
+
+  if (typeof amount === 'number') {
+    return amount;
+  }
+
+  return Math.abs(amount.num1) > Math.abs(amount.num2)
+    ? amount.num1
+    : amount.num2;
