+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  function externalSchedule(amount: ScheduleEntity['_amount']) {
+    const schedule = {
+      id: 'schedule1',
+      name: 'Rent',
+      rule: 'rule1',
+      next_date: '2026-10-12',
+      completed: false,
+      posts_transaction: false,
+      tombstone: false,
+      _payee: 'payee1',
+      _account: 'account1',
+      _amount: amount,
+      _amountOp: 'isbetween',
+      _date: '2026-10-12',
+      _conditions: [],
+      _actions: [],
+    } satisfies ScheduleEntity;
+
+    return scheduleModel.toExternal(schedule);
+  }
+
+  it('uses the range endpoint furthest from zero', () => {
+    expect(externalSchedule({ num1: -10100, num2: -20000 }).expectedAmount).toBe(
+      -20000,
+    );
+    expect(externalSchedule({ num1: 10100, num2: 20000 }).expectedAmount).toBe(
+      20000,
+    );
+  });
+
+  it('uses a single amount as the expected amount', () => {
+    expect(externalSchedule(12345).expectedAmount).toBe(12345);
+  });
+
+  it('uses zero when the schedule has no amount', () => {
+    expect(externalSchedule(null as never).expectedAmount).toBe(0);
+  });
+});
