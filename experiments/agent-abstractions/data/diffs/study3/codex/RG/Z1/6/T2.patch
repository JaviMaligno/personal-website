+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getCategoriesForBulkAction();
+  const prevMonth = monthUtils.prevMonth(month);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      let amount = await getSheetValue(
+        monthUtils.sheetForMonth(prevMonth),
+        'sum-amount-' + cat.id,
+      );
+      if (cat.is_income === 0) {
+        amount *= -1;
+      }
+
+      void setBudget({ category: cat.id, month, amount });
+    }
+  });
+}
