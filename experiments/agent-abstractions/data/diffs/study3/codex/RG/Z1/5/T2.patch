+describe('set last month spending', () => {
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    await setupAverageDatabase();
+  });
+
+  afterEach(async () => {
+    await global.emptyDatabase()();
+  });
+
+  it('budgets expenses from the previous calendar month and zeros inactive categories', async () => {
+    await db.insertCategory({
+      id: 'inactive-cat',
+      name: 'Inactive',
+      cat_group: 'group1',
+      is_income: 0,
+    });
+    await sheet.waitOnSpreadsheet();
+    await setBudget({ category: 'cat1', month: '2024-04', amount: 5000 });
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(1200);
+    expect(await getSheetValue('budget202404', 'budget-inactive-cat')).toBe(0);
+  });
+
+  it('budgets income received in tracking budgets', async () => {
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    await db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+    await db.insertTransaction({
+      date: '2024-03-20',
+      amount: 5000,
+      account: 'account1',
+      category: 'income-cat',
+    });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(5000);
+  });
+});
