+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getBudgetableCategories();
+  const spendingMonth = monthUtils.prevMonth(month);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      const spending = await getSheetValue(
+        monthUtils.sheetForMonth(spendingMonth),
+        `sum-amount-${cat.id}`,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? spending : -spending,
+      });
+    }
+  });
+}
