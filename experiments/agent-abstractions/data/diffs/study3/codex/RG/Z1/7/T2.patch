+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await db.all<db.DbViewCategory>(
+    `SELECT c.* FROM categories c
+     LEFT JOIN category_groups g ON c.cat_group = g.id
+     WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+       AND c.goal_def IS NULL`,
+  );
+  const previousMonth = monthUtils.prevMonth(month);
+
+  await batchMessages(async () => {
+    for (const category of categories) {
+      if (category.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      let amount = await getSheetValue(
+        monthUtils.sheetForMonth(previousMonth),
+        `sum-amount-${category.id}`,
+      );
+      if (category.is_income === 0) {
+        amount *= -1;
+      }
+      void setBudget({ category: category.id, month, amount });
+    }
+  });
+}
