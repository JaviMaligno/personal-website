+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const rangeStart = d.startOfDay(new Date(`${start}T00:00:00`));
+  const rangeEnd = d.startOfDay(new Date(`${end}T00:00:00`));
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // A weekend occurrence can move at most two days across a range edge.
+    const occurrences = schedule
+      .occurrences({
+        start: d.subDays(rangeStart, 2),
+        end: d.addDays(rangeEnd, 3),
+      })
+      .toArray();
+    const dates = new Set<string>();
+
+    for (const occurrence of occurrences) {
+      const date = occurrence.date;
+      if (config.skipWeekend && config.frequency === 'daily' && d.isWeekend(date)) {
+        continue;
+      }
+      const finalDate = config.skipWeekend
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date;
+      const finalDay = dayFromDate(finalDate);
+      if (finalDay >= start && finalDay <= end) {
+        dates.add(finalDay);
+      }
+    }
+
+    return [...dates].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
