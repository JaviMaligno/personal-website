+export async function getDatesInRange({ config, start, end }) {
+  if (start > end) {
+    return [];
+  }
+
+  const rules = recurConfigToRSchedule(config);
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // A weekend occurrence can move by up to three days. Include those
+    // occurrences here, then filter using their adjusted date below.
+    const dates = schedule
+      .occurrences({
+        start: d.subDays(d.startOfDay(monthUtils.parseDate(start)), 3),
+        end: d.addDays(d.startOfDay(monthUtils.parseDate(end)), 3),
+      })
+      .toArray()
+      .map(({ date }) => {
+        if (!config.skipWeekend || !d.isWeekend(date)) {
+          return date;
+        }
+        if (config.frequency === 'daily') {
+          return null;
+        }
+        return getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      })
+      .filter(date => date != null)
+      .map(dayFromDate)
+      .filter(date => date >= start && date <= end);
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
