+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // A weekend occurrence can move by at most two days. Include nearby
+    // occurrences first, then apply the requested range to their final dates.
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(new Date(`${start}T00:00:00`), 3)),
+        end: d.endOfDay(d.addDays(new Date(`${end}T00:00:00`), 3)),
+      })
+      .toArray();
+
+    return [...new Set(occurrences.flatMap(({ date }) => {
+      if (config.skipWeekend && config.frequency === 'daily' && d.isWeekend(date)) {
+        return [];
+      }
+      const finalDate = config.skipWeekend && config.frequency !== 'daily'
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date;
+      const day = dayFromDate(finalDate);
+      return day >= start && day <= end ? [day] : [];
+    }))].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
