+export function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const isDailyWithSkippedWeekends =
+    config.skipWeekend && config.frequency === 'daily';
+  // Weekend adjustment can move an occurrence by at most three days (Sunday
+  // to Friday), so include those source dates when finding occurrences.
+  const occurrenceStart = d.subDays(parseDate(start), 3);
+  const occurrences = schedule
+    .occurrences({
+      start: occurrenceStart,
+      end: d.endOfDay(parseDate(end)),
+    })
+    .toArray();
+
+  return Array.from(
+    new Set(
+      occurrences
+        .filter(({ date }) => !isDailyWithSkippedWeekends || !d.isWeekend(date))
+        .map(({ date }) =>
+          config.skipWeekend && !isDailyWithSkippedWeekends
+            ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+            : date,
+        )
+        .map(dayFromDate)
+        .filter(date => date >= start && date <= end),
+    ),
+  ).sort();
+}
