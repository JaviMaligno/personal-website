+export async function getDatesInRange({ config, start, end }) {
+  if (start > end) {
+    return [];
+  }
+
+  const rules = recurConfigToRSchedule(config);
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // A weekend occurrence can move by at most two days. Include those
+    // original dates, then apply the range to the final scheduled day.
+    const dates = schedule
+      .occurrences({
+        start: d.subDays(d.startOfDay(new Date(start)), 2),
+        end: d.addDays(d.startOfDay(new Date(end)), 2),
+      })
+      .toArray()
+      .map(({ date }) => {
+        if (!config.skipWeekend) return dayFromDate(date);
+        if (config.frequency === 'daily') {
+          return d.isWeekend(date) ? null : dayFromDate(date);
+        }
+        return dayFromDate(
+          getDateWithSkippedWeekend(date, config.weekendSolveMode),
+        );
+      })
+      .filter((date): date is string => date != null)
+      .filter(date => date >= start && date <= end);
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
