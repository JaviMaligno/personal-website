+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const startDate = d.startOfDay(parseDate(start));
+  const endDate = d.endOfDay(parseDate(end));
+  // Weekend adjustment can move an occurrence by at most two days. Include
+  // those source dates so the requested range is evaluated after adjustment.
+  const rangeStart = d.subDays(startDate, 2);
+  const rangeEnd = d.addDays(endDate, 2);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const isDailyWithSkippedWeekends =
+      config.frequency?.toLowerCase() === 'daily' && config.skipWeekend;
+
+    return schedule
+      .occurrences({ start: rangeStart, end: rangeEnd })
+      .toArray()
+      .map(({ date }) => {
+        if (!config.skipWeekend) return date;
+        if (isDailyWithSkippedWeekends && d.isWeekend(date)) return null;
+        return getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      })
+      .filter((date): date is Date => date != null)
+      .map(dayFromDate)
+      .filter(date => date >= start && date <= end)
+      .filter((date, index, dates) => dates.indexOf(date) === index)
+      .sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
