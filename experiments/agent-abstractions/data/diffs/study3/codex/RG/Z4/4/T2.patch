+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const rangeStart = d.subDays(parseDate(start), 3);
+  const rangeEnd = d.addDays(parseDate(end), 3);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const dates = schedule
+      .occurrences({
+        start: d.startOfDay(rangeStart),
+        take: d.differenceInCalendarDays(rangeEnd, rangeStart) + 1,
+      })
+      .toArray()
+      .map(({ date }) => {
+        if (!config.skipWeekend) return date;
+        if (config.frequency === 'daily' && d.isWeekend(date)) return null;
+        return getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      })
+      .filter(Boolean)
+      .map(dayFromDate)
+      .filter(date => date >= start && date <= end);
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
