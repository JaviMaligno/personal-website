+export async function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}): Promise<string[]> {
+  if (start > end) {
+    return [];
+  }
+
+  const rules = recurConfigToRSchedule(config);
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // Weekend occurrences can move up to two days in either direction.
+    // Include those occurrences before filtering on their final date.
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 2)),
+        end: d.endOfDay(d.addDays(parseDate(end), 2)),
+      })
+      .toArray();
+
+    const dates = occurrences.flatMap(({ date }) => {
+      if (!config.skipWeekend) {
+        return [dayFromDate(date)];
+      }
+
+      if (config.frequency === 'daily') {
+        return d.isWeekend(date) ? [] : [dayFromDate(date)];
+      }
+
+      return [
+        dayFromDate(
+          getDateWithSkippedWeekend(date, config.weekendSolveMode),
+        ),
+      ];
+    });
+
+    return [...new Set(dates)]
+      .filter(date => date >= start && date <= end)
+      .sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
