@@ -50,3 +50,22 @@ export async function findOrCreateBank(
 
   return bankData;
 }
+
+/** Refuses to attach a provider account to more than one live local account. */
+export async function assertAccountNotLinked(
+  provider: string,
+  accountId: string,
+  upgradingId?: string,
+): Promise<void> {
+  const linked = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, accountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (linked) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
