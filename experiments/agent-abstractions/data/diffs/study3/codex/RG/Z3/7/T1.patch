@@ -5,6 +5,23 @@ import * as db from '#server/db';
 
 type Institution = string | { name?: string | null };
 
+export async function ensureAccountNotLinked(
+  provider: string,
+  accountId: string,
+  upgradingId?: string,
+) {
+  const existingAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+       AND id != ?`,
+    [provider, accountId, upgradingId ?? ''],
+  );
+
+  if (existingAccount) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
