+
+describe('ensureAccountNotLinked', () => {
+  async function insertLinkedAccount(
+    id: string,
+    provider: string,
+    accountId: string,
+    tombstone = 0,
+    closed = 0,
+  ) {
+    await db.run(
+      `INSERT INTO accounts
+       (id, name, offbudget, closed, tombstone, sort_order, account_id, account_sync_source)
+       VALUES (?, ?, 0, ?, ?, 0, ?, ?)`,
+      [id, id, closed, tombstone, accountId, provider],
+    );
+  }
+
+  it('rejects another live account linked to the same provider account', async () => {
+    await insertLinkedAccount('existing', 'simpleFin', 'external-1');
+
+    await expect(
+      ensureAccountNotLinked('simpleFin', 'external-1', 'new-account'),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows relinking to the account that already holds the link', async () => {
+    await insertLinkedAccount('existing', 'simpleFin', 'external-1', 0, 1);
+
+    await expect(
+      ensureAccountNotLinked('simpleFin', 'external-1', 'existing'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted links and links under a different provider', async () => {
+    await insertLinkedAccount('deleted', 'simpleFin', 'external-1', 1);
+    await insertLinkedAccount('other-provider', 'akahu', 'external-1');
+
+    await expect(
+      ensureAccountNotLinked('simpleFin', 'external-1', 'new-account'),
+    ).resolves.toBeUndefined();
+  });
+});
