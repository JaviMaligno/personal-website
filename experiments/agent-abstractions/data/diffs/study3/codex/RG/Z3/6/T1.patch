+async function ensureBankAccountIsNotLinked(
+  provider: NonNullable<db.DbAccount['account_sync_source']>,
+  accountId: string,
+  upgradingId?: AccountEntity['id'],
+) {
+  const existingAccount = await db.first<Pick<db.DbAccount, 'id'>>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0
+       AND id != ?`,
+    [provider, accountId, upgradingId ?? ''],
+  );
+
+  if (existingAccount) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
