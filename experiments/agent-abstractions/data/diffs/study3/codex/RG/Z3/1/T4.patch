+/** Ensures a provider account has one local owner, optionally taking it over. */
+export async function prepareAccountLink(
+  provider: string,
+  accountId: string,
+  upgradingId?: string,
+  replaceExistingLink = false,
+): Promise<void> {
+  if (!replaceExistingLink) {
+    await assertAccountNotLinked(provider, accountId, upgradingId);
+    return;
+  }
+
+  const linked = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, accountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (linked) {
+    // Keep the local account and its transactions. This is the local portion
+    // of unlinking; do not disconnect the provider connection during takeover.
+    await db.updateAccount({
+      id: linked.id,
+      account_id: null,
+      bank: null,
+      balance_current: null,
+      balance_available: null,
+      balance_limit: null,
+      account_sync_source: null,
+      bank_sync_status: null,
+    });
+  }
+}
