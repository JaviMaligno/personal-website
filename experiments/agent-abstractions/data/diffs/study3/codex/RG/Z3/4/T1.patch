+// @ts-strict-ignore
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+const linkSimpleFin = app.handlers['simplefin-accounts-link'];
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+describe('bank account linking', () => {
+  it('rejects linking a provider account that already belongs to another local account', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing account',
+      account_id: 'provider-account',
+      bank: 'existing-bank',
+      account_sync_source: 'simpleFin',
+    });
+    const before = await db.first('SELECT * FROM accounts WHERE id = ?', [
+      'existing',
+    ]);
+
+    await expect(
+      linkSimpleFin({
+        externalAccount: {
+          account_id: 'provider-account',
+          name: 'Provider account',
+          balance: 10,
+          orgDomain: 'bank.example',
+        },
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(
+      await db.first('SELECT * FROM accounts WHERE id = ?', ['existing']),
+    ).toEqual(before);
+    expect(await db.all('SELECT * FROM accounts')).toHaveLength(1);
+    expect(await db.all('SELECT * FROM payees')).toHaveLength(0);
+    expect(await db.all('SELECT * FROM banks')).toHaveLength(0);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows the same provider account id under another provider', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Existing account',
+      account_id: 'provider-account',
+      bank: 'existing-bank',
+      account_sync_source: 'goCardless',
+    });
+
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+    } as never);
+    await expect(
+      linkSimpleFin({
+        externalAccount: {
+          account_id: 'provider-account',
+          name: 'Provider account',
+          balance: 10,
+          orgDomain: 'bank.example',
+        },
+      }),
+    ).resolves.toBe('ok');
+  });
+});
