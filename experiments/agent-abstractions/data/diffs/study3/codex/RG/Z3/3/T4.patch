+
+describe('ensureAccountIsNotLinked', () => {
+  it('refuses an existing link unless replacement is requested', async () => {
+    await db.insertWithUUID('banks', {
+      id: 'bank',
+      bank_id: 'provider-bank',
+      name: 'Bank',
+    });
+    await db.insertAccount({
+      id: 'old-account',
+      name: 'Old account',
+      bank: 'bank',
+      account_id: 'provider-account',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+
+    await expect(
+      ensureAccountIsNotLinked(
+        'simpleFin',
+        'provider-bank',
+        'provider-account',
+      ),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    await ensureAccountIsNotLinked(
+      'simpleFin',
+      'provider-bank',
+      'provider-account',
+      undefined,
+      true,
+    );
+
+    const account = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['old-account'],
+    );
+    expect(account).toMatchObject({
+      closed: 1,
+      bank: null,
+      account_id: null,
+      account_sync_source: null,
+      balance_current: null,
+      balance_available: null,
+      balance_limit: null,
+      bank_sync_status: null,
+    });
+  });
+});
