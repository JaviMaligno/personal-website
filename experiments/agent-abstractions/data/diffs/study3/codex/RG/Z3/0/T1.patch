@@ -5,6 +5,28 @@ import * as db from '#server/db';
 
 type Institution = string | { name?: string | null };
 
+const ALREADY_LINKED_ERROR =
+  'This bank account is already linked to another account.';
+
+/** Refuses linking a provider account already held by another live account. */
+export async function assertAccountNotLinked(
+  provider: string,
+  accountId: db.DbAccount['account_id'],
+  upgradingId?: db.DbAccount['id'],
+) {
+  const existing = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0 AND account_sync_source = ? AND account_id = ?
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, accountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (existing) {
+    throw new Error(ALREADY_LINKED_ERROR);
+  }
+}
