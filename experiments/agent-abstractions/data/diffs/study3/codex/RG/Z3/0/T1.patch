+describe('assertAccountNotLinked', () => {
+  it('rejects an account held by another non-deleted local account', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'external-1', 'new-account'),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows the current account to refresh its own link', async () => {
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+    });
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'external-1', 'existing'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted accounts and links from other providers', async () => {
+    await db.insertAccount({
+      id: 'deleted',
+      name: 'Deleted',
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+      tombstone: 1,
+    });
+    await db.insertAccount({
+      id: 'different-provider',
+      name: 'Other provider',
+      account_id: 'external-1',
+      account_sync_source: 'goCardless',
+    });
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'external-1', 'new-account'),
+    ).resolves.toBeUndefined();
+  });
+});
