+async function ensureAccountIsOpenForLinking(accountId?: AccountEntity['id']) {
+  if (!accountId) {
+    return;
+  }
+
+  const account = await db.first<Pick<db.DbAccount, 'closed'>>(
+    'SELECT closed FROM accounts WHERE id = ?',
+    [accountId],
+  );
+
+  if (!account) {
+    throw new Error(`Account with ID ${accountId} not found.`);
+  }
+  if (account.closed) {
+    throw new Error(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+  }
+}
