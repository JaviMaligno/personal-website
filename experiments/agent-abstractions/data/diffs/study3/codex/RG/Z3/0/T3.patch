diff --git a/packages/loot-core/src/server/accounts/link.ts b/packages/loot-core/src/server/accounts/link.ts
index ffc3ac8..60bc12b 100644
--- a/packages/loot-core/src/server/accounts/link.ts
+++ b/packages/loot-core/src/server/accounts/link.ts
@@ -7,6 +7,24 @@ type Institution = string | { name?: string | null };
 
 const ALREADY_LINKED_ERROR =
   'This bank account is already linked to another account.';
+const CLOSED_ACCOUNT_ERROR =
+  'Closed accounts cannot be linked to a bank account. Reopen the account first.';
+
+/** Refuses using a closed local account for either a new or existing link. */
+export async function assertAccountOpenForLink(upgradingId?: string) {
+  if (!upgradingId) {
+    return;
+  }
+
+  const account = await db.first<{ closed: number }>(
+    'SELECT closed FROM accounts WHERE id = ? AND tombstone = 0',
+    [upgradingId],
+  );
+
+  if (account?.closed) {
+    throw new Error(CLOSED_ACCOUNT_ERROR);
+  }
+}
 
