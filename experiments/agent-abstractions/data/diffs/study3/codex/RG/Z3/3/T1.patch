   return bankData;
 }
+
+export async function ensureAccountIsNotLinked(
+  provider: string,
+  bankId: db.DbBank['bank_id'],
+  accountId: db.DbAccount['account_id'],
+  upgradingId?: db.DbAccount['id'],
+) {
+  const existing = await db.first<{ id: string }>(
+    `SELECT a.id FROM accounts a
+     JOIN banks b ON b.id = a.bank
+     WHERE a.tombstone = 0 AND a.account_sync_source = ?
+       AND b.bank_id = ? AND a.account_id = ? AND a.id IS NOT ?`,
+    [provider, bankId, accountId, upgradingId ?? null],
+  );
+
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
