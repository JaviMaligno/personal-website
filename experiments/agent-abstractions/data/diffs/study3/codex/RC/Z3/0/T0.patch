@@ -52,6 +52,84 @@ type LinkAccountBaseParams = {
   startingBalance?: number;
 };
 
+type LinkAccountFields = {
+  account_id: string;
+  account_sync_source:
+    | 'goCardless'
+    | 'simpleFin'
+    | 'pluggyai'
+    | 'akahu'
+    | 'enableBanking';
+  mask?: string;
+  name?: string;
+  official_name?: string;
+};
+
+async function linkAccountAndSync({
+  upgradingId,
+  offBudget,
+  account,
+  bank,
+  startingDate,
+  startingBalance,
+  fileId,
+  tables = ['transactions', 'accounts'],
+}: {
+  upgradingId?: AccountEntity['id'];
+  offBudget: boolean;
+  account: LinkAccountFields;
+  bank: Awaited<ReturnType<typeof link.findOrCreateBank>>;
+  startingDate?: string;
+  startingBalance?: number;
+  fileId?: string;
+  tables?: Array<'transactions' | 'accounts'>;
+}) {
+  let id: string;
+
+  if (upgradingId) {
+    const accRow = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [upgradingId],
+    );
+
+    if (!accRow) {
+      throw new Error(`Account with ID ${upgradingId} not found.`);
+    }
+
+    id = accRow.id;
+    await db.update('accounts', {
+      id,
+      account_id: account.account_id,
+      bank: bank.id,
+      account_sync_source: account.account_sync_source,
+    });
+  } else {
+    id = uuidv4();
+    await db.insertWithUUID('accounts', {
+      id,
+      ...account,
+      bank: bank.id,
+      offbudget: offBudget ? 1 : 0,
+    });
+    await db.insertPayee({ name: '', transfer_acct: id });
+  }
+
+  const syncRes = await bankSync.syncAccount(
+    undefined,
+    undefined,
+    id,
+    account.account_id,
+    bank.bank_id,
+    startingDate,
+    startingBalance,
+    ...(fileId === undefined ? [] : [fileId]),
+  );
+
+  await handleSyncResponse(syncRes, id);
+  connection.send('sync-event', { type: 'success', tables });
+  return 'ok';
+}
+
 export type AccountHandlers = {
