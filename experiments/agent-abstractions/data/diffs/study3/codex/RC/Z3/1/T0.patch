 };
 
+type LinkedAccountData = {
+  account_id: string;
+  name?: string;
+  official_name?: string;
+  mask?: string;
+  bank: string;
+  offbudget: number;
+  account_sync_source: NonNullable<AccountEntity['account_sync_source']>;
+};
+
+async function linkBankSyncAccount({
+  upgradingId,
+  account,
+  startingDate,
+  startingBalance,
+  bankId,
+  fileId,
+  includeFileId = false,
+  eventTables,
+}: {
+  upgradingId?: AccountEntity['id'];
+  account: LinkedAccountData;
+  startingDate?: string;
+  startingBalance?: number;
+  bankId: string;
+  fileId?: string;
+  includeFileId?: boolean;
+  eventTables: string[];
+}) {
+  let id: string;
+
+  if (upgradingId) {
+    const accRow = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [upgradingId],
+    );
+
+    if (!accRow) {
+      throw new Error(`Account with ID ${upgradingId} not found.`);
+    }
+
+    id = accRow.id;
+    await db.update('accounts', {
+      id,
+      account_id: account.account_id,
+      bank: account.bank,
+      account_sync_source: account.account_sync_source,
+    });
+  } else {
+    id = uuidv4();
+    await db.insertWithUUID('accounts', { id, ...account });
+    await db.insertPayee({ name: '', transfer_acct: id });
+  }
+
+  const syncRes = await bankSync.syncAccount(
+    undefined,
+    undefined,
+    id,
+    account.account_id,
+    bankId,
+    startingDate,
+    startingBalance,
+    ...(includeFileId ? [fileId] : []),
+  );
+
+  await handleSyncResponse(syncRes, id);
+  connection.send('sync-event', { type: 'success', tables: eventTables });
+  return 'ok';
+}
+
