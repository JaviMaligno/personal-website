+type LinkBankSyncAccountParams = {
+  upgradingId?: AccountEntity['id'];
+  offBudget: boolean;
+  bankId: string;
+  externalAccountId: string;
+  accountSyncSource: NonNullable<AccountEntity['account_sync_source']>;
+  accountFields: Partial<
+    Pick<db.DbAccount, 'name' | 'official_name' | 'mask'>
+  >;
+  providerBankId: string;
+  startingDate?: string;
+  startingBalance?: number;
+  fileId?: string;
+  eventTables: string[];
+};
+
+async function linkBankSyncAccount({
+  upgradingId,
+  offBudget,
+  bankId,
+  externalAccountId,
+  accountSyncSource,
+  accountFields,
+  providerBankId,
+  startingDate,
+  startingBalance,
+  fileId,
+  eventTables,
+}: LinkBankSyncAccountParams) {
+  let id: string;
+
+  if (upgradingId) {
+    const accRow = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [upgradingId],
+    );
+
+    if (!accRow) {
+      throw new Error(`Account with ID ${upgradingId} not found.`);
+    }
+
+    id = accRow.id;
+    await db.update('accounts', {
+      id,
+      account_id: externalAccountId,
+      bank: bankId,
+      account_sync_source: accountSyncSource,
+    });
+  } else {
+    id = uuidv4();
+    await db.insertWithUUID('accounts', {
+      id,
+      account_id: externalAccountId,
+      ...accountFields,
+      bank: bankId,
+      offbudget: offBudget ? 1 : 0,
+      account_sync_source: accountSyncSource,
+    });
+    await db.insertPayee({ name: '', transfer_acct: id });
+  }
+
+  const syncRes = await bankSync.syncAccount(
+    undefined,
+    undefined,
+    id,
+    externalAccountId,
+    providerBankId,
+    startingDate,
+    startingBalance,
+    fileId,
+  );
+
+  await handleSyncResponse(syncRes, id);
+  connection.send('sync-event', { type: 'success', tables: eventTables });
+  return 'ok';
+}
+
