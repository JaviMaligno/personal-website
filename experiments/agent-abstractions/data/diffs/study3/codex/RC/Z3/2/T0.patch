 };
 
+type BankSyncAccountDetails = {
+  account_id: string;
+  name: string;
+  official_name?: string;
+  mask?: string;
+};
+
+async function linkBankSyncAccount({
+  account,
+  bank,
+  provider,
+  upgradingId,
+  offBudget,
+  startingDate,
+  startingBalance,
+  fileId,
+  eventTables,
+}: {
+  account: BankSyncAccountDetails;
+  bank: Pick<db.DbBank, 'id' | 'bank_id'>;
+  provider: AccountEntity['account_sync_source'];
+  upgradingId?: AccountEntity['id'];
+  offBudget: boolean;
+  startingDate?: string;
+  startingBalance?: number;
+  fileId?: string;
+  eventTables: Array<'transactions' | 'accounts'>;
+}) {
+  let id: string;
+
+  if (upgradingId) {
+    const accRow = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [upgradingId],
+    );
+    if (!accRow) {
+      throw new Error(`Account with ID ${upgradingId} not found.`);
+    }
+
+    id = accRow.id;
+    await db.update('accounts', {
+      id,
+      account_id: account.account_id,
+      bank: bank.id,
+      account_sync_source: provider,
+    });
+  } else {
+    id = uuidv4();
+    await db.insertWithUUID('accounts', {
+      id,
+      account_id: account.account_id,
+      ...(account.mask !== undefined && { mask: account.mask }),
+      name: account.name,
+      official_name: account.official_name ?? account.name,
+      bank: bank.id,
+      offbudget: offBudget ? 1 : 0,
+      account_sync_source: provider,
+    });
+    await db.insertPayee({ name: '', transfer_acct: id });
+  }
+
+  const syncRes = await bankSync.syncAccount(
+    undefined,
+    undefined,
+    id,
+    account.account_id,
+    bank.bank_id,
+    startingDate,
+    startingBalance,
+    fileId,
+  );
+  await handleSyncResponse(syncRes, id);
+  connection.send('sync-event', { type: 'success', tables: eventTables });
+  return 'ok';
+}
