+async function linkBankSyncAccount({
+  bank,
+  accountId,
+  accountData,
+  accountSyncSource,
+  upgradingId,
+  offBudget,
+  startingDate,
+  startingBalance,
+  fileId,
+  includeFileId,
+  tables,
+}: {
+  bank: Pick<db.DbBank, 'id' | 'bank_id'>;
+  accountId: string;
+  accountData: Partial<Pick<AccountEntity, 'name' | 'official_name' | 'mask'>>;
+  accountSyncSource: AccountEntity['account_sync_source'];
+  upgradingId?: AccountEntity['id'];
+  offBudget: boolean;
+  startingDate?: string;
+  startingBalance?: number;
+  fileId?: string;
+  includeFileId?: boolean;
+  tables: Array<'transactions' | 'accounts'>;
+}) {
+  let id: AccountEntity['id'];
+  if (upgradingId) {
+    const accRow = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [upgradingId],
+    );
+    if (!accRow) {
+      throw new Error(`Account with ID ${upgradingId} not found.`);
+    }
+    id = accRow.id;
+    await db.update('accounts', {
+      id,
+      account_id: accountId,
+      bank: bank.id,
+      account_sync_source: accountSyncSource,
+    });
+  } else {
+    id = uuidv4();
+    await db.insertWithUUID('accounts', {
+      id,
+      account_id: accountId,
+      ...accountData,
+      bank: bank.id,
+      offbudget: offBudget ? 1 : 0,
+      account_sync_source: accountSyncSource,
+    });
+    await db.insertPayee({ name: '', transfer_acct: id });
+  }
+
+  const syncRes = includeFileId
+    ? await bankSync.syncAccount(
+        undefined,
+        undefined,
+        id,
+        accountId,
+        bank.bank_id,
+        startingDate,
+        startingBalance,
+        fileId,
+      )
+    : await bankSync.syncAccount(
+        undefined,
+        undefined,
+        id,
+        accountId,
+        bank.bank_id,
+        startingDate,
+        startingBalance,
+      );
+  await handleSyncResponse(syncRes, id);
+  connection.send('sync-event', { type: 'success', tables });
+  return 'ok';
+}
