   startingBalance?: number;
 };
 
+type BankSyncAccountFields = Pick<
+  db.DbAccount,
+  'account_id'
+> &
+  Partial<Pick<db.DbAccount, 'mask' | 'name' | 'official_name'>> & {
+    account_sync_source: AccountEntity['account_sync_source'];
+  };
+
+async function linkBankSyncAccount({
+  bank,
+  fields,
+  upgradingId,
+  offBudget,
+  startingDate,
+  startingBalance,
+  fileId,
+  tables,
+}: {
+  bank: { id: string; bank_id: string };
+  fields: BankSyncAccountFields;
+  upgradingId?: AccountEntity['id'];
+  offBudget: boolean;
+  startingDate?: string;
+  startingBalance?: number;
+  fileId?: string | null;
+  tables: Array<'transactions' | 'accounts'>;
+}) {
+  let id: AccountEntity['id'];
+
+  if (upgradingId) {
+    const accRow = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [upgradingId],
+    );
+
+    if (!accRow) {
+      throw new Error(`Account with ID ${upgradingId} not found.`);
+    }
+
+    id = accRow.id;
+    await db.update('accounts', {
+      id,
+      account_id: fields.account_id,
+      bank: bank.id,
+      account_sync_source: fields.account_sync_source,
+    });
+  } else {
+    id = uuidv4();
+    await db.insertWithUUID('accounts', {
+      id,
+      ...fields,
+      bank: bank.id,
+      offbudget: offBudget ? 1 : 0,
+    });
+    await db.insertPayee({ name: '', transfer_acct: id });
+  }
+
+  const syncRes = await bankSync.syncAccount(
+    undefined,
+    undefined,
+    id,
+    fields.account_id,
+    bank.bank_id,
+    startingDate,
+    startingBalance,
+    fileId,
+  );
+
+  await handleSyncResponse(syncRes, id);
+  connection.send('sync-event', { type: 'success', tables });
+  return 'ok';
+}
+
