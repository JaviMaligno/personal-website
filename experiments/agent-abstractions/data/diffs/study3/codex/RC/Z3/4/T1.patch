+// @ts-strict-ignore
+import * as connection from '#platform/server/connection';
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+import { runMutator } from '#server/mutators';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+describe('bank account linking', () => {
+  it('refuses a second link without changing data or contacting the sync server', async () => {
+    db.runQuery(
+      'INSERT INTO banks (id, bank_id, name, tombstone) VALUES (?, ?, ?, 0)',
+      ['bank1', 'sfin-bank', 'SimpleFin'],
+    );
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      bank: 'bank1',
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+    vi.mocked(connection.send).mockClear();
+
+    await expect(
+      runMutator(() =>
+        app.handlers['simplefin-accounts-link']({
+          externalAccount: {
+            account_id: 'external-1',
+            name: 'Checking',
+            orgId: 'new-bank',
+            balance: 0,
+          },
+          upgradingId: 'other-account',
+        }),
+      ),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    const accounts = await db.all<db.DbAccount>('SELECT * FROM accounts');
+    expect(accounts).toHaveLength(1);
+    expect(accounts[0]).toMatchObject({
+      id: 'existing',
+      name: 'Checking',
+      bank: 'bank1',
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+    });
+    expect(await db.all('SELECT * FROM banks')).toHaveLength(1);
+    expect(await db.all('SELECT * FROM payees')).toHaveLength(0);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(connection.send).not.toHaveBeenCalled();
+  });
+
+  it('allows relinking the account that already holds the bank link', async () => {
+    db.runQuery(
+      'INSERT INTO banks (id, bank_id, name, tombstone) VALUES (?, ?, ?, 0)',
+      ['bank1', 'sfin-bank', 'SimpleFin'],
+    );
+    await db.insertAccount({
+      id: 'existing',
+      name: 'Checking',
+      bank: 'bank1',
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+    });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await runMutator(() =>
+      app.handlers['simplefin-accounts-link']({
+        externalAccount: {
+          account_id: 'external-1',
+          name: 'Checking',
+          orgId: 'sfin-bank',
+          institution: 'SimpleFin',
+          balance: 0,
+        },
+        upgradingId: 'existing',
+      }),
+    );
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
