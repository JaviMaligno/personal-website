--- a/packages/loot-core/src/server/accounts/link.ts
+++ b/packages/loot-core/src/server/accounts/link.ts
@@ -50,3 +50,28 @@ export async function findOrCreateBank(
 
   return bankData;
 }
+
+export async function ensureAccountIsNotLinked(
+  accountSyncSource: string,
+  externalAccountId: string,
+  upgradingId?: string,
+) {
+  const existingAccount = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE tombstone = 0
+       AND account_sync_source = ?
+       AND account_id = ?
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [
+      accountSyncSource,
+      externalAccountId,
+      upgradingId ?? null,
+      upgradingId ?? null,
+    ],
+  );
+
+  if (existingAccount) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
