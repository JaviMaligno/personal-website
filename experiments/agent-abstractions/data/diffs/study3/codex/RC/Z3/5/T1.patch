@@ -87,3 +87,49 @@ describe('findOrCreateBank', () => {
     expect(await getBanks()).toHaveLength(1);
   });
 });
+
+describe('ensureAccountIsNotLinked', () => {
+  async function addLinkedAccount(
+    id: string,
+    provider: string,
+    accountId: string,
+    tombstone = 0,
+    closed = 0,
+  ) {
+    await db.insertAccount({
+      id,
+      name: id,
+      account_id: accountId,
+      account_sync_source: provider,
+      tombstone,
+      closed,
+    });
+  }
+
+  it('rejects an account linked to another active local account', async () => {
+    await addLinkedAccount('existing', 'simpleFin', 'external-1', 0, 1);
+
+    await expect(
+      ensureAccountIsNotLinked('simpleFin', 'external-1'),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows relinking into the account that already holds the link', async () => {
+    await addLinkedAccount('existing', 'simpleFin', 'external-1');
+
+    await expect(
+      ensureAccountIsNotLinked('simpleFin', 'external-1', 'existing'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted accounts and links from another provider', async () => {
+    await addLinkedAccount('deleted', 'simpleFin', 'external-1', 1);
+    await addLinkedAccount('other-provider', 'akahu', 'external-1');
+
+    await expect(
+      ensureAccountIsNotLinked('simpleFin', 'external-1'),
+    ).resolves.toBeUndefined();
+  });
+});
diff --git a/packages/loot-core/src/server/accounts/link.ts b/packages/loot-core/src/server/accounts/link.ts
