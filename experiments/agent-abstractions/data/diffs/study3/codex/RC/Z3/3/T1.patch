+import { app } from '#server/accounts/app';
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(bankSync.syncAccount).mockResolvedValue({
+    added: [],
+    updated: [],
+    updatedPreview: [],
+  });
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+describe('bank account linking', () => {
+  it('rejects a bank account already linked to another local account without changes', async () => {
+    await db.insertAccount({
+      id: 'linked-account',
+      name: 'Existing',
+      account_id: 'provider-account',
+      account_sync_source: 'simpleFin',
+      closed: 1,
+    });
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount: {
+          account_id: 'provider-account',
+          name: 'Checking',
+          balance: 100,
+          institution: 'Bank',
+          orgId: 'bank.example',
+        },
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(await db.all('SELECT * FROM accounts')).toHaveLength(1);
+    expect(await db.all('SELECT * FROM payees')).toHaveLength(0);
+    expect(await db.all('SELECT * FROM banks')).toHaveLength(0);
+  });
+
+  it('does not treat a deleted link or another provider as the same bank account', async () => {
+    await db.insertAccount({
+      id: 'deleted-account',
+      name: 'Deleted',
+      account_id: 'provider-account',
+      account_sync_source: 'goCardless',
+      tombstone: 1,
+    });
+    await db.insertAccount({
+      id: 'other-provider-account',
+      name: 'Other provider',
+      account_id: 'provider-account',
+      account_sync_source: 'goCardless',
+    });
+
+    // A duplicate link is rejected before any provider sync call; the account
+    // under another provider does not block this provider's account ID.
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        externalAccount: {
+          account_id: 'provider-account',
+          name: 'Checking',
+          balance: 100,
+          orgId: 'bank.example',
+        },
+      }),
+    ).resolves.toBe('ok');
+  });
+});
