+    await db.insertAccount({ id: 'acct2', name: 'Chosen account' });
+    await db.insertPayee({ name: 'Unrelated', transfer_acct: null });
+    const accountCountBefore = await db.first<{ count: number }>(
+      'SELECT count(*) as count FROM accounts',
+    );
+    const payeeCountBefore = await db.first<{ count: number }>(
+      'SELECT count(*) as count FROM payees',
+    );
+
+    await expect(
+      simpleFinAccountsLinkHandler({
+        externalAccount: {
+          account_id: 'external-1',
+          name: 'New local account',
+          balance: 100,
+          orgDomain: 'org.example',
+        },
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+    expect(
+      await db.first<{ count: number }>('SELECT count(*) as count FROM accounts'),
+    ).toEqual(accountCountBefore);
