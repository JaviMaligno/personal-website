+      cleared: true,
+    });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+    vi.mocked(connection.send).mockClear();
+
+    await runMutator(() =>
+      app.handlers['simplefin-accounts-link']({
+        externalAccount: {
+          account_id: 'external-1',
+          name: 'New checking',
+          orgId: 'sfin-bank',
+          balance: 0,
+        },
+        upgradingId: 'replacement',
+        replaceExistingLink: true,
+      }),
+    );
+
+    expect(
+      await db.first<db.DbAccount>(
+        'SELECT * FROM accounts WHERE id = ?',
+        ['existing'],
+      ),
+    ).toMatchObject({
+      id: 'existing',
+      name: 'Old checking',
+      bank: null,
+      account_id: null,
+      account_sync_source: null,
+      closed: 0,
+    });
+    expect(
+      await db.first('SELECT id FROM transactions WHERE acct = ?', ['existing']),
+    ).toBeTruthy();
+    expect(
+      await db.first<db.DbAccount>(
+        'SELECT * FROM accounts WHERE id = ?',
+        ['replacement'],
+      ),
+    ).toMatchObject({
+      bank: expect.any(String),
+      account_id: 'external-1',
+      account_sync_source: 'simpleFin',
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+    expect(connection.send).toHaveBeenCalledWith('sync-event', {
+      type: 'success',
+      tables: ['transactions', 'accounts'],
+    });
+  });
+
