+describe('bank account linking', () => {
+  it('rejects an account already linked through the same provider without changing anything', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+
+    await expect(
+      simpleFinLinkHandler({
+        externalAccount: {
+          account_id: 'ext-1',
+          name: 'Checking',
+          balance: 0,
+          orgId: 'sfin-bank',
+        },
+      }),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+
+    expect(
+      await db.first('SELECT id FROM accounts WHERE id = ?', ['acct1']),
+    ).toBeTruthy();
+    expect(await db.first('SELECT count(*) as count FROM accounts')).toEqual({
+      count: 1,
+    });
+    expect(await db.first('SELECT count(*) as count FROM payees')).toEqual({
+      count: 0,
+    });
+    expect(await db.first('SELECT count(*) as count FROM banks')).toEqual({
+      count: 1,
+    });
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('allows relinking the account that already holds the link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await simpleFinLinkHandler({
+      externalAccount: {
+        account_id: 'ext-1',
+        name: 'Checking',
+        balance: 0,
+        orgId: 'sfin-bank',
+      },
+      upgradingId: 'acct1',
+    });
+
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not treat a deleted account as holding its bank link', async () => {
+    await setupSimpleFinAccounts([
+      { id: 'acct1', name: 'Checking', accountId: 'ext-1' },
+    ]);
+    db.runQuery('UPDATE accounts SET tombstone = 1 WHERE id = ?', ['acct1']);
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+      updatedPreview: [],
+    });
+
+    await simpleFinLinkHandler({
+      externalAccount: {
+        account_id: 'ext-1',
+        name: 'Checking',
+        balance: 0,
+        orgId: 'sfin-bank',
+      },
+    });
+
+    expect(await db.first('SELECT count(*) as count FROM accounts')).toEqual({
+      count: 2,
+    });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
+});
