+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // Weekend adjustment can move an occurrence by at most two calendar days.
+    const occurrences = schedule
+      .occurrences({
+        start: d.subDays(d.startOfDay(new Date(`${start}T12:00:00`)), 2),
+        end: d.addDays(d.startOfDay(new Date(`${end}T12:00:00`)), 2),
+      })
+      .toArray();
+    const days = new Set<string>();
+
+    for (const occurrence of occurrences) {
+      const isDaily = config.frequency === 'daily';
+      if (isDaily && config.skipWeekend === true && d.isWeekend(occurrence.date)) {
+        continue;
+      }
+
+      const date = isDaily
+        ? occurrence.date
+        : getDateWithSkippedWeekend(
+            occurrence.date,
+            config.weekendSolveMode,
+            config.skipWeekend === true,
+          );
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        days.add(day);
+      }
+    }
+
+    return [...days].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
