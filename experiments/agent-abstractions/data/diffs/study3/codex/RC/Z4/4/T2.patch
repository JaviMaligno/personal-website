+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const rangeStart = d.subDays(d.startOfDay(new Date(`${start}T00:00:00`)), 3);
+  const rangeEnd = d.addDays(d.startOfDay(new Date(`${end}T00:00:00`)), 3);
+  const isDaily = config.frequency === 'daily';
+
+  return [
+    ...new Set(
+      schedule
+        .occurrences({ start: rangeStart, end: rangeEnd })
+        .toArray()
+        .flatMap(({ date }) => {
+          if (isDaily && config.skipWeekend && d.isWeekend(date)) {
+            return [];
+          }
+          const finalDate = getDateWithWeekendRule(
+            date,
+            config.skipWeekend,
+            config.weekendSolveMode,
+          );
+          const day = dayFromDate(finalDate);
+          return day >= start && day <= end ? [day] : [];
+        }),
+    ),
+  ].sort();
+}
