+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const rangeStart = d.startOfDay(parseDate(start));
+  const rangeEnd = d.endOfDay(parseDate(end));
+  if (rangeStart > rangeEnd) return [];
+  // Weekend adjustments can move an occurrence by at most three days.
+  const occurrences = new RSchedule({ rrules: rules })
+    .occurrences({
+      start: d.subDays(rangeStart, 3),
+      end: d.addDays(rangeEnd, 3),
+    })
+    .toArray();
+  const isDaily = config.frequency === 'daily';
+  return [...new Set(occurrences.flatMap(({ date }) => {
+    if (isDaily && config.skipWeekend && d.isWeekend(date)) {
+      return [];
+    }
+    const finalDate = isDaily
+      ? date
+      : getDateWithSkippedWeekend(
+          date,
+          config.weekendSolveMode,
+          config.skipWeekend ?? false,
+        );
+    return d.isWithinInterval(finalDate, { start: rangeStart, end: rangeEnd })
+      ? [dayFromDate(finalDate)]
+      : [];
+  }))].sort();
+}
