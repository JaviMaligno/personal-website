+export async function getDatesInRange({ config, start, end }) {
+  if (start > end) return [];
+
+  const rules = recurConfigToRSchedule(config);
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // Weekend adjustments can move an occurrence by at most three days.
+    const occurrenceStart = d.subDays(new Date(`${start}T00:00:00`), 3);
+    const occurrenceEnd = d.addDays(new Date(`${end}T00:00:00`), 3);
+    const count = d.differenceInCalendarDays(occurrenceEnd, occurrenceStart) + 1;
+    const dates = schedule
+      .occurrences({ start: d.startOfDay(occurrenceStart), take: count })
+      .toArray()
+      .map(({ date }) => {
+        if (config.frequency === 'daily' && config.skipWeekend && d.isWeekend(date)) {
+          return null;
+        }
+        return dayFromDate(
+          getDateWithWeekendRule(
+            date,
+            config.skipWeekend,
+            config.weekendSolveMode,
+          ),
+        );
+      });
+
+    return [...new Set(dates.filter(date => date != null && date >= start && date <= end))].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
