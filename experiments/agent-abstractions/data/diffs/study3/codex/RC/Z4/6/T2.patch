+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const startDate = d.parseISO(start);
+  const endDate = d.parseISO(end);
+  const daily = config.frequency === 'daily';
+  // Weekend adjustments can move a Saturday or Sunday occurrence by at most
+  // two days, so include those source dates before and after the requested range.
+  const sourceStart = d.subDays(startDate, config.skipWeekend ? 2 : 0);
+  const sourceEnd = d.addDays(endDate, config.skipWeekend ? 2 : 0);
+  const span = d.differenceInCalendarDays(sourceEnd, sourceStart) + 1;
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const occurrences = schedule
+      .occurrences({ start: d.startOfDay(sourceStart), take: span })
+      .toArray();
+    const dates = new Set<string>();
+
+    for (const occurrence of occurrences) {
+      if (occurrence.date > sourceEnd) break;
+      if (daily && config.skipWeekend && d.isWeekend(occurrence.date)) {
+        continue;
+      }
+      const adjusted = getScheduleDate(
+        occurrence.date,
+        config.skipWeekend && !daily,
+        config.weekendSolveMode,
+      );
+      const day = dayFromDate(adjusted);
+      if (day >= start && day <= end) dates.add(day);
+    }
+
+    return [...dates].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
