+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const rangeStart = d.startOfDay(parseISO(start));
+  const rangeEnd = d.endOfDay(parseISO(end));
+  // Weekend adjustments can move Saturday/Sunday occurrences by up to two days.
+  const occurrenceStart = d.subDays(rangeStart, 2);
+  const occurrenceEnd = d.addDays(rangeEnd, 2);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const isDaily = config.frequency === 'daily';
+    const dates = schedule
+      .occurrences({ start: occurrenceStart, end: occurrenceEnd })
+      .toArray()
+      .map(({ date }) => date)
+      .filter(date => !(isDaily && config.skipWeekend && d.isWeekend(date)))
+      .map(date =>
+        getDateWithWeekendRule(
+          date,
+          config.skipWeekend,
+          config.weekendSolveMode,
+        ),
+      )
+      .filter(date => date >= rangeStart && date <= rangeEnd)
+      .map(dayFromDate);
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
