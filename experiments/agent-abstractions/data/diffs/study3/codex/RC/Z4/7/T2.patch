+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const firstDate = d.subDays(d.startOfDay(new Date(start + 'T12:00:00')), 3);
+  const lastDate = d.addDays(d.startOfDay(new Date(end + 'T12:00:00')), 3);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const dates = schedule
+      .occurrences({ start: firstDate, end: lastDate })
+      .toArray()
+      .map(({ date }) => {
+        if (config.frequency === 'daily' && config.skipWeekend && d.isWeekend(date)) {
+          return null;
+        }
+        return dayFromDate(
+          getDateWithSkippedWeekend(date, config.weekendSolveMode, Boolean(config.skipWeekend)),
+        );
+      })
+      .filter((date): date is string => date != null && date >= start && date <= end);
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
