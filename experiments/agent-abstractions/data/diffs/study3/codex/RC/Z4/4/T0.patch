+/** Applies a schedule's weekend rule to an occurrence date. */
+export function getDateWithWeekendRule(
+  date: Date,
+  skipWeekend: boolean,
+  solveMode: 'after' | 'before',
+) {
+  return skipWeekend ? getDateWithSkippedWeekend(date, solveMode) : date;
+}
+
+export function getDateStringWithWeekendRule(
+  date: string | null,
+  skipWeekend: boolean,
+  solveMode: 'after' | 'before',
+) {
+  if (!skipWeekend || date == null) {
+    return date;
+  }
+  return monthUtils.dayFromDate(
+    getDateWithWeekendRule(monthUtils._parse(date), true, solveMode),
+  );
+}
