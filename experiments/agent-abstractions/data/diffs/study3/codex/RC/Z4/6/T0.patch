+/** Applies a schedule's weekend rule to an occurrence date. */
+export function getScheduleDate(
+  date: Date,
+  skipWeekend: boolean,
+  solveMode: 'after' | 'before',
+) {
+  if (!skipWeekend || !d.isWeekend(date)) {
+    return date;
   }
-  return date;
+  if (solveMode === 'after') {
+    return d.nextMonday(date);
+  } else if (solveMode === 'before') {
+    return d.previousFriday(date);
+  }
+  throw new Error('Unknown weekend solve mode, this should not happen!');
+}
+
+export function getScheduleDateString(
+  date: string,
+  skipWeekend: boolean,
+  solveMode: 'after' | 'before',
+) {
+  return skipWeekend
+    ? monthUtils.dayFromDate(
+        getScheduleDate(monthUtils._parse(date), true, solveMode),
+      )
+    : date;
