+export async function getDatesInRange({ config, start, end }) {
+  const startDate = parseDate(start);
+  const endDate = parseDate(end);
+  if (startDate > endDate) {
+    return [];
+  }
+
+  const rules = recurConfigToRSchedule(config);
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // Weekend adjustments can move an occurrence by at most two days. Include
+    // those neighboring occurrences so range membership is based on the date
+    // after adjustment.
+    const occurrenceStart = d.subDays(startDate, 2);
+    const occurrenceEnd = d.addDays(endDate, 2);
+    const take = d.differenceInCalendarDays(occurrenceEnd, occurrenceStart) + 1;
+    const isDaily = config.frequency === 'daily';
+
+    return [
+      ...new Set(
+        schedule
+          .occurrences({ start: occurrenceStart, take })
+          .toArray()
+          .map(({ date }) => {
+            if (isDaily && config.skipWeekend === true && d.isWeekend(date)) {
+              return null;
+            }
+            return dayFromDate(
+              getDateWithSkippedWeekend(
+                date,
+                config.weekendSolveMode,
+                config.skipWeekend === true,
+              ),
+            );
+          })
+          .filter(date => date != null && date >= start && date <= end),
+      ),
+    ].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
