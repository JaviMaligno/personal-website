@@ -0,0 +1,33 @@
+import type { ScheduleEntity } from '#types/models/schedule';
+
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  it.each([
+    [125, 125],
+    [{ num1: -101, num2: -200 }, -200],
+    [{ num1: 200, num2: -101 }, 200],
+    [undefined, 0],
+  ])('returns expected amount for %j', (amount, expectedAmount) => {
+    const schedule = {
+      id: 'schedule-id',
+      name: 'Schedule',
+      rule: 'rule-id',
+      next_date: '2026-01-01',
+      completed: false,
+      posts_transaction: false,
+      tombstone: false,
+      _payee: 'payee-id',
+      _account: 'account-id',
+      _amount: amount,
+      _amountOp: 'is',
+      _date: '2026-01-01',
+      _conditions: [],
+      _actions: [],
+    } as ScheduleEntity;
+
+    expect(scheduleModel.toExternal(schedule).expectedAmount).toBe(
+      expectedAmount,
+    );
+  });
+});
