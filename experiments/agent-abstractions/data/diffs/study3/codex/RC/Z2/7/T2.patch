+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  it.each([
+    [100, 100],
+    [{ num1: 10100, num2: 20000 }, 20000],
+    [{ num1: -10100, num2: -20000 }, -20000],
+    [{ num1: -25000, num2: 10000 }, -25000],
+  ])('returns expected amount for %j', (amount, expectedAmount) => {
+    expect(
+      scheduleModel.toExternal({
+        id: 'schedule',
+        name: 'Schedule',
+        rule: 'rule',
+        next_date: '2024-01-01',
+        completed: false,
+        posts_transaction: true,
+        tombstone: false,
+        _payee: 'payee',
+        _account: 'account',
+        _amount: amount,
+        _amountOp: 'isbetween',
+        _date: '2024-01-01',
+        _conditions: [],
+        _actions: [],
+      }).expectedAmount,
+    ).toBe(expectedAmount);
+  });
+});
