+/**
+ * Resolve a ranged schedule amount to its expected value. The budget template
+ * path historically rounds the sum before dividing; keep that option so this
+ * refactor preserves its results for half values.
+ */
+export function getExpectedScheduleAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  rounding: 'midpoint' | 'template' = 'midpoint',
+): number {
+  if (amount == null) return 0;
+  if (typeof amount === 'number') return amount;
+
+  return rounding === 'template'
+    ? Math.round(amount.num1 + amount.num2) / 2
+    : Math.round((amount.num1 + amount.num2) / 2);
 }
 
