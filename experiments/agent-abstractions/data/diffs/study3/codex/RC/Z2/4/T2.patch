+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+function makeSchedule(
+  amount: ScheduleEntity['_amount'],
+): ScheduleEntity {
+  return {
+    id: 'schedule-id',
+    name: 'Schedule',
+    rule: 'rule-id',
+    next_date: '2024-01-01',
+    completed: false,
+    posts_transaction: true,
+    tombstone: false,
+    _payee: 'payee-id',
+    _account: 'account-id',
+    _amount: amount,
+    _amountOp: 'isbetween',
+    _date: '2024-01-01',
+    _conditions: [],
+    _actions: [],
+  };
+}
+
+describe('scheduleModel', () => {
+  it('returns the range endpoint furthest from zero as expectedAmount', () => {
+    expect(
+      scheduleModel.toExternal(makeSchedule({ num1: -10100, num2: -20000 }))
+        .expectedAmount,
+    ).toBe(-20000);
+    expect(
+      scheduleModel.toExternal(makeSchedule({ num1: 10000, num2: -20000 }))
+        .expectedAmount,
+    ).toBe(-20000);
+  });
+
+  it('returns a single amount or zero as expectedAmount', () => {
+    expect(scheduleModel.toExternal(makeSchedule(12500)).expectedAmount).toBe(
+      12500,
+    );
+  });
+});
