+import type { ScheduleEntity } from '#types/models';
+
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  it.each([
+    [{ num1: -10100, num2: -20000 }, -20000],
+    [5000, 5000],
+    [null, 0],
+  ])('returns expectedAmount for %j', (amount, expectedAmount) => {
+    const schedule = {
+      id: 'schedule',
+      name: 'Schedule',
+      rule: 'rule',
+      next_date: '2026-10-12',
+      completed: false,
+      posts_transaction: true,
+      tombstone: false,
+      _payee: 'payee',
+      _account: 'account',
+      _amount: amount,
+      _amountOp: 'isbetween',
+      _date: '2026-10-12',
+      _conditions: [],
+      _actions: [],
+    } satisfies ScheduleEntity;
+
+    expect(scheduleModel.toExternal(schedule)).toMatchObject({
+      amount,
+      amountOp: 'isbetween',
+      expectedAmount,
+    });
+  });
+});
