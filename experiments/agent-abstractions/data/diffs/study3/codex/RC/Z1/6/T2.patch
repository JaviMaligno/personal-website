+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden>(
+    `SELECT c.*, g.hidden AS group_hidden
+     FROM categories c
+     LEFT JOIN category_groups g ON c.cat_group = g.id
+     WHERE c.tombstone = 0`,
+  );
+  const prevMonth = monthUtils.prevMonth(month);
+  const sheetName = monthUtils.sheetForMonth(prevMonth);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (!shouldWriteMonthBudgetCategory(cat, 'last-month-spending')) {
+        continue;
+      }
+
+      const spending = await getSheetValue(
+        sheetName,
+        'sum-amount-' + cat.id,
+      );
+      const amount = cat.is_income === 0 ? -spending : spending;
+      void setBudget({ category: cat.id, month, amount });
+    }
+  });
+}
