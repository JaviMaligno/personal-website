@@ -298,6 +298,41 @@ export async function setZero({ month }: { month: string }): Promise<void> {
   });
 }
 
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden & { goal_def: string | null }>(
+    `
+    SELECT c.*, g.hidden AS group_hidden
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+    `,
+  );
+  const previousMonth = monthUtils.prevMonth(month);
+  const previousSheet = monthUtils.sheetForMonth(previousMonth);
+
+  await batchMessages(async () => {
+    for (const category of categories) {
+      if (!shouldWriteMonthBudget(category)) {
+        continue;
+      }
+
+      const previousSpending = await getSheetValue(
+        previousSheet,
+        `sum-amount-${category.id}`,
+      );
+      void setBudget({
+        category: category.id,
+        month,
+        amount: averageBudgetAmount(category.is_income, previousSpending),
+      });
+    }
+  });
+}
