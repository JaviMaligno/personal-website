+describe('setZero', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves hidden and template-managed categories unchanged', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'visible', name: 'Visible', is_income: 0 });
+    await db.insertCategoryGroup({ id: 'hidden-group', name: 'Hidden', is_income: 0, hidden: 1 });
+    await db.insertCategory({ id: 'regular', name: 'Regular', cat_group: 'visible', is_income: 0 });
+    await db.insertCategory({ id: 'hidden', name: 'Hidden', cat_group: 'visible', is_income: 0, hidden: 1 });
+    await db.insertCategory({ id: 'in-hidden-group', name: 'In hidden group', cat_group: 'hidden-group', is_income: 0 });
+    await db.insertCategory({ id: 'templated', name: 'Templated', cat_group: 'visible', is_income: 0, goal_def: '[{"directive":"template"}]' });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+
+    for (const category of ['regular', 'hidden', 'in-hidden-group', 'templated']) {
+      await setBudget({ category, month: '2024-01', amount: 500 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-regular')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-hidden')).toBe(500);
+    expect(await getSheetValue('budget202401', 'budget-in-hidden-group')).toBe(500);
+    expect(await getSheetValue('budget202401', 'budget-templated')).toBe(500);
+  });
+});
