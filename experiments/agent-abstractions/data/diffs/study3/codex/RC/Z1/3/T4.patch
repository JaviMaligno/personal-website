+describe('month-wide budget actions with hidden categories', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('includes hidden categories when requested while preserving other exclusions', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    const group = await db.insertCategoryGroup({
+      id: 'group',
+      name: 'Group',
+      is_income: 0,
+    });
+    const hiddenGroup = await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    const hidden = await db.insertCategory({
+      id: 'hidden', name: 'Hidden', cat_group: group, is_income: 0, hidden: 1,
+    });
+    const inHiddenGroup = await db.insertCategory({
+      id: 'group-hidden', name: 'Group hidden', cat_group: hiddenGroup, is_income: 0,
+    });
+    const templated = await db.insertCategory({
+      id: 'templated', name: 'Templated', cat_group: group, is_income: 0,
+    });
+    const fixedGroup = await db.insertCategoryGroup({
+      id: 'fixed-group', name: 'Fixed', is_income: 0,
+    });
+    const fixed = await db.insertCategory({
+      id: 'fixed', name: 'Fixed', cat_group: fixedGroup, is_income: 0,
+    });
+    await db.updateWithSchema('categories', {
+      id: templated,
+      goal_def: JSON.stringify([{ type: 'monthly', amount: 100 }]),
+    });
+    await db.run(`INSERT INTO notes (id, note) VALUES (?, ?)`, [fixedGroup, '#fixed']);
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-04']);
+    for (const category of [hidden, inHiddenGroup, templated, fixed]) {
+      await setBudget({ category, month: '2024-04', amount: 1234 });
+    }
+
+    await setZero({ month: '2024-04', includeHiddenCategories: true });
+    await sheet.waitOnSpreadsheet();
+
+    expect(getBudget({ category: hidden, month: '2024-04' })).toBe(0);
+    expect(getBudget({ category: inHiddenGroup, month: '2024-04' })).toBe(0);
+    expect(getBudget({ category: templated, month: '2024-04' })).toBe(1234);
+    expect(getBudget({ category: fixed, month: '2024-04' })).toBe(1234);
+  });
+});
+
