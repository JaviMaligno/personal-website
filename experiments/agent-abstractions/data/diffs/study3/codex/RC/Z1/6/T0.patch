+type MonthBudgetCategory = Pick<
+  db.DbViewCategoryWithGroupHidden,
+  'is_income' | 'hidden' | 'group_hidden'
+>;
+
+type MonthBudgetAction = 'copy-previous' | 'zero' | 'average';
+
+/** The shared category rules for actions that write a whole month's budget. */
+function shouldWriteMonthBudgetCategory(
+  category: MonthBudgetCategory,
+  action: MonthBudgetAction,
+): boolean {
+  if (category.is_income === 1 && !isTrackingBudget()) {
+    return false;
+  }
+  if (
+    (action === 'copy-previous' || action === 'average') &&
+    (category.hidden === 1 || category.group_hidden === 1)
+  ) {
+    return false;
+  }
+  return true;
+}
+
+function averageBudgetAmount(amount: number, isIncome: number): number {
+  return isIncome === 0 ? amount * -1 : amount;
+}
