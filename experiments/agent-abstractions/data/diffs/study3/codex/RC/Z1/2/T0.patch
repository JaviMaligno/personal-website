@@ -0,0 +1,33 @@
+export type MonthBudgetCategory = {
+  id?: string;
+  is_income: number;
+  hidden?: number;
+  group_hidden?: number;
+};
+
+type MonthBudgetAction = 'copy' | 'zero' | 'average';
+
+/** Shared category policy for actions that write budgets across a month. */
+export function shouldBudgetCategory(
+  category: MonthBudgetCategory,
+  action: MonthBudgetAction,
+  isTrackingBudget: boolean,
+): boolean {
+  if (!isTrackingBudget && category.is_income === 1) {
+    return false;
+  }
+
+  if (action !== 'zero') {
+    return category.hidden !== 1 && category.group_hidden !== 1;
+  }
+
+  return true;
+}
+
+/** Spending totals are negative; budget amounts for expense categories are positive. */
+export function averageToBudgetAmount(
+  average: number,
+  isIncome: number,
+): number {
+  return isIncome === 0 ? average * -1 : average;
+}
