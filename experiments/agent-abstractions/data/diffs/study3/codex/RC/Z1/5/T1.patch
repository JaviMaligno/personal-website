diff --git a/packages/loot-core/src/server/budget/month-action.test.ts b/packages/loot-core/src/server/budget/month-action.test.ts
new file mode 100644
index 0000000..9f03c5a
--- /dev/null
+++ b/packages/loot-core/src/server/budget/month-action.test.ts
@@ -0,0 +1,53 @@
+import { describe, expect, it } from 'vitest';
+
+import { shouldWriteMonthBudget } from './month-action';
+
+describe('shouldWriteMonthBudget', () => {
+  const visibleCategory = {
+    is_income: 0 as const,
+    hidden: 0 as const,
+    group_hidden: 0 as const,
+    has_saved_template: 0 as const,
+  };
+
+  it('skips hidden categories and categories in hidden groups for every month action', () => {
+    for (const isTrackingBudget of [false, true]) {
+      expect(
+        shouldWriteMonthBudget(
+          { ...visibleCategory, hidden: 1 },
+          isTrackingBudget,
+        ),
+      ).toBe(false);
+      expect(
+        shouldWriteMonthBudget(
+          { ...visibleCategory, group_hidden: 1 },
+          isTrackingBudget,
+        ),
+      ).toBe(false);
+    }
+  });
+
+  it('skips categories with saved templates', () => {
+    expect(
+      shouldWriteMonthBudget(
+        { ...visibleCategory, has_saved_template: 1 },
+        false,
+      ),
+    ).toBe(false);
+  });
+
+  it('preserves income category behavior', () => {
+    expect(
+      shouldWriteMonthBudget(
+        { ...visibleCategory, is_income: 1 },
+        false,
+      ),
+    ).toBe(false);
+    expect(
+      shouldWriteMonthBudget(
+        { ...visibleCategory, is_income: 1 },
+        true,
+      ),
+    ).toBe(true);
+  });
+});
