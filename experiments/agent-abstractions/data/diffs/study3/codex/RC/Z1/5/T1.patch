-export type MonthBudgetAction = 'copy-previous' | 'zero' | 'average';
-
 /**
- * Preserve the category selection used by each month-wide budget action.
- * Zeroing has historically included hidden categories; copy and averages
- * only operate on visible categories and groups.
+ * Month-wide actions leave hidden categories and categories managed by a
+ * saved template alone.
  */
 export function shouldWriteMonthBudget(
   category: MonthActionCategory,
-  action: MonthBudgetAction,
   isTrackingBudget: boolean,
 ): boolean {
   if (category.is_income === 1 && !isTrackingBudget) {
     return false;
   }
 
-  if (action !== 'zero' && (category.hidden === 1 || category.group_hidden === 1)) {
+  if (
+    category.hidden === 1 ||
+    category.group_hidden === 1 ||
+    category.has_saved_template === 1 ||
+    category.has_saved_template === true
+  ) {
     return false;
   }
 
