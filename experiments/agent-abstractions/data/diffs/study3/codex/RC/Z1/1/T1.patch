diff --git a/packages/loot-core/src/server/budget/month-budget-categories.test.ts b/packages/loot-core/src/server/budget/month-budget-categories.test.ts
new file mode 100644
index 0000000..dea6143
--- /dev/null
+++ b/packages/loot-core/src/server/budget/month-budget-categories.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from 'vitest';
+
+import { categoriesForMonthBudgetAction } from './month-budget-categories';
+
+describe('categoriesForMonthBudgetAction', () => {
+  it('skips hidden categories, hidden groups, and categories with saved templates', () => {
+    const categories = [
+      { id: 'visible', is_income: 0 as const, hidden: 0 as const, group_hidden: 0 as const, goal_def: null },
+      { id: 'hidden', is_income: 0 as const, hidden: 1 as const, group_hidden: 0 as const, goal_def: null },
+      { id: 'hidden-group', is_income: 0 as const, hidden: 0 as const, group_hidden: 1 as const, goal_def: null },
+      { id: 'templated', is_income: 0 as const, hidden: 0 as const, group_hidden: 0 as const, goal_def: '[]' },
+    ];
+
+    expect(categoriesForMonthBudgetAction(categories, false).map(c => c.id)).toEqual([
+      'visible',
+    ]);
+  });
+
+  it('keeps income categories eligible only in tracking budgets', () => {
+    const categories = [
+      { id: 'income', is_income: 1 as const, hidden: 0 as const, group_hidden: 0 as const, goal_def: null },
+    ];
+
+    expect(categoriesForMonthBudgetAction(categories, false)).toEqual([]);
+    expect(categoriesForMonthBudgetAction(categories, true)).toEqual(categories);
+  });
+});
