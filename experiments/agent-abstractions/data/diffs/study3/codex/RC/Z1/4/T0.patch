+type MonthActionCategory = Pick<
+  BudgetData,
+  'is_income' | 'hidden' | 'group_hidden'
+>;
+
+/** Shared rules for deciding which categories a whole-month action writes. */
+function shouldWriteMonthActionCategory(
+  category: MonthActionCategory,
+  { includeHidden, tracking }: { includeHidden: boolean; tracking: boolean },
+): boolean {
+  return (
+    (includeHidden || (category.hidden === 0 && category.group_hidden === 0)) &&
+    (tracking || category.is_income === 0)
+  );
+}
+
+function averageToBudgetAmount(
+  category: Pick<BudgetData, 'is_income'>,
+  average: number,
+) {
+  return category.is_income === 0 ? average * -1 : average;
+}
