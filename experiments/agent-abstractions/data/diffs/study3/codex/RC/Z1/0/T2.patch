+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const previousMonth = monthUtils.prevMonth(month);
+  const categories = await getMonthBudgetCategories(
+    'average',
+    isTrackingBudget(),
+  );
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      const activity = await getSheetValue(
+        monthUtils.sheetForMonth(previousMonth),
+        `sum-amount-${cat.id}`,
+      );
+      const amount = averageToBudgetAmount(activity, cat.is_income);
+      void setBudget({ category: cat.id, month, amount });
+    }
+  });
+}
