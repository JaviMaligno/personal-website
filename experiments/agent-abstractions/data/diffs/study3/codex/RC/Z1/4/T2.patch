   });
 }
 
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await db.all<
+    MonthActionCategory & Pick<db.DbCategory, 'id'>
+  >(
+    `SELECT c.id, c.is_income, c.hidden, c.goal_def, g.hidden AS group_hidden
+     FROM categories c
+     LEFT JOIN category_groups g ON c.cat_group = g.id
+     WHERE c.tombstone = 0`,
+  );
+  const prevMonth = monthUtils.prevMonth(month);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (
+        !shouldWriteMonthActionCategory(cat, { tracking: isTrackingBudget() })
+      ) {
+        continue;
+      }
+
+      const spending = await getSheetValue(
+        monthUtils.sheetForMonth(prevMonth),
+        'sum-amount-' + cat.id,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 0 ? spending * -1 : spending,
+      });
+    }
+  });
+}
