diff --git a/packages/loot-core/src/server/budget/month-action.ts b/packages/loot-core/src/server/budget/month-action.ts
new file mode 100644
index 0000000..ebe33d2
--- /dev/null
+++ b/packages/loot-core/src/server/budget/month-action.ts
@@ -0,0 +1,37 @@
+/** Category rules for actions that write budgets across a whole month. */
+export type MonthActionCategory = {
+  is_income: 1 | 0;
+  hidden: 1 | 0;
+  group_hidden: 1 | 0;
+};
+
+export type MonthBudgetAction = 'copy-previous' | 'zero' | 'average';
+
+/**
+ * Preserve the category selection used by each month-wide budget action.
+ * Zeroing has historically included hidden categories; copy and averages
+ * only operate on visible categories and groups.
+ */
+export function shouldWriteMonthBudget(
+  category: MonthActionCategory,
+  action: MonthBudgetAction,
+  isTrackingBudget: boolean,
+): boolean {
+  if (category.is_income === 1 && !isTrackingBudget) {
+    return false;
+  }
+
+  if (action !== 'zero' && (category.hidden === 1 || category.group_hidden === 1)) {
+    return false;
+  }
+
+  return true;
+}
+
+/** Averages use sheet activity (expenses negative, income positive). */
+export function averageToBudgetAmount(
+  amount: number,
+  isIncome: 1 | 0,
+): number {
+  return isIncome === 0 ? amount * -1 : amount;
+}
