 }
 
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = getBudgetActionCategories(
+    await db.all<BudgetActionEligibility & { id: string }>(`
+      SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden,
+        CASE WHEN c.goal_def IS NOT NULL THEN 1 ELSE 0 END AS has_template
+      FROM categories c
+      LEFT JOIN category_groups g ON c.cat_group = g.id
+      WHERE c.tombstone = 0
+    `),
+    { includeHiddenCategories: false, includeHiddenGroups: false },
+  );
+  const previousMonth = monthUtils.prevMonth(month);
+  const previousSheet = monthUtils.sheetForMonth(previousMonth);
+
+  await batchMessages(async () => {
+    for (const category of categories) {
+      const activity = await getSheetValue(
+        previousSheet,
+        `sum-amount-${category.id}`,
+      );
+      const amount = getAverageBudgetAmount(activity, category.is_income === 1);
+      void setBudget({ category: category.id, month, amount });
+    }
+  });
+}
