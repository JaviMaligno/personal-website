+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden>(
+    `
+    SELECT c.*, g.hidden AS group_hidden, (c.goal_def IS NOT NULL AND
+      COALESCE(JSON_EXTRACT(c.template_settings, '$.source'), 'notes') = 'ui') AS has_saved_template
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+    `,
+  );
+  const prevMonth = monthUtils.prevMonth(month);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (!shouldWriteMonthBudget(cat, isTrackingBudget())) {
+        continue;
+      }
+
+      const spending = await getSheetValue(
+        monthUtils.sheetForMonth(prevMonth),
+        'sum-amount-' + cat.id,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: averageToBudgetAmount(spending, cat.is_income),
+      });
+    }
+  });
+}
