+++ b/packages/loot-core/src/server/budget/month-budget-categories.ts
@@ -0,0 +1,38 @@
+type BudgetAction = 'copy-previous-month' | 'set-zero' | 'set-average';
+
+type CategoryBudgetFields = {
+  is_income: 0 | 1;
+  hidden?: 0 | 1;
+  group_hidden?: 0 | 1;
+};
+
+/**
+ * Shared rules for which categories a month-wide budget action writes.
+ * The actions intentionally have different hidden-category behavior: copy
+ * and averages omit hidden categories, while set-zero includes them.
+ */
+export function categoriesForMonthBudgetAction<T extends CategoryBudgetFields>(
+  categories: T[],
+  action: BudgetAction,
+  isTrackingBudget: boolean,
+): T[] {
+  return categories.filter(category => {
+    if (category.is_income === 1 && !isTrackingBudget) {
+      return false;
+    }
+
+    if (action === 'set-zero') {
+      return true;
+    }
+
+    return category.hidden === 0 && category.group_hidden === 0;
+  });
+}
+
+/** Average spending is negative in the ledger, so budget non-income amounts positively. */
+export function amountForAverageBudget(
+  amount: number,
+  isIncome: boolean,
+): number {
+  return isIncome ? amount : amount * -1;
+}
