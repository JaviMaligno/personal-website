@@ -0,0 +1,63 @@
+import * as db from '#server/db';
+
+export type MonthBudgetAction = 'copy-previous' | 'zero' | 'average';
+
+export type MonthBudgetCategory = Pick<
+  db.DbViewCategoryWithGroupHidden,
+  'id' | 'is_income' | 'hidden' | 'group_hidden'
+>;
+
+export function shouldIncludeMonthBudgetCategory(
+  action: MonthBudgetAction,
+  category: Pick<MonthBudgetCategory, 'is_income' | 'hidden' | 'group_hidden'>,
+  isTrackingBudget: boolean,
+): boolean {
+  return (
+    (isTrackingBudget || category.is_income === 0) &&
+    (action === 'zero' ||
+      (category.hidden === 0 && category.group_hidden === 0))
+  );
+}
+
+/** The shared category policy for actions that fill a whole budget month. */
+export async function getMonthBudgetCategories(
+  action: MonthBudgetAction,
+  isTrackingBudget: boolean,
+  previousMonth?: string,
+): Promise<MonthBudgetCategory[]> {
+  let categories: MonthBudgetCategory[];
+
+  if (action === 'copy-previous') {
+    categories = await db.all<MonthBudgetCategory>(
+      `
+      SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+      FROM ${isTrackingBudget ? 'reflect_budgets' : 'zero_budgets'} b
+      JOIN categories c ON b.category = c.id
+      LEFT JOIN category_groups g ON c.cat_group = g.id
+      WHERE c.tombstone = 0 AND b.month = ?
+      `,
+      [previousMonth],
+    );
+  } else {
+    categories = await db.all<MonthBudgetCategory>(`
+      SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden
+      FROM categories c
+      LEFT JOIN category_groups g ON c.cat_group = g.id
+      WHERE c.tombstone = 0${
+        action === 'average' ? ' AND c.hidden = 0 AND g.hidden = 0' : ''
+      }
+    `);
+  }
+
+  return categories.filter(category =>
+    shouldIncludeMonthBudgetCategory(action, category, isTrackingBudget),
+  );
+}
+
+/** Convert signed activity into the positive budget amount used by averages. */
+export function averageToBudgetAmount(
+  average: number,
+  isIncome: number,
+): number {
+  return isIncome === 0 ? average * -1 : average;
+}
