+type BudgetActionEligibility = Pick<
+  db.DbViewCategoryWithGroupHidden,
+  'is_income' | 'hidden' | 'group_hidden'
+>;
+
+type BudgetActionCategoryPolicy = {
+  includeHiddenCategories: boolean;
+  includeHiddenGroups: boolean;
+};
+
+/** The shared eligibility rules for actions that write a whole month. */
+function getBudgetActionCategories<T extends BudgetActionEligibility>(
+  categories: T[],
+  policy: BudgetActionCategoryPolicy,
+): T[] {
+  const isTracking = isTrackingBudget();
+  return categories.filter(
+    category =>
+      (policy.includeHiddenCategories || category.hidden !== 1) &&
+      (policy.includeHiddenGroups || category.group_hidden !== 1) &&
+      (isTracking || category.is_income !== 1),
+  );
+}
+
+function getAverageBudgetAmount(amount: number, isIncome: boolean): number {
+  return isIncome ? amount : amount * -1;
+}
