     expect(categoriesForMonthBudgetAction(categories, false)).toEqual([]);
     expect(categoriesForMonthBudgetAction(categories, true)).toEqual(categories);
   });
+
+  it('includes hidden categories on request while keeping other exclusions', () => {
+    const categories = [
+      { id: 'hidden', is_income: 0 as const, hidden: 1 as const, group_hidden: 0 as const, goal_def: null },
+      { id: 'hidden-group', is_income: 0 as const, hidden: 0 as const, group_hidden: 1 as const, goal_def: null },
+      { id: 'fixed', is_income: 0 as const, hidden: 1 as const, group_hidden: 0 as const, group_notes: '#fixed', goal_def: null },
+      { id: 'templated', is_income: 0 as const, hidden: 1 as const, group_hidden: 0 as const, goal_def: '[]' },
+      { id: 'income', is_income: 1 as const, hidden: 1 as const, group_hidden: 0 as const, goal_def: null },
+    ];
+
+    expect(categoriesForMonthBudgetAction(categories, false, true).map(c => c.id)).toEqual([
+      'hidden',
+      'hidden-group',
+    ]);
+    expect(categoriesForMonthBudgetAction(categories, true, true).map(c => c.id)).toEqual([
+      'hidden',
+      'hidden-group',
+      'income',
+    ]);
+  });
 });
