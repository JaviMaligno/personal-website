+describe('set budget to last month spending', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('uses previous month spending for expenses and income categories', async () => {
+    await db.insertAccount({ id: 'account1', name: 'Account 1' });
+    await db.insertCategoryGroup({ id: 'expenses', name: 'Expenses', is_income: 0 });
+    await db.insertCategoryGroup({ id: 'income', name: 'Income', is_income: 1 });
+    await db.insertCategory({ id: 'expense', name: 'Expense', cat_group: 'expenses', is_income: 0 });
+    await db.insertCategory({ id: 'income-cat', name: 'Income', cat_group: 'income', is_income: 1 });
+    await db.insertCategory({ id: 'unused', name: 'Unused', cat_group: 'expenses', is_income: 0, hidden: 1 });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-03', '2024-04']);
+    await db.insertTransaction({ date: '2024-03-15', amount: -3000, account: 'account1', category: 'expense' });
+    await db.insertTransaction({ date: '2024-03-16', amount: 5000, account: 'account1', category: 'income-cat' });
+    db.runQuery(`INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`);
+    await setBudget({ category: 'unused', month: '2024-04', amount: 77 });
+    await sheet.waitOnSpreadsheet();
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-expense')).toBe(3000);
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(5000);
+    expect(await getSheetValue('budget202404', 'budget-unused')).toBe(77);
+  });
+});
