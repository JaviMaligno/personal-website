+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await db.all<
+    db.DbViewCategoryWithGroupHidden & { has_template: 1 | 0 }
+  >(
+    `SELECT c.*, (c.goal_def IS NOT NULL) AS has_template,
+            g.hidden AS group_hidden
+       FROM categories c
+       LEFT JOIN category_groups g ON c.cat_group = g.id
+      WHERE c.tombstone = 0`,
+  );
+  const previousMonth = monthUtils.prevMonth(month);
+  const previousSheet = monthUtils.sheetForMonth(previousMonth);
+
+  await batchMessages(async () => {
+    for (const category of categories) {
+      if (!shouldBudgetCategory(category, 'average', isTrackingBudget())) {
+        continue;
+      }
+
+      const spending = await getSheetValue(
+        previousSheet,
+        `sum-amount-${category.id}`,
+      );
+      void setBudget({
+        category: category.id,
+        month,
+        amount: averageToBudgetAmount(spending, category.is_income),
+      });
+    }
+  });
+}
