+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await db.all<
+    db.DbViewCategoryWithGroupHidden & { goal_def: string | null }
+  >(
+    `SELECT c.*, g.hidden AS group_hidden
+     FROM categories c
+     LEFT JOIN category_groups g ON c.cat_group = g.id
+     WHERE c.tombstone = 0`,
+  );
+  const writableCategories = categoriesForMonthBudgetAction(
+    categories,
+    isTrackingBudget(),
+  );
+  const previousMonth = monthUtils.prevMonth(month);
+
+  await batchMessages(async () => {
+    for (const category of writableCategories) {
+      const amount = await getSheetValue(
+        monthUtils.sheetForMonth(previousMonth),
+        `sum-amount-${category.id}`,
+      );
+      void setBudget({
+        category: category.id,
+        month,
+        amount: amountForAverageBudget(amount, category.is_income === 1),
+      });
+    }
+  });
+}
