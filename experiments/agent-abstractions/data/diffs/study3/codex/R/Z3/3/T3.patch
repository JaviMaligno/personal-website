+async function ensureAccountCanBeLinked(upgradingId?: AccountEntity['id']) {
+  if (!upgradingId) {
+    return;
+  }
+
+  const account = await db.first<Pick<db.DbAccount, 'id' | 'closed'>>(
+    'SELECT id, closed FROM accounts WHERE id = ?',
+    [upgradingId],
+  );
+
+  if (!account) {
+    throw new Error(`Account with ID ${upgradingId} not found.`);
+  }
+
+  if (account.closed === 1) {
+    throw new Error(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+  }
+}
