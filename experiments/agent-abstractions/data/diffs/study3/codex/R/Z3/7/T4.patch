+        name: 'New checking',
+        balance: 0,
+        institution: 'SimpleFin',
+        orgId: 'sfin-bank',
+      },
+      replaceExistingLink: true,
+    });
+
+    expect(
+      await db.first<db.DbAccount>(
+        'SELECT * FROM accounts WHERE id = ?',
+        ['old-acct'],
+      ),
+    ).toMatchObject({
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      balance_current: null,
+      balance_available: null,
+      balance_limit: null,
+      bank_sync_status: null,
+    });
+    expect(
+      await db.first('SELECT id FROM transactions WHERE id = ?', [
+        'old-transaction',
+      ]),
+    ).toBeTruthy();
+    expect(
+      await db.first('SELECT id FROM accounts WHERE account_id = ?', [
+        'external-1',
+      ]),
+    ).toMatchObject({ id: expect.not.stringMatching(/^old-acct$/) });
+    expect(bankSync.syncAccount).toHaveBeenCalledTimes(1);
+  });
