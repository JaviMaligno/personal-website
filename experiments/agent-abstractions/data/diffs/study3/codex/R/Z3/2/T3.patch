@@ -0,0 +1,89 @@
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+
+import { app } from './app';
+import * as bankSync from './sync';
+
+vi.mock('./sync', async () => ({
+  ...(await vi.importActual('./sync')),
+  syncAccount: vi.fn(),
+}));
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  await global.emptyDatabase()();
+  await loadMappings();
+});
+
+describe('linking an existing closed account', () => {
+  it('rejects a new bank link without changing the account or creating a bank', async () => {
+    await db.insertAccount({ id: 'closed', name: 'Closed', closed: 1 });
+    const before = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      ['closed'],
+    );
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        upgradingId: 'closed',
+        externalAccount: {
+          account_id: 'external-1',
+          balance: 100,
+          institution: 'Bank',
+          orgDomain: 'bank.example',
+          name: 'Checking',
+        },
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(
+      await db.first('SELECT * FROM accounts WHERE id = ?', ['closed']),
+    ).toEqual(before);
+    expect(await db.all('SELECT * FROM banks')).toEqual([]);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+
+  it('rejects re-linking a closed account that already holds that bank link', async () => {
+    await db.insertAccount({
+      id: 'closed',
+      name: 'Closed',
+      closed: 1,
+      account_id: 'external-1',
+      bank: 'existing-bank',
+      account_sync_source: 'simpleFin',
+    });
+    db.runQuery(
+      'INSERT INTO banks (id, bank_id, name, tombstone) VALUES (?, ?, ?, 0)',
+      ['existing-bank', 'bank.example', 'Bank'],
+    );
+
+    await expect(
+      app.handlers['simplefin-accounts-link']({
+        upgradingId: 'closed',
+        externalAccount: {
+          account_id: 'external-1',
+          balance: 100,
+          institution: 'Bank',
+          orgDomain: 'bank.example',
+          name: 'Checking',
+        },
+      }),
+    ).rejects.toThrow(
+      'Closed accounts cannot be linked to a bank account. Reopen the account first.',
+    );
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'closed',
+      ]),
+    ).toMatchObject({
+      closed: 1,
+      account_id: 'external-1',
+      bank: 'existing-bank',
+    });
+    expect(await db.all('SELECT * FROM banks')).toHaveLength(1);
+    expect(bankSync.syncAccount).not.toHaveBeenCalled();
+  });
+});
