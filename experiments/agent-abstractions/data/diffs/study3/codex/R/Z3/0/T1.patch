@@ -87,3 +87,45 @@ describe('findOrCreateBank', () => {
     expect(await getBanks()).toHaveLength(1);
   });
 });
+
+describe('assertAccountIsNotLinked', () => {
+  async function addAccount(
+    id: string,
+    provider: string,
+    accountId: string,
+    tombstone = 0,
+  ) {
+    await db.insertWithUUID('accounts', {
+      id,
+      name: id,
+      account_sync_source: provider,
+      account_id: accountId,
+      tombstone,
+    });
+  }
+
+  it('rejects a link held by another non-deleted account', async () => {
+    await addAccount('existing', 'simpleFin', 'bank-account');
+
+    await expect(
+      assertAccountIsNotLinked('simpleFin', 'bank-account'),
+    ).rejects.toThrow('This bank account is already linked to another account.');
+  });
+
+  it('allows relinking into the account that already holds the link', async () => {
+    await addAccount('existing', 'simpleFin', 'bank-account');
+
+    await expect(
+      assertAccountIsNotLinked('simpleFin', 'bank-account', 'existing'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted accounts and links from another provider', async () => {
+    await addAccount('deleted', 'simpleFin', 'bank-account', 1);
+    await addAccount('other-provider', 'goCardless', 'bank-account');
+
+    await expect(
+      assertAccountIsNotLinked('simpleFin', 'bank-account'),
+    ).resolves.toBeUndefined();
+  });
+});
diff --git a/packages/loot-core/src/server/accounts/link.ts b/packages/loot-core/src/server/accounts/link.ts
