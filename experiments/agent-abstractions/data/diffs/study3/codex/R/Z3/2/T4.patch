     expect(bankSync.syncAccount).not.toHaveBeenCalled();
   });
 });
+
+describe('replacing an existing bank link', () => {
+  it('unlinks the old local account while preserving it and its transactions', async () => {
+    await db.insertAccount({
+      id: 'old',
+      name: 'Old account',
+      closed: 1,
+      account_id: 'external-1',
+      bank: 'existing-bank',
+      account_sync_source: 'simpleFin',
+    });
+    db.runQuery(
+      'INSERT INTO banks (id, bank_id, name, tombstone) VALUES (?, ?, ?, 0)',
+      ['existing-bank', 'bank.example', 'Bank'],
+    );
+    await db.insertTransaction({
+      id: 'transaction-1',
+      account: 'old',
+      amount: 100,
+      date: '2025-01-01',
+    });
+    vi.mocked(bankSync.syncAccount).mockResolvedValue({
+      added: [],
+      updated: [],
+    });
+
+    await app.handlers['simplefin-accounts-link']({
+      externalAccount: {
+        account_id: 'external-1',
+        balance: 100,
+        institution: 'Bank',
+        orgDomain: 'bank.example',
+        name: 'Checking',
+      },
+      replaceExistingLink: true,
+    });
+
+    expect(
+      await db.first<db.DbAccount>('SELECT * FROM accounts WHERE id = ?', [
+        'old',
+      ]),
+    ).toMatchObject({
+      closed: 1,
+      account_id: null,
+      bank: null,
+      account_sync_source: null,
+      bank_sync_status: null,
+    });
+    expect(
+      await db.first('SELECT * FROM transactions WHERE id = ?', [
+        'transaction-1',
+      ]),
+    ).not.toBeNull();
+    expect(
+      await db.first('SELECT id FROM accounts WHERE account_id = ?', [
+        'external-1',
+      ]),
+    ).not.toBeNull();
+    expect(bankSync.syncAccount).toHaveBeenCalled();
+  });
+});
