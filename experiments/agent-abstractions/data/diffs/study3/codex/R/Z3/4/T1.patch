+describe('ensureAccountNotLinked', () => {
+  async function insertLinkedAccount({
+    id,
+    provider = 'simpleFin',
+    accountId = 'external-1',
+    tombstone = 0,
+    closed = 0,
+  }: {
+    id: string;
+    provider?: string;
+    accountId?: string;
+    tombstone?: number;
+    closed?: number;
+  }) {
+    db.runQuery(
+      `INSERT INTO accounts
+       (id, name, offbudget, closed, tombstone, sort_order, account_id, account_sync_source)
+       VALUES (?, '', 0, ?, ?, 0, ?, ?)`,
+      [id, closed, tombstone, accountId, provider],
+    );
+  }
+
+  it('rejects an account already linked through the same provider', async () => {
+    await insertLinkedAccount({ id: 'existing' });
+
+    await expect(
+      ensureAccountNotLinked('simpleFin', 'external-1'),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows relinking the account that already holds the link', async () => {
+    await insertLinkedAccount({ id: 'existing', closed: 1 });
+
+    await expect(
+      ensureAccountNotLinked('simpleFin', 'external-1', 'existing'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted accounts and links under another provider', async () => {
+    await insertLinkedAccount({ id: 'deleted', tombstone: 1 });
+    await insertLinkedAccount({ id: 'other-provider', provider: 'goCardless' });
+
+    await expect(
+      ensureAccountNotLinked('simpleFin', 'external-1'),
+    ).resolves.toBeUndefined();
+  });
+});
