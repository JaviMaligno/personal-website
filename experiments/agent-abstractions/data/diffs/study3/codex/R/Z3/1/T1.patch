diff --git a/packages/loot-core/src/server/accounts/link.test.ts b/packages/loot-core/src/server/accounts/link.test.ts
index 4d5667b..5a8ae3b 100644
--- a/packages/loot-core/src/server/accounts/link.test.ts
+++ b/packages/loot-core/src/server/accounts/link.test.ts
@@ -1,7 +1,7 @@
 import * as db from '#server/db';
 import { loadMappings } from '#server/db/mappings';
 
-import { findOrCreateBank } from './link';
+import { assertAccountNotLinked, findOrCreateBank } from './link';
 
 beforeEach(async () => {
   await global.emptyDatabase()();
@@ -87,3 +87,47 @@ describe('findOrCreateBank', () => {
     expect(await getBanks()).toHaveLength(1);
   });
 });
+
+describe('assertAccountNotLinked', () => {
+  async function insertLinkedAccount(
+    id: string,
+    provider: string,
+    accountId: string,
+    tombstone = 0,
+  ) {
+    await db.insertWithUUID('accounts', {
+      id,
+      name: id,
+      account_sync_source: provider,
+      account_id: accountId,
+      tombstone,
+    });
+  }
+
+  it('rejects a bank account linked to another live local account', async () => {
+    await insertLinkedAccount('linked', 'simpleFin', 'external-1');
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'external-1'),
+    ).rejects.toThrow(
+      'This bank account is already linked to another account.',
+    );
+  });
+
+  it('allows the same link to be refreshed in its current local account', async () => {
+    await insertLinkedAccount('linked', 'simpleFin', 'external-1');
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'external-1', 'linked'),
+    ).resolves.toBeUndefined();
+  });
+
+  it('ignores deleted accounts and links from other providers', async () => {
+    await insertLinkedAccount('deleted', 'simpleFin', 'external-1', 1);
+    await insertLinkedAccount('other-provider', 'akahu', 'external-1');
+
+    await expect(
+      assertAccountNotLinked('simpleFin', 'external-1'),
+    ).resolves.toBeUndefined();
+  });
+});
diff --git a/packages/loot-core/src/server/accounts/link.ts b/packages/loot-core/src/server/accounts/link.ts
index 19f9163..f500ac8 100644
--- a/packages/loot-core/src/server/accounts/link.ts
+++ b/packages/loot-core/src/server/accounts/link.ts
@@ -50,3 +50,21 @@ export async function findOrCreateBank(
 
   return bankData;
 }
+
+export async function assertAccountNotLinked(
+  provider: string,
+  accountId: string,
+  upgradingId?: string,
+) {
+  const existing = await db.first<{ id: string }>(
+    `SELECT id FROM accounts
+     WHERE account_sync_source = ? AND account_id = ? AND tombstone = 0
+       AND (? IS NULL OR id != ?)
+     LIMIT 1`,
+    [provider, accountId, upgradingId ?? null, upgradingId ?? null],
+  );
+
+  if (existing) {
+    throw new Error('This bank account is already linked to another account.');
+  }
+}
