+
+  it('includes hidden categories and hidden groups only when requested', async () => {
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'Hidden category',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    await db.insertCategory({
+      id: 'hidden-group-cat',
+      name: 'Hidden group category',
+      cat_group: 'hidden-group',
+      is_income: 0,
+    });
+    await setBudget({ category: 'hidden-cat', month: '2024-04', amount: 100 });
+    await setBudget({ category: 'hidden-group-cat', month: '2024-04', amount: 100 });
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(100);
+    expect(await getSheetValue('budget202404', 'budget-hidden-group-cat')).toBe(100);
+
+    await setZero({ month: '2024-04', includeHiddenCategories: true });
+    await sheet.waitOnSpreadsheet();
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(0);
+    expect(await getSheetValue('budget202404', 'budget-hidden-group-cat')).toBe(0);
+  });
+});
