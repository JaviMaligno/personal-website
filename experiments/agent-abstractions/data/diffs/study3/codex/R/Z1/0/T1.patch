+describe('month-wide budget actions and saved templates', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves hidden categories and categories with saved templates untouched', async () => {
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await db.insertCategoryGroup({ id: 'group', name: 'Group', is_income: 0 });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden group',
+      is_income: 0,
+      hidden: 1,
+    });
+    for (const [id, cat_group, hidden] of [
+      ['visible', 'group', 0],
+      ['hidden-category', 'group', 1],
+      ['in-hidden-group', 'hidden-group', 0],
+      ['templated', 'group', 0],
+    ] as const) {
+      await db.insertCategory({ id, name: id, cat_group, hidden });
+    }
+    await db.updateWithSchema('categories', {
+      id: 'templated',
+      goal_def: JSON.stringify([{ type: 'simple' }]),
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01', '2024-02']);
+
+    for (const category of [
+      'visible',
+      'hidden-category',
+      'in-hidden-group',
+      'templated',
+    ]) {
+      await setBudget({ category, month: '2024-01', amount: 100 });
+      await setBudget({ category, month: '2024-02', amount: 200 });
+    }
+    await sheet.waitOnSpreadsheet();
+
+    await setZero({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    for (const category of ['hidden-category', 'in-hidden-group', 'templated']) {
+      expect(await getSheetValue('budget202402', `budget-${category}`)).toBe(
+        200,
+      );
+    }
+    expect(await getSheetValue('budget202402', 'budget-visible')).toBe(0);
+
+    await set3MonthAvg({ month: '2024-02' });
+    await sheet.waitOnSpreadsheet();
+    for (const category of ['hidden-category', 'in-hidden-group', 'templated']) {
+      expect(await getSheetValue('budget202402', `budget-${category}`)).toBe(
+        200,
+      );
+    }
+  });
+});
