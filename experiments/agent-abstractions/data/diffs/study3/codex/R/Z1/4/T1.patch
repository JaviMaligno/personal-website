+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('leaves hidden, hidden-group, and template categories unchanged when zeroing', async () => {
+    await db.insertCategoryGroup({
+      id: 'visible',
+      name: 'Visible',
+      is_income: 0,
+    });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden',
+      is_income: 0,
+      hidden: 1,
+    });
+    for (const [id, group, hidden, goal_def] of [
+      ['normal', 'visible', 0, null],
+      ['hidden', 'visible', 1, null],
+      ['in-hidden-group', 'hidden-group', 0, null],
+      ['templated', 'visible', 0, '[{}]'],
+    ] as const) {
+      await db.insertCategory({
+        id,
+        name: id,
+        cat_group: group,
+        is_income: 0,
+        hidden,
+        goal_def,
+      });
+      await setBudget({ category: id, month: '2024-01', amount: 123 });
+    }
+    await db.insertCategoryGroup({
+      id: 'income-group',
+      name: 'Income',
+      is_income: 1,
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202401', 'budget-normal')).toBe(0);
+    expect(await getSheetValue('budget202401', 'budget-hidden')).toBe(123);
+    expect(await getSheetValue('budget202401', 'budget-in-hidden-group')).toBe(
+      123,
+    );
+    expect(await getSheetValue('budget202401', 'budget-templated')).toBe(123);
+  });
+});
