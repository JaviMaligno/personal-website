+describe('set last month spending', () => {
+  beforeEach(async () => {
+    await global.emptyDatabase()();
+    await setupAverageDatabase();
+  });
+
+  afterEach(async () => {
+    await global.emptyDatabase()();
+  });
+
+  it('budgets previous month expense spending and leaves excluded categories alone', async () => {
+    await db.insertCategory({
+      id: 'hidden-cat',
+      name: 'Hidden',
+      cat_group: 'group1',
+      is_income: 0,
+      hidden: 1,
+    });
+    await setBudget({ category: 'hidden-cat', month: '2024-04', amount: 1234 });
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-cat1')).toBe(1200);
+    expect(await getSheetValue('budget202404', 'budget-hidden-cat')).toBe(
+      1234,
+    );
+  });
+
+  it('budgets income received when tracking budget mode is active', async () => {
+    await db.insertCategory({
+      id: 'income-cat',
+      name: 'Income',
+      cat_group: 'income-group',
+      is_income: 1,
+    });
+    db.runQuery(
+      `INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')`,
+    );
+    await db.insertTransaction({
+      date: '2024-03-20',
+      amount: 4500,
+      account: 'account1',
+      category: 'income-cat',
+    });
+
+    await setLastMonthSpending({ month: '2024-04' });
+    await sheet.waitOnSpreadsheet();
+
+    expect(await getSheetValue('budget202404', 'budget-income-cat')).toBe(4500);
+  });
+});
