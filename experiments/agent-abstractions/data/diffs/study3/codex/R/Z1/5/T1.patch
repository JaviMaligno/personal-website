+describe('month-wide budget actions', () => {
+  beforeEach(global.emptyDatabase());
+  afterEach(global.emptyDatabase());
+
+  it('setZero leaves hidden, hidden-group, and UI-template categories untouched', async () => {
+    await db.insertCategoryGroup({ id: 'income', name: 'Income', is_income: 1 });
+    await db.insertCategoryGroup({ id: 'visible', name: 'Visible', is_income: 0 });
+    await db.insertCategoryGroup({
+      id: 'hidden-group',
+      name: 'Hidden',
+      is_income: 0,
+      hidden: 1,
+    });
+    for (const [id, group, hidden] of [
+      ['hidden-category', 'visible', 1],
+      ['hidden-group-category', 'hidden-group', 0],
+      ['template-category', 'visible', 0],
+      ['regular-category', 'visible', 0],
+    ] as const) {
+      await db.insertCategory({ id, name: id, cat_group: group, is_income: 0, hidden });
+    }
+    await db.updateWithSchema('categories', {
+      id: 'template-category',
+      goal_def: JSON.stringify([{ type: 'simple', monthly: 100 }]),
+      template_settings: { source: 'ui' },
+    });
+    await sheet.loadSpreadsheet(db);
+    await budget.createBudget(['2024-01']);
+    for (const id of [
+      'hidden-category',
+      'hidden-group-category',
+      'template-category',
+      'regular-category',
+    ]) {
+      await setBudget({ category: id, month: '2024-01', amount: 123 });
+    }
+
+    await setZero({ month: '2024-01' });
+    await sheet.waitOnSpreadsheet();
+
+    for (const id of ['hidden-category', 'hidden-group-category', 'template-category']) {
+      expect(await getSheetValue('budget202401', `budget-${id}`)).toBe(123);
+    }
+    expect(await getSheetValue('budget202401', 'budget-regular-category')).toBe(0);
+  });
+});
