+type MonthActionCategory = Pick<
+  db.DbViewCategoryWithGroupHidden,
+  'id' | 'is_income' | 'hidden' | 'group_hidden'
+> & { has_saved_templates: 0 | 1 };
+
+function getMonthActionCategories(): Promise<MonthActionCategory[]> {
+  return db.all<MonthActionCategory>(`
+    SELECT c.id, c.is_income, c.hidden, g.hidden AS group_hidden,
+      CASE WHEN c.goal_def IS NOT NULL
+        AND json_extract(c.template_settings, '$.source') = 'ui'
+        THEN 1 ELSE 0 END AS has_saved_templates
+    FROM categories c
+    LEFT JOIN category_groups g ON c.cat_group = g.id
+    WHERE c.tombstone = 0
+  `);
+}
+
+function shouldSetMonthBudget(cat: MonthActionCategory): boolean {
+  return (
+    cat.hidden === 0 &&
+    cat.group_hidden === 0 &&
+    cat.has_saved_templates === 0 &&
+    (cat.is_income === 0 || isTrackingBudget())
+  );
+}
