+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getMonthActionCategories();
+  const prevMonth = monthUtils.prevMonth(month);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (!shouldSetMonthBudget(cat)) {
+        continue;
+      }
+
+      const spending = await getSheetValue(
+        monthUtils.sheetForMonth(prevMonth),
+        'sum-amount-' + cat.id,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? spending : spending * -1,
+      });
+    }
+  });
+}
+
 type MonthActionCategory = Pick<
   db.DbViewCategoryWithGroupHidden,
   'id' | 'is_income' | 'hidden' | 'group_hidden'
