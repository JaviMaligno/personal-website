   });
 }
 
+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await db.all<db.DbViewCategoryWithGroupHidden>(
+    `
+  SELECT c.*
+  FROM categories c
+  LEFT JOIN category_groups g ON c.cat_group = g.id
+  WHERE c.tombstone = 0 AND c.hidden = 0 AND g.hidden = 0
+    AND NOT (c.goal_def IS NOT NULL
+      AND COALESCE(JSON_EXTRACT(c.template_settings, '$.source'), 'notes') = 'ui')
+  `,
+  );
+  const prevMonth = monthUtils.prevMonth(month);
+  const sheetName = monthUtils.sheetForMonth(prevMonth);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      const spending = await getSheetValue(
+        sheetName,
+        'sum-amount-' + cat.id,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? spending : spending * -1,
+      });
+    }
+  });
+}
