+export async function setLastMonthSpending({
+  month,
+}: {
+  month: string;
+}): Promise<void> {
+  const categories = await getVisibleCategoriesWithoutTemplates();
+  const lastMonth = monthUtils.prevMonth(month);
+
+  await batchMessages(async () => {
+    for (const cat of categories) {
+      if (cat.is_income === 1 && !isTrackingBudget()) {
+        continue;
+      }
+
+      const spent = await getSheetValue(
+        monthUtils.sheetForMonth(lastMonth),
+        `sum-amount-${cat.id}`,
+      );
+      void setBudget({
+        category: cat.id,
+        month,
+        amount: cat.is_income === 1 ? spent : -spent,
+      });
+    }
+  });
+}
