+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const rangeStart = d.subDays(d.startOfDay(d.parseISO(start)), 3);
+  const rangeEnd = d.addDays(d.startOfDay(d.parseISO(end)), 3);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const dates = schedule
+      .occurrences({ start: rangeStart, end: rangeEnd })
+      .toArray()
+      .flatMap(occurrence => {
+        const occurrenceDate = occurrence.date;
+        if (config.frequency === 'daily' && d.isWeekend(occurrenceDate)) {
+          return [];
+        }
+
+        const date =
+          config.skipWeekend && config.frequency !== 'daily'
+            ? getDateWithSkippedWeekend(
+                occurrenceDate,
+                config.weekendSolveMode,
+              )
+            : occurrenceDate;
+        const day = dayFromDate(date);
+        return day >= start && day <= end ? [day] : [];
+      });
+
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
