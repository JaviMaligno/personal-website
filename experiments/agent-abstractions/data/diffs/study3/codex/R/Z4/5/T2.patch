+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const startDate = d.startOfDay(d.subDays(new Date(start), 2));
+  const endDate = d.startOfDay(d.addDays(new Date(end), 2));
+  const isDaily = config.frequency === 'daily';
+
+  return schedule
+    .occurrences({ start: startDate, end: endDate })
+    .toArray()
+    .map(({ date }) => {
+      if (config.skipWeekend && isDaily && d.isWeekend(date)) {
+        return null;
+      }
+      return config.skipWeekend
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date;
+    })
+    .filter((date): date is Date => date != null)
+    .map(dayFromDate)
+    .filter(date => date >= start && date <= end)
+    .filter((date, index, dates) => dates.indexOf(date) === index)
+    .sort();
+}
