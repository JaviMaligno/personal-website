+export function getDatesInRange({
+  config,
+  start,
+  end,
+}: {
+  config: RecurConfig;
+  start: string;
+  end: string;
+}) {
+  if (start > end) return [];
+
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  // Weekend adjustments can move an occurrence by at most three calendar days.
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), 3)),
+      end: d.endOfDay(d.addDays(parseDate(end), 3)),
+    })
+    .toArray();
+
+  const dates = new Set<string>();
+  for (const occurrence of occurrences) {
+    let date = occurrence.date;
+    if (config.skipWeekend && d.isWeekend(date)) {
+      if (config.frequency === 'daily') continue;
+      date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+    }
+    const day = dayFromDate(date);
+    if (day >= start && day <= end) dates.add(day);
+  }
+  return [...dates].sort();
+}
