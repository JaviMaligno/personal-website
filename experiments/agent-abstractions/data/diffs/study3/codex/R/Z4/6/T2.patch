+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const rangeStart = d.subDays(d.startOfDay(parseDate(start)), 3);
+    const rangeEnd = d.addDays(d.startOfDay(parseDate(end)), 3);
+    const occurrences = schedule
+      .occurrences({ start: rangeStart, end: rangeEnd })
+      .toArray();
+    const isDaily = config.frequency === 'daily';
+
+    return [...new Set(occurrences.flatMap(({ date }) => {
+      if (config.skipWeekend && d.isWeekend(date)) {
+        if (isDaily) return [];
+        return [dayFromDate(getDateWithSkippedWeekend(date, config.weekendSolveMode))];
+      }
+      return [dayFromDate(date)];
+    }).filter(day => day >= start && day <= end))].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
