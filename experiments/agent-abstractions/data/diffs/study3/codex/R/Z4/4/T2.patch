+async function getDatesInRange({ config, start, end }) {
+  if (start > end) {
+    return [];
+  }
+
+  const rules = recurConfigToRSchedule(config);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    // Weekend occurrences can move up to two days in either direction. Query
+    // the source occurrences around the range, then apply the adjustment and
+    // decide membership using the resulting day.
+    const occurrences = schedule
+      .occurrences({
+        start: d.startOfDay(d.subDays(parseDate(start), 3)),
+        end: d.startOfDay(d.addDays(parseDate(end), 3)),
+      })
+      .toArray();
+    const dates = new Set<string>();
+
+    for (const occurrence of occurrences) {
+      let date = occurrence.date;
+      if (config.skipWeekend) {
+        if (config.frequency === 'daily' && d.isWeekend(date)) {
+          continue;
+        }
+        date = getDateWithSkippedWeekend(date, config.weekendSolveMode);
+      }
+
+      const day = dayFromDate(date);
+      if (day >= start && day <= end) {
+        dates.add(day);
+      }
+    }
+
+    return [...dates].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
