+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const rangeStart = d.startOfDay(parseDate(start));
+  const rangeEnd = d.endOfDay(parseDate(end));
+  const dates = schedule
+    .occurrences({
+      start: d.subDays(rangeStart, 3),
+      end: d.addDays(rangeEnd, 3),
+    })
+    .toArray()
+    .flatMap(({ date }) => {
+      if (
+        config.skipWeekend &&
+        config.frequency === 'daily' &&
+        d.isWeekend(date)
+      ) {
+        return [];
+      }
+      const finalDate = config.skipWeekend
+        ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+        : date;
+      return finalDate >= rangeStart && finalDate <= rangeEnd
+        ? [dayFromDate(finalDate)]
+        : [];
+    });
+
+  return [...new Set(dates)].sort();
+}
