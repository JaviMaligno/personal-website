+async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const startDate = parseDate(start);
+  const endDate = parseDate(end);
+  // Weekend adjustments can move an occurrence by at most two days. Include
+  // those original dates so occurrences shifted into the requested range count.
+  const searchStart = d.subDays(startDate, config.skipWeekend ? 2 : 0);
+  const searchEnd = d.addDays(endDate, config.skipWeekend ? 2 : 0);
+
+  try {
+    const schedule = new RSchedule({ rrules: rules });
+    const dates = schedule
+      .occurrences({ start: searchStart, end: searchEnd })
+      .toArray()
+      .map(({ date }) => {
+        if (config.frequency === 'daily' && config.skipWeekend && d.isWeekend(date)) {
+          return null;
+        }
+        const finalDate = config.skipWeekend
+          ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+          : date;
+        return finalDate >= startDate && finalDate <= endDate
+          ? dayFromDate(finalDate)
+          : null;
+      })
+      .filter(Boolean);
+    return [...new Set(dates)].sort();
+  } catch (err) {
+    captureBreadcrumb(config);
+    throw err;
+  }
+}
