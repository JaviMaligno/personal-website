+export async function getDatesInRange({ config, start, end }) {
+  const rules = recurConfigToRSchedule(config);
+  const schedule = new RSchedule({ rrules: rules });
+  const skipDailyWeekends = config.skipWeekend && config.frequency === 'daily';
+  // Weekend adjustments can move an occurrence by at most three days (Sunday
+  // to Friday), so include nearby source dates and filter by the adjusted day.
+  const occurrences = schedule
+    .occurrences({
+      start: d.startOfDay(d.subDays(parseDate(start), 3)),
+      end: d.endOfDay(d.addDays(parseDate(end), 3)),
+    })
+    .toArray();
+  return Array.from(
+    new Set(
+      occurrences
+        .filter(({ date }) => !skipDailyWeekends || !d.isWeekend(date))
+        .map(({ date }) =>
+          config.skipWeekend && !skipDailyWeekends
+            ? getDateWithSkippedWeekend(date, config.weekendSolveMode)
+            : date,
+        )
+        .map(dayFromDate)
+        .filter(date => date >= start && date <= end),
+    ),
+  ).sort();
+}
