@@ -0,0 +1,33 @@
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  it.each([
+    [12500, 12500],
+    [{ num1: -10100, num2: -20000 }, -20000],
+    [{ num1: 10100, num2: 20000 }, 20000],
+    [undefined, 0],
+  ])('includes the expected amount for %j', (amount, expectedAmount) => {
+    const result = scheduleModel.toExternal({
+      id: 'schedule-id',
+      name: 'Schedule',
+      rule: 'rule-id',
+      next_date: '2025-01-01',
+      completed: false,
+      posts_transaction: true,
+      tombstone: false,
+      _payee: 'payee-id',
+      _account: 'account-id',
+      _amount: amount,
+      _amountOp: 'isbetween',
+      _date: '2025-01-01',
+      _conditions: [],
+      _actions: [],
+    });
+
+    expect(result).toMatchObject({
+      amount,
+      amountOp: 'isbetween',
+      expectedAmount,
+    });
+  });
+});
