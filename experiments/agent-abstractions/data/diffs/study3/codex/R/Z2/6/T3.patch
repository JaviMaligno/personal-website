+export function getExpectedScheduleAmount(
+  amount: number | { num1: number; num2: number } | null | undefined,
+  op?: string,
+): number {
+  const expected = getScheduledAmount(amount);
+  if (op !== 'isapprox' || typeof amount !== 'number') {
+    return expected;
+  }
+
+  // Approximate schedule matching allows 7.5% variance, rounded to cents.
+  // Planning assumes the end of that tolerance furthest from zero.
+  const tolerance = Math.round(Math.abs(amount) * 0.075);
+  return amount + Math.sign(amount) * tolerance;
+}
