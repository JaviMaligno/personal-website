@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest';
+
+import { scheduleModel } from './api-models';
+
+describe('scheduleModel', () => {
+  function makeSchedule(amount: number | { num1: number; num2: number }) {
+    return {
+      id: 'schedule-id',
+      name: 'Schedule',
+      rule: 'rule-id',
+      next_date: '2024-01-01',
+      completed: false,
+      posts_transaction: true,
+      tombstone: false,
+      _payee: 'payee-id',
+      _account: 'account-id',
+      _amount: amount,
+      _amountOp: 'isbetween',
+      _date: '2024-01-01',
+      _conditions: [],
+      _actions: [],
+    };
+  }
+
+  it('includes the amount expected to post', () => {
+    expect(
+      scheduleModel.toExternal(makeSchedule({ num1: -10100, num2: -20000 })),
+    ).toMatchObject({
+      amount: { num1: -10100, num2: -20000 },
+      amountOp: 'isbetween',
+      expectedAmount: -20000,
+    });
+  });
+
+  it.each([
+    [12000, 12000],
+    [{ num1: 10100, num2: 20000 }, 20000],
+    [{ num1: 20000, num2: 10100 }, 20000],
+    [{ num1: -10100, num2: -20000 }, -20000],
+  ])('derives expectedAmount for %j', (amount, expectedAmount) => {
+    expect(scheduleModel.toExternal(makeSchedule(amount)).expectedAmount).toBe(
+      expectedAmount,
+    );
+  });
+});
