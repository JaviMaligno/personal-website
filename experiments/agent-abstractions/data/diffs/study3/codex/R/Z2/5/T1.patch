+/** Returns the expected transaction amount for a schedule amount condition. */
+export function getScheduleAmount(amount: number | { num1: number; num2: number } | null) {
+  if (amount == null) {
+    return 0;
+  }
+  if (typeof amount === 'number') {
+    return amount;
+  }
+  return Math.abs(amount.num1) > Math.abs(amount.num2)
+    ? amount.num1
+    : amount.num2;
+}
