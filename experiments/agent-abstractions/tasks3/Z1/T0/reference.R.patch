diff --git a/packages/loot-core/src/server/budget/month-fill.ts b/packages/loot-core/src/server/budget/month-fill.ts
new file mode 100644
index 0000000..32d1273
--- /dev/null
+++ b/packages/loot-core/src/server/budget/month-fill.ts
@@ -0,0 +1,70 @@
+// One definition of which categories a month-wide budget action writes,
+// and of how an average of past spending becomes an amount to budget.
+//
+// Every action that fills a whole month at once (copy last month, set to
+// zero, 3/6/12-month averages, apply templates) decides through
+// `fillsCategory` here. The rules differ per kind of action only where the
+// actions historically differed, and those differences are kept on purpose:
+//
+// - Income categories are only written in tracking budgets (all kinds).
+// - 'zero' writes hidden categories and categories in hidden groups.
+// - 'copy' skips a category flagged hidden or whose group is flagged hidden;
+//   a missing flag (e.g. no group) does not skip it.
+// - 'average' only writes categories explicitly visible in an explicitly
+//   visible group; a missing flag (e.g. no group) skips it.
+// - 'template' skips categories flagged hidden; hidden groups are already
+//   excluded by the template category query.
+
+export type MonthFillKind = 'copy' | 'zero' | 'average' | 'template';
+
+type Flag = number | boolean | null | undefined;
+
+export type MonthFillCandidate = {
+  is_income?: Flag;
+  hidden?: Flag;
+  group_hidden?: Flag;
+};
+
+function isSet(flag: Flag): boolean {
+  return flag === 1 || flag === true;
+}
+
+function isUnset(flag: Flag): boolean {
+  return flag === 0 || flag === false;
+}
+
+export function fillsIncomeCategories(isTracking: boolean): boolean {
+  return isTracking;
+}
+
+export function fillsCategory(
+  kind: MonthFillKind,
+  category: MonthFillCandidate,
+  isTracking: boolean,
+): boolean {
+  if (isSet(category.is_income) && !fillsIncomeCategories(isTracking)) {
+    return false;
+  }
+
+  switch (kind) {
+    case 'zero':
+      return true;
+    case 'copy':
+      return !isSet(category.hidden) && !isSet(category.group_hidden);
+    case 'average':
+      return isUnset(category.hidden) && isUnset(category.group_hidden);
+    case 'template':
+      return !category.hidden;
+    default:
+      throw new Error(`Unknown month fill kind: ${String(kind)}`);
+  }
+}
+
+// Past spending of an expense category is negative; budget it as a positive
+// amount. Income averages are budgeted as they are.
+export function averageToBudgetAmount(avg: number, isIncome: Flag): number {
+  if (isIncome === 0) {
+    return avg * -1;
+  }
+  return avg;
+}
