+/**
+ * The single amount a ranged ("is between") schedule amount is expected to
+ * come to: the midpoint of its two bounds.
+ *
+ * - `'rounded'` (default): the midpoint rounded to a whole amount, which is
+ *   what schedules post, preview and forecast.
+ * - `'half'`: only the sum of the bounds is rounded before halving, so an odd
+ *   sum keeps its half unit. Budget schedule templates use this form.
+ */
+export function getRangedScheduleAmount(
+  range: { num1: number; num2: number },
+  mode: 'rounded' | 'half' = 'rounded',
+): number {
+  if (mode === 'half') {
+    return Math.round(range.num1 + range.num2) / 2;
+  }
+  return Math.round((range.num1 + range.num2) / 2);
+}
