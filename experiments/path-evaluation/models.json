{
  "haiku": {
    "transport": "claude_cli",
    "model": "claude-haiku-5-5"
  },
  "sonnet": {
    "transport": "claude_cli",
    "model": "claude-sonnet-5-5"
  },
  "qwen": {
    "transport": "openai",
    "model": "qwen/qwen3.5-9b",
    "endpoint": "https://openrouter.ai/api/v1/chat/completions",
    "key_file": "~/.config/openrouter/key",
    "max_tokens": 2048
  },
  "qwen-think": {
    "transport": "openai",
    "model": "qwen/qwen3.5-9b",
    "endpoint": "https://openrouter.ai/api/v1/chat/completions",
    "key_file": "~/.config/openrouter/key",
    "max_tokens": 8192,
    "params": {
      "reasoning": {
        "enabled": true
      }
    }
  }
}
